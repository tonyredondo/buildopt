#!/usr/bin/env bash
set -euo pipefail

buildopt_die() {
    printf 'buildopt profile CI: %s\n' "$1" >&2
    exit "${2:-1}"
}

for buildopt_command in find git go jq mkdir mktemp mv python3 rm sha256sum sort xargs; do
    command -v "${buildopt_command}" >/dev/null 2>&1 ||
        buildopt_die "required command is unavailable: ${buildopt_command}"
done

buildopt_action_path=${BUILDOPT_PROFILE_ACTION_PATH:-}
buildopt_action_ref=${BUILDOPT_PROFILE_ACTION_REF:-}
buildopt_buildopt_revision=${BUILDOPT_PROFILE_BUILDOPT_REVISION:-}
buildopt_repository_input=${BUILDOPT_PROFILE_REPOSITORY_DIRECTORY:-.}
buildopt_runner_os=${BUILDOPT_PROFILE_RUNNER_OS:-}
buildopt_config_relative=${BUILDOPT_PROFILE_CONFIG:-.buildopt/profile.json}
buildopt_base_revision=${BUILDOPT_PROFILE_BASE_REVISION:-}
buildopt_target_revision=${BUILDOPT_PROFILE_TARGET_REVISION:-}
buildopt_artifact_name=${BUILDOPT_PROFILE_ARTIFACT_NAME:-buildopt-profile-proposal}
buildopt_github_output=${GITHUB_OUTPUT:-}
buildopt_runner_temp=${RUNNER_TEMP:-}
buildopt_workspace=${GITHUB_WORKSPACE:-}

[[ -n "${buildopt_action_path}" && -d "${buildopt_action_path}" ]] ||
    buildopt_die 'action source directory is unavailable'
[[ -n "${buildopt_github_output}" ]] || buildopt_die 'GITHUB_OUTPUT is unavailable'
[[ "${buildopt_runner_os}" == Linux ]] ||
    buildopt_die 'profile-proposal mode currently requires a Linux runner' 64
[[ "${buildopt_base_revision}" =~ ^[0-9a-f]{40}$ ]] ||
    buildopt_die 'profile-base-revision must be a lowercase 40-character commit' 64
[[ "${buildopt_target_revision}" =~ ^[0-9a-f]{40}$ ]] ||
    buildopt_die 'profile-target-revision must be a lowercase 40-character commit' 64
[[ "${buildopt_artifact_name}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] ||
    buildopt_die 'profile-artifact-name is invalid' 64

if [[ -z "${buildopt_buildopt_revision}" ]]; then
    buildopt_buildopt_revision=${buildopt_action_ref}
fi
[[ "${buildopt_buildopt_revision}" =~ ^[0-9a-f]{40}$ ]] ||
    buildopt_die 'pin the Action to a full commit or supply profile-buildopt-revision' 64

buildopt_source_root=$(cd -- "${buildopt_action_path}" && pwd -P)
buildopt_repository=$(cd -- "${buildopt_repository_input}" 2>/dev/null && pwd -P) ||
    buildopt_die 'profile repository directory is unavailable'
if [[ ! -d "${buildopt_repository}/.git" && ! -f "${buildopt_repository}/.git" ]]; then
    buildopt_die 'profile repository directory is not a Git checkout'
fi

# Keep consumers on the historical default working while the owner-generated
# profile replaces the former CI-only input.
if [[ "${buildopt_config_relative}" == .buildopt/profile.json && \
    ! -e "${buildopt_repository}/${buildopt_config_relative}" && \
    ! -L "${buildopt_repository}/${buildopt_config_relative}" && \
    -f "${buildopt_repository}/.buildopt/profile-ci.json" && \
    ! -L "${buildopt_repository}/.buildopt/profile-ci.json" ]]; then
    buildopt_config_relative=.buildopt/profile-ci.json
fi

buildopt_path_is_below() {
    local buildopt_candidate=$1
    local buildopt_root=$2
    [[ -n "${buildopt_root}" ]] || return 1
    buildopt_root=$(cd -- "${buildopt_root}" 2>/dev/null && pwd -P) || return 1
    [[ "${buildopt_candidate}" == "${buildopt_root}" || \
        "${buildopt_candidate}" == "${buildopt_root}/"* ]]
}
if ! buildopt_path_is_below "${buildopt_repository}" "${buildopt_workspace}" &&
    ! buildopt_path_is_below "${buildopt_repository}" "${buildopt_runner_temp}"; then
    buildopt_die 'profile repository must be below GITHUB_WORKSPACE or RUNNER_TEMP'
fi

python3 - "${buildopt_repository}" "${buildopt_config_relative}" <<'PY'
import pathlib
import stat
import sys

root = pathlib.Path(sys.argv[1])
value = sys.argv[2]
path = pathlib.PurePosixPath(value)
if (
    not value
    or value.startswith("/")
    or path.as_posix() != value
    or any(part in ("", ".", "..") for part in path.parts)
):
    raise SystemExit("profile config must be a clean repository-relative path")
current = root
for index, part in enumerate(path.parts):
    current = current / part
    try:
        info = current.lstat()
    except OSError as error:
        raise SystemExit(f"profile config path is unavailable: {error}") from error
    if stat.S_ISLNK(info.st_mode):
        raise SystemExit("profile config path must not contain symlinks")
    if index < len(path.parts) - 1 and not stat.S_ISDIR(info.st_mode):
        raise SystemExit("profile config parent must be a directory")
    if index == len(path.parts) - 1 and not stat.S_ISREG(info.st_mode):
        raise SystemExit("profile config must be a regular file")
PY
buildopt_config="${buildopt_repository}/${buildopt_config_relative}"

buildopt_config_schema=$(jq -r '.schemaVersion // ""' "${buildopt_config}")
if [[ "${buildopt_config_schema}" == buildopt.poc/profile-owner-input/v1 ]]; then
    jq -e '
    keys == [
        "activationAutomatic",
        "changeSource",
        "entrypoints",
        "globalChanges",
        "gradleCommand",
        "gradleOptions",
        "outputConfirmation",
        "pipelineClass",
        "productionAuthorized",
        "repositoryId",
        "requiredOutputs",
        "reviewRequired",
        "schemaVersion",
        "testOptimization",
        "timeoutMinutes"
    ] and
    .schemaVersion == "buildopt.poc/profile-owner-input/v1" and
    .changeSource == "GIT_DIFF_BASE_TO_HEAD" and
    .outputConfirmation.status == "OWNER_CONFIRMED" and
    (.outputConfirmation.observedRevision | test("^[0-9a-f]{40}$")) and
    (.outputConfirmation.contractSha256 | test("^[0-9a-f]{64}$")) and
    .reviewRequired == true and
    .activationAutomatic == false and
    .productionAuthorized == false and
    .testOptimization == "OUT_OF_SCOPE"
    ' "${buildopt_config}" >/dev/null ||
        buildopt_die 'profile configuration does not match buildopt.poc/profile-owner-input/v1' 64
elif ! jq -e '
    keys == [
        "entrypoints",
        "globalChanges",
        "gradleCommand",
        "gradleOptions",
        "pipelineClass",
        "repositoryId",
        "requiredOutputs",
        "schemaVersion",
        "timeoutMinutes"
    ] and
    .schemaVersion == "buildopt.poc/profile-ci-input/v1" and
    (.repositoryId | test("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")) and
    (.pipelineClass | test("^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")) and
    (.entrypoints | type == "array" and length > 0 and length <= 256 and
        all(type == "string" and length > 0 and length <= 256 and test("^[^\\r\\n]+$")) and
        length == (unique | length)) and
    (.requiredOutputs | type == "array" and length > 0 and length <= 256 and
        all(type == "string" and length > 0 and length <= 1024 and test("^[^\\r\\n]+$")) and
        length == (unique | length)) and
    (.globalChanges | type == "array" and length <= 256 and
        all(type == "string" and length > 0 and length <= 1024 and test("^[^\\r\\n]+$")) and
        length == (unique | length)) and
    (.gradleCommand | type == "string" and
        (. == "" or (length <= 1024 and test("^[.]/[^\\r\\n]+$")))) and
    (.gradleOptions | type == "array" and length <= 32 and
        all(type == "string" and length > 0 and length <= 1024 and test("^[^\\r\\n]+$")) and
        length == (unique | length)) and
    (.timeoutMinutes | type == "number" and floor == . and . >= 1 and . <= 30)
' "${buildopt_config}" >/dev/null; then
    buildopt_die 'profile configuration does not match buildopt.poc/profile-ci-input/v1' 64
fi

buildopt_head=$(git -C "${buildopt_repository}" rev-parse HEAD)
[[ "${buildopt_head}" == "${buildopt_target_revision}" ]] ||
    buildopt_die 'profile-target-revision does not match the checked-out HEAD'
git -C "${buildopt_repository}" cat-file -e "${buildopt_base_revision}^{commit}" ||
    buildopt_die 'profile-base-revision is unavailable; fetch its commit before running the Action'
git -C "${buildopt_repository}" merge-base --is-ancestor \
    "${buildopt_base_revision}" "${buildopt_target_revision}" ||
    buildopt_die 'profile-base-revision is not an ancestor of the target'
[[ -z "$(git -C "${buildopt_repository}" status --porcelain --untracked-files=no)" ]] ||
    buildopt_die 'tracked repository state must be clean'

buildopt_artifact_relative=.buildopt/buildopt-profile-proposal
buildopt_artifact="${buildopt_repository}/${buildopt_artifact_relative}"
[[ ! -e "${buildopt_artifact}" && ! -L "${buildopt_artifact}" ]] ||
    buildopt_die "artifact directory already exists: ${buildopt_artifact_relative}"
if [[ -e "${buildopt_repository}/.buildopt" && \
    ( ! -d "${buildopt_repository}/.buildopt" || -L "${buildopt_repository}/.buildopt" ) ]]; then
    buildopt_die '.buildopt must be a real directory when it already exists'
fi
mkdir -p -- "${buildopt_artifact}"

buildopt_write_outputs() {
    local buildopt_decision=$1
    local buildopt_reason=$2
    {
        printf 'decision=%s\n' "${buildopt_decision}"
        printf 'reason=%s\n' "${buildopt_reason}"
        printf 'artifact-directory=%s\n' "${buildopt_artifact}"
    } >>"${buildopt_github_output}"
}

buildopt_changes_nul="${buildopt_artifact}/changes.nul"
jq -S . "${buildopt_config}" >"${buildopt_artifact}/ci-input.json"
git -C "${buildopt_repository}" diff --name-only --no-renames -z \
    "${buildopt_base_revision}" "${buildopt_target_revision}" -- \
    >"${buildopt_changes_nul}"
python3 - "${buildopt_changes_nul}" "${buildopt_artifact}/changes.txt" <<'PY'
import pathlib
import sys

raw = pathlib.Path(sys.argv[1]).read_bytes()
paths = raw.split(b"\0")
if paths and paths[-1] == b"":
    paths.pop()
decoded = []
for value in paths:
    text = value.decode("utf-8")
    if not text or "\n" in text or "\r" in text:
        raise SystemExit("Git change paths must be non-empty UTF-8 lines")
    decoded.append(text)
pathlib.Path(sys.argv[2]).write_text("".join(f"{path}\n" for path in sorted(decoded)), encoding="utf-8")
PY
rm -f -- "${buildopt_changes_nul}"

buildopt_binary_root=$(mktemp -d "${buildopt_runner_temp:-/tmp}/buildopt-profile-ci.XXXXXX")
buildopt_cleanup() {
    if [[ -n "${buildopt_binary_root:-}" && \
        "${buildopt_binary_root}" == "${buildopt_runner_temp:-/tmp}/"* && \
        -d "${buildopt_binary_root}" ]]; then
        rm -rf -- "${buildopt_binary_root}"
    fi
}
trap buildopt_cleanup EXIT
(
    cd -- "${buildopt_source_root}"
    go build -buildvcs=false -trimpath -o "${buildopt_binary_root}/buildopt" ./cmd/buildopt
)

buildopt_args=(
    profile propose
    --changes-file "${buildopt_artifact_relative}/changes.txt"
    --base-revision "${buildopt_base_revision}"
    --output-contract-output "${buildopt_artifact_relative}/buildopt-output-contract.json"
    --manifest-output "${buildopt_artifact_relative}/buildopt-impact-manifest.json"
    --graph-output "${buildopt_artifact_relative}/buildopt-impact-graph.generated.json"
    --generated-manifest-output "${buildopt_artifact_relative}/buildopt-impact.generated.json"
    --fallback-changes-output "${buildopt_artifact_relative}/buildopt-fallback-changes.txt"
    --proposal-output "${buildopt_artifact_relative}/buildopt-profile-proposal.json"
    --buildopt-revision "${buildopt_buildopt_revision}"
)
if [[ "${buildopt_config_schema}" == buildopt.poc/profile-owner-input/v1 ]]; then
    buildopt_args+=(--owner-input "${buildopt_config_relative}")
else
    buildopt_repository_id=$(jq -r '.repositoryId' "${buildopt_config}")
    buildopt_pipeline_class=$(jq -r '.pipelineClass' "${buildopt_config}")
    buildopt_gradle_command=$(jq -r '.gradleCommand' "${buildopt_config}")
    buildopt_timeout=$(jq -r '.timeoutMinutes | tostring + "m"' "${buildopt_config}")
    mapfile -t buildopt_entrypoints < <(jq -r '.entrypoints[]' "${buildopt_config}")
    mapfile -t buildopt_required_outputs < <(jq -r '.requiredOutputs[]' "${buildopt_config}")
    mapfile -t buildopt_global_changes < <(jq -r '.globalChanges[]' "${buildopt_config}")
    mapfile -t buildopt_gradle_options < <(jq -r '.gradleOptions[]' "${buildopt_config}")
    buildopt_args+=(--repository-id "${buildopt_repository_id}" --pipeline-class "${buildopt_pipeline_class}" --timeout "${buildopt_timeout}")
    for buildopt_value in "${buildopt_entrypoints[@]}"; do
        buildopt_args+=(--entrypoint "${buildopt_value}")
    done
    for buildopt_value in "${buildopt_required_outputs[@]}"; do
        buildopt_args+=(--required-output "${buildopt_value}")
    done
    for buildopt_value in "${buildopt_global_changes[@]}"; do
        buildopt_args+=(--global-change "${buildopt_value}")
    done
    for buildopt_value in "${buildopt_gradle_options[@]}"; do
        buildopt_args+=(--gradle-option "${buildopt_value}")
    done
    if [[ -n "${buildopt_gradle_command}" ]]; then
        buildopt_args+=(--gradle-command "${buildopt_gradle_command}")
    fi
fi

set +e
(
    cd -- "${buildopt_repository}"
    "${buildopt_binary_root}/buildopt" "${buildopt_args[@]}"
) >"${buildopt_artifact}/command.stdout.json" \
    2>"${buildopt_artifact}/command.stderr.txt"
buildopt_status=$?
set -e

if ((buildopt_status != 0)); then
    jq -n \
        --argjson commandStatus "${buildopt_status}" \
        --arg baseRevision "${buildopt_base_revision}" \
        --arg buildOptRevision "${buildopt_buildopt_revision}" \
        --arg targetRevision "${buildopt_target_revision}" \
        '{
            schemaVersion: "buildopt.poc/profile-ci-review/v1",
            outcome: "ERROR",
            decision: "NATIVE_FULL_GRAPH",
            reason: "PROPOSAL_COMMAND_FAILED",
            commandStatus: $commandStatus,
            baseRevision: $baseRevision,
            targetRevision: $targetRevision,
            buildOptRevision: $buildOptRevision,
            reviewRequired: true,
            activationAutomatic: false,
            productionAuthorized: false,
            testOptimization: "OUT_OF_SCOPE"
        }' >"${buildopt_artifact}/review.json"
    # Backticks are literal Markdown delimiters, not shell substitutions.
    # shellcheck disable=SC2016
    printf '# BuildOpt structural profile proposal\n\nProposal generation failed. Retain optimized native Gradle and inspect `command.stderr.txt`.\n' \
        >"${buildopt_artifact}/README.md"
    (
        cd -- "${buildopt_artifact}"
        sha256sum README.md changes.txt ci-input.json command.stderr.txt command.stdout.json review.json |
            sort -k2 >checksums.txt
    )
    buildopt_write_outputs NATIVE_FULL_GRAPH PROPOSAL_COMMAND_FAILED
    exit "${buildopt_status}"
fi

buildopt_proposal="${buildopt_artifact}/buildopt-profile-proposal.json"
if ! jq -e '
    .schemaVersion == "buildopt.poc/profile-proposal/v1" and
    (.decision == "MEASURE_STRUCTURAL_CANDIDATE" or .decision == "NATIVE_FULL_GRAPH") and
    (.reason | type == "string" and length > 0) and
    .reviewRequired == true and
    .activationAutomatic == false and
    .productionAuthorized == false and
    .testOptimization == "OUT_OF_SCOPE" and
    .documents.outputContract == ".buildopt/buildopt-profile-proposal/buildopt-output-contract.json"
' "${buildopt_proposal}" >/dev/null; then
    buildopt_write_outputs NATIVE_FULL_GRAPH INVALID_PROPOSAL_ARTIFACT
    buildopt_die 'generated proposal violates the review-only contract'
fi
buildopt_decision=$(jq -r '.decision' "${buildopt_proposal}")
buildopt_reason=$(jq -r '.reason' "${buildopt_proposal}")
jq -n \
    --arg artifactName "${buildopt_artifact_name}" \
    --arg baseRevision "${buildopt_base_revision}" \
    --arg buildOptRevision "${buildopt_buildopt_revision}" \
    --arg decision "${buildopt_decision}" \
    --arg reason "${buildopt_reason}" \
    --arg targetRevision "${buildopt_target_revision}" \
    '{
        schemaVersion: "buildopt.poc/profile-ci-review/v1",
        outcome: "COMPLETE",
        artifactName: $artifactName,
        decision: $decision,
        reason: $reason,
        baseRevision: $baseRevision,
        targetRevision: $targetRevision,
        buildOptRevision: $buildOptRevision,
        reviewRequired: true,
        activationAutomatic: false,
        productionAuthorized: false,
        testOptimization: "OUT_OF_SCOPE"
    }' >"${buildopt_artifact}/review.json"

{
    printf '# BuildOpt structural profile proposal\n\n'
    # Backticks are literal Markdown delimiters, not shell substitutions.
    # shellcheck disable=SC2016
    printf -- '- Decision: `%s`\n' "${buildopt_decision}"
    # shellcheck disable=SC2016
    printf -- '- Reason: `%s`\n' "${buildopt_reason}"
    # shellcheck disable=SC2016
    printf -- '- Base revision: `%s`\n' "${buildopt_base_revision}"
    # shellcheck disable=SC2016
    printf -- '- Target revision: `%s`\n' "${buildopt_target_revision}"
    # shellcheck disable=SC2016
    printf -- '- Review required: `true`\n'
    # shellcheck disable=SC2016
    printf -- '- Automatic activation: `false`\n\n'
    if [[ "${buildopt_decision}" == MEASURE_STRUCTURAL_CANDIDATE ]]; then
        # shellcheck disable=SC2016
        printf 'The bundle contains a candidate graph and an exact measurement handoff. Review it before running `profile measure`; this Action does not measure or activate the proposal.\n'
    else
        printf 'BuildOpt retained optimized native Gradle. No candidate documents or active profile were created.\n'
    fi
} >"${buildopt_artifact}/README.md"

(
    cd -- "${buildopt_artifact}"
    find . -maxdepth 1 -type f ! -name checksums.txt -printf '%P\0' |
        sort -z |
        xargs -0 sha256sum >"${buildopt_binary_root}/checksums.txt"
    mv -- "${buildopt_binary_root}/checksums.txt" checksums.txt
)
buildopt_write_outputs "${buildopt_decision}" "${buildopt_reason}"
printf 'BuildOpt review artifact: %s (%s)\n' "${buildopt_decision}" "${buildopt_reason}"
