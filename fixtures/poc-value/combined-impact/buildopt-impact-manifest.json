{
  "schemaVersion": "buildopt.build-impact/manifest/v1",
  "manifestVersion": 1,
  "repositoryId": "tonyredondo/buildopt-poc-combined-impact",
  "pipelineClass": "poc-value",
  "ownership": "REPOSITORY_COMMITTED",
  "originalEntrypoints": ["assemble"],
  "allowedAlternatives": [
    {
      "id": "affected-service-a",
      "entrypoints": [":service-a:assemble"]
    }
  ],
  "requiredArtifacts": [
    {
      "id": "service-a-jar",
      "path": "service-a/build/libs/service-a-*.jar",
      "owner": "BUILD_OPTIMIZATION"
    }
  ],
  "requiredChecks": [
    {
      "id": "compile-check",
      "owner": "BUILD_OPTIMIZATION"
    },
    {
      "id": "test-owned-check",
      "owner": "TEST_OPTIMIZATION"
    }
  ],
  "globalChangePaths": ["gradle/**"],
  "unknownChangePolicy": "FULL_GRAPH"
}
