#!/usr/bin/env bash
set -euo pipefail

if (($# == 2)) && [[ "$1" == "--exit" ]] && [[ "$2" =~ ^[0-9]+$ ]]; then
    exit "$2"
fi

printf 'argc=%s\n' "$#"
buildopt_index=0
for buildopt_argument in "$@"; do
    printf 'arg%s=<%s>\n' "${buildopt_index}" "${buildopt_argument}"
    buildopt_index=$((buildopt_index + 1))
done
