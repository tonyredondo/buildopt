{
  "schemaVersion": "buildopt.poc/sticky-wrapper-gradle-cache/v1",
  "workItem": "SWL-006",
  "entrypoint": {
    "command": "buildoptw <gradle-args>",
    "committedConfiguration": ".buildopt/config.toml",
    "repositoryWrapper": "gradlew or gradlew.bat"
  },
  "connection": {
    "requiredCapabilities": [
      "CACHE_READ",
      "STATE_READ"
    ],
    "defaultMode": "READ_ONLY",
    "missingOrRejectedCredential": "NATIVE_GRADLE_WITH_WARNING",
    "tokenPassedToGradle": false,
    "projectScopeIncludesCheckoutPath": false
  },
  "gradle": {
    "protocol": "NATIVE_HTTP_BUILD_CACHE",
    "buildCacheFlag": "AUTO_ENABLE_UNLESS_EXPLICITLY_DISABLED",
    "localL1": "MANAGED_PRIVATE_GRADLE_DIRECTORY",
    "centralL2": "INVOCATION_LOCAL_VERIFYING_GATEWAY",
    "centralPolicy": "GRADLE_NATIVE",
    "tierOneAllowlistAppliedToCentralTasks": false,
    "argumentsAndExitStatusPreserved": true
  },
  "lifecycle": {
    "trustedProducer": "EXPLICIT_WRITE_ONLY_HARNESS",
    "consumer": "CLEAN_STICKY_WRAPPER_READ_ONLY_BUILD",
    "consumerFromCacheTasksMinimum": 8,
    "consumerAttemptsPublish": false,
    "corruptObject": "VERIFIED_MISS_WITHOUT_BYTES_RETURNED",
    "serverOutage": "SUCCESSFUL_NATIVE_REBUILD",
    "producerConsumerOutputSHA256Equal": true,
    "producerOutageOutputSHA256Equal": true
  },
  "authority": {
    "proofOfConcept": true,
    "performanceClaim": false,
    "productionAuthorized": false,
    "soakRequired": false,
    "designPartnerRequired": false,
    "testOptimization": "OUT_OF_SCOPE"
  },
  "deferred": [
    "AUTOMATIC_TRUSTED_WRITER_AUTHORIZATION",
    "BUILDOPT_DECISION_STATE_CONSUMPTION",
    "TWO_MACHINE_WALL_TIME_MEASUREMENT",
    "PRODUCTION_HA_RBAC_KMS_BACKUPS"
  ]
}
