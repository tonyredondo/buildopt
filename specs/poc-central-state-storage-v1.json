{
  "schemaVersion": "buildopt.poc/central-state-storage/v1",
  "workItem": "POC-CENTRAL-STATE-STORAGE-001",
  "root": {
    "owner": "buildopt-server",
    "writerLease": "EXISTING_PROCESS_LIFETIME_EXCLUSIVE_LOCK",
    "blobStore": "blobs/sha256",
    "metadata": "state.sqlite",
    "physicalBlobDeduplication": true,
    "logicalMetadataSharedWithGradleCache": false
  },
  "sqlite": {
    "schemaVersion": 1,
    "journalMode": "WAL",
    "synchronous": "FULL",
    "foreignKeys": true,
    "busyTimeoutMs": 5000,
    "tables": [
      "schema_migrations",
      "state_objects",
      "state_manifests",
      "state_manifest_artifacts",
      "state_manifest_references",
      "state_heads",
      "state_cas_requests"
    ]
  },
  "publication": {
    "steps": [
      "PUT_VERIFIED_NAMESPACED_OBJECTS",
      "PUT_COMPLETE_IMMUTABLE_MANIFEST",
      "REVERIFY_ALL_BYTES_AND_REFERENCES",
      "CAS_EXACT_NEXT_HEAD"
    ],
    "headVisibleBeforeCAS": false,
    "exactReplay": "IDEMPOTENT",
    "changedReplay": "IDEMPOTENCY_CONFLICT",
    "concurrentLoser": "STATE_PRECONDITION_FAILED",
    "skippedGeneration": "GENERATION_CONFLICT"
  },
  "read": {
    "scope": [
      "REPOSITORY_SCOPE_SHA256",
      "STATE_KIND"
    ],
    "verification": [
      "HEAD_JCS_SHA256",
      "MANIFEST_JCS_SHA256",
      "HEAD_MANIFEST_BINDING",
      "NAMESPACED_ARTIFACT_METADATA",
      "COMPLETE_ARTIFACT_BYTES_SHA256",
      "EVIDENCE_REFERENCE_EXISTENCE"
    ],
    "selectionRequiresLocalRevalidation": true
  },
  "retention": {
    "stagedObjectOrManifest": "24_HOURS",
    "portfolio": "CURRENT_PLUS_30_DAYS_AFTER_SUPERSEDED",
    "evidence": "WHILE_REFERENCED_PLUS_30_DAYS",
    "checkpoint": "24_HOURS_FROM_CREATED_AT",
    "gradleCachePolicyIndependent": true
  },
  "restart": {
    "sqliteIntegrityCheck": true,
    "foreignKeyCheck": true,
    "schemaIdentityCheck": true,
    "retentionMaintenanceBeforeBlobReconciliation": true,
    "headAndBytesReverifiedOnRead": true
  },
  "authority": {
    "proofOfConcept": true,
    "productionAuthorized": false,
    "soakRequired": false,
    "designPartnerRequired": false,
    "testOptimization": "OUT_OF_SCOPE"
  },
  "deferred": [
    "EXTERNAL_HTTPS_LISTENER",
    "TOKEN_ISSUANCE_AND_AUTHORIZATION",
    "CLIENT_CONNECT_AND_SYNC",
    "REMOTE_PROFILE_SELECTION",
    "TWO_MACHINE_VALUE_MEASUREMENT",
    "PRODUCTION_HA_RBAC_KMS_BACKUPS"
  ]
}
