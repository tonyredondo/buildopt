{
  "schemaVersion": "buildopt.specs/ci-orchestration/v1",
  "github": {
    "scheduleMinutes": 15,
    "workflowDispatch": true,
    "trustedRevisionsOnly": true,
    "maxLeasesPerRun": 1,
    "maxConcurrentValidationsPerRepository": 1,
    "concurrencyGroup": "buildopt-validation-${repository}",
    "cancelInProgress": false,
    "pullRequestTargetAllowed": false
  },
  "budget": {
    "rollingSevenDayPercent": 5,
    "rollingTwentyFourHourPercent": 10,
    "borrowingAllowed": false
  },
  "isolationKeys": [
    "worktree",
    "writableOutputs",
    "gradleUserHome",
    "configurationCache",
    "daemon",
    "l1Cache",
    "writeCredential"
  ],
  "attemptStates": [
    "CREATED",
    "POLICY_BOUND",
    "GRADLE_STARTED",
    "TASK_ACTION_STARTED",
    "VALIDATED",
    "COMMITTED",
    "ABORTED"
  ],
  "cases": [
    {
      "id": "normal-stable-is-authoritative",
      "jobKind": "NORMAL",
      "trustedRevision": true,
      "arms": ["STABLE_POLICY"],
      "naturalRunnerMs24h": 100000,
      "naturalRunnerMs7d": 700000,
      "usedRunnerMs24h": 0,
      "usedRunnerMs7d": 0,
      "requestedRunnerMs": 0,
      "activeValidations": 0,
      "isolated": true,
      "terminalEvent": "COMPLETE",
      "expectedDecision": "RUN_AUTHORITATIVE",
      "expectedReservation": "NOT_REQUIRED",
      "expectedAttempt": "NOT_CREATED",
      "normalJobRemainsAuthoritative": true
    },
    {
      "id": "normal-qualified-candidate-is-one-arm",
      "jobKind": "NORMAL",
      "trustedRevision": true,
      "arms": ["QUALIFIED_CANDIDATE"],
      "naturalRunnerMs24h": 100000,
      "naturalRunnerMs7d": 700000,
      "usedRunnerMs24h": 0,
      "usedRunnerMs7d": 0,
      "requestedRunnerMs": 0,
      "activeValidations": 0,
      "isolated": true,
      "terminalEvent": "COMPLETE",
      "expectedDecision": "RUN_AUTHORITATIVE",
      "expectedReservation": "NOT_REQUIRED",
      "expectedAttempt": "NOT_CREATED",
      "normalJobRemainsAuthoritative": true
    },
    {
      "id": "normal-job-cannot-run-two-arms",
      "jobKind": "NORMAL",
      "trustedRevision": true,
      "arms": ["CONTROL", "QUALIFIED_CANDIDATE"],
      "naturalRunnerMs24h": 100000,
      "naturalRunnerMs7d": 700000,
      "usedRunnerMs24h": 0,
      "usedRunnerMs7d": 0,
      "requestedRunnerMs": 0,
      "activeValidations": 0,
      "isolated": true,
      "terminalEvent": "COMPLETE",
      "expectedDecision": "REJECT_MULTIPLE_AUTHORITATIVE_ARMS",
      "expectedReservation": "NOT_REQUIRED",
      "expectedAttempt": "NOT_CREATED",
      "normalJobRemainsAuthoritative": true
    },
    {
      "id": "trusted-validation-leases-with-budget",
      "jobKind": "VALIDATION",
      "trustedRevision": true,
      "arms": ["CANDIDATE", "CONTROL"],
      "naturalRunnerMs24h": 100000,
      "naturalRunnerMs7d": 700000,
      "usedRunnerMs24h": 4000,
      "usedRunnerMs7d": 20000,
      "requestedRunnerMs": 5000,
      "activeValidations": 0,
      "isolated": true,
      "terminalEvent": "COMPLETE",
      "expectedDecision": "LEASE",
      "expectedReservation": "RELEASE_UNUSED",
      "expectedAttempt": "COMMITTED",
      "normalJobRemainsAuthoritative": true
    },
    {
      "id": "fork-or-untrusted-revision-is-rejected",
      "jobKind": "VALIDATION",
      "trustedRevision": false,
      "arms": ["CANDIDATE", "CONTROL"],
      "naturalRunnerMs24h": 100000,
      "naturalRunnerMs7d": 700000,
      "usedRunnerMs24h": 0,
      "usedRunnerMs7d": 0,
      "requestedRunnerMs": 1000,
      "activeValidations": 0,
      "isolated": true,
      "terminalEvent": "COMPLETE",
      "expectedDecision": "REJECT_UNTRUSTED_REVISION",
      "expectedReservation": "NOT_RESERVED",
      "expectedAttempt": "NOT_CREATED",
      "normalJobRemainsAuthoritative": true
    },
    {
      "id": "daily-budget-does-not-borrow",
      "jobKind": "VALIDATION",
      "trustedRevision": true,
      "arms": ["CANDIDATE", "CONTROL"],
      "naturalRunnerMs24h": 100000,
      "naturalRunnerMs7d": 700000,
      "usedRunnerMs24h": 9500,
      "usedRunnerMs7d": 20000,
      "requestedRunnerMs": 1000,
      "activeValidations": 0,
      "isolated": true,
      "terminalEvent": "COMPLETE",
      "expectedDecision": "REJECT_DAILY_BUDGET",
      "expectedReservation": "NOT_RESERVED",
      "expectedAttempt": "INCONCLUSIVE",
      "normalJobRemainsAuthoritative": true
    },
    {
      "id": "weekly-budget-does-not-borrow",
      "jobKind": "VALIDATION",
      "trustedRevision": true,
      "arms": ["CANDIDATE", "CONTROL"],
      "naturalRunnerMs24h": 100000,
      "naturalRunnerMs7d": 700000,
      "usedRunnerMs24h": 1000,
      "usedRunnerMs7d": 34500,
      "requestedRunnerMs": 1000,
      "activeValidations": 0,
      "isolated": true,
      "terminalEvent": "COMPLETE",
      "expectedDecision": "REJECT_WEEKLY_BUDGET",
      "expectedReservation": "NOT_RESERVED",
      "expectedAttempt": "INCONCLUSIVE",
      "normalJobRemainsAuthoritative": true
    },
    {
      "id": "one-concurrent-validation-per-repository",
      "jobKind": "VALIDATION",
      "trustedRevision": true,
      "arms": ["CANDIDATE", "CONTROL"],
      "naturalRunnerMs24h": 100000,
      "naturalRunnerMs7d": 700000,
      "usedRunnerMs24h": 0,
      "usedRunnerMs7d": 0,
      "requestedRunnerMs": 1000,
      "activeValidations": 1,
      "isolated": true,
      "terminalEvent": "COMPLETE",
      "expectedDecision": "REJECT_CONCURRENCY",
      "expectedReservation": "NOT_RESERVED",
      "expectedAttempt": "QUEUED",
      "normalJobRemainsAuthoritative": true
    },
    {
      "id": "shared-writable-state-is-rejected",
      "jobKind": "VALIDATION",
      "trustedRevision": true,
      "arms": ["CANDIDATE", "CONTROL"],
      "naturalRunnerMs24h": 100000,
      "naturalRunnerMs7d": 700000,
      "usedRunnerMs24h": 0,
      "usedRunnerMs7d": 0,
      "requestedRunnerMs": 1000,
      "activeValidations": 0,
      "isolated": false,
      "terminalEvent": "COMPLETE",
      "expectedDecision": "REJECT_ISOLATION",
      "expectedReservation": "NOT_RESERVED",
      "expectedAttempt": "ABORTED",
      "normalJobRemainsAuthoritative": true
    },
    {
      "id": "cancellation-releases-reservation",
      "jobKind": "VALIDATION",
      "trustedRevision": true,
      "arms": ["CANDIDATE", "CONTROL"],
      "naturalRunnerMs24h": 100000,
      "naturalRunnerMs7d": 700000,
      "usedRunnerMs24h": 0,
      "usedRunnerMs7d": 0,
      "requestedRunnerMs": 1000,
      "activeValidations": 0,
      "isolated": true,
      "terminalEvent": "CANCEL",
      "expectedDecision": "LEASE",
      "expectedReservation": "RELEASE_UNUSED",
      "expectedAttempt": "ABORTED",
      "normalJobRemainsAuthoritative": true
    },
    {
      "id": "dead-owner-is-reconciled-without-duplicate",
      "jobKind": "VALIDATION",
      "trustedRevision": true,
      "arms": ["CANDIDATE", "CONTROL"],
      "naturalRunnerMs24h": 100000,
      "naturalRunnerMs7d": 700000,
      "usedRunnerMs24h": 0,
      "usedRunnerMs7d": 0,
      "requestedRunnerMs": 1000,
      "activeValidations": 0,
      "isolated": true,
      "terminalEvent": "OWNER_DEAD",
      "expectedDecision": "LEASE",
      "expectedReservation": "RELEASE_UNUSED",
      "expectedAttempt": "ABORTED_RECONCILED",
      "normalJobRemainsAuthoritative": true
    },
    {
      "id": "unknown-task-boundary-never-commits",
      "jobKind": "VALIDATION",
      "trustedRevision": true,
      "arms": ["CANDIDATE", "CONTROL"],
      "naturalRunnerMs24h": 100000,
      "naturalRunnerMs7d": 700000,
      "usedRunnerMs24h": 0,
      "usedRunnerMs7d": 0,
      "requestedRunnerMs": 1000,
      "activeValidations": 0,
      "isolated": true,
      "terminalEvent": "UNKNOWN_TASK_BOUNDARY",
      "expectedDecision": "LEASE",
      "expectedReservation": "RELEASE_UNUSED",
      "expectedAttempt": "ABORTED",
      "normalJobRemainsAuthoritative": true
    }
  ]
}
