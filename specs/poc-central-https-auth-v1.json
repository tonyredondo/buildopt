{
  "schemaVersion": "buildopt.poc/central-https-auth/v1",
  "workItem": "POC-CENTRAL-HTTPS-AUTH-001",
  "listener": {
    "centralTransport": "HTTPS_ONLY",
    "minimumTLSVersion": "TLS_1_3",
    "trustedCertificateRequired": true,
    "externalIPv4AllowedOnlyWithTLS": true,
    "plaintextExternalIPv4Allowed": false,
    "loopbackHTTPPreservedForInvocationLocalGateway": true
  },
  "credential": {
    "type": "OWNER_ISSUED_OPAQUE_BEARER",
    "entropyBytes": 32,
    "maximumLifetimeHours": 720,
    "storedForm": "DOMAIN_SEPARATED_SHA256_ONLY",
    "rawTokenReturned": "ONCE_AT_ISSUE",
    "revocation": "EFFECTIVE_ON_NEXT_REQUEST_WITHOUT_RESTART",
    "capabilities": [
      "CACHE_READ",
      "CACHE_WRITE",
      "STATE_READ",
      "STATE_WRITE"
    ]
  },
  "scope": [
    "REPOSITORY_SCOPE_SHA256",
    "TENANT",
    "REPOSITORY",
    "TRUST_DOMAIN",
    "CACHE_NAMESPACE",
    "NAMESPACE_GENERATION"
  ],
  "routes": {
    "cache": "/cache/{cacheKey}",
    "stateObjects": "/api/v1/repositories/{repositoryScope}/state/{kind}/objects/{sha256}",
    "stateManifests": "/api/v1/repositories/{repositoryScope}/state/{kind}/manifests/{sha256}",
    "stateHead": "/api/v1/repositories/{repositoryScope}/state/{kind}/head",
    "stateHeadCAS": "/api/v1/repositories/{repositoryScope}/state/{kind}/head:cas"
  },
  "cacheRequest": {
    "namespaceHeader": "X-BuildOpt-Cache-Namespace",
    "requiresExactTokenNamespace": true
  },
  "cacheWrite": {
    "pendingAttemptHeader": "X-BuildOpt-Cache-Attempt",
    "requiresExactTokenRepositoryAndGeneration": true,
    "directUncommittedRead": false
  },
  "stateWrite": {
    "immutableObjectsAndManifests": true,
    "headMethod": "POST",
    "firstGenerationPrecondition": "If-None-Match: *",
    "laterGenerationPrecondition": "If-Match: \"{currentHeadSha256}\"",
    "exactReplay": "IDEMPOTENT",
    "staleHead": 412,
    "changedIdempotencyPayload": 409
  },
  "failClosed": {
    "missingOrInvalidToken": 401,
    "missingCapability": 403,
    "wrongRepositoryScope": 404,
    "plaintextCentralRequest": 426,
    "storageUnavailable": 503,
    "secretInLogsOrResponses": false
  },
  "authority": {
    "proofOfConcept": true,
    "singleOwnerOperatedService": true,
    "productionAuthorized": false,
    "soakRequired": false,
    "designPartnerRequired": false,
    "testOptimization": "OUT_OF_SCOPE"
  },
  "deferred": [
    "AUTOMATIC_CLIENT_CONNECT",
    "GRADLE_GATEWAY_REMOTE_FORWARDING",
    "BUILDOPT_STATE_SYNC",
    "REMOTE_PROFILE_SELECTION",
    "MULTI_MACHINE_VALUE_MEASUREMENT",
    "PRODUCTION_HA_RBAC_KMS_BACKUPS"
  ]
}
