{
  "schemaVersion": "buildopt.specs/build-impact-automatic/v1",
  "workItems": ["BIA-F4-001", "BIA-F4-002", "BIA-F4-003"],
  "discovery": {
    "implementation": "buildimpact.Discover",
    "adapterVersion": "gradle-runtime-v1",
    "source": "EVALUATED_GRADLE_PROJECT_MODEL",
    "supportedEntrypoints": ["assemble", "jar", "classes", "compileJava", "compileKotlin", "testClasses"],
    "taskSelectors": "GRADLE_NATIVE_UNQUALIFIED_OR_EXACT_PATH",
    "parallelConfiguration": "PROJECT_LOCAL_SNAPSHOT",
    "cyclicProjectDependencies": "CONSERVATIVE_STRONGLY_CONNECTED_COMPONENT",
    "cyclicSourceBoundary": "EXPANDED_FOR_CONSERVATIVE_AFFECTED_CLOSURE",
    "directSourceOwnership": "ORIGINAL_MEMBER_PATHS_OPTIONAL_SUBSET",
    "repositoryLocalIncludedBuilds": "GLOBAL_CHANGE_PATH",
    "unknownPolicy": "FULL_GRAPH"
  },
  "generatedState": {
    "graphSchema": "buildopt.build-impact/declared-graph/v1",
    "manifestSchema": "buildopt.build-impact/generated-manifest/v1",
    "canonicalDigests": ["customerManifest", "discoverySnapshot", "generatedGraph"],
    "repositoryReview": true,
    "driftPolicy": "FAIL_CLOSED"
  },
  "selection": {
    "boundary": "buildimpact.PlanSelection",
    "promotion": "BIA-002_UNCHANGED",
    "requiredProof": "FULL_VERSUS_SELECTED_ARTIFACT_EQUIVALENCE",
    "testOptimization": "PRESERVED_SEPARATELY_NEVER_SELECTED",
    "productionAffectedClosure": "EXPANDED_SOURCE_BOUNDARY_UNCHANGED",
    "pocDirectAttribution": "OWNED_SOURCE_PATHS_WITH_EQUAL_SPECIFICITY_FALLBACK"
  },
  "fallbacks": [
    "INCLUDED_BUILD_OUTSIDE_REPOSITORY",
    "UNSUPPORTED_OR_TEST_ENTRYPOINT",
    "DISCOVERY_FAILURE",
    "GENERATED_STATE_DRIFT",
    "GLOBAL_CHANGE",
    "UNKNOWN_CHANGE_PATH",
    "INCOMPLETE_COVERAGE",
    "BIA_002_NOT_QUALIFIED"
  ]
}
