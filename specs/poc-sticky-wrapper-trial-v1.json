    "separateGradleHome": true,
    "separateDaemon": true,
    "separateCache": true,
    "separateBuildOptState": true,
    "requiredOutputEquivalence": "EXACT_SHA256"
  },
  "budget": {
    "maxExtraPermille": 50,
    "maxConcurrentPerRepository": 1,
    "reservationBeforeRun": true,
    "actualCostIsCandidatePlusNative": true,
    "cancelReleasesUnusedReservation": true,
    "exhaustedAction": "RETAIN_NATIVE_AND_DO_NOT_SCHEDULE"
  },
  "authority": {
    "proofOfConcept": true,
    "trustedCIOnly": true,
    "productionAuthorized": false,
