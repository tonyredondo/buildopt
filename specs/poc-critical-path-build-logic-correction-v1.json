{
  "schemaVersion": "buildopt.specs/poc-critical-path-build-logic-correction/v1",
  "predecessor": "STOP_CRITICAL_PATH_FIRST_REVIEWED_NATIVE_PATCH_NO_PROPOSAL_BREADTH",
  "selectionPolicy": "RETAINED_NATIVE_CRITICAL_PATH_THEN_EXPLICIT_OWNER_BUILD_LOGIC_OPTOUT",
  "sourceGate": {
    "requiredConclusiveFamilies": 5,
    "minimumProposalFamilies": 3,
    "minimumAddressableMilliseconds": 500,
    "minimumAddressablePercent": 2,
    "hardDependencyCriticalPathRequired": true,
    "literalTaskOrTypeBindingRequired": true,
    "allowedCorrectionClasses": [
      "REMOVE_EXPLICIT_CACHE_DISABLE",
      "RESTORE_STATE_TRACKING",
      "ENABLE_EXPLICIT_INCREMENTAL_MODE"
    ]
  },
  "correctnessGate": {
    "exactCompleteOutputs": true,
    "crossRootBehavior": true,
    "requiredInvalidation": true,
    "exactRevert": true,
    "maximumProductFailures": 0
  },
  "valueGate": {
    "balancedPairs": 8,
    "requiredPositivePairs": 8,
    "minimumMeanSavingMilliseconds": 500,
    "minimumMeanSavingPercent": 2,
    "positivePaired95Interval": true,
    "nonRegressiveCandidateP95": true,
    "maximumCombinedPaybackBuilds": 300
  },
  "budget": {
    "maximumSourceFamilies": 5,
    "maximumAdditionalDiskGiB": 4,
    "sourceClassificationGradleStarts": 0
  },
  "boundaries": {
    "retainedDiagnosticsAreNewTimingSamples": false,
    "absenceProvesAllBuildLogicOptimal": false,
    "upstreamPullRequest": false,
    "defaultBranchMutation": false,
    "productionAuthorized": false,
    "automaticApply": false,
    "automaticMerge": false,
    "soak": false,
    "designPartner": false,
    "testOptimization": "OUT_OF_SCOPE"
  }
}
