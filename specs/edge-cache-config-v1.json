{
  "schemaVersion": "buildopt.specs/edge-cache-config/v1",
  "workItem": "C2-001",
  "profile": "OWNER_POC_SINGLE_NODE",
  "configuration": {
    "schemaVersion": "buildopt.edge-cache/config/v1",
    "maximumBytes": 65536,
    "fileType": "REGULAR_NOT_SYMLINK",
    "fileMode": "0600",
    "decoding": "STRICT_JSON_NO_UNKNOWN_FIELDS_NO_TRAILING_DOCUMENT",
    "secrets": "ABSOLUTE_PATHS_ONLY"
  },
  "server": {
    "listener": "127.0.0.1:<valid-port>",
    "activation": "NOT_IMPLEMENTED_IN_C2_001"
  },
  "shared": {
    "baseUrl": "HTTPS_OR_EXPLICIT_IPV4_LOOPBACK_HTTP_ORIGIN",
    "credential": "PRIVATE_FILE_PATH",
    "redirectAuthority": "NONE"
  },
  "storage": {
    "filesystemPolicy": "ALLOWLIST_PROVEN_LOCAL",
    "minimumCapacityBytes": 1073741824,
    "maximumCapacityBytes": 536870912000,
    "maximumObjectBytes": 104857600,
    "maximumStableTtlSeconds": 2592000,
    "maximumPendingTtlSeconds": 86400,
    "highWatermarkPercent": 85,
    "lowWatermarkPercent": 75,
    "protectedPercent": 80,
    "pathPolicy": "ABSOLUTE_CLEAN_NON_ROOT_DISJOINT"
  },
  "authority": {
    "commit": "SHARED_ONLY",
    "collision": "SHARED_ONLY",
    "offlineRead": "COMMITTED_CURRENT_REVOCATION",
    "offlineWriteVisibility": "ATTEMPT_ONLY_PENDING",
    "compression": "DISABLED_UNTIL_MEASURED"
  },
  "boundaries": {
    "closes": [
      "C2-001"
    ],
    "doesNotClose": [
      "C2-002",
      "C2-003",
      "C2-004",
      "C2-005",
      "C2-G01",
      "EIGHT_HOUR_SOAK",
      "EXTERNAL_DESIGN_PARTNER_VALIDATION",
      "PRODUCTION_HARDENING"
    ],
    "ownerOperatedProofOfConcept": true
  }
}
