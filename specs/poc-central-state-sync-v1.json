{
  "schemaVersion": "buildopt.poc/central-state-sync/v1",
  "workItem": "POC-CENTRAL-STATE-SYNC-001",
  "cli": {
    "connect": "buildopt connect HTTPS_ORIGIN --token-file PATH [--ca-file PATH]",
    "sync": "buildopt sync",
    "normalBuildUnchanged": true
  },
  "connection": {
    "defaultDirectory": ".buildopt/central/v1",
    "privateFiles": [
      "connection.json",
      "token",
      "ca.pem"
    ],
    "tokenVisibleToGradle": false,
    "repositoryScope": "SHA256_DERIVED_FROM_REPOSITORY_ID",
    "transport": "HTTPS_TLS_1_3_MINIMUM",
    "redirectsFollowed": false
  },
  "state": {
    "sourceDirectory": ".buildopt/optimize/v1",
    "manualBuildOptFilesRequired": false,
    "kinds": [
      "EVIDENCE",
      "PORTFOLIO",
      "CHECKPOINT"
    ],
    "bundleSchema": "buildopt.poc/central-state-bundle/v1",
    "canonicalization": "RFC_8785_JCS",
    "fileDigestsVerified": true,
    "publicationOrder": [
      "IMMUTABLE_OBJECT",
      "IMMUTABLE_MANIFEST",
      "COMPARE_AND_SWAP_HEAD"
    ],
    "portfolioReferencesEvidenceManifest": true,
    "checkpointExpiryHours": 24
  },
  "lifecycle": {
    "firstSync": "PUSHED",
    "noChangeSync": "NO_CHANGE",
    "cleanConsumer": "PULLED",
    "concurrentUpdate": "CONCURRENT_REMOTE_WON",
    "interruptedPublication": "EXACT_RETRY",
    "offline": "VERIFIED_SNAPSHOT_ONLY",
    "corruptSnapshot": "OFFLINE_NO_SNAPSHOT",
    "incompatibleOrOlderLocalState": "REMOTE_RETAINED_WITH_NATIVE_FALLBACK"
  },
  "security": {
    "requiredReadCapability": "STATE_READ",
    "writeCapability": "STATE_WRITE",
    "credentialFilesPrivate": true,
    "responseDigestsVerified": true,
    "maximumBundleFiles": 64,
    "maximumBundleBytes": 16777216
  },
  "authority": {
    "proofOfConcept": true,
    "selectionRequiresLocalRevalidation": true,
    "productionAuthorized": false,
    "wallTimeClaim": false,
    "soakRequired": false,
    "designPartnerRequired": false,
    "testOptimization": "OUT_OF_SCOPE"
  },
  "deferred": [
    "REMOTE_PROFILE_SELECTION_INSIDE_BUILDOPT_OPTIMIZE",
    "AUTOMATIC_CENTRAL_GRADLE_CACHE_CONFIGURATION",
    "TWO_MACHINE_INSTALLED_PATH",
    "CENTRALIZED_WALL_TIME_VALUE",
    "PRODUCTION_HA_RBAC_KMS_BACKUPS"
  ]
}
