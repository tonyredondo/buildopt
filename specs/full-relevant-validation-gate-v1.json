{
  "schemaVersion": "buildopt.specs/full-relevant-validation-gate/v1",
  "trackerId": "C4-006",
  "localPrerequisite": "C4-005_PASSED",
  "applicability": {
    "evidenceDigestRequired": true,
    "required": "FULL_RELEVANT_VALIDATION",
    "notRequired": "PASS_WITHOUT_REMOTE_CONTACT"
  },
  "request": {
    "endpoint": "SUBMIT_TEST_BUILD_VALIDATION",
    "pollEndpoint": "GET_TEST_BUILD_VALIDATION",
    "contextBound": ["requestId", "tenant", "repository", "trustDomain", "revision", "sourceStateDigest", "actionId", "policyDigest", "deadline"],
    "artifactSetDigestMustEqualLocalCandidate": true,
    "artifactRetrievalKinds": ["CUSTOMER_CHANNEL", "EPHEMERAL_HTTPS"],
    "callerFilesystemPathsRejected": true,
    "idempotencyKey": "actionId:artifactSetDigest"
  },
  "transport": {
    "generatedClient": true,
    "exactRetryCount": 1,
    "sameBodyIdempotencyKeyAndDeadline": true,
    "maximumPolls": 128,
    "maximumPollDelayMs": 5000,
    "maximumOriginalDeadlineHours": 24,
    "stableJitter": true,
    "responseRequestIdRequired": true
  },
  "result": {
    "signature": "Ed25519",
    "canonicalization": "JCS",
    "domain": "test-optimization/v1\\nTEST_VALIDATION_RESULT\\n<payloadDigest>\\n<keyId>",
    "exactContextAndArtifactsRequired": true,
    "passed": "ALLOW_ACTION",
    "failed": "BLOCK_ACTION",
    "inconclusive": "BLOCK_ACTION"
  },
  "remoteMutationPerformed": false,
  "closesGate": "C4-G02",
  "doesNotClose": ["C4-004", "C4-007", "C4-008", "C4-009", "C4-G01", "C4-G03", "C4-G04", "C4-G05", "C4-G06"]
}
