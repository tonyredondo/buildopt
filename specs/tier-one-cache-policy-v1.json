{
  "schemaVersion": "buildopt.specs/tier-one-cache-policy/v1",
  "policyId": "TIER_ONE_CACHE_POLICY_V1",
  "activation": {
    "pluginId": "dev.buildopt.tier-one-policy",
    "effect": "RESTRICT_ONLY",
    "cacheConfigurationOwner": "A0-003"
  },
  "provenRuntimes": [
    {
      "gradle": "8.14.3",
      "jdks": [17, 21],
      "operatingSystem": "linux",
      "architecture": "amd64"
    },
    {
      "gradle": "9.6.1",
      "jdks": [17, 21, 25],
      "operatingSystem": "linux",
      "architecture": "amd64"
    }
  ],
  "taskAllowlist": [
    {
      "id": "CORE_JAVA_SOURCE_SET_COMPILE_V1",
      "taskType": "org.gradle.api.tasks.compile.JavaCompile",
      "implementation": "org.gradle.api.tasks.compile.JavaCompile_Decorated",
      "providerPluginId": "java",
      "providerVersion": "GRADLE_RUNTIME",
      "sourceSetBinding": "compileJavaTaskName",
      "actions": [
        "org.gradle.api.internal.project.taskfactory.IncrementalTaskAction"
      ]
    }
  ],
  "artifactTransformAllowlist": [],
  "defaultDeny": {
    "disallowedTask": "DO_NOT_CACHE",
    "testWithoutGrant": "DO_NOT_CACHE",
    "modifiedAllowlistedTask": "DO_NOT_CACHE",
    "unknownArtifactTransform": "DISABLE_MANAGED_CACHE_INVOCATION",
    "unavailableTransformInventory": "DISABLE_MANAGED_CACHE_INVOCATION",
    "unsupportedRuntime": "DISABLE_MANAGED_CACHE_INVOCATION",
    "unavailableConfigurationCache": "DISABLE_FOR_REINSPECTION",
    "neutralPlugin": "UNCHANGED"
  }
}
