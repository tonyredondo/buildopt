{
  "schemaVersion": "buildopt.specs/gateway-rotation/v1",
  "gateId": "A0-G03",
  "goldenLane": {
    "platform": "linux-amd64",
    "gradle": "9.6.1",
    "jdk": 21,
    "dsls": ["GROOVY", "KOTLIN"]
  },
  "processLifecycle": {
    "implementation": "REAL_BUILDOPT_MANAGED_GATEWAY_PROCESS",
    "registration": "CURRENT_INVOCATION_SAME_UID_UNIX_SOCKET",
    "stableRestart": {
      "endpoint": "REUSED",
      "localCredential": "REUSED",
      "connectionGeneration": "REUSED"
    },
    "rotationTrigger": "PERSISTED_ENDPOINT_BIND_FAILURE",
    "completeRotation": [
      "endpoint",
      "localCredential",
      "connectionGeneration"
    ]
  },
  "configurationCache": {
    "client": "org.gradle.caching.http.HttpBuildCache",
    "stableRestart": "REUSED",
    "completeRotation": "INVALIDATED_ONCE",
    "rotatedReplay": "REUSED",
    "cacheHitAfterRestart": true,
    "cacheHitAfterRotation": true,
    "upstreamCredentialInGradle": false
  },
  "persistence": {
    "file": "gateway-state.json",
    "mode": "0600",
    "contains": [
      "loopbackAddress",
      "localUsername",
      "localCredential",
      "connectionGeneration"
    ],
    "excludes": [
      "upstreamEndpoint",
      "upstreamCredential",
      "authorityDigest",
      "policy",
      "namespace"
    ]
  },
  "concurrentSlots": {
    "realProcesses": 2,
    "distinctLocalIdentities": true,
    "crossLocalCredential": 401,
    "bindingIsolation": [
      "upstreamEndpoint",
      "upstreamCredential",
      "authorityDigest",
      "policy",
      "namespace"
    ]
  },
  "boundaries": {
    "closes": ["A0-G03"],
    "doesNotClose": ["A0-G04", "A0-G05", "A0-G06", "A0-G08", "A1-G04"],
    "completeSpoolFaultMatrix": "A0-G04",
    "completeCommitFaultRecovery": "A0-G05"
  }
}
