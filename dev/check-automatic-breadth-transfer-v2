#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [summary.json]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_summary=${1:-"${buildopt_repo_root}/benchmarks/results/poc-automatic-breadth-transfer-v2/summary.json"}
buildopt_contract="${buildopt_repo_root}/specs/poc-automatic-breadth-transfer-v2.json"
buildopt_subjects="${buildopt_repo_root}/specs/poc-generic-profile-matrix-v3.json"

for buildopt_command in awk cmp find grep jq seq sha256sum sort xargs; do
    command -v "${buildopt_command}" >/dev/null || {
        printf 'required incremental breadth checker command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done

[[ -s ${buildopt_summary} && -s ${buildopt_contract} && -s ${buildopt_subjects} ]] || {
    printf 'incremental breadth evidence or contract is unavailable\n' >&2
    exit 1
}
buildopt_evidence_root=$(cd -- "$(dirname -- "${buildopt_summary}")" && pwd -P)

[[ $(sha256sum "${buildopt_subjects}" | awk '{print $1}') == \
    $(jq -r '.frozenSubjects.sha256' "${buildopt_contract}") ]] || {
    printf 'incremental breadth subject contract drifted\n' >&2
    exit 1
}
[[ $(sha256sum "${buildopt_repo_root}/specs/poc-otel-spring-family-v2.tasks.txt" | \
    awk '{print $1}') == \
    $(jq -r '.frozenSubjects.opentelemetryEntrypointsSha256' "${buildopt_contract}") ]] || {
    printf 'incremental breadth OpenTelemetry workflow drifted\n' >&2
    exit 1
}

jq -e '
  . as $root |
  .schemaVersion == "buildopt.evidence/poc-automatic-breadth-transfer/v2" and
  .workItem == "POC-AUTOMATIC-BREADTH-TRANSFER-V2-001" and
  (.buildopt.revision | test("^[0-9a-f]{40}$")) and
  (.buildopt.executableSha256 | test("^[0-9a-f]{64}$")) and
  .buildopt.packageVersion == "0.7.0-dev" and
  (.subjects | length) == 5 and
  ([.subjects[].key] | unique | length) == 5 and
  .aggregation == {
    subjectCount:(.subjects|length),
    resultAvailable:([.subjects[]|select(.resultAvailable)]|length),
    discoveryComplete:([.subjects[]|select(.discovery.status == "COMPLETE")]|length),
    incrementalComplete:([.subjects[]|select(.incrementalLearning.status == "COMPLETE")]|length),
    calibrationComplete:([.subjects[]|select(.calibration.status == "COMPLETE")]|length),
    valueGatePassed:([.subjects[]|select(.calibration.valueGatePassed == true)]|length),
    economicallyQualified:([.subjects[]|select(.calibration.qualified == true)]|length),
    nativeRetained:([.subjects[]|select(.outcome == "NATIVE_RETAINED")]|length),
    ordinaryInvocations:([.subjects[].ordinaryInvocations]|add),
    measurementOnlyWorkflowRuns:([.subjects[].measurementOnlyWorkflowRuns]|add),
    aggregatePartitionsComplete:
      ([.subjects[]|select(.discovery.aggregatePartition.status == "COMPLETE")]|length),
    materializationsCaptured:
      ([.subjects[]|select(.discovery.materialization.status == "CAPTURED")]|length),
    productFailures:([.subjects[]|select(.productFailure)]|length),
    repositoryPercentagesAveraged:false,
    mechanismPercentagesAdded:false
  } and
  .aggregation.subjectCount == 5 and
  .aggregation.resultAvailable == 5 and
  .aggregation.discoveryComplete == 5 and
  .aggregation.incrementalComplete == 5 and
  .aggregation.calibrationComplete == 5 and
  .aggregation.ordinaryInvocations == 85 and
  .aggregation.measurementOnlyWorkflowRuns == 0 and
  .aggregation.productFailures == 0 and
  .boundaries == {
    proofOfConcept:true,productionAuthorized:false,
    automaticActivationOutsideOwnerCommand:false,soakRequired:false,
    designPartnerRequired:false,testOptimization:"OUT_OF_SCOPE"
  } and
  all(.subjects[];
    .buildopt == {
      revision:$root.buildopt.revision,
      executableSha256:$root.buildopt.executableSha256
    } and
    .processExitCode == 0 and .resultAvailable == true and
    .productFailure == false and .manualFilesRequired == 0 and
    .ordinaryInvocations == 17 and .measurementOnlyWorkflowRuns == 0 and
    .cleanWorkspaceBeforeEveryInvocation == true and
    (.invocationResults | length) == 17 and
    .native == {authoritative:true,exitCode:0,started:true} and
    .execution.authoritative == true and .execution.exitCode == 0 and
    .productionAuthorized == false and .testOptimization == "OUT_OF_SCOPE")
' "${buildopt_summary}" >/dev/null || {
    printf 'incremental breadth terminal summary is invalid\n' >&2
    exit 1
}

while IFS= read -r buildopt_key; do
    buildopt_capture="${buildopt_evidence_root}/${buildopt_key}/capture.json"
    buildopt_expected=$(jq -c --arg key "${buildopt_key}" \
        '.repositories[] | select(.key == $key)' "${buildopt_subjects}")
    [[ -s ${buildopt_capture} && -n ${buildopt_expected} ]] || {
        printf 'incremental breadth capture is unavailable: %s\n' "${buildopt_key}" >&2
        exit 1
    }

    jq -e --arg repositoryId "$(jq -r '.repositoryId' <<<"${buildopt_expected}")" \
        --arg baseRevision "$(jq -r '.publicRevision' <<<"${buildopt_expected}")" '
      .schemaVersion == "buildopt.evidence/automatic-breadth-subject/v2" and
      .repositoryId == $repositoryId and .baseRevision == $baseRevision and
      (.targetRevision | test("^[0-9a-f]{40}$")) and
      (.rawResultSha256 | test("^[0-9a-f]{64}$")) and
      (.stateTreeSha256 | test("^[0-9a-f]{64}$")) and
      .discovery.status == "COMPLETE" and
      .incrementalLearning.status == "COMPLETE" and
      .incrementalLearning.reason == "ORDINARY_OBSERVATIONS_COMPLETE" and
      .incrementalLearning.targetPairs == 8 and
      .incrementalLearning.pairsCompleted == 8 and
      .incrementalLearning.nextArm == "COMPLETE" and
      .incrementalLearning.fallbackSuccessful == true and
      .calibration.status == "COMPLETE" and
      .calibration.pairsRequested == 8 and
      .calibration.pairsMeasured == 8 and
      .calibration.maximumBreakEvenBuilds == 30 and
      .calibration.fallbackSuccessful == true and
      (.calibration.interval95SavedMs | length) == 2 and
      (.discovery.graph.totalProjects >= .discovery.graph.selectedProjects) and
      .discovery.graph.omittedProjects ==
        (.discovery.graph.totalProjects - .discovery.graph.selectedProjects) and
      (.discovery.materialization.status == "CAPTURED" or
       .discovery.materialization.status == "NOT_REQUIRED") and
      (if .calibration.qualified then
         .phase == "QUALIFIED" and .calibration.valueGatePassed == true and
         .calibration.reason == "CANDIDATE_CALIBRATION_QUALIFIED" and
         .calibration.breakEvenBuilds >= 1 and .calibration.breakEvenBuilds <= 30
       else
         .phase == "NATIVE_RETAINED" and .outcome == "NATIVE_RETAINED" and
         (.calibration.reason == "CALIBRATION_VALUE_NOT_PROVEN" or
          .calibration.reason == "CALIBRATION_BREAK_EVEN_EXCEEDED")
       end)
    ' "${buildopt_capture}" >/dev/null || {
        printf 'incremental breadth terminal decision is invalid: %s\n' \
            "${buildopt_key}" >&2
        exit 1
    }

    cmp -s <(jq -S --arg key "${buildopt_key}" \
        '.subjects[] | select(.key == $key)' "${buildopt_summary}") \
        <(jq -S . "${buildopt_capture}") || {
        printf 'incremental breadth summary differs from capture: %s\n' \
            "${buildopt_key}" >&2
        exit 1
    }

    for buildopt_sequence in $(seq 1 17); do
        buildopt_relative=$(printf '%s/invocation-%02d.json' \
            "${buildopt_key}" "${buildopt_sequence}")
        buildopt_invocation="${buildopt_evidence_root}/${buildopt_relative}"
        [[ -s ${buildopt_invocation} ]] || {
            printf 'incremental breadth invocation is unavailable: %s\n' \
                "${buildopt_relative}" >&2
            exit 1
        }
        buildopt_sha=$(sha256sum "${buildopt_invocation}" | awk '{print $1}')
        jq -e --argjson sequence "${buildopt_sequence}" \
            --arg path "${buildopt_relative}" --arg sha256 "${buildopt_sha}" \
            --slurpfile invocation "${buildopt_invocation}" '
          .invocationResults[$sequence - 1] as $metadata |
          ($invocation[0]) as $result |
          $metadata == {
            sequence:$sequence,path:$path,sha256:$sha256,
            outcome:$result.outcome,reason:$result.reason,phase:$result.phase,
            durationMs:$result.durationMs,executionMode:$result.execution.mode,
            exitCode:$result.execution.exitCode
          } and
          $result.schemaVersion == "buildopt.poc/optimize-result/v1" and
          $result.execution.exitCode == 0 and
          $result.productionAuthorized == false and
          $result.testOptimization == "OUT_OF_SCOPE"
        ' "${buildopt_capture}" >/dev/null || {
            printf 'incremental breadth invocation metadata drifted: %s\n' \
                "${buildopt_relative}" >&2
            exit 1
        }
    done

    buildopt_raw=$(jq -er '.rawResult' "${buildopt_capture}")
    buildopt_raw="${buildopt_evidence_root}/${buildopt_raw}"
    buildopt_state="${buildopt_evidence_root}/${buildopt_key}/state"
    [[ -s ${buildopt_raw} && -s ${buildopt_state}/result.json ]] || {
        printf 'incremental breadth terminal result or state is unavailable: %s\n' \
            "${buildopt_key}" >&2
        exit 1
    }
    [[ $(sha256sum "${buildopt_raw}" | awk '{print $1}') == \
        $(jq -r '.rawResultSha256' "${buildopt_capture}") ]] || {
        printf 'incremental breadth raw result hash drifted: %s\n' "${buildopt_key}" >&2
        exit 1
    }
    buildopt_state_sha=$(
        cd -- "${buildopt_state}"
        find . -type f -print0 | sort -z | xargs -0 -r sha256sum | \
            sha256sum | awk '{print $1}'
    )
    [[ ${buildopt_state_sha} == $(jq -r '.stateTreeSha256' "${buildopt_capture}") ]] || {
        printf 'incremental breadth state tree hash drifted: %s\n' "${buildopt_key}" >&2
        exit 1
    }
    cmp -s <(jq -S . "${buildopt_raw}") \
        <(jq -S . "${buildopt_state}/result.json") || {
        printf 'incremental breadth state result differs from raw result: %s\n' \
            "${buildopt_key}" >&2
        exit 1
    }
    cmp -s <(jq -S . "${buildopt_raw}") \
        <(jq -S . "${buildopt_evidence_root}/${buildopt_key}/invocation-17.json") || {
        printf 'incremental breadth final invocation differs from raw result: %s\n' \
            "${buildopt_key}" >&2
        exit 1
    }

    jq -e '
      . as $root |
      .incrementalLearning as $learning |
      $learning.incrementalCostMs ==
        ($learning.baseline.incrementalOverheadMs +
         ([$learning.observations[].incrementalOverheadMs] | add)) and
      ($learning.expectedOutputSha256 | test("^[0-9a-f]{64}$")) and
      $learning.expectedOutputCount >= 1 and
      ($learning.observations | length) == 16 and
      $learning.baseline.arm == "DISCOVERY_CONTROL" and
      $learning.baseline.order == "BASELINE" and
      $learning.baseline.sequence == 0 and $learning.baseline.pair == 0 and
      $learning.baseline.exitCode == 0 and
      $learning.baseline.requiredOutputSha256 == $learning.expectedOutputSha256 and
      $learning.baseline.requiredOutputCount == $learning.expectedOutputCount and
      ([range(0; 16) as $index |
        $learning.observations[$index] as $observation |
        ($observation.sequence == ($index + 1)) and
        ($observation.pair == ((($index / 2) | floor) + 1)) and
        ($observation.exitCode == 0) and
        ($observation.productAttributableFailure == false) and
        ($observation.requiredOutputSha256 == $learning.expectedOutputSha256) and
        ($observation.requiredOutputCount == $learning.expectedOutputCount) and
        (if ((((($index / 2) | floor) + 1) % 2) == 1) then
           ($observation.order == "CONTROL_FIRST") and
           ($observation.arm == (if ($index % 2) == 0 then "CONTROL" else "CANDIDATE" end))
         else
           ($observation.order == "CANDIDATE_FIRST") and
           ($observation.arm == (if ($index % 2) == 0 then "CANDIDATE" else "CONTROL" end))
         end)] | all) and
      ([range(0; 16; 2) as $index |
        $learning.observations[$index] as $first |
        $learning.observations[$index + 1] as $second |
        (if $first.arm == "CONTROL" then
           {control:$first.durationMs,candidate:$second.durationMs}
         else
           {control:$second.durationMs,candidate:$first.durationMs}
         end)] as $pairs |
        (([$pairs[].control] | add / length) == $root.calibration.controlMeanMs) and
        (([$pairs[].candidate] | add / length) == $root.calibration.candidateMeanMs) and
        (([$pairs[] | .control - .candidate] | add / length) == $root.calibration.meanSavedMs) and
        (([$pairs[] | select(.control > .candidate)] | length) ==
          $root.calibration.positivePairs) and
        (([$pairs[].control] | max) == $root.calibration.controlP95Ms) and
        (([$pairs[].candidate] | max) == $root.calibration.candidateP95Ms) and
        ((if $root.calibration.meanSavedMs > 0 then
           ($learning.incrementalCostMs / $root.calibration.meanSavedMs | ceil)
          else 0 end) == $root.calibration.breakEvenBuilds)) and
      $root.calibration.calibrationCostMs == $learning.incrementalCostMs
    ' "${buildopt_capture}" >/dev/null || {
        printf 'incremental breadth measurements cannot be recomputed: %s\n' \
            "${buildopt_key}" >&2
        exit 1
    }

    buildopt_materialization_status=$(jq -r '.discovery.materialization.status' \
        "${buildopt_capture}")
    if [[ ${buildopt_materialization_status} == CAPTURED ]]; then
        buildopt_manifest="${buildopt_state}/materialization/manifest.json"
        [[ -s ${buildopt_manifest} ]] || {
            printf 'incremental breadth materialization manifest is unavailable: %s\n' \
                "${buildopt_key}" >&2
            exit 1
        }
        [[ $(sha256sum "${buildopt_manifest}" | awk '{print $1}') == \
            $(jq -r '.discovery.materialization.manifestSha256' "${buildopt_capture}") ]] || {
            printf 'incremental breadth materialization hash drifted: %s\n' \
                "${buildopt_key}" >&2
            exit 1
        }
        jq -e '
          .discovery.materialization.fileCount >= 1 and
          .discovery.materialization.byteCount >= 1 and
          (.discovery.materialization.patterns | length) >= 1
        ' "${buildopt_capture}" >/dev/null
    fi
done < <(jq -r '.subjects[].key' "${buildopt_summary}")

if grep -R -n -E '/tmp/buildopt-automatic-breadth\.|/home/[^/]+/' \
    "${buildopt_evidence_root}" >/dev/null; then
    printf 'incremental breadth evidence contains a host-local path\n' >&2
    exit 1
fi

"${buildopt_script_dir}/run" --toolchain go -- go test ./internal/launcher \
    -run 'TestExpectedOptimizeIncrementalArm|TestOptimizeIncrementalCheckpoint|TestCaptureOptimizeOutputMaterialization|TestOptimizeAggregatePartition' \
    -count=1 >/dev/null

printf 'Incremental automatic breadth transfer evidence: PASS\n'
