#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)) || [[ $1 != /* ]]; then
    printf 'usage: %s /absolute/result.json\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(CDPATH='' cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_contract="${buildopt_repo_root}/specs/poc-current-longitudinal-harness-v1.json"
buildopt_result=$1
buildopt_temp=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-af014a-check.XXXXXX")
trap 'test -n "${buildopt_temp:-}" && rm -rf -- "${buildopt_temp}"' EXIT

for buildopt_command in git jq sha256sum; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'AF-014A checker requires %s\n' "${buildopt_command}" >&2
        exit 1
    }
done

(
    cd -- "${buildopt_repo_root}/dev/current-longitudinal-harness"
    "${buildopt_script_dir}/run" --toolchain go -- go test -count=1 ./...
    "${buildopt_script_dir}/run" --toolchain go -- go vet ./...
    "${buildopt_script_dir}/run" --toolchain go -- \
        go run . "${buildopt_contract}" "${buildopt_result}"
)

buildopt_revision=$(jq -er '.evaluatedRevision' "${buildopt_result}")
git -C "${buildopt_repo_root}" cat-file -e "${buildopt_revision}^{commit}"
buildopt_archive_sha=$(
    git -C "${buildopt_repo_root}" archive "${buildopt_revision}" | sha256sum | awk '{print $1}'
)
[[ ${buildopt_archive_sha} == "$(jq -er '.sourceArchiveSha256' "${buildopt_result}")" ]] || {
    printf 'AF-014A source archive does not match the evaluated revision\n' >&2
    exit 1
}

jq '(.learning[0].timing.totalNs) += 1' "${buildopt_result}" \
    >"${buildopt_temp}/tampered-result.json"
if (
    cd -- "${buildopt_repo_root}/dev/current-longitudinal-harness"
    "${buildopt_script_dir}/run" --toolchain go -- \
        go run . "${buildopt_contract}" "${buildopt_temp}/tampered-result.json"
) >"${buildopt_temp}/tampered.out" 2>"${buildopt_temp}/tampered.err"; then
    printf 'AF-014A checker accepted a changed timing total\n' >&2
    exit 1
fi

jq '.methodology.learningAttempts = 17' "${buildopt_contract}" \
    >"${buildopt_temp}/changed-contract.json"
if (
    cd -- "${buildopt_repo_root}/dev/current-longitudinal-harness"
    "${buildopt_script_dir}/run" --toolchain go -- \
        go run . "${buildopt_temp}/changed-contract.json" "${buildopt_result}"
) >"${buildopt_temp}/contract.out" 2>"${buildopt_temp}/contract.err"; then
    printf 'AF-014A checker accepted a changed contract\n' >&2
    exit 1
fi

printf 'AF-014A installed harness result is internally consistent and source-bound\n'
