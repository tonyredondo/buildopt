#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)) || [[ "$1" != /* || -e "$1" ]]; then
    printf 'usage: %s ABSENT_ABSOLUTE_OUTPUT_DIR\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_temp=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-runtime-owner.XXXXXX")

buildopt_cleanup() {
    if [[ "${buildopt_temp}" == "${TMPDIR:-/tmp}/buildopt-runtime-owner."* ]]; then
        rm -rf -- "${buildopt_temp}"
    fi
}
trap buildopt_cleanup EXIT

for buildopt_command in awk cp date find jq mkdir nproc rm sha256sum; do
    if ! command -v "${buildopt_command}" >/dev/null 2>&1; then
        printf 'required runtime evaluation command is unavailable: %s\n' "${buildopt_command}" >&2
        exit 1
    fi
done
if [[ -z "${BUILDOPT_BENCHMARK_REVISION:-}" ]] &&
    ! command -v git >/dev/null 2>&1; then
    printf 'runtime evaluation requires git or BUILDOPT_BENCHMARK_REVISION\n' >&2
    exit 1
fi

if [[ -n "${BUILDOPT_BENCHMARK_RUNNER_FILE:-}" ]]; then
    if [[ ! -f "${BUILDOPT_BENCHMARK_RUNNER_FILE}" ]] ||
        ! jq -e '
            .qualifiedGoldenRunner == true and
            .cpuCount == 4 and
            .memoryBytes == 17179869184
        ' "${BUILDOPT_BENCHMARK_RUNNER_FILE}" >/dev/null; then
        printf 'runtime owner evaluation received an invalid runner observation\n' >&2
        exit 1
    fi
    buildopt_cpu_count=$(jq -er '.cpuCount' "${BUILDOPT_BENCHMARK_RUNNER_FILE}")
    buildopt_memory_bytes=$(jq -er '.memoryBytes' "${BUILDOPT_BENCHMARK_RUNNER_FILE}")
else
    buildopt_cpu_count=$(nproc)
    buildopt_memory_bytes=$(awk '/^MemTotal:/ {printf "%.0f\n", $2 * 1024; exit}' /proc/meminfo)
fi
if [[ "${buildopt_cpu_count}" != 4 ]] ||
    ((buildopt_memory_bytes < 14 * 1024 * 1024 * 1024)) ||
    ((buildopt_memory_bytes > 18 * 1024 * 1024 * 1024)); then
    printf 'runtime owner evaluation requires the 4-CPU/16-GiB runner class\n' >&2
    exit 1
fi

buildopt_oom_file=/sys/fs/cgroup/memory.events
buildopt_cgroup_path=$(awk -F: '$1 == "0" {print $3; exit}' /proc/self/cgroup)
if [[ -n "${buildopt_cgroup_path}" && -f "/sys/fs/cgroup${buildopt_cgroup_path}/memory.events" ]]; then
    buildopt_oom_file="/sys/fs/cgroup${buildopt_cgroup_path}/memory.events"
fi
if [[ ! -r "${buildopt_oom_file}" ]]; then
    printf 'cgroup v2 memory.events is required for OOM evidence\n' >&2
    exit 1
fi
buildopt_read_oom() {
    awk '$1 == "oom" || $1 == "oom_kill" {total += $2} END {print total + 0}' "${buildopt_oom_file}"
}

buildopt_gradle_home=${GRADLE_USER_HOME:-"${buildopt_repo_root}/.tools/gradle-user-home/local"}
mkdir -p -- "${buildopt_gradle_home}"
if [[ -n "${BUILDOPT_BENCHMARK_JAVA_HOME:-}" ]]; then
    GRADLE_USER_HOME="${buildopt_gradle_home}" \
        JAVA_HOME="${BUILDOPT_BENCHMARK_JAVA_HOME}" \
        PATH="${BUILDOPT_BENCHMARK_JAVA_HOME}/bin:${PATH}" \
        "${buildopt_repo_root}/gradlew" --no-daemon --version >/dev/null
else
    GRADLE_USER_HOME="${buildopt_gradle_home}" \
        "${buildopt_script_dir}/run" -- \
        "${buildopt_repo_root}/gradlew" --no-daemon --version >/dev/null
fi
buildopt_gradle=$(find \
    "${buildopt_gradle_home}/wrapper/dists/gradle-9.6.1-bin" \
    -type f -path '*/gradle-9.6.1/bin/gradle' -print -quit)
if [[ -z "${buildopt_gradle}" || ! -x "${buildopt_gradle}" ]]; then
    printf 'pinned Gradle 9.6.1 executable is unavailable\n' >&2
    exit 1
fi
if [[ -n "${BUILDOPT_BENCHMARK_JAVA_HOME:-}" ]]; then
    buildopt_java_home=${BUILDOPT_BENCHMARK_JAVA_HOME}
else
    buildopt_java_home=$("${buildopt_script_dir}/run" -- \
        java -XshowSettings:properties -version 2>&1 | \
        awk -F'= ' '/^[[:space:]]*java.home = / {print $2; exit}')
fi

buildopt_fixture="${buildopt_temp}/fixture"
mkdir -p -- "${buildopt_fixture}"
cat >"${buildopt_fixture}/settings.gradle" <<'SETTINGS'
rootProject.name = 'runtime-autotuning'
include 'worker01', 'worker02', 'worker03', 'worker04', 'worker05', 'worker06', 'worker07', 'worker08'
SETTINGS
cat >"${buildopt_fixture}/build.gradle" <<'GRADLE'
import org.gradle.api.tasks.bundling.AbstractArchiveTask
import org.gradle.api.tasks.bundling.Zip

plugins { id 'base' }

allprojects {
    group = 'dev.buildopt.runtime'
    version = '1.0.0'
}

subprojects {
    apply plugin: 'java-library'
    java {
        toolchain.languageVersion = JavaLanguageVersion.of(21)
    }
    tasks.withType(JavaCompile).configureEach {
        options.release = 17
        options.encoding = 'UTF-8'
    }
    tasks.withType(AbstractArchiveTask).configureEach {
        preserveFileTimestamps = false
        reproducibleFileOrder = true
    }
}

tasks.register('runtimeBundle', Zip) {
    dependsOn subprojects.collect { it.tasks.named('jar') }
    from subprojects.collect { it.layout.buildDirectory.dir('libs') }
    destinationDirectory = layout.buildDirectory.dir('runtime')
    archiveFileName = 'runtime-autotuning.zip'
    preserveFileTimestamps = false
    reproducibleFileOrder = true
}
GRADLE

for buildopt_project in {1..8}; do
    printf -v buildopt_project_name 'worker%02d' "${buildopt_project}"
    buildopt_source_root="${buildopt_fixture}/${buildopt_project_name}/src/main/java/dev/buildopt/runtime/${buildopt_project_name}"
    mkdir -p -- "${buildopt_source_root}"
    for buildopt_class in {1..256}; do
        printf -v buildopt_class_name 'Runtime%03d' "${buildopt_class}"
        cat >"${buildopt_source_root}/${buildopt_class_name}.java" <<JAVA
package dev.buildopt.runtime.${buildopt_project_name};

public final class ${buildopt_class_name} {
    private ${buildopt_class_name}() {}

    public static long evaluate(long input) {
        long value = input + ${buildopt_project}L + ${buildopt_class}L;
        for (int index = 0; index < 128; index++) {
            value = Long.rotateLeft(value * 31L + index, index & 31);
        }
        return value;
    }
}
JAVA
    done
done

for buildopt_arm in aa-a aa-b control candidate; do
    cp -R -- "${buildopt_fixture}" "${buildopt_temp}/${buildopt_arm}"
    mkdir -m 0700 -- "${buildopt_temp}/${buildopt_arm}-gradle-home"
done

buildopt_common=(
    --no-daemon
    --offline
    --no-configuration-cache
    --no-build-cache
    --parallel
    --warning-mode=fail
    --console=plain
)
if [[ -n "${BUILDOPT_BENCHMARK_JAVA_INSTALLATIONS_PATHS:-}" ]]; then
    buildopt_common+=(
        "-Dorg.gradle.java.installations.paths=${BUILDOPT_BENCHMARK_JAVA_INSTALLATIONS_PATHS}"
    )
fi

buildopt_run_arm() {
    local buildopt_arm=$1
    local buildopt_workers=$2
    local buildopt_heap=$3
    local buildopt_label=$4
    local buildopt_workspace="${buildopt_temp}/${buildopt_arm}"
    local buildopt_arm_home="${buildopt_temp}/${buildopt_arm}-gradle-home"
    local buildopt_project_cache="${buildopt_temp}/project-cache-${buildopt_label}"
    local buildopt_log="${buildopt_temp}/${buildopt_label}.log"
    local buildopt_started
    local buildopt_completed

    find "${buildopt_workspace}" -type d -name build -prune -exec rm -rf -- {} +
    rm -rf -- "${buildopt_project_cache}"
    buildopt_started=$(date +%s%3N)
    if ! GRADLE_USER_HOME="${buildopt_arm_home}" \
        JAVA_HOME="${buildopt_java_home}" \
        PATH="${buildopt_java_home}/bin:${PATH}" \
        "${buildopt_gradle}" \
        "${buildopt_common[@]}" \
        "--max-workers=${buildopt_workers}" \
        "-Dorg.gradle.jvmargs=-Xmx${buildopt_heap}m -Dfile.encoding=UTF-8" \
        --project-cache-dir "${buildopt_project_cache}" \
        -p "${buildopt_workspace}" \
        runtimeBundle >"${buildopt_log}" 2>&1; then
        sed -n '1,240p' "${buildopt_log}" >&2
        return 1
    fi
    buildopt_completed=$(date +%s%3N)
    buildopt_last_duration=$((buildopt_completed - buildopt_started))
    buildopt_last_digest=$(sha256sum \
        "${buildopt_workspace}/build/runtime/runtime-autotuning.zip" | \
        awk '{print $1}')
}

for buildopt_arm in aa-a aa-b control candidate; do
    buildopt_workers=2
    buildopt_heap=4096
    if [[ "${buildopt_arm}" == candidate ]]; then
        buildopt_workers=4
        buildopt_heap=6144
    fi
    buildopt_run_arm "${buildopt_arm}" "${buildopt_workers}" "${buildopt_heap}" "warm-${buildopt_arm}"
done

buildopt_aa_a_ms=()
buildopt_aa_b_ms=()
buildopt_aa_a_sha=()
buildopt_aa_b_sha=()
buildopt_control_ms=()
buildopt_candidate_ms=()
buildopt_control_sha=()
buildopt_candidate_sha=()
buildopt_oom_before=$(buildopt_read_oom)

for buildopt_pair in 1 2 3 4; do
    if ((buildopt_pair % 2 == 1)); then
        buildopt_order=(aa-a aa-b control candidate)
    else
        buildopt_order=(aa-b aa-a candidate control)
    fi
    for buildopt_arm in "${buildopt_order[@]}"; do
        buildopt_workers=2
        buildopt_heap=4096
        if [[ "${buildopt_arm}" == candidate ]]; then
            buildopt_workers=4
            buildopt_heap=6144
        fi
        buildopt_run_arm "${buildopt_arm}" "${buildopt_workers}" "${buildopt_heap}" \
            "pair-${buildopt_pair}-${buildopt_arm}"
        case "${buildopt_arm}" in
            aa-a)
                buildopt_aa_a_ms+=("${buildopt_last_duration}")
                buildopt_aa_a_sha+=("${buildopt_last_digest}")
                ;;
            aa-b)
                buildopt_aa_b_ms+=("${buildopt_last_duration}")
                buildopt_aa_b_sha+=("${buildopt_last_digest}")
                ;;
            control)
                buildopt_control_ms+=("${buildopt_last_duration}")
                buildopt_control_sha+=("${buildopt_last_digest}")
                ;;
            candidate)
                buildopt_candidate_ms+=("${buildopt_last_duration}")
                buildopt_candidate_sha+=("${buildopt_last_digest}")
                ;;
        esac
    done
done
buildopt_oom_after=$(buildopt_read_oom)

buildopt_json_array() {
    printf '%s\n' "$@" | jq -s 'map(tonumber)'
}
buildopt_json_strings() {
    printf '%s\n' "$@" | jq -R -s 'split("\n")[:-1]'
}

buildopt_input="${buildopt_temp}/runtime-input.json"
buildopt_revision=${BUILDOPT_BENCHMARK_REVISION:-$(git -C "${buildopt_repo_root}" rev-parse HEAD)}
jq -n \
    --arg revision "${buildopt_revision}" \
    --arg runUrl "${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}" \
    --argjson runId "${GITHUB_RUN_ID}" \
    --argjson cpu "${buildopt_cpu_count}" \
    --argjson memory "${buildopt_memory_bytes}" \
    --argjson oomBefore "${buildopt_oom_before}" \
    --argjson oomAfter "${buildopt_oom_after}" \
    --argjson aaA "$(buildopt_json_array "${buildopt_aa_a_ms[@]}")" \
    --argjson aaB "$(buildopt_json_array "${buildopt_aa_b_ms[@]}")" \
    --argjson control "$(buildopt_json_array "${buildopt_control_ms[@]}")" \
    --argjson candidate "$(buildopt_json_array "${buildopt_candidate_ms[@]}")" \
    --argjson aaASHA "$(buildopt_json_strings "${buildopt_aa_a_sha[@]}")" \
    --argjson aaBSHA "$(buildopt_json_strings "${buildopt_aa_b_sha[@]}")" \
    --argjson controlSHA "$(buildopt_json_strings "${buildopt_control_sha[@]}")" \
    --argjson candidateSHA "$(buildopt_json_strings "${buildopt_candidate_sha[@]}")" \
    '{
      schemaVersion: "buildopt.runtime-evaluation/input/v1",
      buildoptRevision: $revision,
      workflowRunId: $runId,
      workflowRunUrl: $runUrl,
      runner: {
        class: "linux-amd64-4c-16g-v1",
        cpuCount: $cpu,
        memoryBytes: $memory,
        oomBefore: $oomBefore,
        oomAfter: $oomAfter,
        ciQueueDeltaMs: 0,
        queueMeasurement: "COMMON_WORKFLOW_JOB_EXACT_ZERO_INCREMENTAL"
      },
      aa: {controlMs: $aaA, candidateMs: $aaB, controlSha256: $aaASHA, candidateSha256: $aaBSHA},
      autotuning: {controlMs: $control, candidateMs: $candidate, controlSha256: $controlSHA, candidateSha256: $candidateSHA}
    }' >"${buildopt_input}"

mkdir -m 0700 -- "${buildopt_output}"
if [[ "${BUILDOPT_RUNTIME_POC_RAW_ONLY:-0}" == 1 ]]; then
    cp -- "${buildopt_input}" "${buildopt_output}/runtime-input.json"
    chmod 0600 "${buildopt_output}/runtime-input.json"
    printf 'BuildOpt runtime POC observations written without applying the legacy promotion gate\n'
    exit 0
fi
if [[ -n "${BUILDOPT_RUNTIME_EVALUATOR:-}" ]]; then
    "${BUILDOPT_RUNTIME_EVALUATOR}" \
        "${buildopt_input}" \
        "${buildopt_output}/runtime-owner-evaluation.json"
else
    "${buildopt_script_dir}/run" --toolchain go -- \
        go run ./cmd/runtime-evaluation \
        "${buildopt_input}" \
        "${buildopt_output}/runtime-owner-evaluation.json"
fi

printf 'B owner evaluation OK: A/A valid and W4_H6G causal autotuning passed p95/p99/queue/OOM/artifact gates\n'
