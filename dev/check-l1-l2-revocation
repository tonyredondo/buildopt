#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_contract="${buildopt_repo_root}/specs/l1-l2-revocation-v1.json"

for buildopt_command in find git jq mkdir readlink; do
    if ! command -v "${buildopt_command}" >/dev/null 2>&1; then
        printf 'required L1/L2 lifecycle command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    fi
done

cd -- "${buildopt_repo_root}"
buildopt_before_status=$(
    git status --porcelain=v1 --untracked-files=all
)

if ! jq -e '
    keys == [
        "backend",
        "boundaries",
        "gateId",
        "goldenLane",
        "gradle",
        "schemaVersion"
    ] and
    .schemaVersion == "buildopt.specs/l1-l2-revocation/v1" and
    .gateId == "A0-G02" and
    .goldenLane == {
        platform: "linux-amd64",
        gradle: "9.6.1",
        jdk: 21,
        dsls: ["GROOVY", "KOTLIN"]
    } and
    .backend.writerAuthority == "SIGNED_CURRENT_READ_WRITE" and
    .backend.putVisibility == "PENDING_ONLY" and
    .backend.commitDecision ==
        "CANONICAL_AUTHENTICATED_COMMIT_DECISION" and
    .backend.committedRead == "VERIFIED_COMMITTED_ONLY" and
    .backend.revocationAdvance == [
        "policyVersion",
        "revocationEpoch",
        "l1SecurityGeneration",
        "gatewayConnectionGeneration",
        "namespaceGeneration"
    ] and
    .backend.oldRoute == {status: 401, bodyBytes: 0} and
    .backend.newGenerationOldKey == {status: 404, bodyBytes: 0} and
    .backend.abort == {
        state: "ABORTED",
        pendingObjects: 0,
        remoteRead: {status: 404, bodyBytes: 0}
    } and
    .gradle.remoteClient ==
        "org.gradle.caching.http.HttpBuildCache" and
    .gradle.readerLocalMode == "READ_WRITE" and
    .gradle.writerLocalMode == "DISABLED_L2_WRITER" and
    .gradle.sequence == [
        "PENDING_L2_WRITER_LOCAL_DISABLED",
        "COMMIT_TRUSTED_SEED",
        "L2_HIT_POPULATES_L1",
        "L1_HIT_WITH_REMOTE_UNAVAILABLE",
        "AUTHENTICATED_REVOCATION_ROTATES_BEFORE_BUILD",
        "NEXT_BUILD_MISS",
        "ROTATED_L1_REPLAY"
    ] and
    .gradle.configurationCache == {
        sameGeneration: "REUSED",
        revocation: "INVALIDATED_ONCE"
    } and
    .gradle.abortedWriter == {
        pendingOnly: true,
        localDirectoryCreated: false,
        afterAbort: "NO_LOCAL_OR_REMOTE_HIT"
    } and
    .gradle.gatewayCredentialAbsentFromOutput == true and
    .boundaries == {
        closes: ["A0-G02"],
        doesNotClose: ["A0-G03", "A0-G04", "A0-G05", "A1-G04"],
        revokedDirectoryPhysicalDeletion: "A1-004",
        completeCommitFaultRecovery: "A0-G05"
    }
' "${buildopt_contract}" >/dev/null; then
    printf 'L1/L2 revocation contract is malformed\n' >&2
    exit 1
fi

buildopt_required_files=(
    "internal/sharedcache/authority_test.go"
    "internal/launcher/managed_l1.go"
    "internal/launcher/managed_l1_test.go"
    "jvm/gradle-plugin/src/main/java/dev/buildopt/gradle/BuildOptManagedL1Plugin.java"
    "jvm/gradle-plugin/src/testKit/java/dev/buildopt/gradle/ManagedL1TestKit.java"
    "specs/l1-l2-revocation-v1.md"
)
for buildopt_relative in "${buildopt_required_files[@]}"; do
    if [[ ! -s "${buildopt_repo_root}/${buildopt_relative}" ]]; then
        printf 'missing L1/L2 lifecycle file: %s\n' \
            "${buildopt_relative}" >&2
        exit 1
    fi
done

"${buildopt_script_dir}/run" --toolchain go -- \
    go test -race -count=1 \
    ./internal/sharedcache \
    -run '^TestLocalAuthorityCommitRevocationAndAbortLifecycle$'
"${buildopt_script_dir}/run" --toolchain go -- \
    go test -race -count=1 \
    ./internal/launcher \
    -run '^TestManagedL1(PrivateDirectoryGenerationAndLease|DisablesLocalCacheForL2Writer)$'
"${buildopt_script_dir}/run" --toolchain go -- \
    go vet ./internal/sharedcache ./internal/launcher

if [[ -z "${GRADLE_USER_HOME:-}" ]]; then
    export GRADLE_USER_HOME="${buildopt_repo_root}/.tools/gradle-user-home/local"
fi
mkdir -p -- "${GRADLE_USER_HOME}"
buildopt_gradle_home=$(
    find \
        "${GRADLE_USER_HOME}/wrapper/dists/gradle-9.6.1-bin" \
        -type d \
        -path '*/gradle-9.6.1' \
        -print \
        -quit
)
if [[ -z "${buildopt_gradle_home}" ||
    ! -x "${buildopt_gradle_home}/bin/gradle" ]]; then
    printf 'pinned Gradle 9.6.1 distribution is unavailable\n' >&2
    exit 1
fi
buildopt_gradle_home=$(readlink -f "${buildopt_gradle_home}")
"${buildopt_script_dir}/run" -- \
    "${buildopt_repo_root}/gradlew" \
    --no-daemon \
    --offline \
    --no-configuration-cache \
    --stacktrace \
    --warning-mode=fail \
    :jvm:gradle-plugin:l1L2LifecycleTestKit \
    -PbuildoptTierOneJava=21 \
    "-PbuildoptTierOneGradleHome=${buildopt_gradle_home}"

buildopt_after_status=$(
    git status --porcelain=v1 --untracked-files=all
)
if [[ "${buildopt_after_status}" != "${buildopt_before_status}" ]]; then
    printf 'L1/L2 lifecycle check changed the working tree\n' >&2
    exit 1
fi

printf 'A0-G02 L1/L2 lifecycle OK: committed L2 to L1, authenticated rotation miss, warmed replay, and aborted writer isolation\n'
