#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [RESULT_FILE]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-spring-test-build-optimization-v1.json"
buildopt_result=${1:-"${buildopt_repo_root}/benchmarks/results/poc-spring-test-build-optimization-v1.json"}

jq -e '
    .schemaVersion == "buildopt.specs/poc-spring-test-build-optimization/v1" and
    .workItem == "POC-TEST-BUILD-OPTIMIZATION-001" and
    .decision == "PREREGISTER_EXACT_STANDARD_JAR_REUSE_WITH_UNCHANGED_TEST_EXECUTION" and
    .protocolRevisions == [
        {
            from: 0,
            reason: "PRE_MEASUREMENT_WARMUP_POPULATES_STANDARD_JAR_CACHE_WITHOUT_REPLAY",
            acceptedPairsBeforeRevision: 0,
            valueThresholdsChanged: false
        },
        {
            from: 1,
            reason: "PRE_MEASUREMENT_ROOT_CLEAN_DID_NOT_FORCE_REQUESTED_TEST_EXECUTION",
            acceptedPairsBeforeRevision: 0,
            valueThresholdsChanged: false
        },
        {
            from: 2,
            reason: "PRE_MEASUREMENT_ATTRIBUTION_IGNORED_EXACT_TEST_FIXTURES_JAR_TASKS",
            acceptedPairsBeforeRevision: 0,
            valueThresholdsChanged: false
        }
    ] and
    .repository.nameWithOwner == "spring-projects/spring-framework" and
    (.repository.revision | test("^[0-9a-f]{40}$")) and
    (.repository.sourceArchiveSha256 | test("^[0-9a-f]{64}$")) and
    .runner.cpuCount == 12 and .runner.maxWorkers == 12 and .runner.jdk == "25" and
    .workflow.entrypoint == ":spring-jms:test" and
    .workflow.testFilter == "org.springframework.jms.support.JmsAccessorTests" and
    .workflow.expectedTests == 8 and
    .workflow.candidateActivation == "buildopt gradle --cache-standard-jar-producers --" and
    (.measurement.commonArguments | index("--offline")) != null and
    (.measurement.commonArguments | index("--build-cache")) != null and
    (.measurement.commonArguments | index("--rerun")) != null and
    .measurement.onlinePreflightMeasured == false and
    .measurement.preflightDaemonStoppedBeforeArmSetup == true and
    .measurement.sameDependencyAndNativeCacheSeedRestoredBeforeArmSetup == true and
    .measurement.outputsRemovedBeforeEveryArm == true and
    .measurement.warmupsPerArm == 1 and .measurement.pairs == 4 and
    .measurement.maximumInterArmIdleGapMs == 5000 and
    .measurement.candidateMustRestoreStandardJar == true and
    .measurement.controlMustExecuteStandardJar == true and
    .measurement.exactDifferentialTaskSuffix == "testFixturesJar" and
    .measurement.requestedTestTaskMustExecute == true and
    .measurement.requiredJarOutputsIdentical == true and
    .measurement.testCasesAndOutcomeIdentical == true and
    .valueGate.minimumSavedMs == 500 and
    .valueGate.minimumReductionRatio == 0.02 and
    .valueGate.positiveLower95Bound == true and
    .valueGate.thresholdsMayMoveAfterMeasurement == false and
    .valueGate.failedPairsMayBeDiscarded == false and
    .boundaries.requestedTestsExecutedInEveryArm == true and
    .boundaries.testSelectionIdentical == true and
    .boundaries.testOrderingChanged == false and
    .boundaries.testShardingChanged == false and
    .boundaries.testRetriesChanged == false and
    .boundaries.testOptimizationModified == false and
    .boundaries.proofOfConcept == true and
    .boundaries.productionReadinessClaimed == false and
    .boundaries.soakRequired == false and
    .boundaries.designPartnerRequired == false
' "${buildopt_spec}" >/dev/null

if (($# == 0)) && [[ ! -s "${buildopt_result}" ]]; then
    printf 'Spring test-build optimization contract OK: %s\n' "${buildopt_spec}"
    exit 0
fi

buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_runner_sha=$(sha256sum "${buildopt_script_dir}/run-poc-spring-test-build-optimization" | awk '{print $1}')
jq -e --arg specSha "${buildopt_spec_sha}" --arg runnerSha "${buildopt_runner_sha}" \
    --slurpfile spec "${buildopt_spec}" '
    def sha256: type == "string" and test("^[0-9a-f]{64}$");
    def bootstrap_mean($data; $sample):
        reduce range(0; 4) as $draw
            ({state: ((2654435761 * ($sample + 1)) % 4294967296), sum: 0};
             .state = ((1664525 * .state + 1013904223) % 4294967296) |
             .sum += $data[((.state / 1073741824) | floor)].savedMs) |
        .sum / 4;
    def bootstrap95($data):
        ([range(0; 4096) as $sample | bootstrap_mean($data; $sample)] | sort) as $r |
        [$r[102], $r[3993]];
    .observations as $data |
    (($data | map(.controlDurationMs) | add) / 4) as $controlMean |
    (($data | map(.candidateDurationMs) | add) / 4) as $candidateMean |
    (($data | map(.savedMs) | add) / 4) as $mean |
    (($data | map(.savedMs) | add) / ($data | map(.controlDurationMs) | add)) as $ratio |
    bootstrap95($data) as $interval |
    ($data | map(select(.savedMs > 0)) | length) as $positive |
    ($mean >= $spec[0].valueGate.minimumSavedMs and
     $ratio >= $spec[0].valueGate.minimumReductionRatio and
     $interval[0] > 0 and
     all($data[]; .requiredJarOutputCount > 0 and
         .tests == 8 and .failures == 0 and .errors == 0 and .skipped == 0 and
         .requestedTestTaskExecuted == true and
         .candidateStandardJarFromCacheCount > 0 and
         .controlStandardJarExecutedCount > 0 and
         .outputsIdentical == true and .testCasesIdentical == true and
         (.productAttributableFailure | not))) as $qualified |
    .schemaVersion == "buildopt.evidence/poc-spring-test-build-optimization/v1" and
    .workItem == "POC-TEST-BUILD-OPTIMIZATION-001" and
    (.capturedAt | fromdateiso8601) and
    (.buildopt.revision | test("^[0-9a-f]{40}$")) and
    (.buildopt.executableSha256 | sha256) and
    .buildopt.runnerScriptSha256 == $runnerSha and
    .specSha256 == $specSha and
    .repository == {
        nameWithOwner: $spec[0].repository.nameWithOwner,
        revision: $spec[0].repository.revision,
        sourceArchiveSha256: $spec[0].repository.sourceArchiveSha256
    } and
    .runner == $spec[0].runner and
    .workflow.entrypoint == $spec[0].workflow.entrypoint and
    .workflow.testFilter == $spec[0].workflow.testFilter and
    .preparation.onlinePreflightMeasured == false and
    .preparation.onlinePreflightSuccess == true and
    .preparation.measuredNetwork == "DISCONNECTED" and
    .preparation.dependencyMode == "GRADLE_OFFLINE" and
    ($data | length) == 4 and
    [$data[].pair] == [1, 2, 3, 4] and
    [$data[].order] == ["CONTROL_FIRST", "CANDIDATE_FIRST", "CONTROL_FIRST", "CANDIDATE_FIRST"] and
    all($data[];
        .savedMs == (.controlDurationMs - .candidateDurationMs) and
        .interArmIdleGapMs >= 0 and
        .interArmIdleGapMs <= $spec[0].measurement.maximumInterArmIdleGapMs and
        (.requiredJarOutputSha256 | sha256) and
        (.testCaseSetSha256 | sha256)) and
    .result == {
        pairs: 4,
        controlMeanMs: $controlMean,
        candidateMeanMs: $candidateMean,
        meanSavedMs: $mean,
        reductionRatio: $ratio,
        interval95SavedMs: $interval,
        positivePairs: $positive,
        qualified: $qualified,
        decision: (if $qualified then
            "QUALIFIED_EXACT_STANDARD_JAR_REUSE_FOR_TEST_BUILDS"
            else "STOP_STANDARD_JAR_REUSE_FOR_SPRING_TEST_BUILD" end)
    } and
    .boundaries == $spec[0].boundaries
' "${buildopt_result}" >/dev/null

printf 'Spring test-build optimization evidence OK: %s\n' "${buildopt_result}"
