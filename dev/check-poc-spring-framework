#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-spring-framework-v1.json"

for buildopt_command in git jq; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required Spring POC command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done

buildopt_before=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)

jq -e '
    .schemaVersion == "buildopt.specs/poc-spring-framework/v1" and
    .workItem == "POC-SPRING-PREREG-001" and
    .decision == "PREREGISTER_OPTIMIZED_NATIVE_SPRING_VALUE_ITERATION" and
    .repository == {
        nameWithOwner: "spring-projects/spring-framework",
        revision: "4b5c92703c63966c3471242c621c4a63b382638d",
        sourceArchiveUrl: "https://codeload.github.com/spring-projects/spring-framework/tar.gz/4b5c92703c63966c3471242c621c4a63b382638d",
        sourceArchiveSha256: "e3fa4258e5e568c0b0e6f1605956cd743cff847b9df7c82ce86b2d2f1109db16",
        wrapperJarSha256: "497c8c2a7e5031f6aa847f88104aa80a93532ec32ee17bdb8d1d2f67a194a9c7",
        wrapperPropertiesSha256: "c94d41b634a5e0ff8a2f812023697b1337eebac18e9962610356a1793f72896d",
        settingsSha256: "6ec3ec6edae99fd4962c3c883753ad299ee9a6a84b189b0b6c19a9b13bb699ad",
        gradlePropertiesSha256: "1d9b83934806d82172d67695cabcb4ea675b67d83eaaa4bbc9ba15bb49201ad9",
        gradleVersion: "9.6.1",
        java: "TEMURIN_25_0_3_PLUS_9",
        projectCount: 27
    } and
    .upstreamControl.workflow == "Build Pull Request" and
    .upstreamControl.runId == 30990220928 and
    .upstreamControl.command == ["check", "antora"] and
    .upstreamControl.observedBuildStepMs == 756000 and
    .upstreamControl.buildCacheEnabled == true and
    .upstreamControl.parallelEnabled == true and
    .upstreamControl.configurationCacheEnabled == false and
    .upstreamControl.secretsRequired == false and
    .primaryRunner.id == "linux-amd64-12c-16659865600b-v1" and
    .primaryRunner.cpuCount == 12 and
    .primaryRunner.memoryBytes == 16659865600 and
    .primaryRunner.maxWorkers == 12 and
    .primaryRunner.runnerIsContractualFourCpuClass == false and
    .change == {
        class: "LEAF_PRODUCTION_SOURCE",
        path: "spring-jms/src/main/java/org/springframework/jms/JmsException.java",
        originalSha256: "61098f8411fd6a379cedb20c2cfed267979eff8ef3f6af7cd5c0fe5bb7b33138",
        mutation: "APPEND_PAIR_COMMENT",
        project: ":spring-jms"
    } and
    .diagnostic.onlinePreflightMeasured == false and
    .diagnostic.measuredNetwork == "DISCONNECTED" and
    .diagnostic.dependencyMode == "GRADLE_OFFLINE" and
    [.diagnostic.commands[].id] == [
        "BUILD_OUTPUTS", "TEST_PREPARATION", "FULL_VERIFICATION"
    ] and
    [.diagnostic.commands[].arguments] == [
        ["assemble", "--no-scan", "--stacktrace", "--max-workers=12"],
        ["testClasses", "--no-scan", "--stacktrace", "--max-workers=12"],
        ["check", "--no-scan", "--stacktrace", "--max-workers=12"]
    ] and
    .diagnostic.taskDurationsMayBeSummedAsWallClockSavings == false and
    .diagnostic.savingsClaimed == false and
    .mechanismBoundaries.BUILD_OUTPUTS.allowedMechanism == "BUILD_IMPACT" and
    .mechanismBoundaries.BUILD_OUTPUTS.testTasksRequested == false and
    .mechanismBoundaries.TEST_PREPARATION.testTasksRequested == false and
    .mechanismBoundaries.TEST_PREPARATION.candidateMayOmitTestTasks == false and
    .mechanismBoundaries.FULL_VERIFICATION.allowedMechanism == "RUNTIME_TUNING_WITH_UNCHANGED_TEST_SET" and
    .mechanismBoundaries.FULL_VERIFICATION.testTasksRequested == true and
    .mechanismBoundaries.FULL_VERIFICATION.candidateMayOmitTestTasks == false and
    .followUpMeasurement.warmupsPerCell == 1 and
    .followUpMeasurement.batches == 2 and
    .followUpMeasurement.pairsPerBatch == 4 and
    .followUpMeasurement.pairsPerCell == 8 and
    .followUpMeasurement.pairOrder == "ALTERNATING_WITH_OPPOSITE_BATCH_START" and
    .followUpMeasurement.maximumInterArmIdleGapMs == 5000 and
    .followUpMeasurement.controlMustRetainUpstreamBuildCache == true and
    .followUpMeasurement.controlMustRetainUpstreamParallelism == true and
    .valueGate == {
        minimumSavedMs: 500,
        minimumReductionRatio: 0.02,
        positiveLower95Bound: true,
        requiredOutputsIdentical: true,
        requiredOutputsNonEmpty: true,
        allRequestedTestsIdentical: true,
        maximumProductAttributableFailures: 0,
        thresholdsMayMoveAfterMeasurement: false,
        failedPairsMayBeDiscarded: false,
        parityAloneCountsAsValue: false
    } and
    .transfer == {
        repository: "open-telemetry/opentelemetry-java-instrumentation",
        authorizedOnlyAfterSpringQualifies: true,
        repositorySpecificProductChangesAllowed: false,
        sameMechanismAndGateRequired: true
    } and
    .boundaries == {
        publicSourceOnly: true,
        proofOfConcept: true,
        performanceMeasuredByThisContract: false,
        savingsClaimedByThisContract: false,
        productionReadinessClaimed: false,
        eightHourSoakExecuted: false,
        externalDesignPartnerRequired: false,
        testOptimizationModified: false
    }
' "${buildopt_spec}" >/dev/null

buildopt_after=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
if [[ "${buildopt_before}" != "${buildopt_after}" ]]; then
    printf 'Spring POC validation changed the working tree\n' >&2
    exit 1
fi

printf 'Spring Framework POC preregistration OK: %s\n' "${buildopt_spec}"
