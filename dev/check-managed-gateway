#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)

cd -- "${buildopt_repo_root}"
"${buildopt_script_dir}/run" \
    --toolchain go \
    -- go test -race -count=1 \
    -run 'LocalGateway|ManagedGateway' \
    ./internal/launcher ./cmd/buildopt

printf 'A0-001 managed gateway OK: private state, slot lease, process reuse, restart, rotation, isolation, and baseline fallback\n'
