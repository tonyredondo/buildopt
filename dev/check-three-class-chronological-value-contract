#!/usr/bin/env bash
set -euo pipefail
buildopt_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
cd -- "${buildopt_root}"
buildopt_spec=specs/poc-three-class-chronological-value-v1.json
buildopt_sources=specs/poc-three-class-chronological-value-v1.sources.json

jq -e '
  .schemaVersion=="buildopt.specs/poc-qualified-lifetime/v2" and
  .workItem=="POC-THREE-CLASS-CHRONOLOGICAL-VALUE-V1" and
  .protocol.calibrationPairs==8 and .protocol.minimumPositiveCalibrationPairs==8 and
  .protocol.maximumBreakEvenBuilds==5 and .protocol.maximumWorkers==12 and
  .protocol.history=="PUBLIC_FIRST_PARENT" and
  .protocol.percentagesAggregatedAcrossRepositories==false and
  .acceptance.qualificationDecisionsRequired==3 and
  (.repositories|length)==3 and
  [.repositories[].key]==["apache-kafka","apache-groovy","spring-framework"] and
  all(.repositories[]; (.observations|length)==3 and
    (.publicRevision|test("^[0-9a-f]{40}$")) and
    (.targetRevision|test("^[0-9a-f]{40}$")) and
    all(.observations[]; test("^[0-9a-f]{40}$"))) and
  .boundaries=={designPartnerRequired:false,productionAuthorized:false,
    proofOfConcept:true,repositorySpecificProductRules:false,soakRequired:false,
    testOptimization:"OUT_OF_SCOPE"}
' "${buildopt_spec}" >/dev/null

jq -e --slurpfile spec "${buildopt_spec}" '
  .schemaVersion=="buildopt.specs/poc-three-class-chronological-value-sources/v1" and
  .selectionRule=="THREE_IMMEDIATE_FIRST_PARENT_DESCENDANTS_OLDEST_TO_NEWEST" and
  (.subjects|length)==3 and .terminalGate=={qualificationDecisions:3,
    positiveCalibrationPairsPerQualifiedSubject:8,observationsPerSubject:3,
    subjectsPaidBack:2,aggregateCumulativeNetPositive:true,productFailures:0,
    exactRequiredOutputs:true} and
  all(.subjects[]; . as $source |
    ($spec[0].repositories[]|select(.key==$source.key)) as $repository |
    $source.historyBranch==$repository.historyBranch and
    ($source.historySha256|test("^[0-9a-f]{64}$")) and
    ($source.pairedValueSha256|test("^[0-9a-f]{64}$")))
' "${buildopt_sources}" >/dev/null

while IFS=$'\t' read -r buildopt_path buildopt_sha; do
  [[ $(sha256sum "${buildopt_path}" | awk '{print $1}') == "${buildopt_sha}" ]] || {
    printf 'three-class source drift: %s\n' "${buildopt_path}" >&2
    exit 1
  }
done < <(jq -r '.subjects[] | [.pairedValueEvidence,.pairedValueSha256] | @tsv' "${buildopt_sources}")
buildopt_spring_history=$(jq -r '.subjects[]|select(.key=="spring-framework")|.historyFile' "${buildopt_sources}")
buildopt_spring_sha=$(jq -r '.subjects[]|select(.key=="spring-framework")|.historySha256' "${buildopt_sources}")
[[ $(sha256sum "${buildopt_spring_history}" | awk '{print $1}') == "${buildopt_spring_sha}" ]]

printf 'three-class chronological contract: 3 subjects, 8/8, 9 descendants\n'
