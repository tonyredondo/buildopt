#!/usr/bin/env bash
set -euo pipefail
umask 077

if (($# != 3)); then
    printf 'usage: %s HISTORY_ROOT OUTPUT_DIR FAMILY|--finalize\n' "$0" >&2
    exit 64
fi

buildopt_history_root=$1
buildopt_output=$2
buildopt_family=$3
buildopt_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
buildopt_config=${buildopt_root}/benchmarks/observed-request-portfolio-v1.json
buildopt_cohort=${buildopt_root}/benchmarks/results/fresh-generic-optimization-v1/cohort.json
[[ ${buildopt_history_root} == /* && -d ${buildopt_history_root} ]] || {
    printf 'history root must be an existing absolute directory\n' >&2
    exit 1
}
[[ ${buildopt_output} == /* ]] || {
    printf 'output must be an absolute path\n' >&2
    exit 1
}
for buildopt_command in date flock git jq mktemp sha256sum stat; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf '%s is required\n' "${buildopt_command}" >&2
        exit 1
    }
done

buildopt_temporary=$(mktemp -d /tmp/buildopt-observed-public.XXXXXX)
buildopt_worktree=
buildopt_worktree_history=
buildopt_family_lock=
buildopt_family_lock_fd=
buildopt_cleanup_worktree() {
    if [[ -n ${buildopt_worktree:-} && -n ${buildopt_worktree_history:-} && -e ${buildopt_worktree} ]]; then
        git -C "${buildopt_worktree_history}" worktree remove --force "${buildopt_worktree}" >/dev/null 2>&1 || true
    fi
    buildopt_worktree=
    buildopt_worktree_history=
}
buildopt_cleanup() {
    buildopt_cleanup_worktree
    if [[ -n ${buildopt_family_lock_fd:-} ]]; then
        flock -u "${buildopt_family_lock_fd}" || true
        exec {buildopt_family_lock_fd}>&-
        buildopt_family_lock_fd=
    fi
    if [[ -n ${buildopt_family_lock:-} ]]; then
        rm -f -- "${buildopt_family_lock}"
        buildopt_family_lock=
    fi
    case ${buildopt_temporary} in
        /tmp/buildopt-observed-public.*) rm -rf -- "${buildopt_temporary}" ;;
        *) printf 'refusing to clean unexpected portfolio root: %s\n' "${buildopt_temporary}" >&2; return 1 ;;
    esac
}
trap buildopt_cleanup EXIT

buildopt_generated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
buildopt_config_sha=$(sha256sum "${buildopt_config}" | awk '{print $1}')
buildopt_cohort_sha=$(sha256sum "${buildopt_cohort}" | awk '{print $1}')
buildopt_binary=${buildopt_temporary}/buildopt
buildopt_classifier=${buildopt_temporary}/request-aligned-classifier
env GOCACHE="${buildopt_temporary}/go-cache" \
    "${buildopt_root}/dev/run" --toolchain go -- \
    go build -o "${buildopt_binary}" ./cmd/buildopt
env GOCACHE="${buildopt_temporary}/go-cache" \
    "${buildopt_root}/dev/run" --toolchain go -- \
    go build -o "${buildopt_classifier}" ./cmd/request-aligned-classifier
buildopt_binary_sha=$(sha256sum "${buildopt_binary}" | awk '{print $1}')

if [[ ! -e ${buildopt_output} ]]; then
    mkdir -p -- "${buildopt_output}/captures" "${buildopt_output}/evidence" \
        "${buildopt_output}/portfolios" "${buildopt_output}/reports" "${buildopt_output}/families"
    : >"${buildopt_output}/observations.jsonl"
    : >"${buildopt_output}/transitions.jsonl"
    chmod 0600 "${buildopt_output}/observations.jsonl" "${buildopt_output}/transitions.jsonl"
    jq -n \
        --arg generatedAt "${buildopt_generated_at}" \
        --arg configSha256 "${buildopt_config_sha}" \
        --arg cohortSha256 "${buildopt_cohort_sha}" \
        --arg executableSha256 "${buildopt_binary_sha}" \
        --arg runnerSha256 "$(sha256sum "${buildopt_root}/dev/run-observed-request-public-portfolio" | awk '{print $1}')" \
        --arg classifierSha256 "$(sha256sum "${buildopt_root}/internal/requestaligned/classification.go" | awk '{print $1}')" \
        --arg launcherSha256 "$(sha256sum "${buildopt_root}/internal/launcher/request_portfolio.go" "${buildopt_root}/internal/launcher/request_portfolio_capture.go" | sha256sum | awk '{print $1}')" \
        --arg initSha256 "$(sha256sum "${buildopt_root}/internal/launcher/request_portfolio.init.gradle" | awk '{print $1}')" '
      {
        schemaVersion:"buildopt.poc/observed-request-public-portfolio-contract/v1",
        workItem:"SWL-PORTFOLIO-003",generatedAt:$generatedAt,
        configSha256:$configSha256,cohortSha256:$cohortSha256,
        executableSha256:$executableSha256,runnerSha256:$runnerSha256,
        classifierSha256:$classifierSha256,launcherSha256:$launcherSha256,initSha256:$initSha256,
        schedule:"FIXED_THREE_COMMAND_CYCLE_OVER_CHRONOLOGICAL_FIRST_PARENT_COMMITS",
        comparison:"PREVIOUS_SUCCESSFUL_OBSERVATION_OF_THE_SAME_EXACT_COMMAND",
        observationBudgetPerFamily:30,requiredRelevantTransitionsPerFamily:5,
        sameInvocationEvidence:true,extraGradleBuilds:0,ordinaryRequestsOnly:true,
        exactRequestPreserved:true,historicalBuildOptStateImported:false,
        historicalBuildOptTimingImported:false,historicalBuildOptActionImported:false,
        performanceMeasured:false,selectionAuthorized:false,activationAuthorized:false
      }
    ' >"${buildopt_output}/contract.json"
    chmod 0600 "${buildopt_output}/contract.json"
else
    [[ -d ${buildopt_output} && -f ${buildopt_output}/contract.json ]] || {
        printf 'existing output is not an observed-request portfolio\n' >&2
        exit 1
    }
    jq -e --arg config "${buildopt_config_sha}" --arg cohort "${buildopt_cohort_sha}" \
        --arg executable "${buildopt_binary_sha}" \
        --arg runner "$(sha256sum "${buildopt_root}/dev/run-observed-request-public-portfolio" | awk '{print $1}')" '
      .schemaVersion=="buildopt.poc/observed-request-public-portfolio-contract/v1" and
      .configSha256==$config and .cohortSha256==$cohort and
      .executableSha256==$executable and .runnerSha256==$runner
    ' "${buildopt_output}/contract.json" >/dev/null || {
        printf 'existing output was created from different inputs\n' >&2
        exit 1
    }
fi

if [[ ${buildopt_family} == --finalize ]]; then
    mapfile -t buildopt_expected_families < <(jq -r '.families[].family' "${buildopt_config}")
    ((${#buildopt_expected_families[@]} == 5)) || {
        printf 'portfolio config must contain five families\n' >&2
        exit 1
    }
    for buildopt_expected in "${buildopt_expected_families[@]}"; do
        [[ -f ${buildopt_output}/families/${buildopt_expected}.json ]] || {
            printf 'family capture is missing: %s\n' "${buildopt_expected}" >&2
            exit 1
        }
    done
    jq -s --arg generatedAt "${buildopt_generated_at}" '
      sort_by(.family) as $families | {
        schemaVersion:"buildopt.poc/observed-request-public-portfolio-summary/v1",
        workItem:"SWL-PORTFOLIO-003",generatedAt:$generatedAt,status:"COMPLETE",
        familyCount:($families|length),
        completeFamilies:([$families[]|select(.relevantTransitions>=5)]|length),
        actionFamilies:([$families[]|select(.actionTransitions>0)]|length),
        productFailures:([$families[].productFailures]|add),families:$families,
        performanceMeasured:false,selectionAuthorized:false,activationAuthorized:false
      }
    ' "${buildopt_output}"/families/*.json >"${buildopt_output}/summary.json"
    chmod 0600 "${buildopt_output}/summary.json"
    printf 'Observed request public portfolio: finalized\n'
    exit 0
fi

jq -e --arg family "${buildopt_family}" '
  ([.families[]|select(.family==$family)]|length)==1
' "${buildopt_config}" >/dev/null || {
    printf 'unknown portfolio family: %s\n' "${buildopt_family}" >&2
    exit 64
}
[[ ! -e ${buildopt_output}/families/${buildopt_family}.json ]] || {
    printf 'family capture already exists: %s\n' "${buildopt_family}" >&2
    exit 1
}
buildopt_family_lock=${buildopt_output}/families/.${buildopt_family}.capture.lock
exec {buildopt_family_lock_fd}>"${buildopt_family_lock}"
flock -n "${buildopt_family_lock_fd}" || {
    printf 'family capture is already running: %s\n' "${buildopt_family}" >&2
    exit 1
}

buildopt_history=${buildopt_history_root}/${buildopt_family}
git -C "${buildopt_history}" rev-parse --git-dir >/dev/null 2>&1 || {
    printf 'missing Git history for %s\n' "${buildopt_family}" >&2
    exit 1
}
buildopt_jdk=$(jq -r --arg family "${buildopt_family}" '.families[]|select(.family==$family)|.jdk' "${buildopt_cohort}")
buildopt_dsl=$(jq -r --arg family "${buildopt_family}" '.families[]|select(.family==$family)|.dsl' "${buildopt_cohort}")
mapfile -t buildopt_targets < <(jq -r --arg family "${buildopt_family}" '
  .families[]|select(.family==$family)|(.reserve[]?.sha),(.primary[]?.sha)
' "${buildopt_cohort}")
((${#buildopt_targets[@]} == 30)) || {
    printf '%s does not have the frozen 30-observation budget\n' "${buildopt_family}" >&2
    exit 1
}

mkdir -p -- "${buildopt_output}/captures/${buildopt_family}" \
    "${buildopt_output}/evidence/${buildopt_family}" "${buildopt_output}/reports/${buildopt_family}"
buildopt_portfolio=${buildopt_output}/portfolios/${buildopt_family}.json
declare -a buildopt_previous_revision=("" "" "")
declare -a buildopt_previous_capture=("" "" "")
buildopt_relevant=0
buildopt_actions=0
buildopt_product_failures=0
buildopt_build_failures=0
buildopt_observed=0
buildopt_comparable=0

for buildopt_target in "${buildopt_targets[@]}"; do
    ((buildopt_relevant >= 5)) && break
    ((buildopt_observed += 1))
    buildopt_command_index=$(((buildopt_observed - 1) % 3))
    buildopt_command_json=$(jq -c --arg family "${buildopt_family}" --argjson index "${buildopt_command_index}" \
        '.families[]|select(.family==$family)|.commands[$index]' "${buildopt_config}")
    mapfile -t buildopt_invocation < <(jq -r '.[]' <<<"${buildopt_command_json}")
    buildopt_slug=$(printf '%02d-%s' "${buildopt_observed}" "${buildopt_target:0:12}")
    buildopt_capture=${buildopt_output}/captures/${buildopt_family}/${buildopt_slug}.json
    buildopt_evidence=${buildopt_output}/evidence/${buildopt_family}/${buildopt_slug}.json
    buildopt_log=${buildopt_temporary}/${buildopt_family}-${buildopt_slug}.log

    buildopt_worktree=${buildopt_temporary}/worktree
    buildopt_worktree_history=${buildopt_history}
    git -C "${buildopt_history}" worktree add --detach "${buildopt_worktree}" "${buildopt_target}" >/dev/null
    set +e
    (cd -- "${buildopt_worktree}" && env \
        BUILDOPT_STICKY_WRAPPER_ROOT="${buildopt_worktree}" \
        BUILDOPT_STICKY_OBSERVATION=0 \
        BUILDOPT_REQUEST_PORTFOLIO_OUTPUT="${buildopt_portfolio}" \
        BUILDOPT_REQUEST_PORTFOLIO_EVIDENCE="${buildopt_evidence}" \
        BUILDOPT_REQUEST_PORTFOLIO_CAPTURE="${buildopt_capture}" \
        GRADLE_USER_HOME="${buildopt_root}/.tools/gradle-user-home/local" \
        "${buildopt_root}/dev/run" --toolchain "${buildopt_jdk}" -- \
        "${buildopt_binary}" run -- "${buildopt_worktree}/gradlew" "${buildopt_invocation[@]}") \
        >"${buildopt_log}" 2>&1
    buildopt_exit=$?
    set -e
    buildopt_cleanup_worktree

    buildopt_product_failure=false
    # A typed incomplete capture is an observed negative, not a product
    # failure, when the durable portfolio still recorded the invocation.
    if [[ ! -f ${buildopt_portfolio} ]]; then
        buildopt_product_failure=true
        ((buildopt_product_failures += 1))
    fi
    ((buildopt_exit != 0)) && ((buildopt_build_failures += 1)) || true
    buildopt_capture_complete=false
    buildopt_exact_arguments=false
    buildopt_arguments_sha=
    buildopt_requested='[]'
    if [[ -f ${buildopt_capture} ]] && jq -e . "${buildopt_capture}" >/dev/null 2>&1; then
        [[ $(jq -r '.status' "${buildopt_capture}") == COMPLETE ]] && buildopt_capture_complete=true
        jq -e --argjson expected "${buildopt_command_json}" '.gradleArguments==$expected' \
            "${buildopt_capture}" >/dev/null && buildopt_exact_arguments=true || true
        buildopt_requested=$(jq -c '.requestedTasks' "${buildopt_capture}")
    fi
    if [[ -f ${buildopt_evidence} ]]; then
        buildopt_arguments_sha=$(jq -r '.argumentsSha256' "${buildopt_evidence}")
    fi
    buildopt_portfolio_generation=0
    buildopt_portfolio_entries=0
    buildopt_latest_observation=
    if [[ -f ${buildopt_portfolio} ]]; then
        buildopt_portfolio_generation=$(jq -r '.generation' "${buildopt_portfolio}")
        buildopt_portfolio_entries=$(jq -r '.entries|length' "${buildopt_portfolio}")
        buildopt_latest_observation=$(jq -r '.recentObservationIds[-1]' "${buildopt_portfolio}")
    fi
    jq -nc \
        --arg generatedAt "${buildopt_generated_at}" --arg family "${buildopt_family}" --arg dsl "${buildopt_dsl}" \
        --arg revision "${buildopt_target}" --argjson ordinal "${buildopt_observed}" \
        --argjson commandIndex "${buildopt_command_index}" --argjson command "${buildopt_command_json}" \
        --argjson exitCode "${buildopt_exit}" --argjson productFailure "${buildopt_product_failure}" \
        --argjson captureComplete "${buildopt_capture_complete}" --argjson exactArguments "${buildopt_exact_arguments}" \
        --arg argumentsSha256 "${buildopt_arguments_sha}" --argjson requestedTasks "${buildopt_requested}" \
        --arg capture "captures/${buildopt_family}/${buildopt_slug}.json" \
        --arg evidence "evidence/${buildopt_family}/${buildopt_slug}.json" \
        --arg captureSha256 "$([[ -f ${buildopt_capture} ]] && sha256sum "${buildopt_capture}" | awk '{print $1}' || true)" \
        --arg evidenceSha256 "$([[ -f ${buildopt_evidence} ]] && sha256sum "${buildopt_evidence}" | awk '{print $1}' || true)" \
        --arg logSha256 "$(sha256sum "${buildopt_log}" | awk '{print $1}')" \
        --argjson portfolioGeneration "${buildopt_portfolio_generation}" \
        --argjson portfolioEntries "${buildopt_portfolio_entries}" \
        --arg observationId "${buildopt_latest_observation}" '
      {
        generatedAt:$generatedAt,family:$family,dsl:$dsl,observationOrdinal:$ordinal,
        revision:$revision,commandIndex:$commandIndex,command:$command,exitCode:$exitCode,
        productFailure:$productFailure,captureComplete:$captureComplete,
        exactArgumentsPreserved:$exactArguments,argumentsSha256:$argumentsSha256,
        requestedTasks:$requestedTasks,capture:$capture,captureSha256:$captureSha256,
        evidence:$evidence,evidenceSha256:$evidenceSha256,logSha256:$logSha256,
        portfolioGeneration:$portfolioGeneration,portfolioEntries:$portfolioEntries,
        observationId:$observationId,performanceMeasured:false,activationAuthorized:false
      }
    ' >>"${buildopt_output}/observations.jsonl"

    if [[ ${buildopt_product_failure} == true ]]; then
        buildopt_transition_status=PRODUCT_FAILURE
        buildopt_transition_reason=REQUEST_PORTFOLIO_NOT_PERSISTED
    elif ((buildopt_exit != 0)); then
        buildopt_transition_status=BUILD_FAILURE
        buildopt_transition_reason=ORDINARY_GRADLE_REQUEST_FAILED
    elif [[ ${buildopt_capture_complete} != true || ${buildopt_exact_arguments} != true || ! -f ${buildopt_evidence} ]]; then
        buildopt_transition_status=INPUT_UNAVAILABLE
        buildopt_transition_reason=SAME_INVOCATION_EVIDENCE_INCOMPLETE
    elif [[ -z ${buildopt_previous_revision[${buildopt_command_index}]} ]]; then
        buildopt_transition_status=BASELINE_ESTABLISHED
        buildopt_transition_reason=FIRST_SUCCESSFUL_EXACT_COMMAND_OBSERVATION
    else
        buildopt_previous=${buildopt_previous_revision[${buildopt_command_index}]}
        mapfile -d '' -t buildopt_changed_paths < <(
            git -C "${buildopt_history}" diff --name-only --diff-filter=ACMRTUXB -z \
                "${buildopt_previous}" "${buildopt_target}"
        )
        if ((${#buildopt_changed_paths[@]} == 0)); then
            buildopt_changed_json='[]'
        else
            buildopt_changed_json=$(printf '%s\0' "${buildopt_changed_paths[@]}" | jq -Rs 'split("\u0000")[:-1]')
        fi
        buildopt_transition=${buildopt_temporary}/${buildopt_family}-${buildopt_slug}-transition.json
        buildopt_report=${buildopt_output}/reports/${buildopt_family}/${buildopt_slug}.json
        jq -n --arg generatedAt "${buildopt_generated_at}" \
            --arg base "${buildopt_previous}" --arg target "${buildopt_target}" \
            --argjson changedPaths "${buildopt_changed_json}" \
            --slurpfile baseCapture "${buildopt_previous_capture[${buildopt_command_index}]}" \
            --slurpfile targetCapture "${buildopt_capture}" '
          {
            schemaVersion:"buildopt.poc/request-aligned-transition/v2",generatedAt:$generatedAt,
            baseRevision:$base,targetRevision:$target,changedPaths:$changedPaths,
            baseCapture:$baseCapture[0],targetCapture:$targetCapture[0]
          }
        ' >"${buildopt_transition}"
        "${buildopt_classifier}" --input "${buildopt_transition}" --output "${buildopt_report}"
        buildopt_transition_status=$(jq -r '.status' "${buildopt_report}")
        buildopt_transition_reason=$(jq -r '.reason' "${buildopt_report}")
        ((buildopt_comparable += 1))
        if [[ ${buildopt_transition_status} == RELEVANT_COMPLETE ]]; then
            ((buildopt_relevant += 1))
            [[ $(jq -r '.testableActions' "${buildopt_report}") == 1 ]] && ((buildopt_actions += 1)) || true
        fi
        jq -nc \
            --arg generatedAt "${buildopt_generated_at}" --arg family "${buildopt_family}" --arg dsl "${buildopt_dsl}" \
            --argjson observationOrdinal "${buildopt_observed}" --argjson commandIndex "${buildopt_command_index}" \
            --argjson command "${buildopt_command_json}" --arg baseRevision "${buildopt_previous}" \
            --arg targetRevision "${buildopt_target}" --arg status "${buildopt_transition_status}" \
            --arg reason "${buildopt_transition_reason}" \
            --arg report "reports/${buildopt_family}/${buildopt_slug}.json" \
            --arg reportSha256 "$(sha256sum "${buildopt_report}" | awk '{print $1}')" \
            --slurpfile result "${buildopt_report}" '
          {
            generatedAt:$generatedAt,family:$family,dsl:$dsl,observationOrdinal:$observationOrdinal,
            commandIndex:$commandIndex,command:$command,baseRevision:$baseRevision,targetRevision:$targetRevision,
            status:$status,reason:$reason,report:$report,reportSha256:$reportSha256,
            inputComplete:$result[0].inputComplete,testableActions:$result[0].testableActions,
            candidateTaskCount:($result[0].candidateTasks|length),omittedTaskCount:($result[0].omittedTasks|length),
            omittedOutputCount:($result[0].omittedOutputs|length),performanceMeasured:false,activationAuthorized:false
          }
        ' >>"${buildopt_output}/transitions.jsonl"
    fi

    if [[ ${buildopt_transition_status} != BASELINE_ESTABLISHED &&
          ( ${buildopt_product_failure} == true || ${buildopt_exit} -ne 0 || ${buildopt_capture_complete} != true ) ]]; then
        jq -nc \
            --arg generatedAt "${buildopt_generated_at}" --arg family "${buildopt_family}" --arg dsl "${buildopt_dsl}" \
            --argjson observationOrdinal "${buildopt_observed}" --argjson commandIndex "${buildopt_command_index}" \
            --argjson command "${buildopt_command_json}" --arg targetRevision "${buildopt_target}" \
            --arg status "${buildopt_transition_status}" --arg reason "${buildopt_transition_reason}" '
          {
            generatedAt:$generatedAt,family:$family,dsl:$dsl,observationOrdinal:$observationOrdinal,
            commandIndex:$commandIndex,command:$command,baseRevision:"",targetRevision:$targetRevision,
            status:$status,reason:$reason,report:"",reportSha256:"",inputComplete:false,
            testableActions:0,candidateTaskCount:0,omittedTaskCount:0,omittedOutputCount:0,
            performanceMeasured:false,activationAuthorized:false
          }
        ' >>"${buildopt_output}/transitions.jsonl"
    fi

    if [[ ${buildopt_exit} -eq 0 && ${buildopt_capture_complete} == true &&
          ${buildopt_exact_arguments} == true && -f ${buildopt_evidence} ]]; then
        buildopt_previous_revision[buildopt_command_index]=${buildopt_target}
        buildopt_previous_capture[buildopt_command_index]=${buildopt_capture}
    fi
    printf '%s: %d/5 relevant, %d action after %d/30 observations (%s, %s)\n' \
        "${buildopt_family}" "${buildopt_relevant}" "${buildopt_actions}" "${buildopt_observed}" \
        "${buildopt_target:0:12}" "${buildopt_transition_status}"
done

jq -n \
    --arg family "${buildopt_family}" --arg dsl "${buildopt_dsl}" \
    --argjson observations "${buildopt_observed}" --argjson comparableTransitions "${buildopt_comparable}" \
    --argjson relevantTransitions "${buildopt_relevant}" --argjson actionTransitions "${buildopt_actions}" \
    --argjson productFailures "${buildopt_product_failures}" --argjson buildFailures "${buildopt_build_failures}" \
    --arg stopReason "$([[ ${buildopt_relevant} -ge 5 ]] && printf RELEVANT_TARGET_MET || printf OBSERVATION_BUDGET_EXHAUSTED)" \
    --arg portfolio "portfolios/${buildopt_family}.json" \
    --arg portfolioSha256 "$([[ -f ${buildopt_portfolio} ]] && sha256sum "${buildopt_portfolio}" | awk '{print $1}' || true)" '
  {
    family:$family,dsl:$dsl,observations:$observations,comparableTransitions:$comparableTransitions,
    relevantTransitions:$relevantTransitions,actionTransitions:$actionTransitions,
    productFailures:$productFailures,buildFailures:$buildFailures,stopReason:$stopReason,
    inputComplete:($relevantTransitions>=5),portfolio:$portfolio,portfolioSha256:$portfolioSha256,
    performanceMeasured:false,selectionAuthorized:false,activationAuthorized:false
  }
' >"${buildopt_output}/families/${buildopt_family}.json"
chmod 0600 "${buildopt_output}/families/${buildopt_family}.json"
rm -f -- "${buildopt_portfolio}.lock"
