#!/usr/bin/env bash
set -euo pipefail

if (($# > 3)); then
    printf 'usage: %s [evidence-directory] [specification] [repository-key]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_evidence=${1:-"${buildopt_repo_root}/benchmarks/results/poc-generic-profile-matrix-v1"}
buildopt_spec=${2:-"${buildopt_repo_root}/specs/poc-generic-profile-matrix-v1.json"}
buildopt_subject_filter=${3:-}
if [[ ${buildopt_spec} != /* ]]; then
    buildopt_spec="${buildopt_repo_root}/${buildopt_spec}"
fi
buildopt_summary="${buildopt_evidence}/summary.json"

for buildopt_command in jq sha256sum; do
    command -v "${buildopt_command}" >/dev/null || {
        printf 'required command is unavailable: %s\n' "${buildopt_command}" >&2
        exit 1
    }
done
buildopt_required_files=("${buildopt_spec}")
if [[ -z ${buildopt_subject_filter} ]]; then
    buildopt_required_files+=("${buildopt_summary}")
fi
for buildopt_file in "${buildopt_required_files[@]}"; do
    [[ -f ${buildopt_file} ]] || {
        printf 'missing generic profile matrix input: %s\n' "${buildopt_file}" >&2
        exit 1
    }
done

buildopt_evidence_schema=$(jq -er '.evidenceSchemaVersion // "buildopt.evidence/poc-generic-profile-matrix/v1"' "${buildopt_spec}")
buildopt_work_item=$(jq -er '.workItem' "${buildopt_spec}")

if [[ -z ${buildopt_subject_filter} ]]; then
    jq -e \
        --arg schemaVersion "${buildopt_evidence_schema}" \
        --arg workItem "${buildopt_work_item}" '
    .schemaVersion == $schemaVersion and
    .workItem == $workItem and
    (.buildopt.revision | test("^[0-9a-f]{40}$")) and
    (.buildopt.executableSha256 | test("^[0-9a-f]{64}$")) and
    .method.candidateMechanisms == ["BUILD_IMPACT"] and
    .method.control == "OPTIMIZED_NATIVE_GRADLE_SAME_DECLARED_WORKFLOW" and
    .method.repositorySpecificProductRulesAllowed == false and
    (.subjects | length) == 5 and
    .aggregation.subjectCount == 5 and
    .aggregation.repositoryPercentagesAveraged == false and
    .aggregation.mechanismPercentagesAdded == false and
    .boundaries.proofOfConcept == true and
    .boundaries.productionAuthorized == false and
    .boundaries.automaticActivation == false and
    .boundaries.testOptimizationModified == false and
    .boundaries.soakRequired == false and
    .boundaries.designPartnerRequired == false
    ' "${buildopt_summary}" >/dev/null
fi

buildopt_repository_count=$(jq '.repositories | length' "${buildopt_spec}")
if [[ -n ${buildopt_subject_filter} ]]; then
    buildopt_subject_matches=$(jq --arg key "${buildopt_subject_filter}" \
        '[.repositories[] | select(.key == $key)] | length' "${buildopt_spec}")
    [[ ${buildopt_subject_matches} -eq 1 ]] || {
        printf 'repository key is absent or ambiguous: %s\n' "${buildopt_subject_filter}" >&2
        exit 1
    }
fi
for ((buildopt_index = 0; buildopt_index < buildopt_repository_count; buildopt_index++)); do
    buildopt_key=$(jq -er ".repositories[${buildopt_index}].key" "${buildopt_spec}")
    if [[ -n ${buildopt_subject_filter} && ${buildopt_key} != "${buildopt_subject_filter}" ]]; then
        continue
    fi
    buildopt_subject="${buildopt_evidence}/${buildopt_key}"
    for buildopt_name in buildopt-changes.txt buildopt-profile-proposal.json result.json; do
        [[ -s ${buildopt_subject}/${buildopt_name} ]] || {
            printf 'missing %s matrix evidence: %s\n' "${buildopt_key}" "${buildopt_name}" >&2
            exit 1
        }
    done
    jq -e \
        --arg key "${buildopt_key}" \
        --slurpfile spec "${buildopt_spec}" '
        ($spec[0].repositories[] | select(.key == $key)) as $expected |
        .schemaVersion == "buildopt.poc/profile-proposal/v1" and
        .repositoryId == $expected.repositoryId and
        .baseRevision == $expected.publicRevision and
        .changedPaths == [$expected.changePath] and
        .requiredOutputs == $expected.requiredOutputs and
        .reviewRequired == true and
        .activationAutomatic == false and
        .productionAuthorized == false and
        .testOptimization == "OUT_OF_SCOPE" and
        ((.decision == "MEASURE_STRUCTURAL_CANDIDATE" and
          .candidateEntrypoints == $expected.expectedCandidateEntrypoints and
          .reason == "COMPLETE_STRUCTURAL_REDUCTION" and
          .unknownRelationships == false) or
         (.decision == "NATIVE_FULL_GRAPH" and
          (.reason | IN("ORIGINAL_WORKFLOW_UNSUPPORTED", "CANDIDATE_WORKFLOW_UNSUPPORTED",
                        "CANDIDATE_GRAPH_INCOMPLETE", "NO_SAFE_STRUCTURAL_CANDIDATE",
                        "SOURCE_OWNERSHIP_AMBIGUOUS"))))
    ' "${buildopt_subject}/buildopt-profile-proposal.json" >/dev/null

    buildopt_status=$(jq -er '.measurementStatus' "${buildopt_subject}/result.json")
    if [[ ${buildopt_status} == COMPLETED ]]; then
        for buildopt_name in buildopt-impact-manifest.json buildopt-impact-graph.generated.json \
            buildopt-impact.generated.json buildopt-fallback-changes.txt evidence.json \
            evaluation.json measurement.log; do
            [[ -s ${buildopt_subject}/${buildopt_name} ]] || {
                printf 'missing completed %s evidence: %s\n' "${buildopt_key}" "${buildopt_name}" >&2
                exit 1
            }
        done
        jq -e '
            .schemaVersion == "buildopt.evidence/structural-profile-qualification/v1" and
            (.evidenceState | IN("QUALIFIED", "INCONCLUSIVE")) and
            .execution.candidateSurface == "INSTALLED_BUILDOPT_STRUCTURAL_IMPACT_ONLY" and
            .execution.mechanisms == ["BUILD_IMPACT"] and
            .execution.launcherOverheadIncluded == true and
            (.observations | length) == 8 and
            all(.observations[];
                .productAttributableFailure == false and
                .requiredOutputCount > 0 and
                .controlRequiredOutputSha256 == .candidateRequiredOutputSha256) and
            .fallback.mode == "FULL_GRAPH" and
            .fallback.buildSuccessful == true and
            .boundaries.repositorySpecificRuleAdded == false and
            .boundaries.testOptimizationModified == false
        ' "${buildopt_subject}/evidence.json" >/dev/null
        jq -e \
            --slurpfile evidence "${buildopt_subject}/evidence.json" \
            --slurpfile evaluation "${buildopt_subject}/evaluation.json" '
            .measurementStatus == "COMPLETED" and
            .result == $evidence[0].result and
            .evaluationDecision == $evaluation[0].decision
        ' "${buildopt_subject}/result.json" >/dev/null
    elif [[ ${buildopt_status} != NOT_RUN_NATIVE_FULL_GRAPH && \
        ${buildopt_status} != MEASUREMENT_UNAVAILABLE ]]; then
        printf 'invalid %s measurement status: %s\n' "${buildopt_key}" "${buildopt_status}" >&2
        exit 1
    elif [[ ${buildopt_status} == MEASUREMENT_UNAVAILABLE ]]; then
        jq -e '
            .result == null and .evaluationDecision == "NATIVE_FULL_GRAPH"
        ' "${buildopt_subject}/result.json" >/dev/null
        jq -e '. == null' "${buildopt_subject}/evidence.json" >/dev/null
        grep -Fq -- 'structural profile measurement unavailable:' \
            "${buildopt_subject}/measurement.log"
    fi
done

if [[ -n ${buildopt_subject_filter} ]]; then
    printf 'Generic profile subject %s: PASS\n' "${buildopt_subject_filter}"
    exit 0
fi

jq -e \
    --slurpfile spec "${buildopt_spec}" \
    --slurpfile spring "${buildopt_evidence}/spring-framework/result.json" \
    --slurpfile otel "${buildopt_evidence}/opentelemetry-java-instrumentation/result.json" \
    --slurpfile kafka "${buildopt_evidence}/apache-kafka/result.json" \
    --slurpfile micronaut "${buildopt_evidence}/micronaut-core/result.json" \
    --slurpfile groovy "${buildopt_evidence}/apache-groovy/result.json" '
    ([$spring[0], $otel[0], $kafka[0], $micronaut[0], $groovy[0]]) as $results |
    .subjects == $results and
    .aggregation.subjectCount == ($results | length) and
    .aggregation.structurallyProposed ==
        ($results | map(select(.proposal.decision == "MEASURE_STRUCTURAL_CANDIDATE")) | length) and
    .aggregation.measured ==
        ($results | map(select(.measurementStatus == "COMPLETED")) | length) and
    .aggregation.qualified ==
        ($results | map(select(.result.qualified == true)) | length) and
    .retainedCompositionContext == $spec[0].retainedCompositionContext and
    all(.retainedCompositionContext[];
        (.evidence | type) == "string" and
        (.mechanisms | length) >= 1 and
        (.reductionRatio >= 0 and .reductionRatio < 1) and
        (.qualified | type) == "boolean")
' "${buildopt_summary}" >/dev/null

printf 'Five-repository generic profile matrix: PASS\n'
