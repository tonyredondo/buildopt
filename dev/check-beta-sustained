#!/usr/bin/env bash
set -euo pipefail

buildopt_mode=trial
case "${1:-}" in
    "")
        if (($# != 0)); then
            printf 'usage: %s [--qualify]\n' "$0" >&2
            exit 64
        fi
        ;;
    --qualify)
        if (($# != 1)); then
            printf 'usage: %s [--qualify]\n' "$0" >&2
            exit 64
        fi
        buildopt_mode=qualify
        ;;
    *)
        printf 'usage: %s [--qualify]\n' "$0" >&2
        exit 64
        ;;
esac

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_contract="${buildopt_repo_root}/specs/beta-sustained-v1.json"
buildopt_manifest="${buildopt_repo_root}/benchmarks/beta-v1.yaml"
buildopt_runner_spec="${buildopt_repo_root}/specs/golden-lane-runner-v1.json"

for buildopt_command in awk docker getconf git id jq; do
    if ! command -v "${buildopt_command}" >/dev/null 2>&1; then
        printf 'required beta sustained command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    fi
done

if ! jq -e '
    . == {
        schemaVersion: "buildopt.specs/beta-sustained/v1",
        gateId: "OPS-001/A1",
        manifest: "benchmarks/beta-v1.yaml",
        commands: {
            trial: "dev/check-beta-sustained",
            qualify: "dev/check-beta-sustained --qualify",
            validate: "beta-benchmark validate-sustained --manifest PATH --result PATH"
        },
        production: {
            qualification: "SUSTAINED_SLICE",
            phase: "SUSTAINED",
            totalDurationSeconds: 3600,
            clients: [1, 8, 32],
            minimumSecondsPerClientStratum: 1200,
            logicalOperationsPerStratum: 10000,
            rawObservations: 30000,
            objectIdentityCount: 100,
            logicalCycleRepeats: 100,
            objectSizesBytes: [65536, 1048576, 10485760, 104857600],
            objectPercentages: [70, 20, 8, 2],
            hitPercent: 70,
            maximumManagedGatewayInFlightBytes: 209715200,
            authorityValiditySeconds: 7200,
            runner: "linux-amd64-4c-16g-v1",
            cpuMax: "400000 100000",
            memoryMax: "17179869184"
        },
        trial: {
            qualification: "TRIAL",
            totalDurationMilliseconds: 900,
            logicalOperationsPerStratum: 100,
            rawObservations: 300,
            scaledSizesBytes: [4096, 65536, 524288, 1048576],
            runnerVerified: false,
            qualifying: false
        },
        execution: {
            transport: "REAL_MANAGED_GATEWAY_LOOPBACK_HTTP",
            storage: "REAL_SINGLE_NODE_SHARED",
            preload: "100_COMPLETE_PENDING_PUTS_THEN_ED25519_COMMIT",
            payloads: "DETERMINISTIC_NON_SPARSE_BYTES",
            scheduler: "DETERMINISTIC_PACED_BATCHES_BOUNDED_BY_CLIENTS_AND_GATEWAY_BYTES",
            errorsAllowed: 0,
            rawFormat: "PRIVATE_JSONL",
            summaryFormat: "PRIVATE_JSON",
            latencyMeasurements: {
                gatewayMiss: "REQUEST_START_TO_RESPONSE_HEADERS",
                verifiedHitReady: "REQUEST_START_TO_VERIFIED_RESPONSE_HEADERS",
                downstreamMaterialization: "RESPONSE_HEADERS_TO_COMPLETE_BODY"
            },
            manifestDigestBound: true,
            rawDigestBound: true,
            unknownFieldsRejected: true,
            tamperRejected: true,
            trialRejectedByProductionValidator: true
        },
        p95TargetsMilliseconds: {
            miss: 50,
            verifiedHitUpTo1MiB: 150,
            verifiedHitUpTo10MiB: 400,
            verifiedHitUpTo100MiB: 2500,
            downstreamBaseMilliseconds: 150,
            downstreamBytesPerSecond: 209715200
        },
        boundaries: {
            closesAfterQualifyingRun: [
                "OPS-001/A1-SUSTAINED-60-MINUTES"
            ],
            doesNotClose: [
                "OPS-001/A1",
                "A1-G02",
                "EIGHT_HOUR_SOAK",
                "GRADLE_FIXTURE_MATRIX"
            ]
        }
    }
' "${buildopt_contract}" >/dev/null; then
    printf 'beta sustained contract is malformed\n' >&2
    exit 1
fi

buildopt_before_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)
buildopt_temp_root=$(mktemp -d)
trap 'rm -rf -- "${buildopt_temp_root}"' EXIT
buildopt_binary="${buildopt_temp_root}/buildopt"
buildopt_benchmark_binary="${buildopt_temp_root}/beta-benchmark"
buildopt_result="${buildopt_temp_root}/output/sustained-result.json"

cd -- "${buildopt_repo_root}"
CGO_ENABLED=0 "${buildopt_script_dir}/run" --toolchain go -- \
    go build -buildvcs=false -trimpath \
    -o "${buildopt_binary}" ./cmd/buildopt
CGO_ENABLED=0 "${buildopt_script_dir}/run" --toolchain go -- \
    go build -buildvcs=false -trimpath \
    -o "${buildopt_benchmark_binary}" ./cmd/beta-benchmark

if [[ "${buildopt_mode}" == "trial" ]]; then
    "${buildopt_benchmark_binary}" sustained-trial \
        --manifest "${buildopt_manifest}" \
        --state-dir "${buildopt_temp_root}/state" \
        --output-dir "${buildopt_temp_root}/output" \
        --buildopt "${buildopt_binary}"
    "${buildopt_benchmark_binary}" validate-sustained-trial \
        --manifest "${buildopt_manifest}" \
        --result "${buildopt_result}"
    if "${buildopt_benchmark_binary}" validate-sustained \
        --manifest "${buildopt_manifest}" \
        --result "${buildopt_result}" >/dev/null 2>&1; then
        printf 'beta sustained trial passed qualifying validation\n' >&2
        exit 1
    fi
    "${buildopt_script_dir}/run" --toolchain go -- \
        go test -race -count=1 ./internal/betabenchmark \
        -run \
        "^(TestRunSustainedTrialUsesManagedGatewayAndRejectsTampering|TestGoldenRunnerCgroupRequiresExactLimits|TestSustainedAuthorityCoversQualificationWindow|TestSustainedLatencyTargetsSeparateReadyAndMaterialization)$"
    "${buildopt_script_dir}/run" --toolchain go -- \
        go vet ./internal/betabenchmark ./cmd/beta-benchmark
else
    "${buildopt_script_dir}/check-golden-lane" --static
    if ! docker info >/dev/null 2>&1; then
        printf 'Docker daemon is unavailable\n' >&2
        exit 1
    fi
    buildopt_required_cpu=$(jq -er '.runnerClass.cpuCount' "${buildopt_runner_spec}")
    buildopt_required_memory=$(jq -er '.runnerClass.memoryBytes' "${buildopt_runner_spec}")
    buildopt_minimum_memory=$(jq -er '.runnerClass.minimumObservedMemoryBytes' "${buildopt_runner_spec}")
    buildopt_host_cpu=$(getconf _NPROCESSORS_ONLN)
    buildopt_host_memory=$(awk '/MemTotal:/ {printf "%.0f", $2 * 1024}' /proc/meminfo)
    if ((
        buildopt_host_cpu < buildopt_required_cpu ||
        buildopt_host_memory < buildopt_minimum_memory
    )); then
        printf 'host cannot enforce the beta sustained runner class\n' >&2
        exit 2
    fi
    buildopt_image=$(jq -er '.container.reference' "${buildopt_runner_spec}")
    buildopt_repository=$(jq -er '.container.repository' "${buildopt_runner_spec}")
    buildopt_index_digest=$(jq -er '.container.indexDigest' "${buildopt_runner_spec}")
    buildopt_platform_digest=$(jq -er '.container.platformDigest' "${buildopt_runner_spec}")
    buildopt_platform_os=$(jq -er '.runnerClass.operatingSystem' "${buildopt_runner_spec}")
    buildopt_platform_arch=$(jq -er '.runnerClass.architecture' "${buildopt_runner_spec}")
    buildopt_index_reference="${buildopt_repository}@${buildopt_index_digest}"
    if ! buildopt_index_manifest=$(
        docker manifest inspect "${buildopt_index_reference}" 2>/dev/null
    ) || ! jq -e \
        --arg buildopt_os "${buildopt_platform_os}" \
        --arg buildopt_arch "${buildopt_platform_arch}" \
        --arg buildopt_digest "${buildopt_platform_digest}" \
        '
            (
                .mediaType == "application/vnd.oci.image.index.v1+json" or
                .mediaType ==
                    "application/vnd.docker.distribution.manifest.list.v2+json"
            ) and
            (
                [
                    .manifests[]? |
                    select(
                        .platform.os == $buildopt_os and
                        .platform.architecture == $buildopt_arch
                    )
                ] |
                length == 1 and
                .[0].digest == $buildopt_digest
            )
        ' <<<"${buildopt_index_manifest}" >/dev/null; then
        printf 'golden image index does not bind the pinned platform digest\n' >&2
        exit 1
    fi
    if ! buildopt_image_json=$(
        docker image inspect "${buildopt_image}" 2>/dev/null
    ) || ! jq -e \
        --arg buildopt_digest "${buildopt_platform_digest}" \
        '
            length == 1 and
            .[0].Os == "linux" and
            .[0].Architecture == "amd64" and
            any(
                .[0].RepoDigests[]?;
                endswith("@" + $buildopt_digest)
            )
        ' <<<"${buildopt_image_json}" >/dev/null; then
        printf 'local golden image does not match the pinned platform digest\n' >&2
        exit 1
    fi
    mkdir -m 0700 "${buildopt_temp_root}/home"
    if ! docker run \
        --rm \
        --pull never \
        --platform "${buildopt_platform_os}/${buildopt_platform_arch}" \
        --user "$(id -u):$(id -g)" \
        --cpus "${buildopt_required_cpu}" \
        --memory "${buildopt_required_memory}" \
        --env HOME=/benchmark/home \
        --env LANG=C.UTF-8 \
        --env LC_ALL=C.UTF-8 \
        --env TZ=UTC \
        --volume "${buildopt_repo_root}:/workspace:ro" \
        --volume "${buildopt_temp_root}:/benchmark" \
        --workdir /workspace \
        "${buildopt_image}" \
        /benchmark/beta-benchmark sustained \
        --manifest /workspace/benchmarks/beta-v1.yaml \
        --state-dir /benchmark/state \
        --output-dir /benchmark/output \
        --buildopt /benchmark/buildopt; then
        if [[ -f "${buildopt_result}" ]]; then
            jq -r '
                .latencyTargets[] |
                select(.status != "PASSED") |
                "failed target: clients=\(.clients) metric=\(.metric) size=\(.sizeBytes) p95=\((.p95Ns / 10000 | round) / 100)ms limit=\((.maximumP95Ns / 10000 | round) / 100)ms"
            ' "${buildopt_result}" >&2
        fi
        exit 1
    fi
    "${buildopt_benchmark_binary}" validate-sustained \
        --manifest "${buildopt_manifest}" \
        --result "${buildopt_result}"
    jq -e '
        .qualification == "SUSTAINED_SLICE" and
        .runnerVerified == true and
        .cycleOperations == 10000 and
        .rawObservations.count == 30000 and
        ([.latencyTargets[].status] | unique) == ["PASSED"] and
        ([.throughput[].durationNs] | add) >= 3600000000000
    ' "${buildopt_result}" >/dev/null
    jq -r '
        [
            .latencyTargets[] |
            . + {ratio: (.p95Ns / .maximumP95Ns)}
        ] |
        group_by(.clients)[] |
        max_by(.ratio) |
        "clients=\(.clients) worst-p95=\((.p95Ns / 10000 | round) / 100)ms metric=\(.metric) size=\(.sizeBytes) limit=\((.maximumP95Ns / 10000 | round) / 100)ms"
    ' "${buildopt_result}"
fi

buildopt_after_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)
if [[ "${buildopt_after_status}" != "${buildopt_before_status}" ]]; then
    printf 'beta sustained checker changed the working tree\n' >&2
    exit 1
fi

if [[ "${buildopt_mode}" == "trial" ]]; then
    printf 'OPS-001/A1 sustained trial OK: real managed gateway, 300 strict observations, qualifying validator rejected the trial\n'
else
    printf 'OPS-001/A1 sustained load OK: 3600 seconds, 1/8/32 clients, 30000 strict observations, golden runner and p95 targets verified\n'
fi
