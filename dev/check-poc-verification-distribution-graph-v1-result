#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: ./dev/check-poc-verification-distribution-graph-v1-result [RESULT_FILE]\n' >&2
    exit 64
fi

buildopt_script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(CDPATH='' cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-verification-distribution-graph-v1.json"
buildopt_runner="${buildopt_script_dir}/run-poc-verification-distribution-graph-v1"
buildopt_result=${1:-"${buildopt_repo_root}/benchmarks/results/poc-verification-distribution-graph-v1.json"}

"${buildopt_script_dir}/check-poc-verification-distribution-graph-v1" >/dev/null
jq -e --slurpfile spec "${buildopt_spec}" '
  .schemaVersion == "buildopt.poc/verification-distribution-graph-result/v1" and
  .workItem == "POC-VERIFICATION-DISTRIBUTION-GRAPH-001" and
  (.capturedAt | fromdateiso8601) and
  (.buildoptRevision | test("^[0-9a-f]{40}$")) and
  (.specSha256 | test("^[0-9a-f]{64}$")) and
  (.runnerSha256 | test("^[0-9a-f]{64}$")) and
  (.installedBinarySha256 | test("^[0-9a-f]{64}$")) and
  .sourceArchiveSha256 == $spec[0].repository.sourceArchiveSha256 and
  (.buildCacheSeedSha256 | test("^[0-9a-f]{64}$")) and
  .runner == {os:$spec[0].runner.os,arch:$spec[0].runner.arch,
    cpuCount:$spec[0].runner.cpuCount,maxWorkers:$spec[0].runner.maxWorkers} and
  .graphContracts == {verificationComplete:true,sourceDistributionComplete:true,
    verificationOriginalProjects:23,verificationCandidateProjects:12,
    distributionOriginalProjects:22,distributionCandidateProjects:12} and
  (.pairs | length) == $spec[0].runner.pairCount and
  [.pairs[].order] == $spec[0].runner.order and
  all(.pairs[]; .controlMs > 0 and .candidateMs > 0 and
    .savedMs == (.controlMs - .candidateMs) and
    .maximumArmGapMs <= $spec[0].runner.maximumPairSeparationMs and
    (.requiredOutputSha256 | test("^[0-9a-f]{64}$")) and
    .outputIdentical == true) and
  .result.controlMeanMs == ([.pairs[].controlMs] | add / length) and
  .result.candidateMeanMs == ([.pairs[].candidateMs] | add / length) and
  .result.meanSavedMs == ([.pairs[].savedMs] | add / length) and
  .result.meanSavedPercent ==
    (((.result.meanSavedMs * 10000 / .result.controlMeanMs) | round) / 100) and
  .result.positivePairs == ([.pairs[].savedMs | select(. > 0)] | length) and
  .result.pairedLowerBoundMs == ([.pairs[].savedMs] | min) and
  .result.maximumArmGapMs == ([.pairs[].maximumArmGapMs] | max) and
  .result.outputsIdentical == true and
  .result.productFailures == 0 and
  .result.fallbackPassed == true and
  .decision == (
    if (.result.meanSavedMs >= $spec[0].valueGate.minimumMeanSavedMs and
        .result.meanSavedPercent >= $spec[0].valueGate.minimumMeanSavedPercent and
        .result.positivePairs >= $spec[0].valueGate.minimumPositivePairs and
        .result.pairedLowerBoundMs > 0)
    then $spec[0].terminalDecisions.qualifies
    else $spec[0].terminalDecisions.doesNotQualify
    end
  ) and
  .boundaries == {pocOnly:true,testOptimizationModified:false,
    otherOptimizationsEnabled:false,productionAuthorityChanged:false}
' "${buildopt_result}" >/dev/null

[[ "$(jq -er '.specSha256' "${buildopt_result}")" == \
    "$(sha256sum "${buildopt_spec}" | awk '{print $1}')" ]] || {
    printf 'verification graph result spec digest mismatch\n' >&2
    exit 1
}
[[ "$(jq -er '.runnerSha256' "${buildopt_result}")" == \
    "$(sha256sum "${buildopt_runner}" | awk '{print $1}')" ]] || {
    printf 'verification graph result runner digest mismatch\n' >&2
    exit 1
}

printf 'Verification and distribution graph result contract: PASS\n'
