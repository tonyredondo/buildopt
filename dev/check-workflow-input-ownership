#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [EVIDENCE_ROOT]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_evidence_root=${1:-"${buildopt_repo_root}/benchmarks/results/poc-workflow-input-ownership-v1"}
buildopt_summary=${buildopt_evidence_root}/summary.json
buildopt_contract=${buildopt_repo_root}/specs/poc-workflow-input-ownership-v1.md

for buildopt_command in git jq mktemp; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'workflow-input ownership validation requires %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done

for buildopt_file in \
    "${buildopt_contract}" \
    "${buildopt_evidence_root}/README.md" \
    "${buildopt_summary}"; do
    [[ -s ${buildopt_file} ]] || {
        printf 'workflow-input ownership file is unavailable: %s\n' \
            "${buildopt_file}" >&2
        exit 1
    }
done

buildopt_before=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
buildopt_tmp=$(mktemp -d /tmp/buildopt-workflow-input-check.XXXXXX)
trap 'rm -rf -- "${buildopt_tmp}"' EXIT

jq -e '
  .schemaVersion == "buildopt.evidence/poc-workflow-input-ownership/v1" and
  .workItem == "POC-WORKFLOW-INPUT-OWNERSHIP-001" and
  .capturedAt == "2026-08-22" and
  .buildoptRevision == "eeb02b6fc1665018fafed634b5d7781957954cd2" and
  .subject.repositoryId ==
    "open-telemetry/opentelemetry-java-instrumentation" and
  .subject.baseRevision == "0ae4cc70d2c2a2bd02f71a33f90b80db7e65ef99" and
  .subject.targetRevision == "dc7e94b40f1b86a19ec3449d895e80ff3c5754a4" and
  .subject.targetTreePreserved == true and
  .subject.localAncestryReconstructed == true and
  (.subject.workflowEntrypoints | length) == 4 and
  .observation.schemaVersion ==
    "buildopt.build-impact/workflow-input-relevance/v1" and
  .observation.complete == true and
  .observation.fallbackReasons == [] and
  (.observation.paths | length) == 4 and
  .observation.paths[0] == {
    path:"CHANGELOG.md",ownerProjects:[],consumingTasks:[],
    disposition:"IGNORED_AS_WORKFLOW_IRRELEVANT"} and
  .observation.paths[1].disposition == "RETAINED_OWNED_PATH" and
  .observation.paths[1].consumingTasks == [] and
  .observation.paths[2].consumingTasks ==
    [":instrumentation:jmx-metrics:library:processResources"] and
  .observation.paths[3].consumingTasks ==
    [":instrumentation:jmx-metrics:library:compileTestJava"] and
  .result.outcome == "LEARNING" and
  .result.reason == "CALIBRATION_PAIR_BUDGET_INSUFFICIENT" and
  .result.nativeExitCode == 0 and
  .result.discoveryStatus == "COMPLETE" and
  .result.discoveryReason == "STRUCTURAL_CANDIDATE_DISCOVERED" and
  .result.changedPathCount == 4 and
  .result.changedProjects == [":instrumentation:jmx-metrics:library"] and
  .result.workflowIgnoredPaths == ["CHANGELOG.md"] and
  .result.graph == {
    totalProjects:1027,selectedProjects:8,omittedProjects:1019} and
  .result.candidateEntrypoints ==
    [":instrumentation:jmx-metrics:library:testClasses"] and
  .result.calibrationPerformed == false and
  .result.selectionPerformed == false and
  .result.performanceClaimed == false and
  .result.productFailures == 0 and
  all(.fixtureCoverage[]; . == true) and
  .decision == "WORKFLOW_INPUT_OWNERSHIP_PROVEN" and
  .nextWork == "POC-NATIVE-VOLATILITY-QUARANTINE-001" and
  .boundaries == {
    proofOfConcept:true,productionAuthorized:false,
    repositorySpecificProductRules:false,filenameExtensionRules:false,
    performanceClaimed:false,claimBroadened:false,soakRequired:false,
    designPartnerRequired:false,testOptimization:"OUT_OF_SCOPE"}
' "${buildopt_summary}" >/dev/null

buildopt_revision=$(jq -r '.buildoptRevision' "${buildopt_summary}")
git -C "${buildopt_repo_root}" cat-file -e "${buildopt_revision}^{commit}"

buildopt_grep_status=0
git -C "${buildopt_repo_root}" grep -ilE \
    'opentelemetry|CHANGELOG\.md|jetty' -- \
    internal/buildimpact \
    internal/launcher \
    dev/check-magic-auto-discovery \
    ':(exclude)**/*_test.go' \
    >"${buildopt_tmp}/subject-specific-files.txt" || buildopt_grep_status=$?
if ((buildopt_grep_status > 1)); then
    printf 'workflow-input ownership source scan failed\n' >&2
    exit 1
fi
if [[ -s ${buildopt_tmp}/subject-specific-files.txt ]]; then
    printf 'workflow-input ownership implementation contains subject-specific rules\n' >&2
    exit 1
fi

jq '.result.performanceClaimed = true' "${buildopt_summary}" \
    >"${buildopt_tmp}/tampered.json"
if jq -e '.result.performanceClaimed == false' \
    "${buildopt_tmp}/tampered.json" >/dev/null; then
    printf 'tampered workflow-input performance claim was accepted\n' >&2
    exit 1
fi

buildopt_after=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
[[ ${buildopt_before} == "${buildopt_after}" ]] || {
    printf 'workflow-input ownership validation changed the working tree\n' >&2
    exit 1
}

printf 'Workflow-input ownership evidence OK: OpenTelemetry 1027 -> 8 projects, one proven-irrelevant path, no performance claim\n'
