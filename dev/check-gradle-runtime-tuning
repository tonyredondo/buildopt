#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_test_root=$(mktemp -d)

buildopt_cleanup() {
    if [[ "${buildopt_test_root}" == "${TMPDIR:-/tmp}/"* ]]; then
        rm -rf -- "${buildopt_test_root}"
    fi
}
trap buildopt_cleanup EXIT

mkdir -p -- "${buildopt_test_root}/project"
cat >"${buildopt_test_root}/project/settings.gradle" <<'EOF'
rootProject.name = 'buildopt-runtime-tuning-fixture'
EOF
cat >"${buildopt_test_root}/project/build.gradle" <<'EOF'
plugins {
    id 'checkstyle'
}

tasks.register('checkstyleNohttp', Checkstyle) {
    maxHeapSize = providers.gradleProperty('fixtureHeap').getOrElse('1g')
    source files()
    classpath = files()
    config = resources.text.fromString('<?xml version="1.0"?><module name="Checker"/>')
}

tasks.register('printRuntimeHeap') {
    doLast {
        println "runtimeHeap=${tasks.named('checkstyleNohttp').get().maxHeapSize.get()}"
    }
}
EOF

buildopt_gradle_home=${GRADLE_USER_HOME:-"${buildopt_repo_root}/.tools/gradle-user-home/local"}
buildopt_gradle=(
    "${buildopt_script_dir}/run" --toolchain temurin-jdk-21 --
    "${buildopt_repo_root}/gradlew" --no-daemon --offline
    -p "${buildopt_test_root}/project"
    --init-script "${buildopt_repo_root}/.github/actions/buildopt.init.gradle"
)
buildopt_plugin_jar=$(find "${buildopt_repo_root}/jvm/gradle-plugin/build/libs" \
    -maxdepth 1 -type f -name 'buildopt-gradle-plugin-*.jar' \
    ! -name '*-sources.jar' ! -name '*-javadoc.jar' -print -quit)
if [[ -z "${buildopt_plugin_jar}" ]]; then
    printf 'runtime tuning check requires the Gradle plugin JAR\n' >&2
    exit 1
fi

buildopt_run_fixture() {
    local buildopt_log=$1
    local buildopt_heap=$2
    shift 2
    local buildopt_environment=(env -u BUILDOPT_RUNTIME_CHECKSTYLE_MAX_HEAP)
    if [[ -n "${buildopt_heap}" ]]; then
        buildopt_environment=(env \
            "BUILDOPT_RUNTIME_CHECKSTYLE_MAX_HEAP=${buildopt_heap}")
    fi
    "${buildopt_environment[@]}" \
        GRADLE_USER_HOME="${buildopt_gradle_home}" \
        BUILDOPT_GRADLE_PLUGIN_JAR="${buildopt_plugin_jar}" \
        BUILDOPT_GRADLE_PROJECT_PLUGIN_MODE=CACHE_ONLY \
        "${buildopt_gradle[@]}" "$@" printRuntimeHeap >"${buildopt_log}" 2>&1
}

if ! buildopt_run_fixture "${buildopt_test_root}/disabled.log" ''; then
    sed -n '1,200p' "${buildopt_test_root}/disabled.log" >&2
    exit 1
fi
grep -Fq 'runtimeHeap=1g' "${buildopt_test_root}/disabled.log" || {
    printf 'disabled runtime tuning changed the repository heap\n' >&2
    exit 1
}

if ! buildopt_run_fixture "${buildopt_test_root}/enabled.log" 2g; then
    sed -n '1,200p' "${buildopt_test_root}/enabled.log" >&2
    exit 1
fi
grep -Fq 'runtimeHeap=2g' "${buildopt_test_root}/enabled.log" || {
    printf 'qualified runtime tuning did not select the 2 GiB heap\n' >&2
    exit 1
}

mkdir -p -- \
    "${buildopt_test_root}/install/bin" \
    "${buildopt_test_root}/install/share/buildopt"
"${buildopt_script_dir}/run" --toolchain go -- go build \
    -mod=readonly -buildvcs=false -trimpath \
    -o "${buildopt_test_root}/install/bin/buildopt" \
    "${buildopt_repo_root}/cmd/buildopt"
install -m 0644 "${buildopt_repo_root}/.github/actions/buildopt.init.gradle" \
    "${buildopt_test_root}/install/share/buildopt/buildopt.init.gradle"
install -m 0644 "${buildopt_plugin_jar}" \
    "${buildopt_test_root}/install/share/buildopt/buildopt-gradle-plugin.jar"
if ! (
    cd "${buildopt_repo_root}"
    env \
        BUILDOPT_RUNTIME_CHECKSTYLE_MAX_HEAP=2g \
        BUILDOPT_RUNNER_AVAILABLE_MEMORY_BYTES=16659865600 \
        GRADLE_USER_HOME="${buildopt_gradle_home}" \
        "${buildopt_test_root}/install/bin/buildopt" gradle \
        --no-daemon --offline -p "${buildopt_test_root}/project" \
        printRuntimeHeap
) >"${buildopt_test_root}/installed.log" 2>&1; then
    sed -n '1,200p' "${buildopt_test_root}/installed.log" >&2
    exit 1
fi
grep -Fq 'runtimeHeap=2g' "${buildopt_test_root}/installed.log" || {
    printf 'installed launcher did not apply qualified runtime tuning\n' >&2
    exit 1
}
if grep -Eq 'authenticated Gradle plugin handshake|local gateway' \
    "${buildopt_test_root}/installed.log"; then
    printf 'local runtime tuning started unnecessary instrumentation\n' >&2
    exit 1
fi

if ! buildopt_run_fixture "${buildopt_test_root}/preserved.log" 2g -PfixtureHeap=3g; then
    sed -n '1,200p' "${buildopt_test_root}/preserved.log" >&2
    exit 1
fi
grep -Fq 'runtimeHeap=3g' "${buildopt_test_root}/preserved.log" || {
    printf 'runtime tuning replaced a repository-owned non-1g heap\n' >&2
    exit 1
}

if buildopt_run_fixture "${buildopt_test_root}/invalid.log" 4g; then
    printf 'runtime tuning accepted an unqualified heap\n' >&2
    exit 1
fi
grep -Fq 'unsupported BUILDOPT_RUNTIME_CHECKSTYLE_MAX_HEAP: 4g' \
    "${buildopt_test_root}/invalid.log" || {
    printf 'runtime tuning invalid-heap failure was not explicit\n' >&2
    exit 1
}

printf 'Gradle Runtime Tuning OK: installed launcher raised exact 1g NoHTTP task to 2g without gateway instrumentation; repository overrides preserved and invalid profile rejected\n'
