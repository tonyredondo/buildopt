#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)); then
    printf 'usage: %s OUTPUT_FILE\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-spring-framework-v1.json"

if [[ "${buildopt_output}" != /* || -e "${buildopt_output}" ]]; then
    printf 'invalid Spring value output path\n' >&2
    exit 64
fi
for buildopt_command in awk cmp cp curl date find git grep jq mkdir mktemp \
    sed sha256sum sort tar; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required Spring value command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
[[ -x /usr/bin/time ]] || {
    printf 'required Spring value command is unavailable: /usr/bin/time\n' >&2
    exit 1
}
if [[ -n "$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)" ]]; then
    printf 'Spring value measurement requires a clean revision-bound checkout\n' >&2
    exit 1
fi

"${buildopt_script_dir}/check-poc-spring-framework" >/dev/null

buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-spring-value.XXXXXX")
buildopt_stop_gradle() {
    local buildopt_checkout=$1
    local buildopt_home=$2
    if [[ -x "${buildopt_checkout}/gradlew" && -d "${buildopt_home}" ]]; then
        (
            cd "${buildopt_checkout}"
            env GRADLE_USER_HOME="${buildopt_home}" \
                "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
                ./gradlew --stop
        ) >/dev/null 2>&1 || true
    fi
}
buildopt_cleanup() {
    if [[ "${buildopt_root}" == "${TMPDIR:-/tmp}/buildopt-spring-value."* ]]; then
        buildopt_stop_gradle "${buildopt_root}/source" \
            "${buildopt_root}/preflight-home"
        buildopt_stop_gradle "${buildopt_root}/control/checkout" \
            "${buildopt_root}/control/gradle-home"
        buildopt_stop_gradle "${buildopt_root}/candidate/checkout" \
            "${buildopt_root}/candidate/gradle-home"
        rm -rf -- "${buildopt_root}"
    fi
}
trap buildopt_cleanup EXIT
chmod 0700 "${buildopt_root}"
mkdir -p -- "${buildopt_root}/release" "${buildopt_root}/package" \
    "${buildopt_root}/install" "${buildopt_root}/source" \
    "${buildopt_root}/preflight-home" "${buildopt_root}/logs"
chmod 0700 "${buildopt_root}/preflight-home"

buildopt_revision=$(git -C "${buildopt_repo_root}" rev-parse HEAD)
buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_archive=$(
    "${buildopt_repo_root}/packaging/linux/package.sh" \
        --version 0.3.0-spring-runtime --output "${buildopt_root}/release"
)
tar -xzf "${buildopt_archive}" -C "${buildopt_root}/package"
buildopt_package_root=$(find "${buildopt_root}/package" -mindepth 1 -maxdepth 1 \
    -type d -name 'buildopt-0.3.0-spring-runtime-linux-amd64' -print -quit)
[[ -n "${buildopt_package_root}" ]] || {
    printf 'Spring value package layout is unavailable\n' >&2
    exit 1
}
"${buildopt_package_root}/install.sh" --prefix "${buildopt_root}/install" >/dev/null
"${buildopt_root}/install/bin/buildopt" doctor >/dev/null
buildopt_executable_sha=$(sha256sum "${buildopt_root}/install/bin/buildopt" | awk '{print $1}')
buildopt_plugin_sha=$(sha256sum \
    "${buildopt_root}/install/share/buildopt/buildopt-gradle-plugin.jar" | awk '{print $1}')

buildopt_source_archive="${buildopt_root}/spring-framework.tar.gz"
buildopt_source_url=$(jq -er '.repository.sourceArchiveUrl' "${buildopt_spec}")
buildopt_source_sha=$(jq -er '.repository.sourceArchiveSha256' "${buildopt_spec}")
curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
    --output "${buildopt_source_archive}" "${buildopt_source_url}"
if [[ "$(sha256sum "${buildopt_source_archive}" | awk '{print $1}')" != \
    "${buildopt_source_sha}" ]]; then
    printf 'Spring source archive checksum mismatch\n' >&2
    exit 1
fi
tar -xzf "${buildopt_source_archive}" --strip-components=1 \
    -C "${buildopt_root}/source"

buildopt_verify_source() {
    local buildopt_checkout=$1
    local buildopt_path=$2
    local buildopt_expected=$3
    if [[ "$(sha256sum "${buildopt_checkout}/${buildopt_path}" | awk '{print $1}')" != \
        "${buildopt_expected}" ]]; then
        printf 'Spring input checksum mismatch: %s\n' "${buildopt_path}" >&2
        return 1
    fi
}

buildopt_verify_source "${buildopt_root}/source" gradle/wrapper/gradle-wrapper.jar \
    "$(jq -er '.repository.wrapperJarSha256' "${buildopt_spec}")"
buildopt_verify_source "${buildopt_root}/source" gradle/wrapper/gradle-wrapper.properties \
    "$(jq -er '.repository.wrapperPropertiesSha256' "${buildopt_spec}")"
buildopt_verify_source "${buildopt_root}/source" settings.gradle \
    "$(jq -er '.repository.settingsSha256' "${buildopt_spec}")"
buildopt_verify_source "${buildopt_root}/source" gradle.properties \
    "$(jq -er '.repository.gradlePropertiesSha256' "${buildopt_spec}")"
buildopt_change_path=$(jq -er '.change.path' "${buildopt_spec}")
buildopt_change_sha=$(jq -er '.change.originalSha256' "${buildopt_spec}")
buildopt_verify_source "${buildopt_root}/source" "${buildopt_change_path}" \
    "${buildopt_change_sha}"

buildopt_preflight_log="${buildopt_root}/logs/preflight.log"
buildopt_preflight_started=$(date +%s%N)
if ! (
    cd "${buildopt_root}/source"
    env GRADLE_USER_HOME="${buildopt_root}/preflight-home" \
        "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
        ./gradlew --daemon --build-cache --parallel --no-configuration-cache \
        --max-workers=12 --no-scan --stacktrace check
) >"${buildopt_preflight_log}" 2>&1; then
    tail -n 160 "${buildopt_preflight_log}" >&2
    printf 'Spring online preflight failed; no paired sample was accepted\n' >&2
    exit 1
fi
buildopt_preflight_finished=$(date +%s%N)
grep -Fq 'BUILD SUCCESSFUL' "${buildopt_preflight_log}" || {
    printf 'Spring preflight lacks the success marker\n' >&2
    exit 1
}
buildopt_stop_gradle "${buildopt_root}/source" \
    "${buildopt_root}/preflight-home"

buildopt_cache_seed="${buildopt_root}/build-cache-seed.tar.gz"
tar -C "${buildopt_root}/preflight-home/caches" -czf "${buildopt_cache_seed}" \
    build-cache-1
buildopt_cache_seed_sha=$(sha256sum "${buildopt_cache_seed}" | awk '{print $1}')

for buildopt_arm in control candidate; do
    mkdir -p -- "${buildopt_root}/${buildopt_arm}/checkout" \
        "${buildopt_root}/${buildopt_arm}/gradle-home"
    tar -xzf "${buildopt_source_archive}" --strip-components=1 \
        -C "${buildopt_root}/${buildopt_arm}/checkout"
    cp -a -- "${buildopt_root}/preflight-home/." \
        "${buildopt_root}/${buildopt_arm}/gradle-home/"
    rm -rf -- "${buildopt_root}/${buildopt_arm}/gradle-home/daemon" \
        "${buildopt_root}/${buildopt_arm}/gradle-home/.tmp"
    cp -- "${buildopt_root}/${buildopt_arm}/checkout/${buildopt_change_path}" \
        "${buildopt_root}/${buildopt_arm}/changed-source.original"
done

buildopt_control_checkout="${buildopt_root}/control/checkout"
buildopt_candidate_checkout="${buildopt_root}/candidate/checkout"
buildopt_control_home="${buildopt_root}/control/gradle-home"
buildopt_candidate_home="${buildopt_root}/candidate/gradle-home"

buildopt_reset_arm() {
    local buildopt_arm=$1
    local buildopt_checkout=$2
    local buildopt_home=$3
    cp -- "${buildopt_root}/${buildopt_arm}/changed-source.original" \
        "${buildopt_checkout}/${buildopt_change_path}"
    (
        cd "${buildopt_checkout}"
        env GRADLE_USER_HOME="${buildopt_home}" \
            "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
            ./gradlew --daemon --offline --quiet --max-workers=12 clean
    ) >"${buildopt_root}/logs/reset-${buildopt_arm}.log" 2>&1
    rm -rf -- "${buildopt_home}/caches/build-cache-1"
    tar -C "${buildopt_home}/caches" -xzf "${buildopt_cache_seed}"
    printf '\n// buildopt-poc-paired-mutation\n' \
        >>"${buildopt_checkout}/${buildopt_change_path}"
}

buildopt_output_manifest() {
    local buildopt_checkout=$1
    local buildopt_manifest=$2
    local buildopt_file
    : >"${buildopt_manifest}"
    while IFS= read -r -d '' buildopt_file; do
        printf '%s  %s\n' "$(sha256sum "${buildopt_file}" | awk '{print $1}')" \
            "${buildopt_file#"${buildopt_checkout}/"}" >>"${buildopt_manifest}"
    done < <(find "${buildopt_checkout}" -type f \
        \( -path '*/build/classes/*' -o -path '*/build/resources/*' \
        -o -path '*/build/libs/*.jar' \) -print0 | sort -z)
    [[ -s "${buildopt_manifest}" ]] || {
        printf 'Spring required-output manifest is empty\n' >&2
        return 1
    }
}

buildopt_test_evidence() {
    local buildopt_checkout=$1
    local buildopt_evidence=$2
    mapfile -d '' buildopt_xml_files < <(find "${buildopt_checkout}" -type f \
        -path '*/build/test-results/*/TEST-*.xml' -print0 | sort -z)
    : >"${buildopt_evidence}"
    awk -v root="${buildopt_checkout}/" '
        function attr(line, key, marker, rest, ending) {
            marker = key "=\""
            rest = substr(line, index(line, marker) + length(marker))
            ending = index(rest, "\"")
            return substr(rest, 1, ending - 1)
        }
        FNR == 1 {
            relative = FILENAME
            sub("^" root, "", relative)
            project = relative
            sub("/build/test-results/.*$", "", project)
            task = relative
            sub("^.*?/build/test-results/", "", task)
            sub("/.*$", "", task)
            gsub("/", ":", project)
            task_path = ":" project ":" task
        }
        /<testcase / {
            class_name = attr($0, "classname")
            test_name = attr($0, "name")
            outcome = "PASSED"
            in_case = 1
            if ($0 ~ /<skipped/) outcome = "SKIPPED"
            if ($0 ~ /<failure/) outcome = "FAILED"
            if ($0 ~ /<error/) outcome = "ERROR"
            if ($0 ~ /\/>/) {
                print task_path "\t" class_name "\t" test_name "\t" outcome
                in_case = 0
            }
            next
        }
        in_case && /<skipped/ { outcome = "SKIPPED" }
        in_case && /<failure/ { outcome = "FAILED" }
        in_case && /<error/ { outcome = "ERROR" }
        in_case && /<\/testcase>/ {
            print task_path "\t" class_name "\t" test_name "\t" outcome
            in_case = 0
        }
    ' "${buildopt_xml_files[@]}" | sort >"${buildopt_evidence}"
    [[ -s "${buildopt_evidence}" ]] || {
        printf 'Spring test evidence is empty\n' >&2
        return 1
    }
}

buildopt_duration_ms=0
buildopt_started_ns=0
buildopt_finished_ns=0
buildopt_max_rss_kb=0
buildopt_run_arm() {
    local buildopt_arm=$1
    local buildopt_checkout=$2
    local buildopt_home=$3
    local buildopt_log=$4
    local buildopt_time=$5
    local -a buildopt_command=()
    local -a buildopt_environment=(env GRADLE_USER_HOME="${buildopt_home}")

    if [[ "${buildopt_arm}" == control ]]; then
        buildopt_command=("${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
            ./gradlew)
    else
        buildopt_environment+=(
            BUILDOPT_RUNTIME_CHECKSTYLE_MAX_HEAP=2g
            BUILDOPT_RUNNER_AVAILABLE_MEMORY_BYTES=16659865600
        )
        buildopt_command=("${buildopt_script_dir}/run" --toolchain temurin-jdk-25 --
            "${buildopt_root}/install/bin/buildopt" gradle)
    fi
    buildopt_command+=(--daemon --offline --build-cache --parallel \
        --no-configuration-cache --console=plain --max-workers=12 --no-scan \
        --stacktrace check)

    buildopt_started_ns=$(date +%s%N)
    if ! (
        cd "${buildopt_checkout}"
        /usr/bin/time -f 'maxRssKb=%M' -o "${buildopt_time}" \
            "${buildopt_environment[@]}" "${buildopt_command[@]}"
    ) >"${buildopt_log}" 2>&1; then
        tail -n 200 "${buildopt_log}" >&2
        printf 'Spring accepted %s arm failed; the pair is retained as failed\n' \
            "${buildopt_arm}" >&2
        return 1
    fi
    buildopt_finished_ns=$(date +%s%N)
    buildopt_duration_ms=$(((buildopt_finished_ns - buildopt_started_ns) / 1000000))
    buildopt_max_rss_kb=$(awk -F= '$1 == "maxRssKb" {print $2}' "${buildopt_time}")
    grep -Fq 'BUILD SUCCESSFUL' "${buildopt_log}" || {
        printf 'Spring %s arm lacks the success marker\n' "${buildopt_arm}" >&2
        return 1
    }
    if ! grep -Eq '^> Task :checkstyleNohttp$' "${buildopt_log}"; then
        printf 'Spring %s arm did not execute checkstyleNohttp\n' "${buildopt_arm}" >&2
        grep -n 'checkstyleNohttp' "${buildopt_log}" >&2 || true
        return 1
    fi
    if grep -Eq '^> Task :checkstyleNohttp (FROM-CACHE|UP-TO-DATE|SKIPPED|NO-SOURCE)' \
        "${buildopt_log}"; then
        printf 'Spring %s arm reused checkstyleNohttp instead of executing it\n' \
            "${buildopt_arm}" >&2
        return 1
    fi
    if grep -Eq '^> Task .*:(publish|upload|release|sign)([A-Z:]|$)' "${buildopt_log}" ||
        grep -Eq 'Publishing build scan|Build scan published|https://gradle[.]com/s/' \
            "${buildopt_log}"; then
        printf 'Spring %s arm attempted a forbidden external action\n' \
            "${buildopt_arm}" >&2
        return 1
    fi
    if [[ "${buildopt_arm}" == candidate ]] &&
        grep -Eiq 'BuildOpt.*(unavailable|authentication failed|handshake failed|broken pipe)' \
            "${buildopt_log}"; then
        printf 'Spring candidate observed a BuildOpt product warning\n' >&2
        return 1
    fi
}

buildopt_reset_arm control "${buildopt_control_checkout}" "${buildopt_control_home}"
buildopt_reset_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}"
buildopt_run_arm control "${buildopt_control_checkout}" "${buildopt_control_home}" \
    "${buildopt_root}/logs/warm-control.log" "${buildopt_root}/logs/warm-control.time"
buildopt_run_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}" \
    "${buildopt_root}/logs/warm-candidate.log" "${buildopt_root}/logs/warm-candidate.time"

buildopt_raw="${buildopt_root}/observations.jsonl"
: >"${buildopt_raw}"
for buildopt_pair in {1..8}; do
    buildopt_reset_arm control "${buildopt_control_checkout}" "${buildopt_control_home}"
    buildopt_reset_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}"

    buildopt_order=CANDIDATE_FIRST
    if ((buildopt_pair <= 4 && buildopt_pair % 2 == 1)) ||
        ((buildopt_pair > 4 && buildopt_pair % 2 == 0)); then
        buildopt_order=CONTROL_FIRST
    fi
    buildopt_control_log="${buildopt_root}/logs/pair-${buildopt_pair}-control.log"
    buildopt_candidate_log="${buildopt_root}/logs/pair-${buildopt_pair}-candidate.log"
    if [[ "${buildopt_order}" == CONTROL_FIRST ]]; then
        buildopt_run_arm control "${buildopt_control_checkout}" "${buildopt_control_home}" \
            "${buildopt_control_log}" "${buildopt_control_log}.time"
        buildopt_control_duration=${buildopt_duration_ms}
        buildopt_control_rss=${buildopt_max_rss_kb}
        buildopt_first_finished=${buildopt_finished_ns}
        buildopt_run_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}" \
            "${buildopt_candidate_log}" "${buildopt_candidate_log}.time"
        buildopt_candidate_duration=${buildopt_duration_ms}
        buildopt_candidate_rss=${buildopt_max_rss_kb}
        buildopt_gap_ms=$(((buildopt_started_ns - buildopt_first_finished) / 1000000))
    else
        buildopt_run_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}" \
            "${buildopt_candidate_log}" "${buildopt_candidate_log}.time"
        buildopt_candidate_duration=${buildopt_duration_ms}
        buildopt_candidate_rss=${buildopt_max_rss_kb}
        buildopt_first_finished=${buildopt_finished_ns}
        buildopt_run_arm control "${buildopt_control_checkout}" "${buildopt_control_home}" \
            "${buildopt_control_log}" "${buildopt_control_log}.time"
        buildopt_control_duration=${buildopt_duration_ms}
        buildopt_control_rss=${buildopt_max_rss_kb}
        buildopt_gap_ms=$(((buildopt_started_ns - buildopt_first_finished) / 1000000))
    fi
    if ((buildopt_gap_ms > 5000)); then
        printf 'Spring pair %s exceeded the inter-arm gap: %s ms\n' \
            "${buildopt_pair}" "${buildopt_gap_ms}" >&2
        exit 1
    fi

    buildopt_control_outputs="${buildopt_root}/control-${buildopt_pair}.outputs"
    buildopt_candidate_outputs="${buildopt_root}/candidate-${buildopt_pair}.outputs"
    buildopt_control_tests="${buildopt_root}/control-${buildopt_pair}.tests"
    buildopt_candidate_tests="${buildopt_root}/candidate-${buildopt_pair}.tests"
    buildopt_output_manifest "${buildopt_control_checkout}" "${buildopt_control_outputs}"
    buildopt_output_manifest "${buildopt_candidate_checkout}" "${buildopt_candidate_outputs}"
    buildopt_test_evidence "${buildopt_control_checkout}" "${buildopt_control_tests}"
    buildopt_test_evidence "${buildopt_candidate_checkout}" "${buildopt_candidate_tests}"
    cmp -s "${buildopt_control_outputs}" "${buildopt_candidate_outputs}" || {
        printf 'Spring required outputs differ in pair %s\n' "${buildopt_pair}" >&2
        exit 1
    }
    cmp -s "${buildopt_control_tests}" "${buildopt_candidate_tests}" || {
        printf 'Spring requested test evidence differs in pair %s\n' \
            "${buildopt_pair}" >&2
        exit 1
    }
    buildopt_test_failures=$(awk -F '\t' \
        '$4 == "FAILED" || $4 == "ERROR" {count++} END {print count + 0}' \
        "${buildopt_control_tests}")
    ((buildopt_test_failures == 0)) || {
        printf 'Spring pair %s contains failed tests\n' "${buildopt_pair}" >&2
        exit 1
    }

    jq -cn \
        --argjson pair "${buildopt_pair}" --arg order "${buildopt_order}" \
        --argjson control "${buildopt_control_duration}" \
        --argjson candidate "${buildopt_candidate_duration}" \
        --argjson gap "${buildopt_gap_ms}" \
        --argjson controlRss "${buildopt_control_rss}" \
        --argjson candidateRss "${buildopt_candidate_rss}" \
        --arg outputSha "$(sha256sum "${buildopt_control_outputs}" | awk '{print $1}')" \
        --argjson outputCount "$(wc -l <"${buildopt_control_outputs}")" \
        --arg testSha "$(sha256sum "${buildopt_control_tests}" | awk '{print $1}')" \
        --argjson testCount "$(wc -l <"${buildopt_control_tests}")" '
        {
            pair: $pair,
            order: $order,
            controlDurationMs: $control,
            candidateDurationMs: $candidate,
            savedMs: ($control - $candidate),
            interArmIdleGapMs: $gap,
            controlMaximumResidentSetKb: $controlRss,
            candidateMaximumResidentSetKb: $candidateRss,
            controlOutputSha256: $outputSha,
            candidateOutputSha256: $outputSha,
            outputFileCount: $outputCount,
            controlTestEvidenceSha256: $testSha,
            candidateTestEvidenceSha256: $testSha,
            testCaseCount: $testCount,
            failedTestCaseCount: 0,
            controlCheckstyleNohttpExecuted: true,
            candidateCheckstyleNohttpExecuted: true,
            productAttributableFailure: false
        }' >>"${buildopt_raw}"
    printf 'Spring pair %s/%s: control=%sms candidate=%sms saved=%sms order=%s\n' \
        "${buildopt_pair}" 8 "${buildopt_control_duration}" \
        "${buildopt_candidate_duration}" \
        "$((buildopt_control_duration - buildopt_candidate_duration))" \
        "${buildopt_order}"
done

jq -s '.' "${buildopt_raw}" >"${buildopt_root}/observations.json"
buildopt_captured_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
jq -n \
    --arg capturedAt "${buildopt_captured_at}" \
    --arg specSha "${buildopt_spec_sha}" \
    --arg revision "${buildopt_revision}" \
    --arg executableSha "${buildopt_executable_sha}" \
    --arg pluginSha "${buildopt_plugin_sha}" \
    --arg sourceSha "${buildopt_source_sha}" \
    --arg cacheSeedSha "${buildopt_cache_seed_sha}" \
    --argjson preflightMs \
        "$(((buildopt_preflight_finished - buildopt_preflight_started) / 1000000))" \
    --slurpfile spec "${buildopt_spec}" \
    --slurpfile rows "${buildopt_root}/observations.json" '
    def bootstrap_mean($data; $sample):
        reduce range(0; 8) as $draw
            ({state: ((2654435761 * ($sample + 1)) % 4294967296), sum: 0};
             .state = ((1664525 * .state + 1013904223) % 4294967296) |
             .sum += $data[((.state / 536870912) | floor)].savedMs) |
        .sum / 8;
    def bootstrap95($data):
        ([range(0; 4096) as $sample | bootstrap_mean($data; $sample)] | sort) as $r |
        [$r[102], $r[3993]];
    $rows[0] as $data |
    (($data | map(.controlDurationMs) | add) / 8) as $controlMean |
    (($data | map(.candidateDurationMs) | add) / 8) as $candidateMean |
    (($data | map(.savedMs) | add) / 8) as $mean |
    (($data | map(.savedMs) | add) / ($data | map(.controlDurationMs) | add)) as $ratio |
    bootstrap95($data) as $interval |
    ($data | map(select(.savedMs > 0)) | length) as $positive |
    ($mean >= $spec[0].valueGate.minimumSavedMs and
     $ratio >= $spec[0].valueGate.minimumReductionRatio and
     $interval[0] > 0 and
     all($data[];
        .controlOutputSha256 == .candidateOutputSha256 and
        .controlTestEvidenceSha256 == .candidateTestEvidenceSha256 and
        .testCaseCount > 40000 and .failedTestCaseCount == 0 and
        .controlCheckstyleNohttpExecuted and
        .candidateCheckstyleNohttpExecuted and
        (.productAttributableFailure | not))) as $qualified |
    {
        schemaVersion: "buildopt.evidence/poc-spring-value/v1",
        workItem: "POC-SPRING-VALUE-001",
        capturedAt: $capturedAt,
        specSha256: $specSha,
        buildopt: {
            revision: $revision,
            executableSha256: $executableSha,
            gradlePluginSha256: $pluginSha
        },
        repository: {
            nameWithOwner: $spec[0].repository.nameWithOwner,
            revision: $spec[0].repository.revision,
            sourceArchiveSha256: $sourceSha
        },
        runner: {
            id: $spec[0].primaryRunner.id,
            cpuCount: 12,
            memoryBytes: 16659865600,
            maxWorkers: 12,
            java: $spec[0].repository.java,
            configurationCacheEnabled: false
        },
        preparation: {
            onlinePreflightMeasured: false,
            onlinePreflightSuccess: true,
            onlinePreflightWallClockMs: $preflightMs,
            measuredNetwork: "DISCONNECTED",
            dependencyMode: "GRADLE_OFFLINE",
            buildCacheSeedSha256: $cacheSeedSha,
            preflightDaemonStoppedBeforeArmSetup: true,
            cacheSeedRestoredBeforeEveryArm: true,
            outputsRemovedBeforeEveryArm: true,
            fixedMutationAppliedAfterCacheRestore: true
        },
        hypothesis: $spec[0].runtimeTuningHypothesis,
        observations: $data,
        result: {
            pairs: 8,
            controlMeanMs: $controlMean,
            candidateMeanMs: $candidateMean,
            meanSavedMs: $mean,
            meanReductionRatio: $ratio,
            interval95SavedMs: $interval,
            positivePairs: $positive,
            requiredOutputsIdentical: true,
            requestedTestsIdentical: true,
            productAttributableFailures: 0
        },
        decision: {
            verdict: (if $qualified then "QUALIFY_SPRING_RUNTIME_TUNING" else "STOP_SPRING_RUNTIME_TUNING" end),
            performanceMeasured: true,
            savingsClaimed: $qualified
        },
        gate: {
            id: "POC-SPRING-VALUE-G01",
            state: (if $qualified then "PASSED" else "FAILED" end)
        },
        boundaries: $spec[0].boundaries
    }' >"${buildopt_root}/result.json"

install -m 0600 "${buildopt_root}/result.json" "${buildopt_output}"
"${buildopt_script_dir}/check-poc-spring-value" "${buildopt_output}"
