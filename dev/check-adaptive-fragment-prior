#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_evidence="${buildopt_repo_root}/benchmarks/results/adaptive-fragment-prior-v1.json"
buildopt_policy="${buildopt_repo_root}/specs/poc-adaptive-fragment-prior-v1.json"
buildopt_temp_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-af007.XXXXXX")
trap 'rm -r -- "${buildopt_temp_root}"' EXIT

for buildopt_command in grep jq mktemp; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'adaptive fragment prior check requires %s\n' "${buildopt_command}" >&2
        exit 1
    }
done

jq -e '
    .schemaVersion == "buildopt.specs/poc-adaptive-fragment-prior/v1" and
    .workItem == "AF-007" and
    .features.repositoryIdentityAllowed == false and
    .features.taskImplementationSha256Weight == 35 and
    .features.pluginVersionSha256Weight == 25 and
    .features.gradleMajorWeight == 10 and
    .features.taskClassWeight == 10 and
    .features.graphShapeWeight == 10 and
    .features.outputShapeWeight == 10 and
    .features.taskOrPluginExactMatchRequired == true and
    .sourceEvidence.minimumIndependentRepositories == 2 and
    .sourceEvidence.exactOutputsRequired == true and
    .sourceEvidence.localCorrectnessRequired == true and
    .sourceEvidence.productAttributableFailureAllowed == false and
    .targetAuthority.explorationPriorityMayChange == true and
    .targetAuthority.correctnessMayTransfer == false and
    .targetAuthority.valueMayTransfer == false and
    .targetAuthority.activationMayTransfer == false and
    .gate.sourceRepositories == 4 and
    .gate.sourceObservations == 6 and
    .gate.holdoutRepositories == 2 and
    .gate.rankedHypotheses == 3 and
    .gate.repositoryRenameComparisons == 3 and
    .gate.priorityChanges == 1 and
    .gate.noMatchCandidates == 0 and
    .gate.rejectedUnsafeInputs == 6 and
    .gate.activationAuthorizations == 0 and
    .outcome == "SAFE_HYPOTHESIS_PRIORS_AVAILABLE" and
    .boundaries.syntheticRankingVectors == true and
    .boundaries.syntheticTimingClaim == false and
    .boundaries.gradleExecutions == 0 and
    .boundaries.productionAuthorized == false and
    .boundaries.testOptimization == "OUT_OF_SCOPE"
' "${buildopt_policy}" >/dev/null

cd -- "${buildopt_repo_root}"
"${buildopt_script_dir}/run" --toolchain go -- \
    go test -count=1 ./internal/adaptivefragment ./dev/adaptive-fragment-prior
"${buildopt_script_dir}/run" --toolchain go -- \
    go vet ./internal/adaptivefragment ./dev/adaptive-fragment-prior
buildopt_direct_imports=$("${buildopt_script_dir}/run" --toolchain go -- \
    go list -f '{{range .Imports}}{{println .}}{{end}}' \
    ./internal/adaptivefragment ./dev/adaptive-fragment-prior)
if grep -Eq '^(net|net/.*|os/exec)$' <<<"${buildopt_direct_imports}"; then
    echo "adaptive fragment prior imports process or network execution" >&2
    exit 1
fi

"${buildopt_script_dir}/run" --toolchain go -- \
    go run ./dev/adaptive-fragment-prior --validate "${buildopt_evidence}" >/dev/null
"${buildopt_script_dir}/run" --toolchain go -- \
    go run ./dev/adaptive-fragment-prior --output "${buildopt_temp_root}/live-report.json"
"${buildopt_script_dir}/run" --toolchain go -- \
    go run ./dev/adaptive-fragment-prior --validate "${buildopt_temp_root}/live-report.json" >/dev/null

jq '.holdouts[0].ranking.candidates[0].activationAuthorized = true' \
    "${buildopt_evidence}" >"${buildopt_temp_root}/tampered-report.json"
if "${buildopt_script_dir}/run" --toolchain go -- \
    go run ./dev/adaptive-fragment-prior --validate "${buildopt_temp_root}/tampered-report.json" >/dev/null 2>&1; then
    echo "adaptive fragment prior accepted transferred activation authority" >&2
    exit 1
fi

echo "adaptive fragment prior: SAFE_HYPOTHESIS_PRIORS_AVAILABLE"
