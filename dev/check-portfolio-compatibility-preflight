#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [evidence-directory]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_contract=${buildopt_repo_root}/specs/poc-portfolio-compatibility-preflight-v1.json
buildopt_evidence=${1:-${buildopt_repo_root}/benchmarks/results/poc-portfolio-compatibility-preflight-v1}
buildopt_summary=${buildopt_evidence}/summary.json

command -v jq >/dev/null 2>&1 || {
    printf 'portfolio compatibility preflight validation requires jq\n' >&2
    exit 1
}

jq -e '
  .schemaVersion == "buildopt.specs/poc-portfolio-compatibility-preflight/v1" and
  .workItem == "POC-PORTFOLIO-COMPATIBILITY-PREFLIGHT-001" and
  .preflight.position ==
    "AFTER_ORDINARY_OPTIMIZED_NATIVE_BEFORE_INDEPENDENT_NATIVE_OBSERVATION" and
  .preflight.bindings == ["REPOSITORY_SCOPE_SHA256","WORKFLOW_SHA256",
    "GRADLE_WRAPPER_SHA256","OUTPUT_CONTRACT_SHA256"] and
  .preflight.compatibleDecision == "COMPATIBLE" and
  .preflight.driftDecision == "NATIVE_RETAINED" and
  .preflight.driftStartsIndependentNativeObservation == false and
  .preflight.compatibleAuthorizesTransport == false and
  .preflight.compatibleAuthorizesProduction == false and
  .rejectionFixture.expectedIndependentNativeObservations == 0 and
  .nextExperiment.evaluationIsDirectChild == true and
  .nextExperiment.wrapperTreeSha256 ==
    "1d1bca219166747b5f7ecbe36d877e3972dfc2047dd6e6ef041867a6f789552c" and
  .nextExperiment.evaluationChangedPaths == ["gradle/libs.versions.toml"] and
  .nextExperiment.outputContractCompatibility == "MUST_BE_OBSERVED_BY_PREFLIGHT" and
  .nextExperiment.timingAuthorizedBeforeCompatiblePreflight == false and
  .boundaries.proofOfConcept == true and
  .boundaries.productionAuthorized == false and
  .boundaries.repositorySpecificProductRules == false and
  .boundaries.soakRequired == false and
  .boundaries.designPartnerRequired == false and
  .boundaries.testOptimization == "OUT_OF_SCOPE"
' "${buildopt_contract}" >/dev/null || {
    printf 'portfolio compatibility preflight contract drifted\n' >&2
    exit 1
}

[[ -s ${buildopt_summary} ]] || {
    printf 'portfolio compatibility preflight evidence is unavailable\n' >&2
    exit 1
}
jq -e --slurpfile contract "${buildopt_contract}" '
  .schemaVersion == "buildopt.evidence/poc-portfolio-compatibility-preflight/v1" and
  .workItem == "POC-PORTFOLIO-COMPATIBILITY-PREFLIGHT-001" and
  .rejection.repositoryId == "micronaut-projects/micronaut-core" and
  .rejection.ordinaryInvocations == 1 and
  .rejection.measurementOnlyWorkflowRuns == 0 and
  .rejection.decision == "NATIVE_RETAINED" and
  .rejection.reason == "PORTFOLIO_CONTEXT_DRIFT" and
  .rejection.driftedBindings ==
    ["GRADLE_WRAPPER_SHA256","OUTPUT_CONTRACT_SHA256"] and
  .rejection.independentNativeObservationAuthorized == false and
  .rejection.independentNativeObservationStarted == false and
  .rejection.independentNativeObservations == 0 and
  .rejection.avoidedIndependentNativeObservations == 1 and
  .rejection.timingPairsMeasured == 0 and
  .rejection.performanceClaimed == false and
  .rejection.productFailures == 0 and
  .nextExperiment == $contract[0].nextExperiment and
  .acceptance.decision == "PREFLIGHT_PROVEN_NEXT_WINDOW_PREREGISTERED" and
  .acceptance.incompatibleWorkAvoided == true and
  .acceptance.compatibleReplayValueProven == false and
  .acceptance.exactOutputGatePreserved == true and
  (.sourceEvidenceSha256 | all(test("^[0-9a-f]{64}$"))) and
  .boundaries == $contract[0].boundaries
' "${buildopt_summary}" >/dev/null || {
    printf 'portfolio compatibility preflight evidence drifted\n' >&2
    exit 1
}

cd -- "${buildopt_repo_root}"
"${buildopt_script_dir}/run" --toolchain go -- \
    go test -count=1 ./internal/nativevolatility
"${buildopt_script_dir}/run" --toolchain go -- \
    go test -count=1 ./internal/launcher \
    -run 'Test(ApplyOptimizeNativeQuarantineFiltersPackAndResetsCalibration|DiagnosticNativeObservationWorksWithoutMaterialization)$'

printf 'Portfolio compatibility preflight contract and implementation: PASS\n'
