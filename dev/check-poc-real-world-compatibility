#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [--spec-only|RESULT_JSON]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-real-world-compatibility-v1.json"
buildopt_runner_spec="${buildopt_repo_root}/specs/golden-lane-runner-v1.json"
buildopt_result=${1:-"${buildopt_repo_root}/benchmarks/results/poc-real-world-compatibility-v1.json"}

for buildopt_command in git jq sha256sum; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required POC-REALWORLD-001 command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
for buildopt_file in "${buildopt_spec}" "${buildopt_runner_spec}"; do
    [[ -f "${buildopt_file}" ]] || {
        printf 'required POC-REALWORLD-001 file is unavailable: %s\n' \
            "${buildopt_file}" >&2
        exit 1
    }
done

jq -e '
    def digest: type == "string" and test("^[0-9a-f]{64}$");
    def revision: type == "string" and test("^[0-9a-f]{40}$");
    def repository($value; $id; $owner; $ref; $revision; $dsl; $gradle; $task):
        $value.id == $id and $value.nameWithOwner == $owner and $value.ref == $ref and
        $value.revision == $revision and ($value.revision | revision) and $value.dsl == $dsl and
        $value.gradleVersion == $gradle and $value.url == ("https://github.com/" + $owner + ".git") and
        ($value.wrapper.jarSha256 | digest) and ($value.wrapper.propertiesSha256 | digest) and
        ($value.wrapper.settingsSha256 | digest) and
        $value.wrapper.distributionUrl ==
            ("https://services.gradle.org/distributions/gradle-" + $gradle + "-bin.zip") and
        ($value.wrapper.distributionSha256 | digest) and
        ($value.target.arguments | type == "array" and index("--no-scan") != null and
            index("--no-daemon") != null and index($task) != null) and
        ($value.target.outputRoots | type == "array" and length >= 1) and
        ($value.excludedEnvironment | type == "array" and index("CI") != null);
    keys == ["boundaries", "decision", "guardrails", "methodology", "repositories", "runner", "schemaVersion", "workItem"] and
    .schemaVersion == "buildopt.specs/poc-real-world-compatibility/v1" and
    .workItem == "POC-REALWORLD-001" and
    .decision == "AUTHORIZE_OR_REJECT_REAL_WORLD_PERFORMANCE_MATRIX" and
    .runner == "linux-amd64-4c-16g-v1" and
    (.repositories | type == "array" and length == 3) and
    ([.repositories[].id] | sort) == ["MOCKITO", "SPOTBUGS", "SPOTLESS"] and
    repository((.repositories[] | select(.id == "SPOTLESS"));
        "SPOTLESS"; "diffplug/spotless"; "gradle/8.9.0";
        "cbd01c4e4b91cea538691d4fe6a8f929d75c27c6"; "GROOVY"; "9.4.1";
        ":plugin-gradle:testClasses") and
    repository((.repositories[] | select(.id == "MOCKITO"));
        "MOCKITO"; "mockito/mockito"; "v5.23.0";
        "a231205b240e7884a63bf0f63440012867a4da21"; "KOTLIN"; "8.14.2";
        ":mockito-extensions:mockito-junit-jupiter:testClasses") and
    repository((.repositories[] | select(.id == "SPOTBUGS"));
        "SPOTBUGS"; "spotbugs/spotbugs"; "4.10.3";
        "8d5cad4536ae263448c09181268bbca70f0c0712";
        "MIXED_KOTLIN_SETTINGS_GROOVY_PROJECTS"; "9.6.1";
        ":spotbugs-tests:testClasses") and
    (.repositories[] | select(.id == "MOCKITO") | .excludedEnvironment | index("ANDROID_HOME") != null) and
    (.repositories[] | select(.id == "SPOTLESS") | .excludedEnvironment |
        index("buildcacheuser") != null and index("buildcachepass") != null) and
    (.repositories[] | select(.id == "SPOTBUGS") |
        .wrapper.checksumInjectionRequired == true) and
    (.repositories[] | select(.id != "SPOTBUGS") |
        .wrapper.checksumInjectionRequired == false) and
    .methodology == {
        purpose: "CONFIRM_PINNED_PUBLIC_REPOSITORY_COMPATIBILITY",
        arms: ["OPTIMIZED_NATIVE_GRADLE", "INSTALLED_BUILDOPT"],
        performanceMeasured: false,
        networkPolicy: "PUBLIC_SOURCE_AND_DEPENDENCY_RESOLUTION_ONLY",
        sourcePolicy: "PINNED_REVISION_DISPOSABLE_CHECKOUT",
        environmentPolicy: "EMPTY_HOME_NO_HOST_CREDENTIALS_EXCLUDED_VARIABLES_ABSENT",
        candidateEntryPoint: "buildopt gradle",
        requiredOutputDigest: "SORTED_RELATIVE_PATH_AND_SHA256"
    } and
    .guardrails == {
        requiredRepositories: 3,
        exactRevisionRequired: true,
        wrapperAndSettingsHashesRequired: true,
        distributionChecksumRequired: true,
        buildScanDisabled: true,
        publishingTasksForbidden: true,
        requiredOutputsNonEmpty: true,
        requiredOutputsIdentical: true,
        maximumProductAttributableFailures: 0
    } and
    .boundaries == {
        publicSourceOnly: true,
        performanceClaimAuthorized: false,
        productionReadinessClaimed: false,
        eightHourSoakExecuted: false,
        externalDesignPartnerRequired: false,
        testOptimizationModified: false
    }
    ' "${buildopt_spec}" >/dev/null

if [[ "${buildopt_result}" == --spec-only ]]; then
    printf 'BuildOpt POC-REALWORLD-001 specification OK: %s\n' "${buildopt_spec}"
    exit 0
fi

[[ -f "${buildopt_result}" ]] || {
    printf 'POC-REALWORLD-001 evidence is unavailable: %s\n' \
        "${buildopt_result}" >&2
    exit 1
}

buildopt_before_status=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_runner_spec_sha=$(sha256sum "${buildopt_runner_spec}" | awk '{print $1}')
buildopt_image=$(jq -er '.container.reference' "${buildopt_runner_spec}")
buildopt_platform_digest=$(jq -er '.container.platformDigest' "${buildopt_runner_spec}")

jq -e \
    --arg specSha256 "${buildopt_spec_sha}" \
    --arg runnerSpecSha256 "${buildopt_runner_spec_sha}" \
    --arg image "${buildopt_image}" \
    --arg platformDigest "${buildopt_platform_digest}" \
    --slurpfile contract "${buildopt_spec}" '
    def digest: type == "string" and test("^[0-9a-f]{64}$");
    def revision: type == "string" and test("^[0-9a-f]{40}$");
    def arm:
        keys == ["actionableTasks", "outputFileCount", "outputSha256", "success"] and
        .success == true and (.actionableTasks | type == "number" and . >= 1) and
        (.outputFileCount | type == "number" and . >= 1) and (.outputSha256 | digest);
    def repository($observed; $expected):
        ($observed | keys) == ["candidate", "classification", "id", "nameWithOwner", "native", "productAttributableFailures", "revision", "sourceArchiveSha256", "wrapper"] and
        $observed.id == $expected.id and
        $observed.nameWithOwner == $expected.nameWithOwner and
        $observed.revision == $expected.revision and ($observed.revision | revision) and
        ($observed.sourceArchiveSha256 | digest) and
        $observed.wrapper == $expected.wrapper and
        ($observed.native | arm) and ($observed.candidate | arm) and
        $observed.native.outputFileCount == $observed.candidate.outputFileCount and
        $observed.native.outputSha256 == $observed.candidate.outputSha256 and
        $observed.productAttributableFailures == 0 and
        $observed.classification == "COMPATIBLE_FOR_PERFORMANCE_MATRIX";
    keys == ["boundaries", "buildopt", "capturedAt", "decision", "gate", "methodology", "repositories", "runner", "schemaVersion", "specSha256"] and
    .schemaVersion == "buildopt.evidence/poc-real-world-compatibility/v1" and
    (.capturedAt | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
    .specSha256 == $specSha256 and
    (.buildopt.revision | revision) and (.buildopt.executableSha256 | digest) and
    (.buildopt.gradlePluginSha256 | digest) and
    .runner == {
        id: "linux-amd64-4c-16g-v1",
        image: $image,
        platformDigest: $platformDigest,
        runnerSpecSha256: $runnerSpecSha256,
        cpuCount: 4,
        memoryBytes: 17179869184
    } and
    .methodology == $contract[0].methodology and
    (.repositories | type == "array" and length == 3) and
    ([.repositories[].id] | sort) == ["MOCKITO", "SPOTBUGS", "SPOTLESS"] and
    repository((.repositories[] | select(.id == "SPOTLESS"));
        ($contract[0].repositories[] | select(.id == "SPOTLESS"))) and
    repository((.repositories[] | select(.id == "MOCKITO"));
        ($contract[0].repositories[] | select(.id == "MOCKITO"))) and
    repository((.repositories[] | select(.id == "SPOTBUGS"));
        ($contract[0].repositories[] | select(.id == "SPOTBUGS"))) and
    .decision == {
        verdict: "AUTHORIZE_POC_REALWORLD_002",
        compatibleRepositories: 3,
        requiredRepositories: 3,
        performanceMeasured: false
    } and
    .gate == {id: "POC-REALWORLD-G01", state: "PASSED"} and
    .boundaries == $contract[0].boundaries
    ' "${buildopt_result}" >/dev/null

buildopt_revision=$(jq -er '.buildopt.revision' "${buildopt_result}")
if git -C "${buildopt_repo_root}" cat-file -e "${buildopt_revision}^{commit}" 2>/dev/null; then
    git -C "${buildopt_repo_root}" merge-base --is-ancestor "${buildopt_revision}" HEAD
fi

buildopt_after_status=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
if [[ "${buildopt_before_status}" != "${buildopt_after_status}" ]]; then
    printf 'POC-REALWORLD-001 validation changed the working tree\n' >&2
    exit 1
fi

printf 'BuildOpt POC-REALWORLD-001 evidence OK: %s\n' "${buildopt_result}"
