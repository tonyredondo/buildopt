#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [RESULT_FILE]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-optimization-overhead-ablation-v1.json"
buildopt_result=${1:-"${buildopt_repo_root}/benchmarks/results/poc-optimization-overhead-ablation-v1.json"}

jq -e '
    .schemaVersion == "buildopt.specs/poc-optimization-overhead-ablation/v1" and
    .workItem == "POC-OPTIMIZATION-OVERHEAD-ABLATION-001" and
    .decision == "PREREGISTER_NATIVE_INIT_ONLY_AND_EXACT_JAR_ARMS" and
    .protocolRevisions == [{
        from: 0,
        reason: "PRE_MEASUREMENT_THREE_ARM_CLEANUP_EXCEEDED_TWO_ARM_IDLE_BUDGET",
        acceptedRoundsBeforeRevision: 0,
        valueThresholdsChanged: false
    }] and
    .repository.nameWithOwner == "spring-projects/spring-framework" and
    (.repository.revision | test("^[0-9a-f]{40}$")) and
    (.repository.sourceArchiveSha256 | test("^[0-9a-f]{64}$")) and
    .runner.cpuCount == 12 and .runner.maxWorkers == 12 and .runner.jdk == "25" and
    .workflow.entrypoint == ":spring-jms:test" and
    .workflow.expectedTests == 8 and
    .workflow.arms == [
        "OPTIMIZED_NATIVE_GRADLE",
        "NATIVE_PLUS_BUILDOPT_INIT_CLASSPATH_ONLY",
        "NATIVE_PLUS_EXACT_STANDARD_JAR_REUSE"
    ] and
    .measurement.warmupsPerArm == 1 and .measurement.rounds == 4 and
    .measurement.roundOrders == [
        ["CONTROL", "INIT_ONLY", "ADAPTER"],
        ["INIT_ONLY", "ADAPTER", "CONTROL"],
        ["ADAPTER", "CONTROL", "INIT_ONLY"],
        ["CONTROL", "ADAPTER", "INIT_ONLY"]
    ] and
    .measurement.maximumInterArmIdleGapMs == 10000 and
    .measurement.adapterMustRestoreStandardJar == true and
    .measurement.otherArmsMustExecuteStandardJar == true and
    .valueGate.minimumSavedMs == 500 and
    .valueGate.minimumReductionRatio == 0.02 and
    .valueGate.positiveLower95Bound == true and
    .valueGate.minimumPositiveRounds == 4 and
    .valueGate.thresholdsMayMoveAfterMeasurement == false and
    .valueGate.failedRoundsMayBeDiscarded == false and
    .decisionPolicy.promoteOnlyWhenNetAdapterBeatsNativeGate == true and
    .decisionPolicy.registrationOptimizationCannotOverrideEndToEndFailure == true and
    .decisionPolicy.unqualifiedWorkflowRemainsNative == true and
    .boundaries.requestedTestsExecutedInEveryArm == true and
    .boundaries.testOptimizationModified == false and
    .boundaries.proofOfConcept == true and
    .boundaries.productionReadinessClaimed == false and
    .boundaries.soakRequired == false and
    .boundaries.designPartnerRequired == false
' "${buildopt_spec}" >/dev/null

if (($# == 0)) && [[ ! -s "${buildopt_result}" ]]; then
    printf 'POC optimization-overhead ablation contract OK: %s\n' "${buildopt_spec}"
    exit 0
fi

buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_runner_sha=$(sha256sum "${buildopt_script_dir}/run-poc-optimization-overhead-ablation" | awk '{print $1}')
jq -e --arg specSha "${buildopt_spec_sha}" --arg runnerSha "${buildopt_runner_sha}" \
    --slurpfile spec "${buildopt_spec}" '
    def sha256: type == "string" and test("^[0-9a-f]{64}$");
    def bootstrap_mean($data; $sample):
        reduce range(0; 4) as $draw
            ({state: ((2654435761 * ($sample + 1)) % 4294967296), sum: 0};
             .state = ((1664525 * .state + 1013904223) % 4294967296) |
             .sum += $data[((.state / 1073741824) | floor)].adapterSavedVsControlMs) |
        .sum / 4;
    def bootstrap95($data):
        ([range(0; 4096) as $sample | bootstrap_mean($data; $sample)] | sort) as $r |
        [$r[102], $r[3993]];
    .observations as $data |
    (($data | map(.controlDurationMs) | add) / 4) as $controlMean |
    (($data | map(.initOnlyDurationMs) | add) / 4) as $initMean |
    (($data | map(.adapterDurationMs) | add) / 4) as $adapterMean |
    ($controlMean - $adapterMean) as $saved |
    ($data | map(.controlDurationMs) | add) as $controlSum |
    ($data | map(.adapterDurationMs) | add) as $adapterSum |
    (($controlSum - $adapterSum) / $controlSum) as $ratio |
    bootstrap95($data) as $interval |
    ($data | map(select(.adapterSavedVsControlMs > 0)) | length) as $positive |
    ($saved >= $spec[0].valueGate.minimumSavedMs and
     $ratio >= $spec[0].valueGate.minimumReductionRatio and
     $interval[0] > 0 and $positive == $spec[0].valueGate.minimumPositiveRounds and
     all($data[]; .tests == 8 and .failures == 0 and .errors == 0 and .skipped == 0 and
         .adapterStandardJarFromCacheCount > 0 and
         .controlStandardJarExecutedCount > 0 and
         .initOnlyStandardJarExecutedCount > 0 and
         .requiredJarOutputCount > 0 and .requiredJarTotalBytes > 0 and
         .outputsIdentical and .testCasesIdentical and
         (.productAttributableFailure | not))) as $qualified |
    .schemaVersion == "buildopt.evidence/poc-optimization-overhead-ablation/v1" and
    .workItem == "POC-OPTIMIZATION-OVERHEAD-ABLATION-001" and
    (.capturedAt | fromdateiso8601) and
    (.buildopt.revision | test("^[0-9a-f]{40}$")) and
    (.buildopt.executableSha256 | sha256) and
    (.buildopt.pluginJarSha256 | sha256) and
    (.buildopt.initScriptSha256 | sha256) and
    .buildopt.runnerScriptSha256 == $runnerSha and
    .specSha256 == $specSha and
    .repository == {
        nameWithOwner: $spec[0].repository.nameWithOwner,
        revision: $spec[0].repository.revision,
        sourceArchiveSha256: $spec[0].repository.sourceArchiveSha256
    } and
    .runner == $spec[0].runner and
    .workflow == $spec[0].workflow and
    .preparation.onlinePreflightMeasured == false and
    .preparation.onlinePreflightSuccess == true and
    .preparation.measuredNetwork == "DISCONNECTED" and
    .preparation.dependencyMode == "GRADLE_OFFLINE" and
    ($data | length) == 4 and
    [$data[].round] == [1, 2, 3, 4] and
    [$data[].order] == $spec[0].measurement.roundOrders and
    all($data[];
        .initOnlyOverheadVsControlMs == (.initOnlyDurationMs - .controlDurationMs) and
        .adapterIncrementalVsInitOnlyMs == (.adapterDurationMs - .initOnlyDurationMs) and
        .adapterSavedVsControlMs == (.controlDurationMs - .adapterDurationMs) and
        .maximumInterArmIdleGapMs >= 0 and
        .maximumInterArmIdleGapMs <= $spec[0].measurement.maximumInterArmIdleGapMs and
        (.requiredJarOutputSha256 | sha256) and
        (.testCaseSetSha256 | sha256)) and
    .result == {
        rounds: 4,
        controlMeanMs: $controlMean,
        initOnlyMeanMs: $initMean,
        adapterMeanMs: $adapterMean,
        meanInitOnlyOverheadMs: ($initMean - $controlMean),
        meanAdapterIncrementalVsInitOnlyMs: ($adapterMean - $initMean),
        meanAdapterSavedVsControlMs: $saved,
        reductionRatio: $ratio,
        interval95SavedMs: $interval,
        positiveRounds: $positive,
        qualified: $qualified,
        decision: (if $qualified then
            "QUALIFIED_VALUE_AWARE_STANDARD_JAR_REUSE"
            else "KEEP_NATIVE_FOR_UNQUALIFIED_STANDARD_JAR_WORKFLOW" end)
    } and
    .boundaries == $spec[0].boundaries
' "${buildopt_result}" >/dev/null

printf 'POC optimization-overhead ablation evidence OK: %s\n' "${buildopt_result}"
