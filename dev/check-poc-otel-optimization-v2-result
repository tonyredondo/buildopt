#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [RESULT_FILE]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-otel-optimization-v2.json"
buildopt_tasks="${buildopt_repo_root}/specs/poc-otel-spring-family-v2.tasks.txt"
buildopt_guard="${buildopt_script_dir}/poc-spring-test-preparation.guard.init.gradle"
buildopt_result=${1:-"${buildopt_repo_root}/benchmarks/results/poc-otel-optimization-v2.json"}

for buildopt_command in git jq sha256sum; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required OpenTelemetry Spring-family result checker is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
"${buildopt_script_dir}/check-poc-otel-optimization-v2" >/dev/null
[[ -s "${buildopt_result}" ]] || {
    printf 'OpenTelemetry Spring-family evidence is unavailable: %s\n' \
        "${buildopt_result}" >&2
    exit 1
}

buildopt_before=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_tasks_sha=$(sha256sum "${buildopt_tasks}" | awk '{print $1}')
buildopt_runner_sha=29287c246eaef3770b2f5ed77adaa71573f2375875959850452f36c90cd1c958
buildopt_guard_sha=$(sha256sum "${buildopt_guard}" | awk '{print $1}')

jq -e --arg specSha "${buildopt_spec_sha}" --arg tasksSha "${buildopt_tasks_sha}" \
    --arg runnerSha "${buildopt_runner_sha}" --arg guardSha "${buildopt_guard_sha}" \
    --slurpfile spec "${buildopt_spec}" \
    --rawfile taskText "${buildopt_tasks}" '
    def sha256: type == "string" and test("^[0-9a-f]{64}$");
    def gitsha: type == "string" and test("^[0-9a-f]{40}$");
    def bootstrap_mean($data; $sample):
        reduce range(0; 4) as $draw
            ({state: ((2654435761 * ($sample + 1)) % 4294967296), sum: 0};
             .state = ((1664525 * .state + 1013904223) % 4294967296) |
             .sum += $data[((.state / 1073741824) | floor)].savedMs) |
        .sum / 4;
    def bootstrap95($data):
        ([range(0; 4096) as $sample | bootstrap_mean($data; $sample)] | sort) as $r |
        [$r[102], $r[3993]];
    ($taskText | split("\n") | map(select(length > 0))) as $tasks |
    .observations as $data |
    (($data | map(.controlDurationMs) | add) / 4) as $controlMean |
    (($data | map(.candidateDurationMs) | add) / 4) as $candidateMean |
    (($data | map(.savedMs) | add) / 4) as $mean |
    (($data | map(.savedMs) | add) /
        ($data | map(.controlDurationMs) | add)) as $ratio |
    bootstrap95($data) as $interval |
    ($data | map(select(.savedMs > 0)) | length) as $positive |
    ($mean >= $spec[0].valueGate.minimumSavedMs and
     $ratio >= $spec[0].valueGate.minimumReductionRatio and
     $interval[0] > 0 and
     $positive >= $spec[0].valueGate.minimumPositivePairs and
     ($data | map(.requiredOutputSha256) | unique | length) == 1 and
     all($data[]; .requiredOutputCount > 0 and
         .candidateHotStateHit and .candidateStandardJarCacheHit and
         (.controlStandardJarCacheHit | not) and
         (.managedRuntimeStarted | not) and
         (.rootBuildGradleTestTasksExecuted | not) and
         (.productAttributableFailure | not))) as $qualified |
    .schemaVersion == "buildopt.evidence/poc-otel-optimization/v2" and
    .workItem == "POC-OTEL-STABILITY-002" and
    (.capturedAt | fromdateiso8601) and
    .specSha256 == $specSha and
    (.buildopt.revision | gitsha) and
    (.buildopt.executableSha256 | sha256) and
    (.buildopt.packageSha256 | sha256) and
    .buildopt.packageVersion == "0.3.0-dev" and
    .buildopt.candidateSurface == $spec[0].measurement.candidateSurface and
    .buildopt.launcherOverheadIncluded == true and
    .buildopt.runnerScriptSha256 == $runnerSha and
    .buildopt.rootTestGuardScriptSha256 == $guardSha and
    .repository == {
        nameWithOwner: $spec[0].repository.nameWithOwner,
        revision: $spec[0].repository.revision,
        sourceArchiveSha256: $spec[0].repository.sourceArchiveSha256
    } and
    .runner == $spec[0].runner and
    .preparation.onlinePreflightMeasured == false and
    .preparation.onlinePreflightSuccess == true and
    (.preparation.onlinePreflightWallClockMs | type == "number" and . > 0) and
    .preparation.measuredNetwork == "DISCONNECTED" and
    .preparation.dependencyMode == "GRADLE_OFFLINE_WITH_SHARED_READ_ONLY_CACHE" and
    (.preparation.readOnlyDependencyCacheSha256 | sha256) and
    (.preparation.buildCacheSeedSha256 | sha256) and
    (.preparation.candidateBuildCacheSeedSha256 | sha256) and
    .preparation.preflightDaemonStoppedBeforeArmSetup == true and
    .preparation.cacheSeedRestoredBeforeEveryArm == true and
    .preparation.sharedCheckout == true and
    .preparation.sharedGradleUserHome == true and
    .preparation.sharedDaemon == true and
    .preparation.controlStandardJarCacheEligibility == false and
    .preparation.candidateStandardJarCacheEligibility == true and
    .preparation.outputsRemovedBeforeEveryArm == true and
    .preparation.fixedMutationAppliedAfterCacheRestore == true and
    .discovery == {
        complete: true,
        containsTestTasks: false,
        graphSha256: $spec[0].discovery.expectedGraphSha256,
        graphDigest: $spec[0].discovery.expectedGraphDigest,
        projectCount: $spec[0].discovery.expectedProjectCount,
        controlReachCount: $spec[0].control.expectedReachedProjectCount,
        candidateReachCount: $spec[0].candidate.expectedReachedProjectCount,
        controlEntrypointsFileSha256: $tasksSha,
        candidateEntrypoints: $spec[0].candidate.entrypoints,
        exactBoundHotStateEnabled: true,
        measuredCandidateHotStateHits: true,
        measuredCandidateStandardJarCacheHits: true
    } and
    ($data | length) == 4 and
    [$data[].pair] == [1, 2, 3, 4] and
    [$data[].order] == [
        "CONTROL_FIRST", "CANDIDATE_FIRST", "CONTROL_FIRST", "CANDIDATE_FIRST"
    ] and
    ($data | map(.requiredOutputSha256) | unique | length) == 1 and
    ($data | map(.requiredOutputCount) | unique | length) == 1 and
    all($data[];
        (.controlDurationMs | type == "number" and . > 0) and
        (.candidateDurationMs | type == "number" and . > 0) and
        .savedMs == (.controlDurationMs - .candidateDurationMs) and
        (.interArmIdleGapMs | type == "number" and . >= 0 and
            . <= $spec[0].measurement.maximumInterArmIdleGapMs) and
        (.controlMaximumResidentSetKb | type == "number" and . > 0) and
        (.candidateMaximumResidentSetKb | type == "number" and . > 0) and
        (.requiredOutputSha256 | sha256) and
        (.requiredOutputCount | type == "number" and . > 0) and
        .controlEntrypoints == $tasks and
        .candidateEntrypoints == $spec[0].candidate.entrypoints and
        .candidateHotStateHit == true and
        .candidateStandardJarCacheHit == true and
        .controlStandardJarCacheHit == false and
        .managedRuntimeStarted == false and
        .rootBuildGradleTestTasksExecuted == false and
        .productAttributableFailure == false) and
    .fallback == {
        changePath: $spec[0].fallback.changePath,
        mode: $spec[0].fallback.expectedMode,
        reason: $spec[0].fallback.expectedReason,
        entrypointsFileSha256: $tasksSha,
        outsideCandidateEntrypointObserved: ":instrumentation:spring:spring-webmvc:spring-webmvc-6.0:javaagent:testClasses",
        buildSuccessful: true,
        performanceClaim: false
    } and
    .result == {
        pairs: 4,
        controlMeanMs: $controlMean,
        candidateMeanMs: $candidateMean,
        meanSavedMs: $mean,
        reductionRatio: $ratio,
        interval95SavedMs: $interval,
        positivePairs: $positive,
        qualified: $qualified,
        decision: (if $qualified then
            $spec[0].terminalDecisions.qualifies
            else $spec[0].terminalDecisions.failsValueGate end)
    } and
    .boundaries == $spec[0].boundaries
' "${buildopt_result}" >/dev/null

buildopt_after=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
if [[ "${buildopt_before}" != "${buildopt_after}" ]]; then
    printf 'OpenTelemetry Spring-family validation changed the working tree\n' >&2
    exit 1
fi

printf 'optimized OpenTelemetry evidence OK: %s\n' "${buildopt_result}"
