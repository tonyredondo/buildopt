#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [RESULT_JSON]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_result=${1:-"${buildopt_repo_root}/benchmarks/results/build-impact-performance-v1-local.json"}

command -v jq >/dev/null 2>&1 || {
    printf 'required Build Impact performance command is unavailable: jq\n' >&2
    exit 1
}
if [[ ! -f "${buildopt_result}" ]]; then
    printf 'Build Impact performance result is unavailable: %s\n' \
        "${buildopt_result}" >&2
    exit 1
fi

buildopt_before_status=
if command -v git >/dev/null 2>&1 && [[ -d "${buildopt_repo_root}/.git" ]]; then
    buildopt_before_status=$(\
        git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
    )
fi

jq -e '
    def digest:
        type == "string" and test("^[0-9a-f]{64}$");
    def revision:
        type == "string" and test("^[0-9a-f]{40}$");
    . as $report |
    .result.observations as $rows |
    keys == [
        "boundaries",
        "buildoptRevision",
        "capturedAt",
        "design",
        "result",
        "runner",
        "schemaVersion"
    ] and
    .schemaVersion == "buildopt.benchmarks/build-impact-performance/v1" and
    (.capturedAt |
        type == "string" and
        test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
    (.buildoptRevision | revision) and
    (.runner | keys == [
        "architecture",
        "cpuCount",
        "memoryBytes",
        "operatingSystem",
        "qualifiedGoldenRunner"
    ]) and
    (.runner.operatingSystem | type == "string" and length > 0) and
    (.runner.architecture | type == "string" and length > 0) and
    (.runner.cpuCount | type == "number" and . > 0 and floor == .) and
    (.runner.memoryBytes | type == "number" and . > 0 and floor == .) and
    (if .runner.qualifiedGoldenRunner
     then .runner.cpuCount == 4 and .runner.memoryBytes == 17179869184
     else true
     end) and
    (.design == {
            "pairs": 4,
            "order": "PAIRED_ALTERNATING",
            "cache": false,
            "configurationCache": false,
            "changedPath": "library-c/src/main/java/synthetic/LibraryC.java",
            "fullEntrypoints": ["assemble", "testOwnedCheck"],
            "selectedEntrypoints": [":service-a:assemble", "testOwnedCheck"],
            "omittedProject": ":service-b",
            "generatedSources": {
                "libraryC": 96,
                "serviceA": 96,
                "serviceB": 2048
            }
        } or
     .design == {
            "pairs": 4,
            "order": "PAIRED_ALTERNATING",
            "cache": false,
            "configurationCache": true,
            "changedPath": "library-c/src/main/java/synthetic/LibraryC.java",
            "fullEntrypoints": ["assemble", "testOwnedCheck"],
            "selectedEntrypoints": [":service-a:assemble", "testOwnedCheck"],
            "omittedProject": ":service-b",
            "generatedSources": {
                "libraryC": 96,
                "serviceA": 96,
                "serviceB": 2048
            },
            "daemonPolicy": "ENABLED_SEPARATE_WARM_WORKSPACES",
            "profile": "OPTIMIZED_NATIVE",
            "fullControlCommand":
                "./gradlew --parallel --configuration-cache --no-build-cache assemble testOwnedCheck"
        }) and
    (.result | keys == [
        "fullGraphMeanMs",
        "meanReductionRatio",
        "meanSavedMs",
        "observations",
        "positivePairs",
        "requiredOutputsIdentical",
        "selectedGraphMeanMs"
    ]) and
    ($rows | type == "array" and length == 4) and
    ([$rows[].pair] | sort) == [1, 2, 3, 4] and
    all($rows[];
        keys == [
            "fullGraphDurationMs",
            "order",
            "pair",
            "preservedTestMarkerSha256",
            "savedMs",
            "selectedGraphDurationMs",
            "serviceAJarSha256"
        ] and
        (.pair | type == "number" and . >= 1 and . <= 4 and floor == .) and
        (if (.pair % 2) == 1
         then .order == "FULL_FIRST"
         else .order == "SELECTED_FIRST"
         end) and
        .fullGraphDurationMs > 0 and
        .selectedGraphDurationMs > 0 and
        .savedMs == (.fullGraphDurationMs - .selectedGraphDurationMs) and
        (.serviceAJarSha256 | digest) and
        (.preservedTestMarkerSha256 | digest)) and
    .result.fullGraphMeanMs ==
        (($rows | map(.fullGraphDurationMs) | add) / 4) and
    .result.selectedGraphMeanMs ==
        (($rows | map(.selectedGraphDurationMs) | add) / 4) and
    .result.meanSavedMs == (($rows | map(.savedMs) | add) / 4) and
    .result.meanReductionRatio ==
        (($rows | map(.savedMs) | add) /
         ($rows | map(.fullGraphDurationMs) | add)) and
    .result.positivePairs ==
        ($rows | map(select(.savedMs > 0)) | length) and
    .result.requiredOutputsIdentical and
    (($rows | map(.serviceAJarSha256) | unique | length) == 1) and
    (($rows | map(.preservedTestMarkerSha256) | unique | length) == 1) and
    .result.meanSavedMs > 0 and
    .result.positivePairs == 4 and
    .boundaries == {
        "customerAlternativeDeclaredByManifest": true,
        "productionPlanSelectionProvenSeparately": true,
        "testOptimizationModified": false,
        "descriptivePocEvidence": true,
        "productionPromotionAuthorized": false,
        "eightHourSoakExecuted": false
    }
' "${buildopt_result}" >/dev/null

if command -v git >/dev/null 2>&1 && [[ -d "${buildopt_repo_root}/.git" ]]; then
    buildopt_after_status=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
    if [[ "${buildopt_before_status}" != "${buildopt_after_status}" ]]; then
        printf 'Build Impact performance validation changed the working tree\n' >&2
        exit 1
    fi
fi

printf 'BuildOpt Build Impact performance OK: %s\n' "${buildopt_result}"
