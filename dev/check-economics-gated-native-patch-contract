#!/usr/bin/env bash
set -euo pipefail

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
cd "${buildopt_repo_root}"

jq -e '
  .schemaVersion == "buildopt.specs/poc-economics-gated-reviewed-native-patch/v1" and
  .predecessor == "STOP_THIRD_FAMILY_CUSTOMER_ECONOMICS_VALUE_GATE" and
  .sourceClassifier == "NORMALIZATION_AWARE_CACHEABILITY_V2" and
  .reusePolicy == "IDENTITIES_AND_COMPATIBILITY_ONLY_ALL_RESULT_ROWS_FRESH" and
  .sourceGate.requiredConclusiveFamilies == 10 and
  .sourceGate.minimumActionFamilies == 1 and
  .sourceGate.maximumNativeDiagnostics == 6 and
  .sourceGate.maximumDiagnosticFamilies == 3 and
  .economicPrefilter.hardDependencyCriticalPathRequired == true and
  .economicPrefilter.minimumAddressableMilliseconds == 500 and
  .economicPrefilter.minimumAddressablePercent == 2 and
  .economicPrefilter.maximumProjectedMachinePaybackBuilds == 300 and
  .economicPrefilter.boundedOutputsAndEffects == true and
  .economicPrefilter.maximumSelectedProposals == 2 and
  .economicPrefilter.maximumSelectedFamilies == 2 and
  .correctnessGate.maximumGradleStartsPerProposal == 6 and
  .correctnessGate.maximumProductFailures == 0 and
  .valueGate.excludedStabilizations == 1 and .valueGate.balancedPairs == 8 and
  .valueGate.requiredPositivePairs == 8 and
  .valueGate.minimumMeanSavingMilliseconds == 500 and
  .valueGate.minimumMeanSavingPercent == 2 and
  .reviewGate.firstExposure == true and
  .reviewGate.ownerReportedActiveSeconds == true and
  .reviewGate.maximumActiveReviewMinutes == 15 and
  .terminalGate.requiredNewPublicFamilies == 1 and
  .terminalGate.maximumCombinedPaybackBuilds == 300 and
  .budget.maximumAdditionalDiskGiB == 8 and
  .budget.minimumFreeDiskBeforePublicBuildGiB == 8 and
  .budget.stopBeforeNextStartFreeDiskGiB == 6 and
  .delivery.controlledForkOnly == true and .delivery.draftOnly == true and
  .delivery.upstreamPullRequest == false and .delivery.defaultBranchMutation == false and
  .delivery.mergeAuthorized == false and .delivery.forcePush == false and
  .boundaries.productionAuthorized == false and
  .boundaries.automaticApply == false and .boundaries.automaticMerge == false and
  .boundaries.soak == false and .boundaries.designPartner == false and
  .boundaries.testOptimization == "OUT_OF_SCOPE"
' specs/poc-economics-gated-reviewed-native-patch-v1.json >/dev/null

jq -e '
  .schemaVersion == "buildopt.specs/poc-economics-gated-reviewed-native-patch-subjects/v1" and
  .reusePolicy == "PUBLIC_REVISIONS_ONLY_NO_PRIOR_RESULT_ROWS" and
  (.families | length) == 10 and
  ([.families[].key] | unique | length) == 10 and
  all(.families[];
    (.key | type == "string" and length > 0) and
    (.repository | test("^https://github.com/.+\\.git$")) and
    (.revision | test("^[0-9a-f]{40}$")))
' specs/poc-economics-gated-reviewed-native-patch-v1.subjects.json >/dev/null

./dev/run --toolchain go -- go test ./cmd/economics-gated-native-patch-audit ./internal/normalizationaware
printf 'EGNP-001 contract OK: ten fresh families, economic prefilter before patch execution\n'
