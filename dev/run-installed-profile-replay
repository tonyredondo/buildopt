#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)) || [[ $1 != /* ]]; then
    printf 'usage: %s /absolute/evidence/output\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
[[ ! -e ${buildopt_output} || -d ${buildopt_output} ]] || {
    printf 'installed-profile evidence output is not a directory: %s\n' \
        "${buildopt_output}" >&2
    exit 1
}
[[ ! -s ${buildopt_output}/summary.json ]] || {
    printf 'installed-profile evidence is already complete: %s\n' \
        "${buildopt_output}" >&2
    exit 1
}

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_spec="${buildopt_repo_root}/specs/poc-installed-profile-replay-v1.json"
buildopt_source_spec="${buildopt_repo_root}/specs/poc-generic-change-breadth-v1.json"
buildopt_source_root="${buildopt_repo_root}/benchmarks/results/poc-generic-change-breadth-v1"

for buildopt_command in awk cp curl file git jq mkdir mktemp mv perl python3 sha256sum tar timeout; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required installed-profile runner command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
"${buildopt_script_dir}/check-installed-profile-replay" >/dev/null
[[ -z $(git -C "${buildopt_repo_root}" status --porcelain --untracked-files=no) ]] || {
    printf 'BuildOpt tracked state must be clean before installed-profile capture\n' >&2
    exit 1
}

buildopt_release_revision=$(jq -er '.release.revision' "${buildopt_spec}")
[[ ${buildopt_release_revision} =~ ^[0-9a-f]{40}$ ]] || {
    printf 'installed-profile release revision is not bound\n' >&2
    exit 1
}
buildopt_version=$(jq -er '.release.version' "${buildopt_spec}")
buildopt_tag=$(jq -er '.release.tag' "${buildopt_spec}")
buildopt_installer_url=$(jq -er '.release.installerUrl' "${buildopt_spec}")
buildopt_remote_tag=$(git ls-remote \
    https://github.com/tonyredondo/buildopt.git "refs/tags/${buildopt_tag}^{}" |
    awk 'NR == 1 {print $1}')
[[ ${buildopt_remote_tag} == "${buildopt_release_revision}" ]] || {
    printf 'public release tag does not resolve to the preregistered revision\n' >&2
    exit 1
}

buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-installed-profile-replay.XXXXXX")
buildopt_cleanup() {
    if [[ ${buildopt_root:-} == "${TMPDIR:-/tmp}/buildopt-installed-profile-replay."* ]]; then
        rm -rf -- "${buildopt_root}"
    fi
}
trap buildopt_cleanup EXIT

buildopt_normalize_log() {
    local buildopt_log=$1
    python3 - "${buildopt_log}" "${buildopt_root}" "${buildopt_repo_root}" "${HOME}" <<'PY'
from pathlib import Path
import sys

log = Path(sys.argv[1])
replacements = (
    (sys.argv[2], "${BUILDOPT_CAPTURE_ROOT}"),
    (sys.argv[3], "${BUILDOPT_SOURCE_ROOT}"),
    (sys.argv[4], "${HOME}"),
)
content = log.read_text(encoding="utf-8")
for source, replacement in sorted(replacements, key=lambda pair: len(pair[0]), reverse=True):
    content = content.replace(source, replacement)
log.write_text(content, encoding="utf-8")
PY
}

buildopt_remove_cell_root() {
    local buildopt_cell_root=$1
    [[ ${buildopt_cell_root} == "${buildopt_root}/"* ]] || return 1
    for _ in 1 2 3 4 5; do
        rm -rf -- "${buildopt_cell_root}" || true
        [[ ! -e ${buildopt_cell_root} ]] && return 0
        sleep 1
    done
    printf 'installed-profile cell cleanup did not settle: %s\n' \
        "${buildopt_cell_root}" >&2
    return 1
}

mkdir -p -- "${buildopt_output}" "${buildopt_root}/install" "${buildopt_root}/release"
curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
    --tlsv1.2 --output "${buildopt_root}/release/install.sh" "${buildopt_installer_url}"
curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
    --tlsv1.2 \
    --output "${buildopt_root}/release/buildopt-${buildopt_version}-linux-amd64.tar.gz.sha256" \
    "https://github.com/tonyredondo/buildopt/releases/download/${buildopt_tag}/buildopt-${buildopt_version}-linux-amd64.tar.gz.sha256"
bash "${buildopt_root}/release/install.sh" --version "${buildopt_version}" \
    --prefix "${buildopt_root}/install" >"${buildopt_output}/install.log" 2>&1
buildopt_normalize_log "${buildopt_output}/install.log"
buildopt_executable="${buildopt_root}/install/bin/buildopt"
[[ -x ${buildopt_executable} ]] || {
    printf 'public BuildOpt executable was not installed\n' >&2
    exit 1
}
buildopt_executable_sha=$(sha256sum "${buildopt_executable}" | awk '{print $1}')
buildopt_installer_sha=$(sha256sum "${buildopt_root}/release/install.sh" | awk '{print $1}')
buildopt_archive_sha=$(awk 'NR == 1 {print $1}' \
    "${buildopt_root}/release/buildopt-${buildopt_version}-linux-amd64.tar.gz.sha256")

buildopt_hash_binary="${buildopt_root}/profile-output-hash"
"${buildopt_script_dir}/run" --toolchain go -- go build -trimpath \
    -o "${buildopt_hash_binary}" ./dev/profile-output-hash

buildopt_mutate_repository() {
    local buildopt_mutation=$1
    local buildopt_repository=$2
    local buildopt_change_path=$3
    local buildopt_marker=$4
    case "${buildopt_mutation}" in
        ADD_PACKAGE_PRIVATE_MARKER_RETURNING_ONE)
            perl -0pi -e 's/\n}\n\z/\n\n    int buildOptPocMarker() {\n        return 1;\n    }\n}\n/' \
                "${buildopt_repository}/${buildopt_change_path}"
            ;;
        APPEND_FIXED_COMMENT)
            printf '\n// buildopt-poc-%s\n' "${buildopt_marker}" \
                >>"${buildopt_repository}/${buildopt_change_path}"
            ;;
        *)
            printf 'unsupported installed-profile mutation: %s\n' \
                "${buildopt_mutation}" >&2
            return 1
            ;;
    esac
}

buildopt_seed_gradle_distribution() {
    local buildopt_repository=$1
    local buildopt_gradle_home=$2
    local buildopt_properties buildopt_url buildopt_archive buildopt_distribution
    local buildopt_source_root_candidate buildopt_source buildopt_destination
    buildopt_properties="${buildopt_repository}/gradle/wrapper/gradle-wrapper.properties"
    buildopt_url=$(awk -F= '$1 == "distributionUrl" {sub(/^[^=]*=/, ""); print; exit}' \
        "${buildopt_properties}")
    buildopt_url=${buildopt_url//\\:/:}
    buildopt_archive=${buildopt_url%%\?*}
    buildopt_archive=${buildopt_archive##*/}
    buildopt_distribution=${buildopt_archive%.zip}
    [[ ${buildopt_distribution} =~ ^gradle-[0-9][0-9.]*-(bin|all)$ ]] || return 1
    buildopt_destination="${buildopt_gradle_home}/wrapper/dists/${buildopt_distribution}"
    mkdir -p -- "${buildopt_destination}"
    for buildopt_source_root_candidate in \
        "${buildopt_repo_root}/.tools/gradle-user-home/wrapper/dists" \
        "${GRADLE_USER_HOME:-${HOME}/.gradle}/wrapper/dists"; do
        buildopt_source="${buildopt_source_root_candidate}/${buildopt_distribution}"
        [[ -d ${buildopt_source} ]] || continue
        cp -a -- "${buildopt_source}/." "${buildopt_destination}/"
    done
}

buildopt_extract_plan() {
    local buildopt_log=$1
    local buildopt_destination=$2
    awk '
      index($0, "buildopt: qualified POC profile plan ") == 1 {
        sub(/^buildopt: qualified POC profile plan /, "")
        print
        found++
      }
      END {if (found != 1) exit 1}
    ' "${buildopt_log}" >"${buildopt_destination}"
    jq -e . "${buildopt_destination}" >/dev/null
}

buildopt_copy_profile() {
    local buildopt_source=$1
    local buildopt_repository=$2
    cp -- "${buildopt_source}/profile.json" \
        "${buildopt_repository}/buildopt-qualified-profile.json"
    cp -- "${buildopt_source}/buildopt-impact-manifest.json" \
        "${buildopt_source}/buildopt-impact-graph.generated.json" \
        "${buildopt_source}/buildopt-impact.generated.json" \
        "${buildopt_source}/buildopt-output-equivalence.json" \
        "${buildopt_repository}/"
}

buildopt_hash_outputs() {
    local buildopt_repository=$1
    local buildopt_repository_id=$2
    local buildopt_pipeline=$3
    local buildopt_destination=$4
    "${buildopt_hash_binary}" "${buildopt_repository}" \
        "${buildopt_repository}/buildopt-impact-manifest.json" \
        "${buildopt_repository_id}" "${buildopt_pipeline}" \
        "${buildopt_repository}/buildopt-output-equivalence.json" \
        >"${buildopt_destination}"
}

buildopt_capture_cell() {
    local buildopt_key=$1
    local buildopt_index buildopt_repository_id buildopt_pipeline buildopt_remote
    local buildopt_public_revision buildopt_jdk buildopt_change_path buildopt_mutation
    local buildopt_expected_target buildopt_terminal_output buildopt_source
    local buildopt_repository buildopt_gradle_home buildopt_cell_output buildopt_target
    local buildopt_candidate_sha buildopt_fallback_sha
    local -a buildopt_expected_entrypoints=()

    buildopt_index=$(jq --arg key "${buildopt_key}" \
        '.repositories | map(.key) | index($key)' "${buildopt_source_spec}")
    [[ ${buildopt_index} != null ]] || return 1
    buildopt_repository_id=$(jq -er ".repositories[${buildopt_index}].repositoryId" "${buildopt_source_spec}")
    buildopt_pipeline=$(jq -er ".repositories[${buildopt_index}].pipelineClass" "${buildopt_source_spec}")
    buildopt_remote=$(jq -er ".repositories[${buildopt_index}].remoteUrl" "${buildopt_source_spec}")
    buildopt_public_revision=$(jq -er ".repositories[${buildopt_index}].publicRevision" "${buildopt_source_spec}")
    buildopt_jdk=$(jq -er ".repositories[${buildopt_index}].jdkToolchain" "${buildopt_source_spec}")
    buildopt_change_path=$(jq -er ".repositories[${buildopt_index}].changePath" "${buildopt_source_spec}")
    buildopt_mutation=$(jq -er ".repositories[${buildopt_index}].mutation" "${buildopt_source_spec}")
    mapfile -t buildopt_expected_entrypoints < <(
        jq -r ".repositories[${buildopt_index}].expectedCandidateEntrypoints[]" \
            "${buildopt_source_spec}"
    )
    buildopt_source="${buildopt_source_root}/${buildopt_key}/capture-2"
    buildopt_expected_target=$(jq -er '.qualification.repositoryRevision' \
        "${buildopt_source}/profile.json")
    buildopt_terminal_output=$(jq -er '
        [.observations[] |
          .controlRequiredOutputSha256, .candidateRequiredOutputSha256] |
        unique | if length == 1 then .[0] else error("terminal output drift") end
    ' "${buildopt_source}/evidence.json")
    [[ $(sha256sum "${buildopt_source}/evidence.json" | awk '{print $1}') == \
        $(jq -er '.qualification.sha256' "${buildopt_source}/profile.json") ]] || {
        printf 'terminal qualification binding drifted: %s\n' "${buildopt_key}" >&2
        return 1
    }

    buildopt_repository="${buildopt_root}/${buildopt_key}/repository"
    buildopt_gradle_home="${buildopt_root}/${buildopt_key}/gradle-home"
    buildopt_cell_output="${buildopt_output}/${buildopt_key}"
    mkdir -p -- "${buildopt_repository}" "${buildopt_gradle_home}" "${buildopt_cell_output}"
    git -C "${buildopt_repository}" init -q
    git -C "${buildopt_repository}" remote add origin "${buildopt_remote}"
    git -C "${buildopt_repository}" fetch --depth=1 origin "${buildopt_public_revision}"
    git -C "${buildopt_repository}" checkout -q --detach FETCH_HEAD
    buildopt_seed_gradle_distribution "${buildopt_repository}" "${buildopt_gradle_home}"
    (
        cd -- "${buildopt_repository}"
        env -u CI GRADLE_USER_HOME="${buildopt_gradle_home}" \
            timeout 15m "${buildopt_script_dir}/run" --toolchain "${buildopt_jdk}" -- \
            ./gradlew --version
    ) >"${buildopt_cell_output}/distribution.log" 2>&1
    buildopt_normalize_log "${buildopt_cell_output}/distribution.log"

    buildopt_mutate_repository "${buildopt_mutation}" "${buildopt_repository}" \
        "${buildopt_change_path}" "${buildopt_key}"
    git -C "${buildopt_repository}" config user.name 'BuildOpt POC'
    git -C "${buildopt_repository}" config user.email 'buildopt-poc@example.invalid'
    git -C "${buildopt_repository}" config commit.gpgsign false
    git -C "${buildopt_repository}" add "${buildopt_change_path}"
    GIT_AUTHOR_DATE='2026-08-10T00:00:00Z' \
        GIT_COMMITTER_DATE='2026-08-10T00:00:00Z' \
        git -C "${buildopt_repository}" commit -qm 'Apply frozen BuildOpt matrix mutation'
    buildopt_target=$(git -C "${buildopt_repository}" rev-parse HEAD)
    [[ ${buildopt_target} == "${buildopt_expected_target}" ]] || {
        printf 'installed-profile target revision drifted: %s\n' "${buildopt_key}" >&2
        return 1
    }
    printf '%s\n' "${buildopt_change_path}" \
        >"${buildopt_repository}/buildopt-changes.txt"
    buildopt_copy_profile "${buildopt_source}" "${buildopt_repository}"

    printf 'Running installed candidate for %s\n' "${buildopt_key}"
    (
        cd -- "${buildopt_repository}"
        env -u CI GRADLE_USER_HOME="${buildopt_gradle_home}" \
            timeout 30m "${buildopt_script_dir}/run" --toolchain "${buildopt_jdk}" -- \
            "${buildopt_executable}" poc --changes-file buildopt-changes.txt
    ) >"${buildopt_cell_output}/candidate.log" 2>&1
    buildopt_extract_plan "${buildopt_cell_output}/candidate.log" \
        "${buildopt_cell_output}/candidate-plan.json"
    jq -e --argjson entrypoints "$(printf '%s\n' "${buildopt_expected_entrypoints[@]}" | jq -Rsc 'split("\n")[:-1]')" \
        --slurpfile profile "${buildopt_source}/profile.json" '
        .schemaVersion == "buildopt.poc/qualified-profile-plan/v4" and
        .selectionMode == "POC_CANDIDATE" and
        .selectionReason == "EXPLICIT_OWNER_POC_CANDIDATE" and
        .entrypoints == $entrypoints and
        .qualification == $profile[0].qualification and
        (.preconditions | length) == 4 and
        all(.preconditions[]; .status == "SATISFIED") and
        .productionAuthorized == false
    ' "${buildopt_cell_output}/candidate-plan.json" >/dev/null
    buildopt_hash_outputs "${buildopt_repository}" "${buildopt_repository_id}" \
        "${buildopt_pipeline}" "${buildopt_cell_output}/candidate-output.json"
    buildopt_candidate_sha=$(jq -er '.sha256' "${buildopt_cell_output}/candidate-output.json")
    buildopt_normalize_log "${buildopt_cell_output}/candidate.log"

    git -C "${buildopt_repository}" clean -ffdxq
    printf '%s\n' "${buildopt_change_path}" \
        >"${buildopt_repository}/buildopt-changes.txt"
    buildopt_copy_profile "${buildopt_source}" "${buildopt_repository}"
    printf '\n' >>"${buildopt_repository}/buildopt-impact-manifest.json"
    printf 'Running installed drift fallback for %s\n' "${buildopt_key}"
    (
        cd -- "${buildopt_repository}"
        env -u CI GRADLE_USER_HOME="${buildopt_gradle_home}" \
            timeout 30m "${buildopt_script_dir}/run" --toolchain "${buildopt_jdk}" -- \
            "${buildopt_executable}" poc --changes-file buildopt-changes.txt
    ) >"${buildopt_cell_output}/fallback.log" 2>&1
    buildopt_extract_plan "${buildopt_cell_output}/fallback.log" \
        "${buildopt_cell_output}/fallback-plan.json"
    jq -e --slurpfile profile "${buildopt_source}/profile.json" '
        .schemaVersion == "buildopt.poc/qualified-profile-plan/v4" and
        .selectionMode == "FULL_GRAPH" and
        .selectionReason == "PROFILE_PRECONDITION_FAILED" and
        .entrypoints == .fallbackEntrypoints and
        .qualification == $profile[0].qualification and
        any(.preconditions[]; .status == "FAILED") and
        .enabledAdapters == [] and
        .productionAuthorized == false
    ' "${buildopt_cell_output}/fallback-plan.json" >/dev/null
    buildopt_hash_outputs "${buildopt_repository}" "${buildopt_repository_id}" \
        "${buildopt_pipeline}" "${buildopt_cell_output}/fallback-output.json"
    buildopt_fallback_sha=$(jq -er '.sha256' "${buildopt_cell_output}/fallback-output.json")
    [[ ${buildopt_fallback_sha} == "${buildopt_candidate_sha}" ]] || {
        printf 'installed candidate and native fallback outputs differ: %s\n' \
            "${buildopt_key}" >&2
        return 1
    }
    buildopt_normalize_log "${buildopt_cell_output}/fallback.log"

    jq -n \
        --arg key "${buildopt_key}" \
        --arg repositoryId "${buildopt_repository_id}" \
        --arg pipelineClass "${buildopt_pipeline}" \
        --arg publicRevision "${buildopt_public_revision}" \
        --arg targetRevision "${buildopt_target}" \
        --arg terminalOutputSha256 "${buildopt_terminal_output}" \
        --arg candidateLogSha256 "$(sha256sum "${buildopt_cell_output}/candidate.log" | awk '{print $1}')" \
        --arg fallbackLogSha256 "$(sha256sum "${buildopt_cell_output}/fallback.log" | awk '{print $1}')" \
        --slurpfile candidatePlan "${buildopt_cell_output}/candidate-plan.json" \
        --slurpfile fallbackPlan "${buildopt_cell_output}/fallback-plan.json" \
        --slurpfile candidateOutput "${buildopt_cell_output}/candidate-output.json" \
        --slurpfile fallbackOutput "${buildopt_cell_output}/fallback-output.json" \
        --slurpfile terminalProfile "${buildopt_source}/profile.json" '
        {
          key: $key,
          repositoryId: $repositoryId,
          pipelineClass: $pipelineClass,
          publicRevision: $publicRevision,
          targetRevision: $targetRevision,
          terminalOutputSha256: $terminalOutputSha256,
          crossCaptureTerminalOutputMatched: ($candidateOutput[0].sha256 == $terminalOutputSha256),
          candidateFallbackOutputsMatched: ($candidateOutput[0].sha256 == $fallbackOutput[0].sha256),
          candidate: {
            decision: $candidatePlan[0].selectionMode,
            reason: $candidatePlan[0].selectionReason,
            entrypoints: $candidatePlan[0].entrypoints,
            output: $candidateOutput[0],
            logSha256: $candidateLogSha256
          },
          driftFallback: {
            decision: $fallbackPlan[0].selectionMode,
            reason: $fallbackPlan[0].selectionReason,
            entrypoints: $fallbackPlan[0].entrypoints,
            output: $fallbackOutput[0],
            logSha256: $fallbackLogSha256
          },
          qualification: $terminalProfile[0].qualification,
          productAttributableFailures: 0,
          testOptimization: "OUT_OF_SCOPE"
        }
    ' >"${buildopt_cell_output}/result.json"
    (
        cd -- "${buildopt_repository}"
        env GRADLE_USER_HOME="${buildopt_gradle_home}" \
            "${buildopt_script_dir}/run" --toolchain "${buildopt_jdk}" -- \
            ./gradlew --stop
    ) >/dev/null 2>&1 || true
    buildopt_remove_cell_root "${buildopt_root:?}/${buildopt_key}"
}

while IFS= read -r buildopt_key; do
    if [[ -s ${buildopt_output}/${buildopt_key}/result.json ]]; then
        printf 'Preserving completed installed-profile cell %s\n' "${buildopt_key}"
        continue
    fi
    [[ ! -e ${buildopt_output}/${buildopt_key} ]] || {
        printf 'incomplete installed-profile cell blocks resume: %s\n' \
            "${buildopt_key}" >&2
        exit 1
    }
    buildopt_capture_cell "${buildopt_key}"
done < <(jq -r '.cells[]' "${buildopt_spec}")

mapfile -t buildopt_result_files < <(
    jq -r '.cells[]' "${buildopt_spec}" |
        while IFS= read -r buildopt_key; do
            printf '%s/%s/result.json\n' "${buildopt_output}" "${buildopt_key}"
        done
)
jq -n \
    --arg capturedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg releaseVersion "${buildopt_version}" \
    --arg releaseTag "${buildopt_tag}" \
    --arg releaseRevision "${buildopt_release_revision}" \
    --arg executableSha256 "${buildopt_executable_sha}" \
    --arg installerSha256 "${buildopt_installer_sha}" \
    --arg archiveSha256 "${buildopt_archive_sha}" \
    --slurpfile spec "${buildopt_spec}" \
    --slurpfile cells <(jq -s '.' "${buildopt_result_files[@]}") '
    {
      schemaVersion: $spec[0].evidenceSchemaVersion,
      workItem: $spec[0].workItem,
      capturedAt: $capturedAt,
      release: {
        version: $releaseVersion,
        tag: $releaseTag,
        revision: $releaseRevision,
        platform: "linux-amd64",
        executableSha256: $executableSha256,
        installerSha256: $installerSha256,
        archiveSha256: $archiveSha256
      },
      method: $spec[0].method,
      amendment: $spec[0].amendment,
      cells: $cells[0],
      aggregation: {
        cells: ($cells[0] | length),
        selectivePlans: ($cells[0] | map(select(.candidate.decision == "POC_CANDIDATE")) | length),
        driftFallbacks: ($cells[0] | map(select(.driftFallback.reason == "PROFILE_PRECONDITION_FAILED")) | length),
        candidateFallbackOutputsMatched: ($cells[0] | map(select(.candidateFallbackOutputsMatched)) | length),
        crossCaptureTerminalOutputsMatched: ($cells[0] | map(select(.crossCaptureTerminalOutputMatched)) | length),
        qualificationsPreserved: ($cells[0] | map(select(.qualification.pairs == 8)) | length),
        productAttributableFailures: ($cells[0] | map(.productAttributableFailures) | add),
        repositoryPercentagesAveraged: false,
        mechanismPercentagesAdded: false
      },
      boundaries: $spec[0].boundaries
    }
' >"${buildopt_output}/summary.json"

printf 'Installed qualified-profile replay evidence written to %s\n' \
    "${buildopt_output}"
