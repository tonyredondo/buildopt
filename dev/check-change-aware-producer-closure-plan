#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_contract="${buildopt_repo_root}/specs/poc-change-aware-producer-closure-v1.json"
buildopt_spec="${buildopt_repo_root}/specs/poc-change-aware-producer-closure-v1.md"
buildopt_plan="${buildopt_repo_root}/docs/plans/change-aware-producer-closure-poc-tracker.md"

for buildopt_command in grep jq; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required change-aware plan command is unavailable: %s\n' "${buildopt_command}" >&2
        exit 1
    }
done

jq -e '
  .schemaVersion == "buildopt.poc/change-aware-producer-closure/v1" and
  .status == "HYPOTHESIS_PREREGISTERED" and
  .selectedHypothesis == "CHANGE_AWARE_PRODUCER_CLOSURE_V1" and
  .predecessor.decision == "STOP_FRESH_GENERIC_POC_FOR_CURRENT_DETECTOR_SET" and
  .predecessor.predecessorTimingMayBeImported == false and
  .predecessor.predecessorActionsMayBePromoted == false and
  .hypothesis.repositorySpecificRulesAllowed == false and
  .hypothesis.taskNameRulesAllowed == false and
  .hypothesis.pathExtensionRulesAllowed == false and
  .hypothesis.manualProfilesAllowed == false and
  .discoveryGate.completeFamilyInputsRequired == 5 and
  .discoveryGate.familiesWithActionsRequired == 3 and
  .discoveryGate.requiredOutputEquivalence == "BYTE_EXACT" and
  .discoveryGate.productFailureBudget == 0 and
  .discoveryGate.timingAuthorizedBeforeBreadth == false and
  .discoveryGate.activationAuthorizedBeforeValue == false and
  .freshCapture.primaryCommitsPerFamily == 20 and
  .freshCapture.reserveCommitsPerFamily == 10 and
  .freshCapture.minimumConclusiveTransitionsPerFamily == 5 and
  .freshCapture.historicalBuildOptStateAllowed == false and
  .freshCapture.historicalTimingRowsAllowed == false and
  [.blocks[].id] == [
    "SWL-CHANGE-000", "SWL-CHANGE-001", "SWL-CHANGE-002",
    "SWL-CHANGE-003", "SWL-CHANGE-004", "SWL-CHANGE-005"
  ] and
  [.blocks[].state] == ["DONE", "TODO", "WAITING", "WAITING", "WAITING", "WAITING"] and
  .nextBlock.id == "SWL-CHANGE-001" and .nextBlock.state == "TODO"
' "${buildopt_contract}" >/dev/null || {
    printf 'change-aware producer closure machine contract is inconsistent\n' >&2
    exit 1
}

# Backticks below are literal Markdown syntax.
# shellcheck disable=SC2016
buildopt_required_plan_text=(
    '**Overall:** `BREADTH_GATE_FAILED`'
    '**Progress:** three blocks executed'
    '**Current block:** `SWL-CHANGE-005`'
    '`CHANGE_AWARE_PRODUCER_CLOSURE_V1` is selected for implementation.'
    'At least three families'
    'All 25 transitions are conclusive'
    '**1/5** versus the frozen **3/5** threshold'
    'Do not benchmark or'
)
for buildopt_text in "${buildopt_required_plan_text[@]}"; do
    grep -Fq -- "${buildopt_text}" "${buildopt_plan}" || {
        printf 'change-aware tracker is missing: %s\n' "${buildopt_text}" >&2
        exit 1
    }
done

grep -Fq -- 'This is an opportunity hypothesis, not a performance result.' "${buildopt_spec}" || {
    printf 'change-aware specification lost its no-performance boundary\n' >&2
    exit 1
}
# The backticks below are literal Markdown syntax.
# shellcheck disable=SC2016
grep -Fq -- '`CHANGE_AWARE_PRODUCER_CLOSURE_V1`' "${buildopt_spec}" || {
    printf 'change-aware specification lost its detector identity\n' >&2
    exit 1
}

printf 'change-aware producer closure plan contract: PASS\n'
