    } and
    (.scorecard | length) == 15 and
    ([.scorecard[].id] | unique | length) == 15 and
    ([.scorecard[].id] | sort) == ([
        "ACTIVATION_BREADTH",
        "BOOTSTRAP_INTEGRITY",
