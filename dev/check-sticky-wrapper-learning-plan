#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_contract="${buildopt_repo_root}/specs/poc-sticky-wrapper-learning-v1.json"
buildopt_spec="${buildopt_repo_root}/specs/poc-sticky-wrapper-learning-v1.md"
buildopt_longitudinal_v2_contract="${buildopt_repo_root}/specs/poc-sticky-wrapper-longitudinal-v2.json"
buildopt_longitudinal_v2_spec="${buildopt_repo_root}/specs/poc-sticky-wrapper-longitudinal-v2.md"
buildopt_plan="${buildopt_repo_root}/docs/plans/sticky-wrapper-learning-poc-tracker.md"
buildopt_tracker="${buildopt_repo_root}/implementation-tracker.md"
buildopt_rfc="${buildopt_repo_root}/gradle-build-optimization-platform.md"

for buildopt_command in awk grep jq; do
    if ! command -v "${buildopt_command}" >/dev/null 2>&1; then
        printf 'required sticky-wrapper-plan command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    fi
done

for buildopt_file in \
    "${buildopt_contract}" \
    "${buildopt_spec}" \
    "${buildopt_longitudinal_v2_contract}" \
    "${buildopt_longitudinal_v2_spec}" \
    "${buildopt_plan}" \
    "${buildopt_tracker}" \
    "${buildopt_rfc}"; do
    if [[ ! -f "${buildopt_file}" ]]; then
        printf 'missing sticky-wrapper-plan input: %s\n' "${buildopt_file}" >&2
        exit 1
    fi
done

if ! jq -e '
    keys == [
        "boundaries",
        "budgets",
        "customerSurface",
        "executionDecisions",
        "hypothesis",
        "lifecycle",
        "planes",
        "predecessor",
        "schemaVersion",
        "scorecard",
        "terminalCampaign",
        "terminalOutcomes",
        "workItem"
    ] and
    .schemaVersion == "buildopt.poc/sticky-wrapper-learning-contract/v1" and
    .workItem == "SWL-000" and
    .predecessor == {
        workItem: "AF-015",
        outcome: "STOP_ADAPTIVE_FRAGMENT_POC",
        authority: "CONTEXT_ONLY"
    } and
    .customerSurface.generatedCommittedFiles == [
        "buildoptw",
        "buildoptw.bat",
        ".buildopt/wrapper.properties",
        ".buildopt/config.toml"
    ] and
    .customerSurface.repeatedCommand == "./buildoptw <gradle args...>" and
    .customerSurface.globalBuildOptInstallationRequired == false and
    .customerSurface.handAuthoredProfileRequired == false and
    .customerSurface.committedCredentialAllowed == false and
    .customerSurface.bootstrap == {
        immutableHttpsDistribution: true,
        sha256Required: true,
        atomicInstallRequired: true,
        verifiedOfflineReuseRequired: true
    } and
    .planes.gradleCache == {
        protocol: "GRADLE_HTTP_BUILD_CACHE",
        contents: "OPAQUE_EVICTABLE_GRADLE_OBJECTS",
        grantsOptimizationAuthority: false
    } and
    .planes.buildoptState == {
        protocol: "TYPED_CANONICAL_HTTPS_STATE",
        contents: "EVIDENCE_DECISIONS_ACTIONS_AND_ECONOMIC_LEDGER",
        generationCASRequired: true,
        servableAsGradleCacheObject: false
    } and
    .lifecycle == [
        "UNSEEN",
        "OBSERVE",
        "SHADOW",
        "TRIAL",
        "QUALIFIED",
        "ACTIVE",
        "SUSPENDED",
        "RETIRED"
    ] and
    .executionDecisions == [
        "NATIVE_NOOP",
        "OBSERVE",
        "SHADOW",
        "TRIAL",
        "ACTIVE_RUNTIME_PROFILE",
        "ACTIVE_DURABLE_PATCH",
        "SUSPENDED",
        "RETIRED"
    ] and
    .budgets == {
        nativeRetentionP50NsMax: 100000000,
        nativeRetentionP95NsMax: 250000000,
        serverUnavailableP95NsMax: 500000000,
        additionalTrialComputePermilleMax: 50,
        concurrentTrialsPerRepositoryMax: 1,
        paybackCompatibleBuildsMax: 30
    } and
    .terminalCampaign == {
        publicRepositoryFamilies: 5,
        requestedBuildsPerFamily: 20,
        validComparableBuildsPerFamilyMin: 15,
        sameRemoteGradleCacheOpportunity: true,
        chronologicalNoLookahead: true,
        exactOutputsByDefault: true,
        historicalEvidenceAuthority: "CONTEXT_ONLY"
    } and
    (.scorecard | length) == 15 and
    ([.scorecard[].id] | unique | length) == 15 and
    ([.scorecard[].id] | sort) == ([
        "ACTIVATION_BREADTH",
        "BOOTSTRAP_INTEGRITY",
        "CORRECTNESS",
        "DURABLE_VALUE",
        "EXPLAINABILITY",
        "GENERIC_IMPLEMENTATION",
        "GRADLE_EQUIVALENCE",
        "LEARNING_BUDGET",
        "LONGITUDINAL_CONFIDENCE",
        "NATIVE_RETENTION_OVERHEAD",
        "PLANE_SEPARATION",
        "PORTFOLIO_VALUE",
        "RUNTIME_VALUE",
        "TIME_TO_VALUE",
        "WRAPPER_ONBOARDING"
    ] | sort) and
    .terminalOutcomes == [
        "CONTINUE_STICKY_WRAPPER_LEARNING_POC",
        "STOP_STICKY_WRAPPER_LEARNING_POC",
        "INCOMPLETE"
    ] and
    .boundaries == {
        pocOnly: true,
        productionAuthorized: false,
        automaticMergeAuthorized: false,
        soakRequired: false,
        designPartnerRequired: false,
        testOptimizationOwned: false,
        retiredMechanismsReactivated: false
    }
' "${buildopt_contract}" >/dev/null; then
    printf 'sticky-wrapper-learning machine contract is malformed\n' >&2
    exit 1
fi

if ! jq -e '
    .schemaVersion == "buildopt.poc/sticky-wrapper-longitudinal/v2" and
    .workItem == "SWL-015" and
    .status == "BLOCKED_BY_SWL_014A_TO_SWL_014D" and
    .historicalV1.classification == "DIAGNOSTIC_ONLY" and
    .historicalV1.terminalAuthority == false and
    [.preconditions[].workItem] == ["SWL-014A", "SWL-014B", "SWL-014C", "SWL-014D"] and
    .cohort.families == 5 and
    .cohort.minimumComparablePerFamily == 15 and
    .arms.workflowArgumentsIdentical == true and
    .arms.sameLocalCacheOpportunity == true and
    .arms.sameRemoteCacheOpportunity == true and
    .arms.runnerMayInjectFlagIntoOneArmOnly == false and
    .readiness.sampleCountAloneIsSufficient == false and
    .readiness.allPreconditionsRequired == true and
    .readiness.completeLifecycleEvidenceRequired == true and
    .readiness.signedEconomicLedgerRequired == true and
    .stopEarly.minimumFamiliesWithTestableActions == 3 and
    .stopEarly.minimumFamiliesPassingInstalledValueGate == 3 and
    .boundaries.terminalThresholdsChanged == false
' "${buildopt_longitudinal_v2_contract}" >/dev/null; then
    printf 'sticky-wrapper longitudinal v2 contract is malformed\n' >&2
    exit 1
fi

buildopt_ordered_blocks=$(
    awk '
        /^\| (8A|14[A-D]|[0-9]+) \| `SWL-[0-9][0-9][0-9][A-D]?`/ {
            if (match($0, /`SWL-[0-9][0-9][0-9][A-D]?`/)) {
                block = substr($0, RSTART + 1, RLENGTH - 2)
                print block
            }
        }
    ' "${buildopt_plan}"
)
buildopt_expected_blocks=$(
    awk '
        BEGIN {
            for (block_number = 0; block_number <= 8; block_number++) printf "SWL-%03d\n", block_number
            print "SWL-008A"
            for (block_number = 9; block_number <= 14; block_number++) printf "SWL-%03d\n", block_number
            print "SWL-014A"
            print "SWL-014B"
            print "SWL-014C"
            print "SWL-014D"
            for (block_number = 15; block_number <= 16; block_number++) printf "SWL-%03d\n", block_number
        }
    '
)
if [[ "${buildopt_ordered_blocks}" != "${buildopt_expected_blocks}" ]]; then
    printf 'sticky-wrapper tracker must contain ordered blocks SWL-000..SWL-008A..SWL-014A..D..SWL-016\n' >&2
    exit 1
fi

buildopt_evidence_count=$(
    # The backticks are literal Markdown syntax.
    # shellcheck disable=SC2016
    grep -Ec '^\| `SWL-E[0-9]{3}` \|' "${buildopt_plan}" || true
)
if [[ "${buildopt_evidence_count}" != 23 ]]; then
    printf 'sticky-wrapper tracker expected 23 evidence rows, found %s\n' \
        "${buildopt_evidence_count}" >&2
    exit 1
fi

buildopt_required_text=(
    "${buildopt_plan}|**Progress:** \`16/22\` blocks complete"
    "${buildopt_plan}|**Current block:** \`SWL-014A\` — protocol and comparison-fairness correction"
    "${buildopt_plan}|./buildoptw <gradle args...>"
    "${buildopt_plan}|The existing central cache and state implementation is reused."
    "${buildopt_spec}|# Sticky wrapper learning POC v1"
    "${buildopt_spec}|CONTINUE_STICKY_WRAPPER_LEARNING_POC"
    "${buildopt_tracker}|STICKY WRAPPER LEARNING POC ACTIVE; PRIOR GENERIC HYPOTHESES STOPPED"
    "${buildopt_tracker}|SWL-014A_PROTOCOL_AND_COMPARISON_FAIRNESS"
    "${buildopt_tracker}|POC-STICKY-WRAPPER-LEARNING"
    "${buildopt_tracker}|\`E-403\`"
    "${buildopt_tracker}|\`E-404\`"
    "${buildopt_tracker}|\`E-405\`"
    "${buildopt_tracker}|\`E-406\`"
    "${buildopt_tracker}|\`E-407\`"
    "${buildopt_tracker}|\`E-408\`"
    "${buildopt_tracker}|\`E-409\`"
    "${buildopt_tracker}|\`E-410\`"
    "${buildopt_tracker}|\`E-411\`"
    "${buildopt_tracker}|\`E-412\`"
    "${buildopt_tracker}|\`E-413\`"
    "${buildopt_tracker}|\`E-414\`"
    "${buildopt_tracker}|\`E-415\`"
    "${buildopt_tracker}|\`E-416\`"
    "${buildopt_tracker}|\`E-418\`"
    "${buildopt_plan}|\`SWL-E015\`"
    "${buildopt_plan}|\`SWL-E018\`"
    "${buildopt_plan}|\`SWL-E019\`"
    "${buildopt_plan}|\`SWL-E023\`"
    "${buildopt_plan}|poc-sticky-wrapper-noop-overhead-v1.md"
    "${buildopt_plan}|check-sticky-wrapper-noop-overhead"
    "${buildopt_plan}|poc-sticky-wrapper-two-machine-v1.md"
    "${buildopt_longitudinal_v2_spec}|# Sticky wrapper longitudinal campaign v2"
    "${buildopt_longitudinal_v2_spec}|Sample count alone cannot produce \`READY_FOR_SWL_016\`."
    "${buildopt_rfc}|generate and commit BuildOpt Wrapper"
    "${buildopt_rfc}|Sticky Wrapper Learning POC Tracker"
)
for buildopt_requirement in "${buildopt_required_text[@]}"; do
    buildopt_file=${buildopt_requirement%%|*}
    buildopt_text=${buildopt_requirement#*|}
    if ! grep -Fq -- "${buildopt_text}" "${buildopt_file}"; then
        printf 'sticky-wrapper plan is missing required text in %s: %s\n' \
            "${buildopt_file}" "${buildopt_text}" >&2
        exit 1
    fi
done

printf 'Sticky wrapper learning plan: OK\n'
