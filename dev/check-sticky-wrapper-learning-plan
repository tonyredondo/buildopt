    .stopEarly.minimumFamiliesWithTestableActions == 3 and
    .stopEarly.minimumFamiliesPassingInstalledValueGate == 3 and
    .stopEarly.terminalAuthority == "SWL-016_ONLY" and
    .stopEarly.onOpportunityFailure == {
        completedBlock: "SWL-014C",
        blockState: "DONE_WITH_STOP_EVIDENCE",
        evidenceOutcome: "SWL_014C_WITH_STOP_EVIDENCE",
        skipped: ["SWL-014D", "SWL-015"],
        next: "SWL-016"
    } and
    .stopEarly.onInstalledValueFailure == {
        completedBlock: "SWL-014D",
        blockState: "DONE_WITH_STOP_EVIDENCE",
        evidenceOutcome: "SWL_014D_WITH_STOP_EVIDENCE",
        skipped: ["SWL-015"],
        next: "SWL-016"
    } and
    .stopEarly.terminalOutcomeProducedBeforeSWL016 == false and
    .boundaries.terminalThresholdsChanged == false
' "$1" >/dev/null
}

