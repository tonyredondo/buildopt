#!/usr/bin/env bash
set -euo pipefail

buildopt_report_error() {
    local buildopt_status=$1
    local buildopt_line=$2
    printf 'base CI failed at line %s (status %s)\n' \
        "${buildopt_line}" "${buildopt_status}" >&2
    exit "${buildopt_status}"
}
trap 'buildopt_report_error "$?" "$LINENO"' ERR

buildopt_usage() {
    printf 'usage: %s (--static | --lane <core|rust>)\n' "$0"
}

buildopt_mode=
buildopt_lane=
case "${1:-}" in
    --static)
        if (($# != 1)); then
            buildopt_usage >&2
            exit 64
        fi
        buildopt_mode=static
        ;;
    --lane)
        if (($# != 2)); then
            buildopt_usage >&2
            exit 64
        fi
        buildopt_mode=lane
        buildopt_lane=$2
        ;;
    *)
        buildopt_usage >&2
        exit 64
        ;;
esac
if [[ -n "${buildopt_lane}" ]] &&
    [[ "${buildopt_lane}" != "core" && "${buildopt_lane}" != "rust" ]]; then
    buildopt_usage >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_lock="${buildopt_repo_root}/.github/base-ci.lock.json"

for buildopt_command in awk git grep jq; do
    if ! command -v "${buildopt_command}" >/dev/null 2>&1; then
        printf 'required base-CI command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    fi
done
if [[ ! -f "${buildopt_lock}" ]]; then
    printf 'missing base-CI lock: %s\n' "${buildopt_lock}" >&2
    exit 70
fi

if ! jq -e '
    keys == [
        "checkout",
        "javaRuntime",
        "runner",
        "rust",
        "schemaVersion",
        "setupJava",
        "workflow"
    ] and
    .schemaVersion == "buildopt.dev/base-ci-lock/v1" and
    .workflow == ".github/workflows/base-ci.yml" and
    .runner == "ubuntu-24.04" and
    (.checkout | keys == ["commit", "repository", "version"]) and
    .checkout.repository == "actions/checkout" and
    .checkout.version == "v7.0.1" and
    (.checkout.commit | test("^[0-9a-f]{40}$")) and
    (.setupJava | keys == ["commit", "repository", "version"]) and
    .setupJava.repository == "actions/setup-java" and
    .setupJava.version == "v5.6.0" and
    (.setupJava.commit | test("^[0-9a-f]{40}$")) and
    .javaRuntime == {
        distribution: "temurin",
        version: "17.0.19+10"
    } and
    .rust == {
        adoption: "optional",
        toolchain: "1.93.0-x86_64-unknown-linux-gnu"
    }
' "${buildopt_lock}" >/dev/null; then
    printf 'base-CI lock is malformed\n' >&2
    exit 70
fi

buildopt_workflow_relative=$(jq -r '.workflow' "${buildopt_lock}")
buildopt_workflow="${buildopt_repo_root}/${buildopt_workflow_relative}"
buildopt_runner=$(jq -r '.runner' "${buildopt_lock}")
buildopt_checkout_repository=$(jq -r '.checkout.repository' "${buildopt_lock}")
buildopt_checkout_commit=$(jq -r '.checkout.commit' "${buildopt_lock}")
buildopt_setup_java_repository=$(jq -r '.setupJava.repository' "${buildopt_lock}")
buildopt_setup_java_commit=$(jq -r '.setupJava.commit' "${buildopt_lock}")
buildopt_java_distribution=$(jq -r '.javaRuntime.distribution' "${buildopt_lock}")
buildopt_java_version=$(jq -r '.javaRuntime.version' "${buildopt_lock}")
buildopt_rust_toolchain=$(jq -r '.rust.toolchain' "${buildopt_lock}")

if [[ ! -f "${buildopt_workflow}" ]]; then
    printf 'missing base-CI workflow: %s\n' "${buildopt_workflow}" >&2
    exit 1
fi

buildopt_require_count() {
    local buildopt_expected=$1
    local buildopt_line=$2
    local buildopt_actual

    buildopt_actual=$(grep -Fxc "${buildopt_line}" "${buildopt_workflow}" || true)
    if [[ "${buildopt_actual}" != "${buildopt_expected}" ]]; then
        printf 'base-CI workflow expected %s occurrence(s) of: %s\n' \
            "${buildopt_expected}" \
            "${buildopt_line}" >&2
        return 1
    fi
}

buildopt_require_count 1 "  push:"
buildopt_require_count 1 "  pull_request:"
buildopt_require_count 1 "  workflow_dispatch:"
buildopt_require_count 1 "  contents: read"
buildopt_require_count 2 "    runs-on: ${buildopt_runner}"
buildopt_require_count 2 \
    "        uses: ${buildopt_checkout_repository}@${buildopt_checkout_commit}"
buildopt_require_count 1 \
    "        uses: ${buildopt_setup_java_repository}@${buildopt_setup_java_commit}"
buildopt_require_count 2 "          persist-credentials: false"
buildopt_require_count 1 "          distribution: ${buildopt_java_distribution}"
buildopt_require_count 1 "          java-version: '${buildopt_java_version}'"
buildopt_require_count 1 "          check-latest: false"
buildopt_require_count 1 "          ${buildopt_rust_toolchain}"
buildopt_require_count 1 "            protoc \\"
buildopt_require_count 1 "            ./dev/check-base-ci --lane core"
buildopt_require_count 1 "        run: ./dev/check-owner-poc-lab"
buildopt_require_count 1 "        run: ./dev/check-base-ci --lane rust"

if grep -Eq \
    '^[[:space:]]+(pull_request_target|schedule):|^[[:space:]]+[a-z-]+:[[:space:]]+write([[:space:]]|$)' \
    "${buildopt_workflow}"; then
    printf 'base-CI workflow contains an unsafe trigger or write permission\n' >&2
    exit 1
fi

mapfile -t buildopt_uses < <(
    awk '$1 == "uses:" {print $2}' "${buildopt_workflow}"
)
if ((${#buildopt_uses[@]} != 3)); then
    printf 'base-CI workflow expected three action references, found %s\n' \
        "${#buildopt_uses[@]}" >&2
