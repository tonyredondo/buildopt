fi
for buildopt_uses_ref in "${buildopt_uses[@]}"; do
    if [[ ! "${buildopt_uses_ref}" =~ ^[^@[:space:]]+@[0-9a-f]{40}$ ]]; then
        printf 'base-CI workflow has a mutable action reference: %s\n' \
            "${buildopt_uses_ref}" >&2
        exit 1
    fi
done

