#!/usr/bin/env bash
set -euo pipefail

buildopt_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${buildopt_repo_root}"

jq -e '
  .schemaVersion == "buildopt.specs/invocation-merge-prefetch/v1" and
  .trackerId == "B-005" and
  .merge.owner == "CI_INTEGRATION" and
  .merge.arity == 2 and
  .merge.proof == "VERSIONED_TRANSITIVE_SUBSUMPTION_AND_ISOLATED_CONTROL" and
  .merge.preserveOn == ["FAILURE_SEMANTICS", "RETRY_SEMANTICS", "CONTINUE_SEMANTICS", "EXCLUSIONS", "FINALIZERS", "ORDER", "INTERMEDIATE_CONSUMER", "SIDE_EFFECTS", "CI_BARRIER", "CONTROL_DIVERGED", "RELEASE_CONTRACT"] and
  .prefetch.authority == "CALLER_VERIFIED" and
  .prefetch.singleFlightKey == ["repository", "revision", "pipelineClass", "compatibilityClass"] and
  .prefetch.maximumPayloadBytes == 1048576 and
  .prefetch.useChecks == ["PAYLOAD_DIGEST", "EXACT_BINDING", "EXPIRY", "MINIMUM_REVOCATION_EPOCH"] and
  .prefetch.failureDisposition == "NORMAL_AUTHENTICATED_POLICY_PATH" and
  .closesGate == "B-G04" and
  .doesNotClose == ["A1-001", "A1-006", "A1-G06", "B-G01", "B-G02", "B-G03"]
' specs/invocation-merge-prefetch-v1.json >/dev/null

go test -race ./internal/runtimeoptimizer
go vet ./internal/runtimeoptimizer
printf 'B-005 invocation merge and prefetch OK: semantic all-or-nothing merge, single-flight verified prefetch, B-G04 fixtures closed\n'
