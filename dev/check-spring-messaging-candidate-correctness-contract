#!/usr/bin/env bash
set -euo pipefail
buildopt_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd -- "${buildopt_root}"

buildopt_subject=specs/poc-spring-messaging-fresh-graph-confirmation-v1.subjects.json
buildopt_selection=benchmarks/results/spring-messaging-fresh-graph-confirmation-v1/summary.json
buildopt_subject_sha=$(sha256sum "${buildopt_subject}" | awk '{print $1}')
buildopt_selection_sha=$(sha256sum "${buildopt_selection}" | awk '{print $1}')

./dev/check-spring-messaging-fresh-graph-confirmation >/dev/null
jq -e --arg subjectSha "${buildopt_subject_sha}" --arg selectionSha "${buildopt_selection_sha}" '
  .schemaVersion=="buildopt.specs/poc-spring-messaging-candidate-correctness/v1" and
  .status=={currentBlock:"SMCC-002",completedBlocks:["SMCC-001"]} and
  .subject.source=="specs/poc-spring-messaging-fresh-graph-confirmation-v1.subjects.json" and
  .subject.sourceSha256==$subjectSha and
  .subject.selectionEvidence=="benchmarks/results/spring-messaging-fresh-graph-confirmation-v1/summary.json" and
  .subject.selectionEvidenceSha256==$selectionSha and
  .subject.owner==":spring-messaging" and .subject.family=="DEPENDENCY_SOURCE" and
  .subject.compatibleMatches==11 and
  .execution=={maximumGradleStarts:3,expectedModes:["OPTIMIZED_NATIVE","OPTIMIZED_NATIVE","INCREMENTAL_CANDIDATE"],candidateBuilds:1,timingSamples:0,timeoutMinutesPerInvocation:30,maximumWorkers:12} and
  .outputs=={expectedCount:14406,expectedSha256:"7de23e14d9987f0cc8661cb7de81b06f4df15cd3039ac8e947ace6f33904779f",exactAcrossAllInvocations:true} and
  .boundaries=={stateForgeryAllowed:false,publicSourceWritesAllowed:false,pairedValueAuthorized:false,productionAuthorized:false,testOptimization:"OUT_OF_SCOPE"}
' specs/poc-spring-messaging-candidate-correctness-v1.json >/dev/null

jq -e '
  .decision=="AUTHORIZE_SPRING_MESSAGING_CANDIDATE_CORRECTNESS_CONTRACT" and
  .selection.owner==":spring-messaging" and .selection.family=="DEPENDENCY_SOURCE" and
  .selection.productCompatibleCommits==11 and .graph.exactOutputFiles==14406 and
  .boundaries.candidateCorrectnessContractAuthorized and
  (.boundaries.candidateExecutionAuthorized|not) and (.boundaries.pairedValueAuthorized|not)
' "${buildopt_selection}" >/dev/null

printf 'spring-messaging candidate correctness contract: three starts, one candidate, zero timing\n'
