#!/usr/bin/env bash
set -euo pipefail

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
cd "${buildopt_repo_root}"

buildopt_contract=specs/poc-critical-path-first-reviewed-native-patch-v1.json
buildopt_subjects=specs/poc-critical-path-first-reviewed-native-patch-v1.subjects.json
buildopt_previous_keys=specs/poc-critical-path-first-reviewed-native-patch-v1.prior-family-keys.txt

jq -e '
  .schemaVersion == "buildopt.specs/poc-critical-path-first-reviewed-native-patch/v1" and
  .selectionPolicy == "FROZEN_OWNER_WORKFLOW_THEN_NATIVE_ECONOMICS_THEN_SOURCE" and
  .diagnosticGate.requiredConclusiveFamilies == 10 and
  .diagnosticGate.minimumProposalFamilies == 3 and
  .diagnosticGate.maximumNativeDiagnostics == 10 and
  .diagnosticGate.maximumDiagnosticsPerFamily == 1 and
  .diagnosticGate.hardDependencyCriticalPathRequired and
  .diagnosticGate.minimumAddressableMilliseconds == 500 and
  .diagnosticGate.minimumAddressablePercent == 2 and
  (.diagnosticGate.sourceInspectionBeforeEconomicAdmission | not) and
  .proposalGate.maximumSelectedProposals == 2 and
  .proposalGate.maximumSelectedFamilies == 2 and
  .proposalGate.maximumProjectedMachinePaybackBuilds == 300 and
  .correctnessGate.maximumGradleStartsPerProposal == 6 and
  .correctnessGate.maximumProductFailures == 0 and
  .valueGate.balancedPairs == 8 and .valueGate.requiredPositivePairs == 8 and
  .valueGate.minimumMeanSavingMilliseconds == 500 and
  .valueGate.minimumMeanSavingPercent == 2 and
  .budget.maximumAdditionalDiskGiB == 8 and
  .budget.minimumFreeDiskBeforePublicBuildGiB == 8 and
  .budget.stopBeforeNextStartFreeDiskGiB == 6 and
  .budget.maximumDiagnosticMinutesPerFamily == 20 and
  .budget.maximumDiagnosticMachineSeconds == 7200 and
  .budget.maximumWorkers == 12 and
  (.boundaries.diagnosticsAreTimingSamples | not) and
  (.boundaries.publicSourceModifiedBeforeProposalGate | not) and
  (.boundaries.upstreamPullRequest | not) and
  (.boundaries.defaultBranchMutation | not) and
  (.boundaries.productionAuthorized | not) and
  (.boundaries.automaticApply | not) and
  (.boundaries.automaticMerge | not) and
  .boundaries.testOptimization == "OUT_OF_SCOPE"
' "${buildopt_contract}" >/dev/null

jq -e '
  .schemaVersion == "buildopt.specs/poc-critical-path-first-reviewed-native-patch-subjects/v1" and
  .reusePolicy == "PREVIOUSLY_UNUSED_PUBLIC_GRADLE_FAMILIES_NO_PRIOR_RESULT_ROWS" and
  (.families | length) == 10 and
  ([.families[].key] | unique | length) == 10 and
  all(.families[];
    (.key | length > 0) and
    (.repository | test("^https://github.com/.+\\.git$")) and
    (.revision | test("^[0-9a-f]{40}$")) and
    (.sourceArchiveSha256 | test("^[0-9a-f]{64}$")) and
    (.wrapperSha256 | test("^[0-9a-f]{64}$")) and
    (.workflowFile | startswith(".")) and
    (.workflowSha256 | test("^[0-9a-f]{64}$")) and
    (.jdkToolchain | test("^temurin-jdk-(17|21|25)$")) and
    ((.ownerManagedToolchains // false) | type == "boolean") and
    (.ownerArguments | length > 0))
' "${buildopt_subjects}" >/dev/null

# Freeze predecessor keys at CPFRNP creation; later successor manifests must not
# retroactively turn a valid holdout into reuse.
[[ $(sha256sum "${buildopt_previous_keys}" | awk '{print $1}') == "4ee07dfd7ccbde9f4b41156684edcfbad7ca9de3a65ab526c8fcab427a8d6d5b" ]]
[[ $(sort -u "${buildopt_previous_keys}") == "$(cat "${buildopt_previous_keys}")" ]]
while IFS= read -r buildopt_key; do
    if grep -Fxq -- "${buildopt_key}" "${buildopt_previous_keys}"; then
        printf 'critical-path-first cohort reuses prior family: %s\n' "${buildopt_key}" >&2
        exit 1
    fi
done < <(jq -r '.families[].key' "${buildopt_subjects}")

printf 'CPFRNP-001 contract OK: ten unused owner workflows, economics before source, fixed budgets\n'
