#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)); then
    printf 'usage: %s OUTPUT_FILE\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-spring-impact-breadth-v1.json"
buildopt_guard="${buildopt_script_dir}/poc-spring-test-preparation.guard.init.gradle"

if [[ "${buildopt_output}" != /* || -e "${buildopt_output}" ]]; then
    printf 'invalid Spring Impact breadth output path\n' >&2
    exit 64
fi
for buildopt_command in awk cmp cp curl date find git grep jq mkdir mktemp \
    sed sha256sum sort tar; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required Spring Impact breadth command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
[[ -x /usr/bin/time ]] || {
    printf 'required Spring Impact breadth command is unavailable: /usr/bin/time\n' >&2
    exit 1
}
if env | grep -q '^BUILDOPT_'; then
    printf 'Spring Impact breadth measurement requires no BUILDOPT_* overrides\n' >&2
    exit 1
fi
if [[ -n "$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)" ]]; then
    printf 'Spring Impact breadth measurement requires a clean revision-bound checkout\n' >&2
    exit 1
fi
"${buildopt_script_dir}/check-poc-spring-impact-breadth" >/dev/null

buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-spring-impact-breadth.XXXXXX")
buildopt_stop_gradle() {
    local buildopt_checkout=$1
    local buildopt_home=$2
    if [[ -x "${buildopt_checkout}/gradlew" && -d "${buildopt_home}" ]]; then
        (
            cd "${buildopt_checkout}"
            env GRADLE_USER_HOME="${buildopt_home}" \
                "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
                ./gradlew --stop
        ) >/dev/null 2>&1 || true
    fi
}
buildopt_cleanup() {
    if [[ "${buildopt_root}" == "${TMPDIR:-/tmp}/buildopt-spring-impact-breadth."* ]]; then
        buildopt_stop_gradle "${buildopt_root}/source" "${buildopt_root}/preflight-home"
        for buildopt_home in "${buildopt_root}"/cells/*/*/gradle-home \
            "${buildopt_root}"/fallback/gradle-home; do
            [[ -d "${buildopt_home}" ]] || continue
            buildopt_stop_gradle "${buildopt_home%/gradle-home}/checkout" "${buildopt_home}"
        done
        rm -rf -- "${buildopt_root}"
    fi
}
trap buildopt_cleanup EXIT
chmod 0700 "${buildopt_root}"
mkdir -p -- "${buildopt_root}/source" "${buildopt_root}/preflight-home" \
    "${buildopt_root}/logs" "${buildopt_root}/cells"
chmod 0700 "${buildopt_root}/preflight-home"

buildopt_revision=$(git -C "${buildopt_repo_root}" rev-parse HEAD)
buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_runner_sha=$(sha256sum "${BASH_SOURCE[0]}" | awk '{print $1}')
buildopt_guard_sha=$(sha256sum "${buildopt_guard}" | awk '{print $1}')
(
    cd "${buildopt_repo_root}"
    "${buildopt_repo_root}/packaging/linux/package.sh" \
        --version 0.3.0-dev --output "${buildopt_root}/package" >/dev/null
)
mkdir -p -- "${buildopt_root}/package-root" "${buildopt_root}/install"
buildopt_package="${buildopt_root}/package/buildopt-0.3.0-dev-linux-amd64.tar.gz"
tar -xzf "${buildopt_package}" -C "${buildopt_root}/package-root"
"${buildopt_root}/package-root/buildopt-0.3.0-dev-linux-amd64/install.sh" \
    --prefix "${buildopt_root}/install" >/dev/null
buildopt_executable="${buildopt_root}/install/bin/buildopt"
buildopt_impact_executable="${buildopt_root}/install/bin/buildopt-impact"
buildopt_executable_sha=$(sha256sum "${buildopt_executable}" | awk '{print $1}')
buildopt_package_sha=$(sha256sum "${buildopt_package}" | awk '{print $1}')

buildopt_source_archive="${buildopt_root}/spring-framework.tar.gz"
buildopt_source_url=$(jq -er '.repository.sourceArchiveUrl' "${buildopt_spec}")
buildopt_source_sha=$(jq -er '.repository.sourceArchiveSha256' "${buildopt_spec}")
curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
    --output "${buildopt_source_archive}" "${buildopt_source_url}"
[[ "$(sha256sum "${buildopt_source_archive}" | awk '{print $1}')" == \
    "${buildopt_source_sha}" ]] || {
    printf 'Spring source archive checksum mismatch\n' >&2
    exit 1
}
tar -xzf "${buildopt_source_archive}" --strip-components=1 -C "${buildopt_root}/source"

buildopt_preflight_started=$(date +%s%N)
if ! (
    cd "${buildopt_root}/source"
    env -u CI GRADLE_USER_HOME="${buildopt_root}/preflight-home" \
        "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
        ./gradlew --daemon --build-cache --parallel --no-configuration-cache \
        --max-workers=12 --no-scan --stacktrace testClasses
) >"${buildopt_root}/logs/preflight.log" 2>&1; then
    tail -n 180 "${buildopt_root}/logs/preflight.log" >&2
    printf 'Spring Impact breadth preflight failed\n' >&2
    exit 1
fi
buildopt_preflight_finished=$(date +%s%N)
grep -Fq 'BUILD SUCCESSFUL' "${buildopt_root}/logs/preflight.log" || {
    printf 'Spring Impact breadth preflight lacks success marker\n' >&2
    exit 1
}
buildopt_stop_gradle "${buildopt_root}/source" "${buildopt_root}/preflight-home"
buildopt_cache_seed="${buildopt_root}/build-cache-seed.tar.gz"
tar -C "${buildopt_root}/preflight-home/caches" -czf "${buildopt_cache_seed}" build-cache-1
buildopt_cache_seed_sha=$(sha256sum "${buildopt_cache_seed}" | awk '{print $1}')

buildopt_make_manifest() {
    local buildopt_cell_index=$1
    local buildopt_target=$2
    jq --argjson cellIndex "${buildopt_cell_index}" '
        .manifestTemplate as $template |
        .selectiveCells[$cellIndex] as $cell |
        $template + {
            pipelineClass: $cell.pipelineClass,
            allowedAlternatives: [{
                id: $cell.alternativeId,
                entrypoints: $cell.candidateEntrypoints
            }],
            requiredArtifacts: [{
                id: $cell.requiredArtifactId,
                path: ($cell.requiredOutputRoots[0] + "/**"),
                owner: "BUILD_OPTIMIZATION"
            }]
        }
    ' "${buildopt_spec}" >"${buildopt_target}"
}

buildopt_prepare_arm() {
    local buildopt_cell_index=$1
    local buildopt_arm=$2
    local buildopt_cell_id
    buildopt_cell_id=$(jq -er ".selectiveCells[${buildopt_cell_index}].id" "${buildopt_spec}")
    local buildopt_arm_root="${buildopt_root}/cells/${buildopt_cell_id}/${buildopt_arm}"
    mkdir -p -- "${buildopt_arm_root}/checkout" "${buildopt_arm_root}/gradle-home"
    tar -xzf "${buildopt_source_archive}" --strip-components=1 \
        -C "${buildopt_arm_root}/checkout"
    cp -a -- "${buildopt_root}/preflight-home/." "${buildopt_arm_root}/gradle-home/"
    rm -rf -- "${buildopt_arm_root}/gradle-home/daemon" \
        "${buildopt_arm_root}/gradle-home/.tmp"
    mkdir -p -- "${buildopt_arm_root}/gradle-home/init.d"
    cp -- "${buildopt_guard}" \
        "${buildopt_arm_root}/gradle-home/init.d/buildopt-poc-test-preparation.guard.init.gradle"
    buildopt_make_manifest "${buildopt_cell_index}" \
        "${buildopt_arm_root}/checkout/buildopt-impact-manifest.json"
    local buildopt_change_path
    buildopt_change_path=$(jq -er ".selectiveCells[${buildopt_cell_index}].changePath" "${buildopt_spec}")
    cp -- "${buildopt_arm_root}/checkout/${buildopt_change_path}" \
        "${buildopt_arm_root}/changed-source.original"
}

buildopt_prepare_cell() {
    local buildopt_cell_index=$1
    local buildopt_cell_id buildopt_candidate_root buildopt_pipeline buildopt_expected_graph
    buildopt_cell_id=$(jq -er ".selectiveCells[${buildopt_cell_index}].id" "${buildopt_spec}")
    buildopt_prepare_arm "${buildopt_cell_index}" control
    buildopt_prepare_arm "${buildopt_cell_index}" candidate
    buildopt_candidate_root="${buildopt_root}/cells/${buildopt_cell_id}/candidate"
    buildopt_pipeline=$(jq -er ".selectiveCells[${buildopt_cell_index}].pipelineClass" "${buildopt_spec}")
    env GRADLE_USER_HOME="${buildopt_candidate_root}/gradle-home" \
        "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
        "${buildopt_impact_executable}" generate \
        --repository "${buildopt_candidate_root}/checkout" \
        --manifest buildopt-impact-manifest.json \
        --repository-id spring-projects/spring-framework \
        --pipeline-class "${buildopt_pipeline}" \
        --graph buildopt-impact-graph.generated.json \
        --generated-manifest buildopt-impact.generated.json \
        --gradle-command ./gradlew --timeout 5m >/dev/null
    buildopt_expected_graph=$(jq -er ".selectiveCells[${buildopt_cell_index}].expectedGraphSha256" "${buildopt_spec}")
    [[ "$(sha256sum "${buildopt_candidate_root}/checkout/buildopt-impact-graph.generated.json" | awk '{print $1}')" == \
        "${buildopt_expected_graph}" ]] || {
        printf 'Spring Impact breadth %s graph drifted\n' "${buildopt_cell_id}" >&2
        exit 1
    }
    local buildopt_expected_reach buildopt_candidate_entry
    buildopt_expected_reach=$(jq -er ".selectiveCells[${buildopt_cell_index}].expectedReachedProjectCount" "${buildopt_spec}")
    buildopt_candidate_entry=$(jq -er ".selectiveCells[${buildopt_cell_index}].candidateEntrypoints[0]" "${buildopt_spec}")
    jq -e --arg entry "${buildopt_candidate_entry}" --argjson count "${buildopt_expected_reach}" '
        .complete == true and
        ([.entrypoints[] | select(.name == $entry)] | length) == 1 and
        (.entrypoints[] | select(.name == $entry) |
            (.reachesProjects | length) == $count and
            .containsTestTasks == false and
            .unknownRelationships == false)
    ' "${buildopt_candidate_root}/checkout/buildopt-impact-graph.generated.json" >/dev/null
    printf '%s\n' \
        "$(jq -er ".selectiveCells[${buildopt_cell_index}].changePath" "${buildopt_spec}")" \
        >"${buildopt_candidate_root}/checkout/.buildopt-changes"
}

buildopt_reset_arm() {
    local buildopt_cell_index=$1
    local buildopt_arm=$2
    local buildopt_mutation=$3
    local buildopt_cell_id buildopt_change_path buildopt_arm_root
    buildopt_cell_id=$(jq -er ".selectiveCells[${buildopt_cell_index}].id" "${buildopt_spec}")
    buildopt_change_path=$(jq -er ".selectiveCells[${buildopt_cell_index}].changePath" "${buildopt_spec}")
    buildopt_arm_root="${buildopt_root}/cells/${buildopt_cell_id}/${buildopt_arm}"
    cp -- "${buildopt_arm_root}/changed-source.original" \
        "${buildopt_arm_root}/checkout/${buildopt_change_path}"
    (
        cd "${buildopt_arm_root}/checkout"
        env -u CI GRADLE_USER_HOME="${buildopt_arm_root}/gradle-home" \
            "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
            ./gradlew --daemon --offline --quiet --max-workers=12 clean
    ) >"${buildopt_root}/logs/reset-${buildopt_cell_id}-${buildopt_arm}.log" 2>&1
    rm -rf -- "${buildopt_arm_root}/gradle-home/caches/build-cache-1"
    tar -C "${buildopt_arm_root}/gradle-home/caches" -xzf "${buildopt_cache_seed}"
    printf '\n// buildopt-poc-spring-breadth-%s\n' "${buildopt_mutation}" \
        >>"${buildopt_arm_root}/checkout/${buildopt_change_path}"
}

buildopt_duration_ms=0
buildopt_started_ns=0
buildopt_finished_ns=0
buildopt_max_rss_kb=0
buildopt_run_arm() {
    local buildopt_cell_index=$1
    local buildopt_arm=$2
    local buildopt_log=$3
    local buildopt_time=$4
    local buildopt_cell_id buildopt_arm_root buildopt_pipeline buildopt_alternative buildopt_changed_project
    buildopt_cell_id=$(jq -er ".selectiveCells[${buildopt_cell_index}].id" "${buildopt_spec}")
    buildopt_arm_root="${buildopt_root}/cells/${buildopt_cell_id}/${buildopt_arm}"
    buildopt_pipeline=$(jq -er ".selectiveCells[${buildopt_cell_index}].pipelineClass" "${buildopt_spec}")
    buildopt_alternative=$(jq -er ".selectiveCells[${buildopt_cell_index}].alternativeId" "${buildopt_spec}")
    buildopt_changed_project=$(jq -er ".selectiveCells[${buildopt_cell_index}].changedProject" "${buildopt_spec}")
    buildopt_started_ns=$(date +%s%N)
    if ! (
        cd "${buildopt_arm_root}/checkout"
        if [[ "${buildopt_arm}" == candidate ]]; then
            /usr/bin/time -f 'maxRssKb=%M' -o "${buildopt_time}" \
                env -u CI GRADLE_USER_HOME="${buildopt_arm_root}/gradle-home" \
                "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
                "${buildopt_executable}" impact \
                --repository-id spring-projects/spring-framework \
                --pipeline-class "${buildopt_pipeline}" \
                --changes-file .buildopt-changes \
                --gradle-option=--daemon --gradle-option=--offline \
                --gradle-option=--build-cache --gradle-option=--parallel \
                --gradle-option=--no-configuration-cache \
                --gradle-option=--console=plain --gradle-option=--max-workers=12 \
                --gradle-option=--no-scan --gradle-option=--stacktrace
        else
            /usr/bin/time -f 'maxRssKb=%M' -o "${buildopt_time}" \
                env -u CI GRADLE_USER_HOME="${buildopt_arm_root}/gradle-home" \
                "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
                ./gradlew --daemon --offline --build-cache --parallel \
                --no-configuration-cache --console=plain --max-workers=12 \
                --no-scan --stacktrace testClasses
        fi
    ) >"${buildopt_log}" 2>&1; then
        tail -n 180 "${buildopt_log}" >&2
        printf 'Spring Impact breadth %s %s arm failed\n' \
            "${buildopt_cell_id}" "${buildopt_arm}" >&2
        return 1
    fi
    buildopt_finished_ns=$(date +%s%N)
    buildopt_duration_ms=$(((buildopt_finished_ns - buildopt_started_ns) / 1000000))
    buildopt_max_rss_kb=$(awk -F= '$1 == "maxRssKb" {print $2 + 0}' "${buildopt_time}")
    grep -Fq 'BUILD SUCCESSFUL' "${buildopt_log}" || return 1
    if [[ "${buildopt_arm}" == candidate ]]; then
        grep -Fq "explicit Build Impact POC candidate ${buildopt_alternative} selected" \
            "${buildopt_log}" || return 1
    fi
    grep -Eq "^> Task ${buildopt_changed_project}:compileJava( |$)" "${buildopt_log}" || {
        printf 'Spring Impact breadth %s %s did not execute changed compileJava\n' \
            "${buildopt_cell_id}" "${buildopt_arm}" >&2
        return 1
    }
    ! grep -Fq 'forbidden root-build Gradle Test task(s):' "${buildopt_log}" || return 1
    grep -Fq '> Task :buildSrc:test UP-TO-DATE' "${buildopt_log}" || return 1
    if grep -Eq '^> Task .*:(publish|upload|release|sign)([A-Z:]|$)' "${buildopt_log}" ||
        grep -Eq 'Publishing build scan|Build scan published|https://gradle[.]com/s/' \
            "${buildopt_log}"; then
        printf 'Spring Impact breadth %s %s attempted an external action\n' \
            "${buildopt_cell_id}" "${buildopt_arm}" >&2
        return 1
    fi
}

buildopt_output_manifest() {
    local buildopt_cell_index=$1
    local buildopt_checkout=$2
    local buildopt_manifest=$3
    local buildopt_output_root buildopt_file
    buildopt_output_root=$(jq -er ".selectiveCells[${buildopt_cell_index}].requiredOutputRoots[0]" "${buildopt_spec}")
    : >"${buildopt_manifest}"
    [[ -d "${buildopt_checkout}/${buildopt_output_root}" ]] || return 1
    while IFS= read -r -d '' buildopt_file; do
        printf '%s  %s\n' "$(sha256sum "${buildopt_file}" | awk '{print $1}')" \
            "${buildopt_file#"${buildopt_checkout}/"}" >>"${buildopt_manifest}"
    done < <(find "${buildopt_checkout}/${buildopt_output_root}" -type f -print0 | sort -z)
    [[ -s "${buildopt_manifest}" ]]
}

buildopt_cell_rows="${buildopt_root}/cells.jsonl"
: >"${buildopt_cell_rows}"
for buildopt_cell_index in 0 1; do
    buildopt_cell_id=$(jq -er ".selectiveCells[${buildopt_cell_index}].id" "${buildopt_spec}")
    buildopt_prepare_cell "${buildopt_cell_index}"
    buildopt_reset_arm "${buildopt_cell_index}" control warmup
    buildopt_reset_arm "${buildopt_cell_index}" candidate warmup
    buildopt_run_arm "${buildopt_cell_index}" control \
        "${buildopt_root}/logs/${buildopt_cell_id}-warm-control.log" \
        "${buildopt_root}/logs/${buildopt_cell_id}-warm-control.time"
    buildopt_run_arm "${buildopt_cell_index}" candidate \
        "${buildopt_root}/logs/${buildopt_cell_id}-warm-candidate.log" \
        "${buildopt_root}/logs/${buildopt_cell_id}-warm-candidate.time"

    buildopt_rows="${buildopt_root}/cells/${buildopt_cell_id}/observations.jsonl"
    : >"${buildopt_rows}"
    for buildopt_pair in 1 2 3 4; do
        buildopt_reset_arm "${buildopt_cell_index}" control "pair-${buildopt_pair}"
        buildopt_reset_arm "${buildopt_cell_index}" candidate "pair-${buildopt_pair}"
        buildopt_order=CANDIDATE_FIRST
        if ((buildopt_pair % 2 == 1)); then
            buildopt_order=CONTROL_FIRST
        fi
        buildopt_control_log="${buildopt_root}/logs/${buildopt_cell_id}-pair-${buildopt_pair}-control.log"
        buildopt_candidate_log="${buildopt_root}/logs/${buildopt_cell_id}-pair-${buildopt_pair}-candidate.log"
        if [[ "${buildopt_order}" == CONTROL_FIRST ]]; then
            buildopt_run_arm "${buildopt_cell_index}" control "${buildopt_control_log}" "${buildopt_control_log}.time"
            buildopt_control_duration=${buildopt_duration_ms}
            buildopt_control_rss=${buildopt_max_rss_kb}
            buildopt_first_finished=${buildopt_finished_ns}
            buildopt_run_arm "${buildopt_cell_index}" candidate "${buildopt_candidate_log}" "${buildopt_candidate_log}.time"
            buildopt_candidate_duration=${buildopt_duration_ms}
            buildopt_candidate_rss=${buildopt_max_rss_kb}
        else
            buildopt_run_arm "${buildopt_cell_index}" candidate "${buildopt_candidate_log}" "${buildopt_candidate_log}.time"
            buildopt_candidate_duration=${buildopt_duration_ms}
            buildopt_candidate_rss=${buildopt_max_rss_kb}
            buildopt_first_finished=${buildopt_finished_ns}
            buildopt_run_arm "${buildopt_cell_index}" control "${buildopt_control_log}" "${buildopt_control_log}.time"
            buildopt_control_duration=${buildopt_duration_ms}
            buildopt_control_rss=${buildopt_max_rss_kb}
        fi
        buildopt_gap_ms=$(((buildopt_started_ns - buildopt_first_finished) / 1000000))
        buildopt_control_manifest="${buildopt_root}/cells/${buildopt_cell_id}/pair-${buildopt_pair}-control.outputs"
        buildopt_candidate_manifest="${buildopt_root}/cells/${buildopt_cell_id}/pair-${buildopt_pair}-candidate.outputs"
        buildopt_output_manifest "${buildopt_cell_index}" \
            "${buildopt_root}/cells/${buildopt_cell_id}/control/checkout" \
            "${buildopt_control_manifest}"
        buildopt_output_manifest "${buildopt_cell_index}" \
            "${buildopt_root}/cells/${buildopt_cell_id}/candidate/checkout" \
            "${buildopt_candidate_manifest}"
        cmp -s "${buildopt_control_manifest}" "${buildopt_candidate_manifest}" || {
            printf 'Spring Impact breadth %s pair %s outputs differ\n' \
                "${buildopt_cell_id}" "${buildopt_pair}" >&2
            exit 1
        }
        buildopt_output_sha=$(sha256sum "${buildopt_control_manifest}" | awk '{print $1}')
        buildopt_output_count=$(awk 'END {print NR}' "${buildopt_control_manifest}")
        jq -cn --argjson pair "${buildopt_pair}" --arg order "${buildopt_order}" \
            --argjson control "${buildopt_control_duration}" \
            --argjson candidate "${buildopt_candidate_duration}" \
            --argjson gap "${buildopt_gap_ms}" --argjson controlRss "${buildopt_control_rss}" \
            --argjson candidateRss "${buildopt_candidate_rss}" \
            --arg outputSha "${buildopt_output_sha}" --argjson outputCount "${buildopt_output_count}" '
            {
                pair: $pair,
                order: $order,
                controlDurationMs: $control,
                candidateDurationMs: $candidate,
                savedMs: ($control - $candidate),
                interArmIdleGapMs: $gap,
                controlMaximumResidentSetKb: $controlRss,
                candidateMaximumResidentSetKb: $candidateRss,
                requiredOutputSha256: $outputSha,
                requiredOutputCount: $outputCount,
                rootBuildGradleTestTasksExecuted: false,
                commonBuildLogicTestTask: ":buildSrc:test",
                commonBuildLogicTestOutcome: "UP-TO-DATE",
                productAttributableFailure: false
            }
        ' >>"${buildopt_rows}"
        printf 'Spring breadth %s pair %s: control=%sms candidate=%sms saved=%sms\n' \
            "${buildopt_cell_id}" "${buildopt_pair}" "${buildopt_control_duration}" \
            "${buildopt_candidate_duration}" "$((buildopt_control_duration - buildopt_candidate_duration))"
    done
    jq -s --argjson cellIndex "${buildopt_cell_index}" --slurpfile spec "${buildopt_spec}" '
        def bootstrap_mean($data; $sample):
            reduce range(0; 4) as $draw
                ({state: ((2654435761 * ($sample + 1)) % 4294967296), sum: 0};
                 .state = ((1664525 * .state + 1013904223) % 4294967296) |
                 .sum += $data[((.state / 1073741824) | floor)].savedMs) |
            .sum / 4;
        def bootstrap95($data):
            ([range(0; 4096) as $sample | bootstrap_mean($data; $sample)] | sort) as $r |
            [$r[102], $r[3993]];
        . as $rows |
        (($rows | map(.controlDurationMs) | add) / 4) as $controlMean |
        (($rows | map(.candidateDurationMs) | add) / 4) as $candidateMean |
        (($rows | map(.savedMs) | add) / 4) as $mean |
        (($rows | map(.savedMs) | add) / ($rows | map(.controlDurationMs) | add)) as $ratio |
        bootstrap95($rows) as $interval |
        ($rows | map(select(.savedMs > 0)) | length) as $positive |
        ($mean >= $spec[0].valueGate.minimumSavedMsPerSelectiveCell and
         $ratio >= $spec[0].valueGate.minimumReductionRatioPerSelectiveCell and
         $interval[0] > 0 and
         $positive >= $spec[0].valueGate.minimumPositivePairsPerSelectiveCell) as $qualified |
        {
            id: $spec[0].selectiveCells[$cellIndex].id,
            changeClass: $spec[0].selectiveCells[$cellIndex].changeClass,
            changePath: $spec[0].selectiveCells[$cellIndex].changePath,
            candidateEntrypoints: $spec[0].selectiveCells[$cellIndex].candidateEntrypoints,
            requiredOutputRoots: $spec[0].selectiveCells[$cellIndex].requiredOutputRoots,
            graphSha256: $spec[0].selectiveCells[$cellIndex].expectedGraphSha256,
            observations: $rows,
            result: {
                pairs: 4,
                controlMeanMs: $controlMean,
                candidateMeanMs: $candidateMean,
                meanSavedMs: $mean,
                reductionRatio: $ratio,
                interval95SavedMs: $interval,
                positivePairs: $positive,
                qualified: $qualified
            }
        }
    ' "${buildopt_rows}" >>"${buildopt_cell_rows}"
done

buildopt_fallback_root="${buildopt_root}/fallback"
mkdir -p -- "${buildopt_fallback_root}/checkout" "${buildopt_fallback_root}/gradle-home"
tar -xzf "${buildopt_source_archive}" --strip-components=1 -C "${buildopt_fallback_root}/checkout"
cp -a -- "${buildopt_root}/preflight-home/." "${buildopt_fallback_root}/gradle-home/"
rm -rf -- "${buildopt_fallback_root}/gradle-home/daemon" "${buildopt_fallback_root}/gradle-home/.tmp"
mkdir -p -- "${buildopt_fallback_root}/gradle-home/init.d"
cp -- "${buildopt_guard}" \
    "${buildopt_fallback_root}/gradle-home/init.d/buildopt-poc-test-preparation.guard.init.gradle"
buildopt_make_manifest 0 "${buildopt_fallback_root}/checkout/buildopt-impact-manifest.json"
env GRADLE_USER_HOME="${buildopt_fallback_root}/gradle-home" \
    "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
    "${buildopt_impact_executable}" generate \
    --repository "${buildopt_fallback_root}/checkout" \
    --manifest buildopt-impact-manifest.json \
    --repository-id spring-projects/spring-framework \
    --pipeline-class poc-spring-breadth-webmvc \
    --graph buildopt-impact-graph.generated.json \
    --generated-manifest buildopt-impact.generated.json \
    --gradle-command ./gradlew --timeout 5m >/dev/null
(
    cd "${buildopt_fallback_root}/checkout"
    env -u CI GRADLE_USER_HOME="${buildopt_fallback_root}/gradle-home" \
        "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
        ./gradlew --daemon --offline --quiet --max-workers=12 clean
) >"${buildopt_root}/logs/fallback-reset.log" 2>&1
rm -rf -- "${buildopt_fallback_root}/gradle-home/caches/build-cache-1"
tar -C "${buildopt_fallback_root}/gradle-home/caches" -xzf "${buildopt_cache_seed}"
printf '\n# buildopt-poc-global-fallback\n' >>"${buildopt_fallback_root}/checkout/gradle.properties"
printf 'gradle.properties\n' >"${buildopt_fallback_root}/checkout/.buildopt-changes"
buildopt_fallback_log="${buildopt_root}/logs/fallback.log"
if ! (
    cd "${buildopt_fallback_root}/checkout"
    env -u CI GRADLE_USER_HOME="${buildopt_fallback_root}/gradle-home" \
        "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
        "${buildopt_executable}" impact \
        --repository-id spring-projects/spring-framework \
        --pipeline-class poc-spring-breadth-webmvc \
        --changes-file .buildopt-changes \
        --gradle-option=--daemon --gradle-option=--offline \
        --gradle-option=--build-cache --gradle-option=--parallel \
        --gradle-option=--no-configuration-cache --gradle-option=--console=plain \
        --gradle-option=--max-workers=12 --gradle-option=--no-scan \
        --gradle-option=--stacktrace
) >"${buildopt_fallback_log}" 2>&1; then
    tail -n 180 "${buildopt_fallback_log}" >&2
    printf 'Spring Impact global fallback failed\n' >&2
    exit 1
fi
grep -Fq 'BuildOpt POC retained the full graph (IMPACT_GLOBAL_CHANGE)' \
    "${buildopt_fallback_log}" || {
    printf 'Spring Impact global change did not retain the full graph\n' >&2
    exit 1
}
grep -Eq '^> Task :spring-jms:compileJava( |$)' "${buildopt_fallback_log}" || {
    printf 'Spring Impact global fallback did not execute a project outside webmvc scope\n' >&2
    exit 1
}
grep -Fq 'BUILD SUCCESSFUL' "${buildopt_fallback_log}" || exit 1
! grep -Fq 'forbidden root-build Gradle Test task(s):' "${buildopt_fallback_log}" || exit 1

jq -s --arg capturedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg revision "${buildopt_revision}" --arg executableSha "${buildopt_executable_sha}" \
    --arg packageSha "${buildopt_package_sha}" --arg specSha "${buildopt_spec_sha}" \
    --arg runnerSha "${buildopt_runner_sha}" --arg guardSha "${buildopt_guard_sha}" \
    --arg cacheSeedSha "${buildopt_cache_seed_sha}" \
    --argjson preflightMs "$(((buildopt_preflight_finished - buildopt_preflight_started) / 1000000))" \
    --slurpfile spec "${buildopt_spec}" '
    . as $cells |
    ($cells | map(select(.result.qualified)) | length) as $qualified |
    {
        schemaVersion: "buildopt.evidence/poc-spring-impact-breadth/v1",
        workItem: "POC-SPRING-IMPACT-BREADTH-001",
        capturedAt: $capturedAt,
        specSha256: $specSha,
        buildopt: {
            revision: $revision,
            executableSha256: $executableSha,
            packageSha256: $packageSha,
            packageVersion: "0.3.0-dev",
            runnerScriptSha256: $runnerSha,
            testGuardScriptSha256: $guardSha,
            launcherOverheadIncluded: true
        },
        repository: {
            nameWithOwner: $spec[0].repository.nameWithOwner,
            revision: $spec[0].repository.revision,
            sourceArchiveSha256: $spec[0].repository.sourceArchiveSha256
        },
        runner: $spec[0].runner,
        preparation: {
            onlinePreflightMeasured: false,
            onlinePreflightSuccess: true,
            onlinePreflightWallClockMs: $preflightMs,
            measuredNetwork: "DISCONNECTED",
            dependencyMode: "GRADLE_OFFLINE",
            buildCacheSeedSha256: $cacheSeedSha,
            preflightDaemonStoppedBeforeArmSetup: true,
            cacheSeedRestoredBeforeEveryArm: true,
            outputsRemovedBeforeEveryArm: true,
            fixedMutationAppliedAfterCacheRestore: true
        },
        selectiveCells: $cells,
        fallbackCell: {
            id: $spec[0].fallbackCell.id,
            changePath: $spec[0].fallbackCell.changePath,
            mode: "FULL_GRAPH",
            reason: "IMPACT_GLOBAL_CHANGE",
            entrypoints: ["testClasses"],
            outsideSelectiveScopeTaskObserved: ":spring-jms:compileJava",
            buildSuccessful: true,
            performanceClaim: false
        },
        result: {
            qualifiedSelectiveCells: $qualified,
            fallbackPassed: true,
            decision: (if $qualified == 2 then
                $spec[0].terminalDecisions.allSelectiveCellsQualifyAndFallbackPasses
                else $spec[0].terminalDecisions.anySelectiveCellFailsOrFallbackFails end)
        },
        boundaries: $spec[0].boundaries
    }
' "${buildopt_cell_rows}" >"${buildopt_output}"

printf 'Spring Impact breadth evidence written: %s\n' "${buildopt_output}"
