#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)); then
    printf 'usage: %s OUTPUT_FILE\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-optimization-overhead-ablation-v1.json"

if [[ "${buildopt_output}" != /* || -e "${buildopt_output}" ]]; then
    printf 'invalid optimization-overhead ablation output path\n' >&2
    exit 64
fi
for buildopt_command in awk cmp cp curl date find git grep jq mkdir mktemp \
    sed sha256sum sort stat tar wc; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required optimization-overhead command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
[[ -x /usr/bin/time ]] || {
    printf 'required optimization-overhead command is unavailable: /usr/bin/time\n' >&2
    exit 1
}
if [[ -n "$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)" ]]; then
    printf 'optimization-overhead measurement requires a clean revision-bound checkout\n' >&2
    exit 1
fi
"${buildopt_script_dir}/check-poc-optimization-overhead-ablation" >/dev/null

buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-optimization-overhead.XXXXXX")
buildopt_stop_gradle() {
    local buildopt_checkout=$1
    local buildopt_home=$2
    if [[ -x "${buildopt_checkout}/gradlew" && -d "${buildopt_home}" ]]; then
        (
            cd "${buildopt_checkout}"
            env GRADLE_USER_HOME="${buildopt_home}" \
                "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
                ./gradlew --stop
        ) >/dev/null 2>&1 || true
    fi
}
buildopt_cleanup() {
    if [[ "${buildopt_root}" == "${TMPDIR:-/tmp}/buildopt-optimization-overhead."* ]]; then
        buildopt_stop_gradle "${buildopt_root}/source" "${buildopt_root}/preflight-home"
        for buildopt_arm in control init-only adapter; do
            buildopt_stop_gradle "${buildopt_root}/${buildopt_arm}/checkout" \
                "${buildopt_root}/${buildopt_arm}/gradle-home"
        done
        rm -rf -- "${buildopt_root}"
    fi
}
trap buildopt_cleanup EXIT
chmod 0700 "${buildopt_root}"
mkdir -p -- "${buildopt_root}/source" "${buildopt_root}/preflight-home" \
    "${buildopt_root}/logs" "${buildopt_root}/product"
chmod 0700 "${buildopt_root}/preflight-home"

buildopt_revision=$(git -C "${buildopt_repo_root}" rev-parse HEAD)
buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_runner_sha=$(sha256sum "${BASH_SOURCE[0]}" | awk '{print $1}')
(
    cd "${buildopt_repo_root}"
    env GOCACHE="${buildopt_root}/go-cache" \
        "${buildopt_script_dir}/run" --toolchain go -- \
        go build -trimpath -o "${buildopt_root}/product/buildopt" ./cmd/buildopt
    "${buildopt_script_dir}/run" -- ./gradlew --no-daemon \
        :jvm:gradle-plugin:clean :jvm:gradle-plugin:jar >/dev/null
)
buildopt_executable_sha=$(sha256sum "${buildopt_root}/product/buildopt" | awk '{print $1}')
buildopt_plugin_jar=$(find "${buildopt_repo_root}/jvm/gradle-plugin/build/libs" \
    -maxdepth 1 -type f -name 'buildopt-gradle-plugin-*.jar' -print)
[[ -n "${buildopt_plugin_jar}" && "$(printf '%s\n' "${buildopt_plugin_jar}" | wc -l)" == 1 ]] || {
    printf 'expected exactly one BuildOpt Gradle plugin JAR\n' >&2
    exit 1
}
buildopt_plugin_sha=$(sha256sum "${buildopt_plugin_jar}" | awk '{print $1}')
buildopt_init_script="${buildopt_repo_root}/.github/actions/buildopt.init.gradle"
buildopt_init_sha=$(sha256sum "${buildopt_init_script}" | awk '{print $1}')

buildopt_source_archive="${buildopt_root}/spring-framework.tar.gz"
buildopt_source_url=$(jq -er '.repository.sourceArchiveUrl' "${buildopt_spec}")
buildopt_source_sha=$(jq -er '.repository.sourceArchiveSha256' "${buildopt_spec}")
curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
    --output "${buildopt_source_archive}" "${buildopt_source_url}"
[[ "$(sha256sum "${buildopt_source_archive}" | awk '{print $1}')" == \
    "${buildopt_source_sha}" ]] || {
    printf 'Spring source archive checksum mismatch\n' >&2
    exit 1
}
tar -xzf "${buildopt_source_archive}" --strip-components=1 -C "${buildopt_root}/source"

buildopt_common_args=(
    --daemon --build-cache --parallel --no-configuration-cache
    --max-workers=12 --no-scan --stacktrace --console=plain
    :spring-jms:test --rerun --tests org.springframework.jms.support.JmsAccessorTests
)
buildopt_preflight_started=$(date +%s%N)
if ! (
    cd "${buildopt_root}/source"
    env -u CI GRADLE_USER_HOME="${buildopt_root}/preflight-home" \
        "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
        ./gradlew "${buildopt_common_args[@]}"
) >"${buildopt_root}/logs/preflight.log" 2>&1; then
    tail -n 180 "${buildopt_root}/logs/preflight.log" >&2
    printf 'optimization-overhead preflight failed\n' >&2
    exit 1
fi
buildopt_preflight_finished=$(date +%s%N)
grep -Fq 'BUILD SUCCESSFUL' "${buildopt_root}/logs/preflight.log" || {
    printf 'optimization-overhead preflight lacks success marker\n' >&2
    exit 1
}
buildopt_stop_gradle "${buildopt_root}/source" "${buildopt_root}/preflight-home"

for buildopt_arm in control init-only adapter; do
    buildopt_checkout="${buildopt_root}/${buildopt_arm}/checkout"
    buildopt_home="${buildopt_root}/${buildopt_arm}/gradle-home"
    mkdir -p -- "${buildopt_checkout}" "${buildopt_home}"
    tar -xzf "${buildopt_source_archive}" --strip-components=1 -C "${buildopt_checkout}"
    cp -a -- "${buildopt_root}/preflight-home/." "${buildopt_home}/"
    rm -rf -- "${buildopt_home}/daemon" "${buildopt_home}/.tmp"
done

buildopt_duration_ms=0
buildopt_started_ns=0
buildopt_finished_ns=0
buildopt_tests=0
buildopt_failures=0
buildopt_errors=0
buildopt_skipped=0
buildopt_jar_hits=0
buildopt_jar_executes=0
buildopt_run_arm() {
    local buildopt_arm=$1
    local buildopt_log=$2
    local buildopt_checkout="${buildopt_root}/${buildopt_arm}/checkout"
    local buildopt_home="${buildopt_root}/${buildopt_arm}/gradle-home"
    (
        cd "${buildopt_checkout}"
        env -u CI GRADLE_USER_HOME="${buildopt_home}" \
            "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
            ./gradlew --daemon --offline --quiet --max-workers=12 \
            clean :spring-core:clean :spring-instrument:clean \
            :spring-beans:clean :spring-aop:clean :spring-context:clean \
            :spring-expression:clean :spring-oxm:clean :spring-tx:clean \
            :spring-messaging:clean :spring-jms:clean
    ) >"${buildopt_log}.clean" 2>&1

    local -a buildopt_command=(./gradlew --offline "${buildopt_common_args[@]}")
    local -a buildopt_environment=(
        env -u CI GRADLE_USER_HOME="${buildopt_home}"
        BUILDOPT_GRADLE_INIT_SCRIPT="${buildopt_init_script}"
        BUILDOPT_GRADLE_PLUGIN_JAR="${buildopt_plugin_jar}"
    )
    if [[ "${buildopt_arm}" == init-only ]]; then
        buildopt_environment+=(BUILDOPT_GRADLE_PROJECT_PLUGIN_MODE=CACHE_ONLY)
        buildopt_command=(./gradlew --init-script "${buildopt_init_script}" --offline "${buildopt_common_args[@]}")
    elif [[ "${buildopt_arm}" == adapter ]]; then
        buildopt_command=(
            "${buildopt_root}/product/buildopt" gradle
            --cache-standard-jar-producers -- --offline "${buildopt_common_args[@]}"
        )
    fi

    buildopt_started_ns=$(date +%s%N)
    if ! (
        cd "${buildopt_checkout}"
        /usr/bin/time -f 'maxRssKb=%M' -o "${buildopt_log}.time" \
            "${buildopt_environment[@]}" \
            "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
            "${buildopt_command[@]}"
    ) >"${buildopt_log}" 2>&1; then
        tail -n 180 "${buildopt_log}" >&2
        printf 'optimization-overhead %s arm failed\n' "${buildopt_arm}" >&2
        return 1
    fi
    buildopt_finished_ns=$(date +%s%N)
    buildopt_duration_ms=$(((buildopt_finished_ns - buildopt_started_ns) / 1000000))
    grep -Fq 'BUILD SUCCESSFUL' "${buildopt_log}" || return 1
    grep -Eq '^> Task :spring-jms:test$' "${buildopt_log}" || return 1
    local buildopt_xml="${buildopt_checkout}/spring-jms/build/test-results/test/TEST-org.springframework.jms.support.JmsAccessorTests.xml"
    [[ -s "${buildopt_xml}" ]] || return 1
    buildopt_tests=$(sed -n 's/.*tests="\([0-9][0-9]*\)".*/\1/p' "${buildopt_xml}" | head -1)
    buildopt_skipped=$(sed -n 's/.*skipped="\([0-9][0-9]*\)".*/\1/p' "${buildopt_xml}" | head -1)
    buildopt_failures=$(sed -n 's/.*failures="\([0-9][0-9]*\)".*/\1/p' "${buildopt_xml}" | head -1)
    buildopt_errors=$(sed -n 's/.*errors="\([0-9][0-9]*\)".*/\1/p' "${buildopt_xml}" | head -1)
    [[ "${buildopt_tests}" == 8 && "${buildopt_skipped}" == 0 && \
        "${buildopt_failures}" == 0 && "${buildopt_errors}" == 0 ]] || return 1
    buildopt_jar_hits=$(grep -Ec '^> Task :[^ ]+:testFixturesJar FROM-CACHE$' "${buildopt_log}" || true)
    buildopt_jar_executes=$(grep -Ec '^> Task :[^ ]+:testFixturesJar$' "${buildopt_log}" || true)
}

buildopt_jar_manifest() {
    local buildopt_arm=$1
    local buildopt_manifest=$2
    local buildopt_checkout="${buildopt_root}/${buildopt_arm}/checkout"
    local buildopt_file
    : >"${buildopt_manifest}"
    while IFS= read -r -d '' buildopt_file; do
        printf '%s  %s  %s\n' \
            "$(sha256sum "${buildopt_file}" | awk '{print $1}')" \
            "$(stat -c '%s' "${buildopt_file}")" \
            "${buildopt_file#"${buildopt_checkout}/"}" >>"${buildopt_manifest}"
    done < <(find "${buildopt_checkout}" -path '*/build/libs/*.jar' -type f -print0 | sort -z)
    [[ -s "${buildopt_manifest}" ]]
}

buildopt_testcase_manifest() {
    local buildopt_arm=$1
    local buildopt_manifest=$2
    local buildopt_xml="${buildopt_root}/${buildopt_arm}/checkout/spring-jms/build/test-results/test/TEST-org.springframework.jms.support.JmsAccessorTests.xml"
    sed -n 's/.*<testcase name="\([^"]*\)" classname="\([^"]*\)".*/\2\t\1/p' \
        "${buildopt_xml}" | sort >"${buildopt_manifest}"
    [[ "$(wc -l <"${buildopt_manifest}")" == 8 ]]
}

for buildopt_arm in control init-only adapter; do
    buildopt_run_arm "${buildopt_arm}" "${buildopt_root}/logs/warm-${buildopt_arm}.log"
done

buildopt_rows="${buildopt_root}/observations.jsonl"
: >"${buildopt_rows}"
for buildopt_round in {1..4}; do
    mapfile -t buildopt_order < <(jq -r ".measurement.roundOrders[$((buildopt_round - 1))][]" "${buildopt_spec}")
    buildopt_previous_finished=0
    buildopt_maximum_gap=0
    buildopt_control_duration=0
    buildopt_init_duration=0
    buildopt_adapter_duration=0
    buildopt_control_executes=0
    buildopt_init_executes=0
    buildopt_adapter_hits=0
    for buildopt_label in "${buildopt_order[@]}"; do
        case "${buildopt_label}" in
            CONTROL) buildopt_arm=control ;;
            INIT_ONLY) buildopt_arm=init-only ;;
            ADAPTER) buildopt_arm=adapter ;;
            *) printf 'unknown optimization-overhead arm: %s\n' "${buildopt_label}" >&2; exit 1 ;;
        esac
        buildopt_run_arm "${buildopt_arm}" \
            "${buildopt_root}/logs/round-${buildopt_round}-${buildopt_arm}.log"
        if ((buildopt_previous_finished > 0)); then
            buildopt_gap=$(((buildopt_started_ns - buildopt_previous_finished) / 1000000))
            ((buildopt_gap > buildopt_maximum_gap)) && buildopt_maximum_gap=${buildopt_gap}
        fi
        buildopt_previous_finished=${buildopt_finished_ns}
        case "${buildopt_arm}" in
            control)
                buildopt_control_duration=${buildopt_duration_ms}
                buildopt_control_executes=${buildopt_jar_executes}
                ;;
            init-only)
                buildopt_init_duration=${buildopt_duration_ms}
                buildopt_init_executes=${buildopt_jar_executes}
                ;;
            adapter)
                buildopt_adapter_duration=${buildopt_duration_ms}
                buildopt_adapter_hits=${buildopt_jar_hits}
                ;;
        esac
    done
    ((buildopt_maximum_gap <= 10000)) || {
        printf 'optimization-overhead round %s exceeded inter-arm gap: %s ms\n' \
            "${buildopt_round}" "${buildopt_maximum_gap}" >&2
        exit 1
    }
    for buildopt_arm in control init-only adapter; do
        buildopt_jar_manifest "${buildopt_arm}" \
            "${buildopt_root}/${buildopt_arm}-${buildopt_round}.jars"
        buildopt_testcase_manifest "${buildopt_arm}" \
            "${buildopt_root}/${buildopt_arm}-${buildopt_round}.tests"
    done
    cmp -s "${buildopt_root}/control-${buildopt_round}.jars" \
        "${buildopt_root}/init-only-${buildopt_round}.jars" || exit 1
    cmp -s "${buildopt_root}/control-${buildopt_round}.jars" \
        "${buildopt_root}/adapter-${buildopt_round}.jars" || exit 1
    cmp -s "${buildopt_root}/control-${buildopt_round}.tests" \
        "${buildopt_root}/init-only-${buildopt_round}.tests" || exit 1
    cmp -s "${buildopt_root}/control-${buildopt_round}.tests" \
        "${buildopt_root}/adapter-${buildopt_round}.tests" || exit 1
    ((buildopt_adapter_hits > 0 && buildopt_control_executes > 0 && buildopt_init_executes > 0)) || exit 1
    buildopt_jar_manifest="${buildopt_root}/control-${buildopt_round}.jars"
    buildopt_jar_total_bytes=$(awk '{sum += $2} END {print sum + 0}' "${buildopt_jar_manifest}")
    buildopt_order_json=$(printf '%s\n' "${buildopt_order[@]}" | jq -R . | jq -s .)
    jq -cn --argjson round "${buildopt_round}" --argjson order "${buildopt_order_json}" \
        --argjson control "${buildopt_control_duration}" \
        --argjson initOnly "${buildopt_init_duration}" \
        --argjson adapter "${buildopt_adapter_duration}" \
        --argjson maximumGap "${buildopt_maximum_gap}" \
        --argjson adapterHits "${buildopt_adapter_hits}" \
        --argjson controlExecutes "${buildopt_control_executes}" \
        --argjson initExecutes "${buildopt_init_executes}" \
        --arg jarSha "$(sha256sum "${buildopt_jar_manifest}" | awk '{print $1}')" \
        --argjson jarCount "$(wc -l <"${buildopt_jar_manifest}")" \
        --argjson jarBytes "${buildopt_jar_total_bytes}" \
        --arg testSha "$(sha256sum "${buildopt_root}/control-${buildopt_round}.tests" | awk '{print $1}')" '
        {
            round: $round, order: $order,
            controlDurationMs: $control,
            initOnlyDurationMs: $initOnly,
            adapterDurationMs: $adapter,
            initOnlyOverheadVsControlMs: ($initOnly - $control),
            adapterIncrementalVsInitOnlyMs: ($adapter - $initOnly),
            adapterSavedVsControlMs: ($control - $adapter),
            maximumInterArmIdleGapMs: $maximumGap,
            tests: 8, failures: 0, errors: 0, skipped: 0,
            adapterStandardJarFromCacheCount: $adapterHits,
            controlStandardJarExecutedCount: $controlExecutes,
            initOnlyStandardJarExecutedCount: $initExecutes,
            requiredJarOutputSha256: $jarSha,
            requiredJarOutputCount: $jarCount,
            requiredJarTotalBytes: $jarBytes,
            testCaseSetSha256: $testSha,
            outputsIdentical: true,
            testCasesIdentical: true,
            productAttributableFailure: false
        }' >>"${buildopt_rows}"
    printf 'Overhead round %s/4: native=%sms init=%sms adapter=%sms adapterSaved=%sms order=%s\n' \
        "${buildopt_round}" "${buildopt_control_duration}" "${buildopt_init_duration}" \
        "${buildopt_adapter_duration}" "$((buildopt_control_duration - buildopt_adapter_duration))" \
        "$(IFS=,; printf '%s' "${buildopt_order[*]}")"
done

jq -s '.' "${buildopt_rows}" >"${buildopt_root}/observations.json"
jq -n --arg capturedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg revision "${buildopt_revision}" --arg executableSha "${buildopt_executable_sha}" \
    --arg pluginSha "${buildopt_plugin_sha}" --arg initSha "${buildopt_init_sha}" \
    --arg runnerSha "${buildopt_runner_sha}" --arg specSha "${buildopt_spec_sha}" \
    --arg sourceSha "${buildopt_source_sha}" \
    --argjson preflightMs "$(((buildopt_preflight_finished - buildopt_preflight_started) / 1000000))" \
    --slurpfile spec "${buildopt_spec}" --slurpfile rows "${buildopt_root}/observations.json" '
    def bootstrap_mean($data; $sample):
        reduce range(0; 4) as $draw
            ({state: ((2654435761 * ($sample + 1)) % 4294967296), sum: 0};
             .state = ((1664525 * .state + 1013904223) % 4294967296) |
             .sum += $data[((.state / 1073741824) | floor)].adapterSavedVsControlMs) |
        .sum / 4;
    def bootstrap95($data):
        ([range(0; 4096) as $sample | bootstrap_mean($data; $sample)] | sort) as $r |
        [$r[102], $r[3993]];
    $rows[0] as $data |
    (($data | map(.controlDurationMs) | add) / 4) as $controlMean |
    (($data | map(.initOnlyDurationMs) | add) / 4) as $initMean |
    (($data | map(.adapterDurationMs) | add) / 4) as $adapterMean |
    ($controlMean - $adapterMean) as $saved |
    ($data | map(.controlDurationMs) | add) as $controlSum |
    ($data | map(.adapterDurationMs) | add) as $adapterSum |
    (($controlSum - $adapterSum) / $controlSum) as $ratio |
    bootstrap95($data) as $interval |
    ($data | map(select(.adapterSavedVsControlMs > 0)) | length) as $positive |
    ($saved >= $spec[0].valueGate.minimumSavedMs and
     $ratio >= $spec[0].valueGate.minimumReductionRatio and
     $interval[0] > 0 and $positive == $spec[0].valueGate.minimumPositiveRounds) as $qualified |
    {
        schemaVersion: "buildopt.evidence/poc-optimization-overhead-ablation/v1",
        workItem: "POC-OPTIMIZATION-OVERHEAD-ABLATION-001",
        capturedAt: $capturedAt,
        buildopt: {
            revision: $revision,
            executableSha256: $executableSha,
            pluginJarSha256: $pluginSha,
            initScriptSha256: $initSha,
            runnerScriptSha256: $runnerSha
        },
        specSha256: $specSha,
        repository: {
            nameWithOwner: $spec[0].repository.nameWithOwner,
            revision: $spec[0].repository.revision,
            sourceArchiveSha256: $sourceSha
        },
        runner: $spec[0].runner,
        workflow: $spec[0].workflow,
        preparation: {
            onlinePreflightMeasured: false,
            onlinePreflightSuccess: true,
            onlinePreflightWallClockMs: $preflightMs,
            measuredNetwork: "DISCONNECTED",
            dependencyMode: "GRADLE_OFFLINE",
            sameDependencyAndNativeCacheSeedRestoredBeforeArmSetup: true,
            outputsRemovedBeforeEveryArm: true,
            warmupsPerArm: 1
        },
        observations: $data,
        result: {
            rounds: 4,
            controlMeanMs: $controlMean,
            initOnlyMeanMs: $initMean,
            adapterMeanMs: $adapterMean,
            meanInitOnlyOverheadMs: ($initMean - $controlMean),
            meanAdapterIncrementalVsInitOnlyMs: ($adapterMean - $initMean),
            meanAdapterSavedVsControlMs: $saved,
            reductionRatio: $ratio,
            interval95SavedMs: $interval,
            positiveRounds: $positive,
            qualified: $qualified,
            decision: (if $qualified then
                "QUALIFIED_VALUE_AWARE_STANDARD_JAR_REUSE"
                else "KEEP_NATIVE_FOR_UNQUALIFIED_STANDARD_JAR_WORKFLOW" end)
        },
        boundaries: $spec[0].boundaries
    }
' >"${buildopt_output}"

"${buildopt_script_dir}/check-poc-optimization-overhead-ablation" "${buildopt_output}" >/dev/null
printf 'POC optimization-overhead ablation evidence written: %s\n' "${buildopt_output}"
