#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_source="${buildopt_root}/specs/poc-magic-calibration-v1.json"
buildopt_temp=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-magic-calibration-contract.XXXXXX")
trap 'rm -f -- "${buildopt_temp}/contract.json"; rmdir -- "${buildopt_temp}"' EXIT

"${buildopt_script_dir}/check-magic-calibration-contract" \
    "${buildopt_source}" >/dev/null

for buildopt_filter in \
    '.budget.qualificationPairs = 4' \
    '.qualification.minimumMeanSavedMs = 0' \
    '.qualification.minimumPositivePairs = 6' \
    '.qualification.candidateP95NonRegressive = false' \
    '.checkpoint.evidenceDigestRequired = false' \
    '.authority.profileMaterialized = true' \
    '.authority.productionAuthorized = true'; do
    jq "${buildopt_filter}" "${buildopt_source}" >"${buildopt_temp}/contract.json"
    if "${buildopt_script_dir}/check-magic-calibration-contract" \
        "${buildopt_temp}/contract.json" >/dev/null 2>&1; then
        printf 'automatic-calibration checker accepted forbidden mutation: %s\n' \
            "${buildopt_filter}" >&2
        exit 1
    fi
done

printf 'Magic automatic-calibration contract negative fixtures OK\n'
