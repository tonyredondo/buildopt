#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [--static]\n' "$0" >&2
    exit 64
fi

buildopt_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
buildopt_evidence=${buildopt_root}/benchmarks/results/request-aligned-producer-fixtures-v1.json
buildopt_mode=${1:-dynamic}
case ${buildopt_mode} in
    dynamic | --static) ;;
    *)
        printf 'usage: %s [--static]\n' "$0" >&2
        exit 64
        ;;
esac
for buildopt_command in cmp jq mktemp sha256sum; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf '%s is required\n' "${buildopt_command}" >&2
        exit 1
    }
done

buildopt_expected_producer=$(sha256sum "${buildopt_root}/dev/request-aligned-producer.init.gradle" | awk '{print $1}')
buildopt_expected_implementation=$(sha256sum "${buildopt_root}/internal/requestaligned/observation.go" | awk '{print $1}')
jq -e \
    --arg producer "${buildopt_expected_producer}" \
    --arg implementation "${buildopt_expected_implementation}" '
  .schemaVersion=="buildopt.evidence/request-aligned-producer-fixtures/v1" and
  .workItem=="SWL-REQUEST-001" and .status=="COMPLETE" and
  .producerSha256==$producer and .implementationSha256==$implementation and
  .coverage==["checkout-path","argument-vector","requested-tasks","Gradle-version","Wrapper","JDK","environment","build-logic","task-graph","current-versioned-output","ambiguous-producer","missing-output","outside-graph"] and
  (.results|length)==4 and
  ([.results[].gradleVersion]|unique)==["8.14.3","9.6.1"] and
  ([.results[].dsl]|unique)==["GROOVY","KOTLIN"] and
  all(.results[];
    .status=="COMPLETE" and .checkoutPathIndependent and
    .requestIdentitySha256==.relocatedRequestIdentitySha256 and
    (.requestIdentitySha256|test("^[0-9a-f]{64}$")) and
    .compatibilityDimensionsChanged==["GRADLE_ARGUMENT_VECTOR","REQUESTED_TASKS","GRADLE_VERSION","WRAPPER","JDK","ENVIRONMENT","BUILD_LOGIC","TASK_GRAPH"] and
    .currentJar.producerTask==":jar" and
    .currentJar.path=="build/libs/groovy-raw-6.0.0-SNAPSHOT-raw.jar" and
    (.currentJar.sha256|test("^[0-9a-f]{64}$")) and .currentOutputCount>0 and
    .negatives==[
      {name:"ambiguous-producer",status:"UNAVAILABLE",reason:"CURRENT_OUTPUT_PRODUCER_AMBIGUOUS"},
      {name:"missing-output",status:"UNAVAILABLE",reason:"CURRENT_PRODUCER_OUTPUTS_EMPTY"},
      {name:"outside-graph",status:"UNAVAILABLE",reason:"REQUESTED_TASK_UNAVAILABLE"}
    ] and
    (.performanceMeasured|not) and (.activationAuthorized|not)
  ) and
  (.performanceMeasured|not) and (.activationAuthorized|not) and
  .outcome=="REQUEST_IDENTITY_AND_CURRENT_OUTPUT_PRODUCER_COMPLETE"
' "${buildopt_evidence}" >/dev/null || {
    printf 'request-aligned producer fixture contract is invalid\n' >&2
    exit 1
}

if [[ ${buildopt_mode} == --static ]]; then
    printf 'Request-aligned producer fixtures: PASS (static)\n'
    exit 0
fi

buildopt_temporary=$(mktemp /tmp/buildopt-request-aligned-producer.XXXXXX.json)
buildopt_cleanup() {
    case ${buildopt_temporary} in
        /tmp/buildopt-request-aligned-producer.*.json)
            rm -f -- "${buildopt_temporary}"
            ;;
        *)
            printf 'refusing to clean unexpected producer output: %s\n' "${buildopt_temporary}" >&2
            return 1
            ;;
    esac
}
trap buildopt_cleanup EXIT
"${buildopt_root}/dev/run-request-aligned-producer-fixtures" "${buildopt_temporary}"
cmp -s "${buildopt_evidence}" "${buildopt_temporary}" || {
    printf 'request-aligned producer fixture evidence is stale\n' >&2
    diff -u "${buildopt_evidence}" "${buildopt_temporary}" >&2 || true
    exit 1
}

printf 'Request-aligned producer fixtures: PASS\n'
