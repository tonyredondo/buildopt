#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_root=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
buildopt_temp=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-magic-calibration.XXXXXX")
buildopt_cleanup() {
    if [[ ${buildopt_temp} == "${TMPDIR:-/tmp}/buildopt-magic-calibration."* ]]; then
        rm -rf -- "${buildopt_temp}"
    fi
}
trap buildopt_cleanup EXIT

for buildopt_command in git jq; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required automatic-calibration command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done

buildopt_binary="${buildopt_temp}/buildopt"
buildopt_gradle_home="${buildopt_root}/.tools/gradle-user-home/local"
"${buildopt_root}/dev/run" --toolchain go -- \
    go build -trimpath -o "${buildopt_binary}" ./cmd/buildopt

buildopt_repository="${buildopt_temp}/repository"
mkdir -p -- "${buildopt_repository}"
cp -R -- "${buildopt_root}/fixtures/gradle-workflow-breadth/." \
    "${buildopt_repository}/"
cp -- "${buildopt_root}/gradlew" "${buildopt_repository}/gradlew"
cp -R -- "${buildopt_root}/gradle" "${buildopt_repository}/gradle"
chmod +x -- "${buildopt_repository}/gradlew"
printf '.buildopt/\n**/build/\n' >"${buildopt_repository}/.gitignore"
sed -i 's/service-a-target/service-a-base/' \
    "${buildopt_repository}/service-a/src/main/java/example/Application.java"
printf '%s\n' \
    '' \
    "project(':service-b') {" \
    "    tasks.register('calibrationWork') {" \
    '        outputs.upToDateWhen { false }' \
    '        doLast { Thread.sleep(1300) }' \
    '    }' \
    "    tasks.named('jar') { dependsOn tasks.named('calibrationWork') }" \
    '}' >>"${buildopt_repository}/build.gradle"

git -C "${buildopt_repository}" init -qb main
git -C "${buildopt_repository}" config user.name 'BuildOpt Fixture'
git -C "${buildopt_repository}" config user.email buildopt-fixture@example.invalid
git -C "${buildopt_repository}" config commit.gpgsign false
git -C "${buildopt_repository}" add .
git -C "${buildopt_repository}" commit -qm 'automatic calibration base'
git -C "${buildopt_repository}" switch -qc feature
git -C "${buildopt_repository}" config branch.feature.remote .
git -C "${buildopt_repository}" config branch.feature.merge refs/heads/main
sed -i 's/service-a-base/service-a-target/' \
    "${buildopt_repository}/service-a/src/main/java/example/Application.java"
git -C "${buildopt_repository}" add \
    service-a/src/main/java/example/Application.java
git -C "${buildopt_repository}" commit -qm 'automatic calibration target'

buildopt_run() {
    local buildopt_state=$1
    local buildopt_pairs=$2
    local buildopt_attempt=$3
    local buildopt_stdout="${buildopt_temp}/${buildopt_state}-${buildopt_attempt}.json"
    local buildopt_stderr="${buildopt_temp}/${buildopt_state}-${buildopt_attempt}.log"
    (
        cd -- "${buildopt_repository}"
        env -u BUILDOPT_BYPASS \
            -u GITHUB_EVENT_PATH -u GITHUB_REPOSITORY \
            -u CI_MERGE_REQUEST_DIFF_BASE_SHA -u CI_COMMIT_BEFORE_SHA \
            -u CI_PROJECT_PATH \
            GRADLE_USER_HOME="${buildopt_gradle_home}" \
            "${buildopt_binary}" optimize --json \
            --state-dir ".buildopt/optimize/${buildopt_state}" \
            --calibration-budget 5m \
            --calibration-pairs "${buildopt_pairs}" \
            --max-break-even-builds 100 \
            jar --offline \
            >"${buildopt_stdout}" 2>"${buildopt_stderr}"
    ) || {
        printf 'automatic calibration failed: %s attempt %s\n' \
            "${buildopt_state}" "${buildopt_attempt}" >&2
        sed -n '1,260p' "${buildopt_stderr}" >&2
        return 1
    }
    printf '%s\n' "${buildopt_stdout}"
}

buildopt_first=$(buildopt_run qualified 8 1)
jq -e '
    .schemaVersion == "buildopt.poc/optimize-result/v1" and
    .outcome == "LEARNING" and .phase == "QUALIFIED" and
    .reason == "QUALIFIED_PROFILE_STORED" and
    .bindings.completeness == "PROFILE_PORTFOLIO_COMPLETE" and
    .native == {authoritative: true, started: true, exitCode: 0} and
    .execution == {mode: "OPTIMIZED_NATIVE", authoritative: true, started: true, exitCode: 0} and
    .manualFilesRequired == 0 and
    .calibrationPerformed == true and .selectionPerformed == false and
    .selection.status == "SKIPPED" and
    .selection.reason == "NO_QUALIFIED_CHECKPOINT" and
    .selection.performed == false and .selection.selected == false and
    .selection.completedBeforeGradle == true and .selection.durationNs >= 1 and
    .selection.validatedBindings == [] and .selection.failedBindings == [] and
    .productionAuthorized == false and .testOptimization == "OUT_OF_SCOPE" and
    .discovery.status == "COMPLETE" and
    .discovery.reason == "STRUCTURAL_CANDIDATE_DISCOVERED" and
    .calibration.status == "COMPLETE" and
    .calibration.reason == "CANDIDATE_CALIBRATION_QUALIFIED" and
    .calibration.performed == true and .calibration.reused == false and
    .calibration.pairsRequested == 8 and .calibration.pairsMeasured == 8 and
    .calibration.meanSavedMs >= 500 and
    .calibration.reductionRatio >= 0.02 and
    .calibration.interval95SavedMs[0] > 0 and
    .calibration.positivePairs == 8 and
    .calibration.controlP95Ms > 0 and .calibration.candidateP95Ms > 0 and
    .calibration.valueGatePassed == true and
    .calibration.qualified == true and
    .calibration.fallbackSuccessful == true and
    .calibration.breakEvenBuilds >= 1 and
    .calibration.breakEvenBuilds <= .calibration.maximumBreakEvenBuilds and
    (.calibration.evidenceSha256 | test("^[0-9a-f]{64}$")) and
    (.calibration.discoverySha256 | test("^[0-9a-f]{64}$")) and
    (.calibration.generatedFiles | length) == 1 and
    .calibration.productionAuthorized == false and
    .calibration.testOptimization == "OUT_OF_SCOPE" and
    .portfolio.status == "COMPLETE" and
    .portfolio.reason == "QUALIFIED_PROFILE_STORED" and
    .portfolio.performed == true and .portfolio.reused == false and
    .portfolio.changeFamily == "LEAF_SOURCE" and
    (.portfolio.familySha256 | test("^[0-9a-f]{64}$")) and
    (.portfolio.profileSha256 | test("^[0-9a-f]{64}$")) and
    .portfolio.profileCount == 1 and
    (.portfolio.generatedFiles | length) == 6 and
    .portfolio.selectionPerformed == false and
    .portfolio.productionAuthorized == false and
    .portfolio.testOptimization == "OUT_OF_SCOPE" and
    .portfolioPerformed == true and
    .value.matchingReplayCount == 0 and
    .value.projectedGrossSavedMs == 0 and
    .value.cumulativeSelectionOverheadMs == 0 and
    .value.projectedCumulativeNetSavedMs == -.calibration.calibrationCostMs and
    .generatedFiles.valueJson == ".buildopt/optimize/qualified/value-report.json" and
    .generatedFiles.valueMarkdown == ".buildopt/optimize/qualified/value-report.md"
' "${buildopt_first}" >/dev/null || {
    printf 'qualified automatic calibration result is invalid\n' >&2
    sed -n '1,320p' "${buildopt_temp}/qualified-1.log" >&2
    jq . "${buildopt_first}" >&2
    exit 1
}

buildopt_evidence=$(jq -r '.calibration.generatedFiles[0]' "${buildopt_first}")
test -s "${buildopt_repository}/${buildopt_evidence}"
jq -e '
    (.sourceBindings.resolvedDependenciesSha256 | test("^[0-9a-f]{64}$")) and
    .execution.candidateStabilization == "PAIRED_BOUND_CACHE_MEASURED_SHAPE_V1" and
    .execution.controlWarmupCount == 1 and
    (.execution.candidateWarmupCount // 0) == 0
' "${buildopt_repository}/${buildopt_evidence}" >/dev/null || {
    printf 'automatic calibration did not preserve its dependency or stabilization bindings\n' >&2
    jq '{sourceBindings, execution}' "${buildopt_repository}/${buildopt_evidence}" >&2
    exit 1
}
if [[ $(uname -s) == Linux ]] &&
    [[ $(stat -c '%a' "${buildopt_repository}/${buildopt_evidence}") != 600 ]]; then
    printf 'automatic calibration evidence is not private: %s\n' \
        "${buildopt_evidence}" >&2
    exit 1
fi

buildopt_first_evidence_sha=$(jq -r '.calibration.evidenceSha256' "${buildopt_first}")
buildopt_first_discovery_sha=$(jq -r '.calibration.discoverySha256' "${buildopt_first}")
buildopt_first_family_sha=$(jq -r '.portfolio.familySha256' "${buildopt_first}")
buildopt_first_profile_sha=$(jq -r '.portfolio.profileSha256' "${buildopt_first}")
buildopt_portfolio=$(jq -r '.portfolio.portfolioFile' "${buildopt_first}")
buildopt_profile=$(jq -r '.portfolio.profileFile' "${buildopt_first}")
test -s "${buildopt_repository}/${buildopt_portfolio}"
test -s "${buildopt_repository}/${buildopt_profile}"
jq -e '
    .schemaVersion == "buildopt.poc/qualified-profile/v4" and
    .profileId == "qualified-structural-build-impact" and
    .mechanisms.buildImpact == true and
    .mechanisms.safeCache == false and
    .mechanisms.runtimeTuning == false and
    .qualification.pairs == 8 and
    .qualification.interval95SavedMs[0] > 0
' "${buildopt_repository}/${buildopt_profile}" >/dev/null
buildopt_first_cost=$(jq -r '.calibration.calibrationCostMs' "${buildopt_first}")
buildopt_first_saved=$(jq -r '.calibration.meanSavedMs' "${buildopt_first}")
buildopt_first_reduction=$(jq -r '.calibration.reductionRatio * 100' "${buildopt_first}")
buildopt_first_break_even=$(jq -r '.calibration.breakEvenBuilds' "${buildopt_first}")
buildopt_value_json=$(jq -r '.generatedFiles.valueJson' "${buildopt_first}")
buildopt_value_markdown=$(jq -r '.generatedFiles.valueMarkdown' "${buildopt_first}")
test -s "${buildopt_repository}/${buildopt_value_json}"
test -s "${buildopt_repository}/${buildopt_value_markdown}"
jq -e '
    .schemaVersion == "buildopt.poc/magic-wow-report/v1" and
    .graph.status == "OBSERVED" and
    ((.graph.reductionRatio - (.graph.omittedProjects / .graph.fullProjects)) | fabs) < 0.000000001 and
    .performance.status == "OBSERVED_CALIBRATION" and
    .performance.observedNetMeanSavedMs ==
        (.performance.optimizedNativeMeanMs - .performance.buildOptMeanMs) and
    ((.performance.observedReductionRatio -
        (.performance.observedNetMeanSavedMs / .performance.optimizedNativeMeanMs)) | fabs) < 0.000000001 and
    .performance.p95DeltaMs ==
        (.performance.buildOptP95Ms - .performance.optimizedNativeP95Ms) and
    .performance.outputsEquivalent == true and
    .economics.breakEvenBuilds ==
        ((.economics.calibrationCostMs / .performance.observedNetMeanSavedMs) | ceil) and
    .economics.expectedUsefulLifetime == {
        status: "UNAVAILABLE", estimatedMatchingBuilds: null,
        reason: "EXACT_REVISION_REPLAY_HAS_NO_OBSERVED_FUTURE_MATCH_COUNT"
    } and
    ((.economics.projectedCumulativeNetSavedMs -
        (.economics.projectedGrossSavedMs - .economics.calibrationCostMs -
         .economics.cumulativeSelectionOverheadMs)) | fabs) < 0.000000001 and
    .proofOfConcept == true and .productionAuthorized == false and
    .testOptimization == "OUT_OF_SCOPE"
' "${buildopt_repository}/${buildopt_value_json}" >/dev/null
grep -Fq '# BuildOpt value report' "${buildopt_repository}/${buildopt_value_markdown}"
grep -Fq 'Expected useful lifetime: **unavailable**' \
    "${buildopt_repository}/${buildopt_value_markdown}"

buildopt_second=$(buildopt_run qualified 8 2)
buildopt_selection_ns=$(jq -r '.selection.durationNs' "${buildopt_second}")
jq -e \
    --arg evidence "${buildopt_first_evidence_sha}" \
    --arg discovery "${buildopt_first_discovery_sha}" \
    --arg family "${buildopt_first_family_sha}" \
    --arg profile "${buildopt_first_profile_sha}" \
    --argjson cost "${buildopt_first_cost}" \
    --argjson saved "${buildopt_first_saved}" '
    .outcome == "QUALIFIED_AND_USED" and .phase == "ACTIVE" and
    .generation == 1 and .attempt == 2 and
    .resume == {
        mode: "AUTO", checkpointFound: true, accepted: true,
        reason: "EXACT_BINDINGS",
        previousStateSha256: .resume.previousStateSha256
    } and
    (.resume.previousStateSha256 | test("^[0-9a-f]{64}$")) and
    .calibration.performed == true and .calibration.reused == true and
    .calibrationPerformed == false and
    .calibration.evidenceSha256 == $evidence and
    .calibration.discoverySha256 == $discovery and
    .calibration.calibrationCostMs == $cost and
    .calibration.meanSavedMs == $saved and
    .reason == "QUALIFIED_PROFILE_SELECTED" and
    .bindings.completeness == "AUTOMATIC_REPLAY_COMPLETE" and
    .native == {authoritative: false, started: false, exitCode: 0} and
    .execution == {mode: "SELECTIVE_PROFILE", authoritative: true, started: true, exitCode: 0} and
    .portfolio.status == "COMPLETE" and
    .portfolio.reason == "QUALIFIED_PROFILE_REUSED" and
    .portfolio.performed == false and .portfolio.reused == true and
    .portfolio.familySha256 == $family and
    .portfolio.profileSha256 == $profile and
    .portfolio.profileCount == 1 and
    .portfolioPerformed == false and
    .selection == {
        status: "SELECTED", reason: "QUALIFIED_PROFILE_SELECTED",
        performed: true, selected: true, completedBeforeGradle: true,
        durationNs: .selection.durationNs,
        changeFamily: "LEAF_SOURCE", familySha256: $family,
        profileSha256: $profile, profileFile: .portfolio.profileFile,
        source: "LOCAL_PORTFOLIO",
        originalEntrypoints: ["jar"], selectedEntrypoints: [":service-a:jar"],
        validatedBindings: [
            "BUILDOPT_EXECUTABLE", "CALIBRATION_EVIDENCE", "CHANGE_FAMILY",
            "DISCOVERY_DOCUMENTS", "GRADLE_OPTIONS", "GRADLE_WRAPPER_PROPERTIES",
            "PROFILE_ARTIFACTS", "PROFILE_PRECONDITIONS", "REPOSITORY_ID",
            "REPOSITORY_REVISION", "WORKFLOW_ENTRYPOINTS"
        ],
        failedBindings: [], productionAuthorized: false,
        testOptimization: "OUT_OF_SCOPE"
    } and
    .central == {
        schemaVersion: "buildopt.poc/central-optimize-integration/v1",
        status: "DISCONNECTED", reason: "NO_CENTRAL_CONNECTION",
        connected: false, selectionSource: "NONE",
        gradleCacheMode: "DISCONNECTED", gradleCacheStatus: "NOT_CONFIGURED",
        checkpointGeneration: 0, portfolioGeneration: 0,
        evidenceGeneration: 0, evidenceRevision: "",
        portfolioManifestSha256: "", evidenceManifestSha256: "",
        revalidatedRevision: "", snapshotsVerified: false,
        preSyncOnline: false, preSyncDurationMs: 0,
        postSyncStatus: "NOT_ATTEMPTED",
        postSyncOnline: false, postSyncDurationMs: 0,
        nativeFallback: false, productionAuthorized: false,
        testOptimization: "OUT_OF_SCOPE"
    } and
    .selection.durationNs >= 1 and
    .selectionPerformed == true and .productionAuthorized == false and
    .value.matchingReplayCount == 1 and
    .value.projectedGrossSavedMs == .calibration.meanSavedMs and
    .value.cumulativeSelectionOverheadMs == (.selection.durationNs / 1000000) and
    .value.projectedCumulativeNetSavedMs ==
        (.value.projectedGrossSavedMs - .calibration.calibrationCostMs -
         .value.cumulativeSelectionOverheadMs)
' "${buildopt_second}" >/dev/null || {
    printf 'exact automatic profile replay is invalid\n' >&2
    jq . "${buildopt_second}" >&2
    exit 1
}
if grep -Eq 'structural pair [0-9]+/8' "${buildopt_temp}/qualified-2.log"; then
    printf 'exact automatic replay unexpectedly repeated measurement\n' >&2
    exit 1
fi
grep -F 'automatic qualified-profile candidate' \
    "${buildopt_temp}/qualified-2.log" >/dev/null

printf '\n' >>"${buildopt_repository}/${buildopt_profile}"
buildopt_repaired=$(buildopt_run qualified 8 3)
jq -e \
    --arg family "${buildopt_first_family_sha}" \
    --arg profile "${buildopt_first_profile_sha}" '
    .generation == 1 and .attempt == 3 and
    .calibration.reused == true and .calibrationPerformed == false and
    .portfolio.reason == "QUALIFIED_PROFILE_STORED" and
    .portfolio.performed == true and .portfolio.reused == false and
    .portfolio.familySha256 == $family and
    .portfolio.profileSha256 == $profile and
    .portfolio.profileCount == 1 and
    .portfolioPerformed == true and
    .selection.status == "NATIVE_RETAINED" and
    .selection.reason == "PROFILE_PORTFOLIO_INVALID" and
    .selection.performed == true and .selection.selected == false and
    .selection.completedBeforeGradle == true and .selection.durationNs >= 1 and
    .selection.failedBindings == ["PROFILE_ARTIFACTS"] and
    .native == {authoritative: true, started: true, exitCode: 0} and
    .execution == {mode: "OPTIMIZED_NATIVE", authoritative: true, started: true, exitCode: 0} and
    .selectionPerformed == true and .productionAuthorized == false
' "${buildopt_repaired}" >/dev/null || {
    printf 'tampered automatic profile was not rebuilt safely\n' >&2
    jq . "${buildopt_repaired}" >&2
    exit 1
}
if grep -Eq 'structural pair [0-9]+/8' "${buildopt_temp}/qualified-3.log"; then
    printf 'profile repair unexpectedly repeated calibration\n' >&2
    exit 1
fi

buildopt_replayed_after_repair=$(buildopt_run qualified 8 4)
jq -e \
    --arg family "${buildopt_first_family_sha}" \
    --arg profile "${buildopt_first_profile_sha}" '
    .outcome == "QUALIFIED_AND_USED" and .phase == "ACTIVE" and
    .reason == "QUALIFIED_PROFILE_SELECTED" and
    .generation == 1 and .attempt == 4 and
    .calibration.reused == true and .calibrationPerformed == false and
    .portfolio.reused == true and .portfolioPerformed == false and
    .selection.status == "SELECTED" and .selection.selected == true and
    .selection.familySha256 == $family and .selection.profileSha256 == $profile and
    .selection.selectedEntrypoints == [":service-a:jar"] and
    .selection.durationNs >= 1 and
    .native == {authoritative: false, started: false, exitCode: 0} and
    .execution == {mode: "SELECTIVE_PROFILE", authoritative: true, started: true, exitCode: 0} and
    .productionAuthorized == false
' "${buildopt_replayed_after_repair}" >/dev/null || {
    printf 'repaired automatic profile was not selected\n' >&2
    jq . "${buildopt_replayed_after_repair}" >&2
    exit 1
}
if grep -Eq 'structural pair [0-9]+/8' "${buildopt_temp}/qualified-4.log"; then
    printf 'repaired automatic replay unexpectedly repeated calibration\n' >&2
    exit 1
fi

buildopt_under_budget=$(buildopt_run under-budget 2 1)
jq -e '
    .outcome == "LEARNING" and .phase == "DISCOVERED" and
    .reason == "CALIBRATION_PAIR_BUDGET_INSUFFICIENT" and
    .bindings.completeness == "DISCOVERY_COMPLETE" and
    .discovery.status == "COMPLETE" and
    .calibration.status == "SKIPPED" and
    .calibration.reason == "CALIBRATION_PAIR_BUDGET_INSUFFICIENT" and
    .calibration.pairsRequested == 2 and
    .calibration.performed == false and .calibration.qualified == false and
    .calibration.generatedFiles == [] and
    .calibration.productionAuthorized == false and
    .portfolio.status == "SKIPPED" and
    .portfolio.performed == false and .portfolio.generatedFiles == [] and
    .portfolioPerformed == false and
    .selectionPerformed == false and .productionAuthorized == false
' "${buildopt_under_budget}" >/dev/null || {
    printf 'under-budget automatic calibration result is invalid\n' >&2
    jq . "${buildopt_under_budget}" >&2
    exit 1
}

buildopt_cancel_tmp="${buildopt_temp}/cancel-tmp"
buildopt_cancel_stdout="${buildopt_temp}/cancelled.json"
buildopt_cancel_stderr="${buildopt_temp}/cancelled.log"
mkdir -p -- "${buildopt_cancel_tmp}"
(
    cd -- "${buildopt_repository}"
    exec env -u BUILDOPT_BYPASS \
        -u GITHUB_EVENT_PATH -u GITHUB_REPOSITORY \
        -u CI_MERGE_REQUEST_DIFF_BASE_SHA -u CI_COMMIT_BEFORE_SHA \
        -u CI_PROJECT_PATH \
        TMPDIR="${buildopt_cancel_tmp}" \
        GRADLE_USER_HOME="${buildopt_gradle_home}" \
        "${buildopt_binary}" optimize --json \
        --state-dir .buildopt/optimize/cancelled \
        --resume never --calibration-budget 5m \
        --calibration-pairs 8 --max-break-even-builds 100 \
        jar --offline \
        >"${buildopt_cancel_stdout}" 2>"${buildopt_cancel_stderr}"
) &
buildopt_cancel_pid=$!
buildopt_cancel_ready=false
for _ in $(seq 1 240); do
    if grep -Fq 'warming isolated control daemon' "${buildopt_cancel_stderr}"; then
        buildopt_cancel_ready=true
        break
    fi
    if ! kill -0 "${buildopt_cancel_pid}" 2>/dev/null; then
        break
    fi
    sleep 0.25
done
if [[ ${buildopt_cancel_ready} != true ]]; then
    kill -TERM "${buildopt_cancel_pid}" 2>/dev/null || true
    wait "${buildopt_cancel_pid}" 2>/dev/null || true
    printf 'automatic calibration did not reach cancellable measurement readiness\n' >&2
    sed -n '1,260p' "${buildopt_cancel_stderr}" >&2
    exit 1
fi
kill -INT "${buildopt_cancel_pid}"
set +e
wait "${buildopt_cancel_pid}"
buildopt_cancel_exit=$?
set -e
if ((buildopt_cancel_exit != 0)); then
    printf 'cancelled automatic calibration returned %s, want authoritative build status 0\n' \
        "${buildopt_cancel_exit}" >&2
    sed -n '1,260p' "${buildopt_cancel_stderr}" >&2
    exit 1
fi
jq -e '
    .outcome == "NATIVE_RETAINED" and .phase == "NATIVE_RETAINED" and
    .reason == "CALIBRATION_CANCELLED" and
    .native == {authoritative: true, started: true, exitCode: 0} and
    .execution == {mode: "OPTIMIZED_NATIVE", authoritative: true, started: true, exitCode: 0} and
    .calibration.status == "NATIVE_RETAINED" and
    .calibration.reason == "CALIBRATION_CANCELLED" and
    .calibration.performed == false and .calibration.qualified == false and
    .calibration.generatedFiles == [] and
    .portfolio.status == "SKIPPED" and .selection.status == "SKIPPED" and
    .productionAuthorized == false and .testOptimization == "OUT_OF_SCOPE"
' "${buildopt_cancel_stdout}" >/dev/null || {
    printf 'cancelled automatic calibration did not retain native execution safely\n' >&2
    jq . "${buildopt_cancel_stdout}" >&2
    exit 1
}
if find "${buildopt_cancel_tmp}" -maxdepth 1 \
    -name 'buildopt-structural-measurement-*' -print -quit | grep -q .; then
    printf 'cancelled automatic calibration retained its measurement root\n' >&2
    exit 1
fi

printf 'Magic calibration and profile portfolio OK: family=LEAF_SOURCE profiles=1 mean saved=%sms reduction=%s%% positive=8/8 calibration=%sms break-even=%s builds selection=%sns; exact evidence/profile replayed, tamper rebuilt, insufficient pair budget made no claim, and cancellation retained native with complete cleanup\n' \
    "${buildopt_first_saved}" "${buildopt_first_reduction}" \
    "${buildopt_first_cost}" "${buildopt_first_break_even}" "${buildopt_selection_ns}"
