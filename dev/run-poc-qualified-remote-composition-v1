#!/usr/bin/env bash
set -euo pipefail

if (($# != 3)); then
    printf 'usage: %s OUTPUT_FILE BUILDOPT_BIN SOURCE_ARCHIVE\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_executable=$2
buildopt_source_archive=$3
buildopt_script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(CDPATH='' cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-qualified-remote-composition-v1.json"
buildopt_fixture="${buildopt_repo_root}/fixtures/poc-kafka-packaging"
buildopt_harness="${buildopt_repo_root}/internal/sharedcache/poc_qualified_remote_composition_test.go"
buildopt_java_home="${buildopt_repo_root}/.tools/toolchains/temurin-jdk-25-69264a7a211bf502"

if [[ "${buildopt_output}" != /* || -e "${buildopt_output}" ||
    ! -x "${buildopt_executable}" || ! -f "${buildopt_source_archive}" ]]; then
    printf 'invalid qualified remote composition runner input\n' >&2
    exit 64
fi
for buildopt_command in awk chmod cp date find git jq mkdir mktemp readlink rm \
    sha256sum sort stat tar timeout xargs; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required qualified composition command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
if [[ -n "$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)" ]]; then
    printf 'qualified remote composition requires a clean revision-bound checkout\n' >&2
    exit 1
fi
if [[ "$(getconf _NPROCESSORS_ONLN)" != 12 ]]; then
    printf 'qualified remote composition requires exactly 12 online CPUs\n' >&2
    exit 1
fi
[[ -x "${buildopt_java_home}/bin/java" ]] || {
    printf 'locked Temurin 25 toolchain is unavailable\n' >&2
    exit 1
}
"${buildopt_script_dir}/check-poc-qualified-remote-composition-v1" >/dev/null

buildopt_source_sha=$(sha256sum "${buildopt_source_archive}" | awk '{print $1}')
[[ "${buildopt_source_sha}" == \
    "$(jq -er '.repository.sourceArchiveSha256' "${buildopt_spec}")" ]] || {
    printf 'Kafka source archive checksum mismatch\n' >&2
    exit 1
}
[[ "$(stat -c %s "${buildopt_source_archive}")" == \
    "$(jq -er '.repository.sourceArchiveBytes' "${buildopt_spec}")" ]] || {
    printf 'Kafka source archive size mismatch\n' >&2
    exit 1
}

buildopt_binary=$(readlink -f "${buildopt_executable}")
buildopt_prefix=$(CDPATH='' cd -- "$(dirname -- "${buildopt_binary}")/.." && pwd)
buildopt_assets="${buildopt_prefix}/share/buildopt"
buildopt_init_script="${buildopt_assets}/buildopt.init.gradle"
buildopt_plugin_jar="${buildopt_assets}/buildopt-gradle-plugin.jar"
if [[ ! -f "${buildopt_init_script}" || ! -f "${buildopt_plugin_jar}" ]]; then
    printf 'installed BuildOpt Gradle assets are unavailable\n' >&2
    exit 1
fi

buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-qualified-remote-composition-v1.XXXXXX")
buildopt_complete=false
buildopt_stop() {
    local buildopt_project=$1
    local buildopt_home=$2
    if [[ -x "${buildopt_project}/gradlew" && -d "${buildopt_home}" ]]; then
        (
            cd "${buildopt_project}"
            env -u CI JAVA_HOME="${buildopt_java_home}" \
                GRADLE_USER_HOME="${buildopt_home}" ./gradlew --stop
        ) >/dev/null 2>&1 || true
    fi
}
buildopt_cleanup() {
    if [[ "${buildopt_root}" == \
        "${TMPDIR:-/tmp}/buildopt-qualified-remote-composition-v1."* ]]; then
        buildopt_stop "${buildopt_root}/seed-project" "${buildopt_root}/seed-home"
        buildopt_stop "${buildopt_root}/control-project" "${buildopt_root}/control-home"
        buildopt_stop "${buildopt_root}/candidate-project" "${buildopt_root}/candidate-home"
        if [[ "${buildopt_complete}" != true && -d "${buildopt_root}/logs" ]]; then
            tar -C "${buildopt_root}" -czf "${buildopt_output}.failure-logs.tar.gz" logs
            chmod 0600 "${buildopt_output}.failure-logs.tar.gz"
            printf 'qualified composition failure logs preserved: %s\n' \
                "${buildopt_output}.failure-logs.tar.gz" >&2
        fi
        rm -rf -- "${buildopt_root}"
    fi
}
trap buildopt_cleanup EXIT
chmod 0700 "${buildopt_root}"
mkdir -p "${buildopt_root}/seed-project" "${buildopt_root}/seed-home" \
    "${buildopt_root}/control-project" "${buildopt_root}/control-home" \
    "${buildopt_root}/candidate-project" "${buildopt_root}/candidate-home" \
    "${buildopt_root}/logs"

tar -xzf "${buildopt_source_archive}" --strip-components=1 \
    -C "${buildopt_root}/seed-project"
buildopt_change_path=$(jq -er '.change.path' "${buildopt_spec}")
[[ "$(sha256sum "${buildopt_root}/seed-project/${buildopt_change_path}" | awk '{print $1}')" == \
    "$(jq -er '.change.originalSha256' "${buildopt_spec}")" ]] || {
    printf 'Kafka change input checksum mismatch\n' >&2
    exit 1
}
cp "${buildopt_fixture}/buildopt-impact-manifest.json" \
    "${buildopt_root}/seed-project/buildopt-impact-manifest.json"
cp "${buildopt_fixture}/buildopt-impact-graph.generated.json" \
    "${buildopt_root}/seed-project/buildopt-impact-graph.generated.json"
cp "${buildopt_fixture}/buildopt-impact.generated.json" \
    "${buildopt_root}/seed-project/buildopt-impact.generated.json"
printf '%s\n' "${buildopt_change_path}" \
    >"${buildopt_root}/seed-project/.buildopt-changes"
printf '\n// BuildOpt fixed Kafka packaging change.\n' \
    >>"${buildopt_root}/seed-project/${buildopt_change_path}"

if ! (
    cd "${buildopt_root}/seed-project"
    env -u CI JAVA_HOME="${buildopt_java_home}" \
        GRADLE_USER_HOME="${buildopt_root}/seed-home" \
        timeout 20m ./gradlew --daemon --build-cache --parallel \
        --console=plain --max-workers=12 --no-scan assemble
) >"${buildopt_root}/logs/dependency-preparation.log" 2>&1; then
    tail -n 180 "${buildopt_root}/logs/dependency-preparation.log" >&2
    printf 'Kafka dependency preparation failed\n' >&2
    exit 1
fi
grep -Fq 'BUILD SUCCESSFUL' "${buildopt_root}/logs/dependency-preparation.log"
! grep -Eq '^> Task .*:test($| )' \
    "${buildopt_root}/logs/dependency-preparation.log" || {
    printf 'Kafka dependency preparation executed a Gradle Test task\n' >&2
    exit 1
}
buildopt_stop "${buildopt_root}/seed-project" "${buildopt_root}/seed-home"

rm -rf -- "${buildopt_root}/seed-home/daemon" \
    "${buildopt_root}/seed-home/caches/build-cache-1"
find "${buildopt_root}/seed-project" -depth -type d \
    \( -name build -o -name .gradle \) -exec rm -rf -- {} +
find "${buildopt_root}/seed-home" -type f \
    \( -name '*.lock' -o -name gc.properties \) -delete
buildopt_dependency_sha=$(
    cd "${buildopt_root}/seed-home"
    find caches/modules-2 -type f -print0 | sort -z |
        xargs -0 sha256sum | sha256sum | awk '{print $1}'
)

for buildopt_arm in control candidate; do
    cp -a --reflink=auto "${buildopt_root}/seed-project/." \
        "${buildopt_root}/${buildopt_arm}-project/"
    cp -a --reflink=auto "${buildopt_root}/seed-home/." \
        "${buildopt_root}/${buildopt_arm}-home/"
done

buildopt_revision=$(git -C "${buildopt_repo_root}" rev-parse HEAD)
env -u CI JAVA_HOME="${buildopt_java_home}" \
    PATH="${buildopt_java_home}/bin:${PATH}" \
    BUILDOPT_POC_QUALIFIED_REMOTE_RESULT="${buildopt_output}" \
    BUILDOPT_POC_QUALIFIED_REMOTE_SEED_PROJECT="${buildopt_root}/seed-project" \
    BUILDOPT_POC_QUALIFIED_REMOTE_CONTROL_PROJECT="${buildopt_root}/control-project" \
    BUILDOPT_POC_QUALIFIED_REMOTE_CANDIDATE_PROJECT="${buildopt_root}/candidate-project" \
    BUILDOPT_POC_QUALIFIED_REMOTE_SEED_HOME="${buildopt_root}/seed-home" \
    BUILDOPT_POC_QUALIFIED_REMOTE_CONTROL_HOME="${buildopt_root}/control-home" \
    BUILDOPT_POC_QUALIFIED_REMOTE_CANDIDATE_HOME="${buildopt_root}/candidate-home" \
    BUILDOPT_POC_QUALIFIED_REMOTE_JAVA_HOME="${buildopt_java_home}" \
    BUILDOPT_POC_QUALIFIED_REMOTE_BUILDOPT_BIN="${buildopt_binary}" \
    BUILDOPT_POC_QUALIFIED_REMOTE_INIT_SCRIPT="${buildopt_init_script}" \
    BUILDOPT_POC_QUALIFIED_REMOTE_PLUGIN_JAR="${buildopt_plugin_jar}" \
    BUILDOPT_POC_QUALIFIED_REMOTE_LOGS="${buildopt_root}/logs" \
    BUILDOPT_POC_QUALIFIED_REMOTE_REVISION="${buildopt_revision}" \
    BUILDOPT_POC_QUALIFIED_REMOTE_RUNNER_SHA="$(sha256sum "${BASH_SOURCE[0]}" | awk '{print $1}')" \
    BUILDOPT_POC_QUALIFIED_REMOTE_SPEC_SHA="$(sha256sum "${buildopt_spec}" | awk '{print $1}')" \
    BUILDOPT_POC_QUALIFIED_REMOTE_HARNESS_SHA="$(sha256sum "${buildopt_harness}" | awk '{print $1}')" \
    BUILDOPT_POC_QUALIFIED_REMOTE_SOURCE_SHA="${buildopt_source_sha}" \
    BUILDOPT_POC_QUALIFIED_REMOTE_DEPENDENCY_SHA="${buildopt_dependency_sha}" \
    BUILDOPT_POC_QUALIFIED_REMOTE_BINARY_SHA="$(sha256sum "${buildopt_binary}" | awk '{print $1}')" \
    BUILDOPT_POC_QUALIFIED_REMOTE_INIT_SHA="$(sha256sum "${buildopt_init_script}" | awk '{print $1}')" \
    BUILDOPT_POC_QUALIFIED_REMOTE_PLUGIN_SHA="$(sha256sum "${buildopt_plugin_jar}" | awk '{print $1}')" \
    BUILDOPT_POC_QUALIFIED_REMOTE_IMPACT_EVIDENCE_SHA="$(sha256sum "${buildopt_repo_root}/benchmarks/results/poc-kafka-packaging-v1.json" | awk '{print $1}')" \
    BUILDOPT_POC_QUALIFIED_REMOTE_EDGE_EVIDENCE_SHA="$(sha256sum "${buildopt_repo_root}/benchmarks/results/poc-remote-cache-transfer-v1.json" | awk '{print $1}')" \
    "${buildopt_script_dir}/run" --toolchain go -- \
        go test -count=1 -timeout=40m -v ./internal/sharedcache \
        -run '^TestPOCQualifiedRemoteCompositionExperiment$'

"${buildopt_script_dir}/check-poc-qualified-remote-composition-v1-result" \
    "${buildopt_output}"
buildopt_complete=true
printf 'POC qualified remote composition evidence written: %s\n' \
    "${buildopt_output}"
