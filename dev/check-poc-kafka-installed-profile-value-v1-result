#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [RESULT_FILE]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(CDPATH='' cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-kafka-installed-profile-value-v1.json"
buildopt_result=${1:-"${buildopt_repo_root}/benchmarks/results/poc-kafka-installed-profile-value-v1.json"}

for buildopt_command in git jq sha256sum; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required installed Kafka profile result command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
[[ -s "${buildopt_result}" ]] || {
    printf 'installed Kafka profile result is unavailable: %s\n' "${buildopt_result}" >&2
    exit 1
}
"${buildopt_script_dir}/check-poc-kafka-installed-profile-value-v1" >/dev/null

buildopt_before=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
buildopt_execution_revision=$(jq -er '.buildoptRevision' "${buildopt_result}")
if ! git -C "${buildopt_repo_root}" merge-base --is-ancestor \
    "${buildopt_execution_revision}" HEAD; then
    printf 'installed Kafka profile evidence revision is not retained in history\n' >&2
    exit 1
fi
buildopt_archived_sha() {
    local buildopt_path=$1
    git -C "${buildopt_repo_root}" show \
        "${buildopt_execution_revision}:${buildopt_path}" | sha256sum | awk '{print $1}'
}
buildopt_postprocessing_revision=$(git -C "${buildopt_repo_root}" log -1 \
    --format=%H \
    -S'DETERMINISTIC_LCG32_FULL_RANGE_INDEX_V2' -- \
    dev/run-poc-kafka-impact-edge-composition-v2)
[[ -n "${buildopt_postprocessing_revision}" ]] || {
    printf 'installed Kafka profile bootstrap correction is unavailable\n' >&2
    exit 1
}

jq -e \
    --arg executionRevision "${buildopt_execution_revision}" \
    --arg specSha "$(buildopt_archived_sha specs/poc-kafka-installed-profile-value-v1.json)" \
    --arg runnerSha "$(buildopt_archived_sha dev/run-poc-kafka-impact-edge-composition-v2)" \
    --arg harnessSha "$(buildopt_archived_sha internal/sharedcache/poc_kafka_impact_edge_composition_test.go)" \
    --arg postprocessingRevision "${buildopt_postprocessing_revision}" \
    --arg profileSha "$(sha256sum "${buildopt_repo_root}/fixtures/poc-kafka-packaging/buildopt-qualified-edge-profile.json" | awk '{print $1}')" \
    --arg usabilitySha "$(sha256sum "${buildopt_repo_root}/benchmarks/results/poc-kafka-composition-usability-v1.json" | awk '{print $1}')" \
    --arg priorSha "$(sha256sum "${buildopt_repo_root}/benchmarks/results/poc-kafka-impact-edge-composition-v2.json" | awk '{print $1}')" \
    --slurpfile spec "${buildopt_spec}" '
    def sha256: type == "string" and test("^[0-9a-f]{64}$");
    def bootstrap_mean($data; $sample):
      reduce range(0; ($data | length)) as $draw
        ({state: ((2654435761 * ($sample + 1)) % 4294967296), sum: 0};
         .state = ((1664525 * .state + 1013904223) % 4294967296) |
         .sum += $data[((.state * ($data | length) / 4294967296) | floor)].savedMs) |
      .sum / ($data | length);
    def bootstrap95($data):
      ([range(0; 4096) as $sample | bootstrap_mean($data; $sample)] | sort) as $r |
      [$r[102], $r[3993]];
    .observations as $data |
    (($data | map(.controlDurationMs) | add) / ($data | length)) as $controlMean |
    (($data | map(.candidateDurationMs) | add) / ($data | length)) as $candidateMean |
    ($controlMean - $candidateMean) as $saved |
    (($data | map(.savedMs) | add) /
      ($data | map(.controlDurationMs) | add)) as $ratio |
    bootstrap95($data) as $interval |
    ($data | map(select(.savedMs > 0)) | length) as $positive |
    (($saved >= $spec[0].valueGate.minimumSavedMs) and
      ($ratio >= $spec[0].valueGate.minimumReductionRatio) and
      ($interval[0] > 0) and
      ($positive >= $spec[0].valueGate.minimumPositivePairs)) as $performance |
    .schemaVersion == "buildopt.evidence/poc-kafka-installed-profile-value/v1" and
    .workItem == "POC-KAFKA-INSTALLED-PROFILE-VALUE-001" and
    .evidenceState == "TERMINAL" and
    (.capturedAt | fromdateiso8601) and
    .buildoptRevision == $executionRevision and
    .runnerScriptSha256 == $runnerSha and
    .specSha256 == $specSha and
    .harnessSha256 == $harnessSha and
    .sourceArchiveSha256 == $spec[0].repository.sourceArchiveSha256 and
    (.dependencyCacheSha256 | sha256) and
    (.installedAssets.binarySha256 | sha256) and
    (.installedAssets.initScriptSha256 | sha256) and
    (.installedAssets.pluginJarSha256 | sha256) and
    .repository == {
      nameWithOwner: $spec[0].repository.nameWithOwner,
      releaseTag: $spec[0].repository.releaseTag,
      revision: $spec[0].repository.revision,
      gradleVersion: $spec[0].repository.gradleVersion,
      jdk: $spec[0].repository.jdk
    } and
    .runner == {id: "linux-amd64-12c-16659865600b-v1", cpuCount: 12,
      memoryBytes: 16659865600, maxWorkers: 12} and
    .network == $spec[0].network and
    .executionPath == {
      installedProfile: true,
      command: $spec[0].hypothesis.command,
      profileId: $spec[0].profile.profileId,
      repositoryOwnedProfile: true,
      experimentOnlySelectionEnvironmentUsed: false
    } and
    .profileEvidence == {
      profileSha256: $profileSha,
      usabilityEvidenceSha256: $usabilitySha,
      priorPerformanceEvidenceSha256: $priorSha,
      priorTimingsReused: false
    } and
    .statisticalPostprocessing.algorithm == "DETERMINISTIC_LCG32_FULL_RANGE_INDEX_V2" and
    .statisticalPostprocessing.bootstrapSamples == 4096 and
    .statisticalPostprocessing.observationsChanged == false and
    (.statisticalPostprocessing.revision == $executionRevision or
      .statisticalPostprocessing.revision == $postprocessingRevision) and
    .preparation.measured == false and
    .preparation.dependenciesResolvedBeforeMeasurement == true and
    .preparation.externalDependencyNetworkBlocked == true and
    .preparation.seededObjectCount > 0 and
    .preparation.seededObjectBytes > 0 and
    .preparation.seedOutputSha256 == $spec[0].sourceNormalization.qualifiedArtifactSha256 and
    .preparation.seedOutputProducingTask == ":clients:shadowJar" and
    .preparation.edgeWarmupOriginRequests > 0 and
    .preparation.edgeWarmupOriginBytes > 0 and
    .mechanisms == {buildImpact: true, edgeLocality: true,
      standardJarAdapter: false, standardCopyAdapter: false, safeCache: false,
      runtimeTuning: false, hotState: false, testOptimization: false,
      sourceNormalization: true} and
    .measurementAssertions.freshPairs == true and
    .measurementAssertions.priorObservationsReused == false and
    .measurementAssertions.sameCachedOutputInEveryMeasuredArm == true and
    .measurementAssertions.shadowJarFromCacheInEveryMeasuredArm == true and
    .measurementAssertions.candidateOriginTrafficZeroInEveryPair == true and
    .measurementAssertions.candidatePlanSelectedInEveryPair == true and
    .measurementAssertions.controlFullGraphInEveryPair == true and
    .measurementAssertions.standardJarAdapterAbsent == true and
    .measurementAssertions.repositoryOwnedProfileSelectedInEveryPair == true and
    .measurementAssertions.productAttributableFailures == 0 and
    ($data | length) == 8 and
    [$data[].pair] == [1, 2, 3, 4, 5, 6, 7, 8] and
    [$data[].order] == $spec[0].measurement.pairOrder and
    all($data[];
      .controlDurationMs > 0 and .candidateDurationMs > 0 and
      .savedMs == (.controlDurationMs - .candidateDurationMs) and
      .interArmIdleGapMs >= 0 and
      .interArmIdleGapMs <= $spec[0].measurement.maximumInterArmIdleGapMs and
      .controlOriginRequests > 0 and .controlOriginBytes > 0 and
      .candidateOriginRequests == 0 and .candidateOriginBytes == 0 and
      .controlRemoteCacheHits > 0 and .candidateRemoteCacheHits > 0 and
      .controlFullGraph == true and .candidatePlanSelected == true and
      .candidateAlternative == $spec[0].valueGate.requiredCandidateAlternative and
      .controlShadowJarFromCache == true and
      .candidateShadowJarFromCache == true and
      .candidateStandardJarAdapter == false and
      .requiredOutputCount == 1 and .requiredOutputBytes > 0 and
      .requiredOutputSha256 == $spec[0].sourceNormalization.qualifiedArtifactSha256 and
      (.controlTaskOutcomeSha256 | sha256) and
      (.candidateTaskOutcomeSha256 | sha256) and
      .outputsIdentical == true and .productAttributableFailure == false) and
    .safety.impactFallbackPassed == true and
    .safety.edgeFailureFallbackPassed == true and
    .safety.edgeFailureBuildSucceeded == true and
    .safety.edgeFailureRemoteCacheDisabled == true and
    .safety.edgeFailureRequiredOutputProduced == true and
    .safety.edgeFailureOutputExact == true and
    .result == {
      pairs: 8,
      controlMeanMs: $controlMean,
      candidateMeanMs: $candidateMean,
      meanSavedMs: $saved,
      reductionRatio: $ratio,
      interval95SavedMs: $interval,
      positivePairs: $positive,
      qualified: $performance,
      decision: (if $performance then $spec[0].decisionPolicy.qualifiedDecision
        else $spec[0].decisionPolicy.unqualifiedDecision end),
      performanceGatePassed: $performance
    } and
    .boundaries == $spec[0].boundaries
' "${buildopt_result}" >/dev/null

buildopt_after=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
if [[ "${buildopt_before}" != "${buildopt_after}" ]]; then
    printf 'installed Kafka profile result validation changed the working tree\n' >&2
    exit 1
fi
printf 'Installed Kafka profile value evidence OK: %s\n' "${buildopt_result}"
