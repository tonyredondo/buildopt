#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)); then
    printf 'usage: %s OUTPUT_FILE\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-structural-profile-adoption-v1.json"

if [[ "${buildopt_output}" != /* || -e "${buildopt_output}" ]]; then
    printf 'invalid structural profile adoption output path\n' >&2
    exit 64
fi
for buildopt_command in awk chmod cmp cp curl date find git grep jq mkdir \
    mktemp mv sed sha256sum sort tar timeout xargs; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required structural profile adoption command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
[[ -x /usr/bin/time ]] || {
    printf 'required structural profile adoption command is unavailable: /usr/bin/time\n' >&2
    exit 1
}
if env | grep -q '^BUILDOPT_'; then
    printf 'structural profile adoption requires an environment without BUILDOPT_* overrides\n' >&2
    exit 1
fi
if [[ -n "$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)" ]]; then
    printf 'structural profile adoption requires a clean revision-bound checkout\n' >&2
    exit 1
fi

"${buildopt_script_dir}/check-poc-structural-profile-adoption-v1" --contract >/dev/null

buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-structural-profile-adoption-v1.XXXXXX")
buildopt_completed=false
buildopt_stop_gradle() {
    local buildopt_checkout=$1
    local buildopt_home=$2
    if [[ -x "${buildopt_checkout}/gradlew" && -d "${buildopt_home}" ]]; then
        (
            cd "${buildopt_checkout}"
            env GRADLE_USER_HOME="${buildopt_home}" \
                "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
                ./gradlew --stop
        ) >/dev/null 2>&1 || true
    fi
}
buildopt_cleanup() {
    if [[ "${buildopt_root}" == "${TMPDIR:-/tmp}/buildopt-structural-profile-adoption-v1."* ]]; then
        if [[ "${buildopt_completed}" != true && -d "${buildopt_root}/logs" ]]; then
            buildopt_failure_logs="${buildopt_output}.failure-logs.tar.gz"
            tar -C "${buildopt_root}" -czf "${buildopt_failure_logs}" logs
            chmod 0600 "${buildopt_failure_logs}"
            printf 'structural profile adoption failure logs preserved: %s\n' \
                "${buildopt_failure_logs}" >&2
        fi
        buildopt_stop_gradle "${buildopt_root}/source" "${buildopt_root}/preflight-home"
        buildopt_stop_gradle "${buildopt_root}/work/checkout" \
            "${buildopt_root}/work/gradle-home"
        chmod -R u+w "${buildopt_root}/readonly-dependencies" 2>/dev/null || true
        rm -rf -- "${buildopt_root}"
    fi
}
trap buildopt_cleanup EXIT
chmod 0700 "${buildopt_root}"
mkdir -p -- "${buildopt_root}/source" "${buildopt_root}/preflight-home" \
    "${buildopt_root}/package-gradle-home" "${buildopt_root}/logs"
chmod 0700 "${buildopt_root}/preflight-home" "${buildopt_root}/package-gradle-home"

buildopt_revision=$(git -C "${buildopt_repo_root}" rev-parse HEAD)
buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_runner_sha=$(sha256sum "${BASH_SOURCE[0]}" | awk '{print $1}')
(
    cd "${buildopt_repo_root}"
    env GRADLE_USER_HOME="${buildopt_root}/package-gradle-home" \
        "${buildopt_repo_root}/packaging/linux/package.sh" \
        --version 0.3.0-dev --output "${buildopt_root}/package" >/dev/null
)
mkdir -p -- "${buildopt_root}/package-root" "${buildopt_root}/install"
buildopt_package="${buildopt_root}/package/buildopt-0.3.0-dev-linux-amd64.tar.gz"
tar -xzf "${buildopt_package}" -C "${buildopt_root}/package-root"
"${buildopt_root}/package-root/buildopt-0.3.0-dev-linux-amd64/install.sh" \
    --prefix "${buildopt_root}/install" >/dev/null
buildopt_executable="${buildopt_root}/install/bin/buildopt"
buildopt_impact_executable="${buildopt_root}/install/bin/buildopt-impact"
buildopt_executable_sha=$(sha256sum "${buildopt_executable}" | awk '{print $1}')
buildopt_package_sha=$(sha256sum "${buildopt_package}" | awk '{print $1}')

buildopt_source_archive="${buildopt_root}/micronaut.tar.gz"
buildopt_source_url=$(jq -er '.repository.sourceArchiveUrl' "${buildopt_spec}")
buildopt_source_sha=$(jq -er '.repository.sourceArchiveSha256' "${buildopt_spec}")
curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
    --output "${buildopt_source_archive}" "${buildopt_source_url}"
[[ "$(sha256sum "${buildopt_source_archive}" | awk '{print $1}')" == \
    "${buildopt_source_sha}" ]] || {
    printf 'Micronaut source archive checksum mismatch\n' >&2
    exit 1
}
tar -xzf "${buildopt_source_archive}" --strip-components=1 -C "${buildopt_root}/source"

buildopt_assert_sha() {
    local buildopt_relative=$1
    local buildopt_expected=$2
    [[ "$(sha256sum "${buildopt_root}/source/${buildopt_relative}" | awk '{print $1}')" == \
        "${buildopt_expected}" ]] || {
        printf 'Micronaut fixed input checksum mismatch: %s\n' "${buildopt_relative}" >&2
        exit 1
    }
}
buildopt_assert_sha gradle/wrapper/gradle-wrapper.properties \
    "$(jq -er '.repository.gradleWrapperPropertiesSha256' "${buildopt_spec}")"
buildopt_assert_sha gradle.properties \
    "$(jq -er '.repository.gradlePropertiesSha256' "${buildopt_spec}")"
buildopt_assert_sha settings.gradle \
    "$(jq -er '.repository.settingsSha256' "${buildopt_spec}")"
buildopt_assert_sha build.gradle \
    "$(jq -er '.repository.rootBuildSha256' "${buildopt_spec}")"
buildopt_assert_sha http-client-jdk/build.gradle.kts \
    "$(jq -er '.repository.changedProjectBuildSha256' "${buildopt_spec}")"
buildopt_assert_sha .github/workflows/gradle.yml \
    "$(jq -er '.repository.upstreamBuildWorkflowSha256' "${buildopt_spec}")"
buildopt_change_path=$(jq -er '.candidate.changePath' "${buildopt_spec}")
buildopt_assert_sha "${buildopt_change_path}" \
    "$(jq -er '.candidate.changeOriginalSha256' "${buildopt_spec}")"

buildopt_preflight_started=$(date +%s%N)
if ! (
    cd "${buildopt_root}/source"
    env -u CI GRADLE_USER_HOME="${buildopt_root}/preflight-home" \
        "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
        timeout 20m ./gradlew --daemon --build-cache --parallel \
        --no-configuration-cache --console=plain \
        --max-workers=12 --no-scan assemble
) >"${buildopt_root}/logs/preflight.log" 2>&1; then
    tail -n 180 "${buildopt_root}/logs/preflight.log" >&2
    printf 'Micronaut assemble preflight failed\n' >&2
    exit 1
fi
buildopt_preflight_finished=$(date +%s%N)
grep -Fq 'BUILD SUCCESSFUL' "${buildopt_root}/logs/preflight.log" || {
    printf 'Micronaut preflight lacks success marker\n' >&2
    exit 1
}
! grep -Eq '^> Task .*:test($| )' "${buildopt_root}/logs/preflight.log" || {
    printf 'Micronaut preflight executed a Gradle Test task\n' >&2
    exit 1
}
buildopt_assert_sha gradle/wrapper/gradle-wrapper.jar \
    "$(jq -er '.repository.gradleWrapperJarSha256' "${buildopt_spec}")"
buildopt_stop_gradle "${buildopt_root}/source" "${buildopt_root}/preflight-home"

buildopt_readonly_cache="${buildopt_root}/readonly-dependencies"
mkdir -p -- "${buildopt_readonly_cache}"
cp -a -- "${buildopt_root}/preflight-home/caches/modules-2" \
    "${buildopt_readonly_cache}/modules-2"
find "${buildopt_readonly_cache}/modules-2" -type f \
    \( -name '*.lock' -o -name gc.properties \) -delete
chmod -R a-w "${buildopt_readonly_cache}"
buildopt_readonly_cache_sha=$(
    cd "${buildopt_readonly_cache}"
    find modules-2 -type f -print0 | sort -z |
        xargs -0 sha256sum | sha256sum | awk '{print $1}'
)
buildopt_cache_seed="${buildopt_root}/build-cache-seed.tar.gz"
tar -C "${buildopt_root}/preflight-home/caches" -czf \
    "${buildopt_cache_seed}" build-cache-1
buildopt_cache_seed_sha=$(sha256sum "${buildopt_cache_seed}" | awk '{print $1}')

jq -n '
    {
        schemaVersion: "buildopt.build-impact/manifest/v1",
        manifestVersion: 1,
        repositoryId: "micronaut-projects/micronaut-core",
        pipelineClass: "poc-structural-transfer-assemble-v1",
        ownership: "REPOSITORY_COMMITTED",
        originalEntrypoints: ["assemble"],
        allowedAlternatives: [{
            id: "micronaut-http-client-jdk-assemble",
            entrypoints: [":micronaut-http-client-jdk:assemble"]
        }],
        requiredArtifacts: [{
            id: "micronaut-http-client-jdk-library",
            path: "http-client-jdk/build/libs/**",
            owner: "BUILD_OPTIMIZATION"
        }],
        requiredChecks: [],
        globalChangePaths: [
            ".github/workflows/**", "build.gradle", "gradle/**",
            "gradle.properties", "settings.gradle"
        ],
        unknownChangePolicy: "FULL_GRAPH"
    }
' >"${buildopt_root}/buildopt-impact-manifest.json"

buildopt_checkout="${buildopt_root}/work/checkout"
buildopt_home="${buildopt_root}/work/gradle-home"
mkdir -p -- "${buildopt_checkout}" "${buildopt_home}"
tar -xzf "${buildopt_source_archive}" --strip-components=1 -C "${buildopt_checkout}"
cp -- "${buildopt_root}/source/gradle/wrapper/gradle-wrapper.jar" \
    "${buildopt_checkout}/gradle/wrapper/gradle-wrapper.jar"
cp -a -- "${buildopt_root}/preflight-home/wrapper" "${buildopt_home}/wrapper"
cp -- "${buildopt_checkout}/${buildopt_change_path}" \
    "${buildopt_root}/changed-source.original"
cp -- "${buildopt_root}/buildopt-impact-manifest.json" \
    "${buildopt_checkout}/buildopt-impact-manifest.json"

env GRADLE_USER_HOME="${buildopt_home}" \
    GRADLE_RO_DEP_CACHE="${buildopt_readonly_cache}" \
    "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
    "${buildopt_impact_executable}" generate \
    --repository "${buildopt_checkout}" \
    --manifest buildopt-impact-manifest.json \
    --repository-id micronaut-projects/micronaut-core \
    --pipeline-class poc-structural-transfer-assemble-v1 \
    --graph buildopt-impact-graph.generated.json \
    --generated-manifest buildopt-impact.generated.json \
    --gradle-command ./gradlew --timeout 15m >/dev/null
buildopt_graph="${buildopt_checkout}/buildopt-impact-graph.generated.json"
cp -- "${buildopt_graph}" "${buildopt_root}/buildopt-impact-graph.original.json"
jq -e --slurpfile spec "${buildopt_spec}" '
    .complete == true and
    (.projects | length) == $spec[0].discovery.expectedProjectCount and
    ([.entrypoints[].name] | sort) == [":micronaut-http-client-jdk:assemble", "assemble"] and
    (.entrypoints[] | select(.name == "assemble") |
        (.reachesProjects | length)) == $spec[0].workload.controlExpectedReachedProjectCount and
    (.entrypoints[] | select(.name == ":micronaut-http-client-jdk:assemble") |
        (.reachesProjects | length)) == $spec[0].candidate.expectedReachedProjectCount and
    all(.entrypoints[];
        .containsTestTasks == false and .unknownRelationships == false)
' "${buildopt_graph}" >/dev/null
buildopt_graph_sha=$(sha256sum "${buildopt_graph}" | awk '{print $1}')
buildopt_generated_manifest="${buildopt_checkout}/buildopt-impact.generated.json"
buildopt_generated_manifest_sha=$(sha256sum "${buildopt_generated_manifest}" | awk '{print $1}')
buildopt_graph_digest=$(jq -er '.graphDigest' "${buildopt_generated_manifest}")
buildopt_owner_glob="${buildopt_change_path%%/src/*}/**"
buildopt_ownership_summary=$(jq -c --arg ownerGlob "${buildopt_owner_glob}" '
    (.entrypoints[] | select(.name == ":micronaut-http-client-jdk:assemble") |
        .reachesProjects) as $candidate |
    [.projects[] |
        select((((.ownedSourcePaths // .sourcePaths) | index($ownerGlob)) != null)) |
        .path] as $owners |
    {
        ownerGlob: $ownerGlob,
        directOwners: $owners,
        directOwnerCount: ($owners | length),
        directOwnersOutsideCandidate: [
            $owners[] as $owner | select(($candidate | index($owner)) == null) | $owner
        ]
    }
' "${buildopt_graph}")
printf 'Micronaut observed graph: sha256=%s digest=%s generatedManifestSha256=%s ownership=%s\n' \
    "${buildopt_graph_sha}" "${buildopt_graph_digest}" \
    "${buildopt_generated_manifest_sha}" "${buildopt_ownership_summary}" >&2
[[ "${buildopt_graph_sha}" == "$(jq -er '.discovery.expectedGraphSha256' "${buildopt_spec}")" ]] || {
    printf 'Micronaut discovered graph drifted after preregistration\n' >&2
    exit 1
}
[[ "${buildopt_generated_manifest_sha}" == \
    "$(jq -er '.discovery.expectedGeneratedManifestSha256' "${buildopt_spec}")" ]] || {
    printf 'Micronaut generated manifest drifted after preregistration\n' >&2
    exit 1
}
jq -e --arg digest "$(jq -er '.discovery.expectedGraphDigest' "${buildopt_spec}")" \
    '.complete == true and .graphDigest == $digest and .fallbackReasons == []' \
    "${buildopt_generated_manifest}" >/dev/null

buildopt_qualification_source="${buildopt_repo_root}/benchmarks/results/poc-structural-profile-qualification-v1.json"
buildopt_qualification="${buildopt_checkout}/buildopt-structural-qualification.json"
cp -- "${buildopt_qualification_source}" "${buildopt_qualification}"
buildopt_qualification_sha=$(sha256sum "${buildopt_qualification}" | awk '{print $1}')
[[ "${buildopt_qualification_sha}" == \
    "$(jq -er '.profile.qualificationEvidenceSha256' "${buildopt_spec}")" ]] || {
    printf 'structural qualification evidence drifted after preregistration\n' >&2
    exit 1
}
(
    cd "${buildopt_checkout}"
    "${buildopt_executable}" profile qualify \
        --manifest buildopt-impact-manifest.json \
        --graph buildopt-impact-graph.generated.json \
        --generated-manifest buildopt-impact.generated.json \
        --evidence buildopt-structural-qualification.json
) >"${buildopt_checkout}/buildopt-qualified-profile.json"
buildopt_profile_sha=$(sha256sum \
    "${buildopt_checkout}/buildopt-qualified-profile.json" | awk '{print $1}')
jq -e --arg qualificationSha "${buildopt_qualification_sha}" '
    .schemaVersion == "buildopt.poc/qualified-profile/v4" and
    .profileVersion == 4 and
    .profileId == "qualified-structural-build-impact" and
    .repositoryId == "micronaut-projects/micronaut-core" and
    .pipelineClass == "poc-structural-transfer-assemble-v1" and
    .fallback == "NATIVE_FULL_GRAPH" and
    .mechanisms == {
        buildImpact: true, standardJarAdapter: false, safeCache: false,
        runtimeTuning: false, hotState: false, standardCopyAdapter: false,
        sharedEdgeCache: false
    } and
    [.preconditions[].path] == [
        "buildopt-impact-manifest.json",
        "buildopt-impact-graph.generated.json",
        "buildopt-impact.generated.json"
    ] and
    .qualification.schemaVersion ==
        "buildopt.evidence/structural-profile-qualification/v1" and
    .qualification.sha256 == $qualificationSha and
    .qualification.pairs == 8 and .qualification.meanSavedMs == 17561.625 and
    .qualification.reductionRatio == 0.7296935134545568 and
    .qualification.interval95SavedMs == [17018.875, 18118.375]
' "${buildopt_checkout}/buildopt-qualified-profile.json" >/dev/null
printf '%s\n' "${buildopt_change_path}" >"${buildopt_checkout}/.buildopt-changes"

buildopt_active_cache_seed="${buildopt_cache_seed}"
buildopt_reset_arm() {
    local buildopt_arm=$1
    cp -- "${buildopt_root}/changed-source.original" \
        "${buildopt_checkout}/${buildopt_change_path}"
    if ! (
        cd "${buildopt_checkout}"
        env -u CI GRADLE_USER_HOME="${buildopt_home}" \
            GRADLE_RO_DEP_CACHE="${buildopt_readonly_cache}" \
            "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
            ./gradlew --daemon --offline --quiet --max-workers=12 clean
    ) >"${buildopt_root}/logs/reset-${buildopt_arm}.log" 2>&1; then
        tail -n 180 "${buildopt_root}/logs/reset-${buildopt_arm}.log" >&2
        printf 'Micronaut %s arm reset failed before measurement\n' "${buildopt_arm}" >&2
        return 1
    fi
    rm -rf -- "${buildopt_home}/caches/build-cache-1"
    mkdir -p -- "${buildopt_home}/caches"
    tar -C "${buildopt_home}/caches" -xzf "${buildopt_active_cache_seed}"
    printf '\n// buildopt-poc-structural-transfer-fixed-change\n' \
        >>"${buildopt_checkout}/${buildopt_change_path}"
}

buildopt_duration_ms=0
buildopt_started_ns=0
buildopt_finished_ns=0
buildopt_max_rss_kb=0
buildopt_run_arm() {
    local buildopt_arm=$1
    local buildopt_log=$2
    local buildopt_time=$3
    local buildopt_compile_cache_policy=$4
    buildopt_started_ns=$(date +%s%N)
    if ! (
        cd "${buildopt_checkout}"
        if [[ "${buildopt_arm}" == candidate ]]; then
            /usr/bin/time -f 'maxRssKb=%M' -o "${buildopt_time}" \
                env -u CI GRADLE_USER_HOME="${buildopt_home}" \
                GRADLE_RO_DEP_CACHE="${buildopt_readonly_cache}" \
                "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
                timeout 10m "${buildopt_executable}" poc \
                --changes-file .buildopt-changes
        else
            /usr/bin/time -f 'maxRssKb=%M' -o "${buildopt_time}" \
                env -u CI GRADLE_USER_HOME="${buildopt_home}" \
                GRADLE_RO_DEP_CACHE="${buildopt_readonly_cache}" \
                "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
                timeout 10m ./gradlew --daemon --offline --build-cache --parallel \
                --no-configuration-cache --console=plain \
                --max-workers=12 --no-scan assemble
        fi
    ) >"${buildopt_log}" 2>&1; then
        tail -n 180 "${buildopt_log}" >&2
        printf 'Micronaut assemble %s arm failed\n' "${buildopt_arm}" >&2
        return 1
    fi
    buildopt_finished_ns=$(date +%s%N)
    buildopt_duration_ms=$(((buildopt_finished_ns - buildopt_started_ns) / 1000000))
    buildopt_max_rss_kb=$(awk -F= '$1 == "maxRssKb" {print $2 + 0}' "${buildopt_time}")
    grep -Fq 'BUILD SUCCESSFUL' "${buildopt_log}" || return 1
    if [[ "${buildopt_arm}" == candidate ]]; then
        grep -Fq 'explicit Build Impact POC candidate micronaut-http-client-jdk-assemble selected' \
            "${buildopt_log}" || return 1
        grep -Fq '"schemaVersion":"buildopt.poc/qualified-profile-plan/v4"' \
            "${buildopt_log}" || return 1
        grep -Fq '"profileId":"qualified-structural-build-impact"' \
            "${buildopt_log}" || return 1
        if grep -Eq 'managed L1 unavailable|plugin handshake|authenticated local gateway|exact-bound Build Impact POC hot state' \
            "${buildopt_log}"; then
            printf 'Micronaut candidate started an unrelated managed runtime or hot state\n' >&2
            return 1
        fi
    fi
    grep -Eq '^> Task :micronaut-http-client-jdk:compileJava( |$)' "${buildopt_log}" || {
        printf 'Micronaut %s arm did not reach changed http-client-jdk compileJava\n' "${buildopt_arm}" >&2
        return 1
    }
    if [[ "${buildopt_compile_cache_policy}" == REQUIRE_MISS ]]; then
        ! grep -Eq '^> Task :micronaut-http-client-jdk:compileJava FROM-CACHE$' \
            "${buildopt_log}" || {
            printf 'Micronaut %s warm-up replayed rather than compiled the fixed mutation\n' \
                "${buildopt_arm}" >&2
            return 1
        }
    elif [[ "${buildopt_compile_cache_policy}" != ALLOW_SHARED_NATIVE_HIT ]]; then
        printf 'invalid Micronaut compile-cache policy: %s\n' \
            "${buildopt_compile_cache_policy}" >&2
        return 1
    fi
    ! grep -Eq '^> Task .*:test($| )' "${buildopt_log}" || {
        printf 'Micronaut %s arm executed a Gradle Test task\n' "${buildopt_arm}" >&2
        return 1
    }
    if grep -Eq '^> Task .*:(publish|upload|release|sign)([A-Z:]|$)' "${buildopt_log}" ||
        grep -Eq 'Publishing build scan|Build scan published|https://gradle[.]com/s/' \
            "${buildopt_log}"; then
        printf 'Micronaut %s arm attempted an external action\n' "${buildopt_arm}" >&2
        return 1
    fi
}

buildopt_output_manifest() {
    local buildopt_manifest=$1
    local buildopt_root_path buildopt_file
    : >"${buildopt_manifest}"
    buildopt_root_path=$(jq -er '.candidate.requiredOutputRoot' "${buildopt_spec}")
    [[ -d "${buildopt_checkout}/${buildopt_root_path}" ]] || {
        printf 'Micronaut required output root is missing: %s\n' "${buildopt_root_path}" >&2
        return 1
    }
    while IFS= read -r -d '' buildopt_file; do
        printf '%s  %s\n' "$(sha256sum "${buildopt_file}" | awk '{print $1}')" \
            "${buildopt_file#"${buildopt_checkout}/"}" >>"${buildopt_manifest}"
    done < <(find "${buildopt_checkout}/${buildopt_root_path}" -type f -print0 | sort -z)
    LC_ALL=C sort -o "${buildopt_manifest}" "${buildopt_manifest}"
    [[ -s "${buildopt_manifest}" ]]
}

buildopt_reset_arm control
buildopt_run_arm control "${buildopt_root}/logs/warm-control.log" \
    "${buildopt_root}/logs/warm-control.time" REQUIRE_MISS
buildopt_reset_arm candidate
buildopt_run_arm candidate "${buildopt_root}/logs/warm-candidate.log" \
    "${buildopt_root}/logs/warm-candidate.time" REQUIRE_MISS
buildopt_candidate_cache_seed="${buildopt_root}/measured-build-cache-seed.tar.gz"
tar -C "${buildopt_home}/caches" -czf \
    "${buildopt_candidate_cache_seed}" build-cache-1
buildopt_candidate_cache_seed_sha=$(sha256sum "${buildopt_candidate_cache_seed}" | awk '{print $1}')
buildopt_active_cache_seed="${buildopt_candidate_cache_seed}"

buildopt_rows="${buildopt_root}/observations.jsonl"
: >"${buildopt_rows}"
for buildopt_pair in {1..8}; do
    buildopt_order=CANDIDATE_FIRST
    if ((buildopt_pair % 2 == 1)); then
        buildopt_order=CONTROL_FIRST
    fi
    buildopt_control_log="${buildopt_root}/logs/pair-${buildopt_pair}-control.log"
    buildopt_candidate_log="${buildopt_root}/logs/pair-${buildopt_pair}-candidate.log"
    buildopt_control_outputs="${buildopt_root}/control-${buildopt_pair}.outputs"
    buildopt_candidate_outputs="${buildopt_root}/candidate-${buildopt_pair}.outputs"
    if [[ "${buildopt_order}" == CONTROL_FIRST ]]; then
        buildopt_reset_arm control
        buildopt_run_arm control "${buildopt_control_log}" "${buildopt_control_log}.time" \
            ALLOW_SHARED_NATIVE_HIT
        buildopt_control_duration=${buildopt_duration_ms}
        buildopt_control_rss=${buildopt_max_rss_kb}
        buildopt_output_manifest "${buildopt_control_outputs}"
        buildopt_reset_arm candidate
        buildopt_first_finished=$(date +%s%N)
        buildopt_run_arm candidate "${buildopt_candidate_log}" "${buildopt_candidate_log}.time" \
            ALLOW_SHARED_NATIVE_HIT
        buildopt_candidate_duration=${buildopt_duration_ms}
        buildopt_candidate_rss=${buildopt_max_rss_kb}
        buildopt_output_manifest "${buildopt_candidate_outputs}"
    else
        buildopt_reset_arm candidate
        buildopt_run_arm candidate "${buildopt_candidate_log}" "${buildopt_candidate_log}.time" \
            ALLOW_SHARED_NATIVE_HIT
        buildopt_candidate_duration=${buildopt_duration_ms}
        buildopt_candidate_rss=${buildopt_max_rss_kb}
        buildopt_output_manifest "${buildopt_candidate_outputs}"
        buildopt_reset_arm control
        buildopt_first_finished=$(date +%s%N)
        buildopt_run_arm control "${buildopt_control_log}" "${buildopt_control_log}.time" \
            ALLOW_SHARED_NATIVE_HIT
        buildopt_control_duration=${buildopt_duration_ms}
        buildopt_control_rss=${buildopt_max_rss_kb}
        buildopt_output_manifest "${buildopt_control_outputs}"
    fi
    buildopt_gap_ms=$(((buildopt_started_ns - buildopt_first_finished) / 1000000))
    ((buildopt_gap_ms <= 5000)) || {
        printf 'Micronaut pair %s exceeded inter-arm gap: %s ms\n' \
            "${buildopt_pair}" "${buildopt_gap_ms}" >&2
        exit 1
    }
    cmp -s "${buildopt_control_outputs}" "${buildopt_candidate_outputs}" || {
        printf 'Micronaut required outputs differ in pair %s\n' "${buildopt_pair}" >&2
        exit 1
    }
    jq -cn --argjson pair "${buildopt_pair}" --arg order "${buildopt_order}" \
        --argjson control "${buildopt_control_duration}" \
        --argjson candidate "${buildopt_candidate_duration}" \
        --argjson gap "${buildopt_gap_ms}" --argjson controlRss "${buildopt_control_rss}" \
        --argjson candidateRss "${buildopt_candidate_rss}" \
        --arg outputSha "$(sha256sum "${buildopt_control_outputs}" | awk '{print $1}')" \
        --argjson outputCount "$(wc -l <"${buildopt_control_outputs}")" \
        --slurpfile spec "${buildopt_spec}" '
        {
            pair: $pair,
            order: $order,
            controlDurationMs: $control,
            candidateDurationMs: $candidate,
            savedMs: ($control - $candidate),
            interArmIdleGapMs: $gap,
            controlMaximumResidentSetKb: $controlRss,
            candidateMaximumResidentSetKb: $candidateRss,
            requiredOutputSha256: $outputSha,
            requiredOutputCount: $outputCount,
            controlEntrypoints: $spec[0].workload.controlEntrypoints,
            candidateEntrypoints: $spec[0].candidate.entrypoints,
            hotStateEnabled: false,
            safeCacheEnabled: false,
            standardJarAdapterEnabled: false,
            runtimeTuningEnabled: false,
            remoteCacheEnabled: false,
            rootBuildGradleTestTasksExecuted: false,
            productAttributableFailure: false
        }
    ' >>"${buildopt_rows}"
    printf 'Micronaut pair %s/8: control=%sms candidate=%sms saved=%sms order=%s\n' \
        "${buildopt_pair}" "${buildopt_control_duration}" "${buildopt_candidate_duration}" \
        "$((buildopt_control_duration - buildopt_candidate_duration))" "${buildopt_order}"
done

buildopt_reset_arm candidate
printf '\n' >>"${buildopt_graph}"
printf '%s\n' "${buildopt_change_path}" >"${buildopt_checkout}/.buildopt-changes"
buildopt_drift_fallback_log="${buildopt_root}/logs/drift-fallback.log"
if ! (
    cd "${buildopt_checkout}"
    env -u CI GRADLE_USER_HOME="${buildopt_home}" \
        GRADLE_RO_DEP_CACHE="${buildopt_readonly_cache}" \
        "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
        timeout 10m "${buildopt_executable}" poc \
        --changes-file .buildopt-changes
) >"${buildopt_drift_fallback_log}" 2>&1; then
    tail -n 180 "${buildopt_drift_fallback_log}" >&2
    printf 'Micronaut profile-drift fallback failed\n' >&2
    exit 1
fi
grep -Fq '"selectionReason":"PROFILE_PRECONDITION_FAILED"' \
    "${buildopt_drift_fallback_log}" || {
    printf 'Micronaut profile drift did not retain the full graph\n' >&2
    exit 1
}
grep -Eq '^> Task :micronaut-websocket:assemble( |$)' \
    "${buildopt_drift_fallback_log}" || {
    printf 'Micronaut profile-drift fallback did not execute outside candidate\n' >&2
    exit 1
}
grep -Fq 'BUILD SUCCESSFUL' "${buildopt_drift_fallback_log}" || exit 1
cp -- "${buildopt_root}/buildopt-impact-graph.original.json" "${buildopt_graph}"

buildopt_reset_arm candidate
printf '\n# buildopt-poc-global-fallback\n' >>"${buildopt_checkout}/gradle.properties"
printf 'gradle.properties\n' >"${buildopt_checkout}/.buildopt-changes"
buildopt_fallback_log="${buildopt_root}/logs/fallback.log"
if ! (
    cd "${buildopt_checkout}"
    env -u CI GRADLE_USER_HOME="${buildopt_home}" \
        GRADLE_RO_DEP_CACHE="${buildopt_readonly_cache}" \
        "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
        timeout 10m "${buildopt_executable}" poc \
        --changes-file .buildopt-changes
) >"${buildopt_fallback_log}" 2>&1; then
    tail -n 180 "${buildopt_fallback_log}" >&2
    printf 'Micronaut global fallback failed\n' >&2
    exit 1
fi
grep -Fq 'buildopt: Build Impact POC retained the full graph (IMPACT_GLOBAL_CHANGE)' \
    "${buildopt_fallback_log}" || {
    printf 'Micronaut global change did not retain the full assemble graph\n' >&2
    exit 1
}
grep -Eq '^> Task :micronaut-websocket:assemble( |$)' "${buildopt_fallback_log}" || {
    printf 'Micronaut fallback did not execute work outside http-client-jdk\n' >&2
    exit 1
}
grep -Fq 'BUILD SUCCESSFUL' "${buildopt_fallback_log}" || exit 1
! grep -Eq '^> Task .*:test($| )' "${buildopt_fallback_log}" || exit 1

jq -s '.' "${buildopt_rows}" >"${buildopt_root}/observations.json"
buildopt_captured_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
jq -n --arg capturedAt "${buildopt_captured_at}" --arg revision "${buildopt_revision}" \
    --arg specSha "${buildopt_spec_sha}" --arg runnerSha "${buildopt_runner_sha}" \
    --arg executableSha "${buildopt_executable_sha}" --arg packageSha "${buildopt_package_sha}" \
    --arg sourceSha "${buildopt_source_sha}" --arg cacheSha "${buildopt_cache_seed_sha}" \
    --arg qualificationSha "${buildopt_qualification_sha}" --arg profileSha "${buildopt_profile_sha}" \
    --arg candidateCacheSha "${buildopt_candidate_cache_seed_sha}" \
    --arg readOnlyCacheSha "${buildopt_readonly_cache_sha}" --arg graphSha "${buildopt_graph_sha}" \
    --argjson preflightMs "$(((buildopt_preflight_finished - buildopt_preflight_started) / 1000000))" \
    --slurpfile spec "${buildopt_spec}" --slurpfile rows "${buildopt_root}/observations.json" '
    def bootstrap_mean($data; $sample):
        reduce range(0; 8) as $draw
            ({state: ((2654435761 * ($sample + 1)) % 4294967296), sum: 0};
             .state = ((1664525 * .state + 1013904223) % 4294967296) |
             .sum += $data[((.state / 536870912) | floor)].savedMs) |
        .sum / 8;
    def bootstrap95($data):
        ([range(0; 4096) as $sample | bootstrap_mean($data; $sample)] | sort) as $r |
        [$r[102], $r[3993]];
    $rows[0] as $data |
    (($data | map(.controlDurationMs) | add) / 8) as $controlMean |
    (($data | map(.candidateDurationMs) | add) / 8) as $candidateMean |
    (($data | map(.savedMs) | add) / 8) as $mean |
    (($data | map(.savedMs) | add) / ($data | map(.controlDurationMs) | add)) as $ratio |
    bootstrap95($data) as $interval |
    ($data | map(select(.savedMs > 0)) | length) as $positive |
    ($mean >= $spec[0].valueGate.minimumSavedMs and
     $ratio >= $spec[0].valueGate.minimumReductionRatio and
     $interval[0] > 0 and
     $positive >= $spec[0].valueGate.minimumPositivePairs and
     ($data | map(.requiredOutputSha256) | unique | length) == 1 and
     all($data[]; .requiredOutputCount > 0 and (.hotStateEnabled | not) and
         (.safeCacheEnabled | not) and (.standardJarAdapterEnabled | not) and
         (.runtimeTuningEnabled | not) and (.remoteCacheEnabled | not) and
         (.rootBuildGradleTestTasksExecuted | not) and
         (.productAttributableFailure | not))) as $qualified |
    {
        schemaVersion: "buildopt.evidence/poc-structural-profile-adoption/v1",
        workItem: "POC-STRUCTURAL-PROFILE-001",
        capturedAt: $capturedAt,
        buildopt: {
            revision: $revision,
            executableSha256: $executableSha,
            packageSha256: $packageSha,
            packageVersion: "0.3.0-dev",
            candidateSurface: $spec[0].measurement.candidateSurface,
            launcherOverheadIncluded: true,
            runnerScriptSha256: $runnerSha
        },
        profile: {
            schemaVersion: $spec[0].profile.schemaVersion,
            profileId: $spec[0].profile.profileId,
            sha256: $profileSha,
            qualificationEvidenceSha256: $qualificationSha,
            materializedBeforeTiming: true,
            repositoryOwnedReviewRequired: true,
            productionAuthorized: false
        },
        specSha256: $specSha,
        repository: {
            nameWithOwner: $spec[0].repository.nameWithOwner,
            branch: $spec[0].repository.branch,
            revision: $spec[0].repository.revision,
            sourceArchiveSha256: $sourceSha
        },
        runner: $spec[0].runner,
        preparation: {
            onlinePreflightMeasured: false,
            onlinePreflightSuccess: true,
            onlinePreflightWallClockMs: $preflightMs,
            measuredNetwork: "DISCONNECTED",
            dependencyMode: "GRADLE_OFFLINE_WITH_SHARED_READ_ONLY_CACHE",
            readOnlyDependencyCacheSha256: $readOnlyCacheSha,
            buildCacheSeedSha256: $cacheSha,
            measuredBuildCacheSeedSha256: $candidateCacheSha,
            preflightDaemonStoppedBeforeArmSetup: true,
            cacheSeedRestoredBeforeEveryArm: true,
            sharedCheckout: true,
            sharedGradleUserHome: true,
            sharedDaemon: true,
            outputsRemovedBeforeEveryArm: true,
            fixedMutationAppliedAfterCacheRestore: true
        },
        discovery: {
            complete: true,
            containsTestTasks: false,
            graphSha256: $graphSha,
            graphDigest: $spec[0].discovery.expectedGraphDigest,
            projectCount: $spec[0].discovery.expectedProjectCount,
            controlReachCount: $spec[0].workload.controlExpectedReachedProjectCount,
            candidateReachCount: $spec[0].candidate.expectedReachedProjectCount,
            candidateEntrypoints: $spec[0].candidate.entrypoints,
            omittedProjectCount: ($spec[0].workload.controlExpectedReachedProjectCount -
                $spec[0].candidate.expectedReachedProjectCount),
            omittedProjectRatio: (($spec[0].workload.controlExpectedReachedProjectCount -
                $spec[0].candidate.expectedReachedProjectCount) /
                $spec[0].workload.controlExpectedReachedProjectCount)
        },
        observations: $data,
        fallback: {
            changePath: $spec[0].fallback.changePath,
            mode: "FULL_GRAPH",
            reason: "IMPACT_GLOBAL_CHANGE",
            outsideCandidateEntrypointObserved: ":micronaut-websocket:assemble",
            buildSuccessful: true,
            performanceClaim: false
        },
        driftFallback: {
            changedBinding: "BUILD_IMPACT_GRAPH_SHA256",
            mode: "FULL_GRAPH",
            reason: "PROFILE_PRECONDITION_FAILED",
            outsideCandidateEntrypointObserved: ":micronaut-websocket:assemble",
            buildSuccessful: true,
            performanceClaim: false
        },
        result: {
            pairs: 8,
            controlMeanMs: $controlMean,
            candidateMeanMs: $candidateMean,
            meanSavedMs: $mean,
            reductionRatio: $ratio,
            interval95SavedMs: $interval,
            positivePairs: $positive,
            qualified: $qualified,
            decision: (if $qualified then $spec[0].terminalDecisions.qualifies
                else $spec[0].terminalDecisions.failsValueGate end)
        },
        boundaries: $spec[0].boundaries
    }
' >"${buildopt_root}/result.json"

install -m 0600 "${buildopt_root}/result.json" "${buildopt_output}"
buildopt_completed=true
printf 'structural profile adoption evidence captured: %s\n' "${buildopt_output}"
