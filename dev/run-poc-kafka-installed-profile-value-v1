#!/usr/bin/env bash
set -euo pipefail

if (($# != 3)); then
    printf 'usage: %s OUTPUT_FILE BUILDOPT_BIN SOURCE_ARCHIVE\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
export BUILDOPT_POC_KAFKA_INSTALLED_PROFILE_VALUE=1
exec "${buildopt_script_dir}/run-poc-kafka-impact-edge-composition-v2" "$@"
