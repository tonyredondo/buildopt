#!/usr/bin/env bash
set -euo pipefail

buildopt_usage() {
    printf 'usage: %s [--toolchain <temurin-jdk-17|temurin-jdk-21|temurin-jdk-25|go|protoc|buf|shellcheck|actionlint|cosign|syft>] -- command [args...]\n' "$0"
}

buildopt_toolchain=temurin-jdk-21
if [[ "${1:-}" == "--help" ]]; then
    buildopt_usage
    exit 0
fi
if [[ "${1:-}" == "--toolchain" ]]; then
    if (($# < 2)); then
        buildopt_usage >&2
        exit 64
    fi
    buildopt_toolchain=$2
    shift 2
fi

case "${buildopt_toolchain}" in
    actionlint | buf | cosign | go | protoc | shellcheck | syft | \
        temurin-jdk-17 | temurin-jdk-21 | temurin-jdk-25) ;;
    *)
        buildopt_usage >&2
        exit 64
        ;;
esac
if [[ "${1:-}" != "--" ]]; then
    buildopt_usage >&2
    exit 64
fi
shift
if (($# == 0)); then
    buildopt_usage >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_lock=${BUILDOPT_TOOLCHAINS_LOCK_FILE:-"${buildopt_script_dir}/toolchains.lock.yaml"}
buildopt_tools_root=${BUILDOPT_TOOLS_ROOT:-"${buildopt_repo_root}/.tools"}

if [[ -z "${buildopt_tools_root}" || "${buildopt_tools_root}" == "/" ]]; then
    printf 'refusing unsafe tool root: %s\n' "${buildopt_tools_root:-<empty>}" >&2
    exit 1
fi
if ! command -v jq >/dev/null 2>&1; then
    printf 'jq is required to resolve the project toolchain\n' >&2
    exit 1
fi
if [[ ! -f "${buildopt_lock}" ]]; then
    printf 'missing toolchain lock: %s\n' "${buildopt_lock}" >&2
    exit 70
fi

if ! buildopt_entry=$(
    jq -ce --arg buildopt_id "${buildopt_toolchain}" '
        [
            .artifacts[] |
            select(.id == $buildopt_id)
        ] |
        if length == 1 then
            .[0]
        else
            error("expected exactly one toolchain entry")
        end
    ' "${buildopt_lock}"
); then
    printf 'invalid toolchain lock entry: %s\n' "${buildopt_toolchain}" >&2
    exit 70
fi

buildopt_id=$(jq -r '.id' <<<"${buildopt_entry}")
buildopt_version=$(jq -r '.version' <<<"${buildopt_entry}")
buildopt_kind=$(jq -r '.kind' <<<"${buildopt_entry}")
buildopt_platform=$(jq -r '.platform' <<<"${buildopt_entry}")
buildopt_provider=$(jq -r '.provider' <<<"${buildopt_entry}")
buildopt_url=$(jq -r '.url' <<<"${buildopt_entry}")
buildopt_sha256=$(jq -r '.sha256' <<<"${buildopt_entry}")
buildopt_tool_home="${buildopt_tools_root}/toolchains/${buildopt_id}-${buildopt_sha256:0:16}"
buildopt_manifest="${buildopt_tool_home}/.buildopt-toolchain.json"

if [[ ! "${buildopt_id}" =~ ^[a-z0-9][a-z0-9-]*$ ]] ||
    [[ ! "${buildopt_provider}" =~ ^[a-z0-9][a-z0-9-]*$ ]] ||
    [[ ! "${buildopt_sha256}" =~ ^[0-9a-f]{64}$ ]] ||
    [[ "${buildopt_kind}" != "binary" &&
        "${buildopt_kind}" != "tar.gz" &&
        "${buildopt_kind}" != "tar.xz" &&
        "${buildopt_kind}" != "zip" ]] ||
    [[ "${buildopt_platform}" != "linux-amd64" ]] ||
    [[ ! "${buildopt_url}" =~ ^https:// ]]; then
    printf 'malformed toolchain identity: %s\n' "${buildopt_toolchain}" >&2
    exit 70
fi

case "${buildopt_id}" in
    actionlint)
        if [[ "${buildopt_provider}" != "actionlint" ]] ||
            [[ "${buildopt_kind}" != "tar.gz" ]] ||
            [[ ! "${buildopt_version}" =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]]; then
            printf 'malformed actionlint toolchain identity\n' >&2
            exit 70
        fi
        ;;
    buf)
        if [[ "${buildopt_provider}" != "buf" ]] ||
            [[ "${buildopt_kind}" != "binary" ]] ||
            [[ ! "${buildopt_version}" =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]]; then
            printf 'malformed Buf toolchain identity\n' >&2
            exit 70
        fi
        ;;
    cosign)
        if [[ "${buildopt_provider}" != "sigstore" ]] ||
            [[ "${buildopt_kind}" != "binary" ]] ||
            [[ ! "${buildopt_version}" =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]]; then
            printf 'malformed cosign toolchain identity\n' >&2
            exit 70
        fi
        ;;
    go)
        if [[ "${buildopt_provider}" != "go-project" ]] ||
            [[ "${buildopt_kind}" != "tar.gz" ]] ||
            [[ ! "${buildopt_version}" =~ ^[0-9]+[.][0-9]+([.][0-9]+)?$ ]]; then
            printf 'malformed Go toolchain identity\n' >&2
            exit 70
        fi
        ;;
    protoc)
        if [[ "${buildopt_provider}" != "protocol-buffers" ]] ||
            [[ "${buildopt_kind}" != "zip" ]] ||
            [[ ! "${buildopt_version}" =~ ^[0-9]+[.][0-9]+([.][0-9]+)?$ ]]; then
            printf 'malformed protoc toolchain identity\n' >&2
            exit 70
        fi
        ;;
    shellcheck)
        if [[ "${buildopt_provider}" != "shellcheck" ]] ||
            [[ "${buildopt_kind}" != "tar.xz" ]] ||
            [[ ! "${buildopt_version}" =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]]; then
            printf 'malformed ShellCheck toolchain identity\n' >&2
            exit 70
        fi
        ;;
    syft)
        if [[ "${buildopt_provider}" != "anchore" ]] ||
            [[ "${buildopt_kind}" != "tar.gz" ]] ||
            [[ ! "${buildopt_version}" =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]]; then
            printf 'malformed Syft toolchain identity\n' >&2
            exit 70
        fi
        ;;
    temurin-jdk-17 | temurin-jdk-21 | temurin-jdk-25)
        if [[ "${buildopt_provider}" != "eclipse-adoptium" ]] ||
            [[ "${buildopt_kind}" != "tar.gz" ]] ||
            [[ ! "${buildopt_version}" =~ ^${buildopt_id##*-}([.]|$) ]]; then
            printf 'malformed JDK toolchain identity: %s\n' \
                "${buildopt_id}" >&2
            exit 70
        fi
        ;;
esac

if [[ ! -f "${buildopt_manifest}" ]]; then
    printf '%s is not provisioned; run: ./dev/bootstrap --toolchain %s\n' \
        "${buildopt_id}" \
        "${buildopt_id}" >&2
    exit 1
fi

if ! jq -e \
    --arg buildopt_id "${buildopt_id}" \
    --arg buildopt_version "${buildopt_version}" \
    --arg buildopt_provider "${buildopt_provider}" \
    --arg buildopt_sha256 "${buildopt_sha256}" \
    --arg buildopt_url "${buildopt_url}" \
    '
        .schemaVersion == "buildopt.dev/provisioned-toolchain/v1" and
        .id == $buildopt_id and
        .version == $buildopt_version and
        .provider == $buildopt_provider and
        .sha256 == $buildopt_sha256 and
        .url == $buildopt_url
    ' "${buildopt_manifest}" >/dev/null; then
    printf 'provisioned toolchain does not match the lock: %s\n' \
        "${buildopt_tool_home}" >&2
    exit 1
fi

case "${buildopt_id}" in
    actionlint)
        if [[ ! -x "${buildopt_tool_home}/bin/actionlint" ]]; then
            printf 'provisioned actionlint binary is unavailable: %s\n' \
                "${buildopt_tool_home}/bin/actionlint" >&2
            exit 1
        fi
        buildopt_actionlint_output=$(
            "${buildopt_tool_home}/bin/actionlint" -version 2>&1
        ) || {
            printf 'provisioned actionlint failed its version probe: %s\n' \
                "${buildopt_tool_home}/bin/actionlint" >&2
            exit 1
        }
        buildopt_actionlint_version=${buildopt_actionlint_output%%$'\n'*}
        if [[ "${buildopt_actionlint_version}" != "${buildopt_version}" ]]; then
            printf 'provisioned actionlint binary does not match %s\n' \
                "${buildopt_version}" >&2
            exit 1
        fi
        ;;
    buf)
        if [[ ! -x "${buildopt_tool_home}/bin/buf" ]]; then
            printf 'provisioned Buf binary is unavailable: %s\n' \
                "${buildopt_tool_home}/bin/buf" >&2
            exit 1
        fi
        buildopt_buf_output=$(
            "${buildopt_tool_home}/bin/buf" --version 2>&1
        ) || {
            printf 'provisioned Buf failed its version probe: %s\n' \
                "${buildopt_tool_home}/bin/buf" >&2
            exit 1
        }
        if [[ "${buildopt_buf_output}" != "${buildopt_version}" ]]; then
            printf 'provisioned Buf binary does not match %s\n' \
                "${buildopt_version}" >&2
            exit 1
        fi
        ;;
    cosign)
        if [[ ! -x "${buildopt_tool_home}/bin/cosign" ]]; then
            printf 'provisioned cosign binary is unavailable: %s\n' \
                "${buildopt_tool_home}/bin/cosign" >&2
            exit 1
        fi
        buildopt_cosign_output=$(
            "${buildopt_tool_home}/bin/cosign" version 2>&1
        ) || {
            printf 'provisioned cosign failed its version probe: %s\n' \
                "${buildopt_tool_home}/bin/cosign" >&2
            exit 1
        }
        buildopt_cosign_version=$(
            awk '$1 == "GitVersion:" {sub(/^v/, "", $2); print $2; exit}' \
                <<<"${buildopt_cosign_output}"
        )
        if [[ "${buildopt_cosign_version}" != "${buildopt_version}" ]]; then
            printf 'provisioned cosign binary does not match %s\n' \
                "${buildopt_version}" >&2
            exit 1
        fi
        ;;
    go)
        if [[ ! -x "${buildopt_tool_home}/bin/go" ]]; then
            printf 'provisioned Go binary is unavailable: %s\n' \
                "${buildopt_tool_home}/bin/go" >&2
            exit 1
        fi
        buildopt_go_output=$(
            GOENV=off \
            GOROOT="${buildopt_tool_home}" \
            GOTOOLCHAIN=local \
                "${buildopt_tool_home}/bin/go" version 2>&1
        ) || {
            printf 'provisioned Go failed its version probe: %s\n' \
                "${buildopt_tool_home}/bin/go" >&2
            exit 1
        }
        if [[ "${buildopt_go_output}" != \
            "go version go${buildopt_version} linux/amd64" ]]; then
            printf 'provisioned Go binary does not match %s\n' \
                "${buildopt_version}" >&2
            exit 1
        fi
        export GOENV=off
        export GOROOT="${buildopt_tool_home}"
        export GOTOOLCHAIN=local
        export GOPATH="${buildopt_tools_root}/state/go/gopath"
        export GOMODCACHE="${GOPATH}/pkg/mod"
        export GOCACHE="${buildopt_tools_root}/state/go/build-cache"
        ;;
    protoc)
        if [[ ! -x "${buildopt_tool_home}/bin/protoc" ]] ||
            [[ ! -f "${buildopt_tool_home}/include/google/protobuf/descriptor.proto" ]]; then
            printf 'provisioned protoc distribution is unavailable: %s\n' \
                "${buildopt_tool_home}" >&2
            exit 1
        fi
        buildopt_protoc_output=$(
            "${buildopt_tool_home}/bin/protoc" --version 2>&1
        ) || {
            printf 'provisioned protoc failed its version probe: %s\n' \
                "${buildopt_tool_home}/bin/protoc" >&2
            exit 1
        }
        if [[ "${buildopt_protoc_output}" != \
            "libprotoc ${buildopt_version}" ]]; then
            printf 'provisioned protoc binary does not match %s\n' \
                "${buildopt_version}" >&2
            exit 1
        fi
        ;;
    shellcheck)
        if [[ ! -x "${buildopt_tool_home}/bin/shellcheck" ]]; then
            printf 'provisioned ShellCheck binary is unavailable: %s\n' \
                "${buildopt_tool_home}/bin/shellcheck" >&2
            exit 1
        fi
        buildopt_shellcheck_output=$(
            "${buildopt_tool_home}/bin/shellcheck" --version 2>&1
        ) || {
            printf 'provisioned ShellCheck failed its version probe: %s\n' \
                "${buildopt_tool_home}/bin/shellcheck" >&2
            exit 1
        }
        buildopt_shellcheck_version=
        while IFS= read -r buildopt_shellcheck_line; do
            if [[ "${buildopt_shellcheck_line}" == "version: "* ]]; then
                buildopt_shellcheck_version=${buildopt_shellcheck_line#version: }
                break
            fi
        done <<<"${buildopt_shellcheck_output}"
        if [[ "${buildopt_shellcheck_version}" != "${buildopt_version}" ]]; then
            printf 'provisioned ShellCheck binary does not match %s\n' \
                "${buildopt_version}" >&2
            exit 1
        fi
        ;;
    syft)
        if [[ ! -x "${buildopt_tool_home}/bin/syft" ]]; then
            printf 'provisioned Syft binary is unavailable: %s\n' \
                "${buildopt_tool_home}/bin/syft" >&2
            exit 1
        fi
        buildopt_syft_output=$(
            "${buildopt_tool_home}/bin/syft" version 2>&1
        ) || {
            printf 'provisioned Syft failed its version probe: %s\n' \
                "${buildopt_tool_home}/bin/syft" >&2
            exit 1
        }
        buildopt_syft_version=$(
            awk '$1 == "Version:" {print $2; exit}' \
                <<<"${buildopt_syft_output}"
        )
        if [[ "${buildopt_syft_version}" != "${buildopt_version}" ]]; then
            printf 'provisioned Syft binary does not match %s\n' \
                "${buildopt_version}" >&2
            exit 1
        fi
        ;;
    temurin-jdk-17 | temurin-jdk-21 | temurin-jdk-25)
        if [[ ! -x "${buildopt_tool_home}/bin/java" ]] ||
            [[ ! -x "${buildopt_tool_home}/bin/javac" ]]; then
            printf 'provisioned Java binaries are unavailable: %s\n' \
                "${buildopt_tool_home}" >&2
            exit 1
        fi
        buildopt_runtime_version=${buildopt_version%%+*}
        buildopt_java_output=$(
            "${buildopt_tool_home}/bin/java" -version 2>&1
        ) || {
            printf 'provisioned java failed its version probe: %s\n' \
                "${buildopt_tool_home}/bin/java" >&2
            exit 1
        }
        buildopt_javac_output=$(
            "${buildopt_tool_home}/bin/javac" -version 2>&1
        ) || {
            printf 'provisioned javac failed its version probe: %s\n' \
                "${buildopt_tool_home}/bin/javac" >&2
            exit 1
        }
        if [[ "${buildopt_java_output}" != \
            *"version \"${buildopt_runtime_version}\""* ]] ||
            [[ "${buildopt_javac_output}" != \
                "javac ${buildopt_runtime_version}" ]]; then
            printf 'provisioned Java binaries do not match %s\n' \
                "${buildopt_version}" >&2
            exit 1
        fi
        export JAVA_HOME="${buildopt_tool_home}"
        ;;
esac

if [[ -n "${PATH:-}" ]]; then
    export PATH="${buildopt_tool_home}/bin:${PATH}"
else
    export PATH="${buildopt_tool_home}/bin"
fi

exec "$@"
