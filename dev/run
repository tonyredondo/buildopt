#!/usr/bin/env bash
set -euo pipefail

buildopt_usage() {
    printf 'usage: %s [--toolchain temurin-jdk-21] -- command [args...]\n' "$0"
}

buildopt_toolchain=temurin-jdk-21
if [[ "${1:-}" == "--help" ]]; then
    buildopt_usage
    exit 0
fi
if [[ "${1:-}" == "--toolchain" ]]; then
    if (($# < 2)); then
        buildopt_usage >&2
        exit 64
    fi
    buildopt_toolchain=$2
    shift 2
fi

if [[ "${buildopt_toolchain}" != "temurin-jdk-21" ]] ||
    [[ "${1:-}" != "--" ]]; then
    buildopt_usage >&2
    exit 64
fi
shift
if (($# == 0)); then
    buildopt_usage >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_lock=${BUILDOPT_TOOLCHAINS_LOCK_FILE:-"${buildopt_script_dir}/toolchains.lock.yaml"}
buildopt_tools_root=${BUILDOPT_TOOLS_ROOT:-"${buildopt_repo_root}/.tools"}

if [[ -z "${buildopt_tools_root}" || "${buildopt_tools_root}" == "/" ]]; then
    printf 'refusing unsafe tool root: %s\n' "${buildopt_tools_root:-<empty>}" >&2
    exit 1
fi
if ! command -v jq >/dev/null 2>&1; then
    printf 'jq is required to resolve the project toolchain\n' >&2
    exit 1
fi
if [[ ! -f "${buildopt_lock}" ]]; then
    printf 'missing toolchain lock: %s\n' "${buildopt_lock}" >&2
    exit 70
fi

if ! buildopt_entry=$(
    jq -ce --arg buildopt_id "${buildopt_toolchain}" '
        [
            .artifacts[] |
            select(.id == $buildopt_id)
        ] |
        if length == 1 then
            .[0]
        else
            error("expected exactly one toolchain entry")
        end
    ' "${buildopt_lock}"
); then
    printf 'invalid toolchain lock entry: %s\n' "${buildopt_toolchain}" >&2
    exit 70
fi

buildopt_id=$(jq -r '.id' <<<"${buildopt_entry}")
buildopt_version=$(jq -r '.version' <<<"${buildopt_entry}")
buildopt_kind=$(jq -r '.kind' <<<"${buildopt_entry}")
buildopt_platform=$(jq -r '.platform' <<<"${buildopt_entry}")
buildopt_provider=$(jq -r '.provider' <<<"${buildopt_entry}")
buildopt_url=$(jq -r '.url' <<<"${buildopt_entry}")
buildopt_sha256=$(jq -r '.sha256' <<<"${buildopt_entry}")
buildopt_runtime_version=${buildopt_version%%+*}
buildopt_jdk_home="${buildopt_tools_root}/toolchains/${buildopt_id}-${buildopt_sha256:0:16}"
buildopt_manifest="${buildopt_jdk_home}/.buildopt-toolchain.json"

if [[ ! "${buildopt_id}" =~ ^[a-z0-9][a-z0-9-]*$ ]] ||
    [[ ! "${buildopt_provider}" =~ ^[a-z0-9][a-z0-9-]*$ ]] ||
    [[ ! "${buildopt_sha256}" =~ ^[0-9a-f]{64}$ ]] ||
    [[ ! "${buildopt_version}" =~ ^21([.]|$) ]] ||
    [[ "${buildopt_kind}" != "tar.gz" ]] ||
    [[ "${buildopt_platform}" != "linux-amd64" ]] ||
    [[ ! "${buildopt_url}" =~ ^https:// ]]; then
    printf 'malformed toolchain identity: %s\n' "${buildopt_toolchain}" >&2
    exit 70
fi

if [[ ! -x "${buildopt_jdk_home}/bin/java" ]] ||
    [[ ! -x "${buildopt_jdk_home}/bin/javac" ]] ||
    [[ ! -f "${buildopt_manifest}" ]]; then
    printf '%s is not provisioned; run: ./dev/bootstrap --toolchain %s\n' \
        "${buildopt_id}" \
        "${buildopt_id}" >&2
    exit 1
fi

if ! jq -e \
    --arg buildopt_id "${buildopt_id}" \
    --arg buildopt_version "${buildopt_version}" \
    --arg buildopt_provider "${buildopt_provider}" \
    --arg buildopt_sha256 "${buildopt_sha256}" \
    --arg buildopt_url "${buildopt_url}" \
    '
        .schemaVersion == "buildopt.dev/provisioned-toolchain/v1" and
        .id == $buildopt_id and
        .version == $buildopt_version and
        .provider == $buildopt_provider and
        .sha256 == $buildopt_sha256 and
        .url == $buildopt_url
    ' "${buildopt_manifest}" >/dev/null; then
    printf 'provisioned toolchain does not match the lock: %s\n' \
        "${buildopt_jdk_home}" >&2
    exit 1
fi

buildopt_java_output=$("${buildopt_jdk_home}/bin/java" -version 2>&1) ||
    {
        printf 'provisioned java failed its version probe: %s\n' \
            "${buildopt_jdk_home}/bin/java" >&2
        exit 1
    }
buildopt_javac_output=$("${buildopt_jdk_home}/bin/javac" -version 2>&1) ||
    {
        printf 'provisioned javac failed its version probe: %s\n' \
            "${buildopt_jdk_home}/bin/javac" >&2
        exit 1
    }
if [[ "${buildopt_java_output}" != *"version \"${buildopt_runtime_version}\""* ]] ||
    [[ "${buildopt_javac_output}" != "javac ${buildopt_runtime_version}" ]]; then
    printf 'provisioned Java binaries do not match %s\n' \
        "${buildopt_version}" >&2
    exit 1
fi

export JAVA_HOME="${buildopt_jdk_home}"
if [[ -n "${PATH:-}" ]]; then
    export PATH="${JAVA_HOME}/bin:${PATH}"
else
    export PATH="${JAVA_HOME}/bin"
fi

exec "$@"
