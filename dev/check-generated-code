#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_manifest="${buildopt_script_dir}/generated-artifacts.json"
buildopt_policy="${buildopt_repo_root}/GENERATED_CODE.md"
buildopt_generator="${buildopt_script_dir}/generate-code"
buildopt_test_root=$(mktemp -d)

buildopt_cleanup() {
    if [[ "${buildopt_test_root}" == /tmp/* ]] &&
        [[ -d "${buildopt_test_root}" ]]; then
        rm -rf -- "${buildopt_test_root}"
    fi
}
trap buildopt_cleanup EXIT

for buildopt_command in cmp diff git grep head jq mktemp; do
    if ! command -v "${buildopt_command}" >/dev/null 2>&1; then
        printf 'required generated-code check command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    fi
done
if [[ ! -f "${buildopt_manifest}" ]] || [[ ! -f "${buildopt_policy}" ]]; then
    printf 'generated-code manifest or policy is missing\n' >&2
    exit 1
fi

if ! buildopt_artifacts=$(
    jq -ce '
        if keys == ["artifacts", "schemaVersion"] and
            .schemaVersion == "buildopt.dev/generated-artifacts/v1" and
            (.artifacts | type) == "array" and
            (.artifacts | length) > 0 and
            ([.artifacts[].id] | unique | length) == (.artifacts | length)
        then
            .artifacts
        else
            error("invalid generated-artifact manifest")
        end
    ' "${buildopt_manifest}"
); then
    printf 'generated-artifact manifest is malformed\n' >&2
    exit 70
fi

for buildopt_policy_rule in \
    "never edit the output manually" \
    "Inspect the semantic source diff" \
    "CI never rewrites the checkout" \
    "\`F0-022\` owns"; do
    if ! grep -Fq "${buildopt_policy_rule}" "${buildopt_policy}"; then
        printf 'generated-code policy is missing rule: %s\n' \
            "${buildopt_policy_rule}" >&2
        exit 1
    fi
done

buildopt_before_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)
buildopt_regenerated_root="${buildopt_test_root}/regenerated"
mapfile -t buildopt_entry_list < <(jq -c '.[]' <<<"${buildopt_artifacts}")
for buildopt_entry in "${buildopt_entry_list[@]}"; do
    buildopt_id=$(jq -r '.id' <<<"${buildopt_entry}")
    buildopt_output_relative=$(jq -r '.outputs[0]' <<<"${buildopt_entry}")
    buildopt_expected="${buildopt_repo_root}/${buildopt_output_relative}"
    buildopt_actual="${buildopt_regenerated_root}/${buildopt_output_relative}"
    if [[ ! -f "${buildopt_expected}" ]]; then
        printf 'checked-in generated output is missing: %s\n' \
            "${buildopt_output_relative}" >&2
        exit 1
    fi
    buildopt_marker_prefix='#'
    if [[ "${buildopt_id}" == openapi-*-client-v1 ]]; then
        buildopt_marker_prefix='//'
    fi
    if [[ "$(head -n 1 "${buildopt_expected}")" != \
        "${buildopt_marker_prefix} Code generated by ./dev/generate-code --artifact ${buildopt_id}; DO NOT EDIT." ]]; then
        printf 'generated output has no exact source marker: %s\n' \
            "${buildopt_output_relative}" >&2
        exit 1
    fi
    "${buildopt_generator}" \
        --artifact "${buildopt_id}" \
        --output-root "${buildopt_regenerated_root}" >/dev/null
    if ! cmp -s "${buildopt_expected}" "${buildopt_actual}"; then
        printf 'generated output is stale: %s\n' \
            "${buildopt_output_relative}" >&2
        diff -u "${buildopt_expected}" "${buildopt_actual}" >&2 || true
        exit 1
    fi
done

for buildopt_entry in "${buildopt_entry_list[@]}"; do
    buildopt_id=$(jq -r '.id' <<<"${buildopt_entry}")
    buildopt_output_relative=$(jq -r '.outputs[0]' <<<"${buildopt_entry}")
    mapfile -t buildopt_sources < <(jq -r '.sources[]' <<<"${buildopt_entry}")
    for buildopt_mutated_index in "${!buildopt_sources[@]}"; do
        buildopt_mutated_source_root="${buildopt_test_root}/mutated-source/${buildopt_id}/${buildopt_mutated_index}"
        buildopt_mutated_output_root="${buildopt_test_root}/mutated-output/${buildopt_id}/${buildopt_mutated_index}"
        for buildopt_source_relative in "${buildopt_sources[@]}"; do
            mkdir -p -- \
                "${buildopt_mutated_source_root}/$(dirname -- "${buildopt_source_relative}")"
            cp -- \
                "${buildopt_repo_root}/${buildopt_source_relative}" \
                "${buildopt_mutated_source_root}/${buildopt_source_relative}"
        done
        buildopt_source_relative=${buildopt_sources[buildopt_mutated_index]}
        if [[ "${buildopt_id}" == "local-events-v1-descriptor" ]]; then
            printf '\nmessage GeneratedDriftFixture {\n  string value = 1;\n}\n' \
                >>"${buildopt_mutated_source_root}/${buildopt_source_relative}"
        else
            printf '\n# generated drift fixture\n' \
                >>"${buildopt_mutated_source_root}/${buildopt_source_relative}"
        fi
        "${buildopt_generator}" \
            --artifact "${buildopt_id}" \
            --source-root "${buildopt_mutated_source_root}" \
            --output-root "${buildopt_mutated_output_root}" >/dev/null
        if cmp -s \
            "${buildopt_repo_root}/${buildopt_output_relative}" \
            "${buildopt_mutated_output_root}/${buildopt_output_relative}"; then
            printf 'generated-code check did not detect source drift: %s/%s\n' \
                "${buildopt_id}" \
                "${buildopt_source_relative}" >&2
            exit 1
        fi
    done
done

set +e
"${buildopt_generator}" \
    --artifact unsupported-generated-artifact >/dev/null 2>&1
buildopt_unknown_exit=$?
"${buildopt_generator}" \
    --artifact local-events-v1-descriptor \
    --output-root / >/dev/null 2>&1
buildopt_unsafe_exit=$?
set -e
if ((buildopt_unknown_exit != 64)) || ((buildopt_unsafe_exit != 1)); then
    printf 'unexpected generated-code error contract: %s/%s\n' \
        "${buildopt_unknown_exit}" \
        "${buildopt_unsafe_exit}" >&2
    exit 1
fi

buildopt_after_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)
if [[ "${buildopt_after_status}" != "${buildopt_before_status}" ]]; then
    printf 'generated-code check changed the working tree\n' >&2
    exit 1
fi

printf 'F0-005 generated-code drift OK: %s artifact(s), every source mutation rejected\n' \
    "${#buildopt_entry_list[@]}"
