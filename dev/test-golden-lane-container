#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_runner="${buildopt_script_dir}/run-golden-lane-container"
buildopt_checker="${buildopt_script_dir}/check-golden-lane"
buildopt_container_build="${buildopt_script_dir}/golden-lane-build"
buildopt_spec="${buildopt_repo_root}/specs/golden-lane-runner-v1.json"
buildopt_test_root=$(mktemp -d)

buildopt_cleanup() {
    rm -rf -- "${buildopt_test_root}"
}
trap buildopt_cleanup EXIT

buildopt_before_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)

buildopt_repository=$(jq -r '.container.repository' "${buildopt_spec}")
buildopt_index_digest=$(jq -r '.container.indexDigest' "${buildopt_spec}")
buildopt_platform_digest=$(jq -r '.container.platformDigest' "${buildopt_spec}")
buildopt_image=$(jq -r '.container.reference' "${buildopt_spec}")
buildopt_jdk_version=$(jq -r '.jdk.version' "${buildopt_spec}")
buildopt_index_reference="${buildopt_repository}@${buildopt_index_digest}"

buildopt_fake_bin="${buildopt_test_root}/fake-bin"
mkdir "${buildopt_fake_bin}"

# The generated fixture expands variables when the fake Docker client runs.
# shellcheck disable=SC1003,SC2016
printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    '{' \
    '    printf '\''%s'\'' "${1:-}"' \
    '    for buildopt_arg in "${@:2}"; do' \
    '        printf '\''\t%s'\'' "${buildopt_arg}"' \
    '    done' \
    '    printf '\''\n'\''' \
    '} >>"${BUILDOPT_TEST_DOCKER_LOG}"' \
    'case "${1:-}" in' \
    '    info)' \
    '        exit "${BUILDOPT_TEST_INFO_EXIT:-0}"' \
    '        ;;' \
    '    manifest)' \
    '        [[ "${2:-}" == "inspect" ]] || exit 64' \
    '        [[ "${3:-}" == "${BUILDOPT_TEST_INDEX_REFERENCE}" ]] || exit 65' \
    '        jq -n \' \
    '            --arg buildopt_digest "${BUILDOPT_TEST_MANIFEST_PLATFORM_DIGEST}" \' \
    '            '\''{' \
    '                mediaType: "application/vnd.oci.image.index.v1+json",' \
    '                manifests: [' \
    '                    {' \
    '                        digest: $buildopt_digest,' \
    '                        platform: {' \
    '                            os: "linux",' \
    '                            architecture: "amd64"' \
    '                        }' \
    '                    },' \
    '                    {' \
    '                        digest: ("sha256:" + ("f" * 64)),' \
    '                        platform: {' \
    '                            os: "unknown",' \
    '                            architecture: "unknown"' \
    '                        }' \
    '                    }' \
    '                ]' \
    '            }'\''' \
    '        ;;' \
    '    pull)' \
    '        exit "${BUILDOPT_TEST_PULL_EXIT:-0}"' \
    '        ;;' \
    '    image)' \
    '        [[ "${2:-}" == "inspect" ]] || exit 64' \
    '        [[ "${3:-}" == "${BUILDOPT_TEST_IMAGE_REFERENCE}" ]] || exit 65' \
    '        jq -n \' \
    '            --arg buildopt_digest "${BUILDOPT_TEST_IMAGE_DIGEST}" \' \
    '            --arg buildopt_os "${BUILDOPT_TEST_IMAGE_OS:-linux}" \' \
    '            --arg buildopt_arch "${BUILDOPT_TEST_IMAGE_ARCH:-amd64}" \' \
    '            '\''[' \
    '                {' \
    '                    Id: $buildopt_digest,' \
    '                    RepoDigests: [' \
    '                        ("eclipse-temurin@" + $buildopt_digest)' \
    '                    ],' \
    '                    Os: $buildopt_os,' \
    '                    Architecture: $buildopt_arch' \
    '                }' \
    '            ]'\''' \
    '        ;;' \
    '    run)' \
    '        printf '\''fake golden container build OK\n'\''' \
    '        exit "${BUILDOPT_TEST_RUN_EXIT:-0}"' \
    '        ;;' \
    '    *)' \
    '        exit 64' \
    '        ;;' \
    'esac' \
    >"${buildopt_fake_bin}/docker"

# These fixtures make strict host-resource cases independent of the workstation.
# shellcheck disable=SC2016
printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf '\''%s\n'\'' "${BUILDOPT_TEST_CPU_COUNT:-4}"' \
    >"${buildopt_fake_bin}/getconf"
# shellcheck disable=SC2016
printf '%s\n' \
    '#!/usr/bin/env bash' \
    'if [[ "$*" == *MemTotal:* ]]; then' \
    '    printf '\''%s\n'\'' "${BUILDOPT_TEST_MEMORY_BYTES:-17179869184}"' \
    'else' \
    '    exec /usr/bin/awk "$@"' \
    'fi' \
    >"${buildopt_fake_bin}/awk"
chmod +x \
    "${buildopt_fake_bin}/awk" \
    "${buildopt_fake_bin}/docker" \
    "${buildopt_fake_bin}/getconf"

buildopt_run_fixture() {
    local buildopt_log=$1
    shift

    BUILDOPT_TEST_DOCKER_LOG="${buildopt_log}" \
    BUILDOPT_TEST_INDEX_REFERENCE="${buildopt_index_reference}" \
    BUILDOPT_TEST_MANIFEST_PLATFORM_DIGEST="${BUILDOPT_TEST_MANIFEST_PLATFORM_DIGEST:-${buildopt_platform_digest}}" \
    BUILDOPT_TEST_IMAGE_REFERENCE="${buildopt_image}" \
    BUILDOPT_TEST_IMAGE_DIGEST="${BUILDOPT_TEST_IMAGE_DIGEST:-${buildopt_platform_digest}}" \
    PATH="${buildopt_fake_bin}:${PATH}" \
        "${buildopt_runner}" "$@"
}

buildopt_smoke_log="${buildopt_test_root}/smoke.log"
buildopt_smoke_output=$(buildopt_run_fixture "${buildopt_smoke_log}" --smoke)
if [[ "${buildopt_smoke_output}" != *"Golden image digest OK"* ]] ||
    [[ "${buildopt_smoke_output}" != *"fake golden container build OK"* ]] ||
    [[ "${buildopt_smoke_output}" != \
        *"Golden container smoke OK: pinned digest on a non-contractual runner"* ]]; then
    printf 'golden container smoke did not report verified image execution\n' >&2
    exit 1
fi

mapfile -t buildopt_smoke_calls <"${buildopt_smoke_log}"
if ((${#buildopt_smoke_calls[@]} != 5)) ||
    [[ "${buildopt_smoke_calls[0]}" != "info" ]] ||
    [[ "${buildopt_smoke_calls[1]}" != \
        $'manifest\tinspect\t'"${buildopt_index_reference}" ]] ||
    [[ "${buildopt_smoke_calls[2]}" != \
        $'pull\t--quiet\t--platform\tlinux/amd64\t'"${buildopt_image}" ]] ||
    [[ "${buildopt_smoke_calls[3]}" != \
        $'image\tinspect\t'"${buildopt_image}" ]] ||
    [[ "${buildopt_smoke_calls[4]}" != \
        *$'run\t--rm\t--pull\tnever\t--platform\tlinux/amd64'* ]] ||
    [[ "${buildopt_smoke_calls[4]}" != \
        *$'\t--env\tBUILDOPT_GOLDEN_LANE_LAUNCHER_BINARY=/buildopt-host-tools/buildopt'* ]] ||
    [[ "${buildopt_smoke_calls[4]}" != \
        *$'\t--env\tBUILDOPT_GOLDEN_LANE_SERVER_BINARY=/buildopt-host-tools/buildopt-server'* ]] ||
    [[ "${buildopt_smoke_calls[4]}" != \
        *$'\t--env\tBUILDOPT_GOLDEN_LANE_USE_ACTIVE_JAVA=1'* ]] ||
    [[ "${buildopt_smoke_calls[4]}" != \
        *$'\t--volume\t'*':/buildopt-host-tools:ro'* ]] ||
    [[ "${buildopt_smoke_calls[4]}" != \
        *$'\t'"${buildopt_image}"$'\t./dev/golden-lane-build' ]]; then
    printf 'golden container smoke used an unexpected Docker command sequence\n' >&2
    exit 1
fi

buildopt_strict_log="${buildopt_test_root}/strict.log"
buildopt_strict_output=$(
    buildopt_run_fixture "${buildopt_strict_log}" --require-runner-class
)
buildopt_strict_run=$(tail -n 1 "${buildopt_strict_log}")
if [[ "${buildopt_strict_output}" != \
    *"ENV-008 golden container OK: pinned digest and 4-CPU/16-GiB cgroups"* ]] ||
    [[ "${buildopt_strict_run}" != *$'\t--cpus\t4'* ]] ||
    [[ "${buildopt_strict_run}" != *$'\t--memory\t17179869184'* ]] ||
    [[ "${buildopt_strict_run}" != \
        *$'\t--env\tBUILDOPT_EXPECT_CGROUP_LIMITS=1'* ]] ||
    [[ "${buildopt_strict_run}" != \
        *$'\t--env\tBUILDOPT_EXPECT_JAVA_VERSION='"${buildopt_jdk_version}"* ]]; then
    printf 'strict golden container did not enforce the runner contract\n' >&2
    exit 1
fi

set +e
BUILDOPT_TEST_INFO_EXIT=1 \
    buildopt_run_fixture "${buildopt_test_root}/daemon-failure.log" --smoke \
    >/dev/null 2>&1
buildopt_daemon_exit=$?
BUILDOPT_TEST_CPU_COUNT=2 \
    buildopt_run_fixture "${buildopt_test_root}/resource-failure.log" \
    --require-runner-class >/dev/null 2>&1
buildopt_resource_exit=$?
BUILDOPT_TEST_MANIFEST_PLATFORM_DIGEST="sha256:$(printf '0%.0s' {1..64})" \
    buildopt_run_fixture "${buildopt_test_root}/manifest-failure.log" --smoke \
    >/dev/null 2>&1
buildopt_manifest_exit=$?
BUILDOPT_TEST_PULL_EXIT=19 \
    buildopt_run_fixture "${buildopt_test_root}/pull-failure.log" --smoke \
    >/dev/null 2>&1
buildopt_pull_exit=$?
BUILDOPT_TEST_IMAGE_ARCH=arm64 \
    buildopt_run_fixture "${buildopt_test_root}/image-failure.log" --smoke \
    >/dev/null 2>&1
buildopt_image_exit=$?
BUILDOPT_TEST_RUN_EXIT=37 \
    buildopt_run_fixture "${buildopt_test_root}/run-failure.log" --smoke \
    >/dev/null 2>&1
buildopt_run_exit=$?
"${buildopt_runner}" --smoke unexpected >/dev/null 2>&1
buildopt_usage_exit=$?
set -e

if ((buildopt_daemon_exit != 1)) ||
    ((buildopt_resource_exit != 2)) ||
    ((buildopt_manifest_exit != 1)) ||
    ((buildopt_pull_exit != 1)) ||
    ((buildopt_image_exit != 1)) ||
    ((buildopt_run_exit != 37)) ||
    ((buildopt_usage_exit != 64)); then
    printf 'unexpected golden container error contract: %s/%s/%s/%s/%s/%s/%s\n' \
        "${buildopt_daemon_exit}" \
        "${buildopt_resource_exit}" \
        "${buildopt_manifest_exit}" \
        "${buildopt_pull_exit}" \
        "${buildopt_image_exit}" \
        "${buildopt_run_exit}" \
        "${buildopt_usage_exit}" >&2
    exit 1
fi

if grep -q '^pull' "${buildopt_test_root}/manifest-failure.log" ||
    grep -q '^image' "${buildopt_test_root}/pull-failure.log" ||
    grep -q '^run' "${buildopt_test_root}/image-failure.log"; then
    printf 'golden container continued after an image verification failure\n' >&2
    exit 1
fi

buildopt_bad_spec="${buildopt_test_root}/bad-spec.json"
jq '.container.reference = "docker.io/library/eclipse-temurin:latest"' \
    "${buildopt_spec}" >"${buildopt_bad_spec}"
set +e
BUILDOPT_GOLDEN_LANE_SPEC_FILE="${buildopt_bad_spec}" \
    "${buildopt_checker}" --static >/dev/null 2>&1
buildopt_spec_exit=$?
set -e
if ((buildopt_spec_exit == 0)); then
    printf 'golden lane static check accepted a mutable image reference\n' >&2
    exit 1
fi

buildopt_fake_java_bin="${buildopt_test_root}/fake-java-bin"
mkdir "${buildopt_fake_java_bin}"
printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf '\''    java.runtime.version = 21.0.10+7-LTS\n'\'' >&2' \
    'printf '\''    java.version = 21.0.10\n'\'' >&2' \
    >"${buildopt_fake_java_bin}/java"
chmod +x "${buildopt_fake_java_bin}/java"
set +e
BUILDOPT_EXPECT_JAVA_VERSION="${buildopt_jdk_version}" \
GRADLE_USER_HOME="${buildopt_test_root}/gradle-home" \
PATH="${buildopt_fake_java_bin}:${PATH}" \
    "${buildopt_container_build}" >/dev/null 2>&1
buildopt_java_exit=$?
set -e
if ((buildopt_java_exit != 1)); then
    printf 'golden container build accepted the wrong Java patch\n' >&2
    exit 1
fi

buildopt_after_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)
if [[ "${buildopt_after_status}" != "${buildopt_before_status}" ]]; then
    printf 'golden container tests changed the working tree\n' >&2
    exit 1
fi

printf 'ENV-008 golden container tests OK: digest, platform, resources, and failures\n'
