#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_contract="${buildopt_repo_root}/specs/poc-central-https-auth-v1.json"

if ! command -v jq >/dev/null 2>&1; then
    printf 'required central HTTPS command is unavailable: jq\n' >&2
    exit 1
fi

if ! jq -e '
    .schemaVersion == "buildopt.poc/central-https-auth/v1" and
    .workItem == "POC-CENTRAL-HTTPS-AUTH-001" and
    .listener.centralTransport == "HTTPS_ONLY" and
    .listener.minimumTLSVersion == "TLS_1_3" and
    .listener.externalIPv4AllowedOnlyWithTLS == true and
    .listener.plaintextExternalIPv4Allowed == false and
    .credential.entropyBytes == 32 and
    .credential.maximumLifetimeHours == 720 and
    .credential.storedForm == "DOMAIN_SEPARATED_SHA256_ONLY" and
    .credential.revocation == "EFFECTIVE_ON_NEXT_REQUEST_WITHOUT_RESTART" and
    .credential.capabilities == ["CACHE_READ", "CACHE_WRITE", "STATE_READ", "STATE_WRITE"] and
    (.scope | length) == 6 and
    .cacheRequest.namespaceHeader == "X-BuildOpt-Cache-Namespace" and
    .cacheRequest.requiresExactTokenNamespace == true and
    .cacheWrite.pendingAttemptHeader == "X-BuildOpt-Cache-Attempt" and
    .cacheWrite.requiresExactTokenRepositoryAndGeneration == true and
    .stateWrite.headMethod == "POST" and
    .stateWrite.firstGenerationPrecondition == "If-None-Match: *" and
    .stateWrite.staleHead == 412 and
    .failClosed.missingOrInvalidToken == 401 and
    .failClosed.missingCapability == 403 and
    .failClosed.wrongRepositoryScope == 404 and
    .failClosed.plaintextCentralRequest == 426 and
    .failClosed.secretInLogsOrResponses == false and
    .authority == {
        proofOfConcept: true,
        singleOwnerOperatedService: true,
        productionAuthorized: false,
        soakRequired: false,
        designPartnerRequired: false,
        testOptimization: "OUT_OF_SCOPE"
    } and
    (.deferred | index("GRADLE_GATEWAY_REMOTE_FORWARDING")) != null and
    (.deferred | index("PRODUCTION_HA_RBAC_KMS_BACKUPS")) != null
' "${buildopt_contract}" >/dev/null; then
    printf 'central HTTPS/authentication contract is malformed\n' >&2
    exit 1
fi

cd -- "${buildopt_repo_root}"
exec "${buildopt_script_dir}/run" \
    --toolchain go \
    -- \
    go test \
        -race \
        -count=1 \
        -run '^TestCentral' \
        ./internal/sharedcache \
        ./cmd/buildopt-server
