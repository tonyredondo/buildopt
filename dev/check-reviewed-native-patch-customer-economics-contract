#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
cd "${buildopt_repo_root}"

buildopt_contract=specs/poc-reviewed-native-patch-customer-economics-v1.json
buildopt_subjects=specs/poc-reviewed-native-patch-customer-economics-v1.subjects.json

jq -e '
  .schemaVersion == "buildopt.specs/poc-reviewed-native-patch-customer-economics/v1" and
  .predecessor == "QUALIFY_OWNER_COMPREHENSION_AND_ACCEPTANCE_TIME_UNMEASURED" and
  .sourceClassifier == "NORMALIZATION_AWARE_CACHEABILITY_V2" and
  .reusePolicy == "REVISIONS_TOOLCHAINS_AND_WORKFLOWS_ONLY_ALL_RESULT_ROWS_FRESH" and
  .sourceGate == {
    requiredConclusiveFamilies:5, minimumActionFamilies:1,
    maximumSelectedProposals:2, maximumSelectedFamilies:2
  } and
  .correctnessGate.maximumGradleStartsPerProposal == 6 and
  .correctnessGate.exactCompleteOutputs == true and
  .correctnessGate.crossRootRestoration == true and
  .correctnessGate.requiredInvalidation == true and
  .correctnessGate.exactRevert == true and
  .correctnessGate.maximumProductFailures == 0 and
  .valueGate.excludedStabilizations == 1 and
  .valueGate.balancedPairs == 8 and
  .valueGate.requiredPositivePairs == 8 and
  .valueGate.minimumMeanSavingMilliseconds == 500 and
  .valueGate.minimumMeanSavingPercent == 2 and
  .valueGate.positivePaired95Interval == true and
  .valueGate.nonRegressiveCandidateP95 == true and
  .reviewGate.firstExposure == true and
  .reviewGate.ownerReportedActiveSeconds == true and
  .reviewGate.maximumActiveReviewMinutes == 15 and
  .reviewGate.maximumProposalClarifications == 1 and
  .terminalGate.requiredNewPublicFamilies == 1 and
  .terminalGate.maximumCombinedPaybackBuilds == 300 and
  .budget.maximumAdditionalDiskGiB == 8 and
  .budget.minimumFreeDiskBeforePublicBuildGiB == 8 and
  .budget.stopBeforeNextStartFreeDiskGiB == 6 and
  .delivery.controlledForkOnly == true and .delivery.draftOnly == true and
  .delivery.upstreamPullRequest == false and
  .delivery.defaultBranchMutation == false and
  .delivery.mergeAuthorized == false and .delivery.forcePush == false and
  .boundaries.productionAuthorized == false and
  .boundaries.automaticApply == false and .boundaries.automaticMerge == false and
  .boundaries.soak == false and .boundaries.designPartner == false and
  .boundaries.testOptimization == "OUT_OF_SCOPE"
' "${buildopt_contract}" >/dev/null

jq -e '
  .schemaVersion == "buildopt.specs/poc-reviewed-native-patch-customer-economics-subjects/v1" and
  .reusePolicy == "PUBLIC_REVISIONS_ONLY_NO_PRIOR_RESULT_ROWS" and
  (.families | length) == 5 and
  ([.families[].key] | unique | length) == 5 and
  ([.families[].key] == ["ktor", "hibernate-orm", "spotless", "mockito", "spotbugs"]) and
  all(.families[];
    (.repository | startswith("https://github.com/") and endswith(".git")) and
    (.revision | test("^[0-9a-f]{40}$")))
' "${buildopt_subjects}" >/dev/null

if grep -Eq 'normalization-aware-cacheability-v2/(source-classification|patch-plan|public-correctness)|reviewed-native-patch-portfolio-v1/(result|selection|accepted-proposals)' \
    "${buildopt_contract}" "${buildopt_subjects}"; then
    printf 'RNCE contract must not consume predecessor result rows\n' >&2
    exit 1
fi

./dev/run --toolchain go -- go test ./cmd/reviewed-native-patch-customer-audit ./internal/normalizationaware
printf 'RNCE-001 contract OK: five fresh families, bounded third-family economics route\n'
