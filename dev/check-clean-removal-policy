#!/usr/bin/env bash
set -euo pipefail

buildopt_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${buildopt_repo_root}"

jq -e '
  .schemaVersion == "buildopt.specs/clean-removal-policy/v1" and
  .trackerId == "B-004" and
  .input.command == "GRADLE_WRAPPER_ARGV" and
  .input.originalArguments == "IMMUTABLE" and
  .eligibleWorkspace == ["VERIFIED_EMPTY_NEW", "PROVEN_STALE_SAFE_PERSISTENT"] and
  .taskContract.implementationType == "org.gradle.api.tasks.Delete" and
  .taskContract.coreTask == true and
  .taskContract.declaredOutputsOnly == true and
  .taskContract.addedActions == 0 and
  .taskContract.dependencies == 0 and
  .taskContract.finalizers == 0 and
  .taskContract.sideEffects == 0 and
  .taskContract.failureObserved == false and
  .preserveOn == ["NOT_AUTHORIZED", "MODEL_UNAVAILABLE", "CLEAN_MODEL_INCOMPLETE", "FAILURE_SEMANTICS", "FINALIZERS", "SIDE_EFFECTS", "CI_BARRIER", "RELEASE_CONTRACT", "REPRODUCIBILITY_VALIDATION"] and
  .multipleCleanTasks == "ALL_OR_NOTHING" and
  .cleanOnlyInvocation == "SKIP_WITHOUT_DEFAULT_TASKS" and
  .doesNotClose == ["A1-001", "A1-006", "A1-G06", "B-G01", "B-G02", "B-G04"]
' specs/clean-removal-policy-v1.json >/dev/null

go test -race ./internal/runtimeoptimizer
go vet ./internal/runtimeoptimizer
printf 'B-004 clean removal policy OK: exact model, immutable argv, all-or-nothing rewrite, fail-closed fixtures\n'
