#!/usr/bin/env bash
set -euo pipefail

if (($# != 3)); then
    printf 'usage: %s OUTPUT_FILE CONTROL_FIRST_JSON CANDIDATE_FIRST_JSON\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_control_first=$2
buildopt_candidate_first=$3
buildopt_profile=${BUILDOPT_POC_PAIRING_PROFILE:-FULL}

case "${buildopt_profile}" in
    FULL)
        buildopt_report_schema=buildopt.evidence/poc-pairing/v1
        buildopt_decision_schema=buildopt.evidence/poc-pairing-decision/v1
        buildopt_gate=POC-PAIRING-G01
        buildopt_required_cells=8
        ;;
    GROOVY_VALUE)
        buildopt_report_schema=buildopt.evidence/poc-groovy/v1
        buildopt_decision_schema=buildopt.evidence/poc-groovy-decision/v1
        buildopt_gate=POC-GROOVY-G01
        buildopt_required_cells=2
        ;;
    GROOVY_SHARED_VALUE)
        buildopt_report_schema=buildopt.evidence/poc-shared-groovy/v1
        buildopt_decision_schema=buildopt.evidence/poc-shared-groovy-decision/v1
        buildopt_gate=POC-SHARED-GROOVY-G01
        buildopt_required_cells=1
        ;;
    KOTLIN_LEAF_VALUE)
        buildopt_report_schema=buildopt.evidence/poc-leaf-kotlin/v1
        buildopt_decision_schema=buildopt.evidence/poc-leaf-kotlin-decision/v1
        buildopt_gate=POC-LEAF-KOTLIN-G01
        buildopt_required_cells=1
        ;;
    KOTLIN_STABILITY_VALUE)
        buildopt_report_schema=buildopt.evidence/poc-kotlin-stability/v1
        buildopt_decision_schema=buildopt.evidence/poc-kotlin-stability-decision/v1
        buildopt_gate=POC-KOTLIN-STABILITY-G01
        buildopt_required_cells=2
        ;;
    *)
        printf 'invalid POC-PAIRING-001 decision profile: %s\n' "${buildopt_profile}" >&2
        exit 64
        ;;
esac

if [[ "${buildopt_output}" != /* || -e "${buildopt_output}" ||
    ! -f "${buildopt_control_first}" || ! -f "${buildopt_candidate_first}" ]]; then
    printf 'invalid POC-PAIRING-001 decision input\n' >&2
    exit 64
fi
command -v jq >/dev/null 2>&1 || {
    printf 'required POC-PAIRING-001 decision command is unavailable: jq\n' >&2
    exit 1
}
command -v sha256sum >/dev/null 2>&1 || {
    printf 'required POC-PAIRING-001 decision command is unavailable: sha256sum\n' >&2
    exit 1
}

buildopt_control_first_sha=$(sha256sum "${buildopt_control_first}" | awk '{print $1}')
buildopt_candidate_first_sha=$(sha256sum "${buildopt_candidate_first}" | awk '{print $1}')

jq -n \
    --arg capturedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg controlFirstSha256 "${buildopt_control_first_sha}" \
    --arg candidateFirstSha256 "${buildopt_candidate_first_sha}" \
    --arg reportSchema "${buildopt_report_schema}" \
    --arg decisionSchema "${buildopt_decision_schema}" \
    --arg gateId "${buildopt_gate}" \
    --argjson requiredCells "${buildopt_required_cells}" \
    --slurpfile controlFirst "${buildopt_control_first}" \
    --slurpfile candidateFirst "${buildopt_candidate_first}" '
    if ($controlFirst | length) != 1 or ($candidateFirst | length) != 1 or
       $controlFirst[0].schemaVersion != $reportSchema or
       $candidateFirst[0].schemaVersion != $reportSchema or
       $controlFirst[0].methodology.startingPairOrder != "CONTROL_FIRST" or
       $candidateFirst[0].methodology.startingPairOrder != "CANDIDATE_FIRST" or
       $controlFirst[0].buildoptRevision != $candidateFirst[0].buildoptRevision or
       $controlFirst[0].publicArtifacts != $candidateFirst[0].publicArtifacts or
       $controlFirst[0].fixture != $candidateFirst[0].fixture
    then error("paired reports are incompatible") else . end |
    ([ $controlFirst[0].workloads[] | {id, classification} ] | sort_by(.id)) as $a |
    ([ $candidateFirst[0].workloads[] | {id, classification} ] | sort_by(.id)) as $b |
    ([$a[] as $left | $b[] |
        select(.id == $left.id and .classification == $left.classification) |
        .id] | sort) as $reproduced |
    ([$a[] as $left | $b[] |
        select(.id == $left.id and .classification != $left.classification) |
        .id] | sort) as $mismatched |
    ([$a[] as $left | $b[] |
        select(.id == $left.id and
               .classification == $left.classification and
               .classification == "BREADTH_GATE_FAILED") |
        .id] | sort) as $reproducedFailures |
    ([$a[] as $left | $b[] |
        select(.id == $left.id and
               .classification == $left.classification and
               .classification != "BREADTH_GATE_FAILED") |
        .id] | sort) as $reproducedQualified |
    ($mismatched | length == 0) as $stable |
    ($controlFirst[0].decision.qualifyingCells) as $controlQualifying |
    ($candidateFirst[0].decision.qualifyingCells) as $candidateQualifying |
    {
        schemaVersion: $decisionSchema,
        capturedAt: $capturedAt,
        buildoptRevision: $controlFirst[0].buildoptRevision,
        reports: {
            controlFirstSha256: $controlFirstSha256,
            candidateFirstSha256: $candidateFirstSha256
        },
        result: {
            classificationReproduced: $stable,
            reproducedCells: $reproduced,
            reproducedQualifiedCells: $reproducedQualified,
            reproducedFailureCells: $reproducedFailures,
            mismatchedCells: $mismatched,
            controlFirstQualifyingCells: $controlQualifying,
            candidateFirstQualifyingCells: $candidateQualifying,
            maximumObservedInterArmIdleGapMs: ([
                $controlFirst[0].workloads[].result.maximumInterArmIdleGapMs,
                $candidateFirst[0].workloads[].result.maximumInterArmIdleGapMs
            ] | max)
        },
        decision: {
            verdict: (if $stable then "CLASSIFICATIONS_REPRODUCED"
                      else "MEASUREMENT_UNSTABLE" end),
            breadthClaim: (if ($stable and $controlQualifying == $requiredCells and
                                  $candidateQualifying == $requiredCells)
                           then "BROADEN_SYNTHETIC_CLAIM"
                           else "RETAIN_QUALIFIED_SYNTHETIC_WORKLOADS_ONLY" end),
            productChangeAuthorization: {
                scope: (if ($reproducedFailures | length) > 0
                        then "REPRODUCED_FAILURE_CELLS_ONLY" else "NONE" end),
                authorizedCells: $reproducedFailures,
                blockedCells: $mismatched
            },
            nextExperiment: (if ($reproducedFailures | length) > 0
                             then "TARGET_REPRODUCED_VALUE_GAPS"
                             elif ($stable and $controlQualifying == $requiredCells and
                                     $candidateQualifying == $requiredCells)
                             then "NONE"
                             else "STOP_AND_REVIEW_MEASUREMENT_BOUNDARY" end)
        },
        gate: {
            id: $gateId,
            state: (if $stable then "PASSED" else "FAILED" end)
        },
        boundaries: {
            thresholdsChanged: false,
            universalSavingsClaimed: false,
            productionReadinessClaimed: false,
            eightHourSoakExecuted: false,
            externalDesignPartnerRequired: false,
            testOptimizationModified: false
        }
    }
    ' >"${buildopt_output}"
chmod 0600 "${buildopt_output}"

printf 'BuildOpt POC-PAIRING-001 decision assembled: %s\n' "${buildopt_output}"
