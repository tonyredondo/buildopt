#!/usr/bin/env bash
set -euo pipefail
umask 077

if (($# > 1)); then
    printf 'usage: %s [RESULT_DIR]\n' "$0" >&2
    exit 64
fi

buildopt_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
buildopt_result=${1:-${buildopt_root}/benchmarks/results/observed-request-public-portfolio-v1}
buildopt_config=${buildopt_root}/benchmarks/observed-request-portfolio-v1.json
buildopt_cohort=${buildopt_root}/benchmarks/results/fresh-generic-optimization-v1/cohort.json
for buildopt_command in awk cmp cp find gzip jq mktemp sha256sum; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf '%s is required\n' "${buildopt_command}" >&2
        exit 1
    }
done
[[ ${buildopt_result} == /* && -d ${buildopt_result} ]] || {
    printf 'result must be an existing absolute directory\n' >&2
    exit 1
}
for buildopt_file in contract.json summary.json observations.jsonl transitions.jsonl; do
    [[ -f ${buildopt_result}/${buildopt_file} && ! -L ${buildopt_result}/${buildopt_file} ]] || {
        printf 'portfolio result is missing: %s\n' "${buildopt_file}" >&2
        exit 1
    }
done
if find "${buildopt_result}" -type l -print -quit | grep -q .; then
    printf 'portfolio result contains a symbolic link\n' >&2
    exit 1
fi

buildopt_temporary=$(mktemp -d /tmp/buildopt-observed-portfolio-check.XXXXXX)
buildopt_cleanup() {
    case ${buildopt_temporary} in
        /tmp/buildopt-observed-portfolio-check.*) rm -rf -- "${buildopt_temporary}" ;;
        *) printf 'refusing to clean unexpected checker root: %s\n' "${buildopt_temporary}" >&2; return 1 ;;
    esac
}
trap buildopt_cleanup EXIT

buildopt_sha() {
    sha256sum "$1" | awk '{print $1}'
}

buildopt_expected_runner=$(buildopt_sha "${buildopt_root}/dev/run-observed-request-public-portfolio")
buildopt_expected_classifier=$(buildopt_sha "${buildopt_root}/internal/requestaligned/classification.go")
buildopt_expected_launcher=$(sha256sum \
    "${buildopt_root}/internal/launcher/request_portfolio.go" \
    "${buildopt_root}/internal/launcher/request_portfolio_capture.go" | sha256sum | awk '{print $1}')
buildopt_expected_init=$(buildopt_sha "${buildopt_root}/internal/launcher/request_portfolio.init.gradle")
buildopt_expected_compactor=$(buildopt_sha "${buildopt_root}/dev/compact-observed-request-public-portfolio")
env GOCACHE="${buildopt_temporary}/go-cache" "${buildopt_root}/dev/run" --toolchain go -- \
    go build -o "${buildopt_temporary}/buildopt" ./cmd/buildopt
# The campaign digest binds the executable that performed the capture. Go
# embeds checkout-dependent build metadata, so CI proves that the current
# sources compile and verifies the portable bindings below instead of claiming
# byte reproduction of an artifact built in another checkout.

jq -e \
    --arg config "$(buildopt_sha "${buildopt_config}")" \
    --arg cohort "$(buildopt_sha "${buildopt_cohort}")" \
    --arg runner "${buildopt_expected_runner}" \
    --arg classifier "${buildopt_expected_classifier}" \
    --arg launcher "${buildopt_expected_launcher}" \
    --arg init "${buildopt_expected_init}" \
    --arg compactor "${buildopt_expected_compactor}" '
  .schemaVersion=="buildopt.poc/observed-request-public-portfolio-contract/v1" and
  .workItem=="SWL-PORTFOLIO-003" and
  .configSha256==$config and .cohortSha256==$cohort and
  (.executableSha256|test("^[0-9a-f]{64}$")) and .runnerSha256==$runner and
  .classifierSha256==$classifier and .launcherSha256==$launcher and .initSha256==$init and
  .schedule=="FIXED_THREE_COMMAND_CYCLE_OVER_CHRONOLOGICAL_FIRST_PARENT_COMMITS" and
  .comparison=="PREVIOUS_SUCCESSFUL_OBSERVATION_OF_THE_SAME_EXACT_COMMAND" and
  .observationBudgetPerFamily==30 and .requiredRelevantTransitionsPerFamily==5 and
  .sameInvocationEvidence==true and .extraGradleBuilds==0 and
  .ordinaryRequestsOnly==true and .exactRequestPreserved==true and
  .historicalBuildOptStateImported==false and .historicalBuildOptTimingImported==false and
  .historicalBuildOptActionImported==false and .performanceMeasured==false and
  .selectionAuthorized==false and .activationAuthorized==false and
  .storage.encoding=="GZIP_RFC1952" and .storage.deterministicHeader==true and
  .storage.compressionLevel==9 and .storage.physicalPathSuffix==".gz" and
  .storage.contentDigestsAddressUncompressedJson==true and .storage.compactorSha256==$compactor
' "${buildopt_result}/contract.json" >/dev/null || {
    printf 'portfolio contract does not match the current frozen inputs\n' >&2
    exit 1
}

jq -e '
  .schemaVersion=="buildopt.poc/observed-request-public-portfolio-summary/v1" and
  .workItem=="SWL-PORTFOLIO-003" and .status=="COMPLETE" and
  .familyCount==5 and .completeFamilies==3 and .actionFamilies==4 and
  .productFailures==0 and .performanceMeasured==false and
  .selectionAuthorized==false and .activationAuthorized==false and
  .storageEncoding=="GZIP_RFC1952" and .contentDigestsAddressUncompressedJson==true and
  ([.families[].family]|sort)==["apache-groovy","apache-kafka","micronaut-core","opentelemetry-java-instrumentation","spring-framework"]
' "${buildopt_result}/summary.json" >/dev/null || {
    printf 'portfolio summary is invalid\n' >&2
    exit 1
}

# Validate chronological observations and the frozen command/revision schedule
# with a separate jq invocation whose input is the complete JSONL array.
jq -s -e --slurpfile config "${buildopt_config}" --slurpfile cohort "${buildopt_cohort}" \
    --slurpfile summary "${buildopt_result}/summary.json" '
  def commands($family): $config[0].families[]|select(.family==$family)|.commands;
  def targets($family): $cohort[0].families[]|select(.family==$family)|[.reserve[].sha,.primary[].sha];
  . as $observations |
  all($observations[];
    .performanceMeasured==false and .activationAuthorized==false and
    .exitCode==0 and .productFailure==false and
    .observationOrdinal>=1 and .observationOrdinal<=30 and
    .commandIndex==((.observationOrdinal-1)%3) and
    .command==commands(.family)[.commandIndex] and
    .revision==targets(.family)[.observationOrdinal-1] and
    .portfolioGeneration==.observationOrdinal and
    (.captureSha256|test("^[0-9a-f]{64}$")) and
    ((.captureComplete==true and .exactArgumentsPreserved==true and
      (.argumentsSha256|test("^[0-9a-f]{64}$")) and
      (.evidenceSha256|test("^[0-9a-f]{64}$"))) or
     (.captureComplete==false and .evidenceSha256==""))
  ) and
  all($summary[0].families[]; . as $family |
    ([$observations[]|select(.family==$family.family)]|length)==$family.observations and
    ([$observations[]|select(.family==$family.family)|.observationOrdinal] ==
      [range(1;$family.observations+1)]) and
    ([$observations[]|select(.family==$family.family and .productFailure==true)]|length)==$family.productFailures and
    ([$observations[]|select(.family==$family.family and .exitCode!=0)]|length)==$family.buildFailures
  )
' "${buildopt_result}/observations.jsonl" >/dev/null || {
    printf 'portfolio observations do not match the frozen schedule\n' >&2
    exit 1
}

jq -s -e --slurpfile config "${buildopt_config}" --slurpfile summary "${buildopt_result}/summary.json" '
  def commands($family): $config[0].families[]|select(.family==$family)|.commands;
  . as $transitions |
  all($transitions[];
    .performanceMeasured==false and .activationAuthorized==false and
    .observationOrdinal>=1 and .observationOrdinal<=30 and
    .commandIndex==((.observationOrdinal-1)%3) and .command==commands(.family)[.commandIndex] and
    (.status|IN("RELEVANT_COMPLETE","IRRELEVANT_TO_REQUEST","GLOBAL_OR_AMBIGUOUS","INPUT_UNAVAILABLE","BUILD_FAILURE","PRODUCT_FAILURE")) and
    ((.reportSha256=="" and .report=="" and .inputComplete==false and .testableActions==0) or
     ((.reportSha256|test("^[0-9a-f]{64}$")) and .report!=""))
  ) and
  all($summary[0].families[]; . as $family |
    ([$transitions[]|select(.family==$family.family and .reportSha256!="")]|length)==$family.comparableTransitions and
    ([$transitions[]|select(.family==$family.family and .status=="RELEVANT_COMPLETE")]|length)==$family.relevantTransitions and
    ([$transitions[]|select(.family==$family.family and .status=="RELEVANT_COMPLETE" and .testableActions==1)]|length)==$family.actionTransitions and
    $family.inputComplete==($family.relevantTransitions>=5) and
    $family.stopReason==(if $family.relevantTransitions>=5 then "RELEVANT_TARGET_MET" else "OBSERVATION_BUDGET_EXHAUSTED" end)
  )
' "${buildopt_result}/transitions.jsonl" >/dev/null || {
    printf 'portfolio transitions do not match the family summaries\n' >&2
    exit 1
}

buildopt_safe_reference() {
    local buildopt_relative=$1
    [[ -n ${buildopt_relative} && ${buildopt_relative} != /* && ${buildopt_relative} != *'..'* &&
       ${buildopt_relative} != *'//'* && ${buildopt_relative} != *$'\n'* ]]
}

buildopt_verify_compressed() {
    local buildopt_relative=$1
    local buildopt_expected=$2
    buildopt_safe_reference "${buildopt_relative}" || return 1
    local buildopt_physical=${buildopt_result}/${buildopt_relative}.gz
    [[ -f ${buildopt_physical} && ! -L ${buildopt_physical} ]] || return 1
    gzip -t -- "${buildopt_physical}"
    [[ $(gzip -cd -- "${buildopt_physical}" | sha256sum | awk '{print $1}') == "${buildopt_expected}" ]]
}

while IFS=$'\t' read -r buildopt_capture buildopt_capture_sha buildopt_evidence buildopt_evidence_sha; do
    buildopt_verify_compressed "${buildopt_capture}" "${buildopt_capture_sha}" || {
        printf 'capture evidence is invalid: %s\n' "${buildopt_capture}" >&2
        exit 1
    }
    if [[ -n ${buildopt_evidence_sha} ]]; then
        buildopt_verify_compressed "${buildopt_evidence}" "${buildopt_evidence_sha}" || {
            printf 'request evidence is invalid: %s\n' "${buildopt_evidence}" >&2
            exit 1
        }
    elif [[ -e ${buildopt_result}/${buildopt_evidence}.gz ]]; then
        printf 'incomplete observation unexpectedly has evidence: %s\n' "${buildopt_evidence}" >&2
        exit 1
    fi
done < <(jq -r '[.capture,.captureSha256,.evidence,.evidenceSha256]|@tsv' "${buildopt_result}/observations.jsonl")

while IFS=$'\t' read -r buildopt_report buildopt_report_sha; do
    [[ -z ${buildopt_report_sha} ]] && continue
    buildopt_verify_compressed "${buildopt_report}" "${buildopt_report_sha}" || {
        printf 'transition report is invalid: %s\n' "${buildopt_report}" >&2
        exit 1
    }
done < <(jq -r '[.report,.reportSha256]|@tsv' "${buildopt_result}/transitions.jsonl")

while IFS=$'\t' read -r buildopt_portfolio buildopt_portfolio_sha; do
    buildopt_safe_reference "${buildopt_portfolio}" || exit 1
    [[ -f ${buildopt_result}/${buildopt_portfolio} &&
       $(buildopt_sha "${buildopt_result}/${buildopt_portfolio}") == "${buildopt_portfolio_sha}" ]] || {
        printf 'family portfolio is invalid: %s\n' "${buildopt_portfolio}" >&2
        exit 1
    }
done < <(jq -r '.families[]|[.portfolio,.portfolioSha256]|@tsv' "${buildopt_result}/summary.json")

# Exercise the verifier's fail-closed boundary without mutating checked-in
# evidence: one changed byte must no longer match the content-addressed digest.
buildopt_first_reference=$(jq -s -r '.[0].capture' "${buildopt_result}/observations.jsonl")
buildopt_first_digest=$(jq -s -r '.[0].captureSha256' "${buildopt_result}/observations.jsonl")
gzip -cd -- "${buildopt_result}/${buildopt_first_reference}.gz" >"${buildopt_temporary}/tampered.json"
printf ' ' >>"${buildopt_temporary}/tampered.json"
[[ $(buildopt_sha "${buildopt_temporary}/tampered.json") != "${buildopt_first_digest}" ]] || {
    printf 'tamper fixture unexpectedly retained the evidence digest\n' >&2
    exit 1
}

printf 'Observed request public portfolio: PASS (128 observations, 113 transitions, 3/5 complete, 4/5 action)\n'
