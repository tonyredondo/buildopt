#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_contract="${buildopt_repo_root}/specs/poc-fresh-generic-optimization-v1.json"
buildopt_plan="${buildopt_repo_root}/docs/plans/fresh-generic-optimization-poc-tracker.md"

for buildopt_command in jq grep; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required fresh-plan command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done

jq -e '
    .schemaVersion == "buildopt.poc/fresh-generic-optimization/v1" and
    .status == "SWL_FRESH_006_TERMINAL_DECISION" and
    .historicalEvidence.classification == "DIAGNOSTIC_ONLY" and
    .historicalEvidence.experimentInputAllowed == false and
    .historicalEvidence.terminalAuthority == false and
    (.historicalEvidence.forbiddenInputs | length) == 4 and
    .subjects == [
      "spring-framework",
      "opentelemetry-java-instrumentation",
      "apache-kafka",
      "micronaut-core",
      "apache-groovy"
    ] and
    .producerOutcomes.conclusive == [
      "TESTABLE_ACTIONS", "NO_OPPORTUNITY", "NOT_APPLICABLE"
    ] and
    .producerOutcomes.incomplete == ["INPUT_UNAVAILABLE", "PRODUCER_FAILED"] and
    .producerOutcomes.incompleteMayStopExperiment == false and
    .detectors == ["TASK_CONTRACT_JAVA_V1", "DECLARED_GRAPH_SCOPE_V1"] and
    .rules.hostedCiTimingThresholdsAllowed == false and
    .rules.requiredOutputEquivalence == "BYTE_EXACT" and
    .rules.productFailureBudget == 0 and
    .rules.publicBreadthRequired == 3 and
    .rules.publicFamilyCount == 5 and
    .rules.installedPairsPerAction == 8 and
    .rules.primaryCommitsPerFamily == 20 and
    .rules.reserveCommitsPerFamily == 10 and
    .rules.minimumComparablePerFamily == 15 and
    [.blocks[].id] == [
      "SWL-FRESH-000", "SWL-FRESH-001", "SWL-FRESH-002",
      "SWL-FRESH-003", "SWL-FRESH-004", "SWL-FRESH-005", "SWL-FRESH-006"
    ] and
    [.blocks[].state] == [
      "DONE", "DONE", "DONE", "DONE", "NOT_AUTHORIZED", "NOT_AUTHORIZED", "TODO"
    ] and
    .nextBlock.id == "SWL-FRESH-006" and
    (.nextBlock.create | length) == 3 and
    (.nextBlock.requiredSubjects | length) == 5 and
    (.nextBlock.requiredChecks | length) == 8 and
    .nextBlock.initialState == "TIMING_AND_CHRONOLOGICAL_CAMPAIGN_NOT_AUTHORIZED"
' "${buildopt_contract}" >/dev/null || {
    printf 'fresh generic optimization machine contract is inconsistent\n' >&2
    exit 1
}

# Backticks below are literal Markdown syntax.
# shellcheck disable=SC2016
buildopt_required_text=(
    '**Progress:** `4/7` blocks complete; two downstream blocks were not authorized'
    '**Current block:** `SWL-FRESH-006` — issue the terminal decision from the conclusive breadth gate'
    '`PRODUCER_FAILED` block the breadth gate; they can never create stop evidence.'
    'CI verifies code, schemas and checked evidence only.'
    'Implement `SWL-FRESH-006` exactly as specified above.'
)

for buildopt_text in "${buildopt_required_text[@]}"; do
    grep -Fq -- "${buildopt_text}" "${buildopt_plan}" || {
        printf 'fresh generic optimization tracker is missing: %s\n' \
            "${buildopt_text}" >&2
        exit 1
    }
done

printf 'fresh generic optimization plan contract: PASS\n'
