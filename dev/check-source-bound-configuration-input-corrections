#!/usr/bin/env bash
set -euo pipefail

if (($# != 0 && $# != 2)); then
    printf 'usage: %s [--sources-root DIRECTORY]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_contract=${buildopt_root}/specs/poc-source-bound-configuration-input-corrections-v1.json
buildopt_subjects=${buildopt_root}/specs/poc-source-bound-configuration-input-corrections-v1.subjects.json
buildopt_plan=${buildopt_root}/docs/plans/source-bound-configuration-input-corrections-poc.md
buildopt_evidence=${buildopt_root}/benchmarks/results/source-bound-configuration-input-corrections-v1/README.md

jq -e '
  .schemaVersion == "buildopt.specs/poc-source-bound-configuration-input-corrections/v1" and
  .experiment == "SOURCE_BOUND_CONFIGURATION_INPUT_CORRECTIONS_V1" and
  .predecessors.reportsConsumedAsEvidence == false and
  .detector.sourceFactsBeforeDiagnostic == true and
  .detector.repositoryOrTaskNameRules == false and
  .cohort == {
    selection:"SOURCE_ENRICHED_MECHANISM_STUDY",prevalenceAuthority:false,
    families:3,subjects:"poc-source-bound-configuration-input-corrections-v1.subjects.json",
    selectionBeforeFirstGradleStart:true,requiredPureSourceFamilies:3
  } and
  .strictDiagnosticGate.requiredConclusiveFamilies == 3 and
  .strictDiagnosticGate.minimumDiagnosticBoundFamilies == 2 and
  .strictDiagnosticGate.maximumSilentlyLostStarts == 0 and
  .materialityGate.minimumFamilies == 2 and
  .materialityGate.minimumMilliseconds == 500 and
  .materialityGate.minimumPercent == 2 and
  .correctnessGate.minimumQualifiedFamilies == 2 and
  .correctnessGate.maximumProductFailures == 0 and
  .valueGate.balancedPairs == 8 and
  .valueGate.requiredPositivePairs == 8 and
  .valueGate.maximumCombinedPaybackBuilds == 300 and
  .controlledEnvironment == {workers:4,stabilitySamples:7,maximumStabilityRatio:1.15,postPrefetchQuiescenceSeconds:120} and
  .budget.maximumAdditionalDiskGiB == 20 and
  .budget.maximumSecondsPerStart == 1200 and
  .budget.concurrentStarts == 1 and
  .current == {completed:["SBIC-000"],next:"SBIC-001"} and
  (.zeroState | to_entries | all(.value == 0)) and
  .boundaries.prevalenceClaim == false and
  .boundaries.testOptimization == "OUT_OF_SCOPE"
' "${buildopt_contract}" >/dev/null

jq -e '
  .schemaVersion == "buildopt.specs/poc-source-bound-configuration-input-corrections-subjects/v1" and
  .freezeBlock == "SBIC-000" and
  .selectionClass == "SOURCE_ENRICHED_MECHANISM_STUDY" and
  .selectionPrecedesFirstGradleStart == true and
  .predecessorReportsConsumed == false and
  (.subjects | length) == 3 and
  ([.subjects[].ordinal] == [1,2,3]) and
  ([.subjects[].key] | unique | length) == 3 and
  ([.subjects[].binding.decision] | unique) == ["PURE_CONFIGURATION_PROCESS_READ"] and
  ([.subjects[].binding.recipe] | sort) == (["PROVIDER_FACTORY_EXEC_V1","PROVIDER_FACTORY_EXEC_V1","TYPED_VALUE_SOURCE_V1"] | sort) and
  (.subjects | all(
    (.revision | test("^[0-9a-f]{40}$")) and
    (.archiveSha256 | test("^[0-9a-f]{64}$")) and
    (.wrapper.sha256 | test("^[0-9a-f]{64}$")) and
    (.wrapper.propertiesPath == "gradle/wrapper/gradle-wrapper.properties") and
    (.wrapper.propertiesSha256 | test("^[0-9a-f]{64}$")) and
    (.ownerWorkflow.sourceSha256 | test("^[0-9a-f]{64}$")) and
    (.binding.sourceSha256 | test("^[0-9a-f]{64}$")) and
    (.binding.callSiteSha256 | test("^[0-9a-f]{64}$")) and
    (.ownerWorkflow.arguments | length > 0) and
    (.requiredOutputs | length > 0)
  )) and
  .prospectiveExclusions == [{
    key:"bluemap",revision:"9c4efeb9696eaae979ec70ea11de8be30e7d2a53",
    sourcePath:"buildSrc/src/main/kotlin/versioning.kt",
    sourceSha256:"7ac5ecbdb80a20c188ce46bc9be0c4de22dda10c57f7ba6515216b459963618b",
    decision:"SIDE_EFFECTING_PROCESS",
    reason:"git update-index --refresh can update index metadata"
  }]
' "${buildopt_subjects}" >/dev/null

for buildopt_block in SBIC-000 SBIC-001 SBIC-002 SBIC-003 SBIC-004 SBIC-005 SBIC-006; do
    grep -Fq -- "${buildopt_block}" "${buildopt_plan}"
done
grep -Fq -- 'zero public Gradle starts' "${buildopt_evidence}"

if (($# == 2)); then
    [[ $1 == --sources-root ]]
    buildopt_sources_root=$(cd -- "$2" && pwd -P)
    while IFS=$'\t' read -r buildopt_key buildopt_revision buildopt_archive buildopt_wrapper buildopt_wrapper_sha buildopt_properties buildopt_properties_sha buildopt_workflow buildopt_workflow_sha buildopt_source buildopt_source_sha buildopt_call buildopt_call_sha; do
        buildopt_source_root=${buildopt_sources_root}/${buildopt_key}
        [[ $(git -C "${buildopt_source_root}" rev-parse HEAD) == "${buildopt_revision}" ]]
        [[ -z $(git -C "${buildopt_source_root}" status --short) ]]
        [[ $(git -C "${buildopt_source_root}" archive --format=tar HEAD | sha256sum | cut -d' ' -f1) == "${buildopt_archive}" ]]
        [[ $(sha256sum "${buildopt_source_root}/${buildopt_wrapper}" | cut -d' ' -f1) == "${buildopt_wrapper_sha}" ]]
        [[ $(sha256sum "${buildopt_source_root}/${buildopt_properties}" | cut -d' ' -f1) == "${buildopt_properties_sha}" ]]
        [[ $(sha256sum "${buildopt_source_root}/${buildopt_workflow}" | cut -d' ' -f1) == "${buildopt_workflow_sha}" ]]
        [[ $(sha256sum "${buildopt_source_root}/${buildopt_source}" | cut -d' ' -f1) == "${buildopt_source_sha}" ]]
        [[ $(sha256sum "${buildopt_source_root}/${buildopt_call}" | cut -d' ' -f1) == "${buildopt_call_sha}" ]]
    done < <(jq -r '.subjects[] | [.key,.revision,.archiveSha256,.wrapper.path,.wrapper.sha256,.wrapper.propertiesPath,.wrapper.propertiesSha256,.ownerWorkflow.sourcePath,.ownerWorkflow.sourceSha256,.binding.sourcePath,.binding.sourceSha256,.binding.callSitePath,.binding.callSiteSha256] | @tsv' "${buildopt_subjects}")
fi

printf 'SBIC contract reconstructed: 3 source-bound families, 2-family value gate, zero public starts\n'
