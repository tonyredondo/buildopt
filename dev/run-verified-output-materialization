#!/usr/bin/env bash
set -euo pipefail

usage='usage: dev/run-verified-output-materialization BUILDOPT OUTPUT_JSON'
if [[ $# -ne 2 ]]; then
  printf '%s\n' "$usage" >&2
  exit 64
fi

repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
buildopt=$1
output=$2
if [[ ! -x $buildopt ]]; then
  printf 'buildopt executable is not executable: %s\n' "$buildopt" >&2
  exit 66
fi
buildopt=$(cd "$(dirname "$buildopt")" && printf '%s/%s\n' "$PWD" "$(basename "$buildopt")")
if [[ $output != /* ]]; then
  output="$PWD/$output"
fi

temporary=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-output-materialization.XXXXXX")
cleanup() {
  rm -rf -- "$temporary"
}
trap cleanup EXIT

fixture="$temporary/repository"
gradle_home="$temporary/gradle-home"
mkdir -p "$fixture" "$gradle_home/wrapper"
git -C "$repository_root" archive HEAD fixtures/build-impact/synthetic-repository |
  tar -x -C "$fixture" --strip-components=3
cp -a "$repository_root/gradlew" "$repository_root/gradle" "$fixture/"
cp -a "$repository_root/.tools/gradle-user-home/wrapper/dists" "$gradle_home/wrapper/"

git -C "$fixture" init -b main >/dev/null
git -C "$fixture" config user.name 'BuildOpt Materialization Fixture'
git -C "$fixture" config user.email 'buildopt-materialization@example.invalid'
git -C "$fixture" config commit.gpgsign false
git -C "$fixture" remote add origin https://github.com/buildopt-poc/verified-output-materialization-fixture.git
git -C "$fixture" add .
git -C "$fixture" commit -m base >/dev/null
git -C "$fixture" switch -c feature >/dev/null
git -C "$fixture" config branch.feature.remote .
git -C "$fixture" config branch.feature.merge refs/heads/main
sed -i 's/return "service-a:/return "service-a-materialized:/' \
  "$fixture/service-a/src/main/java/synthetic/ServiceA.java"
git -C "$fixture" add service-a/src/main/java/synthetic/ServiceA.java
git -C "$fixture" commit -m change >/dev/null

state_dir='.buildopt/materialization/v1'
run_build() {
  local sequence=$1
  if ! (
    cd "$fixture"
    env GRADLE_USER_HOME="$gradle_home" "$buildopt" optimize \
      --state-dir "$state_dir" -- --no-daemon assemble
  ) >"$temporary/invocation-$sequence.log" 2>&1; then
    printf 'BuildOpt invocation %s failed:\n' "$sequence" >&2
    tail -n 120 "$temporary/invocation-$sequence.log" >&2
    return 1
  fi
}

clean_build_outputs() {
  find "$fixture" -mindepth 2 -maxdepth 2 -type d -name build -exec rm -rf -- {} +
}

output_manifest() {
  (
    cd "$fixture"
    find library-c service-a service-b -path '*/build/libs/*.jar' -type f -print |
      LC_ALL=C sort |
      while IFS= read -r artifact; do
        sha256sum "$artifact"
      done
  )
}

run_build 1
baseline_manifest=$(output_manifest)
baseline_count=$(wc -l <<<"$baseline_manifest")
baseline_sha=$(sha256sum <<<"$baseline_manifest" | awk '{print $1}')
if [[ $baseline_count -ne 3 ]]; then
  printf 'baseline did not produce all three workflow JARs\n' >&2
  exit 1
fi

run_build 2
clean_build_outputs
run_build 3
candidate_manifest=$(output_manifest)
candidate_count=$(wc -l <<<"$candidate_manifest")
candidate_sha=$(sha256sum <<<"$candidate_manifest" | awk '{print $1}')
if [[ $candidate_count -ne 3 || $candidate_sha != "$baseline_sha" ]]; then
  printf 'clean-workspace candidate did not preserve the complete workflow output\n' >&2
  exit 1
fi
if ! grep -q 'incremental candidate changed-projects selected' "$temporary/invocation-3.log" ||
  grep -Eq '^> Task :service-b:(assemble|jar)( |$)' "$temporary/invocation-3.log"; then
  printf 'clean-workspace candidate did not omit the unaffected producer\n' >&2
  tail -n 160 "$temporary/invocation-3.log" >&2
  exit 1
fi

state="$fixture/$state_dir/state.json"
manifest_file=$(jq -r '.discovery.materialization.manifestFile' "$state")
blob_file=$(jq -r '.entries[0].blob' "$fixture/$manifest_file")
printf 'corrupt-materialization\n' >"$fixture/$blob_file"
clean_build_outputs
run_build 4
fallback_manifest=$(output_manifest)
fallback_count=$(wc -l <<<"$fallback_manifest")
fallback_sha=$(sha256sum <<<"$fallback_manifest" | awk '{print $1}')
if [[ $fallback_count -ne 3 || $fallback_sha != "$baseline_sha" ]]; then
  printf 'native fallback did not restore the complete workflow output\n' >&2
  exit 1
fi
if ! grep -q 'verified output materialization unavailable' "$temporary/invocation-4.log" ||
  ! grep -Eq '^> Task :service-b:(assemble|jar)( |$)' "$temporary/invocation-4.log"; then
  printf 'corrupt materialization did not retain the full native graph\n' >&2
  tail -n 160 "$temporary/invocation-4.log" >&2
  exit 1
fi

result="$fixture/$state_dir/result.json"
mkdir -p "$(dirname "$output")"
captured_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
buildopt_revision=$(git -C "$repository_root" rev-parse HEAD)
buildopt_sha=$(sha256sum "$buildopt" | awk '{print $1}')
cpu_count=$(getconf _NPROCESSORS_ONLN)
jq -n \
  --arg capturedAt "$captured_at" \
  --arg buildoptRevision "$buildopt_revision" \
  --arg buildoptExecutableSha256 "$buildopt_sha" \
  --arg baselineOutputSha256 "$baseline_sha" \
  --arg candidateOutputSha256 "$candidate_sha" \
  --arg fallbackOutputSha256 "$fallback_sha" \
  --argjson cpuCount "$cpu_count" \
  --argjson baselineOutputCount "$baseline_count" \
  --argjson candidateOutputCount "$candidate_count" \
  --argjson fallbackOutputCount "$fallback_count" \
  --slurpfile result "$result" \
  --slurpfile state "$state" \
  '{
    schemaVersion: "buildopt.poc/verified-output-materialization-evaluation/v1",
    workItem: "POC-VERIFIED-OUTPUT-MATERIALIZATION-001",
    capturedAt: $capturedAt,
    buildoptRevision: $buildoptRevision,
    buildoptExecutableSha256: $buildoptExecutableSha256,
    runner: {
      platform: "linux-amd64",
      cpuCount: $cpuCount,
      evidenceClass: "BOUNDED_LOCAL_POC"
    },
    workload: {
      fixture: "fixtures/build-impact/synthetic-repository",
      workflow: ["--no-daemon", "assemble"],
      projects: 3,
      invocations: 4,
      candidateWorkspaceCleaned: true,
      cacheOpportunityEqual: true
    },
    materialization: $state[0].discovery.materialization,
    graph: $state[0].discovery.graph,
    outputs: {
      baseline: {sha256: $baselineOutputSha256, fileCount: $baselineOutputCount},
      cleanCandidate: {sha256: $candidateOutputSha256, fileCount: $candidateOutputCount},
      corruptStateFallback: {sha256: $fallbackOutputSha256, fileCount: $fallbackOutputCount},
      identical: ($baselineOutputSha256 == $candidateOutputSha256 and $baselineOutputSha256 == $fallbackOutputSha256)
    },
    fallback: {
      triggeredBeforeCandidate: true,
      reason: $result[0].incrementalLearning.reason,
      nativeGraphRestored: true,
      exitCode: $result[0].execution.exitCode
    },
    assertions: {
      onlyUnaffectedOutputsMaterialized: true,
      changedOutputsRebuilt: true,
      corruptBlobRejected: true,
      staleBytesRejectedByUnitTest: true,
      repositorySpecificRuleAdded: false,
      productionAuthorized: false,
      testOptimizationModified: false
    },
    conclusion: "VERIFIED_OUTPUT_MATERIALIZATION_POC_COMPLETE"
  }' >"$output"

printf 'verified output materialization evidence: %s\n' "$output"
