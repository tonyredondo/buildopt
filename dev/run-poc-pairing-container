#!/usr/bin/env bash
set -euo pipefail

if (($# != 3)); then
    printf 'usage: %s OUTPUT_FILE BATCH_ID STARTING_ORDER\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_batch_id=$2
buildopt_starting_order=$3
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/golden-lane-runner-v1.json"

if [[ "${buildopt_output}" != /* || -e "${buildopt_output}" ||
    ! "${buildopt_batch_id}" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ||
    ("${buildopt_starting_order}" != CONTROL_FIRST &&
     "${buildopt_starting_order}" != CANDIDATE_FIRST) ]]; then
    printf 'invalid POC-PAIRING-001 container input\n' >&2
    exit 64
fi
for buildopt_command in awk cp curl docker find git grep id jq mkdir mktemp sha256sum tar; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required POC-PAIRING-001 container command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
if [[ -n "$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)" ]]; then
    printf 'POC-PAIRING-001 container requires a clean revision-bound checkout\n' >&2
    exit 1
fi
if ! docker info >/dev/null 2>&1; then
    printf 'Docker daemon is unavailable\n' >&2
    exit 1
fi

buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-poc-pairing-001-container.XXXXXX")
buildopt_container_prefix="buildopt-poc-pairing-${buildopt_batch_id}-$$"
buildopt_control_container="${buildopt_container_prefix}-control"
buildopt_candidate_container="${buildopt_container_prefix}-candidate"
buildopt_cleanup() {
    docker rm --force "${buildopt_control_container}" \
        "${buildopt_candidate_container}" >/dev/null 2>&1 || true
    if [[ "${buildopt_root}" == "${TMPDIR:-/tmp}/buildopt-poc-pairing-001-container."* ]]; then
        rm -rf -- "${buildopt_root}"
    fi
}
trap buildopt_cleanup EXIT

buildopt_revision=$(git -C "${buildopt_repo_root}" rev-parse HEAD)
buildopt_release="${buildopt_root}/release"
mkdir -p -- "${buildopt_release}"
buildopt_archive=$("${buildopt_repo_root}/packaging/linux/package.sh" \
    --version 0.3.0-pairing001 --output "${buildopt_release}")

buildopt_host_gradle_home=${GRADLE_USER_HOME:-"${buildopt_repo_root}/.tools/gradle-user-home/local"}
if [[ ! -d "${buildopt_host_gradle_home}/wrapper/dists/gradle-9.6.1-bin" ]]; then
    printf 'locked Gradle 9.6.1 distribution is unavailable in %s\n' \
        "${buildopt_host_gradle_home}" >&2
    exit 1
fi

buildopt_jq_url=https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-linux-amd64
buildopt_jq_expected=5942c9b0934e510ee61eb3e30273f1b3fe2590df93933a93d7c58b81d19c8ff5
curl --fail --location --proto '=https' --tlsv1.2 \
    --output "${buildopt_root}/jq" "${buildopt_jq_url}"
buildopt_jq_actual=$(sha256sum "${buildopt_root}/jq" | awk '{print $1}')
if [[ "${buildopt_jq_actual}" != "${buildopt_jq_expected}" ]]; then
    printf 'locked POC-PAIRING-001 jq helper failed SHA-256 verification\n' >&2
    exit 1
fi
chmod 0755 "${buildopt_root}/jq"

buildopt_image=$(jq -er '.container.reference' "${buildopt_spec}")
buildopt_platform_digest=$(jq -er '.container.platformDigest' "${buildopt_spec}")
buildopt_cpu=$(jq -er '.runnerClass.cpuCount' "${buildopt_spec}")
buildopt_memory=$(jq -er '.runnerClass.memoryBytes' "${buildopt_spec}")
buildopt_jdk17_sha=$(jq -er \
    '.artifacts[] | select(.id == "temurin-jdk-17") | .sha256' \
    "${buildopt_repo_root}/dev/toolchains.lock.yaml")
buildopt_jdk17_home=${BUILDOPT_JDK17_HOME:-${BUILDOPT_TOOLS_ROOT:-${buildopt_repo_root}/.tools}/toolchains/temurin-jdk-17-${buildopt_jdk17_sha:0:16}}
if [[ ! -x "${buildopt_jdk17_home}/bin/javac" ]] ||
    ! "${buildopt_jdk17_home}/bin/java" -version 2>&1 | grep -Eq 'version "17([.]|\")'; then
    printf 'POC-PAIRING-001 requires locked Temurin 17\n' >&2
    exit 1
fi

docker pull --quiet --platform linux/amd64 "${buildopt_image}" >/dev/null
if ! docker image inspect "${buildopt_image}" |
    jq -e --arg digest "${buildopt_platform_digest}" '
        length == 1 and .[0].Os == "linux" and .[0].Architecture == "amd64" and
        any(.[0].RepoDigests[]?; endswith("@" + $digest))
    ' >/dev/null; then
    printf 'local POC-PAIRING-001 image does not match the golden platform digest\n' >&2
    exit 1
fi

buildopt_prepare_arm() {
    local buildopt_arm=$1
    local buildopt_arm_lower=${buildopt_arm,,}
    local buildopt_dir="${buildopt_root}/${buildopt_arm_lower}"
    mkdir -p -- "${buildopt_dir}/bin" "${buildopt_dir}/output" \
        "${buildopt_dir}/state" "${buildopt_dir}/gradle-home/wrapper" \
        "${buildopt_dir}/home" "${buildopt_dir}/package"
    cp -R -- "${buildopt_host_gradle_home}/wrapper/dists" \
        "${buildopt_dir}/gradle-home/wrapper/"
    cp -- "${buildopt_root}/jq" "${buildopt_dir}/bin/jq"
    tar -xzf "${buildopt_archive}" -C "${buildopt_dir}/package"
    local buildopt_package_root
    buildopt_package_root=$(find "${buildopt_dir}/package" \
        -mindepth 1 -maxdepth 1 -type d \
        -name 'buildopt-0.3.0-pairing001-linux-amd64')
    if [[ -z "${buildopt_package_root}" ]]; then
        printf 'POC-PAIRING-001 package layout is unavailable for %s\n' \
            "${buildopt_arm}" >&2
        exit 1
    fi
    "${buildopt_package_root}/install.sh" \
        --prefix "${buildopt_dir}/install" >/dev/null
    "${buildopt_dir}/install/bin/buildopt" doctor >/dev/null
}

buildopt_start_arm_container() {
    local buildopt_arm=$1
    local buildopt_arm_lower=${buildopt_arm,,}
    local buildopt_dir="${buildopt_root}/${buildopt_arm_lower}"
    local buildopt_container="${buildopt_container_prefix}-${buildopt_arm_lower}"
    docker run --detach --pull never --network none --platform linux/amd64 \
        --name "${buildopt_container}" \
        --cpus "${buildopt_cpu}" --memory "${buildopt_memory}" \
        --user "$(id -u):$(id -g)" \
        --env HOME=/benchmark/home \
        --env GRADLE_USER_HOME=/benchmark/gradle-home \
        --env JAVA_HOME=/opt/java/openjdk \
        --env BUILDOPT_POC_BREADTH_ARM="${buildopt_arm}" \
        --env BUILDOPT_BENCHMARK_JAVA_INSTALLATIONS_PATHS=/opt/java/jdk17,/opt/java/openjdk \
        --env LANG=C.UTF-8 --env LC_ALL=C.UTF-8 --env TZ=UTC \
        --env PATH=/benchmark/bin:/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        --volume "${buildopt_repo_root}:/workspace:ro" \
        --volume "${buildopt_jdk17_home}:/opt/java/jdk17:ro" \
        --volume "${buildopt_dir}:/benchmark" \
        --workdir /workspace \
        "${buildopt_image}" \
        /bin/sh -c 'while :; do sleep 3600; done' >/dev/null
}

buildopt_exec_step() {
    local buildopt_arm=$1 buildopt_step=$2 buildopt_dsl=$3
    local buildopt_scenario=$4 buildopt_pair=$5 buildopt_destination=$6
    local buildopt_arm_lower=${buildopt_arm,,}
    local buildopt_container="${buildopt_container_prefix}-${buildopt_arm_lower}"
    docker exec \
        --env BUILDOPT_POC_BREADTH_STEP="${buildopt_step}" \
        --env BUILDOPT_POC_BREADTH_STATE_ROOT=/benchmark/state \
        --env BUILDOPT_POC_BREADTH_DSL="${buildopt_dsl}" \
        --env BUILDOPT_POC_BREADTH_SCENARIO="${buildopt_scenario}" \
        --env BUILDOPT_POC_BREADTH_PAIR="${buildopt_pair}" \
        "${buildopt_container}" \
        /workspace/dev/run-poc-breadth \
            "/benchmark/output/${buildopt_destination}" \
            "${buildopt_revision}" \
            /benchmark/install
}

buildopt_append_observation() {
    local buildopt_arm=$1 buildopt_file=$2
    local buildopt_arm_lower=${buildopt_arm,,}
    jq -c . "${buildopt_root}/${buildopt_arm_lower}/output/${buildopt_file}" \
        >>"${buildopt_root}/observations.jsonl"
}

buildopt_first_arm_for_pair() {
    local buildopt_pair=$1
    if ((buildopt_pair % 2 == 1)); then
        if [[ "${buildopt_starting_order}" == CONTROL_FIRST ]]; then
            printf 'CONTROL\n'
        else
            printf 'CANDIDATE\n'
        fi
    elif [[ "${buildopt_starting_order}" == CONTROL_FIRST ]]; then
        printf 'CANDIDATE\n'
    else
        printf 'CONTROL\n'
    fi
}

buildopt_prepare_arm CONTROL
buildopt_prepare_arm CANDIDATE
buildopt_start_arm_container CONTROL
buildopt_start_arm_container CANDIDATE
: >"${buildopt_root}/observations.jsonl"

for buildopt_dsl in KOTLIN GROOVY; do
    buildopt_dsl_lower=${buildopt_dsl,,}
    for buildopt_scenario in NO_CHANGE LEAF_CHANGE SHARED_CHANGE BUILD_LOGIC_CHANGE; do
        buildopt_scenario_lower=${buildopt_scenario,,}
        buildopt_warm_first=$(buildopt_first_arm_for_pair 1)
        if [[ "${buildopt_warm_first}" == CONTROL ]]; then
            buildopt_warm_second=CANDIDATE
        else
            buildopt_warm_second=CONTROL
        fi
        for buildopt_arm in "${buildopt_warm_first}" "${buildopt_warm_second}"; do
            buildopt_arm_lower=${buildopt_arm,,}
            buildopt_warm_file="warm-${buildopt_dsl_lower}-${buildopt_scenario_lower}.json"
            buildopt_exec_step "${buildopt_arm}" WARM "${buildopt_dsl}" \
                "${buildopt_scenario}" 0 "${buildopt_warm_file}"
            if [[ "${buildopt_dsl}" == KOTLIN &&
                "${buildopt_scenario}" == NO_CHANGE ]]; then
                cp -- "${buildopt_root}/${buildopt_arm_lower}/output/${buildopt_warm_file}" \
                    "${buildopt_root}/${buildopt_arm_lower}-meta.json"
            fi
        done

        for buildopt_pair in {1..8}; do
            buildopt_first_arm=$(buildopt_first_arm_for_pair "${buildopt_pair}")
            if [[ "${buildopt_first_arm}" == CONTROL ]]; then
                buildopt_second_arm=CANDIDATE
            else
                buildopt_second_arm=CONTROL
            fi
            for buildopt_arm in "${buildopt_first_arm}" "${buildopt_second_arm}"; do
                buildopt_arm_lower=${buildopt_arm,,}
                buildopt_sample_file="sample-${buildopt_dsl_lower}-${buildopt_scenario_lower}-${buildopt_pair}.json"
                buildopt_exec_step "${buildopt_arm}" SAMPLE "${buildopt_dsl}" \
                    "${buildopt_scenario}" "${buildopt_pair}" \
                    "${buildopt_sample_file}"
                buildopt_append_observation "${buildopt_arm}" \
                    "${buildopt_sample_file}"
            done
        done
    done
done

"${buildopt_script_dir}/assemble-poc-pairing" \
    "${buildopt_output}" "${buildopt_batch_id}" "${buildopt_starting_order}" \
    "${buildopt_root}/control-meta.json" \
    "${buildopt_root}/candidate-meta.json" \
    "${buildopt_root}/observations.jsonl"

printf 'BuildOpt POC-PAIRING-001 strict batch written to %s\n' \
    "${buildopt_output}"
