#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_rfc="${buildopt_repo_root}/gradle-build-optimization-platform.md"
buildopt_tracker="${buildopt_repo_root}/implementation-tracker.md"

for buildopt_command in awk grep sed sha256sum; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required tracker-consistency command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done

buildopt_expected_rfc_sha=$(
    # The backticks are literal Markdown syntax.
    # shellcheck disable=SC2016
    sed -n 's/^\*\*RFC baseline SHA-256:\*\* `\([0-9a-f]\{64\}\)`$/\1/p' \
        "${buildopt_tracker}"
)
buildopt_actual_rfc_sha=$(sha256sum "${buildopt_rfc}" | awk '{print $1}')
if [[ -z "${buildopt_expected_rfc_sha}" ]] ||
    [[ "${buildopt_expected_rfc_sha}" != "${buildopt_actual_rfc_sha}" ]]; then
    printf 'tracker RFC baseline is stale: expected=%s actual=%s\n' \
        "${buildopt_expected_rfc_sha:-missing}" "${buildopt_actual_rfc_sha}" >&2
    exit 1
fi

buildopt_decisions=$(
    awk -F'|' '
        /^\| [A-Z0-9-]+ \| Accepted \|/ {
            id = $2
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", id)
            print id
        }
    ' "${buildopt_rfc}" | sort -u
)
buildopt_decision_count=$(wc -w <<<"${buildopt_decisions}")
if [[ "${buildopt_decision_count}" != 53 ]]; then
    printf 'expected 53 accepted RFC decisions, found %s\n' \
        "${buildopt_decision_count}" >&2
    exit 1
fi

buildopt_traceability=$(
    awk '
        /^### 4\.1 RFC decision traceability$/ {inside = 1; next}
        /^### 4\.2 Readiness gates$/ {inside = 0}
        inside {print}
    ' "${buildopt_tracker}"
)
while IFS= read -r buildopt_decision; do
    if ! grep -Fq -- "\`${buildopt_decision}\`" <<<"${buildopt_traceability}"; then
        printf 'accepted RFC decision is absent from tracker traceability: %s\n' \
            "${buildopt_decision}" >&2
        exit 1
    fi
done <<<"${buildopt_decisions}"

