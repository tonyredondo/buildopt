#!/usr/bin/env bash
set -euo pipefail
umask 077

if (($# > 1)); then
  printf 'usage: %s [--static]\n' "$0" >&2
  exit 64
fi
buildopt_mode=${1:-dynamic}
case ${buildopt_mode} in dynamic | --static) ;; *) printf 'usage: %s [--static]\n' "$0" >&2; exit 64 ;; esac

buildopt_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
buildopt_evidence=${buildopt_root}/benchmarks/results/verified-request-hit-shadow-replay-v1.json
buildopt_route=${buildopt_root}/specs/poc-verified-request-hit-v1.json
buildopt_temporary=$(mktemp -d /tmp/buildopt-request-hit-shadow-check.XXXXXX)
buildopt_cleanup() {
  case ${buildopt_temporary} in
    /tmp/buildopt-request-hit-shadow-check.*) rm -rf -- "${buildopt_temporary}" ;;
    *) printf 'refusing to clean unexpected shadow check root: %s\n' "${buildopt_temporary}" >&2; return 1 ;;
  esac
}
trap buildopt_cleanup EXIT

buildopt_validate() {
  jq -e '
    .schemaVersion == "buildopt.poc/verified-request-hit-shadow-replay/v1" and
    .workItem == "VRH-003" and
    .thresholds == {
      syntheticRepeatsPerCell:2,syntheticCellsRequired:4,
      publicExactRowsPerFamilyRequired:5,publicFamiliesRequired:3,productFailureBudget:0
    } and
    (.synthetic.cases | length) == 4 and
    ([.synthetic.cases[].gradleVersion] | unique) == ["8.14.3","9.6.1"] and
    ([.synthetic.cases[].dsl] | unique) == ["GROOVY","KOTLIN"] and
    all(.synthetic.cases[]; .repeatCount==2 and .exactMatches==2 and .nativeInvocations==3 and (.recordSha256|test("^[0-9a-f]{64}$"))) and
    .synthetic.exactMatches==8 and .synthetic.requiredMatches==8 and .synthetic.matrixPass and
    .synthetic.mismatch.firstDisposition=="SHADOW_MISMATCH_QUARANTINED" and
    .synthetic.mismatch.firstReason=="NATIVE_OUTPUT_MISMATCH" and
    .synthetic.mismatch.nextDisposition=="SHADOW_NOT_PREDICTED" and
    (.synthetic.mismatch.nextReason|startswith("IDENTITY_QUARANTINED:")) and
    .synthetic.mismatch.firstMismatchQuarantined and
    (.synthetic.mismatch.nextReplayPredicted|not) and
    .synthetic.mismatch.nativeExecutedBothTimes and .synthetic.quarantinePass and
    .public.potentialRows==69 and .public.nativeOutputMatches==34 and
    .public.nativeOutputMismatches==35 and .public.safetyAdmittedRows==0 and
    .public.familiesMeetingExactOutputBreadth==2 and
    .public.familiesMeetingAdmissionBreadth==0 and
    (.public.outputBreadthPass|not) and (.public.admissionBreadthPass|not) and
    (.public.families|map({key:.family,value:{potential:.potentialRows,exact:.nativeOutputMatches,mismatch:.nativeOutputMismatches,admitted:.safetyAdmittedRows}})|from_entries)=={
      "apache-kafka":{potential:17,exact:0,mismatch:17,admitted:0},
      "micronaut-core":{potential:14,exact:12,mismatch:2,admitted:0},
      "opentelemetry-java-instrumentation":{potential:22,exact:22,mismatch:0,admitted:0},
      "spring-framework":{potential:16,exact:0,mismatch:16,admitted:0}
    } and
    all(.public.families[]; .nativeOutcomeMatches==.potentialRows and .retentionReason=="HISTORICAL_VRH002_SAFETY_RECORD_UNAVAILABLE") and
    .totals.gradleInvocations==14 and .totals.predictions==9 and
    .totals.shadowMatches==8 and .totals.quarantinedIdentities==1 and
    .totals.actionSelections==0 and .totals.timingSamples==0 and
    (.authority.selectionAuthorized|not) and (.authority.activationAuthorized|not) and
    (.authority.performanceMeasured|not) and (.authority.speedupClaim|not) and
    .decision=="STOP_VERIFIED_REQUEST_HIT_BEFORE_GRADLE_FREE_EXECUTION" and
    .conclusion=="SHADOW_MECHANICS_PASS_BUT_PUBLIC_BREADTH_AND_COMPLETE_SAFETY_ADMISSION_FAIL" and
    .nextBlock=="NONE"
  ' "$1" >/dev/null
}

"${buildopt_root}/dev/check-observed-request-public-portfolio" >/dev/null
"${buildopt_root}/dev/run" --toolchain go -- go test -count=1 -race ./internal/requesthit/...
jq -e '
  .status=="STOPPED" and .currentBlock=="NONE" and .nextBlock=="NONE" and
  (.blocks|map({key:.id,value:.state})|from_entries)=={
    "VRH-001":"DONE","VRH-002":"DONE","VRH-003":"DONE",
    "VRH-004":"NOT_AUTHORIZED","VRH-005":"NOT_AUTHORIZED",
    "VRH-006":"NOT_AUTHORIZED","VRH-007":"NOT_AUTHORIZED"
  } and
  .latestEvidence.path=="benchmarks/results/verified-request-hit-shadow-replay-v1.json" and
  .latestEvidence.syntheticShadowMatches==8 and
  .latestEvidence.publicExactOutputRows==34 and
  .latestEvidence.publicOutputMismatchRows==35 and
  .latestEvidence.publicFamiliesMeetingExactOutputBreadth==2 and
  .latestEvidence.publicSafetyAdmittedRows==0 and
  .latestEvidence.decision=="STOP_VERIFIED_REQUEST_HIT_BEFORE_GRADLE_FREE_EXECUTION"
' "${buildopt_route}" >/dev/null || {
  printf 'verified request hit route does not preserve the terminal shadow stop\n' >&2
  exit 1
}
buildopt_validate "${buildopt_evidence}" || {
  printf 'verified request hit shadow evidence is invalid\n' >&2
  exit 1
}

jq '.public.safetyAdmittedRows=15|.public.familiesMeetingAdmissionBreadth=3|.public.admissionBreadthPass=true|.nextBlock="VRH-004"' \
  "${buildopt_evidence}" >"${buildopt_temporary}/forged.json"
if buildopt_validate "${buildopt_temporary}/forged.json"; then
  printf 'invented public safety admission was accepted\n' >&2
  exit 1
fi

if [[ ${buildopt_mode} == --static ]]; then
  printf 'verified request hit shadow replay: PASS (static stop)\n'
  exit 0
fi
"${buildopt_root}/dev/run-verified-request-hit-shadow-replay" "${buildopt_temporary}/regenerated.json" >/dev/null
cmp -s "${buildopt_evidence}" "${buildopt_temporary}/regenerated.json" || {
  printf 'verified request hit shadow evidence is stale\n' >&2
  diff -u "${buildopt_evidence}" "${buildopt_temporary}/regenerated.json" >&2 || true
  exit 1
}

printf 'verified request hit shadow replay: PASS (dynamic stop)\n'
