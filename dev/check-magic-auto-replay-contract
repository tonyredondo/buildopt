#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [contract.json]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_contract=${1:-"${buildopt_repo_root}/specs/poc-magic-auto-replay-v1.json"}

[[ -s ${buildopt_contract} ]] || {
    printf 'magic automatic replay contract is unavailable: %s\n' "${buildopt_contract}" >&2
    exit 1
}

jq -e '
  keys == [
    "acceptance", "authority", "bindings", "boundaries", "execution",
    "fallbackReasons", "schemaVersion", "selection", "trigger", "workItem"
  ] and
  .schemaVersion == "buildopt.poc/magic-auto-replay/v1" and
  .workItem == "POC-MAGIC-AUTO-REPLAY-001" and
  .trigger == {
    command: "buildopt optimize <gradle args...>", checkpoint: "EXACT_BINDINGS",
    profileState: "QUALIFIED", manualSelectionFlagRequired: false,
    completedBeforeGradle: true
  } and
  .bindings == [
    "BUILDOPT_EXECUTABLE", "CALIBRATION_EVIDENCE", "CHANGE_FAMILY",
    "DISCOVERY_DOCUMENTS", "GRADLE_OPTIONS", "GRADLE_WRAPPER_PROPERTIES",
    "PROFILE_ARTIFACTS", "PROFILE_PRECONDITIONS", "REPOSITORY_ID",
    "REPOSITORY_REVISION", "VERIFIED_UNAFFECTED_OUTPUTS",
    "WORKFLOW_ENTRYPOINTS"
  ] and
  .selection == {
    statuses: ["SKIPPED", "NATIVE_RETAINED", "SELECTED"],
    skippedReason: "NO_QUALIFIED_CHECKPOINT",
    selectedReason: "QUALIFIED_PROFILE_SELECTED",
    selectedSource: "LOCAL_PORTFOLIO", overheadUnit: "NANOSECONDS",
    overheadIncludedInInvocationWallTime: true,
    recordsOriginalEntrypoints: true, recordsSelectedEntrypoints: true,
    recordsValidatedAndFailedBindings: true
  } and
  .execution == {
    selectedMode: "SELECTIVE_PROFILE", fallbackMode: "OPTIMIZED_NATIVE",
    selectedOutcome: "QUALIFIED_AND_USED", selectedPhase: "ACTIVE",
    fallbackBeforeGradle: true, preserveChildExitStatus: true
  } and
  .fallbackReasons == [
    "CHECKPOINT_BINDING_DRIFT",
    "QUALIFICATION_EVIDENCE_DRIFT", "PROFILE_PORTFOLIO_INVALID",
    "PROFILE_FAMILY_NOT_FOUND", "PROFILE_BINDING_DRIFT", "PROFILE_PLAN_REJECTED"
  ] and
  .acceptance == {
    firstInvocationStoresOnly: true, exactSecondInvocationSelects: true,
    secondInvocationRepeatsCalibration: false,
    tamperedProfileStartsSelectiveGradle: false,
    tamperedProfileMayRepairFromValidEvidence: true,
    repairedProfileMaySelectNextInvocation: true,
    crossRevisionInference: false
  } and
  .authority == {
    proofOfConcept: true, ownerInvokedCommandOnly: true,
    selectionAuthorized: true, productionAuthorized: false,
    autonomousPromotion: false, testOptimization: "OUT_OF_SCOPE"
  } and
  .boundaries == {
    syntheticPercentageTransferable: false,
    percentagesAveragedAcrossRepositories: false,
    mechanismPercentagesAdded: false, soakRequired: false,
    designPartnerRequired: false
  }
' "${buildopt_contract}" >/dev/null

for buildopt_binding in \
    'optimizeBindingReplay       = "AUTOMATIC_REPLAY_COMPLETE"' \
    'optimizeSelectionReasonSelected = "QUALIFIED_PROFILE_SELECTED"' \
    'func (run *optimizeRun) prepareAutomaticReplay()' \
    'automaticOptimizeImpact = optimize.prepareAutomaticReplay()'; do
    grep -R -F "${buildopt_binding}" \
        "${buildopt_repo_root}/internal/launcher" >/dev/null
done
grep -R -E 'CompletedBeforeGradle[[:space:]]+bool' \
    "${buildopt_repo_root}/internal/launcher" >/dev/null
grep -E '^[[:space:]]*Source[[:space:]]+string' \
    "${buildopt_repo_root}/internal/launcher/optimize_replay.go" >/dev/null

printf 'Magic automatic replay contract OK: exact pre-Gradle selection with native fallback\n'
