#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)

# WCNCP-002 proves scoped HTTPS authority only. No wrapper, public build,
# candidate, timing, or value claim is authorized in this block.
"${buildopt_script_dir}/check-wrapper-coordinated-native-corrections-plan"

cd -- "${buildopt_repo_root}"
exec "${buildopt_script_dir}/run" \
    --toolchain go \
    -- \
    go test \
        -race \
        -count=1 \
        -run '^(TestWCNCP|TestWCNCRetention|TestTypedState|TestCentralHTTPS)' \
        ./internal/sharedcache
