#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)

# WCNCP-007 proves multi-runner convergence and outage behavior on one
# restarted service with three isolated runners. No timing counts as value.
"${buildopt_script_dir}/check-wrapper-coordinated-native-corrections-plan" >/dev/null

cd -- "${buildopt_repo_root}"
exec "${buildopt_script_dir}/run" \
    --toolchain go \
    -- \
    go test \
        -race \
        -count=1 \
        -run '^(TestWCNCPMultiRunner|TestWCNCP|TestWCNCRetention)' \
        ./internal/sharedcache
