#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [--static]\n' "$0" >&2
    exit 64
fi

buildopt_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
buildopt_evidence=${buildopt_root}/benchmarks/results/observed-request-portfolio-lifecycle-v1.json
buildopt_mode=${1:-dynamic}
case ${buildopt_mode} in dynamic | --static) ;; *) printf 'usage: %s [--static]\n' "$0" >&2; exit 64 ;; esac
for buildopt_command in cmp jq mktemp sha256sum; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf '%s is required\n' "${buildopt_command}" >&2
        exit 1
    }
done

buildopt_implementation_sha=$(sha256sum "${buildopt_root}/internal/requestportfolio/portfolio.go" | awk '{print $1}')
buildopt_launcher_sha=$(sha256sum "${buildopt_root}/internal/launcher/request_portfolio.go" | awk '{print $1}')
buildopt_validate() {
    jq -e --arg implementation "${buildopt_implementation_sha}" --arg launcher "${buildopt_launcher_sha}" '
      .schemaVersion=="buildopt.evidence/observed-request-portfolio-lifecycle/v1" and
      .workItem=="SWL-PORTFOLIO-002" and .status=="COMPLETE" and
      .implementationSha256==$implementation and .launcherSha256==$launcher and
      .observation=={
        compatibilityAndGraphSplit:true,exactArgumentIdentity:"LENGTH_PREFIXED_SHA256",
        extraGradleBuilds:0,localObservationOnOutage:true,postBuildOnly:true,
        rawArgumentsPersisted:false,sameInvocationEvidenceBound:true,serverRequired:false,
        workingDirectoryBound:true
      } and
      (.scenarios|length)==4 and
      ([.scenarios[]|select(.name=="RECURRENT_EXACT_REQUEST" and .lifecycle=="EVIDENCE_COMPLETE" and
        .observationCount==3 and .eligibleObservationCount==2 and .success==2 and .buildFailure==1 and
        .cancelled==0 and .bypassed==0 and .candidateEligible)]|length)==1 and
      ([.scenarios[]|select(.name=="INCOMPLETE_REQUEST_GRAPH" and .lifecycle=="OBSERVED_INCOMPLETE" and
        .observationCount==1 and .eligibleObservationCount==0 and .success==1 and (.candidateEligible|not))]|length)==1 and
      ([.scenarios[]|select(.name=="BYPASSED_REQUEST" and .lifecycle=="INELIGIBLE_OUTCOME" and
        .observationCount==1 and .bypassed==1 and .eligibleObservationCount==0 and (.candidateEligible|not))]|length)==1 and
      ([.scenarios[]|select(.name=="CANCELLED_REQUEST" and .lifecycle=="INELIGIBLE_OUTCOME" and
        .observationCount==1 and .cancelled==1 and .eligibleObservationCount==0 and (.candidateEligible|not))]|length)==1 and
      .concurrency=={canonicalPrivateAtomic:true,lostUpdates:0,observationsPersisted:16,writers:16} and
      .bounds=={maximumIdentities:128,observedIdentities:135,retainedIdentities:128} and
      .negativeChecks=={differentArgumentFramingDistinct:true,mismatchedEvidenceRejected:true,mismatchedInvocationRejected:true,unknownFieldsRejected:true} and
      .authority=={activationAuthorized:false,performanceMeasured:false,selectionAuthorized:false} and
      .outcome=="EXACT_OBSERVED_REQUEST_PORTFOLIO_LIFECYCLE_COMPLETE"
    ' "$1" >/dev/null
}

buildopt_validate "${buildopt_evidence}" || {
    printf 'observed request portfolio evidence is invalid\n' >&2
    exit 1
}

buildopt_temporary=$(mktemp -d /tmp/buildopt-observed-request-portfolio-check.XXXXXX)
buildopt_cleanup() {
    case ${buildopt_temporary} in
        /tmp/buildopt-observed-request-portfolio-check.*) rm -rf -- "${buildopt_temporary}" ;;
        *) printf 'refusing to clean unexpected portfolio-check root: %s\n' "${buildopt_temporary}" >&2; return 1 ;;
    esac
}
trap buildopt_cleanup EXIT

jq '.authority.selectionAuthorized=true' "${buildopt_evidence}" >"${buildopt_temporary}/tampered.json"
if buildopt_validate "${buildopt_temporary}/tampered.json"; then
    printf 'invented portfolio selection authority was accepted\n' >&2
    exit 1
fi

if [[ ${buildopt_mode} == --static ]]; then
    printf 'Observed request portfolio: PASS (static)\n'
    exit 0
fi

env GOCACHE="${buildopt_temporary}/go-cache" "${buildopt_root}/dev/run" --toolchain go -- \
    go test -race ./internal/requestportfolio
env GOCACHE="${buildopt_temporary}/go-cache" "${buildopt_root}/dev/run" --toolchain go -- \
    go test ./internal/launcher -run \
    'TestStickyWrapperPersistsExactRequestPortfolioAfterNativeBuild|TestRequestPortfolioKeepsBypassAndFailureIneligible|TestRequestPortfolioPersistsWhenConfiguredServerIsUnavailable|TestRunStickyNativeNoopScrubsWrapperEnvironment'
"${buildopt_root}/dev/run-observed-request-portfolio-fixtures" "${buildopt_temporary}/regenerated.json" >/dev/null
cmp -s "${buildopt_evidence}" "${buildopt_temporary}/regenerated.json" || {
    printf 'observed request portfolio evidence is stale\n' >&2
    diff -u "${buildopt_evidence}" "${buildopt_temporary}/regenerated.json" >&2 || true
    exit 1
}

printf 'Observed request portfolio: PASS\n'
