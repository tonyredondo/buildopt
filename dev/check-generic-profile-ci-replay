#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_root=$(cd -- "${buildopt_script_directory}/.." && pwd -P)
buildopt_spec="${buildopt_root}/specs/poc-generic-profile-ci-replay-v1.json"
buildopt_matrix="${buildopt_root}/specs/poc-generic-profile-matrix-v3.json"
buildopt_workflow="${buildopt_root}/.github/workflows/profile-proposal-replay.yml"
buildopt_temporary=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-profile-ci-replay.XXXXXX")
buildopt_cleanup() {
    if [[ -n "${buildopt_temporary:-}" && \
        "${buildopt_temporary}" == "${TMPDIR:-/tmp}/buildopt-profile-ci-replay."* && \
        -d "${buildopt_temporary}" ]]; then
        rm -rf -- "${buildopt_temporary}"
    fi
}
trap buildopt_cleanup EXIT

for buildopt_command in cmp find grep jq python3 sha256sum sort xargs; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required replay checker command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
for buildopt_file in \
    "${buildopt_spec}" \
    "${buildopt_workflow}" \
    "${buildopt_script_directory}/prepare-generic-profile-ci-replay" \
    "${buildopt_script_directory}/evaluate-generic-profile-ci-replay" \
    "${buildopt_script_directory}/compose-generic-profile-ci-replay"; do
    [[ -f "${buildopt_file}" ]] || {
        printf 'missing generic profile replay surface: %s\n' "${buildopt_file}" >&2
        exit 1
    }
done

jq -e '
    .schemaVersion == "buildopt.specs/poc-generic-profile-ci-replay/v1" and
    .workItem == "POC-GENERIC-PROFILE-CI-REPLAY-001" and
    .actionMode == "profile-proposal" and
    .method.ownerInputCommittedBeforeChange == true and
    .method.timingExecuted == false and
    .method.repositorySpecificProductRulesAllowed == false and
    .method.referenceGraphEqualityRequired == true and
    (.subjects | length) == 5 and
    ([.subjects[].key] | unique | length) == 5 and
    ([.subjects[].expectedProposalDecision] | unique) == ["MEASURE_STRUCTURAL_CANDIDATE"] and
    .acceptance.matchingSubjectsRequired == 5 and
    .acceptance.performanceClaimCreated == false and
    .boundaries.proofOfConcept == true and
    .boundaries.productionAuthorized == false and
    .boundaries.automaticActivation == false and
    .boundaries.testOptimizationModified == false and
    .boundaries.soakRequired == false and
    .boundaries.designPartnerRequired == false
' "${buildopt_spec}" >/dev/null

if ! grep -Fqx '  workflow_dispatch:' "${buildopt_workflow}" ||
    ! grep -Fqx '  contents: read' "${buildopt_workflow}" ||
    grep -Eq '^[[:space:]]+(push|pull_request|pull_request_target|schedule):' \
        "${buildopt_workflow}"; then
    printf 'profile replay workflow has an unsafe trigger or permission\n' >&2
    exit 1
fi
mapfile -t buildopt_remote_uses < <(
    awk '$1 == "uses:" && $2 != "./" {print $2}' "${buildopt_workflow}"
)
if ((${#buildopt_remote_uses[@]} != 6)); then
    printf 'profile replay workflow expected six immutable remote Action uses\n' >&2
    exit 1
fi
for buildopt_use in "${buildopt_remote_uses[@]}"; do
    [[ "${buildopt_use}" =~ ^[^@[:space:]]+@[0-9a-f]{40}$ ]] || {
        printf 'profile replay workflow has a mutable Action: %s\n' \
            "${buildopt_use}" >&2
        exit 1
    }
done

buildopt_fake_base=1111111111111111111111111111111111111111
buildopt_fake_target=2222222222222222222222222222222222222222
buildopt_fake_revision=3333333333333333333333333333333333333333
mapfile -t buildopt_keys < <(jq -r '.subjects[].key' "${buildopt_spec}")
for buildopt_key in "${buildopt_keys[@]}"; do
    buildopt_subject=$(jq -c --arg key "${buildopt_key}" \
        '.subjects[] | select(.key == $key)' "${buildopt_spec}")
    buildopt_repository=$(jq -c --arg key "${buildopt_key}" \
        '.repositories[] | select(.key == $key)' "${buildopt_matrix}")
    buildopt_reference=$(jq -r '.referenceArtifact' <<<"${buildopt_subject}")
    buildopt_reference="${buildopt_root}/${buildopt_reference}"
    buildopt_artifact="${buildopt_temporary}/${buildopt_key}"
    mkdir -p -- "${buildopt_artifact}"
    for buildopt_name in \
        buildopt-fallback-changes.txt \
        buildopt-impact-graph.generated.json \
        buildopt-impact-manifest.json \
        buildopt-impact.generated.json \
        buildopt-profile-proposal.json; do
        cp -- "${buildopt_reference}/${buildopt_name}" \
            "${buildopt_artifact}/${buildopt_name}"
    done

    buildopt_entrypoints_file=$(jq -r '.entrypointsFile // empty' \
        <<<"${buildopt_repository}")
    buildopt_entrypoints_json="${buildopt_temporary}/${buildopt_key}-entrypoints.json"
    if [[ -n "${buildopt_entrypoints_file}" ]]; then
        jq -Rn '[inputs | select(length > 0)]' \
            <"${buildopt_root}/${buildopt_entrypoints_file}" \
            >"${buildopt_entrypoints_json}"
    else
        jq '.entrypoints' <<<"${buildopt_repository}" >"${buildopt_entrypoints_json}"
    fi
    jq -n -S \
        --arg repositoryId "$(jq -r '.repositoryId' <<<"${buildopt_repository}")" \
        --arg pipelineClass "$(jq -r '.pipelineClass' <<<"${buildopt_repository}")" \
        --slurpfile entrypoints "${buildopt_entrypoints_json}" \
        --argjson requiredOutputs "$(jq -c '.requiredOutputs' <<<"${buildopt_repository}")" \
        '{
            schemaVersion: "buildopt.poc/profile-ci-input/v1",
            repositoryId: $repositoryId,
            pipelineClass: $pipelineClass,
            entrypoints: $entrypoints[0],
            requiredOutputs: $requiredOutputs,
            globalChanges: [],
            gradleCommand: "./gradlew",
            gradleOptions: ["--no-scan", "--max-workers=12"],
            timeoutMinutes: 30
        }' >"${buildopt_artifact}/ci-input.json"
    jq -r '.changePath' <<<"${buildopt_repository}" \
        >"${buildopt_artifact}/changes.txt"
    cp -- "${buildopt_artifact}/buildopt-profile-proposal.json" \
        "${buildopt_artifact}/command.stdout.json"
    : >"${buildopt_artifact}/command.stderr.txt"
    printf '# Retained proposal fixture\n' >"${buildopt_artifact}/README.md"
    jq -n -S \
        --arg baseRevision "${buildopt_fake_base}" \
        --arg buildOptRevision "${buildopt_fake_revision}" \
        --arg decision "$(jq -r '.expectedProposalDecision' <<<"${buildopt_subject}")" \
        --arg reason "$(jq -r '.expectedProposalReason' <<<"${buildopt_subject}")" \
        --arg targetRevision "${buildopt_fake_target}" \
        '{
            schemaVersion: "buildopt.poc/profile-ci-review/v1",
            outcome: "COMPLETE",
            artifactName: "local-replay-fixture",
            decision: $decision,
            reason: $reason,
            baseRevision: $baseRevision,
            targetRevision: $targetRevision,
            buildOptRevision: $buildOptRevision,
            reviewRequired: true,
            activationAutomatic: false,
            productionAuthorized: false,
            testOptimization: "OUT_OF_SCOPE"
        }' >"${buildopt_artifact}/review.json"
    (
        cd -- "${buildopt_artifact}"
        find . -maxdepth 1 -type f ! -name checksums.txt -printf '%P\0' |
            sort -z |
            xargs -0 sha256sum >"${buildopt_temporary}/${buildopt_key}-checksums.txt"
        mv -- "${buildopt_temporary}/${buildopt_key}-checksums.txt" checksums.txt
    )
    buildopt_verdict="${buildopt_temporary}/verdicts/${buildopt_key}-replay.json"
    "${buildopt_script_directory}/evaluate-generic-profile-ci-replay" \
        "${buildopt_key}" \
        "${buildopt_artifact}" \
        "${buildopt_fake_base}" \
        "${buildopt_fake_target}" \
        "${buildopt_fake_revision}" \
        "${buildopt_verdict}" >/dev/null
    jq -e '
        .status == "MATCH" and
        .proposalDecision == "MEASURE_STRUCTURAL_CANDIDATE" and
        .timingExecuted == false and
        .activationAutomatic == false
    ' "${buildopt_verdict}" >/dev/null
done

buildopt_drift_artifact="${buildopt_temporary}/spring-framework"
jq '.complete = false' \
    "${buildopt_drift_artifact}/buildopt-impact-graph.generated.json" \
    >"${buildopt_temporary}/drift-graph.json"
mv -- "${buildopt_temporary}/drift-graph.json" \
    "${buildopt_drift_artifact}/buildopt-impact-graph.generated.json"
(
    cd -- "${buildopt_drift_artifact}"
    find . -maxdepth 1 -type f ! -name checksums.txt -printf '%P\0' |
        sort -z |
        xargs -0 sha256sum >"${buildopt_temporary}/drift-checksums.txt"
    mv -- "${buildopt_temporary}/drift-checksums.txt" checksums.txt
)
"${buildopt_script_directory}/evaluate-generic-profile-ci-replay" \
    spring-framework \
    "${buildopt_drift_artifact}" \
    "${buildopt_fake_base}" \
    "${buildopt_fake_target}" \
    "${buildopt_fake_revision}" \
    "${buildopt_temporary}/drift.json" >/dev/null 2>&1
jq -e '
    .status == "DRIFT" and
    (.driftReasons | index("declaredGraph")) != null and
    .activationAutomatic == false
' "${buildopt_temporary}/drift.json" >/dev/null

buildopt_summary="${buildopt_temporary}/summary.json"
"${buildopt_script_directory}/compose-generic-profile-ci-replay" \
    "${buildopt_temporary}/verdicts" \
    "${buildopt_summary}" \
    "${buildopt_fake_revision}" \
    123456 >/dev/null
jq -e '
    .conclusion == "MATCH" and
    .aggregation.subjectCount == 5 and
    .aggregation.matchCount == 5 and
    .aggregation.driftCount == 0 and
    .timingExecuted == false
' "${buildopt_summary}" >/dev/null
rm -f -- "${buildopt_temporary}/verdicts/apache-groovy-replay.json"
"${buildopt_script_directory}/compose-generic-profile-ci-replay" \
    "${buildopt_temporary}/verdicts" \
    "${buildopt_temporary}/incomplete-summary.json" \
    "${buildopt_fake_revision}" \
    123457 >/dev/null
jq -e '
    .conclusion == "DRIFT_OR_INCOMPLETE" and
    .aggregation.subjectCount == 4
' "${buildopt_temporary}/incomplete-summary.json" >/dev/null

printf 'Generic profile CI replay contract passed: five matches, drift classification, and incomplete summary\n'
