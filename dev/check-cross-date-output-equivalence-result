#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [/absolute/evidence/root]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_evidence_root=${1:-"${buildopt_repo_root}/benchmarks/results/poc-cross-date-output-equivalence-v1"}
buildopt_spec="${buildopt_repo_root}/specs/poc-cross-date-output-equivalence-v1.json"
buildopt_installed="${buildopt_repo_root}/benchmarks/results/poc-installed-profile-replay-v1/summary.json"
buildopt_terminal_root="${buildopt_repo_root}/benchmarks/results/poc-generic-change-breadth-v1"
buildopt_summary="${buildopt_evidence_root}/summary.json"

[[ ${buildopt_evidence_root} == /* && -s ${buildopt_summary} ]] || {
    printf 'cross-date evidence root is invalid: %s\n' "${buildopt_evidence_root}" >&2
    exit 1
}
"${buildopt_script_dir}/check-cross-date-output-equivalence" >/dev/null

jq -e --slurpfile spec "${buildopt_spec}" '
  keys == [
    "aggregation", "boundaries", "buildoptRevision", "capturedAt", "cells",
    "method", "schemaVersion", "sourceBindings", "workItem"
  ] and
  .schemaVersion == $spec[0].evidenceSchemaVersion and
  .workItem == $spec[0].workItem and
  (.capturedAt | fromdateiso8601) > 0 and
  (.buildoptRevision | test("^[0-9a-f]{40}$")) and
  all(.sourceBindings[]; test("^[0-9a-f]{64}$")) and
  .method == $spec[0].method and
  .boundaries == $spec[0].boundaries and
  ([.cells[].key] == $spec[0].cells) and
  .aggregation == {
    cells: 6,
    crossDateMatches: 6,
    controlledRealArtifactDateProbes: 2,
    naturalCrossCaptureMatches: 4,
    previousContractDateRejections: 2,
    undeclaredPropertyDriftRejections: 2,
    payloadDriftRejections: 2,
    qualificationsPreserved: 6,
    productAttributableFailures: 0,
    repositoryPercentagesAveraged: false,
    mechanismPercentagesAdded: false
  }
' "${buildopt_summary}" >/dev/null

[[ $(jq -r '.sourceBindings.installedReplaySha256' "${buildopt_summary}") == \
    $(sha256sum "${buildopt_installed}" | awk '{print $1}') ]] || {
    printf 'installed replay binding drifted\n' >&2
    exit 1
}
[[ $(jq -r '.sourceBindings.reviewedContractSha256' "${buildopt_summary}") == \
    $(sha256sum "${buildopt_repo_root}/fixtures/output-equivalence/groovy-jar.json" | awk '{print $1}') ]] || {
    printf 'reviewed output-equivalence binding drifted\n' >&2
    exit 1
}
[[ $(jq -r '.sourceBindings.previousContractSha256' "${buildopt_summary}") == \
    $(sha256sum "${buildopt_terminal_root}/apache-groovy-jar-leaf-source/capture-2/buildopt-output-equivalence.json" | awk '{print $1}') ]] || {
    printf 'previous output-equivalence binding drifted\n' >&2
    exit 1
}

while IFS= read -r buildopt_key; do
    buildopt_cell="${buildopt_evidence_root}/${buildopt_key}"
    [[ -s ${buildopt_cell}/result.json ]] || exit 1
    buildopt_summary_cell=$(jq --arg key "${buildopt_key}" '.cells[] | select(.key == $key)' "${buildopt_summary}")
    cmp --silent <(printf '%s\n' "${buildopt_summary_cell}") <(jq . "${buildopt_cell}/result.json")
    buildopt_terminal_qualification=$(jq '.qualification' \
        "${buildopt_terminal_root}/${buildopt_key}/capture-2/profile.json")
    cmp --silent <(printf '%s\n' "${buildopt_terminal_qualification}") \
        <(jq '.qualification' "${buildopt_cell}/result.json") || {
        printf 'historical qualification changed: %s\n' "${buildopt_key}" >&2
        exit 1
    }
    if [[ ${buildopt_key} == apache-groovy-* ]]; then
        [[ -s ${buildopt_cell}/build.log && -s ${buildopt_cell}/probe.json ]] || exit 1
        if grep -En '/tmp/buildopt-cross-date-output|/home/tony/' "${buildopt_cell}/build.log" >/dev/null; then
            printf 'cross-date log contains a private capture path: %s\n' "${buildopt_key}" >&2
            exit 1
        fi
        [[ $(sha256sum "${buildopt_cell}/build.log" | awk '{print $1}') == \
            $(jq -r '.buildLogSha256' "${buildopt_cell}/result.json") ]] || exit 1
        cmp --silent <(jq '.probe' "${buildopt_cell}/result.json") \
            <(jq . "${buildopt_cell}/probe.json")
        jq -e '
          .controlledDateBoundary.originalRawSha256 != .controlledDateBoundary.mutatedRawSha256 and
          .controlledDateBoundary.previousContractMatched == false and
          .controlledDateBoundary.reviewedContractMatched == true and
          .controlledDateBoundary.originalSemanticSha256 ==
            .controlledDateBoundary.mutatedSemanticSha256 and
          .undeclaredPropertyDrift.reviewedContractMatched == false and
          .undeclaredPropertyDrift.originalSemanticSha256 !=
            .undeclaredPropertyDrift.mutatedSemanticSha256 and
          .nonMetadataPayloadDrift.reviewedContractMatched == false and
          .nonMetadataPayloadDrift.originalSemanticSha256 !=
            .nonMetadataPayloadDrift.mutatedSemanticSha256 and
          .productAttributableFailures == 0
        ' "${buildopt_cell}/probe.json" >/dev/null
    else
        buildopt_installed_cell=$(jq --arg key "${buildopt_key}" \
            '.cells[] | select(.key == $key)' "${buildopt_installed}")
        jq -e --argjson source "${buildopt_installed_cell}" '
          .evidenceKind == "NATURAL_CROSS_CAPTURE" and
          .crossDateOutputMatched == true and
          .terminalOutputSha256 == $source.terminalOutputSha256 and
          .replayOutputSha256 == $source.candidate.output.sha256 and
          .qualification == $source.qualification and
          .productAttributableFailures == 0
        ' "${buildopt_cell}/result.json" >/dev/null
    fi
done < <(jq -r '.cells[]' "${buildopt_spec}")

printf 'Cross-date output-equivalence evidence OK: 6/6 matches, undeclared drift rejected\n'
