#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)) || [[ $1 != /* ]]; then
    printf 'usage: %s /absolute/evidence/output/directory\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_spec=${buildopt_repo_root}/specs/poc-cross-commit-breadth-v2.subjects.json
buildopt_raw_summary=${buildopt_output}/raw/summary.json

[[ -s ${buildopt_spec} && -s ${buildopt_raw_summary} ]] || {
    printf 'cross-commit breadth V2 inputs are unavailable\n' >&2
    exit 1
}

buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_raw_sha=$(sha256sum "${buildopt_raw_summary}" | awk '{print $1}')

jq -S \
    --arg specSha "${buildopt_spec_sha}" \
    --arg rawSha "${buildopt_raw_sha}" '
  def claim_eligible:
    .qualification.calibration.qualified and
    .qualification.portability.status == "PORTABLE" and
    .economics.selectedReplays > 0 and
    .economics.cumulativeNetSavedMs > 0 and
    all(.observations[]; .exactRequiredOutputs);
  def classification:
    if (.qualification.calibration.qualified | not) then
      "CALIBRATION_VALUE_NOT_PROVEN"
    elif .qualification.portability.status != "PORTABLE" then
      "NATIVE_OUTPUTS_NOT_PORTABLE"
    elif .economics.selectedReplays == 0 then
      "NO_COMPATIBLE_REPLAY"
    elif .economics.cumulativeNetSavedMs <= 0 then
      "VALUE_NOT_PAID_BACK"
    else "CLAIM_ELIGIBLE" end;
  ([.subjects[] | select(claim_eligible)] | length) as $eligible |
  {schemaVersion:"buildopt.evidence/poc-cross-commit-breadth-v2/v1",
   workItem:"POC-CROSS-COMMIT-BREADTH-V2-001",
   capturedAt:.capturedAt,
   decision:(if $eligible >= 2 then "BROADEN_CROSS_COMMIT_VALUE_CLAIM"
     else "RETAIN_BOUNDED_CROSS_COMMIT_VALUE_CLAIM" end),
   protocol:{spec:"specs/poc-cross-commit-breadth-v2.subjects.json",
     specSha256:$specSha,engineSummary:"raw/summary.json",
     engineSummarySha256:$rawSha,method:"PRODUCER_BOUND_QUALIFIED_LIFETIME_V2",
     minimumClaimEligibleSubjects:2,percentagesAggregatedAcrossRepositories:false},
   buildopt:.buildopt,runner:.runner,
   subjects:[.subjects[] |
     {key,repository:.repository.id,classification:classification,
      claimEligible:claim_eligible,
      qualification:{targetRevision:.qualification.targetRevision,
        changeFamily:.qualification.changeFamily,graph:.qualification.graph,
        calibration:.qualification.calibration,
        portability:.qualification.portability},
      observations,economics,acceptance}],
   result:{evaluatedSubjects:(.subjects|length),
     qualifiedSubjects:([.subjects[]|select(.qualification.calibration.qualified)]|length),
     portableSubjects:([.subjects[]|select(.qualification.portability.status == "PORTABLE")]|length),
     claimEligibleSubjects:$eligible,
     observedBuilds:([.subjects[].economics.observedBuilds]|add),
     selectedReplays:([.subjects[].economics.selectedReplays]|add),
     cumulativeNetSavedMs:([.subjects[].economics.cumulativeNetSavedMs]|add),
     crossCommitClaimBroadened:($eligible >= 2),productFailures:0},
   boundaries:{proofOfConcept:true,productionAuthorized:false,
     repositorySpecificProductRules:false,soakRequired:false,
     designPartnerRequired:false,testOptimization:"OUT_OF_SCOPE"}}
' "${buildopt_raw_summary}"
