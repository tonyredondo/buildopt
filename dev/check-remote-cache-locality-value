#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

jq -e '
  .schemaVersion == "buildopt.specs/poc-remote-cache-locality-value/v2" and
  .workItem == "RCL" and
  .objective == "PROVE_REMOTE_CACHE_LOCALITY_PRODUCT_VALUE" and
  .baseline == "OPTIMIZED_NATIVE_GRADLE_DIRECT_TO_REMOTE_SHARED" and
  .status == {currentBlock:"RCL-003",completedBlocks:["RCL-001","RCL-002"],publicBuildAuthorized:true,timingAuthorized:false} and
  .predecessors.maySupplyEvidenceRows == false and
  .predecessors.shapedNetworkMaySatisfyTerminalGate == false and
  .predecessors.mixedMechanismResultsMaySatisfyTerminalGate == false and
  .cohort == {completeFamilies:5,freshEvidenceRequired:true,repositoryOrTaskNameRulesAllowed:false} and
  .singleChangedInput == "CACHE_READ_LOCATION" and
  .equalOpportunity.sameGradleCommand and .equalOpportunity.sameGraph and
  .equalOpportunity.sameTaskOutcomes and .equalOpportunity.sameRequestedCacheKeys and
  .equalOpportunity.sameCommittedObjectSha256AndLength and .equalOpportunity.sameRequiredOutputs and
  .equalOpportunity.readOnlyMeasuredArms and (.equalOpportunity.nativeLocalCacheEnabled | not) and
  .equalOpportunity.independentEquivalentHomes and .equalOpportunity.candidateWarmOriginReadsMaximum == 0 and
  .network.terminalProfile == "FROZEN_UNSHAPED_OWNER_OPERATED_REMOTE_PATH" and
  .network.freezeBeforeFirstPair and .network.shapedProfilesDiagnosticOnly and
  .costAccounting.includeSeed and .costAccounting.includeEdgeFill and
  .costAccounting.includeVerification and .costAccounting.includeStartupAndOperation and
  .costAccounting.includeFallbackAndNativeRetention and
  .gates.publicCorrectness == {conclusiveFamilies:5,minimumEligibleFamilies:3,minimumRestoredObjectsPerEligibleFamily:4,minimumRestoredBytesPerEligibleFamily:8388608,timingAllowedBeforePass:false} and
  .gates.warmValue.pairsPerEligibleFamily == 8 and .gates.warmValue.minimumPositivePairs == 6 and
  .gates.warmValue.minimumSavedMs == 500 and .gates.warmValue.minimumReductionRatio == 0.02 and
  .gates.warmValue.positiveLower95Bound and .gates.warmValue.p95NonRegressive and
  .gates.warmValue.minimumPositiveFamilies == 3 and .gates.warmValue.productFailureBudget == 0 and
  .gates.installedValue.minimumOrdinaryBuildsPerPassingFamily == 20 and
  .gates.installedValue.minimumNetPositiveFamilies == 3 and
  .gates.installedValue.positiveSignedPortfolioMs and
  .gates.installedValue.maximumPaybackCacheConsumingBuilds == 10 and
  .blocks == ["RCL-001","RCL-002","RCL-003","RCL-004","RCL-005","RCL-006"] and
  (.forbiddenMechanisms | length) == 6 and
  (.measurement.hostedCiOwnsWallTimeGate | not) and
  (.measurement.predecessorTimingsReusable | not) and
  (.measurement.thresholdsMayMoveAfterMeasurement | not) and
  (.measurement.failedPairsMayBeDiscarded | not) and
  (.boundaries.publicSourcePatchAuthorized | not) and
  (.boundaries.productionAuthorized | not) and .boundaries.testOptimization == "OUT_OF_SCOPE"
' specs/poc-remote-cache-locality-value-v2.json >/dev/null

jq -e '
  .schemaVersion == "buildopt.specs/poc-remote-cache-locality-value-subjects/v2" and
  .reusePolicy == "SUBJECT_SELECTION_ONLY_ALL_RCL_EVIDENCE_FRESH" and
  (.families | length) == 5 and
  ([.families[].key] | unique | length) == 5 and
  ([.families[].repository] | unique | length) == 5 and
  ([.families[].revision] | unique | length) == 5 and
  all(.families[]; (.revision | test("^[0-9a-f]{40}$")) and
      (.workflow | length) > 0 and (.requiredOutputs | length) > 0)
' specs/poc-remote-cache-locality-value-v2.subjects.json >/dev/null

grep -Fq "**Current block:** \`RCL-003\`" docs/plans/remote-cache-locality-value-poc-tracker.md
grep -Eq "\`RCL-001\`.*\`DONE\`" docs/plans/remote-cache-locality-value-poc-tracker.md
for block in RCL-003 RCL-004 RCL-005 RCL-006; do
    if [[ "${block}" == RCL-003 ]]; then
        grep -Eq "\`${block}\`.*\`TODO\`" docs/plans/remote-cache-locality-value-poc-tracker.md
    else
        grep -Eq "\`${block}\`.*\`WAITING\`" docs/plans/remote-cache-locality-value-poc-tracker.md
    fi
done
grep -Fq 'zero public builds and zero timing samples' benchmarks/results/remote-cache-locality-value-v2/README.md

printf 'RCL contract OK: equal-opportunity locality v2 frozen before public builds or timing\n'
