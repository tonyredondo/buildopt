#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_contract="${buildopt_repo_root}/specs/poc-value-validation-v1.json"
buildopt_cache="${buildopt_repo_root}/benchmarks/results/cache-parity-v1-local.json"
buildopt_runtime="${buildopt_repo_root}/benchmarks/results/b-runtime-owner-evaluation.json"
buildopt_impact="${buildopt_repo_root}/benchmarks/results/build-impact-performance-v1-local.json"
buildopt_baseline="${buildopt_repo_root}/benchmarks/results/poc-value-baseline-v1.json"
buildopt_negative="${buildopt_repo_root}/benchmarks/results/poc-value-negative-mechanisms-v1.json"
buildopt_coverage="${buildopt_repo_root}/benchmarks/results/poc-value-coverage-v1.json"

command -v jq >/dev/null 2>&1 || {
    printf 'required POC value command is unavailable: jq\n' >&2
    exit 1
}

"${buildopt_script_dir}/check-cache-parity-performance" "${buildopt_cache}" >/dev/null
"${buildopt_script_dir}/check-runtime-owner-evaluation" >/dev/null
"${buildopt_script_dir}/check-build-impact-performance" "${buildopt_impact}" >/dev/null
"${buildopt_script_dir}/check-poc-value-baseline" "${buildopt_baseline}" >/dev/null
"${buildopt_script_dir}/check-poc-value-negative-mechanisms" "${buildopt_negative}" >/dev/null
"${buildopt_script_dir}/check-poc-value-coverage" "${buildopt_coverage}" >/dev/null

jq -e \
    --slurpfile cache "${buildopt_cache}" \
    --slurpfile runtime "${buildopt_runtime}" \
    --slurpfile impact "${buildopt_impact}" \
    --slurpfile baseline "${buildopt_baseline}" \
    --slurpfile negative "${buildopt_negative}" \
    --slurpfile coverage "${buildopt_coverage}" '
    .schemaVersion == "buildopt.specs/poc-value-validation/v1" and
    .decision.objective == "REDUCE_CUSTOMER_VISIBLE_BUILD_TIME_AGAINST_OPTIMIZED_NATIVE_GRADLE" and
    .decision.currentVerdict == "CONTINUE_CONDITIONALLY" and
    .decision.pocValueProven == false and
    .decision.noValueNoAction == true and
    .scope.doesNotBlockPoc == [
        "EIGHT_HOUR_SOAK",
        "EXTERNAL_DESIGN_PARTNER",
        "HIGH_AVAILABILITY",
        "ENTERPRISE_IDENTITY",
        "MULTI_TENANCY",
        "PRODUCTION_PROMOTION_SAMPLE"
    ] and
    .measurement.nativeBaseline.buildCache == true and
    .measurement.nativeBaseline.configurationCacheWhenCompatible == true and
    .measurement.nativeBaseline.parallelismWhenCompatible == true and
    .measurement.combinedPairsPerWorkloadMinimum >= 8 and
    .measurement.representativeWorkloadClassesMinimum >= 2 and
    .measurement.requiredDslCoverage == ["KOTLIN", "GROOVY"] and
    .measurement.acceleratorThreshold.minimumSavedMs == 500 and
    .measurement.acceleratorThreshold.minimumReductionRatio == 0.02 and
    .measurement.acceleratorThreshold.positiveLower95Bound == true and
    .measurement.acceleratorThreshold.requiredOutputsIdentical == true and
    .measurement.acceleratorThreshold.maximumProductAttributableFailures == 0 and
    .measurement.safetyEnablerThreshold.maximumAbsoluteNativeRegressionRatio == 0.02 and
    .measurement.safetyEnablerThreshold.mayClaimAcceleration == false and
    ([.mechanisms[].id] | length == (unique | length)) and
    ([.mechanisms[] | select(.id == "SAFE_CACHE" and .classification == "NO_VALUE_NO_ACTION" and .evidence == "benchmarks/results/poc-value-negative-mechanisms-v1.json")] | length) == 1 and
    ([.mechanisms[] | select(.id == "RUNTIME_TUNING" and .classification == "NO_VALUE_NO_ACTION" and .evidence == "benchmarks/results/poc-value-negative-mechanisms-v1.json")] | length) == 1 and
    ([.mechanisms[] | select(.id == "BUILD_IMPACT" and .classification == "THRESHOLD_MET_REQUIRED_BREADTH" and .evidence == "benchmarks/results/poc-value-coverage-v1.json")] | length) == 1 and
    ([.mechanisms[] | select(.id == "TASK_INTELLIGENCE_REVIEWED_SOURCE" and .classification == "THRESHOLD_MET_REVIEWED_CUSTOM_TASK" and .evidence == "benchmarks/results/poc-value-coverage-v1.json")] | length) == 1 and
    ([.mechanisms[] | select(.id == "AGENT_DISCOVERY" and .classification == "UNAVAILABLE")] | length) == 1 and
    ([.mechanisms[] | select(.id == "HERMETIC_PRODUCER" and .classification == "UNAVAILABLE")] | length) == 1 and
    ([.mechanisms[] | select(.id == "PATCH_AUTOPILOT" and .classification == "THRESHOLD_MET_REVIEWED_CUSTOM_TASK_RECIPE" and .evidence == "benchmarks/results/poc-value-coverage-v1.json")] | length) == 1 and
    ([.mechanisms[] | select(.id == "COMBINED_PRODUCT_PATH" and .classification == "NOT_RUN" and .evidence == null)] | length) == 1 and
    ([.nextGates[] | select(.state == "TODO")] | length) == 1 and
    .nextGates == [
        {
            id: "POC-VALUE-001",
            outcome: "REPRODUCE_OPTIMIZED_NATIVE_BASELINE_AND_MECHANISM_SCORECARD_ON_GOLDEN_RUNNER",
            state: "DONE"
        },
        {
            id: "POC-VALUE-002",
            outcome: "SAFE_CACHE_RETURNS_TO_PARITY_AND_RUNTIME_TUNING_CLEARS_THRESHOLD_OR_IS_DISABLED",
            state: "DONE"
        },
        {
            id: "POC-VALUE-003",
            outcome: "BUILD_IMPACT_TASK_AND_PATCH_PASS_REQUIRED_WORKLOAD_BREADTH",
            state: "DONE"
        },
        {
            id: "POC-VALUE-004",
            outcome: "COMBINED_PRODUCT_BEATS_OPTIMIZED_NATIVE_GRADLE_OR_POC_STOPS",
            state: "TODO"
        }
    ] and
    $baseline[0].gate.id == "POC-VALUE-001" and
    $baseline[0].gate.state == "PASSED" and
    $baseline[0].gate.pocValueProven == false and
    $baseline[0].mechanisms.safeCache.classification == "REGRESSION_REQUIRES_ACTION" and
    $baseline[0].mechanisms.safeCache.groovy.meanReductionRatio < -0.02 and
    $baseline[0].mechanisms.runtimeTuning.classification == "BELOW_VALUE_THRESHOLD" and
    $baseline[0].mechanisms.runtimeTuning.meanSavedMs < 0 and
    $baseline[0].mechanisms.runtimeTuning.interval95SavedMs[1] < 0 and
    $baseline[0].mechanisms.buildImpact.classification == "THRESHOLD_MET" and
    $baseline[0].mechanisms.buildImpact.meanSavedMs >= .measurement.acceleratorThreshold.minimumSavedMs and
    $baseline[0].mechanisms.buildImpact.meanReductionRatio >= .measurement.acceleratorThreshold.minimumReductionRatio and
    $baseline[0].mechanisms.buildImpact.interval95SavedMs[0] > 0 and
    $baseline[0].mechanisms.buildImpact.requiredOutputsIdentical and
    $baseline[0].mechanisms.buildImpact.productAttributableFailures == 0 and
    $negative[0].gate == {
        id: "POC-VALUE-002",
        state: "PASSED",
        next: "POC-VALUE-003",
        pocValueProven: false
    } and
    $negative[0].safeCache.classification == "NO_VALUE_NO_ACTION" and
    $negative[0].safeCache.activation == "EXPLICIT_ONLY" and
    $negative[0].safeCache.defaultPath == "NATIVE_GRADLE_CACHE" and
    $negative[0].safeCache.kotlin.meanReductionRatio >= -0.02 and
    $negative[0].safeCache.groovy.meanReductionRatio >= -0.02 and
    $negative[0].runtimeTuning.classification == "NO_VALUE_NO_ACTION" and
    $negative[0].runtimeTuning.activation == "STABLE_CONTROL_ONLY" and
    $negative[0].runtimeTuning.evaluatedCandidateProfile == "W3_H4G" and
    $negative[0].runtimeTuning.requiredOutputsIdentical and
    $negative[0].runtimeTuning.productAttributableFailures == 0 and
    $coverage[0].gate == {
        id: "POC-VALUE-003",
        state: "PASSED",
        next: "POC-VALUE-004",
        pocValueProven: false
    } and
    $coverage[0].summary == {
        workloadClasses: ["REVIEWED_CUSTOM_TASK", "UNRELATED_NON_CACHEABLE_WORK"],
        dslCoverage: ["GROOVY", "KOTLIN"],
        qualifyingWorkloads: 4,
        buildImpactQualifiesBothDsls: true,
        taskIntelligenceQualifiesBothDsls: true,
        patchAutopilotQualifiesBothDsls: true
    }
    ' "${buildopt_contract}" >/dev/null

jq -n \
    --slurpfile contract "${buildopt_contract}" \
    --slurpfile cache "${buildopt_cache}" \
    --slurpfile runtime "${buildopt_runtime}" \
    --slurpfile impact "${buildopt_impact}" \
    --slurpfile baseline "${buildopt_baseline}" \
    --slurpfile negative "${buildopt_negative}" \
    --slurpfile coverage "${buildopt_coverage}" '
    {
        verdict: $contract[0].decision.currentVerdict,
        pocValueProven: $contract[0].decision.pocValueProven,
        safeCache: $negative[0].safeCache.classification,
        safeCacheActivation: $negative[0].safeCache.activation,
        runtimeTuning: $negative[0].runtimeTuning.classification,
        runtimeTuningActivation: $negative[0].runtimeTuning.activation,
        buildImpact: "THRESHOLD_MET_REQUIRED_BREADTH",
        reviewedTask: "THRESHOLD_MET_REVIEWED_CUSTOM_TASK",
        reviewedPatch: "THRESHOLD_MET_REVIEWED_CUSTOM_TASK_RECIPE",
        combinedProduct: "NOT_RUN",
        nativeCacheWorstReductionRatio:
            ([$negative[0].safeCache.kotlin.meanReductionRatio,
              $negative[0].safeCache.groovy.meanReductionRatio] | min),
        runtimeSavedMs: $negative[0].runtimeTuning.meanSavedMs,
        qualifiedWorkloads: $coverage[0].summary.qualifyingWorkloads,
        coverageSavedMs:
            ($coverage[0].workloads |
             map({key: .id, value: .result.meanSavedMs}) | from_entries),
        openGates:
            [$contract[0].nextGates[] | select(.state == "TODO") | .id]
    }
    '
