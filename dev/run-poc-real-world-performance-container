#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)); then
    printf 'usage: %s OUTPUT_FILE\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_contract="${buildopt_repo_root}/specs/poc-real-world-performance-v1.json"
buildopt_compatibility_contract="${buildopt_repo_root}/specs/poc-real-world-compatibility-v1.json"
buildopt_compatibility_evidence="${buildopt_repo_root}/benchmarks/results/poc-real-world-compatibility-v1.json"
buildopt_runner_spec="${buildopt_repo_root}/specs/golden-lane-runner-v1.json"

if [[ "${buildopt_output}" != /* || -e "${buildopt_output}" ]]; then
    printf 'invalid POC-REALWORLD-002 output path\n' >&2
    exit 64
fi
for buildopt_command in awk cp date docker find git grep jq mkdir mktemp \
    sed sha256sum sort tar; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required POC-REALWORLD-002 command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
if [[ -n "$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)" ]]; then
    printf 'POC-REALWORLD-002 requires a clean revision-bound checkout\n' >&2
    exit 1
fi
if ! docker info >/dev/null 2>&1; then
    printf 'Docker daemon is unavailable\n' >&2
    exit 1
fi

buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-poc-realworld-002.XXXXXX")
buildopt_containers=()
buildopt_cleanup() {
    local buildopt_container
    for buildopt_container in "${buildopt_containers[@]}"; do
        docker rm -f "${buildopt_container}" >/dev/null 2>&1 || true
    done
    if [[ "${buildopt_root}" == "${TMPDIR:-/tmp}/buildopt-poc-realworld-002."* ]]; then
        rm -rf -- "${buildopt_root}"
    fi
}
trap buildopt_cleanup EXIT

mkdir -p -- "${buildopt_root}/release" "${buildopt_root}/package" \
    "${buildopt_root}/install" "${buildopt_root}/repositories"
chmod 0700 "${buildopt_root}"

buildopt_revision=$(git -C "${buildopt_repo_root}" rev-parse HEAD)
buildopt_spec_sha=$(sha256sum "${buildopt_contract}" | awk '{print $1}')
buildopt_compatibility_spec_sha=$(sha256sum "${buildopt_compatibility_contract}" | awk '{print $1}')
buildopt_compatibility_evidence_sha=$(sha256sum "${buildopt_compatibility_evidence}" | awk '{print $1}')
if [[ "${buildopt_compatibility_spec_sha}" != \
    "$(jq -er '.inputs.compatibilitySpecSha256' "${buildopt_contract}")" ||
    "${buildopt_compatibility_evidence_sha}" != \
    "$(jq -er '.inputs.compatibilityEvidenceSha256' "${buildopt_contract}")" ]]; then
    printf 'POC-REALWORLD-002 compatibility input drifted after preregistration\n' >&2
    exit 1
fi
"${buildopt_script_dir}/check-poc-real-world-compatibility" >/dev/null
"${buildopt_script_dir}/check-poc-real-world-performance" --spec-only >/dev/null

buildopt_image=$(jq -er '.container.reference' "${buildopt_runner_spec}")
buildopt_platform_digest=$(jq -er '.container.platformDigest' "${buildopt_runner_spec}")
buildopt_cpu=$(jq -er '.runnerClass.cpuCount' "${buildopt_runner_spec}")
buildopt_memory=$(jq -er '.runnerClass.memoryBytes' "${buildopt_runner_spec}")
buildopt_runner_spec_sha=$(sha256sum "${buildopt_runner_spec}" | awk '{print $1}')

docker pull --quiet --platform linux/amd64 "${buildopt_image}" >/dev/null
if ! docker image inspect "${buildopt_image}" |
    jq -e --arg digest "${buildopt_platform_digest}" '
        length == 1 and .[0].Os == "linux" and .[0].Architecture == "amd64" and
        any(.[0].RepoDigests[]?; endswith("@" + $digest))
    ' >/dev/null; then
    printf 'POC-REALWORLD-002 image does not match the pinned platform digest\n' >&2
    exit 1
fi

"${buildopt_repo_root}/dev/run" -- ./gradlew --no-daemon \
    :jvm:gradle-plugin:clean :jvm:jvm-agent:clean >/dev/null
buildopt_archive=$("${buildopt_repo_root}/packaging/linux/package.sh" \
    --version 0.3.0-realworld002 --output "${buildopt_root}/release")
tar -xzf "${buildopt_archive}" -C "${buildopt_root}/package"
buildopt_package_root=$(find "${buildopt_root}/package" -mindepth 1 -maxdepth 1 \
    -type d -name 'buildopt-0.3.0-realworld002-linux-amd64' -print -quit)
if [[ -z "${buildopt_package_root}" ]]; then
    printf 'POC-REALWORLD-002 package layout is unavailable\n' >&2
    exit 1
fi
"${buildopt_package_root}/install.sh" --prefix "${buildopt_root}/install" >/dev/null
"${buildopt_root}/install/bin/buildopt" doctor >/dev/null
buildopt_executable_sha=$(sha256sum "${buildopt_root}/install/bin/buildopt" | awk '{print $1}')
buildopt_plugin="${buildopt_root}/install/share/buildopt/buildopt-gradle-plugin.jar"
[[ -s "${buildopt_plugin}" ]] || {
    printf 'POC-REALWORLD-002 installed Gradle plugin is unavailable\n' >&2
    exit 1
}
buildopt_plugin_sha=$(sha256sum "${buildopt_plugin}" | awk '{print $1}')

buildopt_environment=(
    -u CI
    -u ANDROID_HOME
    -u GITHUB_TOKEN
    -u GH_TOKEN
    -u DEVELOCITY_ACCESS_KEY
    -u GRADLE_ENTERPRISE_ACCESS_KEY
    -u ORG_GRADLE_PROJECT_signingKey
    -u ORG_GRADLE_PROJECT_signingPassword
    -u buildcacheuser
    -u buildcachepass
)

buildopt_hash_outputs() {
    local buildopt_checkout=$1
    local buildopt_repository_index=$2
    local buildopt_scenario=$3
    local buildopt_manifest=$4
    local buildopt_output_root
    local buildopt_file
    local buildopt_relative

    : >"${buildopt_manifest}"
    while IFS= read -r buildopt_output_root; do
        if [[ ! -d "${buildopt_checkout}/${buildopt_output_root}" ]]; then
            printf 'required POC-REALWORLD-002 output root is unavailable: %s\n' \
                "${buildopt_output_root}" >&2
            return 1
        fi
        while IFS= read -r -d '' buildopt_file; do
            buildopt_relative=${buildopt_file#"${buildopt_checkout}/"}
            printf '%s  %s\n' \
                "$(sha256sum "${buildopt_file}" | awk '{print $1}')" \
                "${buildopt_relative}" >>"${buildopt_manifest}"
        done < <(find "${buildopt_checkout}/${buildopt_output_root}" \
            -type f -print0 | sort -z)
    done < <(jq -r \
        ".repositories[${buildopt_repository_index}].requiredOutputs.${buildopt_scenario}[]" \
        "${buildopt_contract}")
    [[ -s "${buildopt_manifest}" ]] || {
        printf 'POC-REALWORLD-002 produced no required output files\n' >&2
        return 1
    }
}

buildopt_container_name() {
    local buildopt_repository_id=$1
    local buildopt_scenario=$2
    local buildopt_arm=$3
    local buildopt_nonce
    buildopt_nonce=$(basename "${buildopt_root}" | tr -cd 'a-zA-Z0-9' | tail -c 10)
    printf 'buildopt-rw2-%s-%s-%s-%s' \
        "${buildopt_repository_id,,}" "${buildopt_scenario,,}" \
        "${buildopt_arm,,}" "${buildopt_nonce}"
}

buildopt_start_container() {
    local buildopt_name=$1
    local buildopt_checkout=$2
    local buildopt_home=$3
    local buildopt_gradle_home=$4
    local buildopt_xdg_cache=$5
    mkdir -p -- "${buildopt_home}" "${buildopt_gradle_home}" "${buildopt_xdg_cache}"
    chmod 0700 "${buildopt_home}" "${buildopt_gradle_home}" "${buildopt_xdg_cache}"
    docker create --name "${buildopt_name}" --platform linux/amd64 \
        --cpus "${buildopt_cpu}" --memory "${buildopt_memory}" \
        --user "$(id -u):$(id -g)" \
        --env HOME=/benchmark/home \
        --env GRADLE_USER_HOME=/benchmark/gradle-home \
        --env XDG_CACHE_HOME=/benchmark/xdg-cache \
        --env LANG=C.UTF-8 --env LC_ALL=C.UTF-8 --env TZ=UTC \
        --volume "${buildopt_checkout}:/repo" \
        --volume "${buildopt_home}:/benchmark/home" \
        --volume "${buildopt_gradle_home}:/benchmark/gradle-home" \
        --volume "${buildopt_xdg_cache}:/benchmark/xdg-cache" \
        --volume "${buildopt_root}/install:/benchmark/install:ro" \
        --workdir /repo "${buildopt_image}" \
        /bin/sh -c 'while :; do sleep 3600; done' >/dev/null
    buildopt_containers+=("${buildopt_name}")
    docker start "${buildopt_name}" >/dev/null
}

buildopt_duration_ms=0
buildopt_started_ns=0
buildopt_finished_ns=0
buildopt_configuration_cache_reused=false
buildopt_omitted_declared_task=false

buildopt_run_arm() {
    local buildopt_repository_index=$1
    local buildopt_scenario=$2
    local buildopt_arm=$3
    local buildopt_container=$4
    local buildopt_log=$5
    local buildopt_offline=$6
    local buildopt_declared_task
    local buildopt_configuration_cache
    local buildopt_status
    local -a buildopt_arguments=(--daemon --parallel --console=plain --stacktrace)
    local -a buildopt_entrypoints=()
    local -a buildopt_command=()

    mapfile -t buildopt_repository_arguments < <(
        jq -r ".repositories[${buildopt_repository_index}].repositoryArguments[]" \
            "${buildopt_contract}"
    )
    buildopt_arguments+=("${buildopt_repository_arguments[@]}")
    if [[ "${buildopt_offline}" == true ]]; then
        buildopt_arguments+=(--offline)
    fi
    buildopt_configuration_cache=$(jq -r \
        ".repositories[${buildopt_repository_index}].configurationCache" \
        "${buildopt_contract}")
    if [[ "${buildopt_configuration_cache}" == true ]]; then
        buildopt_arguments+=(--configuration-cache)
    fi
    if [[ "${buildopt_scenario}" == LEAF_SOURCE_CHANGE && \
        "${buildopt_arm}" == CANDIDATE ]]; then
        mapfile -t buildopt_entrypoints < <(
            jq -r ".repositories[${buildopt_repository_index}].selectedEntrypoints[]" \
                "${buildopt_contract}"
        )
    else
        mapfile -t buildopt_entrypoints < <(
            jq -r ".repositories[${buildopt_repository_index}].originalEntrypoints[]" \
                "${buildopt_contract}"
        )
    fi
    if [[ "${buildopt_arm}" == CONTROL ]]; then
        buildopt_command=(./gradlew --build-cache "${buildopt_arguments[@]}" \
            "${buildopt_entrypoints[@]}")
    else
        buildopt_command=(/benchmark/install/bin/buildopt gradle \
            "${buildopt_arguments[@]}" "${buildopt_entrypoints[@]}")
    fi

    buildopt_started_ns=$(date +%s%N)
    set +e
    docker exec --user "$(id -u):$(id -g)" --workdir /repo \
        "${buildopt_container}" /usr/bin/env "${buildopt_environment[@]}" \
        "${buildopt_command[@]}" >"${buildopt_log}" 2>&1
    buildopt_status=$?
    set -e
    buildopt_finished_ns=$(date +%s%N)
    buildopt_duration_ms=$(((buildopt_finished_ns - buildopt_started_ns) / 1000000))
    if ((buildopt_status != 0)); then
        tail -n 160 "${buildopt_log}" >&2
        printf 'POC-REALWORLD-002 %s/%s arm failed\n' \
            "${buildopt_scenario}" "${buildopt_arm}" >&2
        return 1
    fi
    grep -Fq 'BUILD SUCCESSFUL' "${buildopt_log}" || {
        printf 'POC-REALWORLD-002 arm lacks Gradle success marker\n' >&2
        return 1
    }
    if grep -Eq '^> Task .*:(publish|upload|release|sign)([A-Z:]|$)' \
        "${buildopt_log}"; then
        printf 'POC-REALWORLD-002 executed a forbidden release task\n' >&2
        return 1
    fi
    if grep -Eq 'Publishing build scan|Build scan published|https://gradle[.]com/s/' \
        "${buildopt_log}"; then
        printf 'POC-REALWORLD-002 published a forbidden build scan\n' >&2
        return 1
    fi
    if [[ "${buildopt_arm}" == CANDIDATE ]] &&
        grep -Eiq 'BuildOpt.*(unavailable|authentication failed|handshake failed|broken pipe)' \
            "${buildopt_log}"; then
        printf 'POC-REALWORLD-002 observed a BuildOpt product warning\n' >&2
        return 1
    fi
    buildopt_configuration_cache_reused=false
    if grep -Fq 'Reusing configuration cache.' "${buildopt_log}"; then
        buildopt_configuration_cache_reused=true
    fi
    if [[ "${buildopt_offline}" == true &&
        "${buildopt_configuration_cache}" != "${buildopt_configuration_cache_reused}" ]]; then
        printf 'POC-REALWORLD-002 Configuration Cache state mismatch\n' >&2
        return 1
    fi
    buildopt_declared_task=$(jq -er \
        ".repositories[${buildopt_repository_index}].candidateMustOmitTask" \
        "${buildopt_contract}")
    buildopt_omitted_declared_task=false
    if ! grep -Fq "> Task ${buildopt_declared_task}" "${buildopt_log}"; then
        buildopt_omitted_declared_task=true
    fi
    if [[ "${buildopt_scenario}" == LEAF_SOURCE_CHANGE ]]; then
        if [[ "${buildopt_arm}" == CONTROL && \
            "${buildopt_omitted_declared_task}" == true ]]; then
            printf 'POC-REALWORLD-002 control omitted declared full-graph task\n' >&2
            return 1
        fi
        if [[ "${buildopt_arm}" == CANDIDATE && \
            "${buildopt_omitted_declared_task}" != true ]]; then
            printf 'POC-REALWORLD-002 candidate executed declared unrelated task\n' >&2
            return 1
        fi
    fi
}

buildopt_record_observation() {
    local buildopt_repository_id=$1
    local buildopt_scenario=$2
    local buildopt_pair=$3
    local buildopt_order=$4
    local buildopt_control_ms=$5
    local buildopt_candidate_ms=$6
    local buildopt_gap_ms=$7
    local buildopt_control_output_sha=$8
    local buildopt_candidate_output_sha=$9
    local buildopt_output_count=${10}
    local buildopt_control_source_sha=${11}
    local buildopt_candidate_source_sha=${12}
    local buildopt_control_cc=${13}
    local buildopt_candidate_cc=${14}
    local buildopt_candidate_omitted=${15}
    local buildopt_original_entrypoints=${16}
    local buildopt_candidate_entrypoints=${17}
    local buildopt_raw=${18}
    jq -cn \
        --arg repositoryId "${buildopt_repository_id}" \
        --arg scenarioId "${buildopt_scenario}" \
        --arg order "${buildopt_order}" \
        --arg controlOutputSha256 "${buildopt_control_output_sha}" \
        --arg candidateOutputSha256 "${buildopt_candidate_output_sha}" \
        --arg controlSourceSha256 "${buildopt_control_source_sha}" \
        --arg candidateSourceSha256 "${buildopt_candidate_source_sha}" \
        --argjson pair "${buildopt_pair}" \
        --argjson controlDurationMs "${buildopt_control_ms}" \
        --argjson candidateDurationMs "${buildopt_candidate_ms}" \
        --argjson interArmIdleGapMs "${buildopt_gap_ms}" \
        --argjson outputFileCount "${buildopt_output_count}" \
        --argjson controlConfigurationCacheReused "${buildopt_control_cc}" \
        --argjson candidateConfigurationCacheReused "${buildopt_candidate_cc}" \
        --argjson candidateOmittedDeclaredTask "${buildopt_candidate_omitted}" \
        --argjson controlEntrypoints "${buildopt_original_entrypoints}" \
        --argjson candidateEntrypoints "${buildopt_candidate_entrypoints}" '{
            repositoryId: $repositoryId,
            scenarioId: $scenarioId,
            pair: $pair,
            order: $order,
            controlDurationMs: $controlDurationMs,
            candidateDurationMs: $candidateDurationMs,
            savedMs: ($controlDurationMs - $candidateDurationMs),
            interArmIdleGapMs: $interArmIdleGapMs,
            controlOutputSha256: $controlOutputSha256,
            candidateOutputSha256: $candidateOutputSha256,
            outputFileCount: $outputFileCount,
            controlSourceSha256: $controlSourceSha256,
            candidateSourceSha256: $candidateSourceSha256,
            controlConfigurationCacheReused: $controlConfigurationCacheReused,
            candidateConfigurationCacheReused: $candidateConfigurationCacheReused,
            candidateOmittedDeclaredTask: $candidateOmittedDeclaredTask,
            controlEntrypoints: $controlEntrypoints,
            candidateEntrypoints: $candidateEntrypoints,
            productAttributableFailure: false
        }' >>"${buildopt_raw}"
}

buildopt_raw="${buildopt_root}/observations.jsonl"
: >"${buildopt_raw}"

for buildopt_repository_index in 0 1 2; do
    buildopt_id=$(jq -er ".repositories[${buildopt_repository_index}].id" \
        "${buildopt_contract}")
    buildopt_name=$(jq -er ".repositories[${buildopt_repository_index}].nameWithOwner" \
        "${buildopt_contract}")
    buildopt_url=$(jq -er ".repositories[${buildopt_repository_index}].url" \
        "${buildopt_compatibility_contract}")
    buildopt_ref=$(jq -er ".repositories[${buildopt_repository_index}].ref" \
        "${buildopt_compatibility_contract}")
    buildopt_expected_revision=$(jq -er ".repositories[${buildopt_repository_index}].revision" \
        "${buildopt_contract}")
    buildopt_repository_root="${buildopt_root}/repositories/${buildopt_id}"
    buildopt_base="${buildopt_repository_root}/base"
    mkdir -p -- "${buildopt_repository_root}"

    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_TERMINAL_PROMPT=0 \
        git clone --quiet --depth 1 --branch "${buildopt_ref}" --single-branch \
        "${buildopt_url}" "${buildopt_base}"
    if [[ "$(git -C "${buildopt_base}" rev-parse HEAD)" != \
        "${buildopt_expected_revision}" ]]; then
        printf 'POC-REALWORLD-002 revision mismatch for %s\n' "${buildopt_name}" >&2
        exit 1
    fi
    buildopt_source_archive_sha=$(git -C "${buildopt_base}" archive --format=tar HEAD |
        sha256sum | awk '{print $1}')
    buildopt_compatibility_source_sha=$(jq -er \
        ".repositories[] | select(.id == \"${buildopt_id}\") | .sourceArchiveSha256" \
        "${buildopt_compatibility_evidence}")
    if [[ "${buildopt_source_archive_sha}" != "${buildopt_compatibility_source_sha}" ]]; then
        printf 'POC-REALWORLD-002 source archive drifted for %s\n' "${buildopt_name}" >&2
        exit 1
    fi

    buildopt_checksum_injection=$(jq -r \
        ".repositories[${buildopt_repository_index}].wrapper.checksumInjectionRequired" \
        "${buildopt_compatibility_contract}")
    if [[ "${buildopt_checksum_injection}" == true ]]; then
        buildopt_distribution_sha=$(jq -er \
            ".repositories[${buildopt_repository_index}].wrapper.distributionSha256" \
            "${buildopt_compatibility_contract}")
        printf '\ndistributionSha256Sum=%s\n' "${buildopt_distribution_sha}" \
            >>"${buildopt_base}/gradle/wrapper/gradle-wrapper.properties"
    fi

    for buildopt_scenario in NO_CHANGE LEAF_SOURCE_CHANGE; do
        buildopt_scenario_root="${buildopt_repository_root}/${buildopt_scenario}"
        buildopt_control_checkout="${buildopt_scenario_root}/control"
        buildopt_candidate_checkout="${buildopt_scenario_root}/candidate"
        mkdir -p -- "${buildopt_scenario_root}"
        cp -a -- "${buildopt_base}" "${buildopt_control_checkout}"
        cp -a -- "${buildopt_base}" "${buildopt_candidate_checkout}"

        buildopt_control_container=$(buildopt_container_name \
            "${buildopt_id}" "${buildopt_scenario}" CONTROL)
        buildopt_candidate_container=$(buildopt_container_name \
            "${buildopt_id}" "${buildopt_scenario}" CANDIDATE)
        buildopt_start_container "${buildopt_control_container}" \
            "${buildopt_control_checkout}" "${buildopt_scenario_root}/control-home" \
            "${buildopt_scenario_root}/control-gradle" \
            "${buildopt_scenario_root}/control-xdg"
        buildopt_start_container "${buildopt_candidate_container}" \
            "${buildopt_candidate_checkout}" "${buildopt_scenario_root}/candidate-home" \
            "${buildopt_scenario_root}/candidate-gradle" \
            "${buildopt_scenario_root}/candidate-xdg"

        buildopt_run_arm "${buildopt_repository_index}" "${buildopt_scenario}" \
            CONTROL "${buildopt_control_container}" \
            "${buildopt_scenario_root}/preflight-control.log" false
        buildopt_run_arm "${buildopt_repository_index}" "${buildopt_scenario}" \
            CANDIDATE "${buildopt_candidate_container}" \
            "${buildopt_scenario_root}/preflight-candidate.log" false
        docker network disconnect bridge "${buildopt_control_container}"
        docker network disconnect bridge "${buildopt_candidate_container}"
        buildopt_run_arm "${buildopt_repository_index}" "${buildopt_scenario}" \
            CONTROL "${buildopt_control_container}" \
            "${buildopt_scenario_root}/warm-control.log" true
        buildopt_run_arm "${buildopt_repository_index}" "${buildopt_scenario}" \
            CANDIDATE "${buildopt_candidate_container}" \
            "${buildopt_scenario_root}/warm-candidate.log" true

        buildopt_source_path=$(jq -er \
            ".repositories[${buildopt_repository_index}].sourceChange.path" \
            "${buildopt_contract}")
        buildopt_original_entrypoints=$(jq -c \
            ".repositories[${buildopt_repository_index}].originalEntrypoints" \
            "${buildopt_contract}")
        if [[ "${buildopt_scenario}" == LEAF_SOURCE_CHANGE ]]; then
            buildopt_candidate_entrypoints=$(jq -c \
                ".repositories[${buildopt_repository_index}].selectedEntrypoints" \
                "${buildopt_contract}")
        else
            buildopt_candidate_entrypoints=${buildopt_original_entrypoints}
        fi

        for buildopt_pair in {1..8}; do
            if [[ "${buildopt_scenario}" == LEAF_SOURCE_CHANGE ]]; then
                printf '\n// buildopt-poc-realworld-pair-%s\n' "${buildopt_pair}" \
                    >>"${buildopt_control_checkout}/${buildopt_source_path}"
                printf '\n// buildopt-poc-realworld-pair-%s\n' "${buildopt_pair}" \
                    >>"${buildopt_candidate_checkout}/${buildopt_source_path}"
            fi
            buildopt_control_source_sha=$(sha256sum \
                "${buildopt_control_checkout}/${buildopt_source_path}" | awk '{print $1}')
            buildopt_candidate_source_sha=$(sha256sum \
                "${buildopt_candidate_checkout}/${buildopt_source_path}" | awk '{print $1}')
            if [[ "${buildopt_control_source_sha}" != "${buildopt_candidate_source_sha}" ]]; then
                printf 'POC-REALWORLD-002 source mutation mismatch\n' >&2
                exit 1
            fi

            buildopt_order=CANDIDATE_FIRST
            if ((buildopt_pair <= 4 && buildopt_pair % 2 == 1)) ||
                ((buildopt_pair > 4 && buildopt_pair % 2 == 0)); then
                buildopt_order=CONTROL_FIRST
            fi
            buildopt_control_log="${buildopt_scenario_root}/pair-${buildopt_pair}-control.log"
            buildopt_candidate_log="${buildopt_scenario_root}/pair-${buildopt_pair}-candidate.log"

            if [[ "${buildopt_order}" == CONTROL_FIRST ]]; then
                buildopt_run_arm "${buildopt_repository_index}" "${buildopt_scenario}" \
                    CONTROL "${buildopt_control_container}" "${buildopt_control_log}" true
                buildopt_control_ms=${buildopt_duration_ms}
                buildopt_control_finished=${buildopt_finished_ns}
                buildopt_control_cc=${buildopt_configuration_cache_reused}
                buildopt_hash_outputs "${buildopt_control_checkout}" \
                    "${buildopt_repository_index}" "${buildopt_scenario}" \
                    "${buildopt_scenario_root}/pair-${buildopt_pair}-control.outputs"
                buildopt_run_arm "${buildopt_repository_index}" "${buildopt_scenario}" \
                    CANDIDATE "${buildopt_candidate_container}" "${buildopt_candidate_log}" true
                buildopt_candidate_ms=${buildopt_duration_ms}
                buildopt_gap_ms=$(((buildopt_started_ns - buildopt_control_finished) / 1000000))
                buildopt_candidate_cc=${buildopt_configuration_cache_reused}
                buildopt_candidate_omitted=${buildopt_omitted_declared_task}
                buildopt_hash_outputs "${buildopt_candidate_checkout}" \
                    "${buildopt_repository_index}" "${buildopt_scenario}" \
                    "${buildopt_scenario_root}/pair-${buildopt_pair}-candidate.outputs"
            else
                buildopt_run_arm "${buildopt_repository_index}" "${buildopt_scenario}" \
                    CANDIDATE "${buildopt_candidate_container}" "${buildopt_candidate_log}" true
                buildopt_candidate_ms=${buildopt_duration_ms}
                buildopt_candidate_finished=${buildopt_finished_ns}
                buildopt_candidate_cc=${buildopt_configuration_cache_reused}
                buildopt_candidate_omitted=${buildopt_omitted_declared_task}
                buildopt_hash_outputs "${buildopt_candidate_checkout}" \
                    "${buildopt_repository_index}" "${buildopt_scenario}" \
                    "${buildopt_scenario_root}/pair-${buildopt_pair}-candidate.outputs"
                buildopt_run_arm "${buildopt_repository_index}" "${buildopt_scenario}" \
                    CONTROL "${buildopt_control_container}" "${buildopt_control_log}" true
                buildopt_control_ms=${buildopt_duration_ms}
                buildopt_gap_ms=$(((buildopt_started_ns - buildopt_candidate_finished) / 1000000))
                buildopt_control_cc=${buildopt_configuration_cache_reused}
                buildopt_hash_outputs "${buildopt_control_checkout}" \
                    "${buildopt_repository_index}" "${buildopt_scenario}" \
                    "${buildopt_scenario_root}/pair-${buildopt_pair}-control.outputs"
            fi

            buildopt_control_manifest="${buildopt_scenario_root}/pair-${buildopt_pair}-control.outputs"
            buildopt_candidate_manifest="${buildopt_scenario_root}/pair-${buildopt_pair}-candidate.outputs"
            buildopt_control_output_sha=$(sha256sum "${buildopt_control_manifest}" | awk '{print $1}')
            buildopt_candidate_output_sha=$(sha256sum "${buildopt_candidate_manifest}" | awk '{print $1}')
            buildopt_output_count=$(wc -l <"${buildopt_control_manifest}")
            if [[ "${buildopt_control_output_sha}" != "${buildopt_candidate_output_sha}" ||
                "${buildopt_output_count}" -ne "$(wc -l <"${buildopt_candidate_manifest}")" ]]; then
                diff -u "${buildopt_control_manifest}" "${buildopt_candidate_manifest}" >&2 || true
                printf 'POC-REALWORLD-002 output mismatch for %s/%s\n' \
                    "${buildopt_name}" "${buildopt_scenario}" >&2
                exit 1
            fi
            if ((buildopt_gap_ms < 0 || buildopt_gap_ms > 5000)); then
                printf 'POC-REALWORLD-002 inter-arm gap exceeded the preregistered bound\n' >&2
                exit 1
            fi
            if [[ "${buildopt_scenario}" == NO_CHANGE ]]; then
                buildopt_candidate_omitted=false
            fi
            buildopt_record_observation "${buildopt_id}" "${buildopt_scenario}" \
                "${buildopt_pair}" "${buildopt_order}" "${buildopt_control_ms}" \
                "${buildopt_candidate_ms}" "${buildopt_gap_ms}" \
                "${buildopt_control_output_sha}" "${buildopt_candidate_output_sha}" \
                "${buildopt_output_count}" "${buildopt_control_source_sha}" \
                "${buildopt_candidate_source_sha}" "${buildopt_control_cc}" \
                "${buildopt_candidate_cc}" "${buildopt_candidate_omitted}" \
                "${buildopt_original_entrypoints}" "${buildopt_candidate_entrypoints}" \
                "${buildopt_raw}"
            printf 'POC-REALWORLD-002 %s/%s pair %d saved %dms\n' \
                "${buildopt_name}" "${buildopt_scenario}" "${buildopt_pair}" \
                "$((buildopt_control_ms - buildopt_candidate_ms))"
        done

        docker rm -f "${buildopt_control_container}" \
            "${buildopt_candidate_container}" >/dev/null
    done
done

jq -s \
    --arg capturedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg specSha256 "${buildopt_spec_sha}" \
    --arg buildoptRevision "${buildopt_revision}" \
    --arg executableSha256 "${buildopt_executable_sha}" \
    --arg gradlePluginSha256 "${buildopt_plugin_sha}" \
    --arg image "${buildopt_image}" \
    --arg platformDigest "${buildopt_platform_digest}" \
    --arg runnerSpecSha256 "${buildopt_runner_spec_sha}" \
    --argjson cpuCount "${buildopt_cpu}" \
    --argjson memoryBytes "${buildopt_memory}" \
    --slurpfile spec "${buildopt_contract}" '
    def bootstrap_mean($rows; $sample):
        reduce range(0; 8) as $draw
            ({state: ((2654435761 * ($sample + 1)) % 4294967296), sum: 0};
             .state = ((1664525 * .state + 1013904223) % 4294967296) |
             .sum += $rows[((.state / 536870912) | floor)].savedMs) |
        .sum / 8;
    def bootstrap95($rows):
        ([range(0; 4096) as $sample | bootstrap_mean($rows; $sample)] | sort) as $replicates |
        [$replicates[102], $replicates[3993]];
    group_by(.repositoryId) |
    map(. as $repositoryRows |
        ($spec[0].repositories[] | select(.id == $repositoryRows[0].repositoryId)) as $repositorySpec |
        ($repositoryRows | group_by(.scenarioId) |
         map(. as $rows |
            ($spec[0].scenarios[] | select(.id == $rows[0].scenarioId)) as $scenarioSpec |
            (($rows | map(.savedMs) | add) / 8) as $meanSaved |
            (($rows | map(.savedMs) | add) / ($rows | map(.controlDurationMs) | add)) as $ratio |
            bootstrap95($rows) as $interval |
            (all($rows[]; .controlOutputSha256 == .candidateOutputSha256 and
                          .productAttributableFailure == false)) as $sameOutputs |
            (if $scenarioSpec.successClass == "PARITY" then
                ($ratio >= -$scenarioSpec.maximumRegressionRatio and $sameOutputs)
             else
                ($meanSaved >= $scenarioSpec.minimumSavedMs and
                 $ratio >= $scenarioSpec.minimumReductionRatio and
                 $interval[0] > 0 and $sameOutputs and
                 all($rows[]; .candidateOmittedDeclaredTask))
             end) as $qualified |
            {
                id: $rows[0].scenarioId,
                changeClass: $scenarioSpec.changeClass,
                successClass: $scenarioSpec.successClass,
                classification:
                    (if $qualified then
                        (if $scenarioSpec.successClass == "PARITY" then "PARITY" else "THRESHOLD_MET" end)
                     else "NO_VALUE_NO_ACTION" end),
                result: {
                    pairs: 8,
                    controlMeanMs: (($rows | map(.controlDurationMs) | add) / 8),
                    candidateMeanMs: (($rows | map(.candidateDurationMs) | add) / 8),
                    meanSavedMs: $meanSaved,
                    meanReductionRatio: $ratio,
                    interval95SavedMs: $interval,
                    positivePairs: ($rows | map(select(.savedMs > 0)) | length),
                    requiredOutputsIdentical: $sameOutputs,
                    productAttributableFailures: ($rows | map(select(.productAttributableFailure)) | length),
                    observations: $rows
                }
            })) as $scenarios |
        {
            id: $repositorySpec.id,
            nameWithOwner: $repositorySpec.nameWithOwner,
            revision: $repositorySpec.revision,
            dsl: $repositorySpec.dsl,
            scenarios: $scenarios,
            classification:
                (if all($scenarios[]; .classification == "PARITY" or .classification == "THRESHOLD_MET")
                 then "QUALIFIED" else "RETAIN_BOUNDED_CLAIM" end)
        }) as $repositories |
    ($repositories | map(select(.classification == "QUALIFIED")) | length) as $qualifiedRepositories |
    {
        schemaVersion: "buildopt.evidence/poc-real-world-performance/v1",
        capturedAt: $capturedAt,
        specSha256: $specSha256,
        buildopt: {
            revision: $buildoptRevision,
            executableSha256: $executableSha256,
            gradlePluginSha256: $gradlePluginSha256
        },
        runner: {
            id: "linux-amd64-4c-16g-v1",
            image: $image,
            platformDigest: $platformDigest,
            runnerSpecSha256: $runnerSpecSha256,
            cpuCount: $cpuCount,
            memoryBytes: $memoryBytes
        },
        methodology: $spec[0].measurement + {
            batches: $spec[0].batches,
            nativeControl: $spec[0].nativeControl,
            candidate: $spec[0].candidate,
            scenarios: $spec[0].scenarios
        },
        repositories: $repositories,
        decision: {
            verdict:
                (if $qualifiedRepositories == 3
                 then "BROADEN_CLAIM_TO_QUALIFIED_PUBLIC_REPOSITORIES"
                 else "RETAIN_BOUNDED_SYNTHETIC_CLAIM" end),
            qualifyingRepositories: $qualifiedRepositories,
            requiredRepositories: 3,
            performanceMeasured: true
        },
        gate: {id: "POC-REALWORLD-G02", state: "PASSED"},
        boundaries: $spec[0].boundaries
    }
    ' "${buildopt_raw}" >"${buildopt_root}/poc-real-world-performance.json"

install -m 0600 "${buildopt_root}/poc-real-world-performance.json" \
    "${buildopt_output}"
"${buildopt_script_dir}/check-poc-real-world-performance" "${buildopt_output}"
printf 'BuildOpt POC-REALWORLD-002 strict evidence written to %s\n' \
    "${buildopt_output}"
