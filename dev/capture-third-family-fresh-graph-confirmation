#!/usr/bin/env bash
set -euo pipefail
if (($# != 1)) || [[ $1 != /* || -e $1 ]]; then
    printf 'usage: %s NEW_ABSOLUTE_OUTPUT_DIRECTORY\n' "$0" >&2
    exit 64
fi
buildopt_output=$1
buildopt_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
buildopt_subjects="${buildopt_root}/specs/poc-third-family-fresh-graph-confirmation-v1.subjects.json"
buildopt_subjects_sha=$(sha256sum "${buildopt_subjects}" | awk '{print $1}')
buildopt_free=$(df --output=avail -B1 /tmp | tail -n 1 | tr -d ' ')
((buildopt_free >= 8589934592)) || { printf 'less than 8 GiB free\n' >&2; exit 1; }
env BUILDOPT_AUTOMATIC_BREADTH_PROTOCOL=v3 \
    BUILDOPT_AUTOMATIC_BREADTH_SUBJECTS_FILE="${buildopt_subjects}" \
    BUILDOPT_AUTOMATIC_BREADTH_SUBJECTS_SHA256="${buildopt_subjects_sha}" \
    BUILDOPT_AUTOMATIC_BREADTH_INVOCATIONS=1 \
    BUILDOPT_AUTOMATIC_BREADTH_PROCESS_MODE=no-daemon \
    "${buildopt_root}/dev/run-automatic-breadth-transfer" "${buildopt_output}" spring-framework-docs-recurrent

