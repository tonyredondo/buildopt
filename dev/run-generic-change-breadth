#!/usr/bin/env bash
set -euo pipefail

if (($# < 1 || $# > 3)) || [[ $1 != /* ]]; then
    printf 'usage: %s /absolute/evidence/root [cell-key] [capture-index]\n' "$0" >&2
    exit 64
fi

buildopt_evidence_root=$1
buildopt_filter=${2:-}
buildopt_capture_filter=${3:-}
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_spec="${buildopt_repo_root}/specs/poc-generic-change-breadth-v1.json"

if [[ -n ${buildopt_capture_filter} && ${buildopt_capture_filter} != 1 && \
    ${buildopt_capture_filter} != 2 ]]; then
    printf 'capture index must be 1 or 2\n' >&2
    exit 64
fi
if [[ -n ${buildopt_filter} && \
    $(jq --arg key "${buildopt_filter}" '[.repositories[] | select(.key == $key)] | length' "${buildopt_spec}") -ne 1 ]]; then
    printf 'cell key is absent or ambiguous: %s\n' "${buildopt_filter}" >&2
    exit 64
fi
[[ -z $(git -C "${buildopt_repo_root}" status --porcelain --untracked-files=no) ]] || {
    printf 'BuildOpt tracked state must be clean before change-breadth capture\n' >&2
    exit 1
}

mkdir -p -- "${buildopt_evidence_root}"
buildopt_temporary=
buildopt_cleanup() {
    if [[ ${buildopt_temporary:-} == "${TMPDIR:-/tmp}/buildopt-change-breadth-capture."* ]]; then
        rm -rf -- "${buildopt_temporary}"
    fi
}
trap buildopt_cleanup EXIT

mapfile -t buildopt_keys < <(jq -r '.repositories[].key' "${buildopt_spec}")
for buildopt_key in "${buildopt_keys[@]}"; do
    [[ -z ${buildopt_filter} || ${buildopt_key} == "${buildopt_filter}" ]] || continue
    for buildopt_capture in 1 2; do
        [[ -z ${buildopt_capture_filter} || ${buildopt_capture} == "${buildopt_capture_filter}" ]] || continue
        buildopt_destination="${buildopt_evidence_root}/${buildopt_key}/capture-${buildopt_capture}"
        if [[ -s ${buildopt_destination}/result.json ]]; then
            printf 'Change-breadth capture already exists; preserving %s\n' "${buildopt_destination}"
            continue
        fi
        [[ ! -e ${buildopt_destination} ]] || {
            printf 'incomplete capture destination already exists: %s\n' "${buildopt_destination}" >&2
            exit 1
        }
        buildopt_temporary=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-change-breadth-capture.XXXXXX")
        printf 'Capturing %s run %d/2\n' "${buildopt_key}" "${buildopt_capture}"
        "${buildopt_script_dir}/run-generic-profile-matrix" \
            "${buildopt_temporary}" "${buildopt_spec}" "${buildopt_key}"
        mkdir -p -- "${buildopt_evidence_root}/${buildopt_key}"
        mv -- "${buildopt_temporary}/${buildopt_key}" "${buildopt_destination}"
        rmdir -- "${buildopt_temporary}"
        buildopt_temporary=
    done
done

buildopt_complete=true
for buildopt_key in "${buildopt_keys[@]}"; do
    for buildopt_capture in 1 2; do
        [[ -s ${buildopt_evidence_root}/${buildopt_key}/capture-${buildopt_capture}/result.json ]] || \
            buildopt_complete=false
    done
done
if [[ ${buildopt_complete} == false ]]; then
    printf 'Change-breadth evidence is partial; resume remaining captures.\n'
    exit 0
fi

"${buildopt_script_dir}/assemble-generic-change-breadth" \
    "${buildopt_evidence_root}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
"${buildopt_script_dir}/check-generic-change-breadth-result" "${buildopt_evidence_root}"
