#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [RESULT_FILE]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(CDPATH='' cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_result=${1:-${buildopt_repo_root}/benchmarks/results/poc-functional-coverage-decision-v1/summary.json}
buildopt_contract=${buildopt_repo_root}/specs/poc-functional-coverage-decision-v1.json
buildopt_temporary=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-functional-coverage-decision.XXXXXX")
trap 'rm -rf -- "${buildopt_temporary}"' EXIT

for buildopt_command in awk cmp jq mktemp sha256sum; do
    command -v "${buildopt_command}" >/dev/null || {
        printf 'required functional-coverage checker command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done

"${buildopt_script_dir}/check-lifetime-breadth-v3" check \
    "${buildopt_repo_root}/specs/poc-lifetime-breadth-v3.json" \
    "${buildopt_repo_root}/benchmarks/results/poc-lifetime-breadth-v3" >/dev/null
"${buildopt_script_dir}/compose-functional-coverage-decision" \
    "${buildopt_temporary}/summary.json"
cmp -s "${buildopt_result}" "${buildopt_temporary}/summary.json" || {
    printf 'functional-coverage decision does not match recomputed V3 evidence\n' >&2
    exit 1
}

jq -e \
    --arg contractSha "$(sha256sum "${buildopt_contract}" | awk '{print $1}')" '
  .schemaVersion == "buildopt.evidence/poc-functional-coverage-decision/v1" and
  .workItem == "POC-FUNCTIONAL-COVERAGE-DECISION-001" and
  .evidenceState == "TERMINAL" and .decidedOn == "2026-08-25" and
  .source.contractSha256 == $contractSha and
  .source.executableSha256 == "a8f8af24fecf4d0a190c38ed47f354c8a1accdc622a5b3b51689d744a730b576" and
  .source.lifetimeDecision == "FUNCTIONAL_COVERAGE_NOT_PROVEN" and
  (.criteria | length) == 8 and
  ([.criteria[] | select(.passed) | .id]) == [
    "FROZEN_MATRIX_COMPLETE",
    "EXACT_OUTPUTS_AND_ZERO_FAILURES",
    "GENERIC_SELECTION_RULES",
    "ROBUST_TARGET_QUALIFICATION",
    "BOUNDED_PAYBACK"
  ] and
  .failedCriteria == [
    "REPOSITORY_FAMILY_BREADTH",
    "ELIGIBLE_DESCENDANT_SELECTION",
    "EARLY_NATIVE_RETENTION_OVERHEAD"
  ] and
  (.criteria[] | select(.id == "REPOSITORY_FAMILY_BREADTH") |
    .observed.netPositiveRepositoryFamilies == 1 and
    .required.minimumNetPositiveRepositoryFamilies == 3 and .passed == false) and
  (.criteria[] | select(.id == "ELIGIBLE_DESCENDANT_SELECTION") |
    .observed.selectedReplays == 1 and .observed.eligibleDescendants == 6 and
    .observed.selectionRatio == (1 / 6) and
    .required.minimumSelectionRatio == 0.5 and .passed == false) and
  (.criteria[] | select(.id == "EARLY_NATIVE_RETENTION_OVERHEAD") |
    .observed == {sampleCount:1, medianMs:4098, p95Ms:4098, samplesMs:[4098]} and
    .required == {maximumMedianMs:500, maximumP95Ms:1000} and .passed == false) and
  .decision == "STOP_GENERIC_POC" and
  .effect == {
    genericClaimAuthorized:false,
    productionHardeningAuthorized:false,
    thresholdsChanged:false,
    repositorySpecificRulesAuthorized:false,
    boundedMechanismEvidenceRetained:true,
    nextGenericImplementationBlock:null
  } and
  .boundaries == {
    proofOfConcept:true,
    productionAuthorized:false,
    thresholdChangesAuthorized:false,
    repositorySpecificRulesAuthorized:false,
    soakRequired:false,
    designPartnerRequired:false,
    testOptimization:"OUT_OF_SCOPE"
  }
' "${buildopt_result}" >/dev/null

jq '.decision = "CONTINUE_GENERIC_POC"' "${buildopt_result}" \
    >"${buildopt_temporary}/false-continue.json"
if "${BASH_SOURCE[0]}" "${buildopt_temporary}/false-continue.json" \
    >/dev/null 2>&1; then
    printf 'false continue decision unexpectedly passed verification\n' >&2
    exit 1
fi

jq '.criteria.minimumNetPositiveRepositoryFamilies = 1' "${buildopt_contract}" \
    >"${buildopt_temporary}/moved-threshold.json"
if cmp -s "${buildopt_temporary}/moved-threshold.json" "${buildopt_contract}"; then
    printf 'threshold-drift fixture did not change the contract\n' >&2
    exit 1
fi

printf 'Functional coverage decision OK: STOP_GENERIC_POC (3/8 criteria failed)\n'
