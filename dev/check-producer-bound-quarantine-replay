#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [EVIDENCE_ROOT]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_evidence_root=${1:-"${buildopt_repo_root}/benchmarks/results/poc-producer-bound-quarantine-replay-v1"}
buildopt_summary=${buildopt_evidence_root}/summary.json
buildopt_quarantine=${buildopt_evidence_root}/quarantine-result.json
buildopt_calibration=${buildopt_evidence_root}/calibration-evidence.json
buildopt_output_contract=${buildopt_evidence_root}/output-contract.json
buildopt_result=${buildopt_evidence_root}/result.json
buildopt_contract=${buildopt_repo_root}/specs/poc-producer-bound-quarantine-replay-v1.json

for buildopt_command in git jq sha256sum; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'producer-bound quarantine replay validation requires %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done

for buildopt_file in \
    "${buildopt_contract}" \
    "${buildopt_evidence_root}/README.md" \
    "${buildopt_summary}" \
    "${buildopt_quarantine}" \
    "${buildopt_calibration}" \
    "${buildopt_output_contract}" \
    "${buildopt_result}"; do
    [[ -s ${buildopt_file} ]] || {
        printf 'producer-bound quarantine replay file is unavailable: %s\n' \
            "${buildopt_file}" >&2
        exit 1
    }
done

buildopt_before=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)

buildopt_quarantine_sha=$(sha256sum "${buildopt_quarantine}" | awk '{print $1}')
buildopt_calibration_sha=$(sha256sum "${buildopt_calibration}" | awk '{print $1}')
[[ ${buildopt_quarantine_sha} == "$(jq -r '.subject.nativeVolatility.resultSha256' "${buildopt_summary}")" ]] || {
    printf 'producer-bound quarantine result digest drifted\n' >&2
    exit 1
}
[[ ${buildopt_calibration_sha} == "$(jq -r '.subject.calibration.evidenceSha256' "${buildopt_summary}")" ]] || {
    printf 'producer-bound calibration evidence digest drifted\n' >&2
    exit 1
}

jq -e '
  .schemaVersion == "buildopt.evidence/poc-producer-bound-quarantine-replay/v1" and
  .workItem == "POC-PRODUCER-BOUND-QUARANTINE-REPLAY-001" and
  .buildopt.revision == "d00a5f491bf4b64891edf2d35c20a9b500e2b718" and
  .subject.repositoryId == "spring-projects/spring-framework" and
  .subject.baseRevision == "d8216d719bb203a1ed74e5f75c894b08db6f1a88" and
  .subject.targetRevision == "dbbbf37ac9097852194222a0405d3e060a846b8e" and
  .subject.ordinaryInvocations == 18 and
  .subject.processExitCode == 0 and (.subject.productFailure | not) and
  .subject.nativeVolatility.comparedOutputCount == 8216 and
  (.subject.nativeVolatility.volatilePaths | length) == 14 and
  .subject.nativeVolatility.quarantinedProducers == [
    ":spring-aspects:compileAspectj", ":spring-messaging:compileJava"] and
  .subject.nativeVolatility.quarantinedOutputCount == 352 and
  .subject.nativeVolatility.transportedOutputCount == 7864 and
  .subject.nativeVolatility.decision == "TRANSPORT_READY" and
  .subject.discovery.candidateEntrypoints == [
    ":spring-aspects:compileAspectj", ":spring-jms:classes",
    ":spring-messaging:compileJava"] and
  .subject.calibration.pairsMeasured == 8 and
  .subject.calibration.positivePairs == 7 and
  .subject.calibration.controlMeanMs == 8643.875 and
  .subject.calibration.candidateMeanMs == 7029.375 and
  .subject.calibration.meanSavedMs == 1614.5 and
  .subject.calibration.reductionRatio == 0.18677965611487904 and
  .subject.calibration.interval95SavedMs == [549.375,2702.25] and
  .subject.calibration.breakEvenBuilds == 1 and
  .subject.calibration.qualified and .subject.calibration.valueGatePassed and
  .subject.portfolio.reason == "QUALIFIED_PROFILE_STORED" and
  .aggregation == {
    subjectCount:1,resultAvailable:1,discoveryComplete:1,quarantineApplied:1,
    incrementalComplete:1,calibrationComplete:1,valueGatePassed:1,
    economicallyQualified:1,ordinaryInvocations:18,exactStableOutputPairs:16,
    productFailures:0,repositoryPercentagesAveraged:false,
    mechanismPercentagesAdded:false} and
  .decision == "QUARANTINED_PROFILE_QUALIFIED" and
  .boundaries == {
    proofOfConcept:true,productionAuthorized:false,
    repositorySpecificProductRules:false,
    automaticActivationOutsideOwnerCommand:false,soakRequired:false,
    designPartnerRequired:false,testOptimization:"OUT_OF_SCOPE"}
' "${buildopt_summary}" >/dev/null

jq -e '
  .schemaVersion == "buildopt.poc/native-volatility-quarantine/v1" and
  .decision == "TRANSPORT_READY" and
  .reason == "VOLATILE_PRODUCERS_QUARANTINED" and
  .comparedOutputCount == 8216 and
  (.volatilePaths | length) == 14 and
  .quarantinedProducers == [
    ":spring-aspects:compileAspectj", ":spring-messaging:compileJava"] and
  (.quarantinedOutputs | length) == 352 and
  (.transportedOutputs | length) == 7864 and
  ((.quarantinedOutputs + .transportedOutputs) | length) == .comparedOutputCount and
  ([.quarantinedOutputs[] | select(
    (.producerTasks | any(. == ":spring-aspects:compileAspectj" or
      . == ":spring-messaging:compileJava")) | not)] | length) == 0 and
  ([.transportedOutputs[] | select(
    .producerTasks | any(. == ":spring-aspects:compileAspectj" or
      . == ":spring-messaging:compileJava"))] | length) == 0 and
  (.transportSha256 | test("^[0-9a-f]{64}$")) and
  (.firstObservationSha256 | test("^[0-9a-f]{64}$")) and
  (.secondObservationSha256 | test("^[0-9a-f]{64}$")) and
  .productionAuthorized == false and .testOptimization == "OUT_OF_SCOPE"
' "${buildopt_quarantine}" >/dev/null

jq -e '
  .result.pairs == 8 and .result.positivePairs == 7 and
  .result.controlMeanMs == 8643.875 and .result.candidateMeanMs == 7029.375 and
  .result.meanSavedMs == 1614.5 and
  .result.interval95SavedMs == [549.375,2702.25] and
  .result.qualified and .result.decision == "QUALIFY_STRUCTURAL_PROFILE" and
  ([.observations[] | select(
    .requiredOutputCount == 8033 and
    .controlRequiredOutputSha256 == .candidateRequiredOutputSha256 and
    (.productAttributableFailure | not))] | length) == 8 and
  .fallback.buildSuccessful
' "${buildopt_calibration}" >/dev/null

jq -e '
  .schemaVersion == "buildopt.poc/output-contract/v1" and
  .decision == "VALIDATED_REQUIRED_OUTPUTS" and
  .reason == "DECLARED_OUTPUTS_MATCH_EXECUTED_WORKFLOW" and
  (.candidateOutputs | length) == 104 and
  ([.candidateOutputs[] | select(
    .pattern == "spring-aspects/build/classes/aspectj/main/**" and
    .producerTasks == [":spring-aspects:compileAspectj"])] | length) == 1 and
  ([.candidateOutputs[] | select(
    .pattern == "spring-messaging/build/classes/java/main/**" and
    .producerTasks == [":spring-messaging:compileJava"])] | length) == 1 and
  ([.validations[] | select(.status != "VALIDATED")] | length) == 0 and
  .productionAuthorized == false and .testOptimization == "OUT_OF_SCOPE"
' "${buildopt_output_contract}" >/dev/null

jq -e '
  [.subject.incrementalLearning.observations[] | .requiredOutputSha256] as $hashes |
  ($hashes | length) == 16 and ($hashes | unique | length) == 1 and
  ([.subject.incrementalLearning.observations[] | select(.arm == "CONTROL")] | length) == 8 and
  ([.subject.incrementalLearning.observations[] | select(.arm == "CANDIDATE")] | length) == 8 and
  ([range(1;9) as $pair |
    ([.subject.incrementalLearning.observations[] |
      select(.pair == $pair and .arm == "CONTROL") | .durationMs][0]) -
    ([.subject.incrementalLearning.observations[] |
      select(.pair == $pair and .arm == "CANDIDATE") | .durationMs][0]) |
    select(. > 0)] | length) == 7
' "${buildopt_summary}" >/dev/null

buildopt_grep_status=0
git -C "${buildopt_repo_root}" grep -ilE \
    'spring|aspectj|messaging|kafka|opentelemetry|micronaut|groovy' -- \
    internal/nativevolatility internal/launcher/optimize_quarantine.go \
    ':(exclude)**/*_test.go' \
    >"${TMPDIR:-/tmp}/buildopt-producer-quarantine-subject-files.$$" || \
    buildopt_grep_status=$?
trap 'rm -f -- "${TMPDIR:-/tmp}/buildopt-producer-quarantine-subject-files.$$"' EXIT
if ((buildopt_grep_status > 1)); then
    printf 'producer-bound quarantine source scan failed\n' >&2
    exit 1
fi
if [[ -s ${TMPDIR:-/tmp}/buildopt-producer-quarantine-subject-files.$$ ]]; then
    printf 'producer-bound quarantine implementation contains subject-specific rules\n' >&2
    exit 1
fi

buildopt_after=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
[[ ${buildopt_before} == "${buildopt_after}" ]] || {
    printf 'producer-bound quarantine validation changed the working tree\n' >&2
    exit 1
}

printf 'Producer-bound quarantine replay OK: Spring 8216 outputs, 352 rebuilt locally, 7864 transported exactly, 18.68%% saved with 7/8\n'
