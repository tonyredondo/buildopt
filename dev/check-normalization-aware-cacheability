#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

jq -e '
  .schemaVersion == "buildopt.specs/poc-normalization-aware-cacheability/v2" and
  .workItem == "NAC" and
  .objective == "PROVE_PORTABLE_CACHEABILITY_CORRECTIONS_WITH_EXPLICIT_NORMALIZATION" and
  .baseline == "OPTIMIZED_NATIVE_GRADLE" and
  .predecessor == {
    workItem: "DNO",
    terminal: "STOP_DURABLE_NATIVE_OPTIMIZATION_POC",
    mayMotivate: true,
    maySupplyEvidenceRows: false
  } and
  .cohort == {
    completeFamilies: 5,
    reuseExactSourceRevisionsToIsolateDetectorChange: true,
    freshV2EvidenceRequired: true
  } and
  .sourceClassification == {
    block: "NAC-002",
    evidence: "benchmarks/results/normalization-aware-cacheability-v2/source-classification.json",
    conclusiveFamilies: 5,
    actionFamilies: 4,
    markerOnlyCandidates: 8,
    reviewedRelativeProofCandidates: 1,
    decision: "PASS_SOURCE_ACTION_BREADTH",
    timingAuthorized: false
  } and
  .normalization.portablePrimaryStrategies == [
    "PATH_SENSITIVE_RELATIVE",
    "PATH_SENSITIVE_NAME_ONLY",
    "PATH_SENSITIVE_NONE",
    "CLASSPATH",
    "COMPILE_CLASSPATH"
  ] and
  .normalization.explicitButRejectedStrategies == ["PATH_SENSITIVE_ABSOLUTE"] and
  .normalization.inferredStrategiesAllowed == false and
  (.actions | map(.id)) == [
    "ADD_CACHEABLE_TASK_MARKER_V2",
    "ADD_RELATIVE_PATH_NORMALIZATION_AND_CACHEABLE_MARKER_V1"
  ] and
  .actions[1].eligibleInputAnnotations == [
    "INPUT_FILE",
    "INPUT_FILES",
    "INPUT_DIRECTORY",
    "INPUT_DIRECTORIES"
  ] and
  (.actions | all(.ownerReviewRequired == true)) and
  .gates.breadth == {
    completeFamilies: 5,
    minimumActionFamilies: 3,
    repositoryOrTaskNameRulesAllowed: false,
    timingAllowedBeforePass: false
  } and
  .gates.correctness.productFailureBudget == 0 and
  .gates.correctness.contentMutationRequired == true and
  .gates.correctness.relativePathMutationRequired == true and
  .gates.correctness.crossRootRestoreRequired == true and
  .gates.pairedValue.pairsPerFamily == 8 and
  .gates.pairedValue.minimumPositiveFamilies == 3 and
  .gates.longitudinalValue.minimumCommitsPerFamily == 20 and
  .gates.longitudinalValue.minimumPositiveFamilies == 3 and
  .measurement.hostedCiOwnsWallTimeGate == false and
  .boundaries.proofOfConcept == true and
  .boundaries.automaticMergeAuthorized == false and
  .boundaries.soakRequired == false and
  .boundaries.designPartnerRequired == false and
  .boundaries.testOptimization == "OUT_OF_SCOPE"
' specs/poc-normalization-aware-cacheability-v2.json >/dev/null

jq -e '
  .schemaVersion == "buildopt.specs/poc-normalization-aware-cacheability-subjects/v2" and
  .reusePolicy == "SOURCE_REVISIONS_ONLY_NO_DNO_EVIDENCE_ROWS" and
  (.families | length) == 5 and
  ([.families[].key] | unique | length) == 5 and
  ([.families[].repository] | unique | length) == 5 and
  ([.families[].revision] | unique | length) == 5 and
  all(.families[]; (.revision | test("^[0-9a-f]{40}$")))
' specs/poc-normalization-aware-cacheability-v2.subjects.json >/dev/null

grep -Fq '**Status:** closed — ' \
    docs/plans/normalization-aware-cacheability-poc-tracker.md
grep -Fq '**Current block:** none; all seven blocks are resolved' \
    docs/plans/normalization-aware-cacheability-poc-tracker.md
grep -Eq "\`NAC-001\`.*\`DONE\`" docs/plans/normalization-aware-cacheability-poc-tracker.md
grep -Eq "\`NAC-002\`.*\`DONE\`" docs/plans/normalization-aware-cacheability-poc-tracker.md
grep -Eq "\`NAC-003\`.*\`DONE\`" docs/plans/normalization-aware-cacheability-poc-tracker.md
grep -Eq "\`NAC-004\`.*\`STOPPED\`" docs/plans/normalization-aware-cacheability-poc-tracker.md
grep -Eq "\`NAC-005\`.*\`NOT_AUTHORIZED\`" docs/plans/normalization-aware-cacheability-poc-tracker.md
grep -Eq "\`NAC-006\`.*\`NOT_AUTHORIZED\`" docs/plans/normalization-aware-cacheability-poc-tracker.md
grep -Eq "\`NAC-007\`.*\`DONE\`" docs/plans/normalization-aware-cacheability-poc-tracker.md
grep -Fq 'DNO v1 remains closed and supplies no v2 evidence row or timing sample.' \
    docs/plans/normalization-aware-cacheability-poc-tracker.md
grep -Fq "\`PathSensitivity.ABSOLUTE\` is explicit but not portable and is rejected." \
    specs/poc-normalization-aware-cacheability-v2.md
grep -Fq "Status: closed with terminal \`STOP_DURABLE_NATIVE_OPTIMIZATION_POC\`." \
    specs/poc-durable-native-optimization-v1.md

jq -e '
  .schemaVersion == "buildopt.evidence/normalization-aware-cacheability-terminal/v2" and
  .decision == "STOP_NORMALIZATION_AWARE_CACHEABILITY_POC" and
  .failedPrerequisite == "NAC-004" and
  .scorecard["NAC-005"] == "NOT_AUTHORIZED" and
  .scorecard["NAC-006"] == "NOT_AUTHORIZED" and
  .measuredWallTime == false and
  .successorAuthorized == false
' benchmarks/results/normalization-aware-cacheability-v2/terminal-decision.json >/dev/null

printf 'NAC contract OK: terminal stop preserves incomplete correctness and unauthorized timing\n'
