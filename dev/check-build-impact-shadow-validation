#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_contract="${buildopt_repo_root}/specs/build-impact-shadow-validation-v1.json"

for buildopt_command in go jq; do
    if ! command -v "${buildopt_command}" >/dev/null 2>&1; then
        printf 'required shadow-validation command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    fi
done

jq -e '
    .schemaVersion == "buildopt.specs/build-impact-shadow-validation/v1" and
    .workItem == "C3-003" and
    .observation.schemaVersion == "buildopt.build-impact/validation-observation/v1" and
    .observation.modes == ["SHADOW", "PAIRED_CONTROL"] and
    .outcomes.shadow == "SHADOW_VALIDATED" and
    .outcomes.pairedControl == "CONTROL_PASSED" and
    .outcomes.candidateBuildOrDivergence == "FALSE_NEGATIVE" and
    .outcomes.infrastructureOrInvalidBaseline == "INCONCLUSIVE" and
    .comparison.testOptimization == "PRESERVED_AND_COMPARED_NOT_SELECTED" and
    .comparison.history == "NEVER_AUTHORIZES_OMISSION" and
    .result.schemaVersion == "buildopt.build-impact/validation-result/v1" and
    .result.selectionAuthorized == false and
    .boundaries.closes == ["C3-003"] and
    (.boundaries.doesNotClose | index("BIA-002")) != null
' "${buildopt_contract}" >/dev/null

"${buildopt_script_dir}/check-build-impact-declared-graph"
cd "${buildopt_repo_root}"
go test -race -count=1 ./internal/buildimpact
go vet ./internal/buildimpact
printf 'C3-003 shadow validation checks passed: full baseline, exact control, explicit false negatives\n'
