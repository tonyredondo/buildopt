#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [RESULT_JSON]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_result=${1:-"${buildopt_repo_root}/benchmarks/results/poc-value-baseline-v1.json"}
buildopt_spec="${buildopt_repo_root}/specs/golden-lane-runner-v1.json"

for buildopt_command in git jq sha256sum; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required POC value baseline command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
if [[ ! -f "${buildopt_result}" ]]; then
    printf 'POC value baseline result is unavailable: %s\n' "${buildopt_result}" >&2
    exit 1
fi

buildopt_before_status=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_platform_digest=$(jq -er '.container.platformDigest' "${buildopt_spec}")

jq -e \
    --arg specSha256 "${buildopt_spec_sha}" \
    --arg platformDigest "${buildopt_platform_digest}" '
    def digest: type == "string" and test("^[0-9a-f]{64}$");
    def revision: type == "string" and test("^[0-9a-f]{40}$");
    def exact_bootstrap95($rows):
        ([range(0; 256) as $sample |
          ([1, 4, 16, 64] |
           map($rows[((($sample / .) | floor) % 4)].savedMs) |
           add / 4)] | sort) as $replicates |
        [$replicates[6], $replicates[249]];
    def generic_observations($rows):
        ($rows | type == "array" and length == 4) and
        ([$rows[].pair] | sort) == [1, 2, 3, 4] and
        all($rows[];
            .controlDurationMs > 0 and .candidateDurationMs > 0 and
            .savedMs == (.controlDurationMs - .candidateDurationMs) and
            (if (.pair % 2) == 1
             then .order == "CONTROL_FIRST"
             else .order == "CANDIDATE_FIRST" end));
    def cache_result($value; $dsl):
        $value.dsl == $dsl and
        ($value.revision | revision) and
        generic_observations($value.observations) and
        all($value.observations[]; (.deliverableSha256 | digest)) and
        $value.meanSavedMs ==
            (($value.observations | map(.savedMs) | add) / 4) and
        $value.meanReductionRatio ==
            (($value.observations | map(.savedMs) | add) /
             ($value.observations | map(.controlDurationMs) | add)) and
        $value.interval95SavedMs == exact_bootstrap95($value.observations) and
        $value.positivePairs ==
            ($value.observations | map(select(.savedMs > 0)) | length) and
        $value.requiredOutputsIdentical and
        ([$value.observations[].deliverableSha256] | unique | length) == 1 and
        $value.productAttributableFailures == 0;
    keys == [
        "boundaries", "buildoptRevision", "capturedAt", "gate",
        "mechanisms", "methodology", "runner", "schemaVersion"
    ] and
    .schemaVersion == "buildopt.evidence/poc-value-baseline/v1" and
    (.capturedAt |
        type == "string" and
        test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
    (.buildoptRevision | revision) and
    .runner.schemaVersion == "buildopt.evidence/golden-runner-observation/v1" and
    .runner.id == "linux-amd64-4c-16g-v1" and
    .runner.operatingSystem == "Linux" and
    .runner.architecture == "x86_64" and
    .runner.cpuCount == 4 and
    .runner.memoryBytes == 17179869184 and
    .runner.qualifiedGoldenRunner == true and
    .runner.runnerSpecSha256 == $specSha256 and
    .runner.containerPlatformDigest == $platformDigest and
    .runner.cgroup.cpuMax == "400000 100000" and
    .runner.cgroup.memoryMax == "17179869184" and
    .methodology == {
        purpose: "REPRODUCE_MECHANISM_SCORECARD_AGAINST_OPTIMIZED_NATIVE_GRADLE",
        pairOrder: "PAIRED_ALTERNATING",
        pairsPerMechanism: 4,
        confidenceInterval:
            "EXACT_PAIRED_NONPARAMETRIC_BOOTSTRAP_256_RESAMPLES_TWO_SIDED_95",
        warmState: "ONE_UNMEASURED_WARMUP_PER_ARM_WITH_SEPARATE_HOMES",
        nativeControl: {
            buildCache: true,
            configurationCache: true,
            parallelism: true,
            daemon: true
        },
        percentagesAddedAcrossMechanisms: false
    } and
    cache_result(.mechanisms.safeCache.kotlin; "KOTLIN") and
    cache_result(.mechanisms.safeCache.groovy; "GROOVY") and
    .mechanisms.safeCache.classification ==
        (if (.mechanisms.safeCache.kotlin.meanReductionRatio >= -0.02 and
             .mechanisms.safeCache.groovy.meanReductionRatio >= -0.02)
         then "PARITY_ONLY"
         else "REGRESSION_REQUIRES_ACTION" end) and
    (.mechanisms.runtimeTuning.observations) as $runtimeRows |
    generic_observations($runtimeRows) and
    .mechanisms.runtimeTuning.controlProfile == "STABLE_CONTROL" and
    .mechanisms.runtimeTuning.candidateProfile == "W4_H6G" and
    .mechanisms.runtimeTuning.meanSavedMs ==
        (($runtimeRows | map(.savedMs) | add) / 4) and
    .mechanisms.runtimeTuning.meanReductionRatio ==
        (($runtimeRows | map(.savedMs) | add) /
         ($runtimeRows | map(.controlDurationMs) | add)) and
    .mechanisms.runtimeTuning.interval95SavedMs == exact_bootstrap95($runtimeRows) and
    all($runtimeRows[];
        (.controlSha256 | digest) and (.candidateSha256 | digest) and
        .controlSha256 == .candidateSha256) and
    .mechanisms.runtimeTuning.requiredOutputsIdentical and
    .mechanisms.runtimeTuning.productAttributableFailures == 0 and
    .mechanisms.runtimeTuning.oomDelta == 0 and
    .mechanisms.runtimeTuning.classification ==
        (if (.mechanisms.runtimeTuning.meanSavedMs >= 500 and
             .mechanisms.runtimeTuning.meanReductionRatio >= 0.02 and
             .mechanisms.runtimeTuning.interval95SavedMs[0] > 0 and
             .mechanisms.runtimeTuning.requiredOutputsIdentical and
             .mechanisms.runtimeTuning.oomDelta == 0)
         then "THRESHOLD_MET"
         else "BELOW_VALUE_THRESHOLD" end) and
    (.mechanisms.buildImpact.observations) as $impactRows |
    ($impactRows | type == "array" and length == 4) and
    ([$impactRows[].pair] | sort) == [1, 2, 3, 4] and
    all($impactRows[];
        .fullGraphDurationMs > 0 and .selectedGraphDurationMs > 0 and
        .savedMs == (.fullGraphDurationMs - .selectedGraphDurationMs) and
        (.serviceAJarSha256 | digest) and
        (.preservedTestMarkerSha256 | digest) and
        (if (.pair % 2) == 1
         then .order == "FULL_FIRST"
         else .order == "SELECTED_FIRST" end)) and
    .mechanisms.buildImpact.meanSavedMs ==
        (($impactRows | map(.savedMs) | add) / 4) and
    .mechanisms.buildImpact.meanReductionRatio ==
        (($impactRows | map(.savedMs) | add) /
         ($impactRows | map(.fullGraphDurationMs) | add)) and
    .mechanisms.buildImpact.interval95SavedMs == exact_bootstrap95($impactRows) and
    .mechanisms.buildImpact.positivePairs ==
        ($impactRows | map(select(.savedMs > 0)) | length) and
    .mechanisms.buildImpact.requiredOutputsIdentical and
    ([$impactRows[].serviceAJarSha256] | unique | length) == 1 and
    ([$impactRows[].preservedTestMarkerSha256] | unique | length) == 1 and
    .mechanisms.buildImpact.productAttributableFailures == 0 and
    .mechanisms.buildImpact.classification ==
        (if (.mechanisms.buildImpact.meanSavedMs >= 500 and
             .mechanisms.buildImpact.meanReductionRatio >= 0.02 and
             .mechanisms.buildImpact.interval95SavedMs[0] > 0 and
             .mechanisms.buildImpact.requiredOutputsIdentical)
         then "THRESHOLD_MET"
         else "BELOW_VALUE_THRESHOLD" end) and
    .gate == {
        id: "POC-VALUE-001",
        state: "PASSED",
        next: "POC-VALUE-002",
        pocValueProven: false
    } and
    .boundaries == {
        mechanismExplorationOnly: true,
        combinedProductMeasured: false,
        productionReadinessClaimed: false,
        eightHourSoakExecuted: false,
        externalDesignPartnerRequired: false,
        testOptimizationModified: false
    }
    ' "${buildopt_result}" >/dev/null

buildopt_revision=$(jq -er '.buildoptRevision' "${buildopt_result}")
git -C "${buildopt_repo_root}" cat-file -e "${buildopt_revision}^{commit}"

buildopt_after_status=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
if [[ "${buildopt_before_status}" != "${buildopt_after_status}" ]]; then
    printf 'POC value baseline validation changed the working tree\n' >&2
    exit 1
fi

printf 'BuildOpt POC-VALUE-001 baseline OK: %s\n' "${buildopt_result}"
