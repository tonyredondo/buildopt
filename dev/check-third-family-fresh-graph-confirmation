#!/usr/bin/env bash
set -euo pipefail
buildopt_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd -- "${buildopt_root}"

buildopt_evidence=benchmarks/results/third-family-fresh-graph-confirmation-v1
buildopt_capture_sha=$(sha256sum "${buildopt_evidence}/raw/capture.json" | awk '{print $1}')
buildopt_invocation_sha=$(sha256sum "${buildopt_evidence}/raw/invocation-01.json" | awk '{print $1}')

./dev/check-third-family-fresh-graph-confirmation-contract >/dev/null
jq -e \
  --slurpfile capture "${buildopt_evidence}/raw/capture.json" \
  --slurpfile invocation "${buildopt_evidence}/raw/invocation-01.json" \
  --arg captureSha "${buildopt_capture_sha}" --arg invocationSha "${buildopt_invocation_sha}" '
  $capture[0] as $capture|$invocation[0] as $invocation|
  $capture.schemaVersion=="buildopt.evidence/automatic-breadth-subject/v3" and
  $capture.repositoryId=="spring-projects/spring-framework" and
  $capture.baseRevision=="e93e55b456bbe320d2330fa37a975fe25feada1a" and
  $capture.targetRevision=="7a85ce959bf35ddb268658bedc0edde0efa41491" and
  $capture.processExitCode==0 and ($capture.productFailure|not) and
  $capture.ordinaryInvocations==1 and $capture.measurementOnlyWorkflowRuns==0 and
  $capture.rawResultSha256==$invocationSha and
  ($capture.invocationResults|length)==1 and $capture.invocationResults[0].sha256==$invocationSha and
  $invocation.schemaVersion=="buildopt.poc/optimize-result/v1" and
  $invocation.outcome=="NATIVE_RETAINED" and
  $invocation.reason=="AGGREGATE_OUTPUT_CLOSURE_PRODUCER_UNREACHABLE" and
  $invocation.execution=={authoritative:true,exitCode:0,mode:"OPTIMIZED_NATIVE",started:true} and
  $invocation.discovery.status=="NATIVE_RETAINED" and
  $invocation.discovery.changeFamily=="LEAF_SOURCE" and
  $invocation.discovery.changedProjects==[":framework-docs"] and
  $invocation.discovery.aggregatePartition.outputClosure=={
    candidateOutputCount:0,candidateProducerCount:0,materializedOutputCount:0,
    reachedTaskCount:281,reason:"AGGREGATE_OUTPUT_CLOSURE_PRODUCER_UNREACHABLE",
    requestedEntrypoints:["testClasses"],requiredOutputCount:0,
    schemaVersion:"buildopt.poc/aggregate-output-closure/v1",status:"NATIVE_RETAINED"
  } and
  ($invocation.calibration.performed|not) and ($invocation.calibration.qualified|not) and
  ($invocation.productionAuthorized|not) and
  .schemaVersion=="buildopt.evidence/third-family-fresh-graph-confirmation/v1" and
  .decision=="STOP_THIRD_FAMILY_FRESH_GRAPH_CONFIRMATION" and
  .rawBindings.captureSha256==$captureSha and .rawBindings.invocationSha256==$invocationSha and
  .rawBindings.stateTreeSha256==$capture.stateTreeSha256 and
  .rawBindings.executableSha256==$capture.buildopt.executableSha256 and
  .execution=={mode:"OPTIMIZED_NATIVE",gradleStarts:1,exitCode:0,durationMs:378305,candidateBuilds:0,timingSamples:0,productFailures:0} and
  .discovery=={status:"NATIVE_RETAINED",reason:"AGGREGATE_OUTPUT_CLOSURE_PRODUCER_UNREACHABLE",changedProjects:[":framework-docs"],family:"LEAF_SOURCE",requestedEntrypoints:["testClasses"],reachedTaskCount:281,requiredOutputCount:0,candidateOutputCount:0,historicalCompatibleMatches:0} and
  .economics=={calibrationPerformed:false,candidateMeasured:false,valueClaimed:false} and
  .boundaries=={candidateCorrectnessAuthorized:false,pairedValueAuthorized:false,productionAuthorized:false,testOptimization:"OUT_OF_SCOPE"}
' "${buildopt_evidence}/summary.json" >/dev/null

printf 'third-family fresh graph confirmation: stopped safely (producer unreachable, 1 native start, 0 candidates)\n'
