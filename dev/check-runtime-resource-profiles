#!/usr/bin/env bash
set -euo pipefail

buildopt_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${buildopt_repo_root}"

jq -e '
  .schemaVersion == "buildopt.specs/runtime-resource-profiles/v1" and
  .trackerId == "B-003" and
  .catalogVersion == "golden-linux-amd64-4c-16g-v1" and
  [.arms[].id] == ["STABLE_CONTROL", "W2_H3G", "W3_H4G", "W4_H6G"] and
  [.arms[].maxWorkers] == [2, 2, 3, 4] and
  [.arms[].gradleHeapMb] == [4096, 3072, 4096, 6144] and
  .fixedAcrossArms == ["jdk", "gradleJvmArgs", "compiler", "processLimits", "cgroupLimits"] and
  .launcher.authorityAction == "RESOURCE_PROFILE" and
  .launcher.changedInputs == ["--max-workers", "org.gradle.jvmargs.Xmx"] and
  .launcher.ineligibleDisposition == "PRESERVE_ORIGINAL_ARGV" and
  .doesNotClose == ["A1-001", "A1-006", "A1-G06", "B-G01", "B-G02", "B-G03"]
' specs/runtime-resource-profiles-v1.json >/dev/null

go test -race ./internal/runtimeoptimizer ./internal/launcher
go vet ./internal/runtimeoptimizer ./internal/launcher
printf 'B-003 runtime resource profiles OK: four finite arms, exact context, bounded argv, fail-open fallback\n'
