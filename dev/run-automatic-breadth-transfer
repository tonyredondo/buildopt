#!/usr/bin/env bash
set -euo pipefail

if (($# < 1 || $# > 2)) || [[ $1 != /* ]]; then
    printf 'usage: %s /absolute/evidence/output/directory [repository-key]\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_subject_filter=${2:-}
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_protocol=${BUILDOPT_AUTOMATIC_BREADTH_PROTOCOL:-v1}
case ${buildopt_protocol} in
    v1)
        buildopt_contract="${buildopt_repo_root}/specs/poc-automatic-breadth-transfer-v1.json"
        buildopt_package_version=0.3.0-dev
        buildopt_state_name=automatic-breadth-v1
        ;;
    v2)
        buildopt_contract="${buildopt_repo_root}/specs/poc-automatic-breadth-transfer-v2.json"
        buildopt_package_version=0.7.0-dev
        buildopt_state_name=automatic-breadth-v2
        ;;
    v3)
        buildopt_contract="${buildopt_repo_root}/specs/poc-materialization-economics-v2.json"
        buildopt_package_version=0.8.0-dev
        buildopt_state_name=materialization-economics-v2
        ;;
    v4)
        buildopt_contract="${buildopt_repo_root}/specs/poc-producer-bound-quarantine-replay-v1.json"
        buildopt_package_version=0.9.0-dev
        buildopt_state_name=producer-bound-quarantine-v1
        ;;
    *)
        printf 'unsupported automatic breadth protocol: %s\n' "${buildopt_protocol}" >&2
        exit 64
        ;;
esac
buildopt_subjects=${BUILDOPT_AUTOMATIC_BREADTH_SUBJECTS_FILE:-${buildopt_repo_root}/specs/poc-generic-profile-matrix-v3.json}
buildopt_expected_subjects_sha=${BUILDOPT_AUTOMATIC_BREADTH_SUBJECTS_SHA256:-}
buildopt_retain_root=${BUILDOPT_AUTOMATIC_BREADTH_RETAIN_ROOT:-false}
buildopt_requested_root=${BUILDOPT_AUTOMATIC_BREADTH_ROOT:-}
buildopt_process_mode=${BUILDOPT_AUTOMATIC_BREADTH_PROCESS_MODE:-daemon}
buildopt_task_trace=${BUILDOPT_AUTOMATIC_BREADTH_TASK_TRACE:-false}
case ${buildopt_task_trace} in
    false) ;;
    true)
        [[ ${buildopt_protocol} == v4 &&
            -s ${buildopt_script_dir}/gradle-critical-path.init.gradle ]] || {
            printf 'task trace capture requires protocol v4 and its init script\n' >&2
            exit 64
        }
        ;;
    *)
        printf 'automatic breadth task trace must be true or false\n' >&2
        exit 64
        ;;
esac
buildopt_native_volatility_diagnostic=0
[[ ${buildopt_protocol} == v4 ]] && buildopt_native_volatility_diagnostic=1
buildopt_native_portfolio=${BUILDOPT_NATIVE_VOLATILITY_PORTFOLIO_FILE:-}
buildopt_native_portfolio_context=${BUILDOPT_NATIVE_VOLATILITY_PORTFOLIO_CONTEXT_FILE:-}
buildopt_native_portfolio_revision=${BUILDOPT_NATIVE_VOLATILITY_REVISION_SHA256:-}
buildopt_native_portfolio_requested=false
if [[ -n ${buildopt_native_portfolio}${buildopt_native_portfolio_context}${buildopt_native_portfolio_revision} ]]; then
    [[ -s ${buildopt_native_portfolio} && -s ${buildopt_native_portfolio_context} &&
        ${buildopt_native_portfolio_revision} =~ ^[0-9a-f]{64}$ ]] || {
        printf 'complete native volatility portfolio inputs are required\n' >&2
        exit 64
    }
    buildopt_native_portfolio_requested=true
fi
buildopt_requested_invocations=${BUILDOPT_AUTOMATIC_BREADTH_INVOCATIONS:-}
if [[ -n ${buildopt_requested_invocations} ]]; then
    case ${buildopt_protocol}:${buildopt_requested_invocations} in
        v3:1 | v3:3) ;;
        v4:[1-9] | v4:1[0-8]) ;;
        *)
            printf 'automatic breadth invocation override requires v3:3 or v4:1..18\n' >&2
            exit 64
            ;;
    esac
fi
case ${buildopt_process_mode} in
    daemon | no-daemon) buildopt_process_flag=--${buildopt_process_mode} ;;
    *)
        printf 'unsupported automatic breadth process mode: %s\n' \
            "${buildopt_process_mode}" >&2
        exit 64
        ;;
esac
if [[ -n ${buildopt_requested_root} ]]; then
    [[ ${buildopt_requested_root} == "${TMPDIR:-/tmp}/buildopt-automatic-breadth."* &&
        ! -e ${buildopt_requested_root} ]] || {
        printf 'automatic breadth root is not a new bounded temporary path: %s\n' \
            "${buildopt_requested_root}" >&2
        exit 64
    }
    buildopt_root=${buildopt_requested_root}
    mkdir -p -- "${buildopt_root}"
else
    buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-automatic-breadth.XXXXXX")
fi

buildopt_cleanup() {
    if [[ ${buildopt_retain_root} != true &&
        ${buildopt_root} == "${TMPDIR:-/tmp}/buildopt-automatic-breadth."* ]]; then
        rm -rf -- "${buildopt_root}"
    fi
}
trap buildopt_cleanup EXIT

for buildopt_command in awk cp df find git jq perl sha256sum sleep sort tar timeout xargs; do
    command -v "${buildopt_command}" >/dev/null || {
        printf 'required automatic breadth command is unavailable: %s\n' "${buildopt_command}" >&2
        exit 1
    }
done

[[ -f ${buildopt_contract} && -f ${buildopt_subjects} ]] || {
    printf 'automatic breadth contract is unavailable\n' >&2
    exit 1
}
buildopt_actual_subjects_sha=$(sha256sum "${buildopt_subjects}" | awk '{print $1}')
if [[ -n ${buildopt_expected_subjects_sha} ]]; then
    [[ ${buildopt_actual_subjects_sha} == "${buildopt_expected_subjects_sha}" ]] || {
        printf 'explicit automatic breadth subjects drifted\n' >&2
        exit 1
    }
elif [[ ${buildopt_actual_subjects_sha} != \
    $(jq -r '.frozenSubjects.sha256' "${buildopt_contract}") ]]; then
    printf 'frozen automatic breadth subjects drifted\n' >&2
    exit 1
fi
[[ $(sha256sum "${buildopt_repo_root}/specs/poc-otel-spring-family-v2.tasks.txt" | awk '{print $1}') == \
    $(jq -r '.frozenSubjects.opentelemetryEntrypointsSha256' "${buildopt_contract}") ]] || {
    printf 'frozen OpenTelemetry workflow drifted\n' >&2
    exit 1
}
[[ -z $(git -C "${buildopt_repo_root}" status --porcelain --untracked-files=no) ]] || {
    printf 'BuildOpt tracked state must be clean before evidence capture\n' >&2
    exit 1
}

buildopt_subject_count=$(jq '.repositories | length' "${buildopt_subjects}")
buildopt_expected_subject_count=${buildopt_subject_count}
if [[ -n ${buildopt_subject_filter} ]]; then
    [[ $(jq --arg key "${buildopt_subject_filter}" \
        '[.repositories[] | select(.key == $key)] | length' "${buildopt_subjects}") -eq 1 ]] || {
        printf 'repository key is absent or ambiguous: %s\n' "${buildopt_subject_filter}" >&2
        exit 1
    }
    buildopt_expected_subject_count=1
fi
mkdir -p -- "${buildopt_output}"

buildopt_revision=$(git -C "${buildopt_repo_root}" rev-parse HEAD)
buildopt_package_root="${buildopt_root}/package"
mkdir -p -- "${buildopt_package_root}" "${buildopt_root}/release" "${buildopt_root}/install"
"${buildopt_repo_root}/packaging/linux/package.sh" \
    --version "${buildopt_package_version}" --output "${buildopt_package_root}" >/dev/null
tar -xzf "${buildopt_package_root}/buildopt-${buildopt_package_version}-linux-amd64.tar.gz" \
    -C "${buildopt_root}/release"
"${buildopt_root}/release/buildopt-${buildopt_package_version}-linux-amd64/install.sh" \
    --prefix "${buildopt_root}/install" >/dev/null
buildopt_executable="${buildopt_root}/install/bin/buildopt"
buildopt_executable_sha=$(sha256sum "${buildopt_executable}" | awk '{print $1}')

buildopt_mutate_repository() {
    local buildopt_mutation=$1
    local buildopt_repository=$2
    local buildopt_change_path=$3
    local buildopt_marker=$4

    case "${buildopt_mutation}" in
        APPEND_FIXED_COMMENT)
            printf '\n// buildopt-poc-%s\n' "${buildopt_marker}" \
                >>"${buildopt_repository}/${buildopt_change_path}"
            ;;
        ADD_PACKAGE_PRIVATE_MARKER_RETURNING_ONE)
            perl -0pi -e 's/\n}\n\z/\n\n    int buildOptPocMarker() {\n        return 1;\n    }\n}\n/' \
                "${buildopt_repository}/${buildopt_change_path}"
            ;;
        *)
            printf 'unsupported automatic breadth mutation: %s\n' "${buildopt_mutation}" >&2
            return 1
            ;;
    esac
}

buildopt_seed_gradle_distribution() {
    local buildopt_repository=$1
    local buildopt_gradle_home=$2
    local buildopt_properties buildopt_url buildopt_archive buildopt_distribution
    local buildopt_source_root buildopt_source buildopt_destination

    buildopt_properties="${buildopt_repository}/gradle/wrapper/gradle-wrapper.properties"
    [[ -f ${buildopt_properties} ]] || return 1
    buildopt_url=$(awk -F= '$1 == "distributionUrl" {sub(/^[^=]*=/, ""); print; exit}' \
        "${buildopt_properties}")
    buildopt_url=${buildopt_url//\\:/:}
    buildopt_archive=${buildopt_url%%\?*}
    buildopt_archive=${buildopt_archive##*/}
    buildopt_distribution=${buildopt_archive%.zip}
    [[ ${buildopt_distribution} =~ ^gradle-[0-9][0-9.]*-(bin|all)$ ]] || return 1
    buildopt_destination="${buildopt_gradle_home}/wrapper/dists/${buildopt_distribution}"
    mkdir -p -- "${buildopt_destination}"
    for buildopt_source_root in \
        "${buildopt_repo_root}/.tools/gradle-user-home/wrapper/dists" \
        "${GRADLE_USER_HOME:-${HOME}/.gradle}/wrapper/dists"; do
        buildopt_source="${buildopt_source_root}/${buildopt_distribution}"
        [[ -d ${buildopt_source} ]] || continue
        cp -a -- "${buildopt_source}/." "${buildopt_destination}/"
    done
}

buildopt_prepare_gradle_distribution() {
    local buildopt_repository=$1
    local buildopt_gradle_home=$2
    local buildopt_jdk=$3
    local buildopt_log=$4
    local buildopt_attempt

    buildopt_seed_gradle_distribution "${buildopt_repository}" "${buildopt_gradle_home}"
    : >"${buildopt_log}"
    for buildopt_attempt in 1 2 3; do
        printf 'Gradle distribution preparation attempt %d/3\n' "${buildopt_attempt}" \
            >>"${buildopt_log}"
        if (
            cd -- "${buildopt_repository}"
            env -u CI GRADLE_USER_HOME="${buildopt_gradle_home}" \
                timeout 15m "${buildopt_script_dir}/run" --toolchain "${buildopt_jdk}" -- \
                ./gradlew --version
        ) >>"${buildopt_log}" 2>&1; then
            return 0
        fi
    done
    return 1
}

buildopt_entrypoints() {
    local buildopt_index=$1
    local buildopt_file
    buildopt_file=$(jq -r ".repositories[${buildopt_index}].entrypointsFile // empty" \
        "${buildopt_subjects}")
    if [[ -n ${buildopt_file} ]]; then
        grep -v '^[[:space:]]*$' "${buildopt_repo_root}/${buildopt_file}"
    else
        jq -r ".repositories[${buildopt_index}].entrypoints[]" "${buildopt_subjects}"
    fi
}

buildopt_clean_subject_outputs() {
    local buildopt_repository=$1

    [[ ${buildopt_repository} == "${buildopt_root}/"* && -d ${buildopt_repository}/.git ]] || {
        printf 'refusing to clean an unverified automatic breadth checkout: %s\n' \
            "${buildopt_repository}" >&2
        return 1
    }
    git -C "${buildopt_repository}" clean -qfdX -e '!.buildopt/'
}

buildopt_capture_subject() {
    local buildopt_index=$1
    local buildopt_key buildopt_repository_id buildopt_remote buildopt_base
    local buildopt_jdk buildopt_change_path buildopt_mutation buildopt_target
    local buildopt_public_target
    local buildopt_repository buildopt_gradle_home buildopt_subject_output
    local buildopt_event buildopt_stdout buildopt_stderr buildopt_status buildopt_free
    local buildopt_state_source buildopt_raw_sha buildopt_state_sha
    local buildopt_invocation buildopt_invocation_file buildopt_invocation_sha
    local buildopt_invocation_metadata buildopt_all_invocations_valid
    local buildopt_total_invocations buildopt_native_repository buildopt_native_gradle_home
    local buildopt_native_log buildopt_native_observation buildopt_quarantine_result
    local buildopt_quarantine_sha buildopt_native_observation_sha
    local buildopt_portfolio_preflight buildopt_portfolio_preflight_sha
    local buildopt_portfolio_preflight_json
    local buildopt_portfolio_preflight_decision
    local buildopt_trace_base buildopt_trace_graph
    local buildopt_argument
    local -a buildopt_gradle_args=()
    local -a buildopt_native_gradle_args=()
    local -a buildopt_quarantine_args=()
    local -a buildopt_trace_environment=()

    buildopt_key=$(jq -er ".repositories[${buildopt_index}].key" "${buildopt_subjects}")
    buildopt_repository_id=$(jq -er ".repositories[${buildopt_index}].repositoryId" "${buildopt_subjects}")
    buildopt_remote=$(jq -er ".repositories[${buildopt_index}].remoteUrl" "${buildopt_subjects}")
    buildopt_base=$(jq -er ".repositories[${buildopt_index}].publicRevision" "${buildopt_subjects}")
    buildopt_jdk=$(jq -er ".repositories[${buildopt_index}].jdkToolchain" "${buildopt_subjects}")
    buildopt_change_path=$(jq -er ".repositories[${buildopt_index}].changePath" "${buildopt_subjects}")
    buildopt_mutation=$(jq -er ".repositories[${buildopt_index}].mutation" "${buildopt_subjects}")
    buildopt_public_target=$(jq -r ".repositories[${buildopt_index}].targetRevision // empty" \
        "${buildopt_subjects}")
    buildopt_subject_output="${buildopt_output}/${buildopt_key}"
    [[ ! -e ${buildopt_subject_output} ]] || {
        printf 'automatic breadth subject already exists: %s\n' "${buildopt_key}" >&2
        return 1
    }

    buildopt_free=$(df -Pk "${TMPDIR:-/tmp}" | awk 'NR == 2 {print $4 * 1024}')
    if ((buildopt_free < 8589934592)); then
        printf 'less than 8 GiB is free before %s\n' "${buildopt_key}" >&2
        return 1
    fi

    buildopt_repository="${buildopt_root}/${buildopt_key}/repository"
    buildopt_gradle_home="${buildopt_root}/${buildopt_key}/gradle-home"
    mkdir -p -- "${buildopt_repository}" "${buildopt_gradle_home}" "${buildopt_subject_output}"
    git -C "${buildopt_repository}" init -q
    git -C "${buildopt_repository}" remote add origin "${buildopt_remote}"
    git -C "${buildopt_repository}" fetch --depth=65 origin \
        "${buildopt_base}" ${buildopt_public_target:+"${buildopt_public_target}"}
    if [[ -n ${buildopt_public_target} ]]; then
        git -C "${buildopt_repository}" checkout -q -b buildopt-poc \
            "${buildopt_public_target}"
        [[ $(git -C "${buildopt_repository}" rev-parse HEAD^1) == "${buildopt_base}" ]] || {
            printf 'public qualification target is not a direct child of its base: %s\n' \
                "${buildopt_key}" >&2
            return 1
        }
        buildopt_target=${buildopt_public_target}
    else
        git -C "${buildopt_repository}" checkout -q -b buildopt-poc FETCH_HEAD
    fi

    printf 'Preparing %s outside calibration\n' "${buildopt_repository_id}"
    if ! buildopt_prepare_gradle_distribution \
        "${buildopt_repository}" "${buildopt_gradle_home}" "${buildopt_jdk}" \
        "${buildopt_root}/${buildopt_key}/distribution-preparation.log"; then
        tail -n 120 "${buildopt_root}/${buildopt_key}/distribution-preparation.log" >&2
        printf 'Gradle preparation failed for %s\n' "${buildopt_key}" >&2
        return 1
    fi

    if [[ -z ${buildopt_public_target} ]]; then
        buildopt_mutate_repository "${buildopt_mutation}" "${buildopt_repository}" \
            "${buildopt_change_path}" "${buildopt_key}"
        git -C "${buildopt_repository}" config user.name 'BuildOpt POC'
        git -C "${buildopt_repository}" config user.email 'buildopt-poc@example.invalid'
        git -C "${buildopt_repository}" config commit.gpgsign false
        git -C "${buildopt_repository}" add -- "${buildopt_change_path}"
        GIT_AUTHOR_DATE='2026-08-20T00:00:00Z' \
            GIT_COMMITTER_DATE='2026-08-20T00:00:00Z' \
            git -C "${buildopt_repository}" commit -qm 'Apply frozen automatic breadth mutation'
        buildopt_target=$(git -C "${buildopt_repository}" rev-parse HEAD)
    fi

    while IFS= read -r buildopt_entrypoint; do
        [[ -n ${buildopt_entrypoint} ]] && buildopt_gradle_args+=("${buildopt_entrypoint}")
    done < <(buildopt_entrypoints "${buildopt_index}")
    buildopt_gradle_args+=(
        "${buildopt_process_flag}" --build-cache --parallel --no-configuration-cache
        --console=plain --no-scan --max-workers=12
    )
    if [[ ${buildopt_task_trace} == true ]]; then
        mkdir -p -- "${buildopt_subject_output}/operations" \
            "${buildopt_gradle_home}/init.d"
        cp -- "${buildopt_script_dir}/gradle-critical-path.init.gradle" \
            "${buildopt_gradle_home}/init.d/buildopt-critical-path.gradle"
    fi
    buildopt_event="${buildopt_root}/${buildopt_key}/github-event.json"
    jq -n --arg before "${buildopt_base}" '{before:$before}' >"${buildopt_event}"
    buildopt_stdout="${buildopt_root}/${buildopt_key}/optimize.stdout"
    buildopt_stderr="${buildopt_root}/${buildopt_key}/optimize.stderr"
    buildopt_invocation_metadata="${buildopt_root}/${buildopt_key}/invocations.jsonl"
    : >"${buildopt_invocation_metadata}"

    printf 'Running automatic optimize path for %s\n' "${buildopt_repository_id}"
    if [[ ${buildopt_protocol} == v1 ]]; then
        set +e
        (
            cd -- "${buildopt_repository}"
            env -u CI \
                GITHUB_EVENT_PATH="${buildopt_event}" \
                GITHUB_REPOSITORY="${buildopt_repository_id}" \
                GRADLE_USER_HOME="${buildopt_gradle_home}" \
                timeout 60m "${buildopt_script_dir}/run" --toolchain "${buildopt_jdk}" -- \
                env BUILDOPT_NATIVE_VOLATILITY_DIAGNOSTIC="${buildopt_native_volatility_diagnostic}" \
                    "${buildopt_executable}" optimize \
                --state-dir ".buildopt/optimize/${buildopt_state_name}" \
                --resume never --calibration-budget 30m --calibration-pairs 8 \
                --max-break-even-builds 30 --json -- "${buildopt_gradle_args[@]}"
        ) >"${buildopt_stdout}" 2>"${buildopt_stderr}"
        buildopt_status=$?
        set -e
    else
        buildopt_status=0
        buildopt_all_invocations_valid=true
        buildopt_total_invocations=17
        [[ ${buildopt_protocol} == v4 ]] && buildopt_total_invocations=18
        [[ -n ${buildopt_requested_invocations} ]] && \
            buildopt_total_invocations=${buildopt_requested_invocations}
        for buildopt_invocation in $(seq 1 "${buildopt_total_invocations}"); do
            buildopt_clean_subject_outputs "${buildopt_repository}"
            buildopt_trace_environment=()
            if [[ ${buildopt_task_trace} == true ]]; then
                buildopt_trace_base=$(printf '%s/operations/invocation-%02d' \
                    "${buildopt_subject_output}" "${buildopt_invocation}")
                buildopt_trace_graph=${buildopt_trace_base}-graph.jsonl
                buildopt_trace_environment=(
                    "GRADLE_OPTS=-Dorg.gradle.internal.operations.trace=${buildopt_trace_base}"
                    "BUILDOPT_TASK_GRAPH_OUTPUT=${buildopt_trace_graph}"
                )
            fi
            buildopt_invocation_file=$(printf '%s/invocation-%02d.json' \
                "${buildopt_subject_output}" "${buildopt_invocation}")
            buildopt_stderr=$(printf '%s/invocation-%02d.stderr' \
                "${buildopt_root}/${buildopt_key}" "${buildopt_invocation}")
            printf '  ordinary invocation %d/%d\n' \
                "${buildopt_invocation}" "${buildopt_total_invocations}"
            set +e
            (
                cd -- "${buildopt_repository}"
                env -u CI "${buildopt_trace_environment[@]}" \
                    GITHUB_EVENT_PATH="${buildopt_event}" \
                    GITHUB_REPOSITORY="${buildopt_repository_id}" \
                    GRADLE_USER_HOME="${buildopt_gradle_home}" \
                    timeout 30m "${buildopt_script_dir}/run" --toolchain "${buildopt_jdk}" -- \
                    env BUILDOPT_NATIVE_VOLATILITY_DIAGNOSTIC="${buildopt_native_volatility_diagnostic}" \
                        "${buildopt_executable}" optimize \
                    --state-dir ".buildopt/optimize/${buildopt_state_name}" \
                    --resume auto --calibration-budget 30m --calibration-pairs 8 \
                    --max-break-even-builds 30 --json -- "${buildopt_gradle_args[@]}"
            ) >"${buildopt_invocation_file}" 2>"${buildopt_stderr}"
            buildopt_status=$?
            set -e
            if ((buildopt_status != 0)) || ! jq -e \
                '.schemaVersion == "buildopt.poc/optimize-result/v1"' \
                "${buildopt_invocation_file}" >/dev/null 2>&1; then
                buildopt_all_invocations_valid=false
                break
            fi
            if [[ ${buildopt_task_trace} == true ]] &&
                jq -e '.execution.started == true' "${buildopt_invocation_file}" >/dev/null &&
                [[ ! -s ${buildopt_trace_base}-log.txt || ! -s ${buildopt_trace_graph} ]]; then
                printf 'task trace capture is incomplete for invocation %d\n' \
                    "${buildopt_invocation}" >&2
                buildopt_all_invocations_valid=false
                break
            fi
            buildopt_invocation_sha=$(sha256sum "${buildopt_invocation_file}" | awk '{print $1}')
            jq -nc --arg path "${buildopt_key}/$(basename "${buildopt_invocation_file}")" \
                --arg sha256 "${buildopt_invocation_sha}" \
                --argjson sequence "${buildopt_invocation}" \
                --slurpfile result "${buildopt_invocation_file}" '
              ($result[0]) as $r |
              {sequence:$sequence,path:$path,sha256:$sha256,outcome:$r.outcome,
               reason:$r.reason,phase:$r.phase,durationMs:$r.durationMs,
               executionMode:$r.execution.mode,exitCode:$r.execution.exitCode}
            ' >>"${buildopt_invocation_metadata}"
            if jq -e '
              .incrementalLearning.ordinaryEconomics.decision == "NATIVE_RETAINED" and
              .reason == "ORDINARY_LEARNING_ECONOMICS_REJECTED"
            ' "${buildopt_invocation_file}" >/dev/null; then
                buildopt_total_invocations=${buildopt_invocation}
                break
            fi
            if [[ ${buildopt_protocol} == v4 && ${buildopt_invocation} -eq 1 ]]; then
                buildopt_native_repository="${buildopt_root}/${buildopt_key}/native-repository"
                buildopt_native_gradle_home="${buildopt_root}/${buildopt_key}/native-gradle-home"
                buildopt_native_log="${buildopt_subject_output}/native-build.log"
                buildopt_native_observation="${buildopt_subject_output}/native-second.json"
                buildopt_quarantine_result="${buildopt_subject_output}/quarantine-result.json"
                buildopt_portfolio_preflight="${buildopt_subject_output}/portfolio-preflight.json"
                if [[ ${buildopt_native_portfolio_requested} == true ]]; then
                    printf '  portfolio compatibility preflight\n'
                    if ! (
                        cd -- "${buildopt_repository}"
                        "${buildopt_executable}" profile native-preflight \
                            --state-dir ".buildopt/optimize/${buildopt_state_name}" \
                            --portfolio "${buildopt_native_portfolio}" \
                            --portfolio-context "${buildopt_native_portfolio_context}"
                    ) >"${buildopt_portfolio_preflight}" \
                        2>"${buildopt_subject_output}/portfolio-preflight.stderr"; then
                        cat "${buildopt_subject_output}/portfolio-preflight.stderr" >&2
                        buildopt_all_invocations_valid=false
                        break
                    fi
                    jq -e '
                      .schemaVersion == "buildopt.poc/native-volatility-portfolio-preflight/v1" and
                      ((.decision == "COMPATIBLE" and
                        .reason == "PORTFOLIO_CONTEXT_COMPATIBLE" and
                        .independentNativeObservationAuthorized == true and
                        (.driftedBindings | length) == 0) or
                       (.decision == "NATIVE_RETAINED" and
                        .reason == "PORTFOLIO_CONTEXT_DRIFT" and
                        .independentNativeObservationAuthorized == false and
                        (.driftedBindings | length) > 0)) and
                      .productionAuthorized == false and
                      .testOptimization == "OUT_OF_SCOPE"
                    ' "${buildopt_portfolio_preflight}" >/dev/null || {
                        printf 'portfolio compatibility preflight is invalid\n' >&2
                        buildopt_all_invocations_valid=false
                        break
                    }
                    buildopt_portfolio_preflight_decision=$(jq -r '.decision' \
                        "${buildopt_portfolio_preflight}")
                    if [[ ${buildopt_portfolio_preflight_decision} == NATIVE_RETAINED ]]; then
                        buildopt_total_invocations=${buildopt_invocation}
                        break
                    fi
                fi
                printf '  independent native observation and producer quarantine\n'
                git clone -q --no-hardlinks "${buildopt_repository}" "${buildopt_native_repository}"
                mkdir -p -- "${buildopt_native_gradle_home}"
                if ! buildopt_prepare_gradle_distribution \
                    "${buildopt_native_repository}" "${buildopt_native_gradle_home}" \
                    "${buildopt_jdk}" "${buildopt_subject_output}/native-distribution-preparation.log"; then
                    printf 'independent native Gradle preparation failed for %s\n' \
                        "${buildopt_key}" >&2
                    buildopt_all_invocations_valid=false
                    break
                fi
                buildopt_native_gradle_args=()
                for buildopt_argument in "${buildopt_gradle_args[@]}"; do
                    [[ ${buildopt_argument} == --build-cache ]] && continue
                    buildopt_native_gradle_args+=("${buildopt_argument}")
                done
                buildopt_native_gradle_args+=(--no-build-cache)
                if ! (
                    cd -- "${buildopt_native_repository}"
                    env -u CI GRADLE_USER_HOME="${buildopt_native_gradle_home}" \
                        timeout 60m "${buildopt_script_dir}/run" --toolchain "${buildopt_jdk}" -- \
                        ./gradlew "${buildopt_native_gradle_args[@]}"
                ) >"${buildopt_native_log}" 2>&1; then
                    tail -n 120 "${buildopt_native_log}" >&2
                    buildopt_all_invocations_valid=false
                    break
                fi
                if ! (
                    cd -- "${buildopt_repository}"
                    "${buildopt_executable}" profile native-observe \
                        --state-dir ".buildopt/optimize/${buildopt_state_name}" \
                        --root "${buildopt_native_repository}"
                ) >"${buildopt_native_observation}" 2>"${buildopt_subject_output}/native-observe.stderr"; then
                    cat "${buildopt_subject_output}/native-observe.stderr" >&2
                    buildopt_all_invocations_valid=false
                    break
                fi
                buildopt_quarantine_args=(
                    --state-dir ".buildopt/optimize/${buildopt_state_name}"
                    --second-observation "${buildopt_native_observation}"
                )
                if [[ ${buildopt_native_portfolio_requested} == true ]]; then
                    buildopt_quarantine_args+=(
                        --portfolio "${buildopt_native_portfolio}"
                        --portfolio-context "${buildopt_native_portfolio_context}"
                        --revision "${buildopt_native_portfolio_revision}"
                    )
                fi
                if ! (
                    cd -- "${buildopt_repository}"
                    "${buildopt_executable}" profile quarantine \
                        "${buildopt_quarantine_args[@]}"
                ) >"${buildopt_quarantine_result}" 2>"${buildopt_subject_output}/quarantine.stderr"; then
                    cat "${buildopt_subject_output}/quarantine.stderr" >&2
                    buildopt_all_invocations_valid=false
                    break
                fi
                jq -e --argjson portfolio "${buildopt_native_portfolio_requested}" '
                  if $portfolio then
                    ((.schemaVersion == "buildopt.poc/optimize-native-volatility-portfolio-evidence/v1" and
                      .current.schemaVersion == "buildopt.poc/native-volatility-quarantine/v1" and
                      .current.decision == "TRANSPORT_READY" and
                      .application.schemaVersion == "buildopt.poc/native-volatility-portfolio-application/v1" and
                      .application.decision == "PORTFOLIO_APPLIED" and
                      (.application.quarantinedOutputs | length) > 0 and
                      (.application.transportedOutputs | length) > 0) or
                     (.schemaVersion == "buildopt.poc/optimize-native-volatility-portfolio-retention/v1" and
                      .current.schemaVersion == "buildopt.poc/native-volatility-quarantine/v1" and
                      .decision == "NATIVE_RETAINED" and
                      ((.reason == "PORTFOLIO_CONTEXT_DRIFT" and
                        (.driftedBindings | length) > 0) or
                       (.reason == "CURRENT_MATERIALIZATION_UNAVAILABLE" and
                        (.driftedBindings | length) == 0 and
                        (.missingProducers | length) == 0) or
                       (.reason == "PORTFOLIO_PRODUCER_LINEAGE_UNAVAILABLE" and
                        (.driftedBindings | length) == 0 and
                        (.missingProducers | length) > 0)) and
                      .productionAuthorized == false and
                      .testOptimization == "OUT_OF_SCOPE"))
                  else
                    .schemaVersion == "buildopt.poc/native-volatility-quarantine/v1" and
                    .decision == "TRANSPORT_READY" and
                    (.transportedOutputs | length) > 0 and
                    ((.reason == "INDEPENDENT_NATIVE_OUTPUTS_EXACT" and
                      (.quarantinedProducers | length) == 0 and
                      (.quarantinedOutputs | length) == 0 and
                      (.transportedOutputs | length) == .comparedOutputCount) or
                     (.reason == "VOLATILE_PRODUCERS_QUARANTINED" and
                      (.quarantinedProducers | length) > 0 and
                      (.quarantinedOutputs | length) > 0 and
                      ((.quarantinedOutputs + .transportedOutputs) | length) ==
                        .comparedOutputCount))
                  end
                ' "${buildopt_quarantine_result}" >/dev/null || {
                    printf 'producer-bound output analysis did not produce a safe transport plan\n' >&2
                    buildopt_all_invocations_valid=false
                    break
                }
                (
                    cd -- "${buildopt_native_repository}"
                    env GRADLE_USER_HOME="${buildopt_native_gradle_home}" \
                        "${buildopt_script_dir}/run" --toolchain "${buildopt_jdk}" -- \
                        ./gradlew --stop
                ) >/dev/null 2>&1 || true
                rm -rf -- "${buildopt_native_repository}" "${buildopt_native_gradle_home}"
                if [[ $(jq -r '.schemaVersion' "${buildopt_quarantine_result}") == \
                    "buildopt.poc/optimize-native-volatility-portfolio-retention/v1" ]]; then
                    buildopt_total_invocations=${buildopt_invocation}
                    break
                fi
            fi
        done
        if [[ ${buildopt_all_invocations_valid} == true &&
            ${buildopt_invocation} -eq ${buildopt_total_invocations} ]]; then
            buildopt_stdout=$(printf '%s/invocation-%02d.json' \
                "${buildopt_subject_output}" "${buildopt_total_invocations}")
        fi
    fi

    if ! jq -e '.schemaVersion == "buildopt.poc/optimize-result/v1"' \
        "${buildopt_stdout}" >/dev/null 2>&1; then
        buildopt_capture_schema="buildopt.evidence/automatic-breadth-subject/${buildopt_protocol}"
        jq -n \
            --arg key "${buildopt_key}" --arg repositoryId "${buildopt_repository_id}" \
            --arg baseRevision "${buildopt_base}" --arg targetRevision "${buildopt_target}" \
            --arg buildoptRevision "${buildopt_revision}" \
            --arg executableSha256 "${buildopt_executable_sha}" \
            --arg captureSchema "${buildopt_capture_schema}" \
            --argjson processExitCode "${buildopt_status}" '
          {schemaVersion:$captureSchema,
           key:$key,repositoryId:$repositoryId,baseRevision:$baseRevision,
           targetRevision:$targetRevision,buildopt:{revision:$buildoptRevision,
           executableSha256:$executableSha256},processExitCode:$processExitCode,
           resultAvailable:false,productFailure:true,rawResult:null}
        ' >"${buildopt_subject_output}/capture.json"
        if [[ ${buildopt_protocol} != v1 && -s ${buildopt_stderr} ]]; then
            cp -- "${buildopt_stderr}" "${buildopt_subject_output}/failure.stderr"
            tail -n 120 "${buildopt_stderr}" >&2
        fi
    else
        cp -- "${buildopt_stdout}" "${buildopt_subject_output}/result.json"
        buildopt_state_source="${buildopt_repository}/.buildopt/optimize/${buildopt_state_name}"
        if [[ -d ${buildopt_state_source} ]]; then
            cp -a -- "${buildopt_state_source}" "${buildopt_subject_output}/state"
            if [[ ${buildopt_protocol} == v2 ]]; then
                rm -rf -- "${buildopt_subject_output}/state/materialization/blobs"
            elif [[ ${buildopt_protocol} == v3 ]]; then
                rm -f -- "${buildopt_subject_output}/state/materialization/payload.pack"
            elif [[ ${buildopt_protocol} == v4 ]]; then
                rm -f -- \
                    "${buildopt_subject_output}/state/materialization/payload.pack" \
                    "${buildopt_subject_output}/state/materialization/quarantine/payload.pack"
            fi
        fi
        buildopt_raw_sha=$(sha256sum "${buildopt_subject_output}/result.json" | awk '{print $1}')
        buildopt_state_sha=null
        if [[ -d ${buildopt_subject_output}/state ]]; then
            buildopt_state_sha=$(
                cd -- "${buildopt_subject_output}/state"
                find . -type f -print0 | sort -z | xargs -0 -r sha256sum | \
                    sha256sum | awk '{print $1}'
            )
        fi
        if [[ ${buildopt_protocol} == v1 ]]; then
            jq -n \
            --arg key "${buildopt_key}" --arg repositoryId "${buildopt_repository_id}" \
            --arg baseRevision "${buildopt_base}" --arg targetRevision "${buildopt_target}" \
            --arg buildoptRevision "${buildopt_revision}" \
            --arg executableSha256 "${buildopt_executable_sha}" \
            --arg rawResult "${buildopt_key}/result.json" --arg rawResultSha256 "${buildopt_raw_sha}" \
            --arg stateTreeSha256 "${buildopt_state_sha}" \
            --argjson processExitCode "${buildopt_status}" \
            --slurpfile result "${buildopt_subject_output}/result.json" '
          ($result[0]) as $r |
          {schemaVersion:"buildopt.evidence/automatic-breadth-subject/v1",
           key:$key,repositoryId:$repositoryId,baseRevision:$baseRevision,
           targetRevision:$targetRevision,buildopt:{revision:$buildoptRevision,
           executableSha256:$executableSha256},processExitCode:$processExitCode,
           resultAvailable:true,productFailure:($processExitCode != 0),
           rawResult:$rawResult,rawResultSha256:$rawResultSha256,
           stateTreeSha256:(if $stateTreeSha256 == "null" then null else $stateTreeSha256 end),
           outcome:$r.outcome,reason:$r.reason,durationMs:$r.durationMs,
           manualFilesRequired:$r.manualFilesRequired,native:$r.native,
           execution:$r.execution,discovery:$r.discovery,
           prequalification:$r.prequalification,calibration:$r.calibration,
           portfolio:$r.portfolio,selection:$r.selection,value:$r.value,
           productionAuthorized:$r.productionAuthorized,
           testOptimization:$r.testOptimization}
            ' >"${buildopt_subject_output}/capture.json"
        else
            jq -n \
                --arg key "${buildopt_key}" --arg repositoryId "${buildopt_repository_id}" \
                --arg baseRevision "${buildopt_base}" --arg targetRevision "${buildopt_target}" \
                --arg buildoptRevision "${buildopt_revision}" \
                --arg executableSha256 "${buildopt_executable_sha}" \
                --arg rawResult "${buildopt_key}/result.json" \
                --arg rawResultSha256 "${buildopt_raw_sha}" \
                --arg stateTreeSha256 "${buildopt_state_sha}" \
                --arg captureProtocol "${buildopt_protocol}" \
                --argjson processExitCode "${buildopt_status}" \
                --slurpfile invocations "${buildopt_invocation_metadata}" \
                --slurpfile result "${buildopt_subject_output}/result.json" '
              ($result[0]) as $r |
              {schemaVersion:("buildopt.evidence/automatic-breadth-subject/" + $captureProtocol),
               key:$key,repositoryId:$repositoryId,baseRevision:$baseRevision,
               targetRevision:$targetRevision,buildopt:{revision:$buildoptRevision,
               executableSha256:$executableSha256},processExitCode:$processExitCode,
               resultAvailable:true,productFailure:($processExitCode != 0),
               rawResult:$rawResult,rawResultSha256:$rawResultSha256,
               stateTreeSha256:(if $stateTreeSha256 == "null" then null else $stateTreeSha256 end),
               ordinaryInvocations:($invocations | length),measurementOnlyWorkflowRuns:0,
               cleanWorkspaceBeforeEveryInvocation:true,invocationResults:$invocations,
               outcome:$r.outcome,reason:$r.reason,durationMs:$r.durationMs,
               manualFilesRequired:$r.manualFilesRequired,native:$r.native,
               execution:$r.execution,discovery:$r.discovery,
               incrementalLearning:$r.incrementalLearning,
               prequalification:$r.prequalification,calibration:$r.calibration,
               portfolio:$r.portfolio,selection:$r.selection,value:$r.value,
               productionAuthorized:$r.productionAuthorized,
               testOptimization:$r.testOptimization}
            ' >"${buildopt_subject_output}/capture.json"
            if [[ ${buildopt_protocol} == v4 ]]; then
                buildopt_portfolio_preflight_sha=
                buildopt_portfolio_preflight_json=null
                if [[ -s ${buildopt_subject_output}/portfolio-preflight.json ]]; then
                    buildopt_portfolio_preflight_sha=$(sha256sum \
                        "${buildopt_subject_output}/portfolio-preflight.json" | awk '{print $1}')
                    buildopt_portfolio_preflight_json=$(jq -c . \
                        "${buildopt_subject_output}/portfolio-preflight.json")
                fi
                if [[ ${buildopt_portfolio_preflight_json} != null &&
                    $(jq -r '.decision' "${buildopt_subject_output}/portfolio-preflight.json") == \
                        NATIVE_RETAINED ]]; then
                    jq --arg preflightFile "${buildopt_key}/portfolio-preflight.json" \
                        --arg preflightSha256 "${buildopt_portfolio_preflight_sha}" \
                        --argjson preflight "${buildopt_portfolio_preflight_json}" '
                      . + {nativeVolatility:{
                        resultFile:$preflightFile,resultSha256:$preflightSha256,
                        preflightFile:$preflightFile,preflightSha256:$preflightSha256,
                        preflightDecision:$preflight.decision,
                        secondObservationFile:null,secondObservationSha256:null,
                        independentNativeObservationAuthorized:
                          $preflight.independentNativeObservationAuthorized,
                        independentNativeObservationStarted:false,
                        comparedOutputCount:0,volatilePaths:[],quarantinedProducers:[],
                        quarantinedOutputCount:0,transportedOutputCount:0,
                        decision:$preflight.decision,reason:$preflight.reason,
                        portfolioApplied:false,portfolioDecision:$preflight.decision,
                        portfolioReason:$preflight.reason,
                        contextDriftedBindings:$preflight.driftedBindings}}
                    ' "${buildopt_subject_output}/capture.json" \
                        >"${buildopt_subject_output}/capture.tmp"
                else
                    buildopt_quarantine_sha=$(sha256sum \
                        "${buildopt_subject_output}/quarantine-result.json" | awk '{print $1}')
                    buildopt_native_observation_sha=$(sha256sum \
                        "${buildopt_subject_output}/native-second.json" | awk '{print $1}')
                    jq --arg quarantineFile "${buildopt_key}/quarantine-result.json" \
                        --arg quarantineSha256 "${buildopt_quarantine_sha}" \
                        --arg nativeObservationFile "${buildopt_key}/native-second.json" \
                        --arg nativeObservationSha256 "${buildopt_native_observation_sha}" \
                        --arg preflightFile "${buildopt_key}/portfolio-preflight.json" \
                        --arg preflightSha256 "${buildopt_portfolio_preflight_sha}" \
                        --argjson preflight "${buildopt_portfolio_preflight_json}" \
                        --slurpfile quarantine "${buildopt_subject_output}/quarantine-result.json" '
                  ($quarantine[0]) as $evidence |
                  (if ($evidence.schemaVersion ==
                    "buildopt.poc/optimize-native-volatility-portfolio-evidence/v1" or
                    $evidence.schemaVersion ==
                    "buildopt.poc/optimize-native-volatility-portfolio-retention/v1")
                   then $evidence.current else $evidence end) as $current |
                  (if $evidence.schemaVersion ==
                    "buildopt.poc/optimize-native-volatility-portfolio-evidence/v1"
                   then $evidence.application else null end) as $application |
                  (if $evidence.schemaVersion ==
                    "buildopt.poc/optimize-native-volatility-portfolio-retention/v1"
                   then $evidence else null end) as $retention |
                  . + {nativeVolatility:{
                    resultFile:$quarantineFile,resultSha256:$quarantineSha256,
                    preflightFile:(if $preflight == null then null else $preflightFile end),
                    preflightSha256:
                      (if $preflight == null then null else $preflightSha256 end),
                    preflightDecision:
                      (if $preflight == null then null else $preflight.decision end),
                    secondObservationFile:$nativeObservationFile,
                    secondObservationSha256:$nativeObservationSha256,
                    independentNativeObservationAuthorized:
                      (if $preflight == null then true
                       else $preflight.independentNativeObservationAuthorized end),
                    independentNativeObservationStarted:true,
                    comparedOutputCount:$current.comparedOutputCount,
                    volatilePaths:$current.volatilePaths,
                    quarantinedProducers:
                      (if $application == null then $current.quarantinedProducers
                       else $application.effectiveQuarantinedProducers end),
                    quarantinedOutputCount:
                      ((if $application == null then $current.quarantinedOutputs
                        else $application.quarantinedOutputs end) | length),
                    transportedOutputCount:
                      ((if $application == null then $current.transportedOutputs
                        else $application.transportedOutputs end) | length),
                    decision:(if $retention == null then $current.decision
                      else $retention.decision end),
                    reason:(if $retention == null then $current.reason
                      else $retention.reason end),
                    portfolioApplied:($application != null),
                    portfolioDecision:
                      (if $application != null then $application.decision
                       elif $retention != null then $retention.decision else null end),
                    portfolioReason:
                      (if $retention == null then null else $retention.reason end),
                    contextDriftedBindings:
                      (if $retention == null then [] else $retention.driftedBindings end),
                    missingPortfolioProducers:
                      (if $retention == null then [] else $retention.missingProducers end)}}
                ' "${buildopt_subject_output}/capture.json" \
                    >"${buildopt_subject_output}/capture.tmp"
                fi
                mv -- "${buildopt_subject_output}/capture.tmp" \
                    "${buildopt_subject_output}/capture.json"
            fi
        fi
    fi

    (
        cd -- "${buildopt_repository}"
        env GRADLE_USER_HOME="${buildopt_gradle_home}" \
            "${buildopt_script_dir}/run" --toolchain "${buildopt_jdk}" -- ./gradlew --stop
    ) >/dev/null 2>&1 || true
    if [[ ${buildopt_retain_root} != true ]]; then
        buildopt_subject_root="${buildopt_root:?}/${buildopt_key}"
        for buildopt_cleanup_attempt in 1 2 3 4 5; do
            rm -rf -- "${buildopt_subject_root}" 2>/dev/null || true
            [[ ! -e ${buildopt_subject_root} ]] && break
            ((buildopt_cleanup_attempt < 5)) && sleep 1
        done
        [[ ! -e ${buildopt_subject_root} ]] || {
            printf 'automatic breadth temporary state remained after daemon stop: %s\n' \
                "${buildopt_key}" >&2
            return 1
        }
    fi
    printf 'Captured %s (exit %d)\n' "${buildopt_repository_id}" "${buildopt_status}"
}

for ((buildopt_index = 0; buildopt_index < buildopt_subject_count; buildopt_index++)); do
    buildopt_key=$(jq -er ".repositories[${buildopt_index}].key" "${buildopt_subjects}")
    if [[ -n ${buildopt_subject_filter} && ${buildopt_key} != "${buildopt_subject_filter}" ]]; then
        continue
    fi
    buildopt_capture_subject "${buildopt_index}"
done

buildopt_completed=0
buildopt_capture_files=()
while IFS= read -r buildopt_key; do
    if [[ -s ${buildopt_output}/${buildopt_key}/capture.json ]]; then
        buildopt_capture_files+=("${buildopt_output}/${buildopt_key}/capture.json")
        buildopt_completed=$((buildopt_completed + 1))
    fi
done < <(
    jq -r --arg key "${buildopt_subject_filter}" '
      .repositories[] | select($key == "" or .key == $key) | .key
    ' "${buildopt_subjects}"
)

if ((buildopt_completed != buildopt_expected_subject_count)); then
    printf 'Automatic breadth subjects captured: %d/%d\n' \
        "${buildopt_completed}" "${buildopt_expected_subject_count}"
    exit 0
fi

if [[ ${buildopt_protocol} == v1 ]]; then
    jq -s \
        --arg capturedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg buildoptRevision "${buildopt_revision}" \
        --arg executableSha256 "${buildopt_executable_sha}" '
      {
        schemaVersion:"buildopt.evidence/poc-automatic-breadth-transfer/v1",
        workItem:"POC-AUTOMATIC-BREADTH-TRANSFER-001",capturedAt:$capturedAt,
        buildopt:{revision:$buildoptRevision,executableSha256:$executableSha256,
          packageVersion:"0.3.0-dev"},subjects:.,
        aggregation:{subjectCount:length,
          resultAvailable:(map(select(.resultAvailable))|length),
          discoveryComplete:(map(select(.discovery.status == "COMPLETE"))|length),
          calibrationComplete:(map(select(.calibration.status == "COMPLETE"))|length),
          valueGatePassed:(map(select(.calibration.valueGatePassed == true))|length),
          economicallyQualified:(map(select(.calibration.qualified == true))|length),
          nativeRetained:(map(select(.outcome == "NATIVE_RETAINED"))|length),
          productFailures:(map(select(.productFailure))|length),
          repositoryPercentagesAveraged:false,mechanismPercentagesAdded:false},
        boundaries:{proofOfConcept:true,productionAuthorized:false,
          automaticActivationOutsideOwnerCommand:false,soakRequired:false,
          designPartnerRequired:false,testOptimization:"OUT_OF_SCOPE"}
      }
    ' "${buildopt_capture_files[@]}" >"${buildopt_output}/summary.json"
elif [[ ${buildopt_protocol} == v2 ]]; then
    jq -s \
        --arg capturedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg buildoptRevision "${buildopt_revision}" \
        --arg executableSha256 "${buildopt_executable_sha}" \
        --arg packageVersion "${buildopt_package_version}" '
      {
        schemaVersion:"buildopt.evidence/poc-automatic-breadth-transfer/v2",
        workItem:"POC-AUTOMATIC-BREADTH-TRANSFER-V2-001",capturedAt:$capturedAt,
        buildopt:{revision:$buildoptRevision,executableSha256:$executableSha256,
          packageVersion:$packageVersion},subjects:.,
        aggregation:{subjectCount:length,
          resultAvailable:(map(select(.resultAvailable))|length),
          discoveryComplete:(map(select(.discovery.status == "COMPLETE"))|length),
          incrementalComplete:(map(select(.incrementalLearning.status == "COMPLETE"))|length),
          calibrationComplete:(map(select(.calibration.status == "COMPLETE"))|length),
          valueGatePassed:(map(select(.calibration.valueGatePassed == true))|length),
          economicallyQualified:(map(select(.calibration.qualified == true))|length),
          nativeRetained:(map(select(.outcome == "NATIVE_RETAINED"))|length),
          ordinaryInvocations:(map(.ordinaryInvocations // 0)|add),
          measurementOnlyWorkflowRuns:(map(.measurementOnlyWorkflowRuns // 0)|add),
          aggregatePartitionsComplete:
            (map(select(.discovery.aggregatePartition.status == "COMPLETE"))|length),
          materializationsCaptured:
            (map(select(.discovery.materialization.status == "CAPTURED"))|length),
          productFailures:(map(select(.productFailure))|length),
          repositoryPercentagesAveraged:false,mechanismPercentagesAdded:false},
        boundaries:{proofOfConcept:true,productionAuthorized:false,
          automaticActivationOutsideOwnerCommand:false,soakRequired:false,
          designPartnerRequired:false,testOptimization:"OUT_OF_SCOPE"}
      }
    ' "${buildopt_capture_files[@]}" >"${buildopt_output}/summary.json"
elif [[ ${buildopt_protocol} == v3 ]]; then
    jq -s \
        --arg capturedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg buildoptRevision "${buildopt_revision}" \
        --arg executableSha256 "${buildopt_executable_sha}" \
        --arg packageVersion "${buildopt_package_version}" '
      {
        schemaVersion:"buildopt.evidence/poc-materialization-economics/v2",
        workItem:"POC-MATERIALIZATION-ECONOMICS-V2-001",capturedAt:$capturedAt,
        buildopt:{revision:$buildoptRevision,executableSha256:$executableSha256,
          packageVersion:$packageVersion},subjects:.,
        aggregation:{subjectCount:length,
          resultAvailable:(map(select(.resultAvailable))|length),
          discoveryComplete:(map(select(.discovery.status == "COMPLETE"))|length),
          incrementalComplete:(map(select(.incrementalLearning.status == "COMPLETE"))|length),
          calibrationComplete:(map(select(.calibration.status == "COMPLETE"))|length),
          valueGatePassed:(map(select(.calibration.valueGatePassed == true))|length),
          economicallyQualified:(map(select(.calibration.qualified == true))|length),
          nativeRetained:(map(select(.outcome == "NATIVE_RETAINED"))|length),
          ordinaryInvocations:(map(.ordinaryInvocations // 0)|add),
          measurementOnlyWorkflowRuns:(map(.measurementOnlyWorkflowRuns // 0)|add),
          aggregatePartitionsComplete:
            (map(select(.discovery.aggregatePartition.status == "COMPLETE"))|length),
          materializationsCaptured:
            (map(select(.discovery.materialization.status == "CAPTURED"))|length),
          economicsComplete:
            (map(select([.incrementalLearning.baseline,.incrementalLearning.observations[]] |
              all(.economics != null)))|length),
          productFailures:(map(select(.productFailure))|length),
          repositoryPercentagesAveraged:false,mechanismPercentagesAdded:false},
        boundaries:{proofOfConcept:true,productionAuthorized:false,
          automaticActivationOutsideOwnerCommand:false,soakRequired:false,
          designPartnerRequired:false,testOptimization:"OUT_OF_SCOPE"}
      }
    ' "${buildopt_capture_files[@]}" >"${buildopt_output}/summary.json"
else
    jq -s \
        --arg capturedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg buildoptRevision "${buildopt_revision}" \
        --arg executableSha256 "${buildopt_executable_sha}" \
        --arg packageVersion "${buildopt_package_version}" '
      {
        schemaVersion:"buildopt.evidence/poc-producer-bound-quarantine-replay/v1",
        workItem:"POC-PRODUCER-BOUND-QUARANTINE-REPLAY-001",capturedAt:$capturedAt,
        buildopt:{revision:$buildoptRevision,executableSha256:$executableSha256,
          packageVersion:$packageVersion},subjects:.,
        aggregation:{subjectCount:length,
          resultAvailable:(map(select(.resultAvailable))|length),
          discoveryComplete:(map(select(.discovery.status == "COMPLETE"))|length),
          quarantineApplied:(map(select(.nativeVolatility?.decision == "TRANSPORT_READY"))|length),
          portfolioContextRetained:
            (map(select(.nativeVolatility?.reason == "PORTFOLIO_CONTEXT_DRIFT"))|length),
          incrementalComplete:(map(select(.incrementalLearning.status == "COMPLETE"))|length),
          calibrationComplete:(map(select(.calibration.status == "COMPLETE"))|length),
          valueGatePassed:(map(select(.calibration.valueGatePassed == true))|length),
          economicallyQualified:(map(select(.calibration.qualified == true))|length),
          ordinaryInvocations:(map(.ordinaryInvocations // 0)|add),
          exactStableOutputPairs:
            (map((.incrementalLearning.observations // []) |
              map(select(.requiredOutputSha256 != "")) | length) | add),
          productFailures:(map(select(.productFailure))|length),
          repositoryPercentagesAveraged:false,mechanismPercentagesAdded:false},
        decision:(if all(.productFailure == false and
          .nativeVolatility?.decision == "TRANSPORT_READY" and
          .incrementalLearning?.status == "COMPLETE") then
          (if all(.calibration.qualified == true) then "QUARANTINED_PROFILE_QUALIFIED"
           else "QUARANTINED_PROFILE_VALUE_NOT_PROVEN" end)
          else "QUARANTINED_QUALIFICATION_INCOMPLETE" end),
        boundaries:{proofOfConcept:true,productionAuthorized:false,
          repositorySpecificProductRules:false,automaticActivationOutsideOwnerCommand:false,
          soakRequired:false,designPartnerRequired:false,testOptimization:"OUT_OF_SCOPE"}
      }
    ' "${buildopt_capture_files[@]}" >"${buildopt_output}/summary.json"
fi

printf 'Automatic breadth transfer evidence written to %s\n' "${buildopt_output}"
if [[ ${buildopt_retain_root} == true ]]; then
    printf 'Automatic breadth runtime retained at %s\n' "${buildopt_root}"
fi
