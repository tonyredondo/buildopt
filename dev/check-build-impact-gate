#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_contract="${buildopt_repo_root}/specs/build-impact-gate-v1.json"

for buildopt_command in git jq; do
    if ! command -v "${buildopt_command}" >/dev/null 2>&1; then
        printf 'required Build Impact gate command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    fi
done

if ! jq -e '
    .schemaVersion == "buildopt.specs/build-impact-gate/v1" and
    .gateId == "C3-G01" and
    .milestone == "MVP-C3" and
    .execution == "CURRENT_SOURCE_TREE_COMPOSITE" and
    .constituents == [
        {
            item: "C3-001",
            command: "./dev/check-build-impact-manifest",
            proof: "CUSTOMER_MANIFEST_AUTHORITY"
        },
        {
            item: "C3-002",
            command: "./dev/check-build-impact-declared-graph",
            proof: "CONSERVATIVE_DECLARED_GRAPH"
        },
        {
            item: "C3-003",
            command: "./dev/check-build-impact-shadow-validation",
            proof: "FULL_SHADOW_AND_PAIRED_CONTROL"
        },
        {
            item: "C3-004",
            command: "./dev/check-build-impact-promotion-gate",
            proof: "UNCHANGED_BIA_002_AND_SUSPENSION"
        },
        {
            item: "C3-005",
            command: "./dev/check-build-impact-selection",
            proof: "PROMOTED_ONLY_SYNTHETIC_SELECTION"
        }
    ] and
    .criteria == {
        omissionAuthority: "CUSTOMER_MANIFEST_PLUS_CURRENT_DECLARED_GRAPH",
        historyAuthority: "NEVER",
        globalOrUnknown: "FULL_GRAPH",
        testOptimization: "PRESERVED_SEPARATELY_NEVER_SELECTED",
        discrepancy: "SUSPEND",
        beforeBIA002: "FULL_GRAPH",
        currentCheckedInEvidence: "INCONCLUSIVE",
        syntheticQualifiedProof: "BYTE_IDENTICAL_REQUIRED_OUTPUTS"
    } and
    .boundaries == {
        closes: ["C3-G01", "MVP-C3"],
        doesNotClose: [
            "TEST_SELECTION",
            "EIGHT_HOUR_SOAK",
            "EXTERNAL_DESIGN_PARTNER_VALIDATION",
            "PRODUCTION_PROMOTION",
            "PRODUCTION_READINESS"
        ],
        ownerOperatedProofOfConcept: true
    }
' "${buildopt_contract}" >/dev/null; then
    printf 'Build Impact gate contract is malformed\n' >&2
    exit 1
fi

buildopt_before_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)
for buildopt_checker in \
    check-build-impact-manifest \
    check-build-impact-declared-graph \
    check-build-impact-shadow-validation \
    check-build-impact-promotion-gate \
    check-build-impact-selection; do
    if [[ ! -x "${buildopt_script_dir}/${buildopt_checker}" ]]; then
        printf 'Build Impact constituent is unavailable: %s\n' \
            "${buildopt_checker}" >&2
        exit 1
    fi
    "${buildopt_script_dir}/${buildopt_checker}"
done

buildopt_after_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)
if [[ "${buildopt_after_status}" != "${buildopt_before_status}" ]]; then
    printf 'Build Impact gate changed the source tree\n' >&2
    exit 1
fi

printf 'C3-G01 Build Impact gate passed: C3-001..005 current-tree proofs complete\n'
