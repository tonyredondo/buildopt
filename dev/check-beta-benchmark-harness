#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_contract="${buildopt_repo_root}/specs/beta-benchmark-harness-v1.json"

if ! command -v jq >/dev/null 2>&1; then
    printf 'jq is required to validate the benchmark harness contract\n' >&2
    exit 1
fi
if ! jq -e '
    keys == [
        "boundaries",
        "commands",
        "execution",
        "gateId",
        "manifest",
        "schemaVersion",
        "smoke"
    ] and
    .schemaVersion == "buildopt.specs/beta-benchmark-harness/v1" and
    .gateId == "OPS-001/A1" and
    .manifest == "benchmarks/beta-v1.yaml" and
    .commands == {
        smoke: "beta-benchmark smoke --manifest PATH --state-dir ABSOLUTE_PATH --output-dir ABSOLUTE_PATH",
        validate: "beta-benchmark validate --manifest PATH --result PATH"
    } and
    .smoke == {
        qualification: "SMOKE",
        clients: [1, 8, 32],
        phases: ["COLD", "WARM_70", "SUSTAINED", "SOAK"],
        operationsPerStratum: 100,
        strata: 12,
        rawObservations: 1200,
        scaledSizesBytes: [4096, 65536, 524288, 1048576],
        percentages: [70, 20, 8, 2],
        warmHitPercent: 70
    } and
    .execution == {
        transport: "REAL_LOOPBACK_HTTP",
        storage: "REAL_SINGLE_NODE_SHARED",
        coldPublication: "PENDING_THEN_ED25519_COMMIT",
        readVerification: "STATUS_AND_COMPLETE_BODY_LENGTH",
        rawFormat: "PRIVATE_JSONL",
        summaryFormat: "PRIVATE_JSON",
        manifestDigestBound: true,
        rawDigestBound: true,
        unknownFieldsRejected: true,
        tamperRejected: true
    } and
    .boundaries == {
        closes: ["OPS-001/A1-BENCHMARK-HARNESS-SMOKE"],
        doesNotClose: [
            "OPS-001/A1",
            "BENCHMARK_FULL_PROFILE",
            "FAULT_MATRIX",
            "EIGHT_HOUR_SOAK",
            "GOLDEN_LANE_RESULT"
        ]
    }
' "${buildopt_contract}" >/dev/null; then
    printf 'benchmark harness contract is malformed\n' >&2
    exit 1
fi

buildopt_before_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)

"${buildopt_script_dir}/check-beta-benchmark"
"${buildopt_script_dir}/run" --toolchain go -- \
    go test -count=1 -race \
    ./internal/betabenchmark \
    ./cmd/beta-benchmark
"${buildopt_script_dir}/run" --toolchain go -- \
    go vet ./internal/betabenchmark ./cmd/beta-benchmark

buildopt_after_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)
if [[ "${buildopt_after_status}" != "${buildopt_before_status}" ]]; then
    printf 'benchmark harness checker changed the working tree\n' >&2
    exit 1
fi

printf 'OPS-001/A1 benchmark harness smoke OK: 12 real-HTTP strata, 1200 raw observations, exact summary, and tamper rejection\n'
