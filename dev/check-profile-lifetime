#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [result.json]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_contract=${buildopt_root}/specs/poc-profile-lifetime-v1.json
buildopt_result=${1:-${buildopt_root}/benchmarks/results/poc-profile-lifetime-v1/summary.json}

for buildopt_command in jq awk; do
    command -v "${buildopt_command}" >/dev/null || {
        printf '%s is required to validate profile lifetime evidence\n' "${buildopt_command}" >&2
        exit 1
    }
done

jq -e '
  .schemaVersion == "buildopt.poc/profile-lifetime-contract/v1" and
  .workItem == "POC-PROFILE-LIFETIME-001" and
  .subject.repositoryId == "ktorio/ktor" and .subject.publicRepository and
  .subject.qualifyingRevision == "24b8773fcee753314dfb753b3f994a7ef36823ef" and
  .subject.workflow == "jvmJar" and
  .history.firstParentCommitsIncludingQualification == 6 and
  .history.matchingRevisions == [
    "eb60b722d1ef1fbfeba8708a7d594fd4083a2aec"
  ] and
  .history.notApplicableRevision == "c237e88696debef1ba860a947cfaad3a0b7cb49b" and
  .history.buildLogicInvalidationRevision == "835d7f9ff09caf794e9f058d97ad3690d52f960a" and
  .protocol == {
    calibrationPairs:8,gradleDaemon:false,gradleHeapMaxMiB:2048,
    kotlinDaemonHeapMaxMiB:1536,maximumBreakEvenBuilds:50,maximumWorkers:8,
    persistentArmsAcrossCommits:true,sameCommittedCentralObjects:true,
    sameStartingCacheState:true,alternatingArmOrder:true,
    unmeasuredDependencyWarmup:true,transport:"HTTPS_TLS_1_3_MINIMUM"
  } and
  .acceptance == {
    exactRequiredOutputsEveryRevision:true,matchingProfileSelections:1,
    nativeRetainedNotApplicableCases:1,nativeRetainedBuildLogicCases:1,
    observedCumulativeEconomicsRequired:true,positiveNetSavingRequired:false
  } and
  .boundaries == {
    designPartnerRequired:false,productionAuthorized:false,proofOfConcept:true,
    repositoriesAveraged:false,soakRequired:false,testOptimization:"OUT_OF_SCOPE"
  }
' "${buildopt_contract}" >/dev/null

jq -e --slurpfile contract "${buildopt_contract}" '
  .schemaVersion == "buildopt.evidence/poc-profile-lifetime/v1" and
  .workItem == "POC-PROFILE-LIFETIME-001" and
  (.buildopt.revision | test("^[0-9a-f]{40}$")) and
  (.buildopt.packageSha256 | test("^[0-9a-f]{64}$")) and
  .runner.operatingSystem == "Linux" and .runner.architecture == "x86_64" and
  .runner.cpuCount >= 4 and .runner.memoryBytes >= 8000000000 and
  .repository.id == $contract[0].subject.repositoryId and
  .repository.remote == $contract[0].subject.remote and .repository.publicRepository and
  .protocol == $contract[0].protocol and
  .history == {firstParentCommitsIncludingQualification:6,
    observedCommitsIncludingQualification:4,unobservedInterveningCommits:2} and
  .qualification.targetRevision == $contract[0].subject.qualifyingRevision and
  (.qualification.baseRevision | test("^[0-9a-f]{40}$")) and
  .qualification.family == "DEPENDENCY_SOURCE" and
  .qualification.changedProjects == [":ktor-client-jetty-jakarta"] and
  .qualification.calibration.pairsMeasured == 8 and
  .qualification.calibration.qualified and .qualification.calibration.valueGatePassed and
  .qualification.calibration.calibrationCostMs > 0 and
  .qualification.graph.totalProjects > .qualification.graph.selectedProjects and
  .qualification.graph.selectedProjects > 0 and
  (.observations | length) == 3 and
  ([.observations[] | select(.classification == "MATCHING_REPLAY") | .targetRevision] ==
    $contract[0].history.matchingRevisions) and
  ([.observations[] | select(.classification == "NOT_APPLICABLE") | .targetRevision] ==
    [$contract[0].history.notApplicableRevision]) and
  ([.observations[] | select(.classification == "BUILD_LOGIC_INVALIDATION") | .targetRevision] ==
    [$contract[0].history.buildLogicInvalidationRevision]) and
  ([.observations[].order] == ["CONTROL_FIRST","CANDIDATE_FIRST","CONTROL_FIRST"]) and
  all(.observations[];
    (.parentRevision | test("^[0-9a-f]{40}$")) and
    .controlDurationMs > 0 and .candidateDurationMs > 0 and
    .savedMs == (.controlDurationMs - .candidateDurationMs) and
    .requiredOutputCount >= 1 and
    (.controlRequiredOutputSha256 | test("^[0-9a-f]{64}$")) and
    .controlRequiredOutputSha256 == .candidateRequiredOutputSha256 and
    .centralCacheAvailable and .performanceClaim == (.classification == "MATCHING_REPLAY")
  ) and
  all(.observations[] | select(.classification == "MATCHING_REPLAY");
    .candidateSelected and .selectionSource == "CENTRAL_PORTFOLIO" and
    .candidateFamily == "DEPENDENCY_SOURCE" and
    .candidateChangedProjects == [":ktor-client-jetty-jakarta"] and
    .evidenceRevision == $contract[0].subject.qualifyingRevision
  ) and
  all(.observations[] | select(.classification == "NOT_APPLICABLE");
    (.candidateSelected | not) and .candidateFamily == "DEPENDENCY_SOURCE" and
    .candidateChangedProjects == [":ktor-server-cors"] and
    .candidateReason == "REMOTE_PROFILE_STRUCTURAL_DRIFT"
  ) and
  all(.observations[] | select(.classification == "BUILD_LOGIC_INVALIDATION");
    (.candidateSelected | not) and .candidateReason == "GLOBAL_CHANGE_REQUIRES_FULL_GRAPH"
  ) and
  .economics.observedBuilds == 3 and .economics.matchingReplays == 1 and
  .economics.grossMatchingSavedMs ==
    ([.observations[] | select(.classification == "MATCHING_REPLAY") | .savedMs] | add) and
  .economics.fallbackDeltaMs ==
    ([.observations[] | select(.classification != "MATCHING_REPLAY") | .savedMs] | add) and
  .economics.cumulativeGrossSavedMs == ([.observations[].savedMs] | add) and
  .economics.cumulativeNetSavedMs ==
    (.economics.cumulativeGrossSavedMs - .qualification.calibration.calibrationCostMs) and
  .economics.conclusion ==
    (if .economics.cumulativeNetSavedMs >= 0 then "PAID_BACK_IN_OBSERVED_WINDOW"
     else "NOT_PAID_BACK_IN_OBSERVED_WINDOW" end) and
  .acceptance == {
    decision:"COMPLETE",buildLogicInvalidations:1,exactRequiredOutputs:true,
    matchingSelections:1,nativeRetainedCases:2,publicAncestry:true,
    syntheticCommits:false
  } and
  .boundaries == {
    designPartnerRequired:false,mechanismPercentagesAdded:false,
    productionAuthorized:false,proofOfConcept:true,repositoriesAveraged:false,
    soakRequired:false,testOptimization:"OUT_OF_SCOPE"
  }
' "${buildopt_result}" >/dev/null

buildopt_first_break_even=$(jq -r '.economics.firstObservedBreakEvenBuild // 0' "${buildopt_result}")
if ((buildopt_first_break_even > 0)); then
    buildopt_recomputed=$(jq -r '.qualification.calibration.calibrationCostMs as $cost |
      reduce .observations[] as $observation
        ({sum:0,index:0,answer:0};
         .index += 1 | .sum += $observation.savedMs |
         if .answer == 0 and .sum >= $cost then .answer = .index else . end) | .answer' \
        "${buildopt_result}")
    [[ ${buildopt_recomputed} == "${buildopt_first_break_even}" ]] || {
        printf 'profile lifetime break-even index does not recompute\n' >&2
        exit 1
    }
fi

printf 'Profile lifetime evidence OK: 1 matching replay, 2 safe native-retained cases\n'
