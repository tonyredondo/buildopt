#!/usr/bin/env bash
set -euo pipefail
umask 077

if (($# > 1)); then
    printf 'usage: %s [OUTPUT_JSON]\n' "$0" >&2
    exit 64
fi

buildopt_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
buildopt_gate=${buildopt_root}/benchmarks/results/observed-request-portfolio-breadth-gate-v1.json
buildopt_output=${1:-${buildopt_root}/benchmarks/results/observed-request-portfolio-terminal-decision-v1.json}
[[ ${buildopt_output} == /* ]] || buildopt_output=${PWD}/${buildopt_output}

for buildopt_command in awk jq mktemp sha256sum; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf '%s is required\n' "${buildopt_command}" >&2
        exit 1
    }
done

"${buildopt_root}/dev/check-observed-request-portfolio-breadth-gate" "${buildopt_gate}" >/dev/null

buildopt_temporary=$(mktemp -d /tmp/buildopt-observed-portfolio-terminal-run.XXXXXX)
buildopt_cleanup() {
    case ${buildopt_temporary} in
        /tmp/buildopt-observed-portfolio-terminal-run.*) rm -rf -- "${buildopt_temporary}" ;;
        *) printf 'refusing to clean unexpected terminal-run root: %s\n' "${buildopt_temporary}" >&2; return 1 ;;
    esac
}
trap buildopt_cleanup EXIT

# This policy is deliberately independent of the mutable tracker lifecycle.
# Its canonical digest lets the scorecard prove that none of the preregistered
# thresholds moved when the terminal decision was produced.
jq -cS -n '
  {
    completeInputFamiliesRequired:5,
    relevantTransitionsPerFamilyRequired:5,
    familiesExposingExactActionsRequired:3,
    productFailureBudget:0,
    timingAuthorizedBeforeBreadth:false,
    activationAuthorizedBeforeValue:false,
    requiredTerminalCriteria:[
      "FRESH_CAPTURE_CORRECTNESS",
      "FRESH_INPUT_COMPLETENESS",
      "PUBLIC_ACTION_BREADTH",
      "INSTALLED_ACTIVE_VALUE",
      "CHRONOLOGICAL_CUMULATIVE_VALUE",
      "POSITIVE_FAMILY_CONFIDENCE",
      "PAYBACK",
      "NATIVE_RETENTION_OVERHEAD",
      "PRODUCT_AND_BUILD_FAILURES",
      "THRESHOLD_IMMUTABILITY"
    ]
  }
' >"${buildopt_temporary}/policy.json"

buildopt_gate_sha=$(sha256sum "${buildopt_gate}" | awk '{print $1}')
buildopt_policy_sha=$(sha256sum "${buildopt_temporary}/policy.json" | awk '{print $1}')
buildopt_generated_at=$(jq -r '.generatedAt' "${buildopt_gate}")

jq -n \
    --arg generatedAt "${buildopt_generated_at}" \
    --arg gateSha "${buildopt_gate_sha}" \
    --arg policySha "${buildopt_policy_sha}" \
    --slurpfile gate "${buildopt_gate}" \
    --slurpfile policy "${buildopt_temporary}/policy.json" '
  {
    schemaVersion:"buildopt.poc/observed-request-portfolio-terminal-decision/v1",
    workItem:"SWL-PORTFOLIO-007",
    generatedAt:$generatedAt,
    evidence:{
      breadthGateSha256:$gateSha,
      decisionPolicySha256:$policySha,
      decisionInput:"INDEPENDENT_FRESH_BREADTH_GATE_ONLY",
      routeContractConsumedForDecision:false,
      historicalTimingImported:false,
      historicalActionImported:false
    },
    decisionPolicy:$policy[0],
    executedBlocks:["SWL-PORTFOLIO-000","SWL-PORTFOLIO-001","SWL-PORTFOLIO-002",
      "SWL-PORTFOLIO-003","SWL-PORTFOLIO-004","SWL-PORTFOLIO-007"],
    notAuthorizedBlocks:["SWL-PORTFOLIO-005","SWL-PORTFOLIO-006"],
    scorecard:[
      {criterion:"FRESH_CAPTURE_CORRECTNESS",status:"PASS",evidence:
        (($gate[0].observationsVerified|tostring)+"_OBSERVATIONS_"+
         ($gate[0].transitionRowsReconstructed|tostring)+"_TRANSITIONS_"+
         ($gate[0].reportsRegenerated|tostring)+"_REPORTS_"+
         ($gate[0].typedInputUnavailableRows|tostring)+"_TYPED_UNAVAILABLE")},
      {criterion:"FRESH_INPUT_COMPLETENESS",status:"FAIL",evidence:
        (($gate[0].completeInputFamilies|tostring)+"_OF_5_VERSUS_REQUIRED_"+
         ($gate[0].completeInputFamiliesRequired|tostring)+"_OF_5")},
      {criterion:"PUBLIC_ACTION_BREADTH",status:"PASS",evidence:
        (($gate[0].familiesExposingExactActions|tostring)+"_OF_5_VERSUS_REQUIRED_"+
         ($gate[0].familiesExposingExactActionsRequired|tostring)+"_OF_5")},
      {criterion:"INSTALLED_ACTIVE_VALUE",status:"NOT_MEASURED_NOT_AUTHORIZED"},
      {criterion:"CHRONOLOGICAL_CUMULATIVE_VALUE",status:"NOT_MEASURED_NOT_AUTHORIZED"},
      {criterion:"POSITIVE_FAMILY_CONFIDENCE",status:"NOT_MEASURED_NOT_AUTHORIZED"},
      {criterion:"PAYBACK",status:"NOT_MEASURED_NOT_AUTHORIZED"},
      {criterion:"NATIVE_RETENTION_OVERHEAD",status:"NOT_MEASURED_NOT_AUTHORIZED"},
      {criterion:"PRODUCT_AND_BUILD_FAILURES",status:"PASS",evidence:
        (($gate[0].productFailures|tostring)+"_PRODUCT_FAILURES_"+
         ($gate[0].buildFailures|tostring)+"_BUILD_FAILURES")},
      {criterion:"THRESHOLD_IMMUTABILITY",status:"PASS",evidence:"PREREGISTERED_POLICY_DIGEST_BOUND"}
    ],
    exactActionFamilies:[$gate[0].familyAssessments[]|select(.exposesExactAction)|.family],
    timingRows:{status:"NOT_CREATED",reason:"COMPLETE_FAMILY_INPUT_GATE_FAILED_BEFORE_TIMING"},
    actionExecution:{status:"NOT_RUN_NOT_AUTHORIZED"},
    speedupClaim:false,
    decision:"STOP_OBSERVED_RECURRENT_REQUEST_PORTFOLIO_POC_FOR_CURRENT_DETECTOR",
    conclusion:"EXACT_GENERIC_ACTIONS_EXIST_IN_FOUR_FAMILIES_BUT_FRESH_INPUT_COMPLETENESS_IS_INSUFFICIENT_TO_EVALUATE_INSTALLED_OR_CUMULATIVE_CUSTOMER_VALUE",
    nonConclusion:"THIS_DOES_NOT_PROVE_THAT_GRADLE_BUILDS_HAVE_NO_DIFFERENT_GENERIC_OPTIMIZATION_OPPORTUNITY",
    successorAuthorized:false,
    recommendedNextWork:"ANALYZE_TYPED_INPUT_UNAVAILABLE_AND_ZERO_RELEVANCE_CAUSES_BEFORE_THE_USER_SELECTS_A_MATERIALLY_DIFFERENT_HYPOTHESIS"
  }
' >"${buildopt_output}"

printf 'Observed request portfolio terminal decision written to %s\n' "${buildopt_output}"
