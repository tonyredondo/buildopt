#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [contract.json]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_contract=${1:-"${buildopt_repo_root}/specs/poc-magic-onboarding-contract-v1.json"}

[[ -s ${buildopt_contract} ]] || {
    printf 'magic onboarding contract is unavailable: %s\n' "${buildopt_contract}" >&2
    exit 1
}

jq -e '
  keys == [
    "authority", "boundaries", "command", "currentImplementation", "exitBehavior",
    "outcomes", "phases", "result", "schemaVersion", "state", "transitions", "workItem"
  ] and
  .schemaVersion == "buildopt.poc/magic-onboarding-contract/v1" and
  .workItem == "POC-MAGIC-ONBOARDING-CONTRACT-001" and
  .command.name == "buildopt optimize" and
  .command.syntax == "buildopt optimize [options] [--] <gradle args...>" and
  .command.northStar == "buildopt optimize build" and
  .command.manualBuildOptFilesRequired == 0 and
  .command.gradleArgumentBoundary == "FIRST_POSITIONAL_OR_DOUBLE_DASH" and
  .command.options.stateDir == {
    flag: "--state-dir", default: ".buildopt/optimize/v1",
    constraint: "CLEAN_REPOSITORY_RELATIVE_UNDER_DOT_BUILDOPT"
  } and
  .command.options.resume == {flag: "--resume", default: "AUTO", values: ["AUTO", "NEVER"]} and
  .command.options.calibrationBudget == {
    flag: "--calibration-budget", defaultSeconds: 1800,
    minimumExclusiveSeconds: 0, maximumSeconds: 86400
  } and
  .command.options.calibrationPairs == {flag: "--calibration-pairs", default: 8, minimum: 2, maximum: 16} and
  .command.options.maxBreakEvenBuilds == {flag: "--max-break-even-builds", default: 30, minimum: 1, maximum: 1000} and
  .command.options.json == {flag: "--json", stdout: "ONE_OPTIMIZE_RESULT_JSON", gradleConsole: "STDERR"} and
  [.outcomes[].id] == ["QUALIFIED_AND_USED", "LEARNING", "NATIVE_RETAINED"] and
  .phases == ["UNSEEN", "DISCOVERED", "CALIBRATING", "QUALIFIED", "ACTIVE", "NATIVE_RETAINED", "STALE", "RECALIBRATING"] and
  (.transitions | keys) == (.phases | sort) and
  all(.transitions[]; length > 0 and all(.[]; IN($phases[]))) and
  .state.schemaVersion == "buildopt.poc/optimize-state/v1" and
  .state.root == ".buildopt/optimize/v1" and .state.file == "state.json" and
  .state.permissions == "CURRENT_USER_PRIVATE" and .state.maximumBytes == 1048576 and
  .state.rawGradleArgumentsPersisted == false and
  .state.bindingCompleteness == ["CONTRACT_ONLY", "DISCOVERY_COMPLETE", "CALIBRATION_COMPLETE"] and
  .state.exactResumeBindings == [
    "BUILDOPT_EXECUTABLE", "REPOSITORY_SCOPE", "GRADLE_WRAPPER_PROPERTIES",
    "GRADLE_ARGUMENTS", "CALIBRATION_BUDGET"
  ] and
  .state.resumeDecisions == [
    "NO_CHECKPOINT", "EXACT_BINDINGS", "BINDING_DRIFT", "INVALID_CHECKPOINT", "RESUME_DISABLED"
  ] and
  .state.mismatchBehavior == "NEVER_REUSE_AND_RUN_NATIVE" and
  .state.writeBehavior == "ATOMIC_PRIVATE_REPLACE" and
  .result.schemaVersion == "buildopt.poc/optimize-result/v1" and
  .result.file == ".buildopt/optimize/v1/result.json" and
  .result.permissions == "CURRENT_USER_PRIVATE" and
  (.result.alwaysReports | length) == 11 and
  .result.humanOutput == "SHORT_STDERR_SUMMARY" and
  .result.machineOutput == "RESULT_FILE_ALWAYS_AND_STDOUT_WITH_JSON_FLAG" and
  .exitBehavior == {
    invalidUsage: 64, configurationBeforeGradle: 78, cannotExecute: 126, notFound: 127,
    afterGradleStarts: "PRESERVE_GRADLE_EXIT_OR_SIGNAL_STATUS",
    finalReportFailureAfterGradle: "WARN_AND_PRESERVE_GRADLE_EXIT"
  } and
  .authority == {
    proofOfConcept: true,
    automaticSelectionScope: "OWNER_INVOKED_OPTIMIZE_COMMAND_ONLY_AFTER_ALL_GATES",
    productionAuthorized: false, autonomousPromotion: false,
    testOptimization: "OUT_OF_SCOPE"
  } and
  .currentImplementation == {
    status: "CONTRACT_AND_NATIVE_SKELETON", outcome: "NATIVE_RETAINED",
    reason: "AUTO_DISCOVERY_PENDING", phase: "UNSEEN", nativeBuildCache: true,
    automaticDiscovery: false, calibrationPerformed: false, selectionPerformed: false
  } and
  .boundaries == {
    percentagesAveragedAcrossRepositories: false, mechanismPercentagesAdded: false,
    soakRequired: false, designPartnerRequired: false, productionScope: false
  }
' --argjson phases "$(jq '.phases' "${buildopt_contract}")" "${buildopt_contract}" >/dev/null

for buildopt_binding in \
    'optimizeStateSchemaVersion  = "buildopt.poc/optimize-state/v1"' \
    'optimizeResultSchemaVersion = "buildopt.poc/optimize-result/v1"' \
    'optimizeDefaultStateDir     = ".buildopt/optimize/v1"' \
    'optimizeReasonPending       = "AUTO_DISCOVERY_PENDING"' \
    'optimizeDefaultBudget       = 30 * time.Minute' \
    'optimizeDefaultPairs        = 8' \
    'optimizeDefaultBreakEven    = 30'; do
    grep -F "${buildopt_binding}" "${buildopt_repo_root}/internal/launcher/optimize.go" >/dev/null
done

grep -F 'buildopt optimize [options] [--] <gradle args...>' \
    "${buildopt_repo_root}/internal/launcher/run.go" >/dev/null
grep -F 'buildopt optimize build' \
    "${buildopt_repo_root}/specs/poc-magic-onboarding-contract-v1.md" >/dev/null

printf 'Magic onboarding contract OK: one command, zero manual files, exact resume, native skeleton\n'
