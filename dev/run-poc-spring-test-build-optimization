#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)); then
    printf 'usage: %s OUTPUT_FILE\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-spring-test-build-optimization-v1.json"

if [[ "${buildopt_output}" != /* || -e "${buildopt_output}" ]]; then
    printf 'invalid Spring test-build optimization output path\n' >&2
    exit 64
fi
for buildopt_command in awk cmp cp curl date find git grep jq mkdir mktemp \
    sed sha256sum sort tar; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required Spring test-build command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
[[ -x /usr/bin/time ]] || {
    printf 'required Spring test-build command is unavailable: /usr/bin/time\n' >&2
    exit 1
}
if [[ -n "$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)" ]]; then
    printf 'Spring test-build measurement requires a clean revision-bound checkout\n' >&2
    exit 1
fi
"${buildopt_script_dir}/check-poc-spring-test-build-optimization" >/dev/null

buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-spring-test-build.XXXXXX")
buildopt_stop_gradle() {
    local buildopt_checkout=$1
    local buildopt_home=$2
    if [[ -x "${buildopt_checkout}/gradlew" && -d "${buildopt_home}" ]]; then
        (
            cd "${buildopt_checkout}"
            env GRADLE_USER_HOME="${buildopt_home}" \
                "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
                ./gradlew --stop
        ) >/dev/null 2>&1 || true
    fi
}
buildopt_cleanup() {
    if [[ "${buildopt_root}" == "${TMPDIR:-/tmp}/buildopt-spring-test-build."* ]]; then
        buildopt_stop_gradle "${buildopt_root}/source" "${buildopt_root}/preflight-home"
        for buildopt_arm in control candidate; do
            buildopt_stop_gradle "${buildopt_root}/${buildopt_arm}/checkout" \
                "${buildopt_root}/${buildopt_arm}/gradle-home"
        done
        rm -rf -- "${buildopt_root}"
    fi
}
trap buildopt_cleanup EXIT
chmod 0700 "${buildopt_root}"
mkdir -p -- "${buildopt_root}/source" "${buildopt_root}/preflight-home" \
    "${buildopt_root}/logs" "${buildopt_root}/product"
chmod 0700 "${buildopt_root}/preflight-home"

buildopt_revision=$(git -C "${buildopt_repo_root}" rev-parse HEAD)
buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_runner_sha=$(sha256sum "${BASH_SOURCE[0]}" | awk '{print $1}')
(
    cd "${buildopt_repo_root}"
    env GOCACHE="${buildopt_root}/go-cache" \
        "${buildopt_script_dir}/run" --toolchain go -- \
        go build -trimpath -o "${buildopt_root}/product/buildopt" ./cmd/buildopt
    "${buildopt_script_dir}/run" -- ./gradlew --no-daemon \
        :jvm:gradle-plugin:clean :jvm:gradle-plugin:jar >/dev/null
)
buildopt_executable_sha=$(sha256sum "${buildopt_root}/product/buildopt" | awk '{print $1}')
buildopt_plugin_jar=$(find "${buildopt_repo_root}/jvm/gradle-plugin/build/libs" \
    -maxdepth 1 -type f -name 'buildopt-gradle-plugin-*.jar' -print)
[[ -n "${buildopt_plugin_jar}" && "$(printf '%s\n' "${buildopt_plugin_jar}" | wc -l)" == 1 ]] || {
    printf 'expected exactly one BuildOpt Gradle plugin JAR\n' >&2
    exit 1
}
buildopt_plugin_sha=$(sha256sum "${buildopt_plugin_jar}" | awk '{print $1}')
buildopt_init_script="${buildopt_repo_root}/.github/actions/buildopt.init.gradle"
buildopt_init_sha=$(sha256sum "${buildopt_init_script}" | awk '{print $1}')

buildopt_source_archive="${buildopt_root}/spring-framework.tar.gz"
buildopt_source_url=$(jq -er '.repository.sourceArchiveUrl' "${buildopt_spec}")
buildopt_source_sha=$(jq -er '.repository.sourceArchiveSha256' "${buildopt_spec}")
curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
    --output "${buildopt_source_archive}" "${buildopt_source_url}"
[[ "$(sha256sum "${buildopt_source_archive}" | awk '{print $1}')" == \
    "${buildopt_source_sha}" ]] || {
    printf 'Spring source archive checksum mismatch\n' >&2
    exit 1
}
tar -xzf "${buildopt_source_archive}" --strip-components=1 -C "${buildopt_root}/source"

buildopt_common_args=(
    --daemon --build-cache --parallel --no-configuration-cache
    --max-workers=12 --no-scan --stacktrace --console=plain
    :spring-jms:test --tests org.springframework.jms.support.JmsAccessorTests
)
buildopt_preflight_started=$(date +%s%N)
if ! (
    cd "${buildopt_root}/source"
    env -u CI GRADLE_USER_HOME="${buildopt_root}/preflight-home" \
        "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
        ./gradlew "${buildopt_common_args[@]}"
) >"${buildopt_root}/logs/preflight.log" 2>&1; then
    tail -n 180 "${buildopt_root}/logs/preflight.log" >&2
    printf 'Spring test-build preflight failed\n' >&2
    exit 1
fi
buildopt_preflight_finished=$(date +%s%N)
grep -Fq 'BUILD SUCCESSFUL' "${buildopt_root}/logs/preflight.log" || {
    printf 'Spring test-build preflight lacks success marker\n' >&2
    exit 1
}
buildopt_preflight_xml="${buildopt_root}/source/spring-jms/build/test-results/test/TEST-org.springframework.jms.support.JmsAccessorTests.xml"
[[ -s "${buildopt_preflight_xml}" ]] || {
    printf 'Spring test-build preflight lacks the requested test result\n' >&2
    exit 1
}
buildopt_stop_gradle "${buildopt_root}/source" "${buildopt_root}/preflight-home"

for buildopt_arm in control candidate; do
    buildopt_checkout="${buildopt_root}/${buildopt_arm}/checkout"
    buildopt_home="${buildopt_root}/${buildopt_arm}/gradle-home"
    mkdir -p -- "${buildopt_checkout}" "${buildopt_home}"
    tar -xzf "${buildopt_source_archive}" --strip-components=1 -C "${buildopt_checkout}"
    cp -a -- "${buildopt_root}/preflight-home/." "${buildopt_home}/"
    rm -rf -- "${buildopt_home}/daemon" "${buildopt_home}/.tmp"
done

buildopt_duration_ms=0
buildopt_started_ns=0
buildopt_finished_ns=0
buildopt_tests=0
buildopt_failures=0
buildopt_errors=0
buildopt_skipped=0
buildopt_jar_hits=0
buildopt_jar_executes=0
buildopt_run_arm() {
    local buildopt_arm=$1
    local buildopt_checkout=$2
    local buildopt_home=$3
    local buildopt_log=$4
    local buildopt_time=$5
    (
        cd "${buildopt_checkout}"
        env -u CI GRADLE_USER_HOME="${buildopt_home}" \
            "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
            ./gradlew --daemon --offline --quiet --max-workers=12 clean
    ) >"${buildopt_log}.clean" 2>&1
    local -a buildopt_command=(./gradlew --offline "${buildopt_common_args[@]}")
    if [[ "${buildopt_arm}" == candidate ]]; then
        buildopt_command=(
            "${buildopt_root}/product/buildopt" gradle
            --cache-standard-jar-producers -- --offline "${buildopt_common_args[@]}"
        )
    fi
    buildopt_started_ns=$(date +%s%N)
    if ! (
        cd "${buildopt_checkout}"
        /usr/bin/time -f 'maxRssKb=%M' -o "${buildopt_time}" \
            env -u CI GRADLE_USER_HOME="${buildopt_home}" \
            BUILDOPT_GRADLE_INIT_SCRIPT="${buildopt_init_script}" \
            BUILDOPT_GRADLE_PLUGIN_JAR="${buildopt_plugin_jar}" \
            "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
            "${buildopt_command[@]}"
    ) >"${buildopt_log}" 2>&1; then
        tail -n 180 "${buildopt_log}" >&2
        printf 'Spring test-build %s arm failed\n' "${buildopt_arm}" >&2
        return 1
    fi
    buildopt_finished_ns=$(date +%s%N)
    buildopt_duration_ms=$(((buildopt_finished_ns - buildopt_started_ns) / 1000000))
    grep -Fq 'BUILD SUCCESSFUL' "${buildopt_log}" || return 1
    grep -Eq '^> Task :spring-jms:test$' "${buildopt_log}" || {
        printf 'Spring test-build %s arm did not execute the requested Test task\n' \
            "${buildopt_arm}" >&2
        return 1
    }
    local buildopt_xml="${buildopt_checkout}/spring-jms/build/test-results/test/TEST-org.springframework.jms.support.JmsAccessorTests.xml"
    [[ -s "${buildopt_xml}" ]] || return 1
    buildopt_tests=$(sed -n 's/.*tests="\([0-9][0-9]*\)".*/\1/p' "${buildopt_xml}" | head -1)
    buildopt_skipped=$(sed -n 's/.*skipped="\([0-9][0-9]*\)".*/\1/p' "${buildopt_xml}" | head -1)
    buildopt_failures=$(sed -n 's/.*failures="\([0-9][0-9]*\)".*/\1/p' "${buildopt_xml}" | head -1)
    buildopt_errors=$(sed -n 's/.*errors="\([0-9][0-9]*\)".*/\1/p' "${buildopt_xml}" | head -1)
    [[ "${buildopt_tests}" == 8 && "${buildopt_skipped}" == 0 && \
        "${buildopt_failures}" == 0 && "${buildopt_errors}" == 0 ]] || return 1
    buildopt_jar_hits=$(grep -Ec '^> Task :[^ ]+:jar FROM-CACHE$' "${buildopt_log}" || true)
    buildopt_jar_executes=$(grep -Ec '^> Task :[^ ]+:jar$' "${buildopt_log}" || true)
}

buildopt_jar_manifest() {
    local buildopt_checkout=$1
    local buildopt_manifest=$2
    local buildopt_file
    : >"${buildopt_manifest}"
    while IFS= read -r -d '' buildopt_file; do
        printf '%s  %s\n' "$(sha256sum "${buildopt_file}" | awk '{print $1}')" \
            "${buildopt_file#"${buildopt_checkout}/"}" >>"${buildopt_manifest}"
    done < <(find "${buildopt_checkout}" -path '*/build/libs/*.jar' -type f -print0 | sort -z)
    [[ -s "${buildopt_manifest}" ]]
}

buildopt_testcase_manifest() {
    local buildopt_checkout=$1
    local buildopt_manifest=$2
    local buildopt_xml="${buildopt_checkout}/spring-jms/build/test-results/test/TEST-org.springframework.jms.support.JmsAccessorTests.xml"
    sed -n 's/.*<testcase name="\([^"]*\)" classname="\([^"]*\)".*/\2\t\1/p' \
        "${buildopt_xml}" | sort >"${buildopt_manifest}"
    [[ "$(wc -l <"${buildopt_manifest}")" == 8 ]]
}

buildopt_control_checkout="${buildopt_root}/control/checkout"
buildopt_candidate_checkout="${buildopt_root}/candidate/checkout"
buildopt_control_home="${buildopt_root}/control/gradle-home"
buildopt_candidate_home="${buildopt_root}/candidate/gradle-home"
buildopt_run_arm control "${buildopt_control_checkout}" "${buildopt_control_home}" \
    "${buildopt_root}/logs/warm-control.log" "${buildopt_root}/logs/warm-control.time"
buildopt_run_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}" \
    "${buildopt_root}/logs/warm-candidate.log" "${buildopt_root}/logs/warm-candidate.time"
((buildopt_jar_hits > 0)) || {
    printf 'Spring candidate warmup did not populate or replay a standard Jar\n' >&2
    exit 1
}

buildopt_rows="${buildopt_root}/observations.jsonl"
: >"${buildopt_rows}"
for buildopt_pair in {1..4}; do
    buildopt_order=CANDIDATE_FIRST
    if ((buildopt_pair % 2 == 1)); then
        buildopt_order=CONTROL_FIRST
    fi
    buildopt_control_log="${buildopt_root}/logs/pair-${buildopt_pair}-control.log"
    buildopt_candidate_log="${buildopt_root}/logs/pair-${buildopt_pair}-candidate.log"
    if [[ "${buildopt_order}" == CONTROL_FIRST ]]; then
        buildopt_run_arm control "${buildopt_control_checkout}" "${buildopt_control_home}" \
            "${buildopt_control_log}" "${buildopt_control_log}.time"
        buildopt_control_duration=${buildopt_duration_ms}
        buildopt_control_jar_executes=${buildopt_jar_executes}
        buildopt_first_finished=${buildopt_finished_ns}
        buildopt_run_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}" \
            "${buildopt_candidate_log}" "${buildopt_candidate_log}.time"
        buildopt_candidate_duration=${buildopt_duration_ms}
        buildopt_candidate_jar_hits=${buildopt_jar_hits}
    else
        buildopt_run_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}" \
            "${buildopt_candidate_log}" "${buildopt_candidate_log}.time"
        buildopt_candidate_duration=${buildopt_duration_ms}
        buildopt_candidate_jar_hits=${buildopt_jar_hits}
        buildopt_first_finished=${buildopt_finished_ns}
        buildopt_run_arm control "${buildopt_control_checkout}" "${buildopt_control_home}" \
            "${buildopt_control_log}" "${buildopt_control_log}.time"
        buildopt_control_duration=${buildopt_duration_ms}
        buildopt_control_jar_executes=${buildopt_jar_executes}
    fi
    buildopt_gap_ms=$(((buildopt_started_ns - buildopt_first_finished) / 1000000))
    ((buildopt_gap_ms <= 5000)) || {
        printf 'Spring test-build pair %s exceeded inter-arm gap: %s ms\n' \
            "${buildopt_pair}" "${buildopt_gap_ms}" >&2
        exit 1
    }
    buildopt_control_jars="${buildopt_root}/control-${buildopt_pair}.jars"
    buildopt_candidate_jars="${buildopt_root}/candidate-${buildopt_pair}.jars"
    buildopt_control_tests="${buildopt_root}/control-${buildopt_pair}.tests"
    buildopt_candidate_tests="${buildopt_root}/candidate-${buildopt_pair}.tests"
    buildopt_jar_manifest "${buildopt_control_checkout}" "${buildopt_control_jars}"
    buildopt_jar_manifest "${buildopt_candidate_checkout}" "${buildopt_candidate_jars}"
    buildopt_testcase_manifest "${buildopt_control_checkout}" "${buildopt_control_tests}"
    buildopt_testcase_manifest "${buildopt_candidate_checkout}" "${buildopt_candidate_tests}"
    cmp -s "${buildopt_control_jars}" "${buildopt_candidate_jars}" || {
        printf 'Spring test-build JAR outputs differ in pair %s\n' "${buildopt_pair}" >&2
        exit 1
    }
    cmp -s "${buildopt_control_tests}" "${buildopt_candidate_tests}" || {
        printf 'Spring test cases differ in pair %s\n' "${buildopt_pair}" >&2
        exit 1
    }
    ((buildopt_candidate_jar_hits > 0 && buildopt_control_jar_executes > 0)) || {
        printf 'Spring pair %s did not distinguish candidate Jar hits from native execution\n' \
            "${buildopt_pair}" >&2
        exit 1
    }
    jq -cn --argjson pair "${buildopt_pair}" --arg order "${buildopt_order}" \
        --argjson control "${buildopt_control_duration}" \
        --argjson candidate "${buildopt_candidate_duration}" \
        --argjson gap "${buildopt_gap_ms}" \
        --argjson jarHits "${buildopt_candidate_jar_hits}" \
        --argjson jarExecutes "${buildopt_control_jar_executes}" \
        --arg jarSha "$(sha256sum "${buildopt_control_jars}" | awk '{print $1}')" \
        --argjson jarCount "$(wc -l <"${buildopt_control_jars}")" \
        --arg testSha "$(sha256sum "${buildopt_control_tests}" | awk '{print $1}')" '
        {
            pair: $pair, order: $order,
            controlDurationMs: $control,
            candidateDurationMs: $candidate,
            savedMs: ($control - $candidate),
            interArmIdleGapMs: $gap,
            tests: 8, failures: 0, errors: 0, skipped: 0,
            requestedTestTaskExecuted: true,
            candidateStandardJarFromCacheCount: $jarHits,
            controlStandardJarExecutedCount: $jarExecutes,
            requiredJarOutputSha256: $jarSha,
            requiredJarOutputCount: $jarCount,
            testCaseSetSha256: $testSha,
            outputsIdentical: true,
            testCasesIdentical: true,
            productAttributableFailure: false
        }' >>"${buildopt_rows}"
    printf 'Spring test-build pair %s/4: native=%sms BuildOpt=%sms saved=%sms order=%s\n' \
        "${buildopt_pair}" "${buildopt_control_duration}" "${buildopt_candidate_duration}" \
        "$((buildopt_control_duration - buildopt_candidate_duration))" "${buildopt_order}"
done

jq -s '.' "${buildopt_rows}" >"${buildopt_root}/observations.json"
jq -n --arg capturedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg revision "${buildopt_revision}" --arg executableSha "${buildopt_executable_sha}" \
    --arg pluginSha "${buildopt_plugin_sha}" --arg initSha "${buildopt_init_sha}" \
    --arg runnerSha "${buildopt_runner_sha}" --arg specSha "${buildopt_spec_sha}" \
    --arg sourceSha "${buildopt_source_sha}" \
    --argjson preflightMs "$(((buildopt_preflight_finished - buildopt_preflight_started) / 1000000))" \
    --slurpfile spec "${buildopt_spec}" --slurpfile rows "${buildopt_root}/observations.json" '
    def bootstrap_mean($data; $sample):
        reduce range(0; 4) as $draw
            ({state: ((2654435761 * ($sample + 1)) % 4294967296), sum: 0};
             .state = ((1664525 * .state + 1013904223) % 4294967296) |
             .sum += $data[((.state / 1073741824) | floor)].savedMs) |
        .sum / 4;
    def bootstrap95($data):
        ([range(0; 4096) as $sample | bootstrap_mean($data; $sample)] | sort) as $r |
        [$r[102], $r[3993]];
    $rows[0] as $data |
    (($data | map(.controlDurationMs) | add) / 4) as $controlMean |
    (($data | map(.candidateDurationMs) | add) / 4) as $candidateMean |
    (($data | map(.savedMs) | add) / 4) as $mean |
    (($data | map(.savedMs) | add) / ($data | map(.controlDurationMs) | add)) as $ratio |
    bootstrap95($data) as $interval |
    ($data | map(select(.savedMs > 0)) | length) as $positive |
    ($mean >= $spec[0].valueGate.minimumSavedMs and
     $ratio >= $spec[0].valueGate.minimumReductionRatio and
     $interval[0] > 0 and
     all($data[]; .requiredJarOutputCount > 0 and
         .tests == 8 and .failures == 0 and .errors == 0 and .skipped == 0 and
         .requestedTestTaskExecuted and .candidateStandardJarFromCacheCount > 0 and
         .controlStandardJarExecutedCount > 0 and .outputsIdentical and
         .testCasesIdentical and (.productAttributableFailure | not))) as $qualified |
    {
        schemaVersion: "buildopt.evidence/poc-spring-test-build-optimization/v1",
        workItem: "POC-TEST-BUILD-OPTIMIZATION-001",
        capturedAt: $capturedAt,
        buildopt: {
            revision: $revision,
            executableSha256: $executableSha,
            pluginJarSha256: $pluginSha,
            initScriptSha256: $initSha,
            runnerScriptSha256: $runnerSha
        },
        specSha256: $specSha,
        repository: {
            nameWithOwner: $spec[0].repository.nameWithOwner,
            revision: $spec[0].repository.revision,
            sourceArchiveSha256: $sourceSha
        },
        runner: $spec[0].runner,
        workflow: $spec[0].workflow,
        preparation: {
            onlinePreflightMeasured: false,
            onlinePreflightSuccess: true,
            onlinePreflightWallClockMs: $preflightMs,
            measuredNetwork: "DISCONNECTED",
            dependencyMode: "GRADLE_OFFLINE",
            preflightDaemonStoppedBeforeArmSetup: true,
            sameDependencyAndNativeCacheSeedRestoredBeforeArmSetup: true,
            outputsRemovedBeforeEveryArm: true,
            warmupsPerArm: 1
        },
        observations: $data,
        result: {
            pairs: 4,
            controlMeanMs: $controlMean,
            candidateMeanMs: $candidateMean,
            meanSavedMs: $mean,
            reductionRatio: $ratio,
            interval95SavedMs: $interval,
            positivePairs: $positive,
            qualified: $qualified,
            decision: (if $qualified then
                "QUALIFIED_EXACT_STANDARD_JAR_REUSE_FOR_TEST_BUILDS"
                else "STOP_STANDARD_JAR_REUSE_FOR_SPRING_TEST_BUILD" end)
        },
        boundaries: $spec[0].boundaries
    }
' >"${buildopt_output}"

"${buildopt_script_dir}/check-poc-spring-test-build-optimization" \
    "${buildopt_output}" >/dev/null
printf 'Spring test-build optimization evidence written: %s\n' "${buildopt_output}"
