#!/usr/bin/env bash
set -euo pipefail

if (($# > 2)); then
    printf 'usage: %s [EVIDENCE_ROOT] [--spec-only]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_spec=${buildopt_repo_root}/specs/poc-native-retention-fast-path-v1.json
buildopt_evidence=${buildopt_repo_root}/benchmarks/results/poc-native-retention-fast-path-v1
buildopt_mode=
if (($# == 1)) && [[ $1 == --spec-only ]]; then
    buildopt_mode=--spec-only
elif (($# >= 1)); then
    buildopt_evidence=$1
    buildopt_mode=${2:-}
fi

for buildopt_command in cmp jq mktemp sha256sum; do
    command -v "${buildopt_command}" >/dev/null || {
        printf 'native-retention fast-path validation requires %s\n' "${buildopt_command}" >&2
        exit 1
    }
done

buildopt_baseline=$(jq -er '.baseline.evidence' "${buildopt_spec}")
buildopt_baseline_sha=$(sha256sum "${buildopt_repo_root}/${buildopt_baseline}" | awk '{print $1}')

jq -e --arg baselineSha "${buildopt_baseline_sha}" '
  .schemaVersion == "buildopt.specs/poc-native-retention-fast-path/v1" and
  .workItem == "POC-NATIVE-RETENTION-FAST-PATH-001" and
  .baseline.sha256 == $baselineSha and
  .source.sameRepositories and .source.sameRevisions and
  .source.sameEntrypoints and .source.sameRequiredOutputs and
  .source.sameArmOrder and
  .acceptance.nativeRetainedObservations == 8 and
  .acceptance.preGradleDecisions == 6 and
  .acceptance.postGradleDiscoveryDecisions == 2 and
  .acceptance.maximumPreGradleWrapperOverheadMsPerObservation == 5000 and
  .acceptance.maximumPreGradleWrapperOverheadMsTotal == 24000 and
  (.expected | length) == 8 and
  ([.expected[].revision] | unique | length) == 8 and
  ([.expected[] | select(.decisionPhase | startswith("PRE_GRADLE_"))] | length) == 6 and
  ([.expected[] | select(.decisionPhase == "POST_GRADLE_DISCOVERY")] | length) == 2 and
  all(.expected[]; (.revision | test("^[0-9a-f]{40}$")) and
    (.reason | length > 0)) and
  .boundaries == {proofOfConcept:true,productionAuthorized:false,
    repositorySpecificProductRules:false,soakRequired:false,
    designPartnerRequired:false,testOptimization:"OUT_OF_SCOPE"}
' "${buildopt_spec}" >/dev/null

if [[ ${buildopt_mode} == --spec-only ]]; then
    printf 'Native-retention fast-path specification OK: 8 frozen fallbacks, 6 pre-Gradle decisions\n'
    exit 0
fi

[[ -z ${buildopt_mode} && -s ${buildopt_evidence}/summary.json ]] || {
    printf 'native-retention fast-path evidence is unavailable\n' >&2
    exit 1
}
buildopt_evidence=$(cd -- "${buildopt_evidence}" && pwd -P)

buildopt_source=${buildopt_evidence}/source-v2/raw/summary.json
[[ -s ${buildopt_source} ]] || {
    printf 'native-retention source V2 evidence is unavailable\n' >&2
    exit 1
}
BUILDOPT_QUALIFIED_LIFETIME_SPEC="${buildopt_repo_root}/specs/poc-cross-commit-breadth-v2.subjects.json" \
    "${buildopt_script_dir}/check-qualified-lifetime-v2" "${buildopt_source}"

buildopt_tmp=$(mktemp -d /tmp/buildopt-native-retention-check.XXXXXX)
trap 'rm -rf -- "${buildopt_tmp}"' EXIT
"${buildopt_script_dir}/assemble-native-retention-fast-path" \
    "${buildopt_evidence}" >"${buildopt_tmp}/summary.json"
cmp -s "${buildopt_evidence}/summary.json" "${buildopt_tmp}/summary.json" || {
    printf 'native-retention fast-path summary does not recompute\n' >&2
    exit 1
}

jq -e --slurpfile spec "${buildopt_spec}" \
  --arg specSha "$(sha256sum "${buildopt_spec}" | awk '{print $1}')" \
  --arg sourceSha "$(sha256sum "${buildopt_source}" | awk '{print $1}')" '
  ($spec[0]) as $contract |
  .schemaVersion == "buildopt.evidence/poc-native-retention-fast-path/v1" and
  .workItem == $contract.workItem and
  .protocol.specSha256 == $specSha and
  .protocol.sourceV2SummarySha256 == $sourceSha and
  .result.nativeRetainedObservations == $contract.acceptance.nativeRetainedObservations and
  .result.preGradleDecisions + .result.postGradleDiscoveryDecisions ==
    $contract.acceptance.nativeRetainedObservations and
  .result.exactRequiredOutputs and .result.productFailures == 0 and
  .result.behavior == "GENERIC_FAST_PATH_BEHAVIOR_PROVEN" and
  .result.expectationMismatchCount ==
    ([.observations[] | select(.reason != .expectedReason or
      .decisionPhase != .expectedDecisionPhase)] | length) and
  .result.expectationMismatches ==
    [.observations[] | select(.reason != .expectedReason or
      .decisionPhase != .expectedDecisionPhase) |
      {revision,expectedReason,reason,expectedDecisionPhase,decisionPhase}] and
  ((.result.expectationMismatchCount == 0 and
      .result.preGradleDecisions == $contract.acceptance.preGradleDecisions and
      .result.postGradleDiscoveryDecisions == $contract.acceptance.postGradleDiscoveryDecisions and
      .result.decision == "FAST_PATH_ACCEPTED") or
    (.result.expectationMismatchCount > 0 and
      .result.decision == "FAST_PATH_REJECTED")) and
  (.result.selectedRegression | length) == 1 and
  all(.result.selectedRegression[];
    .selected and .controlDurationMs > .candidateDurationMs and
    .savedMs == (.controlDurationMs - .candidateDurationMs) and
    .reductionRatio == (.savedMs / .controlDurationMs) and
    .exactRequiredOutputs) and
  all(.observations[];
    .wrapperOverheadMs == (.preExecutionMs + .postExecutionMs) and
    .gradleDurationMs > 0 and .executionMode == "OPTIMIZED_NATIVE" and
    .exactRequiredOutputs) and
  all(.observations[] | select(.completedBeforeGradle);
    (.outputObservationPrepared | not) and
    .wrapperOverheadMs <= $contract.acceptance.maximumPreGradleWrapperOverheadMsPerObservation) and
  all(.observations[] | select(.completedBeforeGradle | not);
    .outputObservationPrepared) and
  .result.preGradleWrapperOverheadMs <=
    $contract.acceptance.maximumPreGradleWrapperOverheadMsTotal and
  .boundaries == $contract.boundaries
' "${buildopt_evidence}/summary.json" >/dev/null

printf 'Native-retention evidence OK: %s/8 pre-Gradle, %sms direct wrapper overhead, %s\n' \
    "$(jq -r '.result.preGradleDecisions' "${buildopt_evidence}/summary.json")" \
    "$(jq -r '.result.preGradleWrapperOverheadMs' "${buildopt_evidence}/summary.json")" \
    "$(jq -r '.result.decision' "${buildopt_evidence}/summary.json")"
