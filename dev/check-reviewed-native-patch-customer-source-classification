#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [SOURCE_ROOT]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
cd "${buildopt_repo_root}"

buildopt_report=benchmarks/results/reviewed-native-patch-customer-economics-v1/source-classification.json
buildopt_contract=specs/poc-reviewed-native-patch-customer-economics-v1.json
buildopt_subjects=specs/poc-reviewed-native-patch-customer-economics-v1.subjects.json

buildopt_contract_sha=$(sha256sum "${buildopt_contract}" | cut -d' ' -f1)
buildopt_subjects_sha=$(sha256sum "${buildopt_subjects}" | cut -d' ' -f1)

jq -e --arg contract_sha "${buildopt_contract_sha}" --arg subjects_sha "${buildopt_subjects_sha}" '
  .schemaVersion == "buildopt.evidence/reviewed-native-patch-customer-source-classification/v1" and
  .contractSha256 == $contract_sha and .subjectsSha256 == $subjects_sha and
  .evidenceSource == "FRESH_FROZEN_GIT_SOURCE_ONLY" and
  (.families | length) == 5 and ([.families[].key] | unique | length) == 5 and
  all(.families[]; .conclusive == true) and
  ([.families[] | select(.conclusive)] | length) as $conclusive |
  ([.families[] | select(any(.candidates[];
    .decision == "MARKER_ONLY_ELIGIBLE" or
    .decision == "REVIEWED_RELATIVE_PROOF_REQUIRED"))] | length) as $actions |
  .conclusiveFamilies == $conclusive and .actionFamilies == $actions and
  $conclusive == 5 and $actions == 1 and .requiredActionFamilies == 1 and
  .decision == "PASS_FRESH_SOURCE_ACTION_GATE" and
  .compilationAuthorized == true and .timingAuthorized == false and
  all(.families[].candidates[];
    (.path | type == "string" and length > 0) and
    (.className | type == "string" and length > 0) and
    (.sourceSha256 | test("^[0-9a-f]{64}$")) and
    (.declarationSpan.startLine > 0 and .declarationSpan.endLine > 0) and
    (.decision | IN(
      "MARKER_ONLY_ELIGIBLE", "REVIEWED_RELATIVE_PROOF_REQUIRED",
      "EXPLICIT_NON_PORTABLE", "ALREADY_CACHEABLE", "DISABLED_CACHING",
      "INCOMPLETE_OR_AMBIGUOUS", "NO_ACTION")) and
    all(.fileInputs[];
      (.kind | IN("INPUT_FILE", "INPUT_FILES", "INPUT_DIRECTORY", "INPUT_DIRECTORIES")) and
      (.binding | type == "string" and length > 0) and
      (.declarationSpan.startLine > 0 and .declarationSpan.endLine > 0) and
      all(.primaryNormalization[]; IN(
        "PATH_SENSITIVE_RELATIVE", "PATH_SENSITIVE_NAME_ONLY", "PATH_SENSITIVE_NONE",
        "PATH_SENSITIVE_ABSOLUTE", "CLASSPATH", "COMPILE_CLASSPATH")) and
      all(.supplementaryNormalization[]; IN(
        "NORMALIZE_LINE_ENDINGS", "IGNORE_EMPTY_DIRECTORIES")))) and
  ([.families[] | select(.key == "hibernate-orm") | .candidates[] |
    select(.decision == "REVIEWED_RELATIVE_PROOF_REQUIRED") | .className] |
    sort) == ["IndexerTask", "SettingsDocGenerationTask"]
' "${buildopt_report}" >/dev/null

if grep -ERq 'normalization-aware-cacheability-v2/(source-classification|patch-plan|public-correctness)|reviewed-native-patch-portfolio-v1/(result|selection|accepted-proposals)' \
    cmd/reviewed-native-patch-customer-audit internal/normalizationaware "${buildopt_report}"; then
    printf 'RNCE classifier must not consume predecessor result rows\n' >&2
    exit 1
fi

if (($# == 1)); then
    buildopt_source_root=$1
    buildopt_temporary_report=$(mktemp)
    trap 'rm -f "${buildopt_temporary_report}"' EXIT
    ./dev/run --toolchain go -- go run ./cmd/reviewed-native-patch-customer-audit \
        --source-root "${buildopt_source_root}" \
        --output "${buildopt_temporary_report}"
    cmp --silent "${buildopt_report}" "${buildopt_temporary_report}"

    while IFS=$'\t' read -r buildopt_family buildopt_revision buildopt_path buildopt_expected; do
        buildopt_actual=$(git -C "${buildopt_source_root}/${buildopt_family}" \
            show "${buildopt_revision}:${buildopt_path}" | sha256sum | cut -d' ' -f1)
        if [[ ${buildopt_actual} != "${buildopt_expected}" ]]; then
            printf '%s:%s source drift: expected %s, got %s\n' \
                "${buildopt_family}" "${buildopt_path}" "${buildopt_expected}" "${buildopt_actual}" >&2
            exit 1
        fi
    done < <(jq -r '.families[] | .key as $key | .revision as $revision |
      .candidates[] | [$key, $revision, .path, .sourceSha256] | @tsv' "${buildopt_report}")
fi

printf 'RNCE-002 source classification OK: 5/5 conclusive, 1/5 action families, no timing\n'
