#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)); then
    printf 'usage: %s OUTPUT_FILE\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-otel-optimization-v2.json"
buildopt_tasks_file="${buildopt_repo_root}/specs/poc-otel-spring-family-v2.tasks.txt"
buildopt_guard="${buildopt_script_dir}/poc-spring-test-preparation.guard.init.gradle"

if [[ "${buildopt_output}" != /* || -e "${buildopt_output}" ]]; then
    printf 'invalid OpenTelemetry test-preparation output path\n' >&2
    exit 64
fi
for buildopt_command in awk chmod cmp cp curl date find git grep jq mkdir \
    mktemp sed sha256sum sort tar timeout xargs; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required OpenTelemetry test-preparation command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
if env | grep -q '^BUILDOPT_'; then
    printf 'OpenTelemetry Spring-family measurement requires an environment without BUILDOPT_* overrides\n' >&2
    exit 1
fi
[[ -x /usr/bin/time ]] || {
    printf 'required OpenTelemetry test-preparation command is unavailable: /usr/bin/time\n' >&2
    exit 1
}
if [[ -n "$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)" ]]; then
    printf 'OpenTelemetry test-preparation measurement requires a clean revision-bound checkout\n' >&2
    exit 1
fi

"${buildopt_script_dir}/check-poc-otel-optimization-v2" >/dev/null
mapfile -t buildopt_control_tasks <"${buildopt_tasks_file}"

buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-otel-optimization-v2.XXXXXX")
buildopt_completed=false
buildopt_stop_gradle() {
    local buildopt_checkout=$1
    local buildopt_home=$2
    if [[ -x "${buildopt_checkout}/gradlew" && -d "${buildopt_home}" ]]; then
        (
            cd "${buildopt_checkout}"
            env GRADLE_USER_HOME="${buildopt_home}" \
                "${buildopt_script_dir}/run" --toolchain temurin-jdk-21 -- \
                ./gradlew --stop
        ) >/dev/null 2>&1 || true
    fi
}
buildopt_cleanup() {
    if [[ "${buildopt_root}" == "${TMPDIR:-/tmp}/buildopt-otel-optimization-v2."* ]]; then
        if [[ "${buildopt_completed}" != true && -d "${buildopt_root}/logs" ]]; then
            buildopt_failure_logs="${buildopt_output}.failure-logs.tar.gz"
            tar -C "${buildopt_root}" -czf "${buildopt_failure_logs}" logs
            chmod 0600 "${buildopt_failure_logs}"
            printf 'OpenTelemetry failure logs preserved: %s\n' \
                "${buildopt_failure_logs}" >&2
        fi
        buildopt_stop_gradle "${buildopt_root}/source" "${buildopt_root}/preflight-home"
        buildopt_stop_gradle "${buildopt_root}/work/checkout" \
            "${buildopt_root}/work/gradle-home"
        chmod -R u+w "${buildopt_root}/readonly-dependencies" 2>/dev/null || true
        rm -rf -- "${buildopt_root}"
    fi
}
trap buildopt_cleanup EXIT
chmod 0700 "${buildopt_root}"
mkdir -p -- "${buildopt_root}/source" "${buildopt_root}/preflight-home" \
    "${buildopt_root}/logs"
chmod 0700 "${buildopt_root}/preflight-home"

buildopt_revision=$(git -C "${buildopt_repo_root}" rev-parse HEAD)
buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_runner_sha=$(sha256sum "${BASH_SOURCE[0]}" | awk '{print $1}')
buildopt_guard_sha=$(sha256sum "${buildopt_guard}" | awk '{print $1}')
(
    cd "${buildopt_repo_root}"
    "${buildopt_repo_root}/packaging/linux/package.sh" \
        --version 0.3.0-dev --output "${buildopt_root}/package" >/dev/null
)
mkdir -p -- "${buildopt_root}/package-root" "${buildopt_root}/install"
buildopt_package="${buildopt_root}/package/buildopt-0.3.0-dev-linux-amd64.tar.gz"
tar -xzf "${buildopt_package}" -C "${buildopt_root}/package-root"
"${buildopt_root}/package-root/buildopt-0.3.0-dev-linux-amd64/install.sh" \
    --prefix "${buildopt_root}/install" >/dev/null
buildopt_executable="${buildopt_root}/install/bin/buildopt"
buildopt_impact_executable="${buildopt_root}/install/bin/buildopt-impact"
buildopt_executable_sha=$(sha256sum "${buildopt_executable}" | awk '{print $1}')
buildopt_package_sha=$(sha256sum "${buildopt_package}" | awk '{print $1}')

buildopt_source_archive="${buildopt_root}/opentelemetry-java-instrumentation.tar.gz"
buildopt_source_url=$(jq -er '.repository.sourceArchiveUrl' "${buildopt_spec}")
buildopt_source_sha=$(jq -er '.repository.sourceArchiveSha256' "${buildopt_spec}")
curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
    --output "${buildopt_source_archive}" "${buildopt_source_url}"
[[ "$(sha256sum "${buildopt_source_archive}" | awk '{print $1}')" == \
    "${buildopt_source_sha}" ]] || {
    printf 'OpenTelemetry source archive checksum mismatch\n' >&2
    exit 1
}
tar -xzf "${buildopt_source_archive}" --strip-components=1 -C "${buildopt_root}/source"

buildopt_assert_sha() {
    local buildopt_relative=$1
    local buildopt_expected=$2
    [[ "$(sha256sum "${buildopt_root}/source/${buildopt_relative}" | awk '{print $1}')" == \
        "${buildopt_expected}" ]] || {
        printf 'OpenTelemetry fixed input checksum mismatch: %s\n' "${buildopt_relative}" >&2
        exit 1
    }
}
buildopt_assert_sha gradle/wrapper/gradle-wrapper.jar \
    "$(jq -er '.repository.gradleWrapperJarSha256' "${buildopt_spec}")"
buildopt_assert_sha gradle/wrapper/gradle-wrapper.properties \
    "$(jq -er '.repository.gradleWrapperPropertiesSha256' "${buildopt_spec}")"
buildopt_change_path=$(jq -er '.candidate.changePath' "${buildopt_spec}")
buildopt_assert_sha "${buildopt_change_path}" \
    "$(jq -er '.candidate.changeOriginalSha256' "${buildopt_spec}")"

buildopt_preflight_started=$(date +%s%N)
if ! (
    cd "${buildopt_root}/source"
    env -u CI GRADLE_USER_HOME="${buildopt_root}/preflight-home" \
        "${buildopt_script_dir}/run" --toolchain temurin-jdk-21 -- \
        timeout 20m ./gradlew --daemon --build-cache --parallel \
        --configuration-cache --max-workers=12 --no-scan --stacktrace \
        "${buildopt_control_tasks[@]}"
) >"${buildopt_root}/logs/preflight.log" 2>&1; then
    tail -n 180 "${buildopt_root}/logs/preflight.log" >&2
    printf 'OpenTelemetry test-preparation preflight failed\n' >&2
    exit 1
fi
buildopt_preflight_finished=$(date +%s%N)
grep -Fq 'BUILD SUCCESSFUL' "${buildopt_root}/logs/preflight.log" || {
    printf 'OpenTelemetry test-preparation preflight lacks success marker\n' >&2
    exit 1
}
! grep -Eq '^> Task .*:test($| )' "${buildopt_root}/logs/preflight.log" || {
    printf 'OpenTelemetry preflight executed a Gradle Test task\n' >&2
    exit 1
}
buildopt_stop_gradle "${buildopt_root}/source" "${buildopt_root}/preflight-home"

buildopt_readonly_cache="${buildopt_root}/readonly-dependencies"
mkdir -p -- "${buildopt_readonly_cache}"
cp -a -- "${buildopt_root}/preflight-home/caches/modules-2" \
    "${buildopt_readonly_cache}/modules-2"
find "${buildopt_readonly_cache}/modules-2" -type f \
    \( -name '*.lock' -o -name gc.properties \) -delete
chmod -R a-w "${buildopt_readonly_cache}"
buildopt_readonly_cache_sha=$(
    cd "${buildopt_readonly_cache}"
    find modules-2 -type f -print0 | sort -z |
        xargs -0 sha256sum | sha256sum | awk '{print $1}'
)
buildopt_cache_seed="${buildopt_root}/build-cache-seed.tar.gz"
tar -C "${buildopt_root}/preflight-home/caches" -czf \
    "${buildopt_cache_seed}" build-cache-1
buildopt_cache_seed_sha=$(sha256sum "${buildopt_cache_seed}" | awk '{print $1}')

jq -Rn '[inputs | select(length > 0)]' <"${buildopt_tasks_file}" \
    >"${buildopt_root}/control-entrypoints.json"
jq -n --slurpfile entrypoints "${buildopt_root}/control-entrypoints.json" '
    {
        schemaVersion: "buildopt.build-impact/manifest/v1",
        manifestVersion: 1,
        repositoryId: "open-telemetry/opentelemetry-java-instrumentation",
        pipelineClass: "poc-otel-spring-family-v2",
        ownership: "REPOSITORY_COMMITTED",
        originalEntrypoints: $entrypoints[0],
        allowedAlternatives: [{
            id: "otel-spring-autoconfigure-class-producers",
            entrypoints: [
                ":instrumentation:spring:spring-boot-autoconfigure:compileJava",
                ":instrumentation:spring:spring-boot-autoconfigure:compileJavaSpring3Java",
                ":instrumentation:spring:spring-boot-autoconfigure:compileJavaSpring4Java",
                ":instrumentation:spring:spring-boot-autoconfigure:compileTestJava"
            ]
        }],
        requiredArtifacts: [{
            id: "otel-spring-autoconfigure-test-preparation",
            path: "instrumentation/spring/spring-boot-autoconfigure/build/classes/**",
            owner: "BUILD_OPTIMIZATION"
        }],
        requiredChecks: [],
        globalChangePaths: ["gradle/**", "buildscripts/**", "conventions/**"],
        unknownChangePolicy: "FULL_GRAPH"
    }
' >"${buildopt_root}/buildopt-impact-manifest.json"

buildopt_checkout="${buildopt_root}/work/checkout"
buildopt_home="${buildopt_root}/work/gradle-home"
mkdir -p -- "${buildopt_checkout}" "${buildopt_home}"
tar -xzf "${buildopt_source_archive}" --strip-components=1 -C "${buildopt_checkout}"
cp -a -- "${buildopt_root}/preflight-home/wrapper" "${buildopt_home}/wrapper"
cp -- "${buildopt_checkout}/${buildopt_change_path}" \
    "${buildopt_root}/changed-source.original"
cp -- "${buildopt_root}/buildopt-impact-manifest.json" \
    "${buildopt_checkout}/buildopt-impact-manifest.json"
mkdir -p -- "${buildopt_home}/init.d"
cp -- "${buildopt_guard}" \
    "${buildopt_home}/init.d/buildopt-poc-test-preparation.guard.init.gradle"
buildopt_control_checkout="${buildopt_checkout}"
buildopt_candidate_checkout="${buildopt_checkout}"
buildopt_control_home="${buildopt_home}"
buildopt_candidate_home="${buildopt_home}"

env GRADLE_USER_HOME="${buildopt_candidate_home}" \
    GRADLE_RO_DEP_CACHE="${buildopt_readonly_cache}" \
    "${buildopt_script_dir}/run" --toolchain temurin-jdk-21 -- \
    "${buildopt_impact_executable}" generate \
    --repository "${buildopt_candidate_checkout}" \
    --manifest buildopt-impact-manifest.json \
    --repository-id open-telemetry/opentelemetry-java-instrumentation \
    --pipeline-class poc-otel-spring-family-v2 \
    --graph buildopt-impact-graph.generated.json \
    --generated-manifest buildopt-impact.generated.json \
    --gradle-command ./gradlew --timeout 10m >/dev/null
buildopt_graph="${buildopt_candidate_checkout}/buildopt-impact-graph.generated.json"
jq -e --slurpfile spec "${buildopt_spec}" --slurpfile tasks "${buildopt_root}/control-entrypoints.json" '
    .complete == true and
    (.projects | length) == $spec[0].discovery.expectedProjectCount and
    ([.entrypoints[].name] | sort) ==
        (($tasks[0] + $spec[0].candidate.entrypoints) |
            unique | sort) and
    ([.entrypoints[] | select(.name as $name | $tasks[0] | index($name)) |
        .reachesProjects[]] | unique | length) == $spec[0].control.expectedReachedProjectCount and
    all(.entrypoints[] | select(.name as $name | $spec[0].candidate.entrypoints | index($name));
        (.reachesProjects | length) == $spec[0].candidate.expectedReachedProjectCount) and
    all(.entrypoints[]; .containsTestTasks == false and .unknownRelationships == false)
' "${buildopt_graph}" >/dev/null
buildopt_graph_sha=$(sha256sum "${buildopt_graph}" | awk '{print $1}')
[[ "${buildopt_graph_sha}" == "$(jq -er '.discovery.expectedGraphSha256' "${buildopt_spec}")" ]] || {
    printf 'OpenTelemetry discovered graph drifted after preregistration\n' >&2
    exit 1
}
buildopt_generated_manifest="${buildopt_candidate_checkout}/buildopt-impact.generated.json"
[[ "$(sha256sum "${buildopt_generated_manifest}" | awk '{print $1}')" == \
    "$(jq -er '.discovery.expectedGeneratedManifestSha256' "${buildopt_spec}")" ]] || {
    printf 'OpenTelemetry generated manifest drifted after preregistration\n' >&2
    exit 1
}
jq -e --arg digest "$(jq -er '.discovery.expectedGraphDigest' "${buildopt_spec}")" \
    '.complete == true and .graphDigest == $digest and .fallbackReasons == []' \
    "${buildopt_generated_manifest}" >/dev/null
mkdir -p -- "${buildopt_root}/logs/discovery-state"
cp -- "${buildopt_candidate_checkout}/buildopt-impact-manifest.json" \
    "${buildopt_graph}" "${buildopt_generated_manifest}" \
    "${buildopt_root}/logs/discovery-state/"
printf '%s\n' "${buildopt_change_path}" >"${buildopt_candidate_checkout}/.buildopt-changes"
buildopt_hot_state="${buildopt_root}/work/hot-state"
mkdir -p -- "${buildopt_hot_state}"
chmod 0700 "${buildopt_hot_state}"

buildopt_reset_arm() {
    local buildopt_arm=$1
    local buildopt_checkout=$2
    local buildopt_home=$3
    cp -- "${buildopt_root}/changed-source.original" \
        "${buildopt_checkout}/${buildopt_change_path}"
    if ! (
        cd "${buildopt_checkout}"
        env -u CI GRADLE_USER_HOME="${buildopt_home}" \
            GRADLE_RO_DEP_CACHE="${buildopt_readonly_cache}" \
            "${buildopt_script_dir}/run" --toolchain temurin-jdk-21 -- \
            ./gradlew --daemon --offline --quiet --configuration-cache \
            --max-workers=12 clean
    ) >"${buildopt_root}/logs/reset-${buildopt_arm}.log" 2>&1; then
        tail -n 180 "${buildopt_root}/logs/reset-${buildopt_arm}.log" >&2
        printf 'OpenTelemetry %s arm reset failed before measurement\n' \
            "${buildopt_arm}" >&2
        return 1
    fi
    rm -rf -- "${buildopt_home}/caches/build-cache-1"
    mkdir -p -- "${buildopt_home}/caches"
    tar -C "${buildopt_home}/caches" -xzf "${buildopt_active_cache_seed}"
    printf '\n// buildopt-poc-otel-optimization-fixed-change\n' \
        >>"${buildopt_checkout}/${buildopt_change_path}"
}

buildopt_duration_ms=0
buildopt_started_ns=0
buildopt_finished_ns=0
buildopt_max_rss_kb=0
buildopt_require_candidate_jar_hit=false
buildopt_run_arm() {
    local buildopt_arm=$1
    local buildopt_checkout=$2
    local buildopt_home=$3
    local buildopt_log=$4
    local buildopt_time=$5
    buildopt_started_ns=$(date +%s%N)
    if ! (
        cd "${buildopt_checkout}"
        if [[ "${buildopt_arm}" == candidate ]]; then
            /usr/bin/time -f 'maxRssKb=%M' -o "${buildopt_time}" \
                env -u CI GRADLE_USER_HOME="${buildopt_home}" \
                GRADLE_RO_DEP_CACHE="${buildopt_readonly_cache}" \
                "${buildopt_script_dir}/run" --toolchain temurin-jdk-21 -- \
                timeout 10m "${buildopt_executable}" impact \
                --repository-id open-telemetry/opentelemetry-java-instrumentation \
                --pipeline-class poc-otel-spring-family-v2 \
                --changes-file .buildopt-changes \
                --repository-revision "$(jq -er '.repository.revision' "${buildopt_spec}")" \
                --hot-state-dir "${buildopt_hot_state}" \
                --cache-standard-jar-producers \
                --gradle-option=--daemon --gradle-option=--offline \
                --gradle-option=--build-cache --gradle-option=--parallel \
                --gradle-option=--configuration-cache --gradle-option=--console=plain \
                --gradle-option=--max-workers=12 --gradle-option=--no-scan \
                --gradle-option=--stacktrace
        else
            /usr/bin/time -f 'maxRssKb=%M' -o "${buildopt_time}" \
                env -u CI GRADLE_USER_HOME="${buildopt_home}" \
                GRADLE_RO_DEP_CACHE="${buildopt_readonly_cache}" \
                "${buildopt_script_dir}/run" --toolchain temurin-jdk-21 -- \
                timeout 10m ./gradlew --daemon --offline --build-cache --parallel \
                --configuration-cache --console=plain --max-workers=12 \
                --no-scan --stacktrace "${buildopt_control_tasks[@]}"
        fi
    ) >"${buildopt_log}" 2>&1; then
        tail -n 180 "${buildopt_log}" >&2
        printf 'OpenTelemetry test-preparation %s arm failed\n' "${buildopt_arm}" >&2
        return 1
    fi
    buildopt_finished_ns=$(date +%s%N)
    buildopt_duration_ms=$(((buildopt_finished_ns - buildopt_started_ns) / 1000000))
    buildopt_max_rss_kb=$(awk -F= '$1 == "maxRssKb" {print $2 + 0}' "${buildopt_time}")
    grep -Fq 'BUILD SUCCESSFUL' "${buildopt_log}" || {
        tail -n 180 "${buildopt_log}" >&2
        printf 'OpenTelemetry %s arm lacks Gradle success marker\n' \
            "${buildopt_arm}" >&2
        return 1
    }
    if [[ "${buildopt_arm}" == candidate ]] && ! grep -Fq \
        'explicit Build Impact POC candidate otel-spring-autoconfigure-class-producers selected' \
        "${buildopt_log}"; then
        grep -F 'buildopt: Build Impact POC' "${buildopt_log}" >&2 || true
        printf 'OpenTelemetry candidate did not select the preregistered alternative\n' >&2
        return 1
    fi
    if [[ "${buildopt_arm}" == candidate ]]; then
        grep -Eq '^> Task :testing-common:jar( |$)' "${buildopt_log}" || {
            printf 'OpenTelemetry candidate did not reach the standard testing-common Jar\n' >&2
            return 1
        }
        if [[ "${buildopt_require_candidate_jar_hit}" == true ]] &&
            ! grep -Eq '^> Task :testing-common:jar FROM-CACHE$' "${buildopt_log}"; then
            printf 'OpenTelemetry candidate did not replay the standard testing-common Jar\n' >&2
            return 1
        fi
        if grep -Eq 'managed L1 unavailable|plugin handshake|authenticated local gateway' \
            "${buildopt_log}"; then
            printf 'OpenTelemetry candidate started an unrelated managed runtime\n' >&2
            return 1
        fi
    else
        grep -Eq '^> Task :testing-common:jar( |$)' "${buildopt_log}" || {
            printf 'OpenTelemetry control did not execute the standard testing-common Jar\n' >&2
            return 1
        }
        ! grep -Eq '^> Task :testing-common:jar FROM-CACHE$' "${buildopt_log}" || {
            printf 'OpenTelemetry control unexpectedly consumed the candidate-only Jar entry\n' >&2
            return 1
        }
    fi
    grep -Eq '^> Task :instrumentation:spring:spring-boot-autoconfigure:compileJava( |$)' \
        "${buildopt_log}" || {
        printf 'OpenTelemetry %s arm did not execute changed compileJava\n' "${buildopt_arm}" >&2
        return 1
    }
    ! grep -Fq 'forbidden root-build Gradle Test task(s):' "${buildopt_log}" || {
        tail -n 180 "${buildopt_log}" >&2
        printf 'OpenTelemetry %s arm violated the root Test guard\n' \
            "${buildopt_arm}" >&2
        return 1
    }
    ! grep -Eq '^> Task .*:test($| )' "${buildopt_log}" || {
        printf 'OpenTelemetry %s arm executed a Gradle Test task\n' "${buildopt_arm}" >&2
        return 1
    }
    if grep -Eq '^> Task .*:(publish|upload|release|sign)([A-Z:]|$)' "${buildopt_log}" ||
        grep -Eq 'Publishing build scan|Build scan published|https://gradle[.]com/s/' \
            "${buildopt_log}"; then
        printf 'OpenTelemetry %s arm attempted an external action\n' "${buildopt_arm}" >&2
        return 1
    fi
}

buildopt_output_manifest() {
    local buildopt_checkout=$1
    local buildopt_manifest=$2
    local buildopt_output_root="${buildopt_checkout}/instrumentation/spring/spring-boot-autoconfigure/build/classes"
    local buildopt_file
    : >"${buildopt_manifest}"
    [[ -d "${buildopt_output_root}" ]] || return 1
    while IFS= read -r -d '' buildopt_file; do
        printf '%s  %s\n' "$(sha256sum "${buildopt_file}" | awk '{print $1}')" \
            "${buildopt_file#"${buildopt_checkout}/"}" >>"${buildopt_manifest}"
    done < <(find "${buildopt_output_root}" -type f -print0 | sort -z)
    [[ -s "${buildopt_manifest}" ]]
}

buildopt_active_cache_seed="${buildopt_cache_seed}"
buildopt_reset_arm control "${buildopt_control_checkout}" "${buildopt_control_home}"
if ! buildopt_run_arm control "${buildopt_control_checkout}" "${buildopt_control_home}" \
    "${buildopt_root}/logs/warm-control.log" "${buildopt_root}/logs/warm-control.time"; then
    printf 'OpenTelemetry control warm-up failed before accepted measurement\n' >&2
    exit 1
fi
buildopt_reset_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}"
if ! buildopt_run_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}" \
    "${buildopt_root}/logs/warm-candidate.log" "${buildopt_root}/logs/warm-candidate.time"; then
    printf 'OpenTelemetry candidate warm-up failed before accepted measurement\n' >&2
    exit 1
fi
if grep -Fq 'buildopt: exact-bound Build Impact POC hot state reused' \
    "${buildopt_root}/logs/warm-candidate.log"; then
    printf 'OpenTelemetry candidate warm-up unexpectedly reused pre-existing hot state\n' >&2
    exit 1
fi
buildopt_candidate_cache_seed="${buildopt_root}/candidate-build-cache-seed.tar.gz"
tar -C "${buildopt_home}/caches" -czf \
    "${buildopt_candidate_cache_seed}" build-cache-1
buildopt_candidate_cache_seed_sha=$(
    sha256sum "${buildopt_candidate_cache_seed}" | awk '{print $1}'
)
buildopt_active_cache_seed="${buildopt_candidate_cache_seed}"
buildopt_require_candidate_jar_hit=true

buildopt_rows="${buildopt_root}/observations.jsonl"
: >"${buildopt_rows}"
for buildopt_pair in {1..4}; do
    buildopt_order=CANDIDATE_FIRST
    if ((buildopt_pair % 2 == 1)); then
        buildopt_order=CONTROL_FIRST
    fi
    buildopt_control_log="${buildopt_root}/logs/pair-${buildopt_pair}-control.log"
    buildopt_candidate_log="${buildopt_root}/logs/pair-${buildopt_pair}-candidate.log"
    buildopt_control_outputs="${buildopt_root}/control-${buildopt_pair}.outputs"
    buildopt_candidate_outputs="${buildopt_root}/candidate-${buildopt_pair}.outputs"
    if [[ "${buildopt_order}" == CONTROL_FIRST ]]; then
        buildopt_reset_arm control "${buildopt_control_checkout}" "${buildopt_control_home}"
        buildopt_run_arm control "${buildopt_control_checkout}" "${buildopt_control_home}" \
            "${buildopt_control_log}" "${buildopt_control_log}.time"
        buildopt_control_duration=${buildopt_duration_ms}
        buildopt_control_rss=${buildopt_max_rss_kb}
        buildopt_output_manifest "${buildopt_control_checkout}" "${buildopt_control_outputs}"
        buildopt_reset_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}"
        buildopt_first_finished=$(date +%s%N)
        buildopt_run_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}" \
            "${buildopt_candidate_log}" "${buildopt_candidate_log}.time"
        buildopt_candidate_duration=${buildopt_duration_ms}
        buildopt_candidate_rss=${buildopt_max_rss_kb}
        buildopt_output_manifest "${buildopt_candidate_checkout}" "${buildopt_candidate_outputs}"
    else
        buildopt_reset_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}"
        buildopt_run_arm candidate "${buildopt_candidate_checkout}" "${buildopt_candidate_home}" \
            "${buildopt_candidate_log}" "${buildopt_candidate_log}.time"
        buildopt_candidate_duration=${buildopt_duration_ms}
        buildopt_candidate_rss=${buildopt_max_rss_kb}
        buildopt_output_manifest "${buildopt_candidate_checkout}" "${buildopt_candidate_outputs}"
        buildopt_reset_arm control "${buildopt_control_checkout}" "${buildopt_control_home}"
        buildopt_first_finished=$(date +%s%N)
        buildopt_run_arm control "${buildopt_control_checkout}" "${buildopt_control_home}" \
            "${buildopt_control_log}" "${buildopt_control_log}.time"
        buildopt_control_duration=${buildopt_duration_ms}
        buildopt_control_rss=${buildopt_max_rss_kb}
        buildopt_output_manifest "${buildopt_control_checkout}" "${buildopt_control_outputs}"
    fi
    grep -Fq 'buildopt: exact-bound Build Impact POC hot state reused' \
        "${buildopt_candidate_log}" || {
        printf 'OpenTelemetry candidate pair %s did not reuse exact-bound hot state\n' \
            "${buildopt_pair}" >&2
        exit 1
    }
    buildopt_gap_ms=$(((buildopt_started_ns - buildopt_first_finished) / 1000000))
    ((buildopt_gap_ms <= 5000)) || {
        printf 'OpenTelemetry pair %s exceeded inter-arm gap: %s ms\n' \
            "${buildopt_pair}" "${buildopt_gap_ms}" >&2
        exit 1
    }
    cmp -s "${buildopt_control_outputs}" "${buildopt_candidate_outputs}" || {
        printf 'OpenTelemetry test-preparation outputs differ in pair %s\n' \
            "${buildopt_pair}" >&2
        exit 1
    }
    jq -cn --argjson pair "${buildopt_pair}" --arg order "${buildopt_order}" \
        --argjson control "${buildopt_control_duration}" \
        --argjson candidate "${buildopt_candidate_duration}" \
        --argjson gap "${buildopt_gap_ms}" --argjson controlRss "${buildopt_control_rss}" \
        --argjson candidateRss "${buildopt_candidate_rss}" \
        --arg outputSha "$(sha256sum "${buildopt_control_outputs}" | awk '{print $1}')" \
        --argjson outputCount "$(wc -l <"${buildopt_control_outputs}")" \
        --slurpfile controlTasks "${buildopt_root}/control-entrypoints.json" \
        --slurpfile spec "${buildopt_spec}" '
        {
            pair: $pair, order: $order,
            controlDurationMs: $control,
            candidateDurationMs: $candidate,
            savedMs: ($control - $candidate),
            interArmIdleGapMs: $gap,
            controlMaximumResidentSetKb: $controlRss,
            candidateMaximumResidentSetKb: $candidateRss,
            requiredOutputSha256: $outputSha,
            requiredOutputCount: $outputCount,
            controlEntrypoints: $controlTasks[0],
            candidateEntrypoints: $spec[0].candidate.entrypoints,
            candidateHotStateHit: true,
            candidateStandardJarCacheHit: true,
            controlStandardJarCacheHit: false,
            managedRuntimeStarted: false,
            rootBuildGradleTestTasksExecuted: false,
            productAttributableFailure: false
        }' >>"${buildopt_rows}"
    printf 'OpenTelemetry Spring-family pair %s/4: control=%sms candidate=%sms saved=%sms order=%s\n' \
        "${buildopt_pair}" "${buildopt_control_duration}" "${buildopt_candidate_duration}" \
        "$((buildopt_control_duration - buildopt_candidate_duration))" "${buildopt_order}"
done

cp -- "${buildopt_rows}" "${buildopt_root}/logs/completed-observations.jsonl"

buildopt_reset_arm candidate "${buildopt_candidate_checkout}" \
    "${buildopt_candidate_home}"
printf '\n# buildopt-poc-global-fallback\n' \
    >>"${buildopt_candidate_checkout}/gradle.properties"
printf 'gradle.properties\n' >"${buildopt_candidate_checkout}/.buildopt-changes"
buildopt_fallback_log="${buildopt_root}/logs/fallback.log"
if ! (
    cd "${buildopt_candidate_checkout}"
    env -u CI GRADLE_USER_HOME="${buildopt_candidate_home}" \
        GRADLE_RO_DEP_CACHE="${buildopt_readonly_cache}" \
        "${buildopt_script_dir}/run" --toolchain temurin-jdk-21 -- \
        timeout 10m "${buildopt_executable}" impact \
        --repository-id open-telemetry/opentelemetry-java-instrumentation \
        --pipeline-class poc-otel-spring-family-v2 \
        --changes-file .buildopt-changes \
        --repository-revision "$(jq -er '.repository.revision' "${buildopt_spec}")" \
        --hot-state-dir "${buildopt_hot_state}" \
        --cache-standard-jar-producers \
        --gradle-option=--daemon --gradle-option=--offline \
        --gradle-option=--build-cache --gradle-option=--parallel \
        --gradle-option=--configuration-cache --gradle-option=--console=plain \
        --gradle-option=--max-workers=12 --gradle-option=--no-scan \
        --gradle-option=--stacktrace
) >"${buildopt_fallback_log}" 2>&1; then
    tail -n 180 "${buildopt_fallback_log}" >&2
    printf 'OpenTelemetry Spring-family global fallback failed\n' >&2
    exit 1
fi
grep -Fq 'buildopt: Build Impact POC retained the full graph (IMPACT_GLOBAL_CHANGE)' \
    "${buildopt_fallback_log}" || {
    printf 'OpenTelemetry global change did not retain the full Spring-family graph\n' >&2
    exit 1
}
grep -Eq '^> Task :instrumentation:spring:spring-webmvc:spring-webmvc-6[.]0:javaagent:testClasses( |$)' \
    "${buildopt_fallback_log}" || {
    printf 'OpenTelemetry fallback did not execute an entrypoint outside autoconfigure\n' >&2
    exit 1
}
grep -Fq 'BUILD SUCCESSFUL' "${buildopt_fallback_log}" || exit 1
! grep -Fq 'forbidden root-build Gradle Test task(s):' "${buildopt_fallback_log}" || exit 1
if grep -Fq 'buildopt: exact-bound Build Impact POC hot state reused' \
    "${buildopt_fallback_log}"; then
    printf 'OpenTelemetry global-change fallback reused incompatible hot state\n' >&2
    exit 1
fi

jq -s '.' "${buildopt_rows}" >"${buildopt_root}/observations.json"
buildopt_captured_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
jq -n --arg capturedAt "${buildopt_captured_at}" --arg revision "${buildopt_revision}" \
    --arg specSha "${buildopt_spec_sha}" --arg runnerSha "${buildopt_runner_sha}" \
    --arg guardSha "${buildopt_guard_sha}" --arg executableSha "${buildopt_executable_sha}" \
    --arg packageSha "${buildopt_package_sha}" \
    --arg sourceSha "${buildopt_source_sha}" --arg cacheSha "${buildopt_cache_seed_sha}" \
    --arg candidateCacheSha "${buildopt_candidate_cache_seed_sha}" \
    --arg readOnlyCacheSha "${buildopt_readonly_cache_sha}" --arg graphSha "${buildopt_graph_sha}" \
    --argjson preflightMs "$(((buildopt_preflight_finished - buildopt_preflight_started) / 1000000))" \
    --slurpfile spec "${buildopt_spec}" --slurpfile rows "${buildopt_root}/observations.json" '
    def bootstrap_mean($data; $sample):
        reduce range(0; 4) as $draw
            ({state: ((2654435761 * ($sample + 1)) % 4294967296), sum: 0};
             .state = ((1664525 * .state + 1013904223) % 4294967296) |
             .sum += $data[((.state / 1073741824) | floor)].savedMs) |
        .sum / 4;
    def bootstrap95($data):
        ([range(0; 4096) as $sample | bootstrap_mean($data; $sample)] | sort) as $r |
        [$r[102], $r[3993]];
    $rows[0] as $data |
    (($data | map(.controlDurationMs) | add) / 4) as $controlMean |
    (($data | map(.candidateDurationMs) | add) / 4) as $candidateMean |
    (($data | map(.savedMs) | add) / 4) as $mean |
    (($data | map(.savedMs) | add) / ($data | map(.controlDurationMs) | add)) as $ratio |
    bootstrap95($data) as $interval |
    ($data | map(select(.savedMs > 0)) | length) as $positive |
    ($mean >= $spec[0].valueGate.minimumSavedMs and
     $ratio >= $spec[0].valueGate.minimumReductionRatio and
     $interval[0] > 0 and
     $positive >= $spec[0].valueGate.minimumPositivePairs and
     ($data | map(.requiredOutputSha256) | unique | length) == 1 and
     all($data[]; .requiredOutputCount > 0 and
         .candidateHotStateHit and .candidateStandardJarCacheHit and
         (.controlStandardJarCacheHit | not) and
         (.managedRuntimeStarted | not) and
         (.rootBuildGradleTestTasksExecuted | not) and
         (.productAttributableFailure | not))) as $qualified |
    {
        schemaVersion: "buildopt.evidence/poc-otel-optimization/v2",
        workItem: "POC-OTEL-STABILITY-002",
        capturedAt: $capturedAt,
        buildopt: {
            revision: $revision,
            executableSha256: $executableSha,
            packageSha256: $packageSha,
            packageVersion: "0.3.0-dev",
            candidateSurface: $spec[0].measurement.candidateSurface,
            launcherOverheadIncluded: true,
            runnerScriptSha256: $runnerSha,
            rootTestGuardScriptSha256: $guardSha
        },
        specSha256: $specSha,
        repository: {
            nameWithOwner: $spec[0].repository.nameWithOwner,
            revision: $spec[0].repository.revision,
            sourceArchiveSha256: $sourceSha
        },
        runner: $spec[0].runner,
        preparation: {
            onlinePreflightMeasured: false,
            onlinePreflightSuccess: true,
            onlinePreflightWallClockMs: $preflightMs,
            measuredNetwork: "DISCONNECTED",
            dependencyMode: "GRADLE_OFFLINE_WITH_SHARED_READ_ONLY_CACHE",
            readOnlyDependencyCacheSha256: $readOnlyCacheSha,
            buildCacheSeedSha256: $cacheSha,
            candidateBuildCacheSeedSha256: $candidateCacheSha,
            preflightDaemonStoppedBeforeArmSetup: true,
            cacheSeedRestoredBeforeEveryArm: true,
            sharedCheckout: true,
            sharedGradleUserHome: true,
            sharedDaemon: true,
            controlStandardJarCacheEligibility: false,
            candidateStandardJarCacheEligibility: true,
            outputsRemovedBeforeEveryArm: true,
            fixedMutationAppliedAfterCacheRestore: true
        },
        discovery: {
            complete: true,
            containsTestTasks: false,
            graphSha256: $graphSha,
            graphDigest: $spec[0].discovery.expectedGraphDigest,
            projectCount: $spec[0].discovery.expectedProjectCount,
            controlReachCount: $spec[0].control.expectedReachedProjectCount,
            candidateReachCount: $spec[0].candidate.expectedReachedProjectCount,
            controlEntrypointsFileSha256: $spec[0].control.entrypointsFileSha256,
            candidateEntrypoints: $spec[0].candidate.entrypoints,
            exactBoundHotStateEnabled: true,
            measuredCandidateHotStateHits: ($data | map(.candidateHotStateHit) | all),
            measuredCandidateStandardJarCacheHits:
                ($data | map(.candidateStandardJarCacheHit) | all)
        },
        observations: $data,
        fallback: {
            changePath: $spec[0].fallback.changePath,
            mode: "FULL_GRAPH",
            reason: "IMPACT_GLOBAL_CHANGE",
            entrypointsFileSha256: $spec[0].control.entrypointsFileSha256,
            outsideCandidateEntrypointObserved: ":instrumentation:spring:spring-webmvc:spring-webmvc-6.0:javaagent:testClasses",
            buildSuccessful: true,
            performanceClaim: false
        },
        result: {
            pairs: 4,
            controlMeanMs: $controlMean,
            candidateMeanMs: $candidateMean,
            meanSavedMs: $mean,
            reductionRatio: $ratio,
            interval95SavedMs: $interval,
            positivePairs: $positive,
            qualified: $qualified,
            decision: (if $qualified then
                $spec[0].terminalDecisions.qualifies
                else $spec[0].terminalDecisions.failsValueGate end)
        },
        boundaries: $spec[0].boundaries
    }
' >"${buildopt_root}/result.json"

install -m 0600 "${buildopt_root}/result.json" "${buildopt_output}"
buildopt_completed=true
printf 'OpenTelemetry Spring-family evidence captured: %s\n' "${buildopt_output}"
