buildopt_captured_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
buildopt_cpu_count=$(getconf _NPROCESSORS_ONLN)
buildopt_memory_bytes=$(awk '/MemTotal:/ {print $2 * 1024}' /proc/meminfo)
jq -n \
    --arg capturedAt "${buildopt_captured_at}" --arg revision "${buildopt_revision}" \
    --arg packageSha "${buildopt_package_sha}" --arg kernel "$(uname -r)" \
    --argjson cpuCount "${buildopt_cpu_count}" --argjson memoryBytes "${buildopt_memory_bytes%.*}" \
