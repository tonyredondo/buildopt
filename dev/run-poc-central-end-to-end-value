        ktor ktorio/ktor 6847064 https://github.com/ktorio/ktor.git \
        bc7de799f4eb997a63250f2f70492d85f5c92f50 \
        ktor-server/ktor-server-plugins/ktor-server-webjars/jvm/src/io/ktor/server/webjars/Webjars.kt \
