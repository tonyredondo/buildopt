if ! buildopt_subject_completed apache/beam; then
    buildopt_subject \
        beam apache/beam 5090421 https://github.com/apache/beam.git \
        dd896e2b2395937201b7721251d9f66936f9340c \
        examples/java/twitter/src/main/java/org/apache/beam/examples/twitterstreamgenerator/TwitterConfig.java \
        BEAM_JAVA_GROOVY \
        gradle-8.14.3/linux-amd64/jdk-21/beam-java-twitter \
        TREE examples/java/twitter/build/classes/java/main \
        LEAF_SOURCE 28444 \
        classes --daemon --build-cache --parallel --no-configuration-cache --console=plain \
        --no-scan --max-workers="${buildopt_max_workers}"
