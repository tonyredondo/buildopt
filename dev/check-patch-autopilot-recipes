#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
cd "${buildopt_repo_root}"

jq -e '
  .schemaVersion == "buildopt.specs/patch-autopilot-recipes/v1" and
  .trackerId == "PA-F2-002" and
  (.recipes | length) == 2 and
  .recipes[0] == {
    id:"ARCHIVE_REPRODUCIBILITY_GROOVY_DSL_V1", version:"1.0",
    path:"build.gradle", maximumPostimageBytes:1048576,
    transformation:"APPEND_EXACT_ABSTRACT_ARCHIVE_TASK_CONFIGURATION",
    validationAdapter:"ARCHIVE_CONTENTS_V1"
  } and
  .recipes[1] == {
    id:"GRADLE_BUILD_CACHE_PROPERTIES_V1", version:"1.0",
    path:"gradle.properties", maximumPostimageBytes:1048576,
    transformation:"APPEND_EXACT_ORG_GRADLE_CACHING_TRUE",
    validationAdapter:"ARCHIVE_CONTENTS_V1"
  } and
  .source == {
    encoding:"STRICT_UTF8", lineEnding:"LF", finalNewlineRequired:true,
    operation:"MODIFY_EXACT_REPLACEMENT", ownership:"DEFENSIVE_BYTES"
  } and
  .selection.risk == "LOW" and
  .promotion == {
    candidateControlRequired:true, fullRelevantValidationRequired:true,
    delivery:"DRAFT_ONLY", exactInverseProof:"PA-F2-003"
  } and
  .testOptimizationChanged == false and .remoteMutationPerformed == false
' specs/patch-autopilot-recipes-v1.json >/dev/null

./dev/check-patch-autopilot-recipe-registry
printf 'PA-F2-002 recipes OK: Groovy archives and root build-cache properties are exact and fail closed\n'
