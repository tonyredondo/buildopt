    "contracts/test-vectors/http-semantics"
    "contracts/test-vectors/signatures"
    "contracts/test-vectors/state-machines"
    "specs"
)

buildopt_required_indexes=(
    "adr/README.md"
    "benchmarks/README.md"
    "contracts/README.md"
    "contracts/jsonschema/README.md"
    "contracts/metrics/README.md"
    "contracts/openapi/README.md"
    "contracts/proto/README.md"
    "contracts/proto/local-events/v1/README.md"
    "contracts/test-vectors/README.md"
    "contracts/test-vectors/canonical-json/README.md"
    "contracts/test-vectors/compatibility/README.md"
    "contracts/test-vectors/http-semantics/README.md"
    "contracts/test-vectors/signatures/README.md"
    "contracts/test-vectors/state-machines/README.md"
    "specs/README.md"
)

buildopt_planned_artifacts=(
    "contracts/jsonschema/build-session.v1.schema.json"
    "contracts/metrics/build-impact-v1.json"
    "contracts/jsonschema/experiment-result.v1.schema.json"
