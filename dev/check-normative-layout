    buildopt_parent=${buildopt_path%/*}
    buildopt_namespace=${buildopt_path%%/*}
    buildopt_relative_path=${buildopt_path#*/}
    buildopt_index="${buildopt_repo_root}/${buildopt_namespace}/README.md"

    if [[ ! -d "${buildopt_repo_root}/${buildopt_parent}" ]]; then
        printf 'missing parent namespace for planned artifact: %s\n' \
            "${buildopt_path}" >&2
        buildopt_failed=1
    fi
    if [[ -s "${buildopt_index}" ]] &&
        ! grep -Fq -- "\`${buildopt_relative_path}\`" "${buildopt_index}"; then
        printf 'planned artifact is absent from its namespace index: %s\n' \
            "${buildopt_path}" >&2
        buildopt_failed=1
    fi
    if [[ -e "${buildopt_repo_root}/${buildopt_path}" ]] &&
        [[ ! -s "${buildopt_repo_root}/${buildopt_path}" ]]; then
        printf 'planned normative artifact is empty: %s\n' \
            "${buildopt_path}" >&2
        buildopt_failed=1
    fi
done

for buildopt_path in "${buildopt_materialized_artifacts[@]}"; do
    if [[ ! -s "${buildopt_repo_root}/${buildopt_path}" ]]; then
        printf 'missing or empty materialized normative artifact: %s\n' \
            "${buildopt_path}" >&2
        buildopt_failed=1
    fi
done

