#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [RESULT_FILE]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(CDPATH='' cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-kafka-impact-edge-composition-v1.json"
buildopt_result=${1:-"${buildopt_repo_root}/benchmarks/results/poc-kafka-impact-edge-composition-v1.json"}

for buildopt_command in git jq sha256sum; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required Kafka Impact/Edge result command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
[[ -s "${buildopt_result}" ]] || {
    printf 'Kafka Impact/Edge composition result is unavailable: %s\n' \
        "${buildopt_result}" >&2
    exit 1
}
"${buildopt_script_dir}/check-poc-kafka-impact-edge-composition-v1" >/dev/null

buildopt_before=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_runner_sha=$(sha256sum \
    "${buildopt_script_dir}/run-poc-kafka-impact-edge-composition-v1" | awk '{print $1}')
buildopt_harness_sha=$(sha256sum \
    "${buildopt_repo_root}/internal/sharedcache/poc_kafka_impact_edge_composition_test.go" | awk '{print $1}')
buildopt_impact_sha=$(sha256sum \
    "${buildopt_repo_root}/benchmarks/results/poc-kafka-packaging-v1.json" | awk '{print $1}')
buildopt_edge_sha=$(sha256sum \
    "${buildopt_repo_root}/benchmarks/results/poc-remote-cache-transfer-v1.json" | awk '{print $1}')
buildopt_invalid_sha=$(sha256sum \
    "${buildopt_repo_root}/benchmarks/results/poc-qualified-remote-composition-v1.json" | awk '{print $1}')

jq -e \
    --arg specSha "${buildopt_spec_sha}" \
    --arg runnerSha "${buildopt_runner_sha}" \
    --arg harnessSha "${buildopt_harness_sha}" \
    --arg impactSha "${buildopt_impact_sha}" \
    --arg edgeSha "${buildopt_edge_sha}" \
    --arg invalidSha "${buildopt_invalid_sha}" \
    --slurpfile spec "${buildopt_spec}" '
    def sha256: type == "string" and test("^[0-9a-f]{64}$");
    def bootstrap_mean($data; $sample):
        reduce range(0; 4) as $draw
            ({state: ((2654435761 * ($sample + 1)) % 4294967296), sum: 0};
             .state = ((1664525 * .state + 1013904223) % 4294967296) |
             .sum += $data[((.state / 1073741824) | floor)].savedMs) |
        .sum / 4;
    def bootstrap95($data):
        ([range(0; 4096) as $sample | bootstrap_mean($data; $sample)] | sort) as $r |
        [$r[102], $r[3993]];
    .observations as $data |
    (($data | map(.controlDurationMs) | add) / 4) as $controlMean |
    (($data | map(.candidateDurationMs) | add) / 4) as $candidateMean |
    ($controlMean - $candidateMean) as $saved |
    (($data | map(.savedMs) | add) /
        ($data | map(.controlDurationMs) | add)) as $ratio |
    bootstrap95($data) as $interval |
    ($data | map(select(.savedMs > 0)) | length) as $positive |
    .schemaVersion == "buildopt.evidence/poc-kafka-impact-edge-composition/v1" and
    .workItem == "POC-KAFKA-IMPACT-EDGE-COMPOSITION-001" and
    .evidenceState == "TERMINAL_SAFETY_FAILURE_AFTER_MEASUREMENT" and
    (.capturedAt | fromdateiso8601) and
    .buildoptRevision == "c415e3f979dc9d8bf31c8ce96a392c8638332edf" and
    .runnerScriptSha256 == $runnerSha and .specSha256 == $specSha and
    .harnessSha256 == $harnessSha and (.failureLogArchiveSha256 | sha256) and
    .sourceArchiveSha256 == $spec[0].repository.sourceArchiveSha256 and
    (.installedAssets.binarySha256 | sha256) and
    (.installedAssets.initScriptSha256 | sha256) and
    (.installedAssets.pluginJarSha256 | sha256) and
    .componentEvidence == {
      kafkaImpactScopeSha256: $impactSha,
      kafkaEdgeLocalitySha256: $edgeSha,
      invalidJarCompositionSha256: $invalidSha
    } and
    .repository == {
      nameWithOwner: $spec[0].repository.nameWithOwner,
      releaseTag: $spec[0].repository.releaseTag,
      revision: $spec[0].repository.revision,
      gradleVersion: $spec[0].repository.gradleVersion,
      jdk: $spec[0].repository.jdk
    } and
    .runner == {id: "linux-amd64-12c-16659865600b-v1", cpuCount: 12,
      memoryBytes: 16659865600, maxWorkers: 12} and
    .network == {model: $spec[0].network.model,
      latencyPerResponseMs: $spec[0].network.latencyPerResponseMs,
      bandwidthBytesPerSecond: $spec[0].network.bandwidthBytesPerSecond,
      packetLossRatio: $spec[0].network.packetLossRatio} and
    .preparation == {measured: false, capturedObjectCount: 60,
      capturedObjectBytes: 168442184,
      sharedMaximumObjectBytes: $spec[0].cacheState.sharedMaximumObjectBytes,
      oversizedObjectsExcludedBeforeSharedCommit: true,
      partialStateReused: false} and
    .mechanisms == {buildImpact: true, edgeLocality: true,
      standardJarAdapter: false, standardCopyAdapter: false, safeCache: false,
      runtimeTuning: false, hotState: false, testOptimization: false} and
    .measurementAssertions == {allPairsAcceptedBeforeSafetyFailure: true,
      sameCachedOutputInEveryMeasuredArm: true,
      shadowJarFromCacheInEveryMeasuredArm: true,
      candidateOriginTrafficZeroInEveryPair: true,
      candidatePlanSelectedInEveryPair: true,
      controlFullGraphInEveryPair: true,
      standardJarAdapterAbsent: true,
      productAttributableFailures: 0} and
    ($data | length) == 4 and [$data[].pair] == [1, 2, 3, 4] and
    [$data[].order] == $spec[0].measurement.pairOrder and
    all($data[]; .controlDurationMs > 0 and .candidateDurationMs > 0 and
      .savedMs == (.controlDurationMs - .candidateDurationMs)) and
    .safety.impactFallbackPassed == true and
    .safety.edgeFailureBuildSucceeded == true and
    .safety.edgeFailureRemoteCacheDisabled == true and
    .safety.edgeFailureRequiredOutputProduced == true and
    .safety.edgeFailureOutputExact == false and
    (.safety.edgeFailureLogSha256 | sha256) and
    (.safety.impactFallbackLogSha256 | sha256) and
    .result == {pairs: 4, controlMeanMs: $controlMean,
      candidateMeanMs: $candidateMean, meanSavedMs: $saved,
      reductionRatio: $ratio, interval95SavedMs: $interval,
      positivePairs: $positive, performanceGatePassed: true,
      qualified: false,
      decision: $spec[0].decisionPolicy.unqualifiedDecision} and
    .terminalDiagnostic == {phase: "EDGE_FAILURE_FALLBACK_OUTPUT_VALIDATION",
      reason: "CUSTOM_SHADOW_JAR_REBUILT_DIFFERENT_BYTES",
      timingsMayBeReportedAsDiagnosticOnly: true,
      compositionSavingsMayBeClaimed: false,
      nextAction: "ATTRIBUTE_AND_STABILIZE_CUSTOM_SHADOW_JAR_REPRODUCIBILITY_BEFORE_RECOMPOSITION"} and
    .boundaries == $spec[0].boundaries
' "${buildopt_result}" >/dev/null

buildopt_after=$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)
if [[ "${buildopt_before}" != "${buildopt_after}" ]]; then
    printf 'Kafka Impact/Edge result validation changed the working tree\n' >&2
    exit 1
fi
printf 'POC Kafka Impact/Edge terminal evidence OK: %s\n' "${buildopt_result}"
