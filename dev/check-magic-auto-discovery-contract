#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [contract.json]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_contract=${1:-"${buildopt_root}/specs/poc-magic-auto-discovery-v1.json"}

jq -e '
    keys == [
        "authority", "customerCommand", "derivation", "discoveredDecision",
        "generatedDocuments", "manualBuildOptFilesRequired", "nativeFallbackReasons",
        "schemaVersion", "storage", "supportedFixtureFamilies", "workItem"
    ] and
    .schemaVersion == "buildopt.poc/magic-auto-discovery/v1" and
    .workItem == "POC-MAGIC-AUTO-DISCOVERY-001" and
    .customerCommand == "buildopt optimize <gradle args...>" and
    .manualBuildOptFilesRequired == 0 and
    .derivation.wrapper == "REPOSITORY_GRADLE_WRAPPER" and
    .derivation.workflow == "GRADLE_ARGUMENT_VECTOR" and
    .derivation.target == "IMMUTABLE_HEAD" and
    .derivation.changes == "EXACT_BASE_TO_HEAD_GIT_DIFF" and
    .derivation.outputs == "NON_EMPTY_GRADLE_DECLARED_REPOSITORY_OUTPUTS" and
    .derivation.graph == "TYPED_COMPLETE_GRADLE_PROJECT_AND_TASK_RELATIONSHIPS" and
    .supportedFixtureFamilies == ["PACKAGING", "VERIFICATION", "DISTRIBUTION", "TEST_PREPARATION"] and
    .discoveredDecision == {
        outcome: "LEARNING", reason: "STRUCTURAL_CANDIDATE_DISCOVERED",
        phase: "DISCOVERED", bindingCompleteness: "DISCOVERY_COMPLETE",
        nativeAuthoritative: true, calibrationPerformed: false, selectionPerformed: false
    } and
    (.nativeFallbackReasons | length) == 22 and
    (.nativeFallbackReasons | index("GLOBAL_CHANGE_REQUIRES_FULL_GRAPH")) != null and
    (.nativeFallbackReasons | index("ORIGINAL_WORKFLOW_UNSUPPORTED")) != null and
    (.nativeFallbackReasons | index("BASE_REVISION_AMBIGUOUS")) != null and
    .generatedDocuments == [
        "changes.txt", "output-contract.json", "manifest.json", "graph.json",
        "generated-manifest.json", "fallback-changes.txt", "proposal.json"
    ] and
    .storage == {
        root: ".buildopt/optimize/v1/discovery",
        permissions: "CURRENT_USER_PRIVATE", writeBehavior: "ATOMIC_PRIVATE_REPLACE",
        rawGradleArgumentsPersisted: false, absoluteRepositoryPathPersisted: false
    } and
    .authority == {
        proofOfConcept: true, reviewRequired: true, nativeGradleAuthoritative: true,
        automaticActivation: false, productionAuthorized: false,
        performanceClaimCreated: false, testOptimization: "OUT_OF_SCOPE"
    }
' "${buildopt_contract}" >/dev/null

grep -F 'optimizeDiscoveryReasonFound = "STRUCTURAL_CANDIDATE_DISCOVERED"' \
    "${buildopt_root}/internal/launcher/optimize_discovery.go" >/dev/null
grep -F 'optimizeBindingDiscovery    = "DISCOVERY_COMPLETE"' \
    "${buildopt_root}/internal/launcher/optimize.go" >/dev/null

printf 'Magic automatic-discovery contract OK\n'
