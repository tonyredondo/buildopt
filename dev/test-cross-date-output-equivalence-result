#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_source="${buildopt_repo_root}/benchmarks/results/poc-cross-date-output-equivalence-v1"
buildopt_temp=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-cross-date-test.XXXXXX")

buildopt_cleanup() {
    if [[ ${buildopt_temp} == "${TMPDIR:-/tmp}/buildopt-cross-date-test."* ]]; then
        rm -rf -- "${buildopt_temp}"
    fi
}
trap buildopt_cleanup EXIT

"${buildopt_script_dir}/check-cross-date-output-equivalence-result" "${buildopt_source}"
cp -a -- "${buildopt_source}/." "${buildopt_temp}/"

jq '.aggregation.crossDateMatches = 5' "${buildopt_temp}/summary.json" \
    >"${buildopt_temp}/summary-mutated.json"
mv -- "${buildopt_temp}/summary-mutated.json" "${buildopt_temp}/summary.json"
if "${buildopt_script_dir}/check-cross-date-output-equivalence-result" "${buildopt_temp}" \
    >/dev/null 2>&1; then
    printf 'checker accepted a tampered cross-date summary\n' >&2
    exit 1
fi

cp -- "${buildopt_source}/summary.json" "${buildopt_temp}/summary.json"
jq '.controlledDateBoundary.reviewedContractMatched = false' \
    "${buildopt_temp}/apache-groovy-jar-leaf-source/probe.json" \
    >"${buildopt_temp}/apache-groovy-jar-leaf-source/probe-mutated.json"
mv -- "${buildopt_temp}/apache-groovy-jar-leaf-source/probe-mutated.json" \
    "${buildopt_temp}/apache-groovy-jar-leaf-source/probe.json"
if "${buildopt_script_dir}/check-cross-date-output-equivalence-result" "${buildopt_temp}" \
    >/dev/null 2>&1; then
    printf 'checker accepted a tampered Groovy date probe\n' >&2
    exit 1
fi

printf 'Cross-date output-equivalence negative fixtures OK\n'
