#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_contract="${buildopt_repo_root}/specs/beta-disk-faults-v1.json"
buildopt_manifest="${buildopt_repo_root}/benchmarks/beta-v1.yaml"

for buildopt_command in git jq; do
    if ! command -v "${buildopt_command}" >/dev/null 2>&1; then
        printf 'required beta disk-fault command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    fi
done

if ! jq -e '
    keys == [
        "boundaries",
        "commands",
        "deliverableId",
        "evidence",
        "execution",
        "exitGateId",
        "faults",
        "gateId",
        "manifest",
        "schemaVersion"
    ] and
    .schemaVersion == "buildopt.specs/beta-disk-faults/v1" and
    .gateId == "OPS-001/A1" and
    .deliverableId == "A1-003" and
    .exitGateId == "A1-G03" and
    .manifest == "benchmarks/beta-v1.yaml" and
    .commands == {
        run: "beta-benchmark disk-faults --manifest PATH --state-dir ABSOLUTE_PATH --output-dir ABSOLUTE_PATH",
        validate: "beta-benchmark validate-disk-faults --manifest PATH --result PATH"
    } and
    .faults == [
        {
            id: "DISK_HIGH_WATERMARK",
            expectedSafety: "EVICT_TO_LOW_OR_STOP_PUT",
            triggerSequence: 1,
            events: [
                "PROJECTED_HIGH_WATERMARK",
                "EVICTED_TO_LOW_WATERMARK",
                "AUTHORITY_REMOVED_BEFORE_BLOB_CLEANUP",
                "PHYSICAL_ORPHANS_COLLECTED"
            ],
            recovery: "EVICTED_TO_LOW_AND_VERIFIED"
        },
        {
            id: "DISK_OUT_OF_SPACE",
            expectedSafety: "STOP_PUT_BEFORE_READ_CORRUPTION",
            triggerSequence: 5,
            events: [
                "DISK_AVAILABILITY_BELOW_REQUEST",
                "PUT_REJECTED_BEFORE_BODY_READ",
                "NO_PARTIAL_AUTHORITY",
                "PUT_RECOVERED_AFTER_AVAILABILITY"
            ],
            recovery: "PUT_ACCEPTED_AFTER_DISK_RECOVERY"
        }
    ] and
    .execution == {
        qualification: "FAULT_SLICE",
        transport: "REAL_LOOPBACK_HTTP",
        storage: "REAL_SINGLE_NODE_SHARED",
        capacityBytes: 1000,
        objectBytes: 100,
        highWatermarkBytes: 850,
        lowWatermarkBytes: 750,
        stableBytesBeforeTrigger: 800,
        stableBytesAfterEviction: 700,
        physicallyCollectedBlobs: 2,
        outOfSpaceAvailableBytes: 50,
        outOfSpaceRequestBytes: 60,
        outOfSpaceHttpStatus: 413,
        rejectedBodyReadBytes: 0,
        recoveryHttpStatus: 201
    } and
    .evidence == {
        rawSchema: "buildopt.benchmarks/disk-fault-observation/v1",
        resultSchema: "buildopt.benchmarks/disk-fault-result/v1",
        rawObservations: 8,
        privateMode: "0600",
        manifestDigestBound: true,
        rawDigestBound: true,
        unknownFieldsRejected: true,
        tamperRejected: true
    } and
    .boundaries == {
        closes: [
            "OPS-001/A1-DISK-FAULTS",
            "A1-003",
            "A1-G03"
        ],
        doesNotClose: [
            "OPS-001/A1",
            "A1-G02",
            "A1-G04",
            "FAULT_MATRIX_REMAINING_13",
            "SUSTAINED_60_MINUTES",
            "EIGHT_HOUR_SOAK",
            "GOLDEN_LANE_RESULT"
        ]
    }
' "${buildopt_contract}" >/dev/null; then
    printf 'beta disk-fault contract is malformed\n' >&2
    exit 1
fi

buildopt_before_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)
buildopt_temp_root=$(mktemp -d)
trap 'rm -rf -- "${buildopt_temp_root}"' EXIT
buildopt_state="${buildopt_temp_root}/state"
buildopt_output="${buildopt_temp_root}/output"
buildopt_result="${buildopt_output}/disk-fault-result.json"

cd -- "${buildopt_repo_root}"
"${buildopt_script_dir}/run" --toolchain go -- \
    go run ./cmd/beta-benchmark disk-faults \
    --manifest "${buildopt_manifest}" \
    --state-dir "${buildopt_state}" \
    --output-dir "${buildopt_output}"
"${buildopt_script_dir}/run" --toolchain go -- \
    go run ./cmd/beta-benchmark validate-disk-faults \
    --manifest "${buildopt_manifest}" \
    --result "${buildopt_result}"
"${buildopt_script_dir}/run" --toolchain go -- \
    go test -race -count=1 \
    ./internal/betabenchmark \
    ./internal/sharedcache \
    -run \
    "^(TestRunDiskFaultsProducesBoundTamperEvidentEvidence|TestCapacityPolicyCannotExpandPrivateBetaBounds|TestPendingAdmissionStopsBeforeDiskExhaustion|TestByteSLRUWatermarksAndStableTTL)$"
"${buildopt_script_dir}/run" --toolchain go -- \
    go vet ./internal/betabenchmark ./cmd/beta-benchmark ./internal/sharedcache

buildopt_after_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)
if [[ "${buildopt_after_status}" != "${buildopt_before_status}" ]]; then
    printf 'beta disk-fault checker changed the working tree\n' >&2
    exit 1
fi

printf 'OPS-001/A1 disk faults OK: 800+100 crossed 850 and evicted to 700; 60-byte PUT at 50 available returned 413 before 0 body bytes and recovered\n'
