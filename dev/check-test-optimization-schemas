#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)

cd -- "${buildopt_repo_root}/dev/schema-validator"
exec "${buildopt_script_dir}/run" \
    --toolchain go \
    -- \
    go test \
        -count=1 \
        -run 'TestTestOptimization(V1Fixtures|SemanticBindingsV1|ValidatorEntrypoints)$' \
        .
