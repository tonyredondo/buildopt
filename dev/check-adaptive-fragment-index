#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_evidence="${buildopt_repo_root}/benchmarks/results/adaptive-fragment-lookup-v1-local.json"
buildopt_policy="${buildopt_repo_root}/specs/poc-adaptive-fragment-index-v1.json"
buildopt_temp_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-af003.XXXXXX")
trap 'rm -r -- "${buildopt_temp_root}"' EXIT

for buildopt_command in grep jq mktemp; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'adaptive fragment index check requires %s\n' "${buildopt_command}" >&2
        exit 1
    }
done

jq -e '
    .schemaVersion == "buildopt.specs/poc-adaptive-fragment-index/v1" and
    .workItem == "AF-003" and
    .fingerprints == [
        "GIT_REVISION_PROVENANCE",
        "GRADLE_WRAPPER",
        "WORKFLOW",
        "PRODUCER_LINEAGE",
        "OUTPUT_CONTRACT",
        "CHANGE_FAMILY"
    ] and
    .gate == {
        minimumRepositories: 5,
        minimumDecisions: 30,
        medianMsExclusiveMaximum: 500,
        p95MsExclusiveMaximum: 1000,
        maximumGradleStarts: 0,
        maximumRemoteCalls: 0,
        maximumOutputMaterializations: 0,
        maximumLifecycleMutations: 0
    } and
    .outcome == "FAST_FRAGMENT_LOOKUP_AVAILABLE" and
    .boundaries.activationAuthorized == false and
    .boundaries.buildTimingClaim == false and
    .boundaries.productionAuthorized == false and
    .boundaries.testOptimization == "OUT_OF_SCOPE"
' "${buildopt_policy}" >/dev/null

cd -- "${buildopt_repo_root}"
"${buildopt_script_dir}/run" --toolchain go -- \
    go test -count=1 ./internal/adaptivefragment ./dev/adaptive-fragment-index
"${buildopt_script_dir}/run" --toolchain go -- \
    go vet ./internal/adaptivefragment ./dev/adaptive-fragment-index
buildopt_direct_imports=$("${buildopt_script_dir}/run" --toolchain go -- \
    go list -f '{{range .Imports}}{{println .}}{{end}}' \
    ./internal/adaptivefragment ./dev/adaptive-fragment-index)
if grep -Eq '^(net|net/.*|os/exec)$' <<<"${buildopt_direct_imports}"; then
    echo "adaptive fragment lookup imports process or network execution" >&2
    exit 1
fi
"${buildopt_script_dir}/run" --toolchain go -- \
    go run ./dev/adaptive-fragment-index --validate "${buildopt_evidence}" >/dev/null
"${buildopt_script_dir}/run" --toolchain go -- \
    go run ./dev/adaptive-fragment-index \
    --output "${buildopt_temp_root}/live-report.json"
"${buildopt_script_dir}/run" --toolchain go -- \
    go run ./dev/adaptive-fragment-index \
    --validate "${buildopt_temp_root}/live-report.json" >/dev/null

jq '.summary.p95Ms += 1' "${buildopt_evidence}" >"${buildopt_temp_root}/tampered-report.json"
if "${buildopt_script_dir}/run" --toolchain go -- \
    go run ./dev/adaptive-fragment-index \
    --validate "${buildopt_temp_root}/tampered-report.json" >/dev/null 2>&1; then
    echo "adaptive fragment index accepted a tampered summary" >&2
    exit 1
fi

echo "adaptive fragment index: FAST_FRAGMENT_LOOKUP_AVAILABLE"
