#!/usr/bin/env bash
set -euo pipefail

buildopt_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${buildopt_repo_root}"

jq -e '
  .schemaVersion == "buildopt.specs/runtime-rollout-control/v1" and
  .trackerId == "B-008" and
  .budget.rollingSevenDayMaximumPercent == 5 and
  .budget.rollingTwentyFourHourMaximumPercent == 10 and
  .budget.maximumConcurrentValidationPerRepository == 1 and
  (.budget.naturalAssignmentCharged | not) and
  (.budget.borrowingAllowed | not) and
  .budget.repositoryMayOnlyReduce and
  .rollout.directReversibleBasisPoints == [500, 2500, 5000, 9500] and
  .rollout.proofGatedStages == ["SHADOW", "CANARY_1", "CANARY_5", "CANARY_25", "CANARY_50", "ACTIVE_95"] and
  .rollout.permanentControlBasisPoints == 500 and
  .rollout.maximumStageAdvancePerDecision == 1 and
  .suspendOn == ["INCOMPLETE_TELEMETRY", "DRIFT", "ARTIFACT_DIVERGENCE", "ATTRIBUTABLE_FAILURE", "OOM", "SUSTAINED_SWAPPING", "P95_REGRESSION", "QUEUE_REGRESSION"] and
  .fallback.beforeTaskActions == "RETRY_IMMUTABLE_ORIGINAL_ONCE" and
  .fallback.afterTaskActions == "ISOLATED_BASELINE_OR_PROVEN_NO_EFFECTS_ONLY" and
  .fallback.unsafeRetry == "PRESERVE_FAILURE_AND_REQUIRE_KILL_SWITCH" and
  .killSwitch.signature == "ED25519_PINNED_KEY" and
  .killSwitch.generation == "STRICTLY_MONOTONIC" and
  .killSwitch.enableDisposition == "SUSPEND_ALL_AND_STABLE_CONTROL" and
  .killSwitch.disableDisposition == "REVALIDATION_REQUIRED" and
  .closesGates == ["B-G02", "B-G06"] and
  .doesNotClose == ["A1-001", "A1-006", "A1-G06", "B-G01", "B-G03"]
' specs/runtime-rollout-control-v1.json >/dev/null

./dev/check-ci-orchestration
./dev/check-runtime-validation-isolation
go test -race ./internal/runtimeoptimizer -run 'Test(Rollout|ProofRollout|ExplicitRollback|SignedKill|Fallback)'
go vet ./internal/runtimeoptimizer
printf 'B-008 rollout control OK: rolling budgets, exact stages/control, fallback, rollback, signed kill switch; B-G02/B-G06 closed\n'
