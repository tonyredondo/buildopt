#!/usr/bin/env bash
set -euo pipefail

if (($# != 2)); then
    printf 'usage: dev/run-change-aware-public-capture HISTORY_ROOT OUTPUT_DIR\n' >&2
    exit 64
fi

buildopt_history_root=$1
buildopt_output=$2
buildopt_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
buildopt_cohort=${buildopt_root}/benchmarks/results/fresh-generic-optimization-v1/cohort.json
[[ ${buildopt_history_root} == /* && -d ${buildopt_history_root} ]] || {
    printf 'history root must be an existing absolute directory\n' >&2
    exit 1
}
[[ ${buildopt_output} == /* && ! -e ${buildopt_output} ]] || {
    printf 'output must be a new absolute path\n' >&2
    exit 1
}
for buildopt_command in awk date find git jq mktemp sha256sum sort xargs; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf '%s is required\n' "${buildopt_command}" >&2
        exit 1
    }
done

buildopt_temporary=$(mktemp -d /tmp/buildopt-change-aware-public.XXXXXX)
buildopt_worktree=
buildopt_worktree_history=
buildopt_cleanup_worktree() {
    if [[ -n ${buildopt_worktree:-} && -n ${buildopt_worktree_history:-} && -e ${buildopt_worktree} ]]; then
        git -C "${buildopt_worktree_history}" worktree remove --force "${buildopt_worktree}" >/dev/null 2>&1 || true
    fi
    buildopt_worktree=
    buildopt_worktree_history=
}
buildopt_cleanup() {
    buildopt_cleanup_worktree
    case ${buildopt_temporary} in
        /tmp/buildopt-change-aware-public.*)
            rm -rf -- "${buildopt_temporary}"
            ;;
        *)
            printf 'refusing to clean unexpected capture root: %s\n' "${buildopt_temporary}" >&2
            return 1
            ;;
    esac
}
trap buildopt_cleanup EXIT

mkdir -p -- "${buildopt_output}/captures" "${buildopt_output}/reports"
buildopt_analyzer=${buildopt_temporary}/change-aware-producer
"${buildopt_root}/dev/run" --toolchain go -- go build -o "${buildopt_analyzer}" ./cmd/change-aware-producer
: >"${buildopt_output}/transitions.jsonl"

buildopt_generated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
jq -n \
    --arg generatedAt "${buildopt_generated_at}" \
    --arg cohortSha256 "$(sha256sum "${buildopt_cohort}" | awk '{print $1}')" \
    --arg producerSha256 "$(sha256sum "${buildopt_root}/dev/change-aware-producer.init.gradle" | awk '{print $1}')" '
  {
    schemaVersion:"buildopt.poc/change-aware-public-capture-contract/v1",
    workItem:"SWL-CHANGE-001",
    generatedAt:$generatedAt,
    cohortSha256:$cohortSha256,
    producerSha256:$producerSha256,
    selectionPolicy:"REVERSE_CHRONOLOGICAL_PRIMARY_THEN_RESERVE_TARGETS_WITH_FIRST_PARENT_BASE_UNTIL_FIVE_CONCLUSIVE_TRANSITIONS",
    requiredConclusiveTransitionsPerFamily:5,
    ordinaryRequestedBuildsOnly:true,
    historicalBuildOptStateImported:false,
    historicalTimingImported:false,
    performanceMeasured:false,
    activationAuthorized:false
  }
' >"${buildopt_output}/contract.json"

buildopt_boundary_capture() {
    local buildopt_path=$1
    local buildopt_family=$2
    local buildopt_dsl=$3
    local buildopt_base=$4
    local buildopt_target=$5
    local buildopt_status=$6
    local buildopt_reason=$7
    local buildopt_changed_json=$8
    local buildopt_requested_json=$9
    local buildopt_outputs_json=${10}
    jq -n \
        --arg generatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg family "${buildopt_family}" --arg dsl "${buildopt_dsl}" \
        --arg base "${buildopt_base}" --arg target "${buildopt_target}" \
        --arg status "${buildopt_status}" --arg reason "${buildopt_reason}" \
        --argjson changedPaths "${buildopt_changed_json}" \
        --argjson requestedTasks "${buildopt_requested_json}" \
        --argjson requiredOutputs "${buildopt_outputs_json}" '
      {
        schemaVersion:"buildopt.poc/change-aware-producer-capture/v1",
        generatedAt:$generatedAt,family:$family,dsl:$dsl,
        baseRevision:$base,targetRevision:$target,status:$status,reason:$reason,
        changedPaths:$changedPaths,requestedTasks:$requestedTasks,
        requiredOutputs:$requiredOutputs,tasks:[]
      }
    ' >"${buildopt_path}"
}

mapfile -t buildopt_families < <(jq -r '.families[].family' "${buildopt_cohort}")
for buildopt_family in "${buildopt_families[@]}"; do
    buildopt_history=${buildopt_history_root}/${buildopt_family}
    git -C "${buildopt_history}" rev-parse --git-dir >/dev/null 2>&1 || {
        printf 'missing Git history for %s\n' "${buildopt_family}" >&2
        exit 1
    }
    buildopt_dsl=$(jq -r --arg family "${buildopt_family}" '.families[] | select(.family==$family) | .dsl' "${buildopt_cohort}")
    buildopt_jdk=$(jq -r --arg family "${buildopt_family}" '.families[] | select(.family==$family) | .jdk' "${buildopt_cohort}")
    buildopt_workflow=$(jq -r --arg family "${buildopt_family}" '.families[] | select(.family==$family) | .workflow[0]' "${buildopt_cohort}")
    buildopt_requested_json=$(jq -nc --arg workflow "${buildopt_workflow}" '[$workflow]')
    buildopt_outputs_json=$(jq -c --arg family "${buildopt_family}" '.families[] | select(.family==$family) | .requiredOutputs' "${buildopt_cohort}")
    mapfile -t buildopt_gradle_arguments < <(jq -r --arg family "${buildopt_family}" '.families[] | select(.family==$family) | .workflow[1:][]' "${buildopt_cohort}")
    mapfile -t buildopt_targets < <(jq -r --arg family "${buildopt_family}" '
        .families[] | select(.family==$family) | [(.primary | reverse),(.reserve | reverse)] | flatten | .[].sha
    ' "${buildopt_cohort}")
    buildopt_conclusive=0
    buildopt_ordinal=0

    for buildopt_target in "${buildopt_targets[@]}"; do
        ((buildopt_conclusive >= 5)) && break
        ((buildopt_ordinal += 1))
        buildopt_base=$(git -C "${buildopt_history}" rev-parse "${buildopt_target}^1")
        mapfile -d '' -t buildopt_changed_paths < <(
            git -C "${buildopt_history}" diff --name-only --diff-filter=ACMRTUXB -z "${buildopt_base}" "${buildopt_target}"
        )
        if ((${#buildopt_changed_paths[@]} == 0)); then
            buildopt_changed_json='[]'
        else
            buildopt_changed_json=$(printf '%s\0' "${buildopt_changed_paths[@]}" | jq -Rs 'split("\u0000")[:-1]')
        fi
        buildopt_slug=${buildopt_family}-$(printf '%02d' "${buildopt_ordinal}")-${buildopt_target:0:12}
        buildopt_capture=${buildopt_output}/captures/${buildopt_slug}.json
        buildopt_report=${buildopt_output}/reports/${buildopt_slug}.json
        buildopt_log=${buildopt_temporary}/${buildopt_slug}.log

        if ((${#buildopt_changed_paths[@]} == 0)); then
            buildopt_boundary_capture "${buildopt_capture}" "${buildopt_family}" "${buildopt_dsl}" \
                "${buildopt_base}" "${buildopt_target}" UNAVAILABLE NO_CHANGED_PATHS \
                "${buildopt_changed_json}" "${buildopt_requested_json}" "${buildopt_outputs_json}"
        else
            buildopt_worktree=${buildopt_temporary}/worktree
            buildopt_worktree_history=${buildopt_history}
            git -C "${buildopt_history}" worktree add --detach "${buildopt_worktree}" "${buildopt_target}" >/dev/null
            if ! env \
                BUILDOPT_CHANGE_CAPTURE_OUTPUT="${buildopt_capture}" \
                BUILDOPT_CHANGE_FAMILY="${buildopt_family}" \
                BUILDOPT_CHANGE_DSL="${buildopt_dsl}" \
                BUILDOPT_CHANGE_BASE="${buildopt_base}" \
                BUILDOPT_CHANGE_TARGET="${buildopt_target}" \
                BUILDOPT_CHANGE_PATHS="${buildopt_changed_json}" \
                BUILDOPT_CHANGE_REQUESTED_TASKS="${buildopt_requested_json}" \
                BUILDOPT_CHANGE_REQUIRED_OUTPUTS="${buildopt_outputs_json}" \
                GRADLE_USER_HOME="${buildopt_root}/.tools/gradle-user-home/local" \
                "${buildopt_root}/dev/run" --toolchain "${buildopt_jdk}" -- \
                    "${buildopt_worktree}/gradlew" "${buildopt_gradle_arguments[@]}" \
                    --project-dir "${buildopt_worktree}" \
                    -I "${buildopt_root}/dev/change-aware-producer.init.gradle" \
                    buildoptChangeAwareCapture >"${buildopt_log}" 2>&1; then
                buildopt_boundary_capture "${buildopt_capture}" "${buildopt_family}" "${buildopt_dsl}" \
                    "${buildopt_base}" "${buildopt_target}" FAILED GRADLE_CAPTURE_FAILED \
                    "${buildopt_changed_json}" "${buildopt_requested_json}" "${buildopt_outputs_json}"
            fi
            buildopt_cleanup_worktree
        fi

        # Groovy's pretty printer emits indentation on otherwise empty array
        # lines. Normalize the JSON without changing any captured value so the
        # checked evidence is stable and whitespace-clean.
        jq -c . "${buildopt_capture}" >"${buildopt_temporary}/normalized-capture.json"
        mv "${buildopt_temporary}/normalized-capture.json" "${buildopt_capture}"
        "${buildopt_analyzer}" --input "${buildopt_capture}" --output "${buildopt_report}"
        buildopt_status=$(jq -r '.status' "${buildopt_report}")
        case ${buildopt_status} in
            TESTABLE_ACTIONS | NO_SAFE_ACTION | NOT_APPLICABLE)
                ((buildopt_conclusive += 1))
                ;;
            INPUT_UNAVAILABLE | PRODUCER_FAILED) ;;
            *)
                printf 'unexpected report status for %s: %s\n' "${buildopt_slug}" "${buildopt_status}" >&2
                exit 1
                ;;
        esac
        jq -nc \
            --arg family "${buildopt_family}" --arg dsl "${buildopt_dsl}" \
            --arg base "${buildopt_base}" --arg target "${buildopt_target}" \
            --arg capture "captures/${buildopt_slug}.json" --arg report "reports/${buildopt_slug}.json" \
            --arg captureSha256 "$(sha256sum "${buildopt_capture}" | awk '{print $1}')" \
            --arg reportSha256 "$(sha256sum "${buildopt_report}" | awk '{print $1}')" \
            --argjson changedPathCount "${#buildopt_changed_paths[@]}" \
            --argjson ordinal "${buildopt_ordinal}" \
            --slurpfile result "${buildopt_report}" '
          {
            family:$family,dsl:$dsl,attemptOrdinal:$ordinal,
            baseRevision:$base,targetRevision:$target,changedPathCount:$changedPathCount,
            capture:$capture,captureSha256:$captureSha256,
            report:$report,reportSha256:$reportSha256,
            status:$result[0].status,reason:$result[0].reason,
            inputComplete:$result[0].inputComplete,
            testableActions:$result[0].testableActions,
            candidateTaskCount:($result[0].candidateTasks|length),
            omittedTaskCount:($result[0].omittedTasks|length),
            omittedOutputCount:($result[0].omittedOutputs|length),
            performanceMeasured:$result[0].performanceMeasured,
            activationAuthorized:$result[0].activationAuthorized
          }
        ' >>"${buildopt_output}/transitions.jsonl"
        printf '%s %d/5 conclusive: %s %s\n' \
            "${buildopt_family}" "${buildopt_conclusive}" "${buildopt_target:0:12}" "${buildopt_status}"
    done
done

jq -s --arg generatedAt "${buildopt_generated_at}" '
  group_by(.family) | map({
    family:.[0].family,dsl:.[0].dsl,
    attemptedTransitions:length,
    conclusiveTransitions:([.[] | select(.status=="TESTABLE_ACTIONS" or .status=="NO_SAFE_ACTION" or .status=="NOT_APPLICABLE")]|length),
    actionTransitions:([.[] | select(.status=="TESTABLE_ACTIONS")]|length),
    outcomes:(group_by(.status)|map({key:.[0].status,value:length})|from_entries),
    inputComplete:(([.[] | select(.status=="TESTABLE_ACTIONS" or .status=="NO_SAFE_ACTION" or .status=="NOT_APPLICABLE")]|length)>=5)
  }) as $families | {
    schemaVersion:"buildopt.poc/change-aware-public-capture-summary/v1",
    workItem:"SWL-CHANGE-001",generatedAt:$generatedAt,
    status:(if ([$families[].inputComplete]|all) and ($families|length)==5 then "COMPLETE" else "INCOMPLETE" end),
    familyCount:($families|length),
    completeFamilies:([$families[]|select(.inputComplete)]|length),
    families:$families,
    performanceMeasured:false,activationAuthorized:false,
    outcome:(if ([$families[].inputComplete]|all) and ($families|length)==5 then "FRESH_CHANGE_AND_PRODUCER_EVIDENCE_COMPLETE" else "FRESH_CHANGE_AND_PRODUCER_EVIDENCE_INCOMPLETE" end)
  }
' "${buildopt_output}/transitions.jsonl" >"${buildopt_output}/summary.json"

(
    cd -- "${buildopt_output}"
    find . -type f ! -name sha256sums -print0 | LC_ALL=C sort -z |
        xargs -0 sha256sum >"${buildopt_temporary}/sha256sums"
    mv "${buildopt_temporary}/sha256sums" sha256sums
)

jq -e '.status=="COMPLETE" and .completeFamilies==5' "${buildopt_output}/summary.json" >/dev/null || {
    printf 'change-aware public capture is incomplete: %s\n' "${buildopt_output}" >&2
    exit 1
}
printf 'Change-aware public capture written to %s\n' "${buildopt_output}"
