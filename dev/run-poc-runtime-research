#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)); then
    printf 'usage: %s OUTPUT_FILE\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-runtime-research-v1.json"

if [[ "${buildopt_output}" != /* || -e "${buildopt_output}" ]]; then
    printf 'invalid POC Runtime research output path\n' >&2
    exit 64
fi
for buildopt_command in awk cmp cp curl date find git grep jq mkdir mktemp \
    sed sha256sum sort tar wc; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required POC Runtime research command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
if [[ -n "$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)" ]]; then
    printf 'POC Runtime research requires a clean revision-bound checkout\n' >&2
    exit 1
fi
"${buildopt_script_dir}/check-poc-runtime-research" >/dev/null

buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-runtime-research.XXXXXX")
buildopt_stop_gradle() {
    local buildopt_checkout=$1
    local buildopt_home=$2
    if [[ -x "${buildopt_checkout}/gradlew" && -d "${buildopt_home}" ]]; then
        (
            cd "${buildopt_checkout}"
            env GRADLE_USER_HOME="${buildopt_home}" \
                "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
                ./gradlew --stop
        ) >/dev/null 2>&1 || true
    fi
}
buildopt_cleanup() {
    if [[ "${buildopt_root}" == "${TMPDIR:-/tmp}/buildopt-runtime-research."* ]]; then
        buildopt_stop_gradle "${buildopt_root}/source" "${buildopt_root}/preflight-home"
        for buildopt_arm in control candidate; do
            buildopt_stop_gradle "${buildopt_root}/${buildopt_arm}/checkout" \
                "${buildopt_root}/${buildopt_arm}/gradle-home"
        done
        rm -rf -- "${buildopt_root}"
    fi
}
trap buildopt_cleanup EXIT
chmod 0700 "${buildopt_root}"
mkdir -p -- "${buildopt_root}/source" "${buildopt_root}/preflight-home" \
    "${buildopt_root}/logs"
chmod 0700 "${buildopt_root}/preflight-home"

buildopt_revision=$(git -C "${buildopt_repo_root}" rev-parse HEAD)
buildopt_spec_sha=$(sha256sum "${buildopt_spec}" | awk '{print $1}')
buildopt_runner_sha=$(sha256sum "${BASH_SOURCE[0]}" | awk '{print $1}')
buildopt_source_archive="${buildopt_root}/spring-framework.tar.gz"
buildopt_source_url=$(jq -er '.repository.sourceArchiveUrl' "${buildopt_spec}")
buildopt_source_sha=$(jq -er '.repository.sourceArchiveSha256' "${buildopt_spec}")
curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
    --output "${buildopt_source_archive}" "${buildopt_source_url}"
[[ "$(sha256sum "${buildopt_source_archive}" | awk '{print $1}')" == \
    "${buildopt_source_sha}" ]] || {
    printf 'Spring source archive checksum mismatch\n' >&2
    exit 1
}
tar -xzf "${buildopt_source_archive}" --strip-components=1 -C "${buildopt_root}/source"

buildopt_change_path=$(jq -er '.change.path' "${buildopt_spec}")
buildopt_change_sha=$(jq -er '.change.originalSha256' "${buildopt_spec}")
[[ "$(sha256sum "${buildopt_root}/source/${buildopt_change_path}" | awk '{print $1}')" == \
    "${buildopt_change_sha}" ]] || {
    printf 'Spring Runtime research mutation source mismatch\n' >&2
    exit 1
}

buildopt_preflight_started=$(date +%s%N)
if ! (
    cd "${buildopt_root}/source"
    env -u CI GRADLE_USER_HOME="${buildopt_root}/preflight-home" \
        "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
        ./gradlew --daemon --build-cache --parallel --no-configuration-cache \
        --max-workers=12 --no-scan --stacktrace testClasses
) >"${buildopt_root}/logs/preflight.log" 2>&1; then
    tail -n 180 "${buildopt_root}/logs/preflight.log" >&2
    printf 'POC Runtime research preflight failed\n' >&2
    exit 1
fi
buildopt_preflight_finished=$(date +%s%N)
grep -Fq 'BUILD SUCCESSFUL' "${buildopt_root}/logs/preflight.log" || {
    printf 'POC Runtime research preflight lacks success marker\n' >&2
    exit 1
}
buildopt_stop_gradle "${buildopt_root}/source" "${buildopt_root}/preflight-home"

buildopt_cache_seed="${buildopt_root}/build-cache-seed.tar.gz"
tar -C "${buildopt_root}/preflight-home/caches" -czf \
    "${buildopt_cache_seed}" build-cache-1
buildopt_cache_seed_sha=$(sha256sum "${buildopt_cache_seed}" | awk '{print $1}')

for buildopt_arm in control candidate; do
    buildopt_checkout="${buildopt_root}/${buildopt_arm}/checkout"
    buildopt_home="${buildopt_root}/${buildopt_arm}/gradle-home"
    mkdir -p -- "${buildopt_checkout}" "${buildopt_home}"
    tar -xzf "${buildopt_source_archive}" --strip-components=1 -C "${buildopt_checkout}"
    cp -a -- "${buildopt_root}/preflight-home/." "${buildopt_home}/"
    rm -rf -- "${buildopt_home}/daemon" "${buildopt_home}/.tmp"
    cp -- "${buildopt_checkout}/${buildopt_change_path}" \
        "${buildopt_root}/${buildopt_arm}/changed-source.original"
done

buildopt_reset_arm() {
    local buildopt_arm=$1
    local buildopt_mutation=$2
    local buildopt_checkout="${buildopt_root}/${buildopt_arm}/checkout"
    local buildopt_home="${buildopt_root}/${buildopt_arm}/gradle-home"
    cp -- "${buildopt_root}/${buildopt_arm}/changed-source.original" \
        "${buildopt_checkout}/${buildopt_change_path}"
    (
        cd "${buildopt_checkout}"
        env -u CI GRADLE_USER_HOME="${buildopt_home}" \
            "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
            ./gradlew --daemon --offline --quiet --max-workers=12 clean
    ) >"${buildopt_root}/logs/reset-${buildopt_arm}.log" 2>&1
    rm -rf -- "${buildopt_home}/caches/build-cache-1"
    tar -C "${buildopt_home}/caches" -xzf "${buildopt_cache_seed}"
    printf '\n// buildopt-poc-runtime-research-%s\n' "${buildopt_mutation}" \
        >>"${buildopt_checkout}/${buildopt_change_path}"
}

buildopt_duration_ms=0
buildopt_started_ns=0
buildopt_finished_ns=0
buildopt_run_arm() {
    local buildopt_arm=$1
    local buildopt_log=$2
    local buildopt_checkout="${buildopt_root}/${buildopt_arm}/checkout"
    local buildopt_home="${buildopt_root}/${buildopt_arm}/gradle-home"
    local buildopt_workers=12
    if [[ "${buildopt_arm}" == candidate ]]; then
        buildopt_workers=6
    fi
    buildopt_started_ns=$(date +%s%N)
    if ! (
        cd "${buildopt_checkout}"
        env -u CI GRADLE_USER_HOME="${buildopt_home}" \
            "${buildopt_script_dir}/run" --toolchain temurin-jdk-25 -- \
            ./gradlew --daemon --offline --build-cache --parallel \
            --no-configuration-cache --console=plain \
            --max-workers="${buildopt_workers}" --no-scan --stacktrace testClasses
    ) >"${buildopt_log}" 2>&1; then
        tail -n 180 "${buildopt_log}" >&2
        printf 'POC Runtime research %s arm failed\n' "${buildopt_arm}" >&2
        return 1
    fi
    buildopt_finished_ns=$(date +%s%N)
    buildopt_duration_ms=$(((buildopt_finished_ns - buildopt_started_ns) / 1000000))
    grep -Fq 'BUILD SUCCESSFUL' "${buildopt_log}" || return 1
    grep -Eq '^> Task :spring-jms:compileJava$' "${buildopt_log}" || {
        printf 'POC Runtime research %s arm did not execute changed compileJava\n' \
            "${buildopt_arm}" >&2
        return 1
    }
    grep -Fq '> Task :buildSrc:test UP-TO-DATE' "${buildopt_log}" || {
        printf 'POC Runtime research %s arm changed the buildSrc test outcome\n' \
            "${buildopt_arm}" >&2
        return 1
    }
    if grep -Eq '^> Task .*:(publish|upload|release|sign)([A-Z:]|$)' "${buildopt_log}" ||
        grep -Eq 'Publishing build scan|Build scan published|https://gradle[.]com/s/' \
            "${buildopt_log}"; then
        printf 'POC Runtime research %s arm attempted an external action\n' \
            "${buildopt_arm}" >&2
        return 1
    fi
}

buildopt_output_manifest() {
    local buildopt_arm=$1
    local buildopt_manifest=$2
    local buildopt_checkout="${buildopt_root}/${buildopt_arm}/checkout"
    local buildopt_file
    : >"${buildopt_manifest}"
    [[ -d "${buildopt_checkout}/spring-jms/build/classes" ]] || return 1
    while IFS= read -r -d '' buildopt_file; do
        printf '%s  %s\n' "$(sha256sum "${buildopt_file}" | awk '{print $1}')" \
            "${buildopt_file#"${buildopt_checkout}/"}" >>"${buildopt_manifest}"
    done < <(find "${buildopt_checkout}/spring-jms/build/classes" -type f -print0 | sort -z)
    [[ -s "${buildopt_manifest}" ]]
}

buildopt_task_manifest() {
    local buildopt_log=$1
    local buildopt_manifest=$2
    sed -n 's/^> Task \([^ ]*\)\(.*\)$/\1\2/p' "${buildopt_log}" | sort -u \
        >"${buildopt_manifest}"
    [[ -s "${buildopt_manifest}" ]]
}

for buildopt_arm in control candidate; do
    buildopt_reset_arm "${buildopt_arm}" warmup
    buildopt_run_arm "${buildopt_arm}" \
        "${buildopt_root}/logs/warm-${buildopt_arm}.log"
done

buildopt_rows="${buildopt_root}/observations.jsonl"
: >"${buildopt_rows}"
for buildopt_pair in {1..4}; do
    buildopt_reset_arm control "pair-${buildopt_pair}"
    buildopt_reset_arm candidate "pair-${buildopt_pair}"
    buildopt_order=$(jq -r ".measurement.pairOrder[$((buildopt_pair - 1))]" \
        "${buildopt_spec}")
    buildopt_control_log="${buildopt_root}/logs/pair-${buildopt_pair}-control.log"
    buildopt_candidate_log="${buildopt_root}/logs/pair-${buildopt_pair}-candidate.log"
    if [[ "${buildopt_order}" == CONTROL_FIRST ]]; then
        buildopt_run_arm control "${buildopt_control_log}"
        buildopt_control_duration=${buildopt_duration_ms}
        buildopt_first_finished=${buildopt_finished_ns}
        buildopt_run_arm candidate "${buildopt_candidate_log}"
        buildopt_candidate_duration=${buildopt_duration_ms}
    else
        buildopt_run_arm candidate "${buildopt_candidate_log}"
        buildopt_candidate_duration=${buildopt_duration_ms}
        buildopt_first_finished=${buildopt_finished_ns}
        buildopt_run_arm control "${buildopt_control_log}"
        buildopt_control_duration=${buildopt_duration_ms}
    fi
    buildopt_gap_ms=$(((buildopt_started_ns - buildopt_first_finished) / 1000000))
    ((buildopt_gap_ms <= 10000)) || {
        printf 'POC Runtime research pair %s exceeded inter-arm gap: %s ms\n' \
            "${buildopt_pair}" "${buildopt_gap_ms}" >&2
        exit 1
    }

    buildopt_control_outputs="${buildopt_root}/control-${buildopt_pair}.outputs"
    buildopt_candidate_outputs="${buildopt_root}/candidate-${buildopt_pair}.outputs"
    buildopt_control_tasks="${buildopt_root}/control-${buildopt_pair}.tasks"
    buildopt_candidate_tasks="${buildopt_root}/candidate-${buildopt_pair}.tasks"
    buildopt_output_manifest control "${buildopt_control_outputs}"
    buildopt_output_manifest candidate "${buildopt_candidate_outputs}"
    buildopt_task_manifest "${buildopt_control_log}" "${buildopt_control_tasks}"
    buildopt_task_manifest "${buildopt_candidate_log}" "${buildopt_candidate_tasks}"
    cmp -s "${buildopt_control_outputs}" "${buildopt_candidate_outputs}" || {
        printf 'POC Runtime research outputs differ in pair %s\n' "${buildopt_pair}" >&2
        exit 1
    }
    cmp -s "${buildopt_control_tasks}" "${buildopt_candidate_tasks}" || {
        printf 'POC Runtime research task outcomes differ in pair %s\n' \
            "${buildopt_pair}" >&2
        exit 1
    }

    jq -cn --argjson pair "${buildopt_pair}" --arg order "${buildopt_order}" \
        --argjson control "${buildopt_control_duration}" \
        --argjson candidate "${buildopt_candidate_duration}" \
        --argjson gap "${buildopt_gap_ms}" \
        --arg outputSha "$(sha256sum "${buildopt_control_outputs}" | awk '{print $1}')" \
        --argjson outputCount "$(wc -l <"${buildopt_control_outputs}")" \
        --arg taskSha "$(sha256sum "${buildopt_control_tasks}" | awk '{print $1}')" '
        {
            pair: $pair, order: $order,
            controlMaxWorkers: 12,
            candidateMaxWorkers: 6,
            controlDurationMs: $control,
            candidateDurationMs: $candidate,
            savedMs: ($control - $candidate),
            interArmIdleGapMs: $gap,
            requiredOutputSha256: $outputSha,
            requiredOutputCount: $outputCount,
            taskOutcomeSetSha256: $taskSha,
            outputsIdentical: true,
            taskOutcomesIdentical: true,
            productAttributableFailure: false
        }' >>"${buildopt_rows}"
    printf 'Runtime pair %s/4: workers12=%sms workers6=%sms saved=%sms order=%s\n' \
        "${buildopt_pair}" "${buildopt_control_duration}" \
        "${buildopt_candidate_duration}" \
        "$((buildopt_control_duration - buildopt_candidate_duration))" \
        "${buildopt_order}"
done

jq -s '.' "${buildopt_rows}" >"${buildopt_root}/observations.json"
jq -n --arg capturedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg revision "${buildopt_revision}" --arg runnerSha "${buildopt_runner_sha}" \
    --arg specSha "${buildopt_spec_sha}" --arg sourceSha "${buildopt_source_sha}" \
    --arg cacheSha "${buildopt_cache_seed_sha}" \
    --argjson preflightMs \
        "$(((buildopt_preflight_finished - buildopt_preflight_started) / 1000000))" \
    --slurpfile spec "${buildopt_spec}" \
    --slurpfile rows "${buildopt_root}/observations.json" '
    def bootstrap_mean($data; $sample):
        reduce range(0; 4) as $draw
            ({state: ((2654435761 * ($sample + 1)) % 4294967296), sum: 0};
             .state = ((1664525 * .state + 1013904223) % 4294967296) |
             .sum += $data[((.state / 1073741824) | floor)].savedMs) |
        .sum / 4;
    def bootstrap95($data):
        ([range(0; 4096) as $sample | bootstrap_mean($data; $sample)] | sort) as $r |
        [$r[102], $r[3993]];
    $rows[0] as $data |
    (($data | map(.controlDurationMs) | add) / 4) as $controlMean |
    (($data | map(.candidateDurationMs) | add) / 4) as $candidateMean |
    ($controlMean - $candidateMean) as $saved |
    (($data | map(.savedMs) | add) /
        ($data | map(.controlDurationMs) | add)) as $ratio |
    bootstrap95($data) as $interval |
    ($data | map(select(.savedMs > 0)) | length) as $positive |
    ($saved >= $spec[0].valueGate.minimumSavedMs and
     $ratio >= $spec[0].valueGate.minimumReductionRatio and
     $interval[0] > 0 and
     $positive == $spec[0].valueGate.minimumPositivePairs) as $qualified |
    {
        schemaVersion: "buildopt.evidence/poc-runtime-research/v1",
        workItem: "POC-RUNTIME-RESEARCH-001",
        capturedAt: $capturedAt,
        buildoptRevision: $revision,
        runnerScriptSha256: $runnerSha,
        specSha256: $specSha,
        repository: {
            nameWithOwner: $spec[0].repository.nameWithOwner,
            revision: $spec[0].repository.revision,
            sourceArchiveSha256: $sourceSha
        },
        runner: $spec[0].runner,
        hypothesis: $spec[0].hypothesis,
        workflow: $spec[0].workflow,
        preparation: {
            onlinePreflightMeasured: false,
            onlinePreflightSuccess: true,
            onlinePreflightWallClockMs: $preflightMs,
            measuredNetwork: "DISCONNECTED",
            dependencyMode: "GRADLE_OFFLINE",
            buildCacheSeedSha256: $cacheSha,
            sameDependencyAndNativeCacheSeedRestoredBeforeArmSetup: true,
            independentCheckoutAndGradleHomePerArm: true,
            outputsRemovedBeforeEveryArm: true,
            fixedMutationAppliedAfterCacheRestore: true
        },
        observations: $data,
        result: {
            pairs: 4,
            controlMeanMs: $controlMean,
            candidateMeanMs: $candidateMean,
            meanSavedMs: $saved,
            reductionRatio: $ratio,
            interval95SavedMs: $interval,
            positivePairs: $positive,
            qualified: $qualified,
            decision: (if $qualified then
                $spec[0].decisionPolicy.qualifiedDecision
                else $spec[0].decisionPolicy.unqualifiedDecision end)
        },
        boundaries: $spec[0].boundaries
    }
' >"${buildopt_output}"

"${buildopt_script_dir}/check-poc-runtime-research" "${buildopt_output}" >/dev/null
printf 'POC Runtime research evidence written: %s\n' "${buildopt_output}"
