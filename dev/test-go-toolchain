#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_bootstrap="${buildopt_script_dir}/bootstrap"
buildopt_run="${buildopt_script_dir}/run"
buildopt_test_root=$(mktemp -d)

buildopt_cleanup() {
    rm -rf -- "${buildopt_test_root}"
}
trap buildopt_cleanup EXIT

buildopt_before_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)

buildopt_payload_root="${buildopt_test_root}/payload"
buildopt_fake_go="${buildopt_payload_root}/go"
mkdir -p "${buildopt_fake_go}/bin"

# The generated fixture expands these variables when the fake Go binary runs.
# shellcheck disable=SC2016
printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'case "${1:-}" in' \
    '    version)' \
    '        printf '\''go version go1.26.5 linux/amd64\n'\''' \
    '        ;;' \
    '    env)' \
    '        if [[ "${2:-}" == "GOROOT" ]]; then' \
    '            printf '\''%s\n'\'' "${GOROOT}"' \
    '        else' \
    '            exit 64' \
    '        fi' \
    '        ;;' \
    '    *)' \
    '        exit 64' \
    '        ;;' \
    'esac' \
    >"${buildopt_fake_go}/bin/go"
chmod +x "${buildopt_fake_go}/bin/go"

buildopt_archive="${buildopt_test_root}/fake-go.tar.gz"
tar -czf "${buildopt_archive}" -C "${buildopt_payload_root}" go
buildopt_sha256=$(sha256sum "${buildopt_archive}" | awk '{print $1}')

buildopt_lock="${buildopt_test_root}/toolchains.lock.json"
jq -n \
    --arg buildopt_sha256 "${buildopt_sha256}" \
    '{
        schemaVersion: "buildopt.dev/toolchains-lock/v1",
        platforms: [
            {
                id: "linux-amd64",
                operatingSystem: "linux",
                architecture: "amd64"
            }
        ],
        artifacts: [
            {
                id: "go",
                version: "1.26.5",
                adoption: "required",
                kind: "tar.gz",
                platform: "linux-amd64",
                provider: "go-project",
                url: "https://example.invalid/fake-go.tar.gz",
                sha256: $buildopt_sha256,
                requiredBy: ["ENV-005"]
            }
        ]
    }' >"${buildopt_lock}"

buildopt_fake_host_bin="${buildopt_test_root}/fake-host-bin"
buildopt_curl_count="${buildopt_test_root}/curl-count"
mkdir "${buildopt_fake_host_bin}"
# The generated fixture expands these variables when the fake curl runs.
# shellcheck disable=SC2016
printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'buildopt_output=' \
    'while (($# > 0)); do' \
    '    case "$1" in' \
    '        --output)' \
    '            buildopt_output=$2' \
    '            shift 2' \
    '            ;;' \
    '        *)' \
    '            shift' \
    '            ;;' \
    '    esac' \
    'done' \
    'if [[ -z "${buildopt_output}" ]]; then' \
    '    exit 64' \
    'fi' \
    'buildopt_count=0' \
    'if [[ -f "${BUILDOPT_TEST_CURL_COUNT}" ]]; then' \
    '    read -r buildopt_count <"${BUILDOPT_TEST_CURL_COUNT}"' \
    'fi' \
    'printf '\''%s\n'\'' "$((buildopt_count + 1))" >"${BUILDOPT_TEST_CURL_COUNT}"' \
    'cp -- "${BUILDOPT_TEST_ARCHIVE}" "${buildopt_output}"' \
    >"${buildopt_fake_host_bin}/curl"
chmod +x "${buildopt_fake_host_bin}/curl"

buildopt_tools_root="${buildopt_test_root}/tools with spaces"
buildopt_bootstrap_output=$(
    BUILDOPT_TEST_ARCHIVE="${buildopt_archive}" \
    BUILDOPT_TEST_CURL_COUNT="${buildopt_curl_count}" \
    BUILDOPT_TOOLCHAINS_LOCK_FILE="${buildopt_lock}" \
    BUILDOPT_TOOLS_ROOT="${buildopt_tools_root}" \
    PATH="${buildopt_fake_host_bin}:${PATH}" \
        "${buildopt_bootstrap}" --toolchain go
)
if [[ "${buildopt_bootstrap_output}" != *"Provisioned go 1.26.5"* ]]; then
    printf 'bootstrap did not report a successful Go provision\n' >&2
    exit 1
fi

buildopt_install_dir="${buildopt_tools_root}/toolchains/go-${buildopt_sha256:0:16}"
if [[ ! -x "${buildopt_install_dir}/bin/go" ]]; then
    printf 'bootstrap did not install an executable Go binary\n' >&2
    exit 1
fi

buildopt_second_output=$(
    BUILDOPT_TEST_ARCHIVE="${buildopt_archive}" \
    BUILDOPT_TEST_CURL_COUNT="${buildopt_curl_count}" \
    BUILDOPT_TOOLCHAINS_LOCK_FILE="${buildopt_lock}" \
    BUILDOPT_TOOLS_ROOT="${buildopt_tools_root}" \
    PATH="${buildopt_fake_host_bin}:${PATH}" \
        "${buildopt_bootstrap}" --toolchain go
)
if [[ "${buildopt_second_output}" != *"is already provisioned"* ]] ||
    [[ "$(<"${buildopt_curl_count}")" != "1" ]]; then
    printf 'Go bootstrap is not idempotent\n' >&2
    exit 1
fi

buildopt_global_bin="${buildopt_test_root}/global-bin"
mkdir "${buildopt_global_bin}"
printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf '\''go version go1.25.0 linux/amd64\n'\''' \
    >"${buildopt_global_bin}/go"
chmod +x "${buildopt_global_bin}/go"

buildopt_global_go=$(
    PATH="${buildopt_global_bin}:${PATH}" go version
)
buildopt_project_go=$(
    BUILDOPT_TOOLCHAINS_LOCK_FILE="${buildopt_lock}" \
    BUILDOPT_TOOLS_ROOT="${buildopt_tools_root}" \
    PATH="${buildopt_global_bin}:${PATH}" \
        "${buildopt_run}" --toolchain go -- go version
)
if [[ "${buildopt_global_go}" != *'go1.25.0'* ]] ||
    [[ "${buildopt_project_go}" != \
        'go version go1.26.5 linux/amd64' ]]; then
    printf 'dev/run did not isolate project Go from global Go\n' >&2
    exit 1
fi

buildopt_probe="${buildopt_test_root}/probe-environment"
# The generated probe expands variables inside the dev/run child.
# shellcheck disable=SC2016
printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf '\''%s\n'\'' "${GOROOT}"' \
    'printf '\''%s\n'\'' "${GOTOOLCHAIN}"' \
    'printf '\''%s\n'\'' "${GOENV}"' \
    'printf '\''%s\n'\'' "${GOPATH}"' \
    'printf '\''%s\n'\'' "${GOMODCACHE}"' \
    'printf '\''%s\n'\'' "${GOCACHE}"' \
    'command -v go' \
    >"${buildopt_probe}"
chmod +x "${buildopt_probe}"
buildopt_probe_output=$(
    BUILDOPT_TOOLCHAINS_LOCK_FILE="${buildopt_lock}" \
    BUILDOPT_TOOLS_ROOT="${buildopt_tools_root}" \
    GOENV="${buildopt_test_root}/global-go-env" \
    GOROOT="${buildopt_test_root}/global-go-root" \
    GOTOOLCHAIN=auto \
    GOPATH="${buildopt_test_root}/global-go-path" \
    PATH="${buildopt_global_bin}:${PATH}" \
        "${buildopt_run}" --toolchain go -- "${buildopt_probe}"
)
buildopt_expected_probe=$(
    printf '%s\n' \
        "${buildopt_install_dir}" \
        "local" \
        "off" \
        "${buildopt_tools_root}/state/go/gopath" \
        "${buildopt_tools_root}/state/go/gopath/pkg/mod" \
        "${buildopt_tools_root}/state/go/build-cache" \
        "${buildopt_install_dir}/bin/go"
)
if [[ "${buildopt_probe_output}" != "${buildopt_expected_probe}" ]]; then
    printf 'dev/run supplied an unexpected project Go environment\n' >&2
    exit 1
fi

buildopt_global_go_after=$(
    PATH="${buildopt_global_bin}:${PATH}" go version
)
if [[ "${buildopt_global_go_after}" != "${buildopt_global_go}" ]]; then
    printf 'dev/run changed global Go state\n' >&2
    exit 1
fi

set +e
BUILDOPT_TOOLCHAINS_LOCK_FILE="${buildopt_lock}" \
BUILDOPT_TOOLS_ROOT="${buildopt_tools_root}" \
    "${buildopt_run}" --toolchain go -- bash -c 'exit 37'
buildopt_child_exit=$?
BUILDOPT_TOOLCHAINS_LOCK_FILE="${buildopt_lock}" \
BUILDOPT_TOOLS_ROOT="${buildopt_test_root}/missing-tools" \
    "${buildopt_run}" --toolchain go -- go version >/dev/null 2>&1
buildopt_missing_exit=$?
set -e
if ((buildopt_child_exit != 37)) ||
    ((buildopt_missing_exit != 1)); then
    printf 'unexpected Go run error contract: %s/%s\n' \
        "${buildopt_child_exit}" \
        "${buildopt_missing_exit}" >&2
    exit 1
fi

buildopt_after_status=$(
    git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all
)
if [[ "${buildopt_after_status}" != "${buildopt_before_status}" ]]; then
    printf 'Go toolchain tests changed the working tree\n' >&2
    exit 1
fi

printf 'ENV-005 Go toolchain tests OK: idempotency, isolation, environment, and exit propagation\n'
