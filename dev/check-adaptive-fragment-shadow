#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_source="${buildopt_repo_root}/benchmarks/results/poc-lifetime-breadth-v3"
buildopt_evidence="${buildopt_repo_root}/benchmarks/results/adaptive-fragment-shadow-v1.json"
buildopt_policy="${buildopt_repo_root}/specs/poc-adaptive-fragment-shadow-v1.json"
buildopt_temp_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-af004.XXXXXX")
trap 'rm -r -- "${buildopt_temp_root}"' EXIT

for buildopt_command in grep jq mktemp; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'adaptive fragment shadow check requires %s\n' "${buildopt_command}" >&2
        exit 1
    }
done

jq -e '
    .schemaVersion == "buildopt.specs/poc-adaptive-fragment-shadow/v1" and
    .workItem == "AF-004" and
    .source.repositories == 5 and
    .source.futureEvidenceAllowed == false and
    .gate.minimumFragmentRetentionRatio == 0.5 and
    .gate.maximumLookaheadObservations == 0 and
    .gate.maximumActivationAuthorizations == 0 and
    .gate.maximumMeasurementOnlyBuilds == 0 and
    .outcome == "FRAGMENT_COVERAGE_HYPOTHESIS_SUPPORTED" and
    .boundaries.shadowOnly == true and
    .boundaries.fragmentActivationAuthorized == false and
    .boundaries.buildTimingClaim == false and
    .boundaries.productionAuthorized == false and
    .boundaries.testOptimization == "OUT_OF_SCOPE"
' "${buildopt_policy}" >/dev/null

cd -- "${buildopt_repo_root}"
"${buildopt_script_dir}/run" --toolchain go -- \
    go test -count=1 ./internal/adaptivefragment ./dev/adaptive-fragment-shadow
"${buildopt_script_dir}/run" --toolchain go -- \
    go vet ./internal/adaptivefragment ./dev/adaptive-fragment-shadow
buildopt_direct_imports=$("${buildopt_script_dir}/run" --toolchain go -- \
    go list -f '{{range .Imports}}{{println .}}{{end}}' \
    ./internal/adaptivefragment ./dev/adaptive-fragment-shadow)
if grep -Eq '^(net|net/.*|os/exec)$' <<<"${buildopt_direct_imports}"; then
    echo "adaptive fragment shadow replay imports process or network execution" >&2
    exit 1
fi

"${buildopt_script_dir}/run" --toolchain go -- \
    go run ./dev/adaptive-fragment-shadow \
    --source "${buildopt_source}" --validate "${buildopt_evidence}" >/dev/null
"${buildopt_script_dir}/run" --toolchain go -- \
    go run ./dev/adaptive-fragment-shadow \
    --source "${buildopt_source}" --output "${buildopt_temp_root}/live-report.json"
"${buildopt_script_dir}/run" --toolchain go -- \
    go run ./dev/adaptive-fragment-shadow \
    --source "${buildopt_source}" --validate "${buildopt_temp_root}/live-report.json" >/dev/null

jq '.summary.descendantsWithFragment -= 1' "${buildopt_evidence}" >"${buildopt_temp_root}/tampered-report.json"
if "${buildopt_script_dir}/run" --toolchain go -- \
    go run ./dev/adaptive-fragment-shadow \
    --source "${buildopt_source}" --validate "${buildopt_temp_root}/tampered-report.json" >/dev/null 2>&1; then
    echo "adaptive fragment shadow replay accepted a tampered report" >&2
    exit 1
fi

echo "adaptive fragment shadow replay: FRAGMENT_COVERAGE_HYPOTHESIS_SUPPORTED"
