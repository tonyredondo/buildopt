#!/usr/bin/env bash
set -euo pipefail

if (($# > 2)); then
    printf 'usage: %s [evidence-directory|--spec-only] [specification]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_v1_spec="${buildopt_repo_root}/specs/poc-generic-holdout-v1.json"
buildopt_v2_spec="${buildopt_repo_root}/specs/poc-generic-holdout-v2.json"
buildopt_v3_spec="${buildopt_repo_root}/specs/poc-generic-holdout-v3.json"
buildopt_v4_spec="${buildopt_repo_root}/specs/poc-generic-holdout-v4.json"
buildopt_v5_spec="${buildopt_repo_root}/specs/poc-generic-holdout-v5.json"
buildopt_spec=${2:-"${buildopt_repo_root}/specs/poc-generic-holdout-v2.json"}
if [[ ${buildopt_spec} != /* ]]; then
    buildopt_spec="${buildopt_repo_root}/${buildopt_spec}"
fi
buildopt_evidence=${1:-"${buildopt_repo_root}/benchmarks/results/poc-generic-holdout-v2"}

for buildopt_command in git jq; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required holdout validation command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
for buildopt_file in "${buildopt_v1_spec}" "${buildopt_v2_spec}" \
    "${buildopt_v3_spec}" "${buildopt_v4_spec}" "${buildopt_v5_spec}" \
    "${buildopt_spec}"; do
    [[ -f ${buildopt_file} ]] || {
        printf 'holdout specification is unavailable: %s\n' "${buildopt_file}" >&2
        exit 1
    }
done

jq -e '
    .schemaVersion == "buildopt.specs/poc-generic-holdout/v1" and
    .evidenceSchemaVersion == "buildopt.evidence/poc-generic-holdout/v1" and
    .workItem == "POC-GENERIC-HOLDOUT-001" and
    .decision == "RUN_ONE_UNSEEN_SUBSTANTIAL_HOLDOUT_WITH_THE_UNCHANGED_GENERIC_PATH" and
    (.preregisteredFromRevision | test("^[0-9a-f]{40}$")) and
    .subject == {
      key: "hibernate-orm",
      repositoryId: "hibernate/hibernate-orm",
      remoteUrl: "https://github.com/hibernate/hibernate-orm.git",
      publicRevision: "2b448a59d332326f0cd0691c868425124d55cbb5",
      jdkToolchain: "temurin-jdk-25",
      pipelineClass: "assemble",
      entrypoints: ["assemble"],
      changePath: "hibernate-core/src/main/java/org/hibernate/Session.java",
      mutation: "APPEND_FIXED_COMMENT",
      requiredOutputs: ["hibernate-core/build/libs/**"]
    } and
    .runner.platform == "linux-amd64" and
    .runner.cpuCount == 12 and
    .runner.maxWorkers == 12 and
    .runner.pairs == 8 and
    .runner.order == "ALTERNATING_CONTROL_FIRST_CANDIDATE_FIRST" and
    .runner.maximumInterArmGap == "5s" and
    .runner.fallbackMaxWorkers == 4 and
    .method.surface == "INSTALLED_BUILDOPT_PROFILE_PROPOSE_MEASURE_EVALUATE" and
    .method.candidateMechanisms == ["BUILD_IMPACT"] and
    .method.control == "OPTIMIZED_NATIVE_GRADLE_SAME_DECLARED_WORKFLOW" and
    .method.repositorySpecificProductRulesAllowed == false and
    .method.postResultTuningAllowed == false and
    .qualification.minimumMeanSavedMs == 500 and
    .qualification.minimumReductionRatio == 0.02 and
    .qualification.positiveLower95Bound == true and
    .qualification.minimumPositivePairs == 8 and
    .qualification.requiredOutputsIdentical == true and
    .qualification.maximumProductAttributableFailures == 0 and
    .qualification.failedOrTimedOutObservationsMayBeDiscarded == false and
    .decisionRules.repositorySpecificException == "FORBIDDEN" and
    .decisionRules.thresholdRelaxation == "FORBIDDEN" and
    .boundaries.proofOfConcept == true and
    .boundaries.productionAuthorized == false and
    .boundaries.automaticActivation == false and
    .boundaries.testOptimizationModified == false and
    .boundaries.soakRequired == false and
    .boundaries.designPartnerRequired == false
' "${buildopt_v1_spec}" >/dev/null

if [[ ${buildopt_spec} != "${buildopt_v1_spec}" ]]; then
    jq -e '
        .schemaVersion == "buildopt.specs/poc-generic-holdout/v2" and
        .evidenceSchemaVersion == "buildopt.evidence/poc-generic-holdout/v2" and
        .workItem == "POC-GENERIC-HOLDOUT-001" and
        .decision == "RERUN_FROZEN_HOLDOUT_WITH_CORRECTED_REPOSITORY_OUTPUT_DIRECTORY" and
        .preregisteredFromRevision == "f8dac70fa71900215516bdd4f4f1f3cd42573b41" and
        .supersedes == "buildopt.specs/poc-generic-holdout/v1" and
        .subject.repositoryId == "hibernate/hibernate-orm" and
        .subject.publicRevision == "2b448a59d332326f0cd0691c868425124d55cbb5" and
        .subject.entrypoints == ["assemble"] and
        .subject.changePath == "hibernate-core/src/main/java/org/hibernate/Session.java" and
        .subject.requiredOutputs == ["hibernate-core/target/libs/**"] and
        .runner.cpuCount == 12 and
        .runner.pairs == 8 and
        .method.candidateMechanisms == ["BUILD_IMPACT"] and
        .method.control == "OPTIMIZED_NATIVE_GRADLE_SAME_DECLARED_WORKFLOW" and
        .method.repositorySpecificProductRulesAllowed == false and
        .method.postResultTuningAllowed == false and
        .qualification.minimumMeanSavedMs == 500 and
        .qualification.minimumReductionRatio == 0.02 and
        .qualification.minimumPositivePairs == 8 and
        .qualification.failedOrTimedOutObservationsMayBeDiscarded == false and
        .amendment.reason == "HIBERNATE_MODULE_ASPECT_SETS_BUILD_DIRECTORY_TO_TARGET" and
        .amendment.sourceLine == 31 and
        .amendment.acceptedPairsFromV1 == 0 and
        .amendment.warmupsReused == false and
        .amendment.proposalReused == false and
        .amendment.timedConditionsChanged == false and
        .amendment.qualificationChanged == false and
        .boundaries.proofOfConcept == true and
        .boundaries.productionAuthorized == false and
        .boundaries.automaticActivation == false and
        .boundaries.testOptimizationModified == false
    ' "${buildopt_v2_spec}" >/dev/null
fi

if [[ $(jq -r '.schemaVersion' "${buildopt_spec}") == buildopt.specs/poc-generic-holdout/v5 ]]; then
    jq -e '
        .schemaVersion == "buildopt.specs/poc-generic-holdout/v5" and
        .evidenceSchemaVersion == "buildopt.evidence/poc-generic-holdout/v5" and
        .workItem == "POC-GENERIC-HOLDOUT-CROSSOVER-001" and
        .decision == "RERUN_FROZEN_HOLDOUT_AS_PREREGISTERED_RECIPROCAL_CROSSOVER" and
        .preregisteredFromRevision == "eda817279505eda1801a43ec80c680f429662e65" and
        .supersedes == "buildopt.specs/poc-generic-holdout/v4" and
        .subject.repositoryId == "hibernate/hibernate-orm" and
        .subject.publicRevision == "2b448a59d332326f0cd0691c868425124d55cbb5" and
        .subject.entrypoints == ["assemble"] and
        .subject.changePath == "hibernate-core/src/main/java/org/hibernate/Session.java" and
        .subject.requiredOutputs == ["hibernate-core/target/libs/**"] and
        .runner.cpuCount == 12 and
        .runner.maxWorkers == 12 and
        .runner.measurementBatches == 2 and
        .runner.pairsPerBatch == 8 and
        .runner.reciprocalBlocks == 8 and
        .runner.warmupsPerArm == 4 and
        .runner.warmupPhases == ["CACHE_SEED", "BASE_DAEMON_STABILIZATION", "TARGET_WORKLOAD_STABILIZATION", "TARGET_WORKLOAD_STABILITY_CONFIRMATION"] and
        .runner.targetStabilityConfirmations == 2 and
        .runner.orderWithinBatch == "ALTERNATING_CONTROL_FIRST_CANDIDATE_FIRST" and
        .runner.blockConstruction == "ADJACENT_CONTROL_FIRST_PLUS_CANDIDATE_FIRST" and
        .runner.fallbackMaxWorkers == 12 and
        .method.candidateMechanisms == ["BUILD_IMPACT"] and
        .method.control == "OPTIMIZED_NATIVE_GRADLE_SAME_DECLARED_WORKFLOW" and
        .method.twoTargetShapeObservationsBeforePairs == true and
        .method.warmupAndPairExactTaskPathsRecorded == true and
        .method.rawPairsCombinedOnlyAsReciprocalBlocks == true and
        .method.repositorySpecificProductRulesAllowed == false and
        .method.postResultTuningAllowed == false and
        .qualification.minimumMeanSavedMs == 500 and
        .qualification.minimumReductionRatio == 0.02 and
        .qualification.minimumPositiveBlocks == 8 and
        .qualification.failedOrTimedOutObservationsMayBeDiscarded == false and
        .qualification.exactTaskPathsMustBePresent == true and
        .qualification.bothBatchFallbacksMustPass == true and
        .amendment.reason == "V4_REVEALED_FIRST_SECOND_PERIOD_BIAS_AND_NATIVE_TARGET_SHAPE_DRIFT" and
        .amendment.v4PositivePairs == 5 and
        .amendment.v4ControlFirstPositivePairs == 4 and
        .amendment.v4CandidateFirstPositivePairs == 1 and
        .amendment.acceptedPairsFromV4 == 0 and
        .amendment.warmupsReused == false and
        .amendment.proposalReused == false and
        .amendment.timingReused == false and
        .amendment.qualificationThresholdsChanged == false and
        .amendment.observationUnitChanged == true and
        .decisionRules.repositorySpecificException == "FORBIDDEN" and
        .decisionRules.thresholdRelaxation == "FORBIDDEN" and
        .boundaries.proofOfConcept == true and
        .boundaries.productionAuthorized == false and
        .boundaries.automaticActivation == false and
        .boundaries.testOptimizationModified == false and
        .boundaries.soakRequired == false and
        .boundaries.designPartnerRequired == false
    ' "${buildopt_spec}" >/dev/null
fi

if [[ $(jq -r '.schemaVersion' "${buildopt_spec}") == buildopt.specs/poc-generic-holdout/v3 ]]; then
    jq -e '
        .schemaVersion == "buildopt.specs/poc-generic-holdout/v3" and
        .evidenceSchemaVersion == "buildopt.evidence/poc-generic-holdout/v3" and
        .workItem == "POC-GENERIC-HOLDOUT-002" and
        .decision == "RERUN_FROZEN_HOLDOUT_AFTER_GENERIC_WARMUP_DIAGNOSTIC_CORRECTION" and
        .preregisteredFromRevision == "fac53c2c92b53c4226be3792907fc8f714dbcf54" and
        .supersedes == "buildopt.specs/poc-generic-holdout/v2" and
        .subject.repositoryId == "hibernate/hibernate-orm" and
        .subject.publicRevision == "2b448a59d332326f0cd0691c868425124d55cbb5" and
        .subject.entrypoints == ["assemble"] and
        .subject.changePath == "hibernate-core/src/main/java/org/hibernate/Session.java" and
        .subject.requiredOutputs == ["hibernate-core/target/libs/**"] and
        .runner.cpuCount == 12 and
        .runner.warmupsPerArm == 2 and
        .runner.warmupPhases == ["CACHE_SEED", "DAEMON_STABILIZATION"] and
        .runner.pairs == 8 and
        .method.candidateMechanisms == ["BUILD_IMPACT"] and
        .method.control == "OPTIMIZED_NATIVE_GRADLE_SAME_DECLARED_WORKFLOW" and
        .method.warmupsMeasured == false and
        .method.warmupAndPairTaskOutcomesRecorded == true and
        .method.warmupAndPairLogSha256Recorded == true and
        .method.repositorySpecificProductRulesAllowed == false and
        .method.postResultTuningAllowed == false and
        .qualification.minimumMeanSavedMs == 500 and
        .qualification.minimumReductionRatio == 0.02 and
        .qualification.minimumPositivePairs == 8 and
        .qualification.failedOrTimedOutObservationsMayBeDiscarded == false and
        .amendment.reason == "V2_SINGLE_WARMUP_COULD_NOT_ATTRIBUTE_FIRST_PAIR_DAEMON_DRIFT" and
        .amendment.v2PositivePairs == 7 and
        .amendment.v2FirstPairSavedMs == -1118 and
        .amendment.acceptedPairsFromV2 == 0 and
        .amendment.warmupsReused == false and
        .amendment.proposalReused == false and
        .amendment.timingReused == false and
        .amendment.qualificationChanged == false and
        .decisionRules.thresholdRelaxation == "FORBIDDEN" and
        .boundaries.proofOfConcept == true and
        .boundaries.productionAuthorized == false and
        .boundaries.automaticActivation == false and
        .boundaries.testOptimizationModified == false
    ' "${buildopt_spec}" >/dev/null
fi

if [[ $(jq -r '.schemaVersion' "${buildopt_spec}") == buildopt.specs/poc-generic-holdout/v4 ]]; then
    jq -e '
        .schemaVersion == "buildopt.specs/poc-generic-holdout/v4" and
        .evidenceSchemaVersion == "buildopt.evidence/poc-generic-holdout/v4" and
        .workItem == "POC-GENERIC-HOLDOUT-003" and
        .decision == "RERUN_FROZEN_HOLDOUT_AFTER_TARGET_WORKLOAD_AND_HOST_PRESSURE_DIAGNOSTIC_CORRECTION" and
        .preregisteredFromRevision == "4b9f8e17b889da65f32725d70c4efb70d026f6fc" and
        .supersedes == "buildopt.specs/poc-generic-holdout/v3" and
        .subject.repositoryId == "hibernate/hibernate-orm" and
        .subject.publicRevision == "2b448a59d332326f0cd0691c868425124d55cbb5" and
        .subject.entrypoints == ["assemble"] and
        .subject.changePath == "hibernate-core/src/main/java/org/hibernate/Session.java" and
        .subject.requiredOutputs == ["hibernate-core/target/libs/**"] and
        .runner.cpuCount == 12 and
        .runner.maxWorkers == 12 and
        .runner.warmupsPerArm == 3 and
        .runner.warmupPhases == ["CACHE_SEED", "BASE_DAEMON_STABILIZATION", "TARGET_WORKLOAD_STABILIZATION"] and
        .runner.pairs == 8 and
        .runner.fallbackMaxWorkers == 12 and
        .runner.fallbackGradleOptions == ["--no-daemon", "--parallel", "--max-workers=12"] and
        .method.candidateMechanisms == ["BUILD_IMPACT"] and
        .method.control == "OPTIMIZED_NATIVE_GRADLE_SAME_DECLARED_WORKFLOW" and
        .method.warmupsMeasured == false and
        .method.targetRevisionWarmupBeforePairs == true and
        .method.warmupAndPairTaskOutcomesRecorded == true and
        .method.warmupAndPairTaskFingerprintRecorded == true and
        .method.warmupAndPairLogSha256Recorded == true and
        .method.intervalLinuxPsiRecordedOutsideTiming == true and
        .method.hostPressureChangesQualificationThresholds == false and
        .method.repositorySpecificProductRulesAllowed == false and
        .method.postResultTuningAllowed == false and
        .qualification.minimumMeanSavedMs == 500 and
        .qualification.minimumReductionRatio == 0.02 and
        .qualification.minimumPositivePairs == 8 and
        .qualification.failedOrTimedOutObservationsMayBeDiscarded == false and
        .qualification.measuredExecutionShapeMustBeStable == true and
        .qualification.targetWarmupExecutionShapeMustMatchMeasuredPairs == true and
        .amendment.reason == "V3_BASE_ONLY_STABILIZATION_DID_NOT_WARM_TARGET_WORKLOAD_OR_ATTRIBUTE_EXECUTION_SHAPE_AND_HOST_PRESSURE" and
        .amendment.v3PositivePairs == 4 and
        .amendment.v3FirstFourPairsPositive == true and
        .amendment.v3LastFourPairsPositive == false and
        .amendment.v3ControlTaskCountDriftPair == 8 and
        .amendment.acceptedPairsFromV3 == 0 and
        .amendment.warmupsReused == false and
        .amendment.proposalReused == false and
        .amendment.timingReused == false and
        .amendment.qualificationChanged == false and
        .decisionRules.thresholdRelaxation == "FORBIDDEN" and
        .boundaries.proofOfConcept == true and
        .boundaries.productionAuthorized == false and
        .boundaries.automaticActivation == false and
        .boundaries.testOptimizationModified == false
    ' "${buildopt_spec}" >/dev/null
fi

buildopt_preregistered_from=$(jq -er '.preregisteredFromRevision' "${buildopt_spec}")
git -C "${buildopt_repo_root}" cat-file -e \
    "${buildopt_preregistered_from}^{commit}" 2>/dev/null || {
    printf 'holdout preregistration base is not a repository commit\n' >&2
    exit 1
}

if [[ ${buildopt_evidence} == --spec-only ]]; then
    printf 'Generic holdout preregistration: PASS\n'
    exit 0
fi

buildopt_summary="${buildopt_evidence}/summary.json"
buildopt_required=(
    "${buildopt_summary}"
    "${buildopt_evidence}/buildopt-changes.txt"
    "${buildopt_evidence}/buildopt-profile-proposal.json"
    "${buildopt_evidence}/proposal.log"
    "${buildopt_evidence}/evidence.json"
    "${buildopt_evidence}/evaluation.json"
)
for buildopt_file in "${buildopt_required[@]}"; do
    [[ -s ${buildopt_file} ]] || {
        printf 'missing holdout evidence: %s\n' "${buildopt_file}" >&2
        exit 1
    }
done

jq -e --slurpfile spec "${buildopt_spec}" '
    .schemaVersion == ($spec[0].captureEvidenceSchemaVersion // $spec[0].evidenceSchemaVersion) and
    .workItem == $spec[0].workItem and
    (.capturedAt | fromdateiso8601) > 0 and
    (.buildopt.revision | test("^[0-9a-f]{40}$")) and
    (.buildopt.executableSha256 | test("^[0-9a-f]{64}$")) and
    .buildopt.packageVersion == "0.3.0-dev" and
    .subject.key == $spec[0].subject.key and
    .subject.repositoryId == $spec[0].subject.repositoryId and
    .subject.remoteUrl == $spec[0].subject.remoteUrl and
    .subject.publicRevision == $spec[0].subject.publicRevision and
    .subject.observedPublicRevision == $spec[0].subject.publicRevision and
    (.subject.targetRevision | test("^[0-9a-f]{40}$")) and
    .subject.jdkToolchain == $spec[0].subject.jdkToolchain and
    .subject.pipelineClass == $spec[0].subject.pipelineClass and
    .subject.entrypoints == $spec[0].subject.entrypoints and
    .subject.changePath == $spec[0].subject.changePath and
    .subject.requiredOutputs == $spec[0].subject.requiredOutputs and
    .method == $spec[0].method and
    .qualification == $spec[0].qualification and
    .boundaries == $spec[0].boundaries and
    .proposal.originalEntrypoints == $spec[0].subject.entrypoints and
    (.proposal.decision | IN("MEASURE_STRUCTURAL_CANDIDATE", "NATIVE_FULL_GRAPH"))
' "${buildopt_summary}" >/dev/null

jq -e --slurpfile spec "${buildopt_spec}" '
    .schemaVersion == "buildopt.poc/profile-proposal/v1" and
    .repositoryId == $spec[0].subject.repositoryId and
    .baseRevision == $spec[0].subject.publicRevision and
    .changedPaths == [$spec[0].subject.changePath] and
    .requiredOutputs == $spec[0].subject.requiredOutputs and
    .originalEntrypoints == $spec[0].subject.entrypoints and
    .reviewRequired == true and
    .activationAutomatic == false and
    .productionAuthorized == false and
    .testOptimization == "OUT_OF_SCOPE" and
    ((.decision == "MEASURE_STRUCTURAL_CANDIDATE" and
      .reason == "COMPLETE_STRUCTURAL_REDUCTION" and
      .unknownRelationships == false and
      (.candidateEntrypoints | length) >= 1 and
      .analysis.plan.selectedProjectCount >= 1 and
      .analysis.plan.selectedProjectCount < .analysis.plan.totalProjectCount and
      .analysis.plan.omittedProjectCount ==
        (.analysis.plan.totalProjectCount - .analysis.plan.selectedProjectCount)) or
     (.decision == "NATIVE_FULL_GRAPH" and
      (.reason | IN("ORIGINAL_WORKFLOW_UNSUPPORTED", "CANDIDATE_WORKFLOW_UNSUPPORTED",
                    "CANDIDATE_GRAPH_INCOMPLETE", "NO_SAFE_STRUCTURAL_CANDIDATE",
                    "SOURCE_OWNERSHIP_AMBIGUOUS", "OUTPUTS_MISSING",
                    "REQUIRED_OUTPUTS_EMPTY", "OUTPUT_OWNERSHIP_AMBIGUOUS"))))
' "${buildopt_evidence}/buildopt-profile-proposal.json" >/dev/null

buildopt_expected_change=$(jq -er '.subject.changePath' "${buildopt_spec}")
[[ $(cat "${buildopt_evidence}/buildopt-changes.txt") == "${buildopt_expected_change}" ]] || {
    printf 'holdout changed path does not match the preregistration\n' >&2
    exit 1
}

buildopt_proposal_decision=$(jq -er '.proposal.decision' "${buildopt_summary}")
buildopt_measurement_status=$(jq -er '.measurementStatus' "${buildopt_summary}")
if [[ ${buildopt_proposal_decision} == NATIVE_FULL_GRAPH ]]; then
    jq -e '
        .measurementStatus == "NOT_RUN_NATIVE_FULL_GRAPH" and
        .result == null and
        .evaluationDecision == "NATIVE_FULL_GRAPH"
    ' "${buildopt_summary}" >/dev/null
    jq -e '. == null' "${buildopt_evidence}/evidence.json" >/dev/null
    jq -e '. == null' "${buildopt_evidence}/evaluation.json" >/dev/null
    [[ ! -e ${buildopt_evidence}/profile.json ]] || {
        printf 'native holdout decision unexpectedly wrote a profile\n' >&2
        exit 1
    }
elif [[ ${buildopt_measurement_status} == COMPLETED ]]; then
    for buildopt_name in buildopt-fallback-changes.txt \
        buildopt-impact-manifest.json buildopt-impact-graph.generated.json \
        buildopt-impact.generated.json measurement.log evaluation.log; do
        [[ -e ${buildopt_evidence}/${buildopt_name} ]] || {
            printf 'missing completed holdout evidence: %s\n' "${buildopt_name}" >&2
            exit 1
        }
    done
    jq -e '
        .schemaVersion == "buildopt.evidence/structural-profile-qualification/v1" and
        (.evidenceState | IN("QUALIFIED", "INCONCLUSIVE")) and
        .execution.candidateSurface == "INSTALLED_BUILDOPT_STRUCTURAL_IMPACT_ONLY" and
        .execution.mechanisms == ["BUILD_IMPACT"] and
        .execution.launcherOverheadIncluded == true and
        (.observations | length) == 8 and
        all(.observations[];
            .productAttributableFailure == false and
            .requiredOutputCount > 0 and
            .controlRequiredOutputSha256 == .candidateRequiredOutputSha256) and
        .fallback.mode == "FULL_GRAPH" and
        .fallback.buildSuccessful == true and
        .boundaries.repositorySpecificRuleAdded == false and
        .boundaries.testOptimizationModified == false
    ' "${buildopt_evidence}/evidence.json" >/dev/null
    if [[ $(jq -r '.schemaVersion' "${buildopt_spec}") == buildopt.specs/poc-generic-holdout/v3 ]]; then
        jq -e '
            .execution.warmupsPerArm == 2 and
            [.execution.controlWarmups[].phase] == ["CACHE_SEED", "DAEMON_STABILIZATION"] and
            [.execution.candidateWarmups[].phase] == ["CACHE_SEED", "DAEMON_STABILIZATION"] and
            all(.execution.controlWarmups[], .execution.candidateWarmups[];
                .durationMs > 0 and
                (.logSha256 | test("^[0-9a-f]{64}$")) and
                .taskOutcomes.total > 0 and
                .taskOutcomes.total == (.taskOutcomes.executed + .taskOutcomes.fromCache +
                  .taskOutcomes.upToDate + .taskOutcomes.noSource + .taskOutcomes.skipped)) and
            all(.observations[];
                (.controlLogSha256 | test("^[0-9a-f]{64}$")) and
                (.candidateLogSha256 | test("^[0-9a-f]{64}$")) and
                .controlTaskOutcomes.total > 0 and
                .candidateTaskOutcomes.total > 0)
        ' "${buildopt_evidence}/evidence.json" >/dev/null
    fi
    if [[ $(jq -r '.schemaVersion' "${buildopt_spec}") == buildopt.specs/poc-generic-holdout/v4 ]]; then
        jq -e '
            .execution.warmupsPerArm == 3 and
            [.execution.controlWarmups[].phase] == ["CACHE_SEED", "BASE_DAEMON_STABILIZATION", "TARGET_WORKLOAD_STABILIZATION"] and
            [.execution.candidateWarmups[].phase] == ["CACHE_SEED", "BASE_DAEMON_STABILIZATION", "TARGET_WORKLOAD_STABILIZATION"] and
            all(.execution.controlWarmups[], .execution.candidateWarmups[];
                .durationMs > 0 and
                (.logSha256 | test("^[0-9a-f]{64}$")) and
                .taskOutcomes.total > 0 and
                (.taskOutcomes.fingerprintSha256 | test("^[0-9a-f]{64}$")) and
                .taskOutcomes.total == (.taskOutcomes.executed + .taskOutcomes.fromCache +
                  .taskOutcomes.upToDate + .taskOutcomes.noSource + .taskOutcomes.skipped) and
                .hostPressure.available == true and
                all([.hostPressure.cpuSomeTotalUs, .hostPressure.memorySomeTotalUs,
                     .hostPressure.memoryFullTotalUs, .hostPressure.ioSomeTotalUs,
                     .hostPressure.ioFullTotalUs][]; . >= 0)) and
            all(.observations[];
                (.controlLogSha256 | test("^[0-9a-f]{64}$")) and
                (.candidateLogSha256 | test("^[0-9a-f]{64}$")) and
                (.controlTaskOutcomes.fingerprintSha256 | test("^[0-9a-f]{64}$")) and
                (.candidateTaskOutcomes.fingerprintSha256 | test("^[0-9a-f]{64}$")) and
                .controlHostPressure.available == true and
                .candidateHostPressure.available == true and
                all([.controlHostPressure.cpuSomeTotalUs, .controlHostPressure.memorySomeTotalUs,
                     .controlHostPressure.memoryFullTotalUs, .controlHostPressure.ioSomeTotalUs,
                     .controlHostPressure.ioFullTotalUs, .candidateHostPressure.cpuSomeTotalUs,
                     .candidateHostPressure.memorySomeTotalUs, .candidateHostPressure.memoryFullTotalUs,
                     .candidateHostPressure.ioSomeTotalUs, .candidateHostPressure.ioFullTotalUs][]; . >= 0)) and
            .result.executionShapeObserved == true and
            .result.targetWarmupShapeObserved == true and
            (([.observations[].controlTaskOutcomes.fingerprintSha256] | unique | length) == 1 and
             ([.observations[].candidateTaskOutcomes.fingerprintSha256] | unique | length) == 1) as $measuredShapeStable |
            (.execution.controlWarmups[2].taskOutcomes.fingerprintSha256 ==
               .observations[0].controlTaskOutcomes.fingerprintSha256 and
             .execution.candidateWarmups[2].taskOutcomes.fingerprintSha256 ==
               .observations[0].candidateTaskOutcomes.fingerprintSha256) as $targetShapeStable |
            ((.result.executionShapeStable // false) == $measuredShapeStable) and
            ((.result.targetWarmupShapeStable // false) == $targetShapeStable) and
            ((.result.qualified == false) or
             ($measuredShapeStable and $targetShapeStable))
        ' "${buildopt_evidence}/evidence.json" >/dev/null
    fi
    if [[ $(jq -r '.schemaVersion' "${buildopt_spec}") == buildopt.specs/poc-generic-holdout/v5 ]]; then
        jq -e '
            .execution.warmupsPerArm == 4 and
            [.execution.controlWarmups[].phase] == ["CACHE_SEED", "BASE_DAEMON_STABILIZATION", "TARGET_WORKLOAD_STABILIZATION", "TARGET_WORKLOAD_STABILITY_CONFIRMATION"] and
            [.execution.candidateWarmups[].phase] == ["CACHE_SEED", "BASE_DAEMON_STABILIZATION", "TARGET_WORKLOAD_STABILIZATION", "TARGET_WORKLOAD_STABILITY_CONFIRMATION"] and
            all(.execution.controlWarmups[], .execution.candidateWarmups[];
                .durationMs > 0 and
                (.logSha256 | test("^[0-9a-f]{64}$")) and
                .taskOutcomes.total > 0 and
                (.taskOutcomes.fingerprintSha256 | test("^[0-9a-f]{64}$")) and
                (.taskOutcomes.tasks | length) == .taskOutcomes.total and
                all(.taskOutcomes.tasks[];
                    (.path | startswith(":")) and
                    (.outcome | IN("EXECUTED", "FROM_CACHE", "UP_TO_DATE", "NO_SOURCE", "SKIPPED"))) and
                .hostPressure.available == true) and
            all(.observations[];
                (.controlLogSha256 | test("^[0-9a-f]{64}$")) and
                (.candidateLogSha256 | test("^[0-9a-f]{64}$")) and
                (.controlTaskOutcomes.tasks | length) == .controlTaskOutcomes.total and
                (.candidateTaskOutcomes.tasks | length) == .candidateTaskOutcomes.total and
                all(.controlTaskOutcomes.tasks[], .candidateTaskOutcomes.tasks[];
                    (.path | startswith(":")) and
                    (.outcome | IN("EXECUTED", "FROM_CACHE", "UP_TO_DATE", "NO_SOURCE", "SKIPPED"))) and
                .controlHostPressure.available == true and
                .candidateHostPressure.available == true) and
            .result.executionShapeObserved == true and
            .result.targetWarmupShapeObserved == true and
            (([.observations[].controlTaskOutcomes.fingerprintSha256] | unique | length) == 1 and
             ([.observations[].candidateTaskOutcomes.fingerprintSha256] | unique | length) == 1) as $measuredShapeStable |
            (([.execution.controlWarmups[2,3].taskOutcomes.fingerprintSha256] +
              [.observations[].controlTaskOutcomes.fingerprintSha256] | unique | length) == 1 and
             ([.execution.candidateWarmups[2,3].taskOutcomes.fingerprintSha256] +
              [.observations[].candidateTaskOutcomes.fingerprintSha256] | unique | length) == 1) as $targetShapeStable |
            ((.result.executionShapeStable // false) == $measuredShapeStable) and
            ((.result.targetWarmupShapeStable // false) == $targetShapeStable) and
            ((.result.qualified == false) or ($measuredShapeStable and $targetShapeStable))
        ' "${buildopt_evidence}/evidence.json" >/dev/null
    fi
    jq -e \
        --slurpfile evidence "${buildopt_evidence}/evidence.json" \
        --slurpfile evaluation "${buildopt_evidence}/evaluation.json" '
        .result == $evidence[0].result and
        .evaluationDecision == $evaluation[0].decision and
        .result.pairs == 8 and
        ((.result.qualified == true and
          .evaluationDecision == "QUALIFY_STRUCTURAL_PROFILE") or
         (.result.qualified == false and
          .evaluationDecision == "NATIVE_FULL_GRAPH"))
    ' "${buildopt_summary}" >/dev/null
    buildopt_qualified=$(jq -r '.result.qualified' "${buildopt_summary}")
    if [[ ${buildopt_qualified} == true ]]; then
        [[ -s ${buildopt_evidence}/profile.json ]] || {
            printf 'qualified holdout evidence is missing its review profile\n' >&2
            exit 1
        }
    else
        [[ ! -e ${buildopt_evidence}/profile.json ]] || {
            printf 'inconclusive holdout evidence unexpectedly wrote a profile\n' >&2
            exit 1
        }
    fi
elif [[ ${buildopt_measurement_status} == MEASUREMENT_UNAVAILABLE ]]; then
    jq -e '
        .result == null and .evaluationDecision == "NATIVE_FULL_GRAPH"
    ' "${buildopt_summary}" >/dev/null
    jq -e '. == null' "${buildopt_evidence}/evidence.json" >/dev/null
    grep -Fq -- 'structural profile measurement unavailable:' \
        "${buildopt_evidence}/measurement.log"
else
    printf 'invalid holdout measurement state: %s\n' \
        "${buildopt_measurement_status}" >&2
    exit 1
fi

printf 'Generic unseen holdout: PASS (%s, %s)\n' \
    "${buildopt_proposal_decision}" "${buildopt_measurement_status}"
