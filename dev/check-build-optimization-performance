#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_cache="${buildopt_repo_root}/benchmarks/results/cache-parity-v1-local.json"
buildopt_runtime="${buildopt_repo_root}/benchmarks/results/b-runtime-owner-evaluation.json"
buildopt_impact="${buildopt_repo_root}/benchmarks/results/build-impact-performance-v1-local.json"
buildopt_combined="${buildopt_repo_root}/benchmarks/results/poc-value-combined-v1.json"
buildopt_otel_historical="${buildopt_repo_root}/benchmarks/results/poc-otel-optimization-v2.json"
buildopt_otel_clean="${buildopt_repo_root}/benchmarks/results/poc-otel-clean-composition-v1.json"
buildopt_kafka_transfer="${buildopt_repo_root}/benchmarks/results/poc-third-repository-transfer-v1.json"

"${buildopt_script_dir}/check-cache-parity-performance" "${buildopt_cache}" >/dev/null
"${buildopt_script_dir}/check-runtime-owner-evaluation" >/dev/null
"${buildopt_script_dir}/check-build-impact-performance" "${buildopt_impact}" >/dev/null
"${buildopt_script_dir}/check-poc-value-combined" "${buildopt_combined}" >/dev/null
"${buildopt_script_dir}/check-poc-otel-optimization-v2-result" "${buildopt_otel_historical}" >/dev/null
"${buildopt_script_dir}/check-poc-otel-clean-composition-v1-result" "${buildopt_otel_clean}" >/dev/null
"${buildopt_script_dir}/check-poc-third-repository-transfer-v1-result" "${buildopt_kafka_transfer}" >/dev/null

jq -n \
    --slurpfile cache "${buildopt_cache}" \
    --slurpfile runtime "${buildopt_runtime}" \
    --slurpfile impact "${buildopt_impact}" \
    --slurpfile combined "${buildopt_combined}" \
    --slurpfile otelHistorical "${buildopt_otel_historical}" \
    --slurpfile otelClean "${buildopt_otel_clean}" \
    --slurpfile kafkaTransfer "${buildopt_kafka_transfer}" '
    {
        schemaVersion: "buildopt.evidence/build-optimization-scorecard/v1",
        interpretation: "ATTRIBUTABLE_RESULTS_NOT_ADDITIVE",
        safeCache: {
            claim: "FASTER_THAN_CACHE_OFF_AND_WITHIN_NATIVE_CACHE_PARITY_GUARDRAIL",
            kotlin: {
                cacheOffReductionRatio:
                    $cache[0].repositories[] |
                    select(.dsl == "KOTLIN") |
                    .comparisons.CACHE_OFF.meanReductionRatio,
                nativeCacheReductionRatio:
                    $cache[0].repositories[] |
                    select(.dsl == "KOTLIN") |
                    .comparisons.NATIVE_CACHE.meanReductionRatio
            },
            groovy: {
                cacheOffReductionRatio:
                    $cache[0].repositories[] |
                    select(.dsl == "GROOVY") |
                    .comparisons.CACHE_OFF.meanReductionRatio,
                nativeCacheReductionRatio:
                    $cache[0].repositories[] |
                    select(.dsl == "GROOVY") |
                    .comparisons.NATIVE_CACHE.meanReductionRatio
            },
            nativeCacheMaximumRegressionRatio: 0.02
        },
        runtimeTuning: {
            claim: "POSITIVE_CAUSAL_RESOURCE_PROFILE_SAVINGS",
            reductionRatio:
                $runtime[0].autotuning.metrics.reductionRatio,
            meanSavedMs:
                $runtime[0].autotuning.metrics.meanDeltaMs,
            lower95SavedMs:
                $runtime[0].autotuning.metrics.interval95Ms[0],
            artifactDivergence:
                $runtime[0].autotuning.metrics.artifactDivergence,
            oomDelta: $runtime[0].autotuning.oomDelta
        },
        buildImpact: {
            claim: "POSITIVE_SAVINGS_WHEN_A_DECLARED_PROJECT_IS_UNAFFECTED",
            reductionRatio: $impact[0].result.meanReductionRatio,
            meanSavedMs: $impact[0].result.meanSavedMs,
            positivePairs: $impact[0].result.positivePairs,
            requiredOutputsIdentical:
                $impact[0].result.requiredOutputsIdentical
        },
        combinedPublicPath: {
            claim: $combined[0].decision.claim,
            verdict: $combined[0].decision.verdict,
            pocValueProven: $combined[0].decision.pocValueProven,
            results:
                ($combined[0].workloads |
                 map({key: .id, value: {
                     meanSavedMs: .result.meanSavedMs,
                     reductionRatio: .result.meanReductionRatio,
                     lower95SavedMs: .result.interval95SavedMs[0],
                     positivePairs: .result.positivePairs
                }}) | from_entries)
        },
        historicalSubstantialPublicPath: {
            claim: "QUALIFIED_OPENTELEMETRY_SPRING_FAMILY_POC_VALUE_WITH_HOT_STATE",
            meanSavedMs: $otelHistorical[0].result.meanSavedMs,
            reductionRatio: $otelHistorical[0].result.reductionRatio,
            interval95SavedMs: $otelHistorical[0].result.interval95SavedMs,
            positivePairs: $otelHistorical[0].result.positivePairs,
            requiredOutputCount:
                $otelHistorical[0].observations[0].requiredOutputCount,
            safeFallback: $otelHistorical[0].fallback.buildSuccessful,
            hotStateEnabled: true,
            decision: $otelHistorical[0].result.decision
        },
        substantialPublicPath: {
            claim: "QUALIFIED_CLEAN_OPENTELEMETRY_COMPOSITION",
            meanSavedMs: $otelClean[0].result.meanSavedMs,
            reductionRatio: $otelClean[0].result.reductionRatio,
            interval95SavedMs: $otelClean[0].result.interval95SavedMs,
            positivePairs: $otelClean[0].result.positivePairs,
            requiredOutputCount:
                $otelClean[0].observations[0].requiredOutputCount,
            safeFallback: $otelClean[0].fallback.buildSuccessful,
            hotStateEnabled: false,
            standardJarCacheHits:
                $otelClean[0].discovery.measuredCandidateStandardJarCacheHits,
            decision: $otelClean[0].result.decision
        },
        thirdRepositoryTransfer: {
            claim: "QUALIFIED_CLEAN_PROFILE_ON_APACHE_KAFKA",
            repository: $kafkaTransfer[0].repository.nameWithOwner,
            workloadClass: "MULTI_MODULE_JAVA_SCALA_TEST_PREPARATION",
            meanSavedMs: $kafkaTransfer[0].result.meanSavedMs,
            reductionRatio: $kafkaTransfer[0].result.reductionRatio,
            interval95SavedMs: $kafkaTransfer[0].result.interval95SavedMs,
            positivePairs: $kafkaTransfer[0].result.positivePairs,
            requiredOutputCount:
                $kafkaTransfer[0].observations[0].requiredOutputCount,
            controlReachCount: $kafkaTransfer[0].discovery.controlReachCount,
            candidateReachCount: $kafkaTransfer[0].discovery.candidateReachCount,
            safeFallback: $kafkaTransfer[0].fallback.buildSuccessful,
            decision: $kafkaTransfer[0].result.decision
        },
        boundaries: {
            proofOfConcept: true,
            universalSavingsClaim: false,
            productionPromotionAuthorized: false,
            eightHourSoakExecuted: false,
            testOptimizationModified: false
        }
    }
'
