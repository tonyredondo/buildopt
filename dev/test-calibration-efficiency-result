#!/usr/bin/env bash
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_source="${buildopt_repo_root}/benchmarks/results/poc-calibration-efficiency-v1"
buildopt_temp=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-calibration-efficiency-test.XXXXXX")

buildopt_cleanup() {
    if [[ ${buildopt_temp} == "${TMPDIR:-/tmp}/buildopt-calibration-efficiency-test."* ]]; then
        rm -rf -- "${buildopt_temp}"
    fi
}
trap buildopt_cleanup EXIT

"${buildopt_script_dir}/check-calibration-efficiency-result" "${buildopt_source}"
cp -a -- "${buildopt_source}/." "${buildopt_temp}/"

jq '.cells[0].economics.optimizedCold.installedBreakEvenBuilds =
    .cells[0].economics.baseline.installedBreakEvenBuilds' \
    "${buildopt_temp}/summary.json" >"${buildopt_temp}/summary-mutated.json"
mv -- "${buildopt_temp}/summary-mutated.json" "${buildopt_temp}/summary.json"
if "${buildopt_script_dir}/check-calibration-efficiency-result" "${buildopt_temp}" \
    >/dev/null 2>&1; then
    printf 'checker accepted a regressed break-even summary\n' >&2
    exit 1
fi

cp -- "${buildopt_source}/summary.json" "${buildopt_temp}/summary.json"
printf 'tampered\n' >>"${buildopt_temp}/apache-groovy-jar-leaf-source/capture-1/replay.log"
if "${buildopt_script_dir}/check-calibration-efficiency-result" "${buildopt_temp}" \
    >/dev/null 2>&1; then
    printf 'checker accepted a tampered replay log\n' >&2
    exit 1
fi

printf 'Calibration efficiency negative fixtures OK: summary and replay tampering rejected\n'
