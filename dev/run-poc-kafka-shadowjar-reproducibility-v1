#!/usr/bin/env bash
set -euo pipefail

if (($# != 2)); then
    printf 'usage: %s OUTPUT_FILE SOURCE_ARCHIVE\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_source_archive=$2
buildopt_script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(CDPATH='' cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_spec="${buildopt_repo_root}/specs/poc-kafka-shadowjar-reproducibility-v1.json"
buildopt_java_home="${buildopt_repo_root}/.tools/toolchains/temurin-jdk-25-69264a7a211bf502"

if [[ "${buildopt_output}" != /* || -e "${buildopt_output}" ||
    ! -f "${buildopt_source_archive}" ]]; then
    printf 'invalid Kafka shadow JAR reproducibility runner input\n' >&2
    exit 64
fi
for buildopt_command in awk chmod cp date find git grep jq mkdir mktemp rm sed \
    seq sha256sum sleep sort stat tail tar timeout tr unzip zipinfo; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required Kafka reproducibility command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
if [[ -n "$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)" ]]; then
    printf 'Kafka reproducibility runner requires a clean revision-bound checkout\n' >&2
    exit 1
fi
if [[ "$(getconf _NPROCESSORS_ONLN)" != 12 ]]; then
    printf 'Kafka reproducibility runner requires exactly 12 online CPUs\n' >&2
    exit 1
fi
[[ -x "${buildopt_java_home}/bin/java" ]] || {
    printf 'locked Temurin 25 toolchain is unavailable\n' >&2
    exit 1
}
"${buildopt_script_dir}/check-poc-kafka-shadowjar-reproducibility-v1" >/dev/null

buildopt_source_sha=$(sha256sum "${buildopt_source_archive}" | awk '{print $1}')
[[ "${buildopt_source_sha}" == \
    "$(jq -er '.repository.sourceArchiveSha256' "${buildopt_spec}")" ]] || {
    printf 'Kafka source archive checksum mismatch\n' >&2
    exit 1
}
[[ "$(stat -c %s "${buildopt_source_archive}")" == \
    "$(jq -er '.repository.sourceArchiveBytes' "${buildopt_spec}")" ]] || {
    printf 'Kafka source archive size mismatch\n' >&2
    exit 1
}

buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-kafka-shadowjar-v1.XXXXXX")
buildopt_complete=false
buildopt_server_pid=''
buildopt_cleanup() {
    if [[ -n "${buildopt_server_pid}" ]]; then
        kill "${buildopt_server_pid}" >/dev/null 2>&1 || true
        wait "${buildopt_server_pid}" >/dev/null 2>&1 || true
    fi
    if [[ "${buildopt_root}" == "${TMPDIR:-/tmp}/buildopt-kafka-shadowjar-v1."* ]]; then
        if [[ "${buildopt_complete}" != true && -d "${buildopt_root}/logs" ]]; then
            tar -C "${buildopt_root}" -czf "${buildopt_output}.failure-logs.tar.gz" logs
            chmod 0600 "${buildopt_output}.failure-logs.tar.gz"
            printf 'Kafka reproducibility failure logs preserved: %s\n' \
                "${buildopt_output}.failure-logs.tar.gz" >&2
        fi
        rm -rf -- "${buildopt_root}"
    fi
}
trap buildopt_cleanup EXIT
chmod 0700 "${buildopt_root}"
mkdir -p "${buildopt_root}/prep-project" "${buildopt_root}/prep-home" \
    "${buildopt_root}/logs" "${buildopt_root}/records" "${buildopt_root}/artifacts"

buildopt_prepare_source() {
    local buildopt_project=$1
    local buildopt_normalized=$2
    mkdir -p "${buildopt_project}"
    tar -xzf "${buildopt_source_archive}" --strip-components=1 \
        -C "${buildopt_project}"
    [[ "$(sha256sum "${buildopt_project}/build.gradle" | awk '{print $1}')" == \
        "$(jq -er '.diagnosis.originalBuildFileSha256' "${buildopt_spec}")" ]]
    local buildopt_change_path
    buildopt_change_path=$(jq -er '.change.path' "${buildopt_spec}")
    [[ "$(sha256sum "${buildopt_project}/${buildopt_change_path}" | awk '{print $1}')" == \
        "$(jq -er '.change.originalSha256' "${buildopt_spec}")" ]]
    printf '\n// BuildOpt fixed Kafka packaging change.\n' \
        >>"${buildopt_project}/${buildopt_change_path}"
    if [[ "${buildopt_normalized}" == true ]]; then
        [[ "$(grep -Fxc '    reproducibleFileOrder = false' "${buildopt_project}/build.gradle")" == 1 ]]
        [[ "$(grep -Fxc '    preserveFileTimestamps = true' "${buildopt_project}/build.gradle")" == 1 ]]
        sed -i \
            -e 's/^    reproducibleFileOrder = false$/    reproducibleFileOrder = true/' \
            -e 's/^    preserveFileTimestamps = true$/    preserveFileTimestamps = false/' \
            "${buildopt_project}/build.gradle"
    fi
}

buildopt_prepare_source "${buildopt_root}/prep-project" false
if ! (
    cd "${buildopt_root}/prep-project"
    env -u CI JAVA_HOME="${buildopt_java_home}" \
        GRADLE_USER_HOME="${buildopt_root}/prep-home" \
        timeout 20m ./gradlew --no-daemon --no-build-cache \
        --no-configuration-cache --parallel --console=plain \
        --max-workers=12 --no-scan :clients:shadowJar
) >"${buildopt_root}/logs/dependency-preparation.log" 2>&1; then
    tail -n 180 "${buildopt_root}/logs/dependency-preparation.log" >&2
    printf 'Kafka dependency preparation failed\n' >&2
    exit 1
fi
grep -Fq 'BUILD SUCCESSFUL' "${buildopt_root}/logs/dependency-preparation.log"
if grep -Eq '^> Task .*:test($| )' "${buildopt_root}/logs/dependency-preparation.log"; then
    printf 'Kafka dependency preparation executed a Gradle Test task\n' >&2
    exit 1
fi
rm -rf -- "${buildopt_root}/prep-project"
rm -rf -- "${buildopt_root}/prep-home/daemon"
find "${buildopt_root}/prep-home" -type f \
    \( -name '*.lock' -o -name gc.properties \) -delete

buildopt_payload_sha() {
    local buildopt_jar=$1
    while IFS= read -r buildopt_entry; do
        printf '%s\0' "${buildopt_entry}"
        unzip -p "${buildopt_jar}" "${buildopt_entry}" | sha256sum | awk '{print $1}'
    done < <(zipinfo -1 "${buildopt_jar}" | sort) | sha256sum | awk '{print $1}'
}

buildopt_run() {
    local buildopt_label=$1
    local buildopt_normalized=$2
    local buildopt_remote_url=${3:-}
    local buildopt_project="${buildopt_root}/${buildopt_label}-project"
    local buildopt_home="${buildopt_root}/${buildopt_label}-home"
    local buildopt_log="${buildopt_root}/logs/${buildopt_label}.log"
    buildopt_prepare_source "${buildopt_project}" "${buildopt_normalized}"
    mkdir -p "${buildopt_home}"
    for buildopt_seed_dir in caches wrapper; do
        if [[ -d "${buildopt_root}/prep-home/${buildopt_seed_dir}" ]]; then
            cp -a --reflink=auto "${buildopt_root}/prep-home/${buildopt_seed_dir}" \
                "${buildopt_home}/"
        fi
    done
    find "${buildopt_home}" -type f \( -name '*.lock' -o -name gc.properties \) -delete

    local -a buildopt_args=(--no-daemon --no-configuration-cache --parallel
        --console=plain --max-workers=12 --no-scan)
    if [[ -z "${buildopt_remote_url}" ]]; then
        buildopt_args+=(--no-build-cache)
    else
        local buildopt_init="${buildopt_root}/${buildopt_label}.init.gradle"
        printf '%s\n' \
            'import org.gradle.caching.http.HttpBuildCache' \
            'settingsEvaluated { settings ->' \
            '    settings.buildCache {' \
            '        local { enabled = false }' \
            '        remote(HttpBuildCache) {' \
            "            url = uri('${buildopt_remote_url}/cache/')" \
            '            push = false' \
            '            allowUntrustedServer = true' \
            '        }' \
            '    }' \
            '}' >"${buildopt_init}"
        buildopt_args+=(--build-cache --init-script "${buildopt_init}")
    fi
    buildopt_args+=(:clients:shadowJar)

    local buildopt_started buildopt_finished
    buildopt_started=$(date +%s%N)
    if ! (
        cd "${buildopt_project}"
        env -u CI JAVA_HOME="${buildopt_java_home}" \
            GRADLE_USER_HOME="${buildopt_home}" \
            timeout 20m ./gradlew "${buildopt_args[@]}"
    ) >"${buildopt_log}" 2>&1; then
        tail -n 180 "${buildopt_log}" >&2
        printf 'Kafka reproducibility build failed: %s\n' "${buildopt_label}" >&2
        exit 1
    fi
    buildopt_finished=$(date +%s%N)
    grep -Fq 'BUILD SUCCESSFUL' "${buildopt_log}"
    grep -Fq '> Task :clients:shadowJar' "${buildopt_log}"
    if grep -Fq '> Task :clients:shadowJar FROM-CACHE' "${buildopt_log}"; then
        printf 'Kafka reproducibility build restored shadowJar from cache: %s\n' \
            "${buildopt_label}" >&2
        exit 1
    fi
    if grep -Eq '^> Task .*:test($| )' "${buildopt_log}"; then
        printf 'Kafka reproducibility build executed a Gradle Test task: %s\n' \
            "${buildopt_label}" >&2
        exit 1
    fi

    mapfile -t buildopt_outputs < <(
        find "${buildopt_project}/clients/build/libs" -maxdepth 1 -type f \
            -name 'kafka-clients-*.jar' | sort
    )
    [[ "${#buildopt_outputs[@]}" == 1 ]] || {
        printf 'Kafka shadow JAR output count mismatch: %s\n' "${buildopt_label}" >&2
        exit 1
    }
    local buildopt_jar=${buildopt_outputs[0]}
    cp "${buildopt_jar}" "${buildopt_root}/artifacts/${buildopt_label}.jar"
    jq -n \
        --arg id "${buildopt_label}" \
        --argjson normalized "${buildopt_normalized}" \
        --arg buildFileSha256 "$(sha256sum "${buildopt_project}/build.gradle" | awk '{print $1}')" \
        --arg artifactSha256 "$(sha256sum "${buildopt_jar}" | awk '{print $1}')" \
        --argjson artifactBytes "$(stat -c %s "${buildopt_jar}")" \
        --arg payloadSha256 "$(buildopt_payload_sha "${buildopt_jar}")" \
        --arg entryOrderSha256 "$(zipinfo -1 "${buildopt_jar}" | sha256sum | awk '{print $1}')" \
        --arg metadataSha256 "$(zipinfo -T -l "${buildopt_jar}" | sed -e '1,3d' -e '$d' | sha256sum | awk '{print $1}')" \
        --arg logSha256 "$(sha256sum "${buildopt_log}" | awk '{print $1}')" \
        --argjson durationMs "$(((buildopt_finished - buildopt_started) / 1000000))" \
        --argjson remoteFailure "$([[ -n "${buildopt_remote_url}" ]] && printf true || printf false)" \
        '{id: $id, normalized: $normalized, cleanSourceTree: true,
          freshGradleHome: true, buildFileSha256: $buildFileSha256,
          artifactSha256: $artifactSha256, artifactBytes: $artifactBytes,
          payloadSha256: $payloadSha256, entryOrderSha256: $entryOrderSha256,
          metadataSha256: $metadataSha256, logSha256: $logSha256,
          durationMs: $durationMs, taskExecuted: true,
          remoteFailureInjected: $remoteFailure}' \
        >"${buildopt_root}/records/${buildopt_label}.json"
}

buildopt_run baseline-a false
sleep 3
buildopt_run baseline-b false
buildopt_run normalized-a true
sleep 3
buildopt_run normalized-b true

"${buildopt_script_dir}/run" --toolchain go -- go build \
    -o "${buildopt_root}/kafka-shadowjar-503-server" \
    ./dev/kafka-shadowjar-503-server
buildopt_ready="${buildopt_root}/failure-server.url"
"${buildopt_root}/kafka-shadowjar-503-server" "${buildopt_ready}" \
    >"${buildopt_root}/logs/failure-server.log" 2>&1 &
buildopt_server_pid=$!
for _ in $(seq 1 100); do
    [[ -s "${buildopt_ready}" ]] && break
    sleep 0.1
done
[[ -s "${buildopt_ready}" ]] || {
    printf 'Kafka failure server did not become ready\n' >&2
    exit 1
}
buildopt_failure_url=$(tr -d '\r\n' <"${buildopt_ready}")
buildopt_run fallback-503 true "${buildopt_failure_url}"
kill "${buildopt_server_pid}" >/dev/null 2>&1 || true
wait "${buildopt_server_pid}" >/dev/null 2>&1 || true
buildopt_server_pid=''

buildopt_records=$(jq -s '.' \
    "${buildopt_root}/records/baseline-a.json" \
    "${buildopt_root}/records/baseline-b.json" \
    "${buildopt_root}/records/normalized-a.json" \
    "${buildopt_root}/records/normalized-b.json" \
    "${buildopt_root}/records/fallback-503.json")
buildopt_baseline_a=$(jq -r '.[0].artifactSha256' <<<"${buildopt_records}")
buildopt_baseline_b=$(jq -r '.[1].artifactSha256' <<<"${buildopt_records}")
buildopt_payload=$(jq -r '.[0].payloadSha256' <<<"${buildopt_records}")
buildopt_normalized=$(jq -r '.[2].artifactSha256' <<<"${buildopt_records}")
buildopt_build_file=$(jq -r '.[2].buildFileSha256' <<<"${buildopt_records}")

[[ "${buildopt_baseline_a}" != "${buildopt_baseline_b}" ]]
[[ "$(jq '[.[0].payloadSha256, .[1].payloadSha256] | unique | length' <<<"${buildopt_records}")" == 1 ]]
[[ "$(jq '[.[2].artifactSha256, .[3].artifactSha256, .[4].artifactSha256] | unique | length' <<<"${buildopt_records}")" == 1 ]]
[[ "$(jq '[.[].payloadSha256] | unique | length' <<<"${buildopt_records}")" == 1 ]]
grep -Eq 'Could not load entry .* from remote build cache|The remote build cache was disabled' \
    "${buildopt_root}/logs/fallback-503.log"

buildopt_revision=$(git -C "${buildopt_repo_root}" rev-parse HEAD)
jq -n \
    --arg capturedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg buildoptRevision "${buildopt_revision}" \
    --arg runnerSha256 "$(sha256sum "${BASH_SOURCE[0]}" | awk '{print $1}')" \
    --arg specSha256 "$(sha256sum "${buildopt_spec}" | awk '{print $1}')" \
    --arg serverSourceSha256 "$(sha256sum "${buildopt_repo_root}/dev/kafka-shadowjar-503-server/main.go" | awk '{print $1}')" \
    --arg sourceArchiveSha256 "${buildopt_source_sha}" \
    --arg dependencyPreparationLogSha256 "$(sha256sum "${buildopt_root}/logs/dependency-preparation.log" | awk '{print $1}')" \
    --arg baselineASha256 "${buildopt_baseline_a}" \
    --arg baselineBSha256 "${buildopt_baseline_b}" \
    --arg payloadSha256 "${buildopt_payload}" \
    --arg normalizedSha256 "${buildopt_normalized}" \
    --arg normalizedBuildFileSha256 "${buildopt_build_file}" \
    --arg failureServerLogSha256 "$(sha256sum "${buildopt_root}/logs/failure-server.log" | awk '{print $1}')" \
    --argjson builds "${buildopt_records}" \
    --slurpfile spec "${buildopt_spec}" '
    {
      schemaVersion: "buildopt.evidence/poc-kafka-shadowjar-reproducibility/v1",
      workItem: "POC-KAFKA-SHADOWJAR-REPRODUCIBILITY-001",
      capturedAt: $capturedAt,
      buildoptRevision: $buildoptRevision,
      runnerScriptSha256: $runnerSha256,
      specSha256: $specSha256,
      failureServerSourceSha256: $serverSourceSha256,
      sourceArchiveSha256: $sourceArchiveSha256,
      repository: {
        nameWithOwner: $spec[0].repository.nameWithOwner,
        releaseTag: $spec[0].repository.releaseTag,
        revision: $spec[0].repository.revision,
        gradleVersion: $spec[0].repository.gradleVersion,
        jdk: $spec[0].repository.jdk
      },
      runner: {id: "linux-amd64-12c-16659865600b-v1", cpuCount: 12,
        memoryBytes: 16659865600, maxWorkers: 12},
      preparation: {measured: false, cleanSourceCopies: 5,
        dependencyPreparationLogSha256: $dependencyPreparationLogSha256,
        partialStateReused: false},
      builds: $builds,
      attribution: {
        upstreamReproducibleFileOrder: false,
        upstreamPreserveFileTimestamps: true,
        baselineBytesIdentical: false,
        baselinePayloadIdentical: true,
        baselineArtifactSha256: [$baselineASha256, $baselineBSha256],
        logicalPayloadSha256: $payloadSha256
      },
      stabilization: {
        method: $spec[0].stabilization.method,
        normalizedBuildFileSha256: $normalizedBuildFileSha256,
        normalizedArtifactSha256: $normalizedSha256,
        independentBuildsIdentical: true,
        payloadPreserved: true,
        upstreamCheckoutModified: false
      },
      fallback: {
        remoteCacheResponseStatus: 503,
        buildSucceeded: true,
        remoteCacheDisabled: true,
        outputMatchedNormalizedBuilds: true,
        failureServerLogSha256: $failureServerLogSha256
      },
      result: {qualified: true,
        decision: $spec[0].decisionPolicy.qualifiedDecision,
        compositionRerunAuthorized: true,
        performanceClaimAllowed: false},
      boundaries: $spec[0].boundaries
    }' >"${buildopt_output}"
chmod 0600 "${buildopt_output}"

"${buildopt_script_dir}/check-poc-kafka-shadowjar-reproducibility-v1-result" \
    "${buildopt_output}"
buildopt_complete=true
printf 'POC Kafka shadow JAR reproducibility evidence written: %s\n' \
    "${buildopt_output}"
