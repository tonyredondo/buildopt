if [[ "${buildopt_artifact}" == "openapi-go-client-v1" ]]; then
    "${buildopt_script_dir}/run" \
        --toolchain go \
        -- \
        gofmt -w "${buildopt_temporary}"
fi

chmod 0644 "${buildopt_temporary}"
mv -- "${buildopt_temporary}" "${buildopt_output}"
printf 'Generated %s at %s (%s)\n' \
    "${buildopt_artifact}" \
    "${buildopt_output}" \
    "$(sha256sum "${buildopt_output}" | awk '{print $1}')"
