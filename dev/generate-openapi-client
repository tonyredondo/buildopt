#!/usr/bin/env bash
set -euo pipefail

buildopt_usage() {
    printf 'usage: %s --artifact <openapi-go-client-v1|openapi-java-client-v1> --source-root <path> --output-root <path>\n' "$0"
}

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_artifact=
buildopt_source_root=
buildopt_output_root=
while (($# > 0)); do
    case "$1" in
        --artifact)
            buildopt_artifact=${2:-}
            shift 2
            ;;
        --source-root)
            buildopt_source_root=${2:-}
            shift 2
            ;;
        --output-root)
            buildopt_output_root=${2:-}
            shift 2
            ;;
        *)
            buildopt_usage >&2
            exit 64
            ;;
    esac
done
case "${buildopt_artifact}" in
    openapi-go-client-v1 | openapi-java-client-v1) ;;
    *)
        buildopt_usage >&2
        exit 64
        ;;
esac
if [[ -z "${buildopt_source_root}" || -z "${buildopt_output_root}" ]] ||
    [[ "${buildopt_source_root}" == "/" || "${buildopt_output_root}" == "/" ]]; then
    printf 'missing or unsafe generation root\n' >&2
    exit 1
fi
for buildopt_command in awk cat mktemp sed sha256sum sort tr wc; do
    if ! command -v "${buildopt_command}" >/dev/null 2>&1; then
        printf 'required OpenAPI client generator command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    fi
done

buildopt_sources=(
    "contracts/openapi/buildopt-control.v1.yaml"
    "contracts/openapi/buildopt-cache-control.v1.yaml"
    "contracts/openapi/test-optimization.v1.yaml"
    "contracts/test-vectors/compatibility/n-n-minus-1.tsv"
)
for buildopt_source in "${buildopt_sources[@]}"; do
    if [[ ! -f "${buildopt_source_root}/${buildopt_source}" ]]; then
        printf 'generated client source is missing: %s\n' "${buildopt_source}" >&2
        exit 1
    fi
done

buildopt_work_root=$(mktemp -d)
buildopt_cleanup() {
    if [[ "${buildopt_work_root}" == /tmp/* ]] &&
        [[ -d "${buildopt_work_root}" ]]; then
        rm -rf -- "${buildopt_work_root}"
    fi
}
trap buildopt_cleanup EXIT

buildopt_operations="${buildopt_work_root}/operations.tsv"
for buildopt_spec in "${buildopt_sources[@]:0:3}"; do
    case "${buildopt_spec}" in
        */buildopt-control.v1.yaml)
            buildopt_contract_version=buildopt-control/v1
            ;;
        */buildopt-cache-control.v1.yaml)
            buildopt_contract_version=buildopt-cache-control/v1
            ;;
        */test-optimization.v1.yaml)
            buildopt_contract_version=test-optimization/v1
            ;;
    esac
    awk -v contract_version="${buildopt_contract_version}" '
        /^paths:$/ {
            in_paths = 1
            next
        }
        /^components:$/ {
            in_paths = 0
        }
        in_paths && /^  \// {
            path = $1
            sub(/:$/, "", path)
            next
        }
        in_paths && /^    (get|post):$/ {
            method = toupper($1)
            sub(/:$/, "", method)
            next
        }
        in_paths && /^      operationId: / {
            operation_id = $2
            print operation_id "\t" method "\t" path "\t" contract_version
        }
    ' "${buildopt_source_root}/${buildopt_spec}" >>"${buildopt_operations}"
done

buildopt_operation_count=$(wc -l <"${buildopt_operations}")
buildopt_unique_count=$(awk -F '\t' '{print $1}' "${buildopt_operations}" | sort -u | wc -l)
if ((buildopt_operation_count != 13 || buildopt_unique_count != 13)); then
    printf 'expected 13 unique OpenAPI operations, found %s/%s\n' \
        "${buildopt_operation_count}" \
        "${buildopt_unique_count}" >&2
    exit 1
fi

buildopt_source_digest=$(
    for buildopt_source in "${buildopt_sources[@]}"; do
        sha256sum "${buildopt_source_root}/${buildopt_source}" | awk '{print $1}'
    done | sha256sum | awk '{print $1}'
)

case "${buildopt_artifact}" in
    openapi-go-client-v1)
        buildopt_output_relative=internal/generated/openapi/client_v1.go
        ;;
    openapi-java-client-v1)
        buildopt_output_relative=jvm/generated-client/src/main/java/dev/buildopt/generated/BuildOptClientsV1.java
        ;;
esac
buildopt_output="${buildopt_output_root}/${buildopt_output_relative}"
mkdir -p -- "$(dirname -- "${buildopt_output}")"
buildopt_temporary=$(mktemp "${buildopt_output}.tmp.XXXXXX")

if [[ "${buildopt_artifact}" == "openapi-go-client-v1" ]]; then
    {
        printf '// Code generated by ./dev/generate-code --artifact %s; DO NOT EDIT.\n' \
            "${buildopt_artifact}"
        printf '// Sources SHA-256: %s\n\n' "${buildopt_source_digest}"
        cat <<'GO_HEADER'
// Package openapiclient provides the generated BuildOpt v1 control-plane
// transport bindings. Callers retain retry and semantic validation policy.
package openapiclient

import (
	"bytes"
	"context"
	"errors"
	"fmt"
	"io"
	"net/http"
	"net/url"
	"strings"
	"time"
)

const maxResponseBytes = 16 << 20

// Endpoint is one operation extracted from the normative OpenAPI documents.
type Endpoint struct {
	OperationID    string
	Method         string
	Path           string
	ContractVersion string
	Mutation       bool
}

var allEndpoints = [...]Endpoint{
GO_HEADER
        while IFS=$'\t' read -r buildopt_id buildopt_method buildopt_path buildopt_contract; do
            buildopt_mutation=false
            if [[ "${buildopt_method}" != "GET" ]]; then
                buildopt_mutation=true
            fi
            printf '\t{OperationID: "%s", Method: "%s", Path: "%s", ContractVersion: "%s", Mutation: %s},\n' \
                "${buildopt_id}" \
                "${buildopt_method}" \
                "${buildopt_path}" \
                "${buildopt_contract}" \
                "${buildopt_mutation}"
        done <"${buildopt_operations}"
        cat <<'GO_MIDDLE'
}

// Endpoints returns an isolated copy of the complete operation inventory.
func Endpoints() []Endpoint {
	return append([]Endpoint(nil), allEndpoints[:]...)
}

// EndpointByOperationID resolves one immutable generated operation.
func EndpointByOperationID(operationID string) (Endpoint, bool) {
	for _, endpoint := range allEndpoints {
		if endpoint.OperationID == operationID {
			return endpoint, true
		}
	}
	return Endpoint{}, false
}
GO_MIDDLE
        cat <<'GO_BODY'
// Client performs one explicitly selected generated operation.
type Client struct {
	BaseURL    string
	Token      string
	HTTPClient *http.Client
}

// Response retains the status, headers, and bounded response bytes.
type Response struct {
	StatusCode int
	Header     http.Header
	Body       []byte
}

// Do executes an endpoint once. It never retries implicitly, so the caller can
// preserve the original deadline, idempotency key, payload, and precondition.
func (client Client) Do(
	ctx context.Context,
	endpoint Endpoint,
	pathValues map[string]string,
	requestID string,
	idempotencyKey string,
	ifMatch string,
	deadline time.Time,
	body []byte,
) (Response, error) {
	base, err := url.Parse(client.BaseURL)
	if err != nil || base.Scheme != "https" || base.Host == "" {
		return Response{}, errors.New("generated client requires an absolute HTTPS base URL")
	}
	if client.Token == "" {
		return Response{}, errors.New("generated client requires a bearer token")
	}
	if endpoint.Mutation && idempotencyKey == "" {
		return Response{}, errors.New("mutation requires an idempotency key")
	}
	if endpoint.Mutation && len(body) == 0 {
		return Response{}, errors.New("mutation requires a JSON body")
	}
	if !deadline.IsZero() && !deadline.After(time.Now()) {
		return Response{}, context.DeadlineExceeded
	}

	path := endpoint.Path
	for name, value := range pathValues {
		path = strings.ReplaceAll(path, "{"+name+"}", url.PathEscape(value))
	}
	if strings.ContainsAny(path, "{}") {
		return Response{}, fmt.Errorf("unresolved path parameter in %q", path)
	}
	target, err := url.Parse(strings.TrimRight(client.BaseURL, "/") + path)
	if err != nil {
		return Response{}, fmt.Errorf("resolve request URL: %w", err)
	}

	var requestBody io.Reader
	if len(body) > 0 {
		requestBody = bytes.NewReader(body)
	}
	request, err := http.NewRequestWithContext(
		ctx,
		endpoint.Method,
		target.String(),
		requestBody,
	)
	if err != nil {
		return Response{}, fmt.Errorf("create request: %w", err)
	}
	request.Header.Set("Authorization", "Bearer "+client.Token)
	request.Header.Set("X-BuildOpt-Contract-Version", endpoint.ContractVersion)
	if requestID != "" {
		request.Header.Set("X-BuildOpt-Request-ID", requestID)
	}
	if idempotencyKey != "" {
		request.Header.Set("Idempotency-Key", idempotencyKey)
	}
	if ifMatch != "" {
		request.Header.Set("If-Match", ifMatch)
	}
	if !deadline.IsZero() {
		request.Header.Set("X-BuildOpt-Deadline", deadline.UTC().Format(time.RFC3339Nano))
	}
	if len(body) > 0 {
		request.Header.Set("Content-Type", "application/json")
	}

	httpClient := client.HTTPClient
	if httpClient == nil {
		httpClient = http.DefaultClient
	}
	httpResponse, err := httpClient.Do(request)
	if err != nil {
		return Response{}, fmt.Errorf("send request: %w", err)
	}
	defer httpResponse.Body.Close()
	responseBody, err := io.ReadAll(io.LimitReader(httpResponse.Body, maxResponseBytes+1))
	if err != nil {
		return Response{}, fmt.Errorf("read response: %w", err)
	}
	if len(responseBody) > maxResponseBytes {
		return Response{}, errors.New("generated client response exceeds 16 MiB")
	}
	return Response{
		StatusCode: httpResponse.StatusCode,
		Header:     httpResponse.Header.Clone(),
		Body:       responseBody,
	}, nil
}

// Shape controls unknown-field behavior during version negotiation.
type Shape string

const (
	ShapeHTTPControl     Shape = "HTTP_CONTROL"
	ShapeSignedCommand   Shape = "SIGNED_COMMAND"
	ShapeExportableRecord Shape = "EXPORTABLE_RECORD"
)

// CompatibilityDecision is the fail-closed N/N-1 negotiation result.
type CompatibilityDecision string

const (
	CompatibilityAccept                CompatibilityDecision = "ACCEPT"
	CompatibilityAcceptPreserveUnknown CompatibilityDecision = "ACCEPT_PRESERVE_UNKNOWN"
	CompatibilityRejectUnknownField    CompatibilityDecision = "REJECT_UNKNOWN_FIELD"
	CompatibilityIncompatibleBaseline  CompatibilityDecision = "INCOMPATIBLE_BASELINE"
)

// Negotiate applies the normative same-major adjacent-minor compatibility rule.
func Negotiate(
	localMajor int,
	localMinor int,
	remoteMajor int,
	remoteMinor int,
	shape Shape,
	unknownFields bool,
) CompatibilityDecision {
	minorDifference := localMinor - remoteMinor
	if minorDifference < 0 {
		minorDifference = -minorDifference
	}
	if localMajor != remoteMajor || minorDifference > 1 {
		return CompatibilityIncompatibleBaseline
	}
	if unknownFields {
		switch shape {
		case ShapeSignedCommand:
			return CompatibilityRejectUnknownField
		case ShapeExportableRecord:
			return CompatibilityAcceptPreserveUnknown
		}
	}
	return CompatibilityAccept
}
GO_BODY
    } >"${buildopt_temporary}"
else
    {
        printf '// Code generated by ./dev/generate-code --artifact %s; DO NOT EDIT.\n' \
            "${buildopt_artifact}"
        printf '// Sources SHA-256: %s\n\n' "${buildopt_source_digest}"
        cat <<'JAVA_HEADER'
package dev.buildopt.generated;

import java.io.IOException;
import java.net.URI;
import java.net.URLEncoder;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.charset.StandardCharsets;
import java.time.Duration;
import java.time.Instant;
import java.util.List;
import java.util.Map;
import java.util.Objects;

/**
 * Generated BuildOpt v1 control-plane transport bindings.
 *
 * <p>The client executes once and leaves retry and semantic validation policy
 * to its caller so the original deadline, identity, payload, and precondition
 * remain explicit.
 */
public final class BuildOptClientsV1 {
    private static final int MAX_RESPONSE_BYTES = 16 << 20;

    /** One operation extracted from a normative OpenAPI document. */
    public record Endpoint(
            String operationId,
            String method,
            String path,
            String contractVersion,
            boolean mutation) {
    }

JAVA_HEADER
        while IFS=$'\t' read -r buildopt_id buildopt_method buildopt_path buildopt_contract; do
            buildopt_java_name=$(
                sed -E 's/([[:lower:][:digit:]])([[:upper:]])/\1_\2/g' <<<"${buildopt_id}" |
                    tr '[:lower:]' '[:upper:]'
            )
            buildopt_mutation=false
            if [[ "${buildopt_method}" != "GET" ]]; then
                buildopt_mutation=true
            fi
            printf '    public static final Endpoint %s = new Endpoint("%s", "%s", "%s", "%s", %s);\n' \
                "${buildopt_java_name}" \
                "${buildopt_id}" \
                "${buildopt_method}" \
                "${buildopt_path}" \
                "${buildopt_contract}" \
                "${buildopt_mutation}"
        done <"${buildopt_operations}"
        cat <<'JAVA_MIDDLE'

    /** Complete generated operation inventory. */
    public static final List<Endpoint> ALL_ENDPOINTS = List.of(
JAVA_MIDDLE
        buildopt_index=0
        while IFS=$'\t' read -r buildopt_id _; do
            buildopt_java_name=$(
                sed -E 's/([[:lower:][:digit:]])([[:upper:]])/\1_\2/g' <<<"${buildopt_id}" |
                    tr '[:lower:]' '[:upper:]'
            )
            ((buildopt_index += 1))
            buildopt_suffix=,
            if ((buildopt_index == buildopt_operation_count)); then
                buildopt_suffix=
            fi
            printf '            %s%s\n' "${buildopt_java_name}" "${buildopt_suffix}"
        done <"${buildopt_operations}"
        cat <<'JAVA_BODY'
    );

    private BuildOptClientsV1() {
    }

    /** Bounded immutable response. */
    public record Response(int statusCode, Map<String, List<String>> headers, byte[] body) {
        public Response {
            body = body.clone();
        }

        @Override
        public byte[] body() {
            return body.clone();
        }
    }

    /** Single-attempt HTTPS client. */
    public static final class Client {
        private final URI baseUri;
        private final String token;
        private final HttpClient httpClient;

        public Client(URI baseUri, String token, HttpClient httpClient) {
            this.baseUri = Objects.requireNonNull(baseUri, "baseUri");
            this.token = Objects.requireNonNull(token, "token");
            this.httpClient = Objects.requireNonNull(httpClient, "httpClient");
            if (!"https".equalsIgnoreCase(baseUri.getScheme()) || baseUri.getHost() == null) {
                throw new IllegalArgumentException(
                        "generated client requires an absolute HTTPS base URI");
            }
            if (token.isEmpty()) {
                throw new IllegalArgumentException(
                        "generated client requires a bearer token");
            }
        }

        public Response send(
                Endpoint endpoint,
                Map<String, String> pathValues,
                String requestId,
                String idempotencyKey,
                String ifMatch,
                Instant deadline,
                byte[] body) throws IOException, InterruptedException {
            Objects.requireNonNull(endpoint, "endpoint");
            Objects.requireNonNull(pathValues, "pathValues");
            Objects.requireNonNull(body, "body");
            if (endpoint.mutation() && idempotencyKey.isEmpty()) {
                throw new IllegalArgumentException(
                        "mutation requires an idempotency key");
            }
            if (endpoint.mutation() && body.length == 0) {
                throw new IllegalArgumentException("mutation requires a JSON body");
            }
            if (deadline != null && !deadline.isAfter(Instant.now())) {
                throw new IllegalArgumentException("deadline has elapsed");
            }

            String path = endpoint.path();
            for (Map.Entry<String, String> value : pathValues.entrySet()) {
                String encoded = URLEncoder.encode(
                        value.getValue(),
                        StandardCharsets.UTF_8).replace("+", "%20");
                path = path.replace("{" + value.getKey() + "}", encoded);
            }
            if (path.indexOf('{') >= 0 || path.indexOf('}') >= 0) {
                throw new IllegalArgumentException(
                        "unresolved path parameter in " + path);
            }
            URI target = baseUri.resolve(path.startsWith("/") ? path.substring(1) : path);
            HttpRequest.BodyPublisher publisher = body.length == 0
                    ? HttpRequest.BodyPublishers.noBody()
                    : HttpRequest.BodyPublishers.ofByteArray(body);
            HttpRequest.Builder request = HttpRequest.newBuilder(target)
                    .header("Authorization", "Bearer " + token)
                    .header("X-BuildOpt-Contract-Version", endpoint.contractVersion())
                    .method(endpoint.method(), publisher);
            if (!requestId.isEmpty()) {
                request.header("X-BuildOpt-Request-ID", requestId);
            }
            if (!idempotencyKey.isEmpty()) {
                request.header("Idempotency-Key", idempotencyKey);
            }
            if (!ifMatch.isEmpty()) {
                request.header("If-Match", ifMatch);
            }
            if (deadline != null) {
                request.header("X-BuildOpt-Deadline", deadline.toString());
                Duration remaining = Duration.between(Instant.now(), deadline);
                request.timeout(remaining);
            }
            if (body.length > 0) {
                request.header("Content-Type", "application/json");
            }
            HttpResponse<byte[]> response = httpClient.send(
                    request.build(),
                    HttpResponse.BodyHandlers.ofByteArray());
            if (response.body().length > MAX_RESPONSE_BYTES) {
                throw new IOException("generated client response exceeds 16 MiB");
            }
            return new Response(
                    response.statusCode(),
                    response.headers().map(),
                    response.body());
        }
    }

    public enum Shape {
        HTTP_CONTROL,
        SIGNED_COMMAND,
        EXPORTABLE_RECORD
    }

    public enum CompatibilityDecision {
        ACCEPT,
        ACCEPT_PRESERVE_UNKNOWN,
        REJECT_UNKNOWN_FIELD,
        INCOMPATIBLE_BASELINE
    }

    /** Applies the normative same-major adjacent-minor compatibility rule. */
    public static CompatibilityDecision negotiate(
            int localMajor,
            int localMinor,
            int remoteMajor,
            int remoteMinor,
            Shape shape,
            boolean unknownFields) {
        if (localMajor != remoteMajor || Math.abs(localMinor - remoteMinor) > 1) {
            return CompatibilityDecision.INCOMPATIBLE_BASELINE;
        }
        if (unknownFields) {
            if (shape == Shape.SIGNED_COMMAND) {
                return CompatibilityDecision.REJECT_UNKNOWN_FIELD;
            }
            if (shape == Shape.EXPORTABLE_RECORD) {
                return CompatibilityDecision.ACCEPT_PRESERVE_UNKNOWN;
            }
        }
        return CompatibilityDecision.ACCEPT;
    }
