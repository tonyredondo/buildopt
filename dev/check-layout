buildopt_failed=0

for buildopt_path in "${buildopt_required_directories[@]}"; do
    if [[ ! -d "${buildopt_repo_root}/${buildopt_path}" ]]; then
        printf 'missing directory: %s\n' "${buildopt_path}" >&2
        buildopt_failed=1
    fi
done

for buildopt_path in "${buildopt_required_files[@]}"; do
    if [[ ! -f "${buildopt_repo_root}/${buildopt_path}" ]]; then
        printf 'missing file: %s\n' "${buildopt_path}" >&2
        buildopt_failed=1
    fi
done

if ! buildopt_git_root=$(git -C "${buildopt_repo_root}" rev-parse --show-toplevel 2>/dev/null); then
    printf 'not a Git repository: %s\n' "${buildopt_repo_root}" >&2
    buildopt_failed=1
elif [[ "${buildopt_git_root}" != "${buildopt_repo_root}" ]]; then
    printf 'unexpected Git root: %s\n' "${buildopt_git_root}" >&2
    buildopt_failed=1
fi

if ! buildopt_branch=$(git -C "${buildopt_repo_root}" symbolic-ref --short HEAD 2>/dev/null); then
    printf 'repository has no symbolic branch\n' >&2
    buildopt_failed=1
elif [[ "${buildopt_branch}" != "main" ]]; then
    printf 'unexpected initial branch: %s\n' "${buildopt_branch}" >&2
    buildopt_failed=1
fi

if ((buildopt_failed != 0)); then
    exit 1
fi

printf 'F0-001 layout OK: %s\n' "${buildopt_repo_root}"
