#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [contract.json]\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
buildopt_root=$(cd -- "${buildopt_script_dir}/.." && pwd -P)
buildopt_contract=${1:-"${buildopt_root}/specs/poc-magic-calibration-v1.json"}

jq -e '
    keys == [
        "authority", "budget", "checkpoint", "customerCommand", "decisions",
        "generatedDocument", "orchestration", "qualification", "schemaVersion",
        "workItem"
    ] and
    .schemaVersion == "buildopt.poc/magic-calibration/v1" and
    .workItem == "POC-MAGIC-CALIBRATION-001" and
    .customerCommand == "buildopt optimize <gradle args...>" and
    .orchestration == [
        "OPTIMIZED_NATIVE_AUTHORITATIVE", "AUTOMATIC_DISCOVERY",
        "ISOLATED_STRUCTURAL_MEASUREMENT", "FULL_GRAPH_FALLBACK",
        "BREAK_EVEN_EVALUATION"
    ] and
    .budget == {
        sharedDeadline: "DISCOVERY_AND_CALIBRATION", acceptedPairRange: [2, 16],
        qualificationPairs: 8,
        insufficientPairDecision: "CALIBRATION_PAIR_BUDGET_INSUFFICIENT"
    } and
    .qualification.order == "BALANCED_CONTROL_CANDIDATE" and
    .qualification.requiredOutputEquivalence == "EXACT_BYTES_BY_DEFAULT" and
    .qualification.minimumMeanSavedMs == 500 and
    .qualification.minimumReductionRatio == 0.02 and
    .qualification.minimumPositivePairs == 7 and
    .qualification.interval95LowerBoundPositive == true and
    .qualification.candidateP95NonRegressive == true and
    .qualification.executionShapeStableWhenObserved == true and
    .qualification.fullGraphFallbackRequired == true and
    .qualification.breakEven == "CEIL_CALIBRATION_COST_DIVIDED_BY_MEAN_SAVED" and
    .qualification.maximumBreakEvenBuilds == "CUSTOMER_BOUND" and
    .checkpoint == {
        bindingCompleteness: "CALIBRATION_COMPLETE",
        reuse: "EXACT_BINDINGS_AND_RECOMPUTED_EVIDENCE_ONLY",
        discoveryDigestRequired: true, evidenceDigestRequired: true,
        tamperDecision: "RECALIBRATE_OR_RETAIN_NATIVE"
    } and
    .decisions == {
        qualified: "CANDIDATE_CALIBRATION_QUALIFIED",
        noValue: "CALIBRATION_VALUE_NOT_PROVEN",
        poorPayback: "CALIBRATION_BREAK_EVEN_EXCEEDED",
        executionFailure: "CALIBRATION_EXECUTION_FAILED",
        budgetExhausted: "CALIBRATION_BUDGET_EXHAUSTED"
    } and
    .generatedDocument == {
        path: ".buildopt/optimize/v1/calibration/evidence.json",
        permissions: "CURRENT_USER_PRIVATE", writeBehavior: "ATOMIC_PRIVATE_REPLACE"
    } and
    .authority == {
        proofOfConcept: true, nativeGradleAuthoritative: true,
        profileMaterialized: false, automaticSelection: false,
        productionAuthorized: false, testOptimization: "OUT_OF_SCOPE"
    }
' "${buildopt_contract}" >/dev/null

grep -F 'optimizeRequiredCalibrationPairs        = 8' \
    "${buildopt_root}/internal/launcher/optimize_calibration.go" >/dev/null
grep -F 'optimizeMinimumPositiveCalibrationPairs = 7' \
    "${buildopt_root}/internal/launcher/optimize_calibration.go" >/dev/null
grep -F 'StructuralQualificationRobust7Of8P95' \
    "${buildopt_root}/internal/launcher/optimize_calibration.go" >/dev/null
grep -F 'structuralMinimumSavedMS' \
    "${buildopt_root}/internal/profilediscovery/structural.go" >/dev/null

printf 'Magic automatic-calibration contract OK\n'
