#!/usr/bin/env bash
set -euo pipefail

if (($# != 3)); then
    printf 'usage: %s OUTPUT_DIRECTORY BUILDOPT_BIN KAFKA_SOURCE_ARCHIVE\n' "$0" >&2
    exit 64
fi

buildopt_output_dir=$1
buildopt_binary=$2
buildopt_kafka_source=$3
buildopt_script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(CDPATH='' cd -- "${buildopt_script_dir}/.." && pwd)

[[ "${buildopt_output_dir}" == /* && ! -e "${buildopt_output_dir}" &&
    -x "${buildopt_binary}" && -s "${buildopt_kafka_source}" ]] || {
    printf 'qualified-profile matrix inputs are invalid\n' >&2
    exit 64
}
[[ -z "$(git -C "${buildopt_repo_root}" status --porcelain=v1 --untracked-files=all)" ]] || {
    printf 'qualified-profile matrix requires a clean revision-bound checkout\n' >&2
    exit 1
}

"${buildopt_script_dir}/check-poc-qualified-profile-matrix-v1" >/dev/null
mkdir -m 0700 -- "${buildopt_output_dir}"

buildopt_spring="${buildopt_output_dir}/spring.json"
buildopt_otel="${buildopt_output_dir}/opentelemetry.json"
buildopt_kafka="${buildopt_output_dir}/kafka.json"

"${buildopt_script_dir}/run-poc-spring-installed-impact" \
    "${buildopt_spring}" --qualified-profile
"${buildopt_script_dir}/check-poc-qualified-profile-matrix-cell" \
    spring-build-impact "${buildopt_spring}"

"${buildopt_script_dir}/run-poc-otel-clean-composition-v1" \
    "${buildopt_otel}" --qualified-profile
"${buildopt_script_dir}/check-poc-qualified-profile-matrix-cell" \
    opentelemetry-impact-standard-jar "${buildopt_otel}"

"${buildopt_script_dir}/run-poc-kafka-installed-profile-value-v1" \
    "${buildopt_kafka}" "${buildopt_binary}" "${buildopt_kafka_source}"
"${buildopt_script_dir}/check-poc-kafka-installed-profile-value-v1-result" \
    "${buildopt_kafka}"

"${buildopt_script_dir}/compose-poc-qualified-profile-matrix-v1" \
    "${buildopt_output_dir}"
