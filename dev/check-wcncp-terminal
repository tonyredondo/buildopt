#!/usr/bin/env bash
# Reconstruct the final prospective decision while retaining the retracted
# zero-row terminal record as immutable audit history.
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_evidence="${buildopt_repo_root}/benchmarks/results/wrapper-coordinated-native-corrections-v1"
buildopt_contract="${buildopt_repo_root}/specs/poc-wrapper-coordinated-native-corrections-v1.json"
buildopt_subjects="${buildopt_repo_root}/specs/poc-wrapper-coordinated-native-corrections-v1.subjects.json"

command -v jq >/dev/null 2>&1 || {
    printf 'required WCNCP command is unavailable: jq\n' >&2
    exit 1
}

jq -e '
    .status == "PROSPECTIVE_CAPTURE_COMPLETE" and
    .gates.familyCount == 10 and
    .gates.requiredConclusiveFamilies == 10 and
    .gates.minimumActionableMaterialFamilies == 3 and
    .gates.minimumCorrectnessQualifiedFamilies == 2 and
    .gates.minimumValueQualifiedFamilies == 2 and
    .gates.minimumNewValueQualifiedFamilies == 1 and
    .gates.minimumMaterialMilliseconds == 500 and
    .gates.minimumMaterialPercent == 2 and
    .gates.minimumCorrectnessStarts == 5 and
    .gates.balancedPairs == 8 and .gates.requiredPositivePairs == 8 and
    .gates.requiredOutputEquivalence == "BYTE_EXACT" and
    .gates.maximumProductFailures == 0 and
    .gates.maximumCustomerPaybackBuilds == 300 and
    [.blocks[].state] == ["DONE", "DONE", "DONE", "DONE", "DONE", "DONE", "DONE", "DONE", "DONE", "TODO", "WAITING", "WAITING", "WAITING", "WAITING"] and
    .nextBlock.id == "WCNCP-009" and .nextBlock.state == "TODO"
' "${buildopt_contract}" >/dev/null || {
    printf 'WCNCP prospective block ordering or frozen gates changed\n' >&2
    exit 1
}

cmp -s "${buildopt_evidence}/contract.json" "${buildopt_contract}" || {
    printf 'evidence contract snapshot differs from live contract\n' >&2
    exit 1
}
cmp -s "${buildopt_evidence}/subjects.json" "${buildopt_subjects}" || {
    printf 'evidence subjects snapshot differs from live subjects\n' >&2
    exit 1
}

jq -e '
    .authoritative == false and
    .terminalDecision == "RETRACTED_PREMATURE_CLOSURE" and
    .retraction.currentBlock == "WCNCP-008" and
    .retraction.prospectiveRowsContributed == 0 and
    .thresholdsMoved == false and
    .historicalEvidenceContamination == false and
    .hostedTimingInValueArithmetic == false
' "${buildopt_evidence}/terminal-decision.json" >/dev/null || {
    printf 'premature WCNCP terminal record is not explicitly retracted\n' >&2
    exit 1
}

for buildopt_block in 010 011 012; do
    buildopt_file=$(find "${buildopt_evidence}" -maxdepth 1 -type f -name "wcncp-e${buildopt_block}-*.json" -print)
    if test -z "${buildopt_file}" || ! jq -e '.state == "RETRACTED_PREMATURE_CLOSURE"' "${buildopt_file}" >/dev/null; then
        printf 'WCNCP-E%s zero-row placeholder is not retracted\n' "${buildopt_block}" >&2
        exit 1
    fi
done

"${buildopt_script_dir}/check-wcncp-controlled-materiality" \
    "${buildopt_evidence}/wcncp-e009a/attempt-1"
"${buildopt_script_dir}/check-wcncp-opportunity-breadth-final"

buildopt_final_breadth="${buildopt_evidence}/wcncp-e009-final.json"
buildopt_final_terminal="${buildopt_evidence}/wcncp-e013-final.json"
buildopt_final_decision=$(jq -r '.decision' "${buildopt_final_breadth}")
buildopt_final_conclusive=$(jq -r '.familiesConclusive' "${buildopt_final_breadth}")
buildopt_final_actionable=$(jq -r '.actionableMaterialFamilies' "${buildopt_final_breadth}")
buildopt_final_breadth_sha=$(sha256sum "${buildopt_final_breadth}" | awk '{print $1}')
jq -e \
    --arg decision "${buildopt_final_decision}" \
    --arg breadthSha "${buildopt_final_breadth_sha}" \
    --argjson conclusive "${buildopt_final_conclusive}" \
    --argjson actionable "${buildopt_final_actionable}" '
    .schemaVersion == "buildopt.wcncp/terminal-decision/v2" and
    .block == "WCNCP-013" and .evidence == "WCNCP-E013" and
    .authoritative == true and .terminalDecision == $decision and
    .basis == "wcncp-e009-final.json" and .basisSha256 == $breadthSha and
    .recomputation.wrapperFunctionalFoundation == "PASS" and
    .recomputation.prospectiveObservations == 30 and
    .recomputation.originalDiagnosticStarts == 16 and
    .recomputation.controlledDiagnosticStarts == 6 and
    .recomputation.familiesConclusive == $conclusive and $conclusive == 10 and
    .recomputation.familiesConclusiveRequired == 10 and
    .recomputation.actionableMaterialFamilies == $actionable and $actionable == 1 and
    .recomputation.actionableMaterialFamiliesRequired == 3 and
    .recomputation.correctnessQualifiedFamilies == 0 and
    .recomputation.valueQualifiedFamilies == 0 and .recomputation.ownerReviews == 0 and
    .recomputation.productFailures == 0 and
    .controlledMateriality.preflightMaximumToMinimumRatio <=
      .controlledMateriality.preflightMaximumAllowed and
    .controlledMateriality.graphqlJava == "ACTIONABLE_MATERIAL_CORRECTION" and
    .controlledMateriality.apacheGroovy == "NON_MATERIAL_BLOCKER" and
    .controlledMateriality.testRetryGradlePlugin == "UNSUPPORTED_PROBLEM_CLASS" and
    .gatedWork.publicSourceMutations == 0 and .gatedWork.candidateBuilds == 0 and
    .gatedWork.pairedValueTimingSamples == 0 and .gatedWork.reviewArtifacts == 0 and
    .thresholdsMoved == false and .historicalEvidenceContamination == false and
    .hostedTimingInValueArithmetic == false and .speedupClaim == false
' "${buildopt_final_terminal}" >/dev/null

if ! (cd -- "${buildopt_evidence}" && sha256sum -c sha256sums >/dev/null); then
    printf 'evidence sha256sums do not verify\n' >&2
    exit 1
fi

"${buildopt_script_dir}/check-wcncp-prospective-capture"

printf 'WCNCP terminal decision reconstructed: 10/10 conclusive, 1/3 actionable, %s\n' \
    "${buildopt_final_decision}"
