#!/usr/bin/env bash
# Guard the prospective lane against the retracted zero-row terminal closure.
# This checker verifies live block ordering and audit-artifact status; it does
# not manufacture a terminal decision from missing prospective evidence.
set -euo pipefail

if (($# != 0)); then
    printf 'usage: %s\n' "$0" >&2
    exit 64
fi

buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_evidence="${buildopt_repo_root}/benchmarks/results/wrapper-coordinated-native-corrections-v1"
buildopt_contract="${buildopt_repo_root}/specs/poc-wrapper-coordinated-native-corrections-v1.json"
buildopt_subjects="${buildopt_repo_root}/specs/poc-wrapper-coordinated-native-corrections-v1.subjects.json"

command -v jq >/dev/null 2>&1 || {
    printf 'required WCNCP command is unavailable: jq\n' >&2
    exit 1
}

jq -e '
    .status == "FUNCTIONAL_FOUNDATION_READY" and
    .gates.familyCount == 10 and
    .gates.requiredConclusiveFamilies == 10 and
    .gates.minimumActionableMaterialFamilies == 3 and
    .gates.minimumCorrectnessQualifiedFamilies == 2 and
    .gates.minimumValueQualifiedFamilies == 2 and
    .gates.minimumNewValueQualifiedFamilies == 1 and
    .gates.minimumMaterialMilliseconds == 500 and
    .gates.minimumMaterialPercent == 2 and
    .gates.minimumCorrectnessStarts == 5 and
    .gates.balancedPairs == 8 and .gates.requiredPositivePairs == 8 and
    .gates.requiredOutputEquivalence == "BYTE_EXACT" and
    .gates.maximumProductFailures == 0 and
    .gates.maximumCustomerPaybackBuilds == 300 and
    [.blocks[].state] == ["DONE", "DONE", "DONE", "DONE", "DONE", "DONE", "DONE", "DONE", "TODO", "WAITING", "WAITING", "WAITING", "WAITING", "WAITING"] and
    .nextBlock.id == "WCNCP-008" and .nextBlock.state == "TODO"
' "${buildopt_contract}" >/dev/null || {
    printf 'WCNCP prospective block ordering or frozen gates changed\n' >&2
    exit 1
}

cmp -s "${buildopt_evidence}/contract.json" "${buildopt_contract}" || {
    printf 'evidence contract snapshot differs from live contract\n' >&2
    exit 1
}
cmp -s "${buildopt_evidence}/subjects.json" "${buildopt_subjects}" || {
    printf 'evidence subjects snapshot differs from live subjects\n' >&2
    exit 1
}

jq -e '
    .authoritative == false and
    .terminalDecision == "RETRACTED_PREMATURE_CLOSURE" and
    .retraction.currentBlock == "WCNCP-008" and
    .retraction.prospectiveRowsContributed == 0 and
    .thresholdsMoved == false and
    .historicalEvidenceContamination == false and
    .hostedTimingInValueArithmetic == false
' "${buildopt_evidence}/terminal-decision.json" >/dev/null || {
    printf 'premature WCNCP terminal record is not explicitly retracted\n' >&2
    exit 1
}

for buildopt_block in 008 009 010 011 012; do
    buildopt_file=$(find "${buildopt_evidence}" -maxdepth 1 -type f -name "wcncp-e${buildopt_block}-*.json" -print)
    if test -z "${buildopt_file}" || ! jq -e '.state == "RETRACTED_PREMATURE_CLOSURE"' "${buildopt_file}" >/dev/null; then
        printf 'WCNCP-E%s zero-row placeholder is not retracted\n' "${buildopt_block}" >&2
        exit 1
    fi
done

if ! (cd -- "${buildopt_evidence}" && sha256sum -c sha256sums >/dev/null); then
    printf 'evidence sha256sums do not verify\n' >&2
    exit 1
fi

printf 'WCNCP prospective lane OK: WCNCP-008 is open and no terminal decision is authoritative\n'
