#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
    printf 'usage: %s [OUTPUT_JSON]\n' "$0" >&2
    exit 64
fi

buildopt_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
buildopt_capture=${buildopt_root}/benchmarks/results/change-aware-producer-closure-v1
buildopt_gate=${buildopt_root}/benchmarks/results/change-aware-breadth-gate-v1.json
buildopt_route=${buildopt_root}/specs/poc-change-aware-producer-closure-v1.json
buildopt_output=${1:-${buildopt_root}/benchmarks/results/change-aware-terminal-decision-v1.json}
[[ ${buildopt_output} == /* ]] || buildopt_output=${PWD}/${buildopt_output}

for buildopt_command in awk jq sha256sum; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf '%s is required\n' "${buildopt_command}" >&2
        exit 1
    }
done
"${buildopt_root}/dev/check-change-aware-public-capture" >/dev/null
"${buildopt_root}/dev/check-change-aware-breadth-gate" "${buildopt_gate}" >/dev/null

buildopt_route_sha=$(sha256sum "${buildopt_route}" | awk '{print $1}')
buildopt_capture_contract_sha=$(sha256sum "${buildopt_capture}/contract.json" | awk '{print $1}')
buildopt_transitions_sha=$(sha256sum "${buildopt_capture}/transitions.jsonl" | awk '{print $1}')
buildopt_gate_sha=$(sha256sum "${buildopt_gate}" | awk '{print $1}')
buildopt_generated_at=$(jq -r '.generatedAt' "${buildopt_gate}")

jq -n \
    --arg generatedAt "${buildopt_generated_at}" \
    --arg routeSha "${buildopt_route_sha}" \
    --arg captureContractSha "${buildopt_capture_contract_sha}" \
    --arg transitionsSha "${buildopt_transitions_sha}" \
    --arg gateSha "${buildopt_gate_sha}" \
    --slurpfile gate "${buildopt_gate}" '
  {
    schemaVersion:"buildopt.poc/change-aware-terminal-decision/v1",
    workItem:"SWL-CHANGE-005",
    generatedAt:$generatedAt,
    evidence:{
      routeContractSha256:$routeSha,
      captureContractSha256:$captureContractSha,
      transitionsLedgerSha256:$transitionsSha,
      breadthGateSha256:$gateSha,
      historicalEvidenceImported:false
    },
    executedBlocks:["SWL-CHANGE-000","SWL-CHANGE-001","SWL-CHANGE-002","SWL-CHANGE-005"],
    notAuthorizedBlocks:["SWL-CHANGE-003","SWL-CHANGE-004"],
    scorecard:[
      {criterion:"FRESH_INPUT_COMPLETENESS",status:"PASS",evidence:
        (($gate[0].completeInputFamilies|tostring)+"_OF_"+
          ($gate[0].completeInputFamiliesRequired|tostring)+"_FAMILIES")},
      {criterion:"REPORT_REPRODUCIBILITY",status:"PASS",evidence:"25_OF_25_REBUILT_FROM_RAW_CAPTURE"},
      {criterion:"STATIC_ACTION_OUTPUT_BINDING",status:"PASS",evidence:"1_OF_1_ACTIONS_HAS_EXACT_OMITTED_OUTPUT_BINDING"},
      {criterion:"PUBLIC_ACTION_BREADTH",status:"FAIL",evidence:
        (($gate[0].familiesExposingCompleteActions|tostring)+"_OF_5_VERSUS_REQUIRED_"+
          ($gate[0].familiesExposingCompleteActionsRequired|tostring)+"_OF_5")},
      {criterion:"INSTALLED_ACTIVE_VALUE",status:"NOT_MEASURED_NOT_AUTHORIZED"},
      {criterion:"CHRONOLOGICAL_CUMULATIVE_VALUE",status:"NOT_MEASURED_NOT_AUTHORIZED"},
      {criterion:"POSITIVE_FAMILY_CONFIDENCE",status:"NOT_MEASURED_NOT_AUTHORIZED"},
      {criterion:"PAYBACK",status:"NOT_MEASURED_NOT_AUTHORIZED"},
      {criterion:"NATIVE_RETENTION_OVERHEAD",status:"NOT_MEASURED_NOT_AUTHORIZED"},
      {criterion:"PRODUCT_ATTRIBUTABLE_FAILURES",status:"PASS",evidence:"0_CAPTURE_OR_ANALYZER_FAILURES"}
    ],
    timingRows:{status:"NOT_CREATED",reason:"CHANGE_AWARE_ACTION_BREADTH_FAILED_BEFORE_TIMING"},
    actionExecution:{status:"NOT_RUN_NOT_AUTHORIZED",family:"spring-framework"},
    speedupClaim:false,
    decision:"STOP_CHANGE_AWARE_PRODUCER_CLOSURE_POC_FOR_CURRENT_DETECTOR",
    conclusion:"CHANGE_AWARE_PRODUCER_CLOSURE_IS_COMPLETE_BUT_NOT_BROAD_ENOUGH_FOR_GENERIC_VALUE_MEASUREMENT",
    nonConclusion:"THIS_DOES_NOT_PROVE_THAT_GRADLE_BUILDS_HAVE_NO_DIFFERENT_GENERIC_OPTIMIZATION_OPPORTUNITY",
    successorAuthorized:false,
    recommendedNextWork:"ANALYZE_NO_SAFE_ACTION_CAUSES_AND_SELECT_A_MATERIALLY_DIFFERENT_GENERIC_HYPOTHESIS_BEFORE_MORE_TIMING"
  }
' >"${buildopt_output}"

printf 'Change-aware terminal decision written to %s\n' "${buildopt_output}"
