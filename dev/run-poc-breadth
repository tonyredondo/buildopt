#!/usr/bin/env bash
set -euo pipefail

if (($# != 3)); then
    printf 'usage: %s OUTPUT_FILE BUILDOPT_REVISION INSTALL_PREFIX\n' "$0" >&2
    exit 64
fi

buildopt_output=$1
buildopt_revision=$2
buildopt_prefix=$3
buildopt_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
buildopt_repo_root=$(cd -- "${buildopt_script_dir}/.." && pwd)
buildopt_fixture="${buildopt_repo_root}/fixtures/poc-breadth/realistic-multimodule"
buildopt_arm_mode=${BUILDOPT_POC_BREADTH_ARM:-BOTH}

if [[ "${buildopt_output}" != /* || -e "${buildopt_output}" ||
    ! "${buildopt_revision}" =~ ^[0-9a-f]{40}$ || "${buildopt_prefix}" != /* ]]; then
    printf 'invalid POC-BREADTH-001 input\n' >&2
    exit 64
fi
case "${buildopt_arm_mode}" in
    BOTH | CONTROL | CANDIDATE) ;;
    *)
        printf 'invalid POC-BREADTH-001 arm mode: %s\n' "${buildopt_arm_mode}" >&2
        exit 64
        ;;
esac
if [[ "${buildopt_arm_mode}" != BOTH && "${BUILDOPT_POC_OVERHEAD_TRACE:-0}" == 1 ]]; then
    printf 'isolated POC breadth arms do not support diagnostic tracing\n' >&2
    exit 64
fi
for buildopt_command in awk chmod cp date env find grep jq ln mkdir mktemp rm sed sha256sum sort; do
    command -v "${buildopt_command}" >/dev/null 2>&1 || {
        printf 'required POC-BREADTH-001 command is unavailable: %s\n' \
            "${buildopt_command}" >&2
        exit 1
    }
done
for buildopt_file in \
    "${buildopt_prefix}/bin/buildopt" \
    "${buildopt_prefix}/bin/buildopt-impact" \
    "${buildopt_prefix}/share/buildopt/buildopt.init.gradle" \
    "${buildopt_prefix}/share/buildopt/buildopt-gradle-plugin.jar"; do
    [[ -s "${buildopt_file}" ]] || {
        printf 'installed POC-BREADTH-001 artifact is unavailable: %s\n' \
            "${buildopt_file}" >&2
        exit 1
    }
done

buildopt_root=$(mktemp -d "${TMPDIR:-/tmp}/buildopt-poc-breadth-001.XXXXXX")
buildopt_cleanup() {
    if [[ "${BUILDOPT_POC_OVERHEAD_TRACE:-0}" == 1 ]]; then
        return
    fi
    if [[ "${buildopt_root}" == "${TMPDIR:-/tmp}/buildopt-poc-breadth-001."* ]]; then
        # A terminating Gradle daemon can race with deletion. The container is
        # removed immediately, so cleanup must not overwrite benchmark status.
        rm -rf -- "${buildopt_root}" 2>/dev/null || true
    fi
}
trap buildopt_cleanup EXIT

buildopt_raw="${buildopt_root}/observations.jsonl"
buildopt_runner="${buildopt_root}/runner.json"
"${buildopt_script_dir}/capture-golden-runner" "${buildopt_runner}"

buildopt_fixture_sha=$(
    cd -- "${buildopt_fixture}"
    while IFS= read -r buildopt_file; do
        printf '%s  %s\n' "$(sha256sum "${buildopt_file}" | awk '{print $1}')" "${buildopt_file}"
    done < <(find . -type f -not -path './.gradle/*' -not -path '*/build/*' -print | sort)
    )
buildopt_fixture_sha=$(printf '%s\n' "${buildopt_fixture_sha}" | sha256sum | awk '{print $1}')

buildopt_distribution_home=${GRADLE_USER_HOME:-"${HOME}/.gradle"}
if [[ ! -d "${buildopt_distribution_home}/wrapper/dists/gradle-9.6.1-bin" ]]; then
    printf 'locked Gradle 9.6.1 distribution is unavailable in %s\n' \
        "${buildopt_distribution_home}" >&2
    exit 1
fi

buildopt_gradle_arguments=(
    --offline
    --parallel
    --configuration-cache
    --build-cache
    --console=plain
    --warning-mode=fail
)
if [[ -n "${BUILDOPT_BENCHMARK_JAVA_INSTALLATIONS_PATHS:-}" ]]; then
    buildopt_gradle_arguments+=(
        "-Dorg.gradle.java.installations.paths=${BUILDOPT_BENCHMARK_JAVA_INSTALLATIONS_PATHS}"
    )
fi

buildopt_seed_gradle_home() {
    local buildopt_home=$1
    if [[ ! -e "${buildopt_home}/wrapper/dists" ]]; then
        mkdir -p -- "${buildopt_home}/wrapper"
        ln -s -- "${buildopt_distribution_home}/wrapper/dists" \
            "${buildopt_home}/wrapper/dists"
    fi
}

buildopt_prepare_workspace() {
    local buildopt_workspace=$1 buildopt_dsl=$2
    mkdir -p -- "${buildopt_workspace}"
    cp -R -- "${buildopt_fixture}/." "${buildopt_workspace}/"
    rm -rf -- "${buildopt_workspace}/.gradle" "${buildopt_workspace}/build" \
        "${buildopt_workspace}/buildSrc/build"
    if [[ "${buildopt_dsl}" == KOTLIN ]]; then
        rm -f -- "${buildopt_workspace}/settings.gradle" \
            "${buildopt_workspace}/build.gradle"
    else
        rm -f -- "${buildopt_workspace}/settings.gradle.kts" \
            "${buildopt_workspace}/build.gradle.kts"
    fi
    cp -- "${buildopt_repo_root}/gradlew" "${buildopt_workspace}/gradlew"
    chmod 0755 "${buildopt_workspace}/gradlew"
    mkdir -p -- "${buildopt_workspace}/gradle/wrapper"
    cp -- "${buildopt_repo_root}/gradle/wrapper/gradle-wrapper.jar" \
        "${buildopt_repo_root}/gradle/wrapper/gradle-wrapper.properties" \
        "${buildopt_workspace}/gradle/wrapper/"
}

buildopt_mutate_workspace() {
    local buildopt_workspace=$1 buildopt_dsl=$2 buildopt_scenario=$3 buildopt_pair=$4
    case "${buildopt_scenario}" in
        NO_CHANGE) ;;
        LEAF_CHANGE)
            sed -i -E \
                "s/return \"api-[^\"]*\" \+ SharedValue.value\(\);/return \"api-pair-${buildopt_pair}-\" + SharedValue.value();/" \
                "${buildopt_workspace}/service-api/src/main/java/dev/buildopt/breadth/ServiceApi.java"
            ;;
        SHARED_CHANGE)
            sed -i -E \
                "s/return \"shared-[^\"]*\" \+ PlatformCore.platform\(\);/return \"shared-pair-${buildopt_pair}-\" + PlatformCore.platform();/" \
                "${buildopt_workspace}/shared-lib/src/main/java/dev/buildopt/breadth/SharedValue.java"
            ;;
        BUILD_LOGIC_CHANGE)
            if [[ "${buildopt_dsl}" == KOTLIN ]]; then
                printf '\n// breadth-pair-%s\n' "${buildopt_pair}" >>"${buildopt_workspace}/build.gradle.kts"
            else
                printf '\n// breadth-pair-%s\n' "${buildopt_pair}" >>"${buildopt_workspace}/build.gradle"
            fi
            ;;
        *)
            printf 'unknown POC breadth scenario: %s\n' "${buildopt_scenario}" >&2
            exit 1
            ;;
    esac
}

buildopt_hash_files() {
    local buildopt_file
    for buildopt_file in "$@"; do
        [[ -s "${buildopt_file}" ]] || {
            printf 'required POC breadth output is unavailable: %s\n' "${buildopt_file}" >&2
            exit 1
        }
        sha256sum "${buildopt_file}" | awk '{print $1}'
    done | sha256sum | awk '{print $1}'
}

buildopt_duration_ms=0
buildopt_output_sha=
buildopt_executed_verifications=0
buildopt_configuration_cache_reused=false
buildopt_phase_json=null

buildopt_run_arm() {
    local buildopt_workspace=$1 buildopt_home=$2 buildopt_arm=$3
    local buildopt_scenario=$4 buildopt_log=$5
    local -a buildopt_tasks=(assemble testOwnedCheck)
    if [[ "${buildopt_arm}" == CANDIDATE ]]; then
        case "${buildopt_scenario}" in
            LEAF_CHANGE) buildopt_tasks=(:service-api:assemble testOwnedCheck) ;;
            SHARED_CHANGE) buildopt_tasks=(:service-api:assemble :service-worker:assemble testOwnedCheck) ;;
        esac
    fi
    buildopt_seed_gradle_home "${buildopt_home}"
    local buildopt_started buildopt_finished buildopt_status
    local buildopt_trace_base='' buildopt_trace_log=''
    local -a buildopt_arm_gradle_arguments=("${buildopt_gradle_arguments[@]}")
    if [[ "${BUILDOPT_POC_OVERHEAD_TRACE:-0}" == 1 ]]; then
        buildopt_trace_base="${buildopt_log%.log}.operations"
        buildopt_trace_log="${buildopt_trace_base}-log.txt"
        rm -f -- "${buildopt_trace_log}"
        buildopt_arm_gradle_arguments+=(
            "-Dorg.gradle.internal.operations.trace=${buildopt_trace_base}"
        )
    fi
    buildopt_started=$(date +%s%N)
    set +e
    if [[ "${buildopt_arm}" == CONTROL ]]; then
        (
            cd -- "${buildopt_workspace}"
            env GRADLE_USER_HOME="${buildopt_home}" \
                ./gradlew "${buildopt_arm_gradle_arguments[@]}" "${buildopt_tasks[@]}"
        ) >"${buildopt_log}" 2>&1
    else
        (
            cd -- "${buildopt_workspace}"
            env -u BUILDOPT_SAFE_CACHE -u BUILDOPT_RUNTIME_PROFILE \
                GRADLE_USER_HOME="${buildopt_home}" \
                "${buildopt_prefix}/bin/buildopt" gradle \
                "${buildopt_arm_gradle_arguments[@]}" "${buildopt_tasks[@]}"
        ) >"${buildopt_log}" 2>&1
    fi
    buildopt_status=$?
    set -e
    buildopt_finished=$(date +%s%N)
    if ((buildopt_status != 0)); then
        sed -n '1,240p' "${buildopt_log}" >&2
        printf 'POC breadth %s/%s arm failed\n' "${buildopt_scenario}" "${buildopt_arm}" >&2
        exit 1
    fi
    buildopt_duration_ms=$(((buildopt_finished - buildopt_started) / 1000000))
    buildopt_phase_json=null
    if [[ -n "${buildopt_trace_log}" ]]; then
        [[ -s "${buildopt_trace_log}" ]] || {
            printf 'POC breadth operation trace is unavailable: %s\n' \
                "${buildopt_trace_log}" >&2
            exit 1
        }
        buildopt_external_started_ms=$((buildopt_started / 1000000))
        buildopt_external_finished_ms=$((buildopt_finished / 1000000))
        buildopt_phase_json=$(jq -sc \
            --argjson externalStartedMs "${buildopt_external_started_ms}" \
            --argjson externalFinishedMs "${buildopt_external_finished_ms}" '
            (map(select(.startTime != null and
                        .detailsClassName == "org.gradle.launcher.exec.DefaultBuildTreeActionExecutor$1")) |
             if length == 1 then .[0] else error("expected one root build operation") end) as $rootStart |
            (map(select(.endTime != null and .id == $rootStart.id)) |
             if length == 1 then .[0] else error("expected one root build completion") end) as $rootEnd |
            (map(select(.startTime != null and
                        .detailsClassName == "org.gradle.internal.buildtree.BuildOperationFiringBuildTreeWorkExecutor$1")) |
             if length == 1 then .[0] else error("expected one main-task operation") end) as $tasksStart |
            (map(select(.endTime != null and .id == $tasksStart.id)) |
             if length == 1 then .[0] else error("expected one main-task completion") end) as $tasksEnd |
            {
                externalDurationMs: ($externalFinishedMs - $externalStartedMs),
                launcherAndGradleClientStartupMs: ($rootStart.startTime - $externalStartedMs),
                initPluginSetupMs: 0,
                configurationBeforeTasksMs: ($tasksStart.startTime - $rootStart.startTime),
                taskExecutionTemporalMs: ($tasksEnd.endTime - $tasksStart.startTime),
                gradleFinalizationMs: ($rootEnd.endTime - $tasksEnd.endTime),
                launcherAndGradleClientTeardownMs: ($externalFinishedMs - $rootEnd.endTime),
                gradleRootDurationMs: ($rootEnd.endTime - $rootStart.startTime),
                candidateMode: "NATIVE_ONLY"
            } |
            .reconciledDurationMs = (
                .launcherAndGradleClientStartupMs + .initPluginSetupMs +
                .configurationBeforeTasksMs + .taskExecutionTemporalMs +
                .gradleFinalizationMs + .launcherAndGradleClientTeardownMs
            ) |
            if (.externalDurationMs - .reconciledDurationMs | fabs) <= 2 and
               ([.launcherAndGradleClientStartupMs, .configurationBeforeTasksMs,
                 .taskExecutionTemporalMs, .gradleFinalizationMs,
                 .launcherAndGradleClientTeardownMs] | all(. >= 0))
            then . else error("operation phases do not reconcile") end
        ' "${buildopt_trace_log}")
    fi
    buildopt_executed_verifications=$(grep -Ec '^> Task :[^:]+:pocVerify$' "${buildopt_log}" || true)
    buildopt_configuration_cache_reused=false
    if grep -Fq 'Reusing configuration cache.' "${buildopt_log}"; then
        buildopt_configuration_cache_reused=true
    fi

    case "${buildopt_scenario}" in
        LEAF_CHANGE)
            buildopt_output_sha=$(buildopt_hash_files \
                "${buildopt_workspace}/service-api/build/libs/service-api-1.0.jar" \
                "${buildopt_workspace}/service-api/build/poc-breadth/verification.txt" \
                "${buildopt_workspace}/build/test-owned/check.txt")
            ;;
        SHARED_CHANGE)
            buildopt_output_sha=$(buildopt_hash_files \
                "${buildopt_workspace}/service-api/build/libs/service-api-1.0.jar" \
                "${buildopt_workspace}/service-worker/build/libs/service-worker-1.0.jar" \
                "${buildopt_workspace}/service-api/build/poc-breadth/verification.txt" \
                "${buildopt_workspace}/service-worker/build/poc-breadth/verification.txt" \
                "${buildopt_workspace}/build/test-owned/check.txt")
            ;;
        *)
            buildopt_output_sha=$(buildopt_hash_files \
                "${buildopt_workspace}/platform-core/build/libs/platform-core-1.0.jar" \
                "${buildopt_workspace}/shared-lib/build/libs/shared-lib-1.0.jar" \
                "${buildopt_workspace}/service-api/build/libs/service-api-1.0.jar" \
                "${buildopt_workspace}/service-worker/build/libs/service-worker-1.0.jar" \
                "${buildopt_workspace}/developer-tool/build/libs/developer-tool-1.0.jar" \
                "${buildopt_workspace}/platform-core/build/poc-breadth/verification.txt" \
                "${buildopt_workspace}/shared-lib/build/poc-breadth/verification.txt" \
                "${buildopt_workspace}/service-api/build/poc-breadth/verification.txt" \
                "${buildopt_workspace}/service-worker/build/poc-breadth/verification.txt" \
                "${buildopt_workspace}/developer-tool/build/poc-breadth/verification.txt" \
                "${buildopt_workspace}/build/test-owned/check.txt")
            ;;
    esac
}

buildopt_record_pair() {
    local buildopt_id=$1 buildopt_scenario=$2 buildopt_change=$3 buildopt_success=$4
    local buildopt_dsl=$5 buildopt_pair=$6 buildopt_order=$7
    local buildopt_control_ms=$8 buildopt_candidate_ms=$9
    local buildopt_control_sha=${10} buildopt_candidate_sha=${11}
    local buildopt_control_executed=${12} buildopt_candidate_executed=${13}
    local buildopt_control_cc=${14} buildopt_candidate_cc=${15}
    local buildopt_control_phases=${16:-null} buildopt_candidate_phases=${17:-null}
    jq -cn \
        --arg workloadId "${buildopt_id}" --arg scenario "${buildopt_scenario}" \
        --arg changeClass "${buildopt_change}" --arg successClass "${buildopt_success}" \
        --arg dsl "${buildopt_dsl}" --arg order "${buildopt_order}" \
        --arg controlSha256 "${buildopt_control_sha}" \
        --arg candidateSha256 "${buildopt_candidate_sha}" \
        --argjson pair "${buildopt_pair}" \
        --argjson controlDurationMs "${buildopt_control_ms}" \
        --argjson candidateDurationMs "${buildopt_candidate_ms}" \
        --argjson controlExecutedVerifications "${buildopt_control_executed}" \
        --argjson candidateExecutedVerifications "${buildopt_candidate_executed}" \
        --argjson controlConfigurationCacheReused "${buildopt_control_cc}" \
        --argjson candidateConfigurationCacheReused "${buildopt_candidate_cc}" \
        --argjson controlPhases "${buildopt_control_phases}" \
        --argjson candidatePhases "${buildopt_candidate_phases}" '{
            workloadId: $workloadId,
            scenario: $scenario,
            changeClass: $changeClass,
            successClass: $successClass,
            dsl: $dsl,
            pair: $pair,
            order: $order,
            controlDurationMs: $controlDurationMs,
            candidateDurationMs: $candidateDurationMs,
            savedMs: ($controlDurationMs - $candidateDurationMs),
            controlOutputSha256: $controlSha256,
            candidateOutputSha256: $candidateSha256,
            controlExecutedVerifications: $controlExecutedVerifications,
            candidateExecutedVerifications: $candidateExecutedVerifications,
            controlConfigurationCacheReused: $controlConfigurationCacheReused,
            candidateConfigurationCacheReused: $candidateConfigurationCacheReused,
            productAttributableFailure: false
        } + (if $controlPhases == null then {} else {
            controlPhases: $controlPhases,
            candidatePhases: $candidatePhases
        } end)' >>"${buildopt_raw}"
}

buildopt_record_arm() {
    local buildopt_id=$1 buildopt_scenario=$2 buildopt_change=$3 buildopt_success=$4
    local buildopt_dsl=$5 buildopt_pair=$6 buildopt_arm=$7
    local buildopt_duration=$8 buildopt_sha=$9 buildopt_executed=${10}
    local buildopt_cc=${11}
    jq -cn \
        --arg workloadId "${buildopt_id}" --arg scenario "${buildopt_scenario}" \
        --arg changeClass "${buildopt_change}" --arg successClass "${buildopt_success}" \
        --arg dsl "${buildopt_dsl}" --arg arm "${buildopt_arm}" \
        --arg outputSha256 "${buildopt_sha}" \
        --argjson pair "${buildopt_pair}" \
        --argjson durationMs "${buildopt_duration}" \
        --argjson executedVerifications "${buildopt_executed}" \
        --argjson configurationCacheReused "${buildopt_cc}" '{
            workloadId: $workloadId,
            scenario: $scenario,
            changeClass: $changeClass,
            successClass: $successClass,
            dsl: $dsl,
            pair: $pair,
            arm: $arm,
            durationMs: $durationMs,
            outputSha256: $outputSha256,
            executedVerifications: $executedVerifications,
            configurationCacheReused: $configurationCacheReused,
            productAttributableFailure: false
        }' >>"${buildopt_raw}"
}

for buildopt_dsl in KOTLIN GROOVY; do
    buildopt_dsl_lower=${buildopt_dsl,,}
    for buildopt_scenario in NO_CHANGE LEAF_CHANGE SHARED_CHANGE BUILD_LOGIC_CHANGE; do
        case "${buildopt_scenario}" in
            NO_CHANGE) buildopt_change=NONE; buildopt_success=PARITY ;;
            LEAF_CHANGE) buildopt_change=LEAF_SOURCE; buildopt_success=ACCELERATOR ;;
            SHARED_CHANGE) buildopt_change=SHARED_SOURCE; buildopt_success=ACCELERATOR ;;
            BUILD_LOGIC_CHANGE) buildopt_change=GLOBAL_BUILD_LOGIC; buildopt_success=PARITY ;;
        esac
        buildopt_slug=${buildopt_scenario,,}
        buildopt_control="${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-control"
        buildopt_candidate="${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-candidate"
        buildopt_control_home="${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-control-home"
        buildopt_candidate_home="${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-candidate-home"
        if [[ "${buildopt_arm_mode}" != BOTH ]]; then
            buildopt_arm_lower=${buildopt_arm_mode,,}
            buildopt_workspace="${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-${buildopt_arm_lower}"
            buildopt_home="${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-${buildopt_arm_lower}-home"
            buildopt_prepare_workspace "${buildopt_workspace}" "${buildopt_dsl}"
            if [[ "${buildopt_arm_mode}" == CANDIDATE ]]; then
                buildopt_preflight_workspace="${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-candidate-preflight"
                buildopt_prepare_workspace "${buildopt_preflight_workspace}" "${buildopt_dsl}"
                buildopt_seed_gradle_home "${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-preflight-home"
                (
                    cd -- "${buildopt_preflight_workspace}"
                    env GRADLE_USER_HOME="${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-preflight-home" \
                        "${buildopt_prefix}/bin/buildopt-impact" check \
                        --repository "${buildopt_preflight_workspace}" \
                        --manifest buildopt-impact-manifest.json \
                        --repository-id tonyredondo/buildopt-poc-breadth \
                        --pipeline-class poc-breadth \
                        --graph buildopt-impact-graph.generated.json \
                        --generated-manifest buildopt-impact.generated.json \
                        --gradle-command ./gradlew >/dev/null
                )
            fi
            buildopt_run_arm "${buildopt_workspace}" "${buildopt_home}" \
                "${buildopt_arm_mode}" "${buildopt_scenario}" \
                "${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-warm-${buildopt_arm_lower}.log"
            for buildopt_pair in {1..8}; do
                buildopt_mutate_workspace "${buildopt_workspace}" "${buildopt_dsl}" \
                    "${buildopt_scenario}" "${buildopt_pair}"
                buildopt_run_arm "${buildopt_workspace}" "${buildopt_home}" \
                    "${buildopt_arm_mode}" "${buildopt_scenario}" \
                    "${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-${buildopt_pair}-${buildopt_arm_lower}.log"
                buildopt_record_arm "BREADTH_${buildopt_scenario}_${buildopt_dsl}" \
                    "${buildopt_scenario}" "${buildopt_change}" "${buildopt_success}" \
                    "${buildopt_dsl}" "${buildopt_pair}" "${buildopt_arm_mode}" \
                    "${buildopt_duration_ms}" "${buildopt_output_sha}" \
                    "${buildopt_executed_verifications}" "${buildopt_configuration_cache_reused}"
                printf 'POC-STABILITY-001 %s/%s %s sample %d: %dms\n' \
                    "${buildopt_scenario}" "${buildopt_dsl}" "${buildopt_arm_mode}" \
                    "${buildopt_pair}" "${buildopt_duration_ms}"
            done
            continue
        fi
        buildopt_prepare_workspace "${buildopt_control}" "${buildopt_dsl}"
        buildopt_prepare_workspace "${buildopt_candidate}" "${buildopt_dsl}"

        buildopt_seed_gradle_home "${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-preflight-home"
        (
            cd -- "${buildopt_candidate}"
            env GRADLE_USER_HOME="${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-preflight-home" \
                "${buildopt_prefix}/bin/buildopt-impact" check \
                --repository "${buildopt_candidate}" \
                --manifest buildopt-impact-manifest.json \
                --repository-id tonyredondo/buildopt-poc-breadth \
                --pipeline-class poc-breadth \
                --graph buildopt-impact-graph.generated.json \
                --generated-manifest buildopt-impact.generated.json \
                --gradle-command ./gradlew >/dev/null
        )

        buildopt_run_arm "${buildopt_control}" "${buildopt_control_home}" CONTROL \
            "${buildopt_scenario}" "${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-warm-control.log"
        buildopt_run_arm "${buildopt_candidate}" "${buildopt_candidate_home}" CANDIDATE \
            "${buildopt_scenario}" "${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-warm-candidate.log"

        for buildopt_pair in {1..8}; do
            buildopt_mutate_workspace "${buildopt_control}" "${buildopt_dsl}" "${buildopt_scenario}" "${buildopt_pair}"
            buildopt_mutate_workspace "${buildopt_candidate}" "${buildopt_dsl}" "${buildopt_scenario}" "${buildopt_pair}"
            buildopt_order=CONTROL_FIRST
            if ((buildopt_pair % 2 == 0)); then buildopt_order=CANDIDATE_FIRST; fi
            for buildopt_position in FIRST SECOND; do
                buildopt_arm=CONTROL
                if [[ ("${buildopt_order}" == CONTROL_FIRST && "${buildopt_position}" == SECOND) ||
                    ("${buildopt_order}" == CANDIDATE_FIRST && "${buildopt_position}" == FIRST) ]]; then
                    buildopt_arm=CANDIDATE
                fi
                if [[ "${buildopt_arm}" == CONTROL ]]; then
                    buildopt_run_arm "${buildopt_control}" "${buildopt_control_home}" CONTROL \
                        "${buildopt_scenario}" "${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-${buildopt_pair}-control.log"
                    buildopt_control_ms=${buildopt_duration_ms}
                    buildopt_control_sha=${buildopt_output_sha}
                    buildopt_control_executed=${buildopt_executed_verifications}
                    buildopt_control_cc=${buildopt_configuration_cache_reused}
                    buildopt_control_phases=${buildopt_phase_json}
                else
                    buildopt_run_arm "${buildopt_candidate}" "${buildopt_candidate_home}" CANDIDATE \
                        "${buildopt_scenario}" "${buildopt_root}/${buildopt_dsl_lower}-${buildopt_slug}-${buildopt_pair}-candidate.log"
                    buildopt_candidate_ms=${buildopt_duration_ms}
                    buildopt_candidate_sha=${buildopt_output_sha}
                    buildopt_candidate_executed=${buildopt_executed_verifications}
                    buildopt_candidate_cc=${buildopt_configuration_cache_reused}
                    buildopt_candidate_phases=${buildopt_phase_json}
                fi
            done
            buildopt_record_pair "BREADTH_${buildopt_scenario}_${buildopt_dsl}" \
                "${buildopt_scenario}" "${buildopt_change}" "${buildopt_success}" \
                "${buildopt_dsl}" "${buildopt_pair}" "${buildopt_order}" \
                "${buildopt_control_ms}" "${buildopt_candidate_ms}" \
                "${buildopt_control_sha}" "${buildopt_candidate_sha}" \
                "${buildopt_control_executed}" "${buildopt_candidate_executed}" \
                "${buildopt_control_cc}" "${buildopt_candidate_cc}" \
