{
  "schemaVersion": "1.0",
  "metricDefinitionVersion": "build-impact-v1",
  "decisionIds": [
    "METRICS-001",
    "MEASURE-001"
  ],
  "measurementStates": [
    "COMPLETE",
    "PARTIAL",
    "UNAVAILABLE"
  ],
  "observationMethods": [
    "EXACT",
    "APPROXIMATED",
    "UNAVAILABLE"
  ],
  "outcomeClasses": [
    "SUCCESS",
    "BUILD_FAILURE",
    "INFRA_FAILURE",
    "CANCELLED"
  ],
  "dimensions": [
    "actionId",
    "cacheState",
    "cacheTier",
    "changeClass",
    "daemonState",
    "effectScope",
    "environment",
    "measurementEpoch",
    "outcome",
    "pipelineClass",
    "repositoryId",
    "runnerClass",
    "runnerPool",
    "trustDomain",
    "workUnitsFingerprint",
    "workspaceState"
  ],
  "comparisonRules": {
    "savedAndReductionSign": "POSITIVE_IS_IMPROVEMENT",
    "deltaSign": "NEGATIVE_IS_IMPROVEMENT",
    "outcomeIsolation": true,
    "requiredStrata": [
      "environment",
      "pipelineClass",
      "runnerClass",
      "outcome",
      "workUnitsFingerprint",
      "measurementEpoch"
    ],
    "pairedRequirements": [
      "same workUnitsFingerprint and required deliverables",
      "same pipeline and runner class",
      "prescribed workspace, daemon, and cache state",
      "same Test Optimization grant and policy",
      "assignment persisted before outcome"
    ],
    "invalidComparison": "INCONCLUSIVE"
  },
  "promotionPolicy": {
    "version": "beta-measurement-v1",
    "directReversible": {
      "minimumWindowDays": 7,
      "minimumObservationsPerArm": 100
    },
    "proofGated": {
      "minimumWindowDays": 14,
      "minimumObservationsPerArm": 200
    },
    "minimumBenefit": {
      "bound": "ONE_SIDED_95_LOWER",
      "combination": "MAX",
      "absoluteMilliseconds": 500,
      "relativeToControl": 0.02
    },
    "p95Regression": {
      "bound": "ONE_SIDED_95_UPPER",
      "combination": "MAX",
      "absoluteMilliseconds": 500,
      "relativeToControl": 0.03
    },
    "p99Regression": {
      "bound": "OBSERVED_UPPER",
      "combination": "MAX",
      "absoluteMilliseconds": 1000,
      "relativeToControl": 0.05
    },
    "p99MinimumObservationsPerArm": 1000,
    "postPromotionControlRatio": 0.05,
    "maximumAdditionalComputeDays": 28,
    "correctness": [
      {
        "metricId": "requiredDeliverableDivergenceRate",
        "maximum": 0
      },
      {
        "metricId": "productAttributableFailureRate",
        "maximum": 0
      }
    ],
    "insufficientEvidenceState": "INCONCLUSIVE"
  },
  "metrics": [
    {
      "id": "customerVisibleBuildMs",
      "owner": "BUILD_OPTIMIZATION",
      "purpose": "Primary customer-visible build latency and source for the product north star.",
      "lifecycle": "BUILD_SESSION",
      "formula": "monotonic(endBoundary - startBoundary)",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "All assigned build sessions, aggregated only within comparable outcome classes.",
      "denominator": "NONE",
      "sources": ["neutral measurement envelope"],
      "startBoundary": "NEUTRAL_ENVELOPE_HANDOFF",
      "endBoundary": "EXIT_CODE_AND_REQUIRED_DELIVERABLES_AVAILABLE",
      "dimensions": ["environment", "pipelineClass", "runnerClass", "outcome", "workUnitsFingerprint"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["monotonic clock", "non-negative duration", "same boundary for every arm"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["Includes all synchronous product overhead.", "Never replace session latency with a sum of task or process durations."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "customerVisibleFeedbackMs",
      "owner": "CI_ADAPTER",
      "purpose": "End-to-end feedback guardrail including queue time caused or experienced.",
      "lifecycle": "BUILD_SESSION",
      "formula": "authenticated(deliverablesAvailableAt - jobEligibleAt)",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "CI sessions whose provider exposes stable authenticated eligibility and completion boundaries.",
      "denominator": "NONE",
      "sources": ["authenticated CI adapter", "neutral measurement envelope"],
      "startBoundary": "CI_JOB_ELIGIBLE",
      "endBoundary": "EXIT_CODE_AND_REQUIRED_DELIVERABLES_AVAILABLE",
      "dimensions": ["pipelineClass", "runnerPool", "runnerClass", "outcome", "workUnitsFingerprint"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["provider timestamps have stable semantics", "queue and execution boundaries reconcile"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["Unavailable for local builds or providers without authenticated eligibility time."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "UNAVAILABLE"]
    },
    {
      "id": "ciQueueMs",
      "owner": "CI_ADAPTER",
      "purpose": "Queue context and guardrail for product-attributable capacity effects.",
      "lifecycle": "BUILD_SESSION",
      "formula": "authenticated(runnerStartedAt - jobEligibleAt)",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "CI sessions with authenticated eligibility and runner-start timestamps.",
      "denominator": "NONE",
      "sources": ["authenticated CI adapter"],
      "startBoundary": "CI_JOB_ELIGIBLE",
      "endBoundary": "CI_RUNNER_STARTED",
      "dimensions": ["pipelineClass", "runnerPool", "runnerClass", "outcome"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["analyzed per runner pool", "control and canary capacity included"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["Never inferred from the Gradle process."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "UNAVAILABLE"]
    },
    {
      "id": "runnerOccupiedMs",
      "owner": "CI_ADAPTER",
      "purpose": "Capacity and economic consumption including asynchronous product work.",
      "lifecycle": "BUILD_SESSION",
      "formula": "temporal union of runner assignment intervals owned by the session",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "Sessions and linked control, canary, validation, or shadow work with authenticated runner assignment.",
      "denominator": "NONE",
      "sources": ["authenticated CI adapter", "orchestration ledger"],
      "startBoundary": "FIRST_RUNNER_ASSIGNMENT",
      "endBoundary": "LAST_RUNNER_RELEASE",
      "dimensions": ["pipelineClass", "runnerPool", "runnerClass", "effectScope", "actionId"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["overlapping intervals form a union", "linked asynchronous work is retained"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["May exceed customer-visible latency when additional work continues asynchronously."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "gradleProcessMs",
      "owner": "GRADLE_ADAPTER",
      "purpose": "Per-invocation process diagnostic that does not replace session latency.",
      "lifecycle": "BUILD_SESSION",
      "formula": "monotonic(processEnd - processStart)",
      "unit": "ms",
      "grain": "GRADLE_INVOCATION",
      "population": "Every observed Gradle invocation belonging to a build session.",
      "denominator": "NONE",
      "sources": ["launcher process lifecycle", "authenticated Gradle producer"],
      "startBoundary": "GRADLE_PROCESS_STARTED",
      "endBoundary": "GRADLE_PROCESS_ENDED",
      "dimensions": ["environment", "pipelineClass", "runnerClass", "outcome", "workUnitsFingerprint"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["process interval lies inside the session envelope"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["Multiple invocation durations may overlap and must not be summed as session latency."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "gradleProcessUnionMs",
      "owner": "BUILD_OPTIMIZATION",
      "purpose": "Session-level time covered by one or more Gradle processes.",
      "lifecycle": "BUILD_SESSION",
      "formula": "duration of union(gradle invocation intervals)",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "Sessions with one or more observed Gradle process intervals.",
      "denominator": "NONE",
      "sources": ["gradleProcessMs intervals"],
      "startBoundary": "FIRST_GRADLE_PROCESS_STARTED",
      "endBoundary": "LAST_GRADLE_PROCESS_ENDED",
      "dimensions": ["environment", "pipelineClass", "runnerClass", "outcome", "workUnitsFingerprint"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["overlap counted once", "union does not exceed the session envelope"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["Not the sum of parallel invocation durations."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "buildCriticalPathMs",
      "owner": "GRADLE_ADAPTER",
      "purpose": "Locate serial work that determines required-deliverable completion.",
      "lifecycle": "BUILD_SESSION",
      "formula": "duration from first to last node on the validated required-work critical path",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "Sessions with a complete supported task graph and required-deliverables manifest.",
      "denominator": "NONE",
      "sources": ["authenticated task events", "required work manifest"],
      "startBoundary": "FIRST_CRITICAL_PATH_NODE_STARTED",
      "endBoundary": "LAST_REQUIRED_CRITICAL_PATH_NODE_COMPLETED",
      "dimensions": ["pipelineClass", "runnerClass", "outcome", "workUnitsFingerprint"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["complete graph coverage", "required deliverables identified"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["Approximate paths must identify their method and cannot be presented as exact."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "timeToFirstBuildFailureMs",
      "owner": "BUILD_OPTIMIZATION",
      "purpose": "Failure-feedback latency without treating a faster failed build as successful savings.",
      "lifecycle": "BUILD_SESSION",
      "formula": "monotonic(firstActionableBuildFailureAt - neutralEnvelopeHandoffAt)",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "BUILD_FAILURE sessions, separated by failure class.",
      "denominator": "NONE",
      "sources": ["neutral measurement envelope", "authenticated failure event"],
      "startBoundary": "NEUTRAL_ENVELOPE_HANDOFF",
      "endBoundary": "FIRST_ACTIONABLE_BUILD_FAILURE",
      "dimensions": ["pipelineClass", "runnerClass", "outcome", "workUnitsFingerprint", "changeClass"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["never mixed with successful, infrastructure-failure, or cancelled sessions"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["A final nonzero exit provides only a labeled upper-bound approximation."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "testOwnedTaskExecutionMs",
      "owner": "TEST_OPTIMIZATION",
      "purpose": "Reconcile Test Optimization work ownership without double-counting wall time.",
      "lifecycle": "BUILD_SESSION",
      "formula": "sum(test-owned task action durations)",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "Sessions containing tasks covered by an authenticated Test Optimization grant.",
      "denominator": "NONE",
      "sources": ["authenticated Test Optimization grant", "task action events"],
      "startBoundary": "EACH_TEST_OWNED_TASK_ACTION_START",
      "endBoundary": "EACH_TEST_OWNED_TASK_ACTION_END",
      "dimensions": ["pipelineClass", "runnerClass", "outcome", "workUnitsFingerprint"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["one primary action owner", "grant digest matches the assignment"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["Intervals may overlap and are not a wall-clock decomposition component."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "launcherAndPolicyMs",
      "owner": "BUILD_OPTIMIZATION",
      "purpose": "Non-overlapping policy and launcher component of customerVisibleBuildMs.",
      "lifecycle": "BUILD_SESSION",
      "formula": "union of synchronous launcher and policy intervals before Gradle startup",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "Sessions with component-level neutral-envelope instrumentation.",
      "denominator": "customerVisibleBuildMs",
      "sources": ["neutral measurement envelope", "launcher lifecycle"],
      "startBoundary": "NEUTRAL_ENVELOPE_HANDOFF",
      "endBoundary": "GRADLE_START_HANDOFF",
      "dimensions": ["environment", "pipelineClass", "runnerClass", "outcome"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["no overlap with another decomposition component", "component sum reconciles within tolerance"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["Policy-off still measures the common launcher envelope."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "gatewayStartupMs",
      "owner": "BUILD_OPTIMIZATION",
      "purpose": "Synchronous local gateway startup and readiness overhead.",
      "lifecycle": "BUILD_SESSION",
      "formula": "monotonic(gatewayReadyAt - gatewayStartRequestedAt)",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "Sessions that start or reconnect a managed gateway.",
      "denominator": "customerVisibleBuildMs",
      "sources": ["launcher gateway lifecycle"],
      "startBoundary": "GATEWAY_START_REQUESTED",
      "endBoundary": "AUTHENTICATED_GATEWAY_READY",
      "dimensions": ["environment", "pipelineClass", "runnerClass"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["readiness is authenticated", "restart and reconnect are distinguished"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["A reused gateway may have a measured zero synchronous startup interval, not an absent value."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "gradleStartupAndInitializationMs",
      "owner": "GRADLE_ADAPTER",
      "purpose": "Non-overlapping Gradle startup and initialization component.",
      "lifecycle": "BUILD_SESSION",
      "formula": "union of Gradle process startup and initialization intervals",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "Sessions with supported authenticated Gradle lifecycle events.",
      "denominator": "customerVisibleBuildMs",
      "sources": ["launcher process lifecycle", "authenticated Gradle lifecycle"],
      "startBoundary": "GRADLE_PROCESS_STARTED",
      "endBoundary": "GRADLE_INITIALIZATION_COMPLETED",
      "dimensions": ["pipelineClass", "runnerClass", "daemonState", "outcome"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["temporal union across invocations", "no overlap with configuration"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["Daemon and Configuration Cache state remain dimensions, not hidden adjustments."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "configurationMs",
      "owner": "GRADLE_ADAPTER",
      "purpose": "Non-overlapping Gradle configuration component.",
      "lifecycle": "BUILD_SESSION",
      "formula": "temporal union of supported Gradle configuration intervals",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "Sessions with supported authenticated configuration lifecycle events.",
      "denominator": "customerVisibleBuildMs",
      "sources": ["authenticated Gradle lifecycle"],
      "startBoundary": "GRADLE_CONFIGURATION_STARTED",
      "endBoundary": "GRADLE_CONFIGURATION_COMPLETED",
      "dimensions": ["pipelineClass", "runnerClass", "daemonState", "cacheState", "outcome"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["temporal union across invocations", "Configuration Cache state retained"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["Configuration Cache entry-load cost remains in this component."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "executionOrRestoreMs",
      "owner": "GRADLE_ADAPTER",
      "purpose": "Non-overlapping task execution, cache restore, and required-work component.",
      "lifecycle": "BUILD_SESSION",
      "formula": "temporal union of required task execution and restore intervals",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "Sessions with supported task lifecycle coverage.",
      "denominator": "customerVisibleBuildMs",
      "sources": ["authenticated task events", "cache gateway events"],
      "startBoundary": "FIRST_REQUIRED_EXECUTION_OR_RESTORE_STARTED",
      "endBoundary": "LAST_REQUIRED_EXECUTION_OR_RESTORE_COMPLETED",
      "dimensions": ["pipelineClass", "runnerClass", "cacheState", "outcome", "workUnitsFingerprint"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["parallel intervals form a union", "required work manifest is complete"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["Summed task durations may exceed this wall-clock component."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "finalizationMs",
      "owner": "BUILD_OPTIMIZATION",
      "purpose": "Non-overlapping synchronous finalization component through deliverable availability.",
      "lifecycle": "BUILD_SESSION",
      "formula": "monotonic(deliverablesAvailableAt - requiredWorkCompletedAt)",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "Sessions whose required-work and deliverable boundaries are known.",
      "denominator": "customerVisibleBuildMs",
      "sources": ["neutral measurement envelope", "deliverables validator", "launcher finalization"],
      "startBoundary": "REQUIRED_WORK_COMPLETED",
      "endBoundary": "EXIT_CODE_AND_REQUIRED_DELIVERABLES_AVAILABLE",
      "dimensions": ["environment", "pipelineClass", "runnerClass", "outcome"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["includes synchronous export and validation", "excludes asynchronous telemetry"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["Async export cost remains an economic/resource metric, not customer-visible latency."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "unattributedMs",
      "owner": "BUILD_OPTIMIZATION",
      "purpose": "Residual needed to reconcile the non-overlapping latency decomposition.",
      "lifecycle": "BUILD_SESSION",
      "formula": "customerVisibleBuildMs - sum(non-overlapping observed components)",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "Sessions with any component-level latency measurement.",
      "denominator": "customerVisibleBuildMs",
      "sources": ["neutral measurement envelope", "all decomposition components"],
      "startBoundary": "NEUTRAL_ENVELOPE_HANDOFF",
      "endBoundary": "EXIT_CODE_AND_REQUIRED_DELIVERABLES_AVAILABLE",
      "dimensions": ["environment", "pipelineClass", "runnerClass", "outcome"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["component sum plus residual reconciles within published tolerance", "clock anomalies invalidate exactness"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["A large residual is a data-quality signal, not an optimization category."],
      "signConvention": "NON_NEGATIVE",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "observedNetBuildTimeSavedMs",
      "owner": "EXPERIMENT_SERVICE",
      "purpose": "Causal PRODUCT_TOTAL or ACTION_INCREMENTAL time benefit including regressions.",
      "lifecycle": "EXPERIMENT_RESULT",
      "formula": "control customerVisibleBuildMs - candidate customerVisibleBuildMs",
      "unit": "ms",
      "grain": "EXPERIMENT_STRATUM",
      "population": "Comparable assigned sessions analyzed by intention to treat and outcome class.",
      "denominator": "comparable sessions per arm",
      "sources": ["BUILD_SESSION records", "pre-outcome assignment ledger"],
      "startBoundary": "EXPERIMENT_WINDOW_START",
      "endBoundary": "EXPERIMENT_WINDOW_END",
      "dimensions": ["effectScope", "measurementEpoch", "pipelineClass", "runnerClass", "outcome", "actionId"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["causal design required", "interval and effect statistic exported", "negative regressions retained"],
      "retention": "EXPERIMENT_RESULT_RECORD",
      "caveats": ["Historical or prior-build comparison alone cannot populate this metric.", "ACTION_INCREMENTAL effects are not added to PRODUCT_TOTAL."],
      "signConvention": "POSITIVE_IS_IMPROVEMENT",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "observedBuildTimeReductionRatio",
      "owner": "EXPERIMENT_SERVICE",
      "purpose": "Scale-independent causal build-time benefit.",
      "lifecycle": "EXPERIMENT_RESULT",
      "formula": "sum(control - candidate) / sum(control)",
      "unit": "ratio",
      "grain": "EXPERIMENT_STRATUM",
      "population": "The same comparable sessions used for observedNetBuildTimeSavedMs.",
      "denominator": "sum control customerVisibleBuildMs",
      "sources": ["observedNetBuildTimeSavedMs inputs"],
      "startBoundary": "EXPERIMENT_WINDOW_START",
      "endBoundary": "EXPERIMENT_WINDOW_END",
      "dimensions": ["effectScope", "measurementEpoch", "pipelineClass", "runnerClass", "outcome", "actionId"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["ratio of aggregate sums", "individual percentages are never averaged"],
      "retention": "EXPERIMENT_RESULT_RECORD",
      "caveats": ["A negative ratio is a retained regression."],
      "signConvention": "POSITIVE_IS_IMPROVEMENT",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "estimatedNetBuildTimeSavedMs",
      "owner": "EXPERIMENT_SERVICE",
      "purpose": "Contextual model estimate for ranking or bounded exploration.",
      "lifecycle": "BUILD_SESSION",
      "formula": "versioned contextual model estimate of control - candidate latency",
      "unit": "ms",
      "grain": "BUILD_SESSION",
      "population": "Eligible sessions with the declared model features available before outcome.",
      "denominator": "NONE",
      "sources": ["versioned historical model", "pre-outcome comparison features"],
      "startBoundary": "MODEL_FEATURE_SNAPSHOT",
      "endBoundary": "MODEL_ESTIMATE_EMITTED",
      "dimensions": ["effectScope", "measurementEpoch", "pipelineClass", "runnerClass", "actionId"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["model version and 95 percent interval required", "never labeled observed or causal"],
      "retention": "BUILD_SESSION_RECORD",
      "caveats": ["Estimates are never added to observed portfolio savings."],
      "signConvention": "POSITIVE_IS_IMPROVEMENT",
      "allowedMethods": ["APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "productSynchronousOverheadMs",
      "owner": "BUILD_OPTIMIZATION",
      "purpose": "Complete policy-off product cost relative to the native pre-product baseline.",
      "lifecycle": "EXPERIMENT_RESULT",
      "formula": "policy-off wrapper customerVisibleBuildMs - native baseline customerVisibleBuildMs",
      "unit": "ms",
      "grain": "PAIRED_EXECUTION",
      "population": "Paired, otherwise identical no-hit executions on the same runner class.",
      "denominator": "one comparable native and wrapper observation",
      "sources": ["neutral measurement envelope", "versioned baseline definition"],
      "startBoundary": "NEUTRAL_ENVELOPE_HANDOFF",
      "endBoundary": "EXIT_CODE_AND_REQUIRED_DELIVERABLES_AVAILABLE",
      "dimensions": ["measurementEpoch", "environment", "pipelineClass", "runnerClass", "outcome", "workUnitsFingerprint"],
      "nullPolicy": "UNAVAILABLE_WITH_REASON",
      "qualityRules": ["native and wrapper arms use the same external envelope", "execution order is balanced", "raw signed differences retained"],
      "retention": "EXPERIMENT_RESULT_RECORD",
      "caveats": ["This is not causal product savings and does not activate a promotion gate in the walking skeleton."],
      "signConvention": "POSITIVE_IS_REGRESSION",
      "allowedMethods": ["EXACT", "APPROXIMATED", "UNAVAILABLE"]
    },
    {
      "id": "productSynchronousOverheadRatio",
      "owner": "BUILD_OPTIMIZATION",
      "purpose": "Wrapper overhead relative to native baseline duration.",
      "lifecycle": "EXPERIMENT_RESULT",
      "formula": "productSynchronousOverheadMs / native baseline customerVisibleBuildMs",
      "unit": "ratio",
      "grain": "PAIRED_EXECUTION",
      "population": "The same paired executions used for productSynchronousOverheadMs.",
      "denominator": "native baseline customerVisibleBuildMs",
