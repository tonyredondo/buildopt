{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.buildopt.dev/adaptive-fragment-portfolio.v1.schema.json",
  "title": "BuildOpt ADAPTIVE_FRAGMENT_PORTFOLIO v1",
  "description": "One immutable repository-scoped portfolio of current adaptive fragment generations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "repositoryScopeSha256", "generation", "fragments", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "buildopt.adaptive/portfolio/v1" },
    "recordType": { "const": "ADAPTIVE_FRAGMENT_PORTFOLIO" },
    "repositoryScopeSha256": { "$ref": "#/$defs/sha256" },
    "generation": { "$ref": "#/$defs/generation" },
    "supersedesSha256": { "$ref": "#/$defs/sha256" },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/entry" }
    },
    "createdAt": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "generation": { "const": 1 } }, "required": ["generation"] },
      "then": { "not": { "required": ["supersedesSha256"] } },
      "else": { "required": ["supersedesSha256"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "state": { "enum": ["OBSERVED", "SHADOW", "QUALIFIED", "ACTIVE", "SUSPENDED", "EXPIRED"] },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyId", "revisionId", "fragmentGeneration", "state"],
      "properties": {
        "familyId": { "$ref": "#/$defs/sha256" },
        "revisionId": { "$ref": "#/$defs/sha256" },
        "fragmentGeneration": { "$ref": "#/$defs/generation" },
        "state": { "$ref": "#/$defs/state" }
      }
    }
  }
}
