{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.buildopt.dev/test-cache-grant.v1.schema.json",
  "title": "BuildOpt TestCacheGrant v1",
  "description": "Signed fail-closed authorization issued by Test Optimization before Gradle configuration for explicitly selected test task types or adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "contractVersion",
    "grantId",
    "grantEpoch",
    "grantDigest",
    "repository",
    "revisionOrPolicyRange",
    "allowedTaskTypesOrAdapters",
    "namespace",
    "read",
    "write",
    "issuedAt",
    "expiresAt",
    "policyDigest",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "recordType": {
      "const": "TEST_CACHE_GRANT"
    },
    "contractVersion": {
      "const": "test-optimization/v1"
    },
    "grantId": {
      "$ref": "#/$defs/identifier"
    },
    "grantEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "grantDigest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "revisionOrPolicyRange": {
      "$ref": "#/$defs/revisionOrPolicyRange"
    },
    "allowedTaskTypesOrAdapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selector"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]{1,512}$"
    },
    "read": {
      "type": "boolean"
    },
    "write": {
      "type": "boolean"
    },
    "issuedAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "expiresAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "policyDigest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "anyOf": [
    {
      "properties": {
        "read": {
          "const": true
        }
      },
      "required": [
        "read"
      ]
    },
    {
      "properties": {
        "write": {
          "const": true
        }
      },
      "required": [
        "write"
      ]
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^(?:sha256|hmac-sha256):[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "repository",
        "trustDomain"
      ],
      "properties": {
        "tenant": {
          "$ref": "#/$defs/identifier"
        },
        "repository": {
          "$ref": "#/$defs/identifier"
        },
        "trustDomain": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "revisionOrPolicyRange": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "revision",
            "sourceStateDigest"
          ],
          "properties": {
            "kind": {
              "const": "REVISION"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,64}$"
            },
            "sourceStateDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "policyId",
            "minimumPolicyVersion",
            "maximumPolicyVersion"
          ],
          "properties": {
            "kind": {
              "const": "POLICY_RANGE"
            },
            "policyId": {
              "$ref": "#/$defs/identifier"
            },
            "minimumPolicyVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "maximumPolicyVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "TASK_TYPE",
            "ADAPTER"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "keyId",
        "signedPayloadDigest",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "canonicalization": {
          "const": "JCS"
        },
        "keyId": {
          "$ref": "#/$defs/identifier"
        },
        "signedPayloadDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
