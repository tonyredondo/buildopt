{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.buildopt.dev/commit-decision.v1.schema.json",
  "title": "BuildOpt CommitDecision v1",
  "description": "Canonical immutable authenticated authorization for one atomic first-writer-wins publication of an exactly covered pending object set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "contractVersion",
    "decisionId",
    "decisionDigest",
    "attemptId",
    "repository",
    "sourceRevision",
    "sourceStateDigest",
    "objects",
    "policyDigest",
    "configurationPolicyDigest",
    "cacheContractDigest",
    "testOptimizationGrant",
    "revocationEpoch",
    "validation",
    "issuedAt",
    "expiresAt",
    "authentication"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "recordType": {
      "const": "COMMIT_DECISION"
    },
    "contractVersion": {
      "const": "buildopt-cache-commit/v1"
    },
    "decisionId": {
      "$ref": "#/$defs/identifier"
    },
    "decisionDigest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "attemptId": {
      "$ref": "#/$defs/identifier"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "sourceStateDigest": {
      "$ref": "#/$defs/digest"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "policyDigest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "configurationPolicyDigest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "cacheContractDigest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "testOptimizationGrant": {
      "$ref": "#/$defs/grant"
    },
    "revocationEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "issuedAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "expiresAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "authentication": {
      "$ref": "#/$defs/authentication"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^(?:sha256|hmac-sha256):[0-9a-f]{64}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "repository",
        "trustDomain"
      ],
      "properties": {
        "tenant": {
          "$ref": "#/$defs/identifier"
        },
        "repository": {
          "$ref": "#/$defs/identifier"
        },
        "trustDomain": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespaceGeneration",
        "key",
        "checksum",
        "sizeBytes"
      ],
      "properties": {
        "namespaceGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,256}$"
        },
        "checksum": {
          "$ref": "#/$defs/sha256Digest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 107374182400
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "PRESENT",
            "NOT_REQUIRED"
          ]
        },
        "grantId": {
          "$ref": "#/$defs/identifier"
        },
        "grantEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "expiresAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "reason": {
          "const": "NO_TEST_OUTPUTS"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "PRESENT"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "grantId",
              "grantEpoch",
              "digest",
              "expiresAt"
            ],
            "not": {
              "required": [
                "reason"
              ]
            }
          },
          "else": {
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "grantId"
                  ]
                },
                {
                  "required": [
                    "grantEpoch"
                  ]
                },
                {
                  "required": [
                    "digest"
                  ]
                },
                {
                  "required": [
                    "expiresAt"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASSED",
            "NOT_REQUIRED"
          ]
        },
        "evidenceRef": {
          "$ref": "#/$defs/identifier"
        },
        "completedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "reason": {
          "const": "ALLOWLISTED_DIRECT_ACTION"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASSED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidenceRef",
              "completedAt",
              "expiresAt"
            ],
            "not": {
              "required": [
                "reason"
              ]
            }
          },
          "else": {
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "evidenceRef"
                  ]
                },
                {
                  "required": [
                    "completedAt"
                  ]
                },
                {
                  "required": [
                    "expiresAt"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/identifier"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
