{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.buildopt.dev/central-state-cas.v1.schema.json",
  "title": "BuildOpt CENTRAL_STATE_CAS v1",
  "description": "One idempotent create-or-advance request for a CENTRAL_STATE_HEAD. Arithmetic generation and manifest-link checks remain semantic conformance requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "operation",
    "idempotencyKey",
    "expectedGeneration",
    "expectedHeadSha256",
    "next"
  ],
  "properties": {
    "schemaVersion": {
      "const": "buildopt.central/state-cas/v1"
    },
    "recordType": {
      "const": "CENTRAL_STATE_CAS"
    },
    "operation": {
      "const": "CREATE_OR_ADVANCE"
    },
    "idempotencyKey": {
      "$ref": "#/$defs/sha256"
    },
    "expectedGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "expectedHeadSha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "next": {
      "$ref": "central-state-head.v1.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "expectedGeneration": {
            "const": 0
          }
        },
        "required": [
          "expectedGeneration"
        ]
      },
      "then": {
        "properties": {
          "expectedHeadSha256": {
            "type": "null"
          },
          "next": {
            "properties": {
              "generation": {
                "const": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "expectedHeadSha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
