{
  "schemaVersion": "buildopt.build-impact/manifest/v1",
  "manifestVersion": 1,
  "repositoryId": "hibernate/hibernate-orm",
  "pipelineClass": "assemble",
  "ownership": "REPOSITORY_COMMITTED",
  "originalEntrypoints": [
    "assemble"
  ],
  "allowedAlternatives": [
    {
      "id": "changed-projects",
      "entrypoints": [
        ":hibernate-core:assemble"
      ]
    }
  ],
  "requiredArtifacts": [
    {
      "id": "required-output-1",
      "path": "hibernate-core/build/libs/**",
      "owner": "BUILD_OPTIMIZATION"
    }
  ],
  "requiredChecks": [],
  "globalChangePaths": [
    "build-logic/**",
    "build.gradle",
    "build.gradle.kts",
    "buildSrc/**",
    "gradle.properties",
    "gradle/**",
    "settings.gradle",
    "settings.gradle.kts"
  ],
  "unknownChangePolicy": "FULL_GRAPH"
}
