+        boolean admitted = gradleVersion.equals("9.7.1")
+            && task.getJavaLauncher().get().getMetadata().getLanguageVersion().asInt() == 21
+            && expectedStateBinding.equals(task.getConfigProperties().get("buildopt_state"))
+            && task.getConfigDirectory()
+                .get()
+                .getAsFile()
+                .toPath()
+                .toAbsolutePath()
+                .normalize()
+                .equals(originalConfig.getParentFile().toPath().toAbsolutePath().normalize())
+            && CheckstyleSuccessState.hash(originalConfig.toPath()).equals(CONFIG_HASH)
+            && task.getConfig().asString().equals(adapt(Files.readString(originalConfig.toPath())))
+            && task.getClasspath().isEmpty()
+            && task.getReports().getXml().getRequired().get()
+            && task.getReports().getHtml().getRequired().get() == false
+            && task.getReports().getSarif().getRequired().get() == false;
+        boolean engine = false;
+        boolean rules = false;
+        int ordinal = 0;
+        for (File file : task.getCheckstyleClasspath()) {
+            String hash = file.isFile() ? CheckstyleSuccessState.hash(file.toPath()) : "unsupported directory";
+            identity.put("classpath:" + ordinal++, file.getAbsolutePath() + "=" + hash);
+            engine |= hash.equals(ENGINE_HASH);
+            if (file.isFile() && file.getName().equals("build-conventions.jar")) {
+                admitted &= rules == false;
+                rules = qualifiedRules(file);
+            } else {
+                admitted &= hash.equals(ENGINE_DEPENDENCIES.get(file.getName()));
+            }
+        }
+        admitted &= engine && rules;
+        Path configDirectory = task.getConfigDirectory().get().getAsFile().toPath();
+        try (var files = Files.walk(configDirectory)) {
+            for (Path file : files.filter(Files::isRegularFile).sorted().toList()) {
+                identity.put("configFile:" + configDirectory.relativize(file), CheckstyleSuccessState.hash(file));
+            }
+        }
+        File report = task.getReports().getXml().getOutputLocation().get().getAsFile();
+        identity.put("report", report.getAbsolutePath());
+        // Length prefixes avoid ambiguous identities for arbitrary property values and paths.
+        StringBuilder text = new StringBuilder();
+        identity.forEach((key, item) -> text.append(key.length()).append(':').append(key).append(item.length()).append(':').append(item));
+        String fingerprint = CheckstyleSuccessState.hash(text.toString().getBytes(StandardCharsets.UTF_8));
+        return new Context(fingerprint, admitted);
+    }
+
+    private static boolean qualifiedRules(File file) throws IOException {
+        try (JarFile jar = new JarFile(file)) {
+            for (String name : new String[] {
+                "ContentAwareChecker.class",
+                "ContentAwareChecker$OrderedEvents.class",
+                "CheckstyleSuccessState.class" }) {
+                String path = "org/elasticsearch/gradle/internal/checkstyle/" + name;
+                var member = jar.getJarEntry(path);
+                if (member == null) {
+                    return false;
+                }
+                try (
+                    var expected = CheckstyleSuccessHistory.class.getResourceAsStream("/" + path);
+                    var actual = jar.getInputStream(member)
+                ) {
+                    if (expected == null
+                        || CheckstyleSuccessState.hash(expected.readAllBytes())
+                            .equals(CheckstyleSuccessState.hash(actual.readAllBytes())) == false) {
+                        return false;
+                    }
+                }
+            }
+            for (Map.Entry<String, String> entry : RULE_HASHES.entrySet()) {
+                var member = jar.getJarEntry("org/elasticsearch/gradle/internal/checkstyle/" + entry.getKey());
+                if (member == null) {
+                    return false;
+                }
+                try (var input = jar.getInputStream(member)) {
+                    if (CheckstyleSuccessState.hash(input.readAllBytes()).equals(entry.getValue()) == false) {
+                        return false;
+                    }
+                }
+            }
+        }
+        return true;
+    }
+
+    /** Commit only after native worker completion and all requested reports have been written. */
+    private record Commit(File directory, File originalConfig, String gradleVersion) implements Action<Task> {
+        @Override
+        public void execute(Task value) {
+            Path state = directory.toPath();
+            try {
+                Properties request = CheckstyleSuccessState.read(state.resolve("request"));
+                Properties proposed = CheckstyleSuccessState.read(state.resolve("proposed"));
+                if (request.getProperty("requestId") != null
+                    && request.getProperty("requestId").equals(proposed.getProperty("requestId"))
+                    && request.getProperty("identity").equals(proposed.getProperty("identity"))) {
+                    Checkstyle task = (Checkstyle) value;
+                    Context after = context(task, state, originalConfig, gradleVersion);
+                    if (after.admitted() == false || after.identity().equals(request.getProperty("identity")) == false) {
+                        return;
+                    }
+                    Path report = task.getReports().getXml().getOutputLocation().get().getAsFile().toPath();
+                    proposed.setProperty("reportHash", CheckstyleSuccessState.hash(report));
+                    CheckstyleSuccessState.write(state.resolve("success"), proposed);
+                }
+                Files.deleteIfExists(state.resolve("request"));
+                Files.deleteIfExists(state.resolve("proposed"));
+            } catch (IOException e) {
+                value.getLogger().info("Checkstyle success history was not committed", e);
+            }
+        }
+    }
+}
