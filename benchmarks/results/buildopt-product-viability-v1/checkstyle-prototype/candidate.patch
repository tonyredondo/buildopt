+
+    private CheckstyleSuccessHistory() {}
+
+    /** Generate a Gradle-only configuration; the original XML remains usable by IDEs. */
+    public static String adapt(String original) {
+        return original.replace(ORIGINAL_ROOT, ADAPTED_ROOT);
+    }
+
+    /** Retain the native task type, source, checking classpath, dependencies and reports. */
+    public static void install(Project project, Checkstyle task, File originalConfig, File adaptedConfig) {
+        File state = new File(project.getRootDir(), ".gradle/buildopt-checkstyle/server/" + task.getName());
+        task.getLocalState().register(state);
+        task.getConfigProperties()
+            .put(
+                "buildopt_state",
+                originalConfig.getParentFile().toPath().relativize(state.toPath()).toString().replace(File.separatorChar, '/')
+            );
+        task.setConfig(project.getResources().getText().fromFile(adaptedConfig));
+        task.doFirst(new Prepare(state, originalConfig, project.getGradle().getGradleVersion(), project.getResources().getText()));
+        task.doLast(new Commit(state, originalConfig, project.getGradle().getGradleVersion()));
+    }
+
+    /** Invalidate the previous commit before the worker starts, so cancellation cannot publish partial state. */
