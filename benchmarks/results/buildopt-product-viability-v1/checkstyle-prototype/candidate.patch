+
+package org.elasticsearch.gradle.internal.checkstyle;
+
+import com.puppycrawl.tools.checkstyle.Checker;
+import com.puppycrawl.tools.checkstyle.DefaultConfiguration;
+import com.puppycrawl.tools.checkstyle.api.AuditEvent;
+import com.puppycrawl.tools.checkstyle.api.AuditListener;
+import com.puppycrawl.tools.checkstyle.api.CheckstyleException;
+import com.puppycrawl.tools.checkstyle.api.Configuration;
+import com.puppycrawl.tools.checkstyle.api.RootModule;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Properties;
+import java.util.Set;
+
+/**
+ * Reuses content-bound successes for the qualified source-only rule set. The native Checker
+ * owns parsing, filtering, diagnostics and formatting. Replayed successes contain no violations;
+ * their native audit events retain every report entry in the current input enumeration order.
+ */
+public final class ContentAwareChecker implements RootModule {
+    private final Checker checker = new Checker();
+    private final List<AuditListener> listeners = new ArrayList<>();
+    private final Set<String> reusable = new HashSet<>();
+    private final Properties completed = new Properties();
+    private List<File> inputs = List.of();
+    private Map<String, String> hashes = Map.of();
+    private Path stateDirectory;
+    private int cursor;
+    private boolean violation;
+
+    /** Use the native module factory and classloader, including all owner checks. */
+    @Override
+    public void setModuleClassLoader(ClassLoader classLoader) {
+        checker.setModuleClassLoader(classLoader);
+    }
+
+    /** Strip only the adapter property; every native property, message and child is retained. */
+    @Override
+    public void configure(Configuration configuration) throws CheckstyleException {
+        DefaultConfiguration nativeConfiguration = new DefaultConfiguration("Checker");
+        for (String property : configuration.getPropertyNames()) {
+            if ("buildoptStateDirectory".equals(property)) {
+                stateDirectory = Path.of(configuration.getProperty(property)).toAbsolutePath().normalize();
+            } else {
+                nativeConfiguration.addProperty(property, configuration.getProperty(property));
+            }
+        }
+        configuration.getMessages().forEach(nativeConfiguration::addMessage);
+        for (Configuration child : configuration.getChildren()) {
+            nativeConfiguration.addChild(child);
+        }
+        checker.configure(nativeConfiguration);
+        checker.addListener(new OrderedEvents());
+    }
+
+    /** The Ant task still supplies its ordinary XML, console and severity listeners. */
+    @Override
+    public void addListener(AuditListener listener) {
+        listeners.add(listener);
+    }
+
+    /** Never publish successes after an error, exception, incomplete report or unsupported request. */
+    @Override
+    public int process(List<File> files) throws CheckstyleException {
+        inputs = List.copyOf(files);
+        cursor = 0;
+        violation = false;
+        reusable.clear();
+        completed.clear();
+        Properties request = new Properties();
+        boolean admitted = false;
+        try {
+            if (stateDirectory != null) {
+                request = CheckstyleSuccessState.read(stateDirectory.resolve("request"));
+            }
+            admitted = "true".equals(request.getProperty("admitted")) && stateDirectory.toString().equals(request.getProperty("stateRoot"));
+            hashes = admitted ? hashInputs(files) : Map.of();
+        } catch (IOException e) {
+            // Metadata and hash preparation must not replace the native file/error path.
+            admitted = false;
+            hashes = Map.of();
+        }
+        for (Map.Entry<String, String> entry : hashes.entrySet()) {
+            if (entry.getValue().equals(request.getProperty("file:" + entry.getKey()))) {
+                reusable.add(entry.getKey());
+            }
+        }
+        List<File> changed = files.stream().filter(file -> reusable.contains(file.getAbsolutePath()) == false).toList();
+        int errors = checker.process(changed);
+        try {
+            // The auditFinished callback has already closed all native formatters here.
+            if (admitted && violation == false && errors == 0 && hashes.equals(hashInputs(files))) {
+                completed.setProperty("identity", request.getProperty("identity"));
+                completed.setProperty("requestId", request.getProperty("requestId"));
+                CheckstyleSuccessState.write(stateDirectory.resolve("proposed"), completed);
+            }
+        } catch (IOException e) {
+            // A completed native result remains valid when optional local history cannot be saved.
+        }
+        return errors;
+    }
+
+    /** Release the same native resources even when checking throws. */
+    @Override
+    public void destroy() {
+        checker.destroy();
+        listeners.clear();
+    }
+
+    private static Map<String, String> hashInputs(List<File> files) throws IOException {
+        Map<String, String> result = new HashMap<>();
+        for (File file : files) {
+            // Missing/unreadable input is processed by Checker, preserving its native error path.
+            if (Files.isRegularFile(file.toPath()) && Files.isReadable(file.toPath())) {
+                result.put(file.getAbsolutePath(), CheckstyleSuccessState.hash(file.toPath()));
+            }
+        }
+        return result;
+    }
+
+    private void replayBefore(String next) {
+        while (cursor < inputs.size()) {
+            String path = inputs.get(cursor).getAbsolutePath();
+            if (path.equals(next)) {
+                cursor++;
+                break;
+            }
+            cursor++;
+            if (reusable.contains(path)) {
+                AuditEvent event = new AuditEvent(checker, path);
+                listeners.forEach(listener -> listener.fileStarted(event));
+                listeners.forEach(listener -> listener.fileFinished(event));
+                completed.setProperty("file:" + path, hashes.get(path));
+            }
+        }
+    }
+
+    /** Forward actual native events and insert only previously proven empty file entries. */
+    private final class OrderedEvents implements AuditListener {
+        @Override
+        public void auditStarted(AuditEvent event) {
+            listeners.forEach(listener -> listener.auditStarted(event));
+        }
+
+        @Override
+        public void auditFinished(AuditEvent event) {
+            replayBefore(null);
+            listeners.forEach(listener -> listener.auditFinished(event));
+        }
+
+        @Override
+        public void fileStarted(AuditEvent event) {
+            replayBefore(event.getFileName());
+            listeners.forEach(listener -> listener.fileStarted(event));
+        }
+
+        @Override
+        public void fileFinished(AuditEvent event) {
+            String hash = hashes.get(event.getFileName());
+            if (hash != null) {
+                completed.setProperty("file:" + event.getFileName(), hash);
+            }
+            listeners.forEach(listener -> listener.fileFinished(event));
+        }
+
+        @Override
+        public void addError(AuditEvent event) {
+            violation = true;
+            listeners.forEach(listener -> listener.addError(event));
+        }
+
+        @Override
+        public void addException(AuditEvent event, Throwable throwable) {
+            violation = true;
+            listeners.forEach(listener -> listener.addException(event, throwable));
+        }
+    }
+}
