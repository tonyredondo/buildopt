+package org.elasticsearch.gradle.internal.checkstyle;
+
+import com.puppycrawl.tools.checkstyle.AbstractAutomaticBean;
+import com.puppycrawl.tools.checkstyle.Checker;
+import com.puppycrawl.tools.checkstyle.DefaultConfiguration;
+import com.puppycrawl.tools.checkstyle.XMLLogger;
+import com.puppycrawl.tools.checkstyle.api.AbstractFileSetCheck;
+import com.puppycrawl.tools.checkstyle.api.FileText;
+import com.puppycrawl.tools.checkstyle.api.RootModule;
+
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.FileTime;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Properties;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+/** Real-engine regression tests; the observation check counts work without replacing any native rule. */
+public class ContentAwareCheckerTests {
+    @Rule
+    public TemporaryFolder temporary = new TemporaryFolder();
+
+    /** Observe actual FileSetCheck processing independently of success metadata and replayed report events. */
+    public static class ProcessingObserver extends AbstractFileSetCheck {
+        private static final ThreadLocal<List<String>> FILES = ThreadLocal.withInitial(ArrayList::new);
+
+        @Override
+        protected void processFiltered(File file, FileText text) {
+            FILES.get().add(file.getName());
+        }
+    }
+
+    @Test
+    public void testContentReuseRetainsOrderedXmlIncludingExcludedFiles() throws Exception {
+        Path source = temporary.newFolder("sources").toPath();
+        Path state = temporary.newFolder("state").toPath();
+        File a = source.resolve("A.java").toFile();
+        File b = source.resolve("B.java").toFile();
+        File module = source.resolve("module-info.java").toFile();
+        Files.writeString(a.toPath(), "public class A {}\n");
+        Files.writeString(b.toPath(), "public class B {}\n");
+        Files.writeString(module.toPath(), "module example {}\n");
+        List<File> files = List.of(b, module, a);
+        Run nativeCold = run(false, state, files, new Properties());
+        Run cold = run(true, state, files, new Properties());
+        assertEquals(nativeCold.xml(), cold.xml());
+        assertEquals(List.of("B.java", "A.java"), cold.processed());
+        Run warm = run(true, state, files, cold.success());
+        assertEquals(nativeCold.xml(), warm.xml());
+        assertTrue(warm.processed().isEmpty());
+        Files.writeString(a.toPath(), "public class A { int value; }\n");
+        Run nativeEdit = run(false, state, files, new Properties());
+        Run edit = run(true, state, files, warm.success());
+        assertEquals(nativeEdit.xml(), edit.xml());
+        assertEquals(List.of("A.java"), edit.processed());
+        // A content change with the same timestamp must still reach the actual checker.
+        FileTime time = Files.getLastModifiedTime(a.toPath());
+        Files.writeString(a.toPath(), "import java.util.*;\npublic class A {}\n");
+        Files.setLastModifiedTime(a.toPath(), time);
+        Run nativeFailure = run(false, state, files, new Properties());
+        Run failure = run(true, state, files, edit.success());
+        assertEquals(nativeFailure.xml(), failure.xml());
+        assertEquals(nativeFailure.errors(), failure.errors());
+        assertTrue(failure.errors() > 0);
+        assertTrue(failure.success().isEmpty());
+    }
+
+    @Test
+    public void testFailuresNeverBecomeTrustedHistory() throws Exception {
+        Path state = temporary.newFolder("state").toPath();
+        File a = temporary.newFile("A.java");
+        File b = temporary.newFile("B.java");
+        List<File> files = List.of(a, b);
+        Files.writeString(a.toPath(), "import java.util.*;\npublic class A {}\n");
+        Files.writeString(b.toPath(), "import java.io.*;\npublic class B {}\n");
+        Run failed = run(true, state, files, new Properties());
+        assertEquals(2, failed.errors());
+        assertTrue(failed.success().isEmpty());
+        Files.writeString(a.toPath(), "public class A {}\n");
+        Run partial = run(true, state, files, failed.success());
+        assertEquals(1, partial.errors());
+        assertEquals(List.of("A.java", "B.java"), partial.processed());
+        assertEquals(run(false, state, files, new Properties()).xml(), partial.xml());
+        Files.writeString(b.toPath(), "public class B {}\n");
+        Run fixed = run(true, state, files, partial.success());
+        assertEquals(0, fixed.errors());
+        assertEquals(List.of("A.java", "B.java"), fixed.processed());
+        assertFalse(fixed.success().isEmpty());
+    }
+
+    @Test
+    public void testAddDeleteRenameAndEmptyInput() throws Exception {
+        Path state = temporary.newFolder("state").toPath();
+        File a = temporary.newFile("A.java");
+        Files.writeString(a.toPath(), "public class A {}\n");
+        Run initial = run(true, state, List.of(a), new Properties());
+        File b = temporary.newFile("B.java");
+        Files.writeString(b.toPath(), "public class B {}\n");
+        Run added = run(true, state, List.of(a, b), initial.success());
+        assertEquals(List.of("B.java"), added.processed());
+        assertEquals(run(false, state, List.of(a, b), new Properties()).xml(), added.xml());
+        Run deleted = run(true, state, List.of(b), added.success());
+        assertTrue(deleted.processed().isEmpty());
+        assertEquals(run(false, state, List.of(b), new Properties()).xml(), deleted.xml());
+        File renamed = temporary.newFolder("renamed").toPath().resolve("B.java").toFile();
+        Files.move(b.toPath(), renamed.toPath());
+        Run moved = run(true, state, List.of(renamed), deleted.success());
+        assertEquals(List.of("B.java"), moved.processed());
+        Run empty = run(true, state, List.of(), moved.success());
+        assertEquals(run(false, state, List.of(), new Properties()).xml(), empty.xml());
+        Run restored = run(true, state, List.of(renamed), empty.success());
+        assertEquals(List.of("B.java"), restored.processed());
+    }
+
+    @Test
+    public void testCorruptAndInterruptedMetadataAreNotHistory() throws Exception {
+        Path state = temporary.newFolder("state").toPath();
+        Path committed = state.resolve("success");
+        Properties success = new Properties();
+        success.setProperty("file:example", "value");
+        CheckstyleSuccessState.write(committed, success);
+        assertEquals("value", CheckstyleSuccessState.read(committed).getProperty("file:example"));
+        Files.writeString(state.resolve(".success-interrupted.tmp"), "unfinished");
+        assertEquals("value", CheckstyleSuccessState.read(committed).getProperty("file:example"));
+        Files.writeString(committed, "broken");
+        assertTrue(CheckstyleSuccessState.read(committed).isEmpty());
+        Files.delete(committed);
+        assertTrue(CheckstyleSuccessState.read(committed).isEmpty());
+    }
+
+    private record Run(int errors, String xml, List<String> processed, Properties success) {}
+
+    private Run run(boolean candidate, Path state, List<File> files, Properties previous) throws Exception {
+        DefaultConfiguration configuration = new DefaultConfiguration("Checker");
+        configuration.addProperty("charset", "UTF-8");
+        DefaultConfiguration exclusion = new DefaultConfiguration("BeforeExecutionExclusionFileFilter");
+        exclusion.addProperty("fileNamePattern", "module\\-info\\.java$");
+        configuration.addChild(exclusion);
+        configuration.addChild(new DefaultConfiguration(ProcessingObserver.class.getName()));
+        DefaultConfiguration tree = new DefaultConfiguration("TreeWalker");
+        tree.addChild(new DefaultConfiguration("AvoidStarImport"));
+        tree.addChild(new DefaultConfiguration("UnusedImports"));
+        configuration.addChild(tree);
+        RootModule checker = candidate ? new ContentAwareChecker() : new Checker();
+        if (candidate) {
+            Properties request = new Properties();
+            request.putAll(previous);
+            request.setProperty("admitted", "true");
+            request.setProperty("stateRoot", state.toAbsolutePath().normalize().toString());
+            request.setProperty("identity", "engine-test-only; Gradle admission is tested separately");
+            request.setProperty("requestId", "current-request");
+            CheckstyleSuccessState.write(state.resolve("request"), request);
+            Files.deleteIfExists(state.resolve("proposed"));
+            configuration.addProperty("buildoptStateDirectory", state.toString());
+        }
+        ProcessingObserver.FILES.get().clear();
+        Path report = temporary.newFile().toPath();
+        int errors;
+        try {
+            checker.setModuleClassLoader(getClass().getClassLoader());
+            checker.configure(configuration);
+            checker.addListener(new XMLLogger(Files.newOutputStream(report), AbstractAutomaticBean.OutputStreamOptions.CLOSE));
+            errors = checker.process(files);
+        } finally {
+            checker.destroy();
+        }
+        return new Run(
+            errors,
+            Files.readString(report),
+            List.copyOf(ProcessingObserver.FILES.get()),
+            candidate ? CheckstyleSuccessState.read(state.resolve("proposed")) : new Properties()
+        );
+    }
+}
