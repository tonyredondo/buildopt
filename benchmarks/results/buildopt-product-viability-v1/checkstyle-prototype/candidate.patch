+            Path state = directory.toPath();
+            try {
+                Properties previous = CheckstyleSuccessState.read(state.resolve("success"));
+                Files.deleteIfExists(state.resolve("success"));
+                Files.deleteIfExists(state.resolve("proposed"));
+                Files.deleteIfExists(state.resolve("request"));
