+                request.setProperty("stateRoot", state.toAbsolutePath().normalize().toString());
+                request.setProperty("identity", fingerprint);
+                request.setProperty("requestId", UUID.randomUUID().toString());
+                CheckstyleSuccessState.write(state.resolve("request"), request);
+            } catch (IOException e) {
+                // The original is already a declared configDirectory input. Both configurations
+                // request identical rules and reports; this branch only removes success reuse.
+                nativeFallback(task, textResources, originalConfig);
+                task.getLogger().info("Checkstyle success history unavailable; using native checking", e);
+            }
+        }
+    }
+
+    /** Bypass the adapter itself on unsupported engines, retaining any caller-supplied native rules. */
+    private static void nativeFallback(Checkstyle task, TextResourceFactory resources, File originalConfig) {
+        String configured = task.getConfig().asString();
+        if (configured.contains(ADAPTED_ROOT)) {
+            String nativeText = configured.replace(ADAPTED_ROOT, ORIGINAL_ROOT);
+            TextResource original = resources.fromFile(originalConfig);
+            task.setConfig(nativeText.equals(original.asString()) ? original : resources.fromString(nativeText));
+        } else if (configured.contains("org.elasticsearch.gradle.internal.checkstyle.ContentAwareChecker")) {
+            throw new org.gradle.api.GradleException("Unsupported modification of generated Checkstyle adapter configuration");
+        }
+    }
