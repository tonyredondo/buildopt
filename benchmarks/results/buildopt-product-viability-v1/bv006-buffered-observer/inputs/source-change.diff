+//go:build linux && amd64 && replay_integration && replay_gradle
+
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// The independent checker also reconstructs every payload and acknowledgement.
+// Restoring synchronous writes must fail the unchanged 500-ms delay criterion.
+func TestBufferedObserverCase(t *testing.T) {
+	name := os.Getenv("BUILDOPT_BUFFERED_CASE")
+	root := os.Getenv("BUILDOPT_BUFFERED_ROOT")
+	if !filepath.IsAbs(root) {
+		t.Fatal("explicit fixture root required")
+	}
+	self, err := processIdentity(os.Getpid())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = observerSave(filepath.Join(root, "fixture-identity.json"), self); err != nil {
+		t.Fatal(err)
+	}
+	config := defaultBufferedConfig()
+	options := samplerOptions{maxRows: 10000, maxBytes: 512 << 20, stopAfter: 40, buffered: &config}
+	stop := make(chan struct{})
+	timerDone := make(chan struct{})
+	cancelAfter := time.Duration(0)
+	observe := cgroupProcesses
+	expected := ""
+	switch name {
+	case "normal":
+	case "writer-delay", "race-writer-delay":
+		config.Fault = "delay"
+	case "writer-error":
+		config.Fault = "error"
+		expected = "deliberate writer error"
+	case "short-write":
+		config.Fault = "short"
+		expected = "short write"
+	case "record-saturation":
+		config.Fault = "delay"
+		config.PendingRecords = 3
+		expected = "writer pending record limit"
+	case "byte-saturation":
+		config.PendingBytes = 1
+		expected = "writer pending byte limit"
+	case "total-output-limit":
+		config.TotalBytes = 1
+		expected = "writer total byte limit"
+	case "cancel-before":
+		close(stop)
+	case "cancel-capture":
+		config.Fault = "delay"
+		cancelAfter = 750 * time.Millisecond
+	case "cancel-drain":
+		config.Fault = "delay"
+		options.stopAfter = 3
+		cancelAfter = 600 * time.Millisecond
+	case "drain-timeout":
+		config.Fault = "stall"
+		config.DrainNS = int64(200 * time.Millisecond)
+		options.stopAfter = 3
+		expected = "writer drain deadline"
+	case "writer-exit":
+		config.Fault = "exit"
+		expected = "writer acknowledgement"
+	case "driver-exit":
+		config.Fault = "stall"
+	case "scan-error":
+		observe = func(string) ([]ProcessIdentity, error) { return nil, errors.New("deliberate scan error") }
+		expected = "deliberate scan error"
+	default:
+		t.Fatal("unregistered case", name)
+	}
+	if cancelAfter > 0 {
+		go func() {
+			defer close(timerDone)
+			time.Sleep(cancelAfter)
+			observerSave(filepath.Join(root, "cancel.json"), observerClock())
+			close(stop)
+		}()
+	} else {
+		close(timerDone)
+	}
+	begin := observerClock()
+	err = observeSampler(workerSession{Cgroup: self.Cgroup}, filepath.Join(root, "proc-samples.jsonl"), stop, observe, options)
+	end := observerClock()
+	<-timerDone
+	if name == "driver-exit" {
+		t.Fatal("driver-exit must be interrupted by its registered controller")
+	}
+	if (expected == "" && err != nil) || (expected != "" && (err == nil || !strings.Contains(err.Error(), expected))) {
+		t.Fatalf("expected %q; got %v", expected, err)
+	}
+	var report struct {
+		Rows        []observerPhase `json:"rows"`
+		Persistence bufferedSummary `json:"persistence"`
+	}
+	// This assertion reads a projection; the independent checker validates the
+	// full report. readJSON intentionally rejects unknown protocol fields.
+	raw, err := os.ReadFile(filepath.Join(root, "proc-samples.jsonl.phases.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = json.Unmarshal(raw, &report); err != nil {
+		t.Fatal(err)
+	}
+	if expected == "" && report.Persistence.Accepted != report.Persistence.Acknowledged {
+		t.Fatal("accepted payloads lost")
+	}
+	if name == "normal" || name == "writer-delay" || name == "race-writer-delay" {
+		if len(report.Rows) != 40 || report.Persistence.Acknowledged != 40 {
+			t.Fatal("wrong complete record count")
+		}
+		for i := 1; i < len(report.Rows); i++ {
+			if report.Rows[i].Wake.BootNS-report.Rows[i-1].Wake.BootNS > int64(500*time.Millisecond) {
+				t.Fatal("writer delay blocked live sampling")
+			}
+		}
+	}
+	if report.Persistence.PeakPendingRecords > config.PendingRecords || report.Persistence.PeakPendingBytes > config.PendingBytes {
+		t.Fatal("queue exceeded bounds")
+	}
+	if end.MonoNS-begin.MonoNS > int64(9*time.Second) {
+		t.Fatal("unbounded collection or drain")
+	}
+	if err = observerSave(filepath.Join(root, "case-result.json"), map[string]interface{}{"name": name, "begin": begin, "end": end, "expectedError": expected}); err != nil {
+		t.Fatal(err)
+	}
+}
diff --git 1/.tools/state/buildopt-product-viability-v1/bv006-buffered-observer/control/source/buffered_writer_test.go 2/.tools/state/buildopt-product-viability-v1/bv006-buffered-observer/control/source/buffered_writer_test.go
